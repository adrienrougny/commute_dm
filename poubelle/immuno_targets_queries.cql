-- Count collections and collection entries
MATCH (c:Collection) RETURN 'Collection' AS label, count(c) AS count
UNION ALL
MATCH (ce:CollectionEntry) RETURN 'CollectionEntry' AS label, count(ce) AS count;

-- Get collection names
MATCH (c:Collection) RETURN c.name AS name;

-- Get 10 proteins with their UniProt IDs from RDF annotations
MATCH (rdf:RDFAnnotation)<-[:HAS_ITEM]-(bag)<-[:HAS_VALUE]-(item:Item)-[:HAS_KEY]->(protein:Protein)
WHERE any(r IN rdf.resources WHERE r CONTAINS 'uniprot')
WITH DISTINCT protein.name AS protein_name,
     [r IN rdf.resources WHERE r CONTAINS 'uniprot' | split(r, ':')[-1]] AS uniprot_ids
RETURN protein_name, uniprot_ids
LIMIT 10;

-- Match Feng list UniProt IDs against proteins in each collection
WITH ['O00175','O00182','O00253','O00300','O00585','O00626','O00755','O14625','O14788','O14836','O15123','O15444','O15455','O15467','O43508','O43557','O43915','O43927','O75144','O75509','O75888','O76036','O76096','O95150','O95715','O95750','O95760','O95998','P01033','P01042','P01127','P01133','P01137','P01138','P01258','P01374','P01375','P01562','P01563','P01574','P01579','P01584','P01588','P01589','P01730','P01903','P02741','P02745','P02778','P02794','P03956','P04083','P04085','P04141','P05000','P05112','P05113','P05164','P05231','P05362','P06702','P06731','P07333','P07766','P08254','P08887','P09038','P09341','P09603','P09919','P09958','P10144','P10145','P10147','P10451','P10600','P12544','P13232','P13236','P13500','P13501','P13521','P13725','P14136','P14174','P14210','P14778','P14780','P14784','P15018','P15248','P15514','P15529','P15692','P16035','P16109','P16410','P16581','P16871','P17948','P18075','P18510','P18627','P18827','P19320','P19438','P19875','P19876','P20333','P20783','P20809','P21583','P22301','P22362','P22894','P23510','P23560','P24001','P24394','P25774','P25942','P26022','P26441','P26718','P26842','P26951','P27930','P28799','P28908','P29459','P29460','P29965','P32927','P32970','P32971','P33681','P35225','P35442','P35916','P35968','P36222','P39900','P40189','P40225','P40933','P41217','P41273','P42701','P42830','P43489','P43490','P48023','P48061','P49763','P49767','P49771','P50591','P51671','P55773','P60568','P62760','P78310','P78324','P78423','P78556','P80075','P80098','P80162','P80188','P80511','Q01151','Q01344','Q01638','Q02223','Q02763','Q06643','Q07011','Q07325','Q08334','Q10589','Q12866','Q13007','Q13261','Q13291','Q13478','Q14005','Q14116','Q14213','Q14627','Q15109','Q15116','Q15389','Q16552','Q16619','Q16627','Q16663','Q29980','Q29983','Q5ZPR3','Q6UX27','Q6ZMJ4','Q7Z5A7','Q8IU54','Q8IZI9','Q8IZJ0','Q8N423','Q8NEV9','Q8TD46','Q8WXI7','Q92583','Q92956','Q969D9','Q96D42','Q96F46','Q96PD4','Q96RJ3','Q99062','Q99616','Q99650','Q99731','Q99988','Q9BQ51','Q9GZV9','Q9GZX6','Q9H2A7','Q9NP99','Q9NPF7','Q9NPY3','Q9NRJ3','Q9NRM6','Q9NSA1','Q9NWZ3','Q9NYY1','Q9NZC2','Q9NZH7','Q9NZH8','Q9NZQ7','Q9P0M4','Q9UBV4','Q9UHA7','Q9UHD0','Q9UHF5','Q9UK05','Q9UMR7','Q9UNG2','Q9UQV4','Q9Y258','Q9Y4X3','Q9Y5U5','Q9Y6K9','Q9Y6Q6'] AS feng_ids
MATCH (ce:CollectionEntry)<-[:HAS_ENTRY]-(coll:Collection)
MATCH (ce)-[:HAS_MODEL]->(model)-[:HAS_SPECIES]->(protein:Protein)
MATCH (item:Item)-[:HAS_KEY]->(protein), (item)-[:HAS_VALUE]->(bag:Bag)-[:HAS_ITEM]->(rdf:RDFAnnotation)
WHERE any(r IN rdf.resources WHERE any(fid IN feng_ids WHERE r = 'urn:miriam:uniprot:' + fid))
WITH coll.name AS collection, protein.name AS protein_name,
     [r IN rdf.resources WHERE r STARTS WITH 'urn:miriam:uniprot:' | split(r, ':')[-1]] AS uniprot_ids
RETURN collection, collect(DISTINCT uniprot_ids[0]) AS matched_uniprot, count(DISTINCT uniprot_ids[0]) AS count;

-- Combined unique count across both collections
WITH ['O00175','O00182','O00253','O00300','O00585','O00626','O00755','O14625','O14788','O14836','O15123','O15444','O15455','O15467','O43508','O43557','O43915','O43927','O75144','O75509','O75888','O76036','O76096','O95150','O95715','O95750','O95760','O95998','P01033','P01042','P01127','P01133','P01137','P01138','P01258','P01374','P01375','P01562','P01563','P01574','P01579','P01584','P01588','P01589','P01730','P01903','P02741','P02745','P02778','P02794','P03956','P04083','P04085','P04141','P05000','P05112','P05113','P05164','P05231','P05362','P06702','P06731','P07333','P07766','P08254','P08887','P09038','P09341','P09603','P09919','P09958','P10144','P10145','P10147','P10451','P10600','P12544','P13232','P13236','P13500','P13501','P13521','P13725','P14136','P14174','P14210','P14778','P14780','P14784','P15018','P15248','P15514','P15529','P15692','P16035','P16109','P16410','P16581','P16871','P17948','P18075','P18510','P18627','P18827','P19320','P19438','P19875','P19876','P20333','P20783','P20809','P21583','P22301','P22362','P22894','P23510','P23560','P24001','P24394','P25774','P25942','P26022','P26441','P26718','P26842','P26951','P27930','P28799','P28908','P29459','P29460','P29965','P32927','P32970','P32971','P33681','P35225','P35442','P35916','P35968','P36222','P39900','P40189','P40225','P40933','P41217','P41273','P42701','P42830','P43489','P43490','P48023','P48061','P49763','P49767','P49771','P50591','P51671','P55773','P60568','P62760','P78310','P78324','P78423','P78556','P80075','P80098','P80162','P80188','P80511','Q01151','Q01344','Q01638','Q02223','Q02763','Q06643','Q07011','Q07325','Q08334','Q10589','Q12866','Q13007','Q13261','Q13291','Q13478','Q14005','Q14116','Q14213','Q14627','Q15109','Q15116','Q15389','Q16552','Q16619','Q16627','Q16663','Q29980','Q29983','Q5ZPR3','Q6UX27','Q6ZMJ4','Q7Z5A7','Q8IU54','Q8IZI9','Q8IZJ0','Q8N423','Q8NEV9','Q8TD46','Q8WXI7','Q92583','Q92956','Q969D9','Q96D42','Q96F46','Q96PD4','Q96RJ3','Q99062','Q99616','Q99650','Q99731','Q99988','Q9BQ51','Q9GZV9','Q9GZX6','Q9H2A7','Q9NP99','Q9NPF7','Q9NPY3','Q9NRJ3','Q9NRM6','Q9NSA1','Q9NWZ3','Q9NYY1','Q9NZC2','Q9NZH7','Q9NZH8','Q9NZQ7','Q9P0M4','Q9UBV4','Q9UHA7','Q9UHD0','Q9UHF5','Q9UK05','Q9UMR7','Q9UNG2','Q9UQV4','Q9Y258','Q9Y4X3','Q9Y5U5','Q9Y6K9','Q9Y6Q6'] AS feng_ids
MATCH (ce:CollectionEntry)<-[:HAS_ENTRY]-(coll:Collection)
MATCH (ce)-[:HAS_MODEL]->(model)-[:HAS_SPECIES]->(protein:Protein)
MATCH (item:Item)-[:HAS_KEY]->(protein), (item)-[:HAS_VALUE]->(bag:Bag)-[:HAS_ITEM]->(rdf:RDFAnnotation)
WHERE any(r IN rdf.resources WHERE any(fid IN feng_ids WHERE r = 'urn:miriam:uniprot:' + fid))
WITH [r IN rdf.resources WHERE r STARTS WITH 'urn:miriam:uniprot:' | split(r, ':')[-1]][0] AS uid
RETURN count(DISTINCT uid) AS combined_unique;
