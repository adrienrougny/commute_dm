UNWIND [{start: {_id:3627}, end: {_id:1105}, properties:{evidence:"APP is synthesized in the endoplasmic reticulum (ER) and then transported through the Golgi apparatus to the trans-Golgi-network (TGN) where the highest concentration of APP is found in neurons at steady state. Abeta is generated in the ER and Golgi/TGN. From the TGN, APP can be transported in TGN-derived secretory vesicles to the cell surface where it is either cleaved by alpha-secretase to produce a soluble molecule, sAPPalpha [37], or re-internalized via an endosomal/lysosomal degradation pathway", annotationSubgraph:["Non-amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"21214928", citationType:"PubMed", citationRef:"21214928"}}] AS row
