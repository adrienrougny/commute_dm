UNWIND [{start: {_id:3910}, end: {_id:2837}, properties:{evidence:"Using screening approaches in primary neurons, we identified brain- derived neurotrophic factor (BDNF) as a major inducer of Sorla that activates receptor gene transcription through the ERK (extracellular regulated kinase) pathway.These findings demonstrate that the beneficial effects ascribed to BDNF in APP metabolism act through induction of Sorla that encodes a negative regulator of neuronal APP processing", annotationSubgraph:["Non-amyloidogenic subgraph", "MAPK-ERK subgraph"], annotationConfidence:["Medium"], pmid:"20007471", citationType:"PubMed", citationRef:"20007471"}}] AS row
