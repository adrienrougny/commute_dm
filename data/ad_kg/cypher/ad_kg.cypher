UNWIND [{start: {_id:1188}, end: {_id:663}, properties:{evidence:"The miR-29a/b-1 cluster was significantly (and AD-dementia-specific) decreased in AD patients displaying abnormally high BACE1 protein. Loss of microRNA cluster miR-29a/b-1 in sporadic Alzheimer's disease correlates with increased BACE1/beta-secretase expression.We show here that miR-29a, -29b-1, and -9 can regulate BACE1 expression in vitro.", annotationSubgraph:["Beta secretase subgraph", "miRNA subgraph"], pmid:"18434550", citationType:"PubMed", citationRef:"18434550"}}, {start: {_id:856}, end: {_id:1406}, properties:{evidence:"During differentiation of macrophages primarily the promoter 3 and to a certain extent promoter 1 is activated. Consequently macrophages mainly express PPARgamma1 (10). In macrophages PPARgamma represses inducible nitric-oxide (NO) synthase induction as well as concomitant NO production (11) and attenuates the oxidative burst (13, 14). Moreover, inhibiting nuclear factor ÎºB (NFÎºB) decreases expression of inflammatory cytokines such as interleukin (IL)-1, tumor necrosis factor Î± (TNFÎ±) or IL-6 (12). Thus, PPARgamma is important to shape an anti-inflammatory macrophage phenotype and appears crucial for dampening inflammation", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], pmid:"20164187", citationType:"PubMed", citationRef:"20164187"}}, {start: {_id:1149}, end: {_id:1147}, properties:{evidence:"Utilizing human cell lines, we demonstrate that miRNAs hsa-mir-106a and hsa-mir-520c bind to their predicted target sequences in the APP 3'UTR and negatively regulate reporter gene expression. Over- expression of these miRNAs, but not control miRNAs, results in translational repression of APP mRNA and significantly reduces APP protein levels. These results are the first to demonstrate that levels of human APP can be regulated by miRNAs.", annotationSubgraph:["miRNA subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18684319", citationType:"PubMed", citationRef:"18684319"}}, {start: {_id:4611}, end: {_id:1489}, properties:{evidence:"Results showed significant hypermethylation of mammalian orthologue of Sir2 (SIRT1) gene in AD patients", pmid:"25287307", citationType:"PubMed", citationRef:"25287307"}}, {start: {_id:4621}, end: {_id:4619}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"Significantly increased mRNA and expression of Cdk5 were observed in the hippocampal CA1 in the rats injected with amyloid fibrils. Increased acetylation of histone H3 was detected in the Cdk5 promoter region in hippocampal CA1 in these rats.", annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], pmid:"25234403", citationType:"PubMed", citationRef:"25234403"}}] AS row
