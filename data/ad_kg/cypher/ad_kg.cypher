UNWIND [{start: {_id:27}, end: {_id:3}, properties:{evidence:"Alzheimer's disease (AD) is associated with accumulations of amyloid- beta (Abeta) peptides, oxidative damage, mitochondrial dysfunction, neurodegeneration, and dementia", annotationSubgraph:["Response to oxidative stress", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16687508", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"16687508"}}, {start: {_id:1163}, end: {_id:3}, properties:{evidence:"To some extent vascular complications of type 2 diabetes or glucose intolerance might be leading to neurodegeneration due to insufficient neuronal nutrient supply as well as imÂ­ paired -amyloid (A) clearance from the brain [12] . FurÂ­thermore, disturbed cerebral perfusion due to endothelial dysfunction and alteration of the blood brain barrier results in upregulation of amyloid precursor protein (APP) expresÂ­ sion and Adeposition [13]. Also, hyperinsulinemia as it is present in type 2 diabetes may play an important role in forÂ­ mation of senile plaques (14].", annotationSubgraph:["Insulin signal transduction", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19519303", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:27}, end: {_id:93}, properties:{evidence:"The fact that mitochondria are the major generators and direct targets of reactive oxygen species led several investigators to foster the idea that oxidative stress and damage in mitochondria are contributory factors to several disorders including Alzheimer's disease and diabetes.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["High"], pmid:"17316694", citationType:"PubMed", citationRef:"17316694"}}, {start: {_id:1148}, end: {_id:2030}, properties:{evidence:"S-nitrosoglutathione (GSNO) is an endogenous nitric oxide carrier modulating endothelial function, inflammation, and neurotransmission.", annotationSubgraph:["Inflammatory response subgraph", "Nitric oxide subgraph"], annotationMeshdisease:["Inflammation"], annotationConfidence:["High"], pmid:"23254638", citationType:"PubMed", citationRef:"23254638"}}, {start: {_id:2051}, end: {_id:2048}, properties:{evidence:"Age-related androgen depletion is known to be a risk factor for various diseases, such as osteoporosis and sarcopenia.", annotationSubgraph:["Androgen subgraph"], annotationMeshdisease:["Osteoporosis", "Sarcopenia"], pmid:"24177288", citationType:"PubMed", citationRef:"24177288"}}, {start: {_id:2052}, end: {_id:2048}, properties:{evidence:"Age-related androgen depletion is known to be a risk factor for various diseases, such as osteoporosis and sarcopenia.", annotationSubgraph:["Androgen subgraph"], annotationMeshdisease:["Osteoporosis", "Sarcopenia"], pmid:"24177288", citationType:"PubMed", citationRef:"24177288"}}, {start: {_id:27}, end: {_id:2048}, properties:{evidence:"Furthermore, recent studies have demonstrated that age-related androgen depletion results in accumulation of beta-amyloid protein and thereby acts as a risk factor for the development of Alzheimer's disease.", annotationSubgraph:["Androgen subgraph"], pmid:"24177288", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24177288"}}, {start: {_id:27}, end: {_id:2058}, properties:{evidence:"Caffeine based measures of CYP1A2 activity correlate with oral clearance of tacrine in patients with Alzheimer's disease.", annotationSpecies:["9606"], pmid:"9764962", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"9764962"}}, {start: {_id:27}, end: {_id:2063}, properties:{evidence:"Identification of cytochrome P450 1A2 as enzyme involved in the microsomal metabolism of Huperzine A. Huperzine A is a reversible and selective cholinesterase inhibitor approved for the treatment of Alzheimer's disease.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"12586202", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12586202"}}, {start: {_id:27}, end: {_id:76}, properties:{evidence:"The endothelial nitric oxide synthase (NOS3) gene encodes endothelial NOS, an enzyme that regulates the production of the vasodilatory nitric oxide associated with the cerebral small vessel pathology observed in early AD.", annotationSubgraph:["Nitric oxide subgraph"], annotationMeshanatomy:["Cerebrum", "Endothelium"], annotationConfidence:["High"], pmid:"15016421", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15016421"}}, {start: {_id:27}, end: {_id:2163}, properties:{evidence:"The therapeutic potential of screening for markers of renin- angiotensin abnormality for the prediction of Alzheimer's disease is considered, as is the potential use of agents known to influence the renin-angiotensin system in the treatment or prevention of the disease.", annotationSubgraph:["Renin-angiotensin subgraph"], pmid:"15853619", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15853619"}}, {start: {_id:27}, end: {_id:2166}, properties:{evidence:"Here, we discuss the role of angiotensin II in cognitive impairment and AD.", annotationSubgraph:["Renin-angiotensin subgraph"], pmid:"23304450", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23304450"}}, {start: {_id:1148}, end: {_id:93}, properties:{evidence:"Associated with these inflammatory responses are tumor necrosis factor-alpha (TNF-alpha) and reactive oxygen species (ROS), both believed to be derived from brain microglia.", annotationSubgraph:["Inflammatory response subgraph", "Reactive oxygen species subgraph", "Tumor necrosis factor subgraph"], annotationMeshanatomy:["Brain", "Microglia"], annotationConfidence:["High"], pmid:"18554520", citationType:"PubMed", citationRef:"18554520"}}, {start: {_id:1148}, end: {_id:3}, properties:{evidence:"Cyclooxygenase-1 null mice show reduced neuroinflammation in response to beta-amyloid.", annotationSubgraph:["Amyloidogenic subgraph", "Prostaglandin subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Neurons"], annotationConfidence:["Medium"], pmid:"20157512", citationType:"PubMed", citationRef:"20157512"}}, {start: {_id:825}, end: {_id:704}, properties:{evidence:"More recent data indicate that these enzymes and the biologically active lipid molecules they generate could influence the functioning of the central nervous system and the pathobiology of neurodegenerative disorders such as AD via mechanisms different from classical inflammation.", annotationMeshdisease:["Neurodegenerative Diseases", "Inflammation", "Alzheimer Disease"], annotationMeshanatomy:["Central Nervous System"], pmid:"20691748", citationType:"PubMed", citationRef:"20691748"}}, {start: {_id:27}, end: {_id:704}, properties:{evidence:"More recent data indicate that these enzymes and the biologically active lipid molecules they generate could influence the functioning of the central nervous system and the pathobiology of neurodegenerative disorders such as AD via mechanisms different from classical inflammation.", annotationMeshdisease:["Neurodegenerative Diseases", "Inflammation", "Alzheimer Disease"], annotationMeshanatomy:["Central Nervous System"], pmid:"20691748", citationType:"PubMed", citationRef:"20691748"}}, {start: {_id:1098}, end: {_id:2436}, properties:{evidence:"These leukotrienes are known to produce inflammatory responses in asthma and allergic reactions, to induce a reduction of tyrosine hydroxylase in brain, and are involved in the development of cardiac strokes, obesity and type 2 diabetes.", annotationSubgraph:["Eicosanoids signaling subgraph"], annotationMeshdisease:["Diabetes Mellitus, Type 2", "Obesity", "Stroke", "Hypersensitivity", "Asthma"], annotationMeshanatomy:["Brain"], pmid:"24059322", citationType:"PubMed", citationRef:"24059322"}}, {start: {_id:1142}, end: {_id:2436}, properties:{evidence:"These leukotrienes are known to produce inflammatory responses in asthma and allergic reactions, to induce a reduction of tyrosine hydroxylase in brain, and are involved in the development of cardiac strokes, obesity and type 2 diabetes.", annotationSubgraph:["Eicosanoids signaling subgraph"], annotationMeshdisease:["Diabetes Mellitus, Type 2", "Obesity", "Stroke", "Hypersensitivity", "Asthma"], annotationMeshanatomy:["Brain"], pmid:"24059322", citationType:"PubMed", citationRef:"24059322"}}, {start: {_id:2025}, end: {_id:2436}, properties:{evidence:"These leukotrienes are known to produce inflammatory responses in asthma and allergic reactions, to induce a reduction of tyrosine hydroxylase in brain, and are involved in the development of cardiac strokes, obesity and type 2 diabetes.", annotationSubgraph:["Eicosanoids signaling subgraph"], annotationMeshdisease:["Diabetes Mellitus, Type 2", "Obesity", "Stroke", "Hypersensitivity", "Asthma"], annotationMeshanatomy:["Brain"], pmid:"24059322", citationType:"PubMed", citationRef:"24059322"}}, {start: {_id:2206}, end: {_id:2436}, properties:{evidence:"These leukotrienes are known to produce inflammatory responses in asthma and allergic reactions, to induce a reduction of tyrosine hydroxylase in brain, and are involved in the development of cardiac strokes, obesity and type 2 diabetes.", annotationSubgraph:["Eicosanoids signaling subgraph"], annotationMeshdisease:["Diabetes Mellitus, Type 2", "Obesity", "Stroke", "Hypersensitivity", "Asthma"], annotationMeshanatomy:["Brain"], pmid:"24059322", citationType:"PubMed", citationRef:"24059322"}}] AS row
