UNWIND [{start: {_id:3063}, end: {_id:118}, properties:{evidence:"In vitro studies showing that DYRK1A phosphorylates tau protein suggest that this kinase is also involved in tau protein phosphorylation in the human brain and contributes to neurofibrillary degeneration, and that this contribution might be enhanced in patients with DS.", annotationSubgraph:["DYRK1A subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"18696092", citationType:"PubMed", citationRef:"18696092"}}, {start: {_id:3063}, end: {_id:653}, properties:{evidence:"Results demonstrate that the beta-carboline compounds (1) potently reduce the expression of all three phosphorylated forms of tau protein, and (2) inhibit the DYRK1A catalyzed direct phosphorylation of tau protein on serine 396.", annotationSubgraph:["DYRK1A subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"21573099", citationType:"PubMed", citationRef:"21573099"}}, {start: {_id:3070}, end: {_id:1726}, properties:{evidence:"Endothelin-converting enzyme-1 and 2 (ECE-1 and ECE-2) are expressed in endothelial cells and neurones, respectively, and both cleave 'big endothelin' to produce the vasoconstrictor endothelin-1 (ET-1).", annotationSubgraph:["Endothelin subgraph"], pmid:"20345647", citationType:"PubMed", citationRef:"20345647"}}, {start: {_id:3071}, end: {_id:1726}, properties:{evidence:"Endothelin-converting enzyme-1 and 2 (ECE-1 and ECE-2) are expressed in endothelial cells and neurones, respectively, and both cleave 'big endothelin' to produce the vasoconstrictor endothelin-1 (ET-1).", annotationSubgraph:["Endothelin subgraph"], pmid:"20345647", citationType:"PubMed", citationRef:"20345647"}}, {start: {_id:3071}, end: {_id:1726}, properties:{evidence:"Endothelin-converting enzyme-2 (ECE-2), which is expressed in neural tissues, cleaves 'big endothelin' to produce the vasoconstrictor endothelin-1.", annotationSubgraph:["Endothelin subgraph"], pmid:"19541930", citationType:"PubMed", citationR