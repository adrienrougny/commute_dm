 pmid:"24854197", citationType:"PubMed", citationRef:"24854197"}}, {start: {_id:4263}, end: {_id:6}, properties:{evidence:"Several findings indicate that the activation of both CB1 and CB2 receptors by natural or synthetic agonists, at non-psychoactive doses, have beneficial effects in Alzheimer experimental models by reducing the harmful beta-amyloid peptide action and tau phosphorylation, as well as by promoting the brain's intrinsic repair mechanisms.", annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"24634659", citationType:"PubMed", citationRef:"24634659"}}, {start: {_id:4331}, end: {_id:6}, properties:{evidence:"Several findings indicate that the activation of both CB1 and CB2 receptors by natural or synthetic agonists, at non-psychoactive doses, have beneficial effects in Alzheimer experimental models by reducing the harmful beta-amyloid peptide action and tau phosphorylation, as well as by promoting the brain's intrinsic repair mechanisms.", annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"24634659", citationType:"PubMed", citationRef:"24634659"}}, {start: {_id:4263}, end: {_id:1801}, properties:{evidence:"Several findings indicate that the activation of both CB1 and CB2 receptors by natural or synthetic agonists, at non-psychoactive doses, have beneficial effects in Alzheimer experimental models by reducing the harmful beta-amyloid peptide action and tau phosphorylation, as well as by promoting the brain's intrinsic repair mechanisms.", annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"24634659", citationType:"PubMed", citationRef:"24634659"}}] AS row
