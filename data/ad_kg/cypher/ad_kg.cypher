MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:4321}, end: {_id:6}, properties:{evidence:"Results demonstrated that orally administered rutin significantly attenuated memory deficits in AD transgenic mice, decreased oligomeric Abeta level, increased super oxide dismutase (SOD) activity and glutathione (GSH)/glutathione disulfide (GSSG) ratio, reduced GSSG and malondialdehyde (MDA) levels, downregulated microgliosis and astrocytosis, and decreased interleukin (IL)-1beta and IL-6 levels in the brain.", annotationSubgraph:["Non-amyloidogenic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"24512768", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24512768"}}, {start: {_id:4321}, end: {_id:4269}, properties:{evidence:"Results demonstrated that orally administered rutin significantly attenuated memory deficits in AD transgenic mice, decreased oligomeric Abeta level, increased super oxide dismutase (SOD) activity and glutathione (GSH)/glutathione disulfide (GSSG) ratio, reduced GSSG and malondialdehyde (MDA) levels, downregulated microgliosis and astrocytosis, and decreased interleukin (IL)-1beta and IL-6 levels in the brain.", annotationSubgraph:["Interleukin signaling subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Microglia"], annotationConfidence:["High"], pmid:"24512768", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24512768"}}, {start: {_id:4321}, end: {_id:2029}, properties:{evidence:"Results demonstrated that orally administered rutin significantly attenuated memory deficits in AD transgenic mice, decreased oligomeric Abeta level, increased super oxide dismutase (SOD) activity and glutathione (GSH)/glutathione disulfide (GSSG) ratio, reduced GSSG and malondialdehyde (MDA) levels, downregulated microgliosis and astrocytosis, and decreased interleukin (IL)-1beta and IL-6 levels in the brain.", annotationSubgraph:["Interleukin signaling subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Microglia"], annotationConfidence:["High"], pmid:"24512768", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24512768"}}, {start: {_id:611}, end: {_id:4225}, properties:{evidence:"Here we report that the expression of COX-2 and glial fibrillary acidic protein were enhanced and that of/ peroxisome proliferator- activated receptor gamma (PPARgamma) was decreased in Abeta(25-35)-treated astrocytes. In line/ with these results, nuclear factor-kappaB translocation was increased in the presence of Abeta.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Prostaglandin subgraph"], annotationMeshanatomy:["Astrocytes", "Microglia"], annotationConfidence:["Low"], pmid:"20413894", citationType:"PubMed", citationRef:"20413894"}}, {start: {_id:4366}, end: {_id:4367}, properties:{evidence:"We found that palmitic acid significantly increased de-novo synthesis of ceramide in astroglia, which/ in turn was involved in inducing both increased production of the Abeta protein and hyperphosphorylation of the tau/ protein. Increased amyloidogenesis and hyperphoshorylation of tau lead to formation of the two most important/ pathophysiological characteristics associated with AD, Abeta or senile plaques and neurofibrillary tangles, respectively./ In addition to these pathophysiological changes, AD is also characterized by certain metabolic changes; abnormal/ cerebral glucose metabolism is one of the distinct characteristics of AD. In this context, we found that palmitic/ acid significantly decreased the levels of astroglial glucose transporter (GLUT1) and down-regulated glucose uptake/ and lactate release by astroglia. Our present data establish an underlying mechanism by which saturated fatty acids/ induce AD-associated pathophysiological as well as metabolic changes, placing 'astroglial fatty acid metabolism' at/ the center of the pathogenic cascade in AD.", annotationSubgraph:["Sphingolipid metabolic subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"17908174", citationType:"PubMed", citationRef:"17908174"}}, {start: {_id:4391}, end: {_id:6}, properties:{evidence:"We found that the quantity and the molecular pattern of Abeta and its derivatives clearly differed between the CAA case with and the one without corticosteroid treatment. Moreover, amyloid-associated proteins were significantly reduced in the CAA extracts with corticosteroid treatment. In particular, reduction of S100A9/Mrp14 was remarkable (Kametani and Ikeda, 2013).", annotationSubgraph:["Metabolism of steroid hormones subgraph"], annotationConfidence:["High"], pmid:"24262203", citationType:"PubMed", citationRef:"24262203"}}, {start: {_id:4391}, end: {_id:4242}, properties:{evidence:"We found that the quantity and the molecular pattern of Abeta and its derivatives clearly differed between the CAA case with and the one without corticosteroid treatment. Moreover, amyloid-associated proteins were significantly reduced in the CAA extracts with corticosteroid treatment. In particular, reduction of S100A9/Mrp14 was remarkable (Kametani and Ikeda, 2013).", annotationSubgraph:["Metabolism of steroid hormones subgraph"], annotationConfidence:["High"], pmid:"24262203", citationType:"PubMed", citationRef:"24262203"}}, {start: {_id:4391}, end: {_id:6}, properties:{evidence:"In CAA, and probably in AD, corticosteroid treatment suppresses the secondarily induced vascular inflammation (Chang et al., 2012, Kloppenborg et al., 2010 and Machida et al., 2012) and the activation of S100A9/Mrp14 (Gebhardt et al., 2002 and Kametani and Ikeda, 2013). Recently, it has been reported that anti-Abeta autoantibodies were progressively reduced in the cerebrospinal fluid of a patient with CAA-related inflammation, following intravenous steroid administration (Piazza et al., 2013). Reduction of S100A9/Mrp14 might induce suppression of amyloid fibril formation (Zhang et al., 2012) and increase phagocytosis of fibrillar Abeta in microglia cells (Kummer et al., 2012), resulting in reduced Abeta amyloid fibril deposition.", annotationSubgraph:["Inflammatory response subgraph", "Metabolism of steroid hormones subgraph"], annotationConfidence:["Medium"], pmid:"24262203", citationType:"PubMed", citationRef:"24262203"}}, {start: {_id:4394}, end: {_id:4242}, properties:{evidence:"[Estradiol co-treated with Tetrachlorodibenzodioxin] results in decreased expression of S100A9 mRNA", annotationSubgraph:["Estrogen subgraph", "Toll like receptor subgraph"], pmid:"19484750", citationType:"PubMed", citationRef:"19484750"}}, {start: {_id:4395}, end: {_id:4242}, properties:{evidence:"[Estradiol co-treated with Tetrachlorodibenzodioxin] results in decreased expression of S100A9 mRNA", annotationSubgraph:["Estrogen subgraph", "Toll like receptor subgraph"], annotationConfidence:["Medium"], pmid:"19484750", citationType:"PubMed", citationRef:"19484750"}}, {start: {_id:4406}, end: {_id:838}, properties:{evidence:"[celecoxib results in decreased activity of and results in decreased expression of PTGS2 protein] which results in increased expression of PPARG", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], pmid:"19522023", citationType:"PubMed", citationRef:"19522023"}}, {start: {_id:4409}, end: {_id:838}, properties:{evidence:"2,2-bis(4-glycidyloxyphenyl)propane inhibits the reaction [Indomethacin results in increased activity of PPARG protein]", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], pmid:"12065695", citationType:"PubMed", citationRef:"12065695"}}, {start: {_id:2197}, end: {_id:838}, properties:{evidence:"Ethanol inhibits the reaction [pioglitazone results in increased activity of PPARG protein]", pmid:"17019405", citationType:"PubMed", citationRef:"17019405"}}, {start: {_id:4427}, end: {_id:4100}, properties:{evidence:"2-(2-amino-3-methoxyphenyl)-4H-1-benzopyran-4-one inhibits the reaction [resveratrol results in decreased expression of CHI3L1 protein]", pmid:"21029458", citationType:"PubMed", citationRef:"21029458"}}, {start: {_id:2058}, end: {_id:4440}, properties:{evidence:"Caffeine is a widely consumed psychoactive drug, which is emerging as a protective agent against AD progression and in aging associated deficits. This occurs mainly through the blockade of adenosine A2A receptors, whose expression and function become aberrant throughout aging and in age-related pathologies.", annotationSubgraph:["Epigenetic modification subgraph"], annotationSpecies:["9606"], pmid:"21427489", citationType:"PubMed", citationRef:"21427489"}}, {start: {_id:802}, end: {_id:4449}, properties:{evidence:"More recently, it was reported that subchronic exposure to Cd inhibited DNA-methyltransferase activity in cultured cells, while chronic exposure enhanced the activity of the DNA-methyltransferase.", annotationSubgraph:["Epigenetic modification subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19245828", annotationDurationOfChemicalExposure:["Subchronic"], citationType:"PubMed", citationRef:"19245828"}}, {start: {_id:4452}, end: {_id:4447}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"we found that presence of either 5-methylctosine or 8-oxo-dG dramatically suppressed Sp1 DNA-binding;", annotationSubgraph:["Epigenetic modification subgraph"], annotationConfidence:["High"], pmid:"19245828", citationType:"PubMed", citationRef:"19245828"}}, {start: {_id:4107}, end: {_id:4447}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"we found that presence of either 5-methylctosine or 8-oxo-dG dramatically suppressed Sp1 DNA-binding;", annotationSubgraph:["Epigenetic modification subgraph"], annotationConfidence:["High"], pmid:"19245828", citationType:"PubMed", citationRef:"19245828"}}, {start: {_id:4470}, end: {_id:4482}, properties:{evidence:"It has been shown that the MTHFR 677T allele is associated with increased total plasma Hcy levels (tHcy) and decreased serum folate levels, mainly in 677TT homozygous subjects. the MTHFR 677C>T polymorphism as a candidate AD risk factor", annotationSubgraph:["Epigenetic modification subgraph"], annotationMeshanatomy:["Serum"], pmid:"21119889", citationType:"PubMed", citationRef:"21119889"}}, {start: {_id:1799}, end: {_id:2915}, properties:{evidence:"Abeta-derived diffusible ligands, ADDLs reduce drebrin cluster density", pmid:"25058791", citationType:"PubMed", citationRef:"25058791"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
