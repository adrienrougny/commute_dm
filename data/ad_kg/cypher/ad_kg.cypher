UNWIND [{start: {_id:4172}, end: {_id:4171}, properties:{evidence:"In the current communication, we report the structure determined by X-ray crystallography of N-terminal sequence Asp-Ala-Glu-Phe-Arg-His- Asp-Ser (DAEFRHDS) of Abeta-peptide with a Group I PLA2 purified from venom of Andaman Cobra sub-species Naja naja sagittifera at 2.0 Ã… resolution (Protein Data Bank (PDB) Code: 3JQ5).", annotationMeshanatomy:["Venoms"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:4173}, end: {_id:4171}, properties:{evidence:"In the current communication, we report the structure determined by X-ray crystallography of N-terminal sequence Asp-Ala-Glu-Phe-Arg-His- Asp-Ser (DAEFRHDS) of Abeta-peptide with a Group I PLA2 purified from venom of Andaman Cobra sub-species Naja naja sagittifera at 2.0 Ã… resolution (Protein Data Bank (PDB) Code: 3JQ5).", annotationMeshanatomy:["Venoms"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:4172}, end: {_id:4173}, properties:{evidence:"In the current communication, we report the structure determined by X-ray crystallography of N-terminal sequence Asp-Ala-Glu-Phe-Arg-His- Asp-Ser (DAEFRHDS) of Abeta-peptide with a Group I PLA2 purified from venom of Andaman Cobra sub-species Naja naja sagittifera at 2.0 Ã… resolution (Protein Data Bank (PDB) Code: 3JQ5).", annotationMeshanatomy:["Venoms"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:1225}, end: {_id:4183}, properties:{evidence:"We showed that adding luteolin in high-fat diet can significantly reduce body weight gain, food intake and plasma cytokines as well as improving glucose metabolism of mice on HFD.", annotationSpecies:["10090"], annotationMeshanatomy:["Plasma"], pmid:"24667364", citationType:"PubMed", citationRef:"24667364"}}, {start: {_id:1935}, end: {_id:1847}, properties:{evidence:"The brains were then removed and malondialdehyde (MDA) and total thiol groups concentrations were measured.The time latency to enter the dark compartment by OVX-LPS group was shorter than that of OVX at both first and 24th hours after the shock (P < 0.05 - P < 0.001).", annotationMeshanatomy:["Brain"], pmid:"24829769", citationType:"PubMed", citationRef:"24829769"}}, {start: {_id:1935}, end: {_id:1847}, properties:{evidence:"The hippocampal MDA concentration in OVX-LPS group was higher than Sham- LPS group (P < 0.01).Brain tissue oxidative damage contributed in deleterious effects of LPS on learning and memory.", annotationMeshanatomy:["Hippocampus", "Tissues", "Brain"], pmid:"24829769", citationType:"PubMed", citationRef:"24829769"}}, {start: {_id:4260}, end: {_id:4261}, properties:{evidence:"Effects of Naproxen on Immune Responses in a Colchicine-Induced Rat Model of Alzheimer's Disease.", annotationSpecies:["10116"], pmid:"24662962", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24662962"}}, {start: {_id:4260}, end: {_id:4262}, properties:{evidence:"Alterations in immunological parameters [increased phagocytic activity of white blood cells and splenic polymorphonuclear cells (PMN), increased cytotoxicity and decreased leucocyte adhesive inhibition index (LAI) of splenic mononuclear cells (MNC)] were also observed in colchicine-injected rats, which showed a dose-dependent recovery after oral administration of naproxen in AD rats.", annotationSpecies:["10116"], annotationMeshdisease:["Plaque, Amyloid"], annotationMeshanatomy:["Leukocytes"], pmid:"24662962", citationType:"PubMed", citationRef:"24662962"}}, {start: {_id:4261}, end: {_id:4260}, properties:{evidence:"Alterations in immunological parameters [increased phagocytic activity of white blood cells and splenic polymorphonuclear cells (PMN), increased cytotoxicity and decreased leucocyte adhesive inhibition index (LAI) of splenic mononuclear cells (MNC)] were also observed in colchicine-injected rats, which showed a dose-dependent recovery after oral administration of naproxen in AD rats.", annotationSpecies:["10116"], annotationMeshdisease:["Plaque, Amyloid"], annotationMeshanatomy:["Leukocytes"], pmid:"24662962", citationType:"PubMed", citationRef:"24662962"}}, {start: {_id:4283}, end: {_id:2156}, properties:{evidence:"Taken together, our data suggested that rifampicin induced GRP78 via the PERK-eIF2Î±-ATF4 pathway to protect neurons against rotenone- induced cell damage.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshanatomy:["Neurons"], pmid:"24638036", citationType:"PubMed", citationRef:"24638036"}}, {start: {_id:4292}, end: {_id:2197}, properties:{evidence:"The PPARgamma agonist pioglitazone and a novel selective PPARÎ±/gamma modulator, DSP-8658, currently in clinical development for the treatment of type 2 diabetes, enhanced the microglial uptake of Abeta in a PPARgamma-dependent manner.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationConfidence:["Medium"], pmid:"23197723", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"23197723"}}, {start: {_id:93}, end: {_id:3423}, properties:{evidence:"The data indicate that apart from acetylsalicylic acid (aspirin) and simvastatin, several neurophysiologically-relevant concentrations of Abetapeptides and neurotoxic trace metals variably induced ROS induction, COX-2 and cPLA2 expression.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["Medium"], pmid:"24619568", citationType:"PubMed", citationRef:"24619568"}}, {start: {_id:4304}, end: {_id:3423}, properties:{evidence:"The data indicate that apart from acetylsalicylic acid (aspirin) and simvastatin, several neurophysiologically-relevant concentrations of Abetapeptides and neurotoxic trace metals variably induced ROS induction, COX-2 and cPLA2 expression.", annotationSubgraph:["Prostaglandin subgraph"], annotationConfidence:["High"], pmid:"24619568", citationType:"PubMed", citationRef:"24619568"}}, {start: {_id:4138}, 