UNWIND [{start: {_id:2301}, end: {_id:2234}, properties:{evidence:"We have recently reported the existence of a molecular link between decreased p27 levels and enhanced phosphorylation of pRb protein and proliferation of immortalized lymphocytes from Alzheimer's disease (AD) patients.", annotationSubgraph:["Ubiquitin degradation subgraph", "Cyclin-CDK subgraph"], annotationSpecies:["9606"], annotationCell:["lymphocyte"], pmid:"17448572", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17448572"}}] AS row
