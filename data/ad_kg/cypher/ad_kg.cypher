UNWIND [{start: {_id:2666}, end: {_id:466}, properties:{evidence:"Co-expression and pulse-chase experiments showed that a functional apoE:APP interaction occurs intracellularly which directly affects maturation and subsequently the secretion kinetics of APP.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"11523796", citationType:"PubMed", citationRef:"11523796"}}] AS row
