UNWIND [{start: {_id:1766}, end: {_id:1910}, properties:{evidence:"Galantamine and nefiracetam have been shown to potentiate the phasic activity of nicotinic acetylcholine receptors (nAChRss) in the brain. Stimulation of nAChRss is also known to cause release of various neurotransmitters including glutamate and gamma-aminobutyric acid (GABA).", annotationSubgraph:["Acetylcholine signaling subgraph", "GABA subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19272425", citationType:"PubMed", citationRef:"19272425"}}, {start: {_id:1768}, end: {_id:1910}, properties:{evidence:"Galantamine and nefiracetam have been shown to potentiate the phasic activity of nicotinic acetylcholine receptors (nAChRss) in the brain. Stimulation of nAChRss is also known to cause release of various neurotransmitters including glutamate and gamma-aminobutyric acid (GABA).", annotationSubgraph:["Acetylcholine signaling subgraph", "GABA subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19272425", citationType:"PubMed", citationRef:"19272425"}}, {start: {_id:1770}, end: {_id:1910}, properties:{evidence:"Galantamine and nefiracetam have been shown to potentiate the phasic activity of nicotinic acetylcholine receptors (nAChRss) in the brain. Stimulation of nAChRss is also known to cause release of various neurotransmitters including glutamate and gamma-aminobutyric acid (GABA).", annotationSubgraph:["Acetylcholine signaling subgraph", "GABA subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19272425", citationType:"PubMed", citationRef:"19272425"}}, {start: {_id:1772}, end: {_id:1910}, properties:{evidence:"Galantamine and nefiracetam have been shown to potentiate the phasic activity of nicotinic acetylcholine receptors (nAChRss) in the brain. Stimulation of nAChRss is also known to cause release of various neurotransmitters including glutamate and gamma-aminobutyric acid (GABA).", annotationSubgraph:["Acetylcholine signaling subgraph", "GABA subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19272425", citationType:"PubMed", citationRef:"19272425"}}, {start: {_id:1774}, end: {_id:1910}, properties:{evidence:"Galantamine and nefiracetam have been shown to potentiate the phasic activity of nicotinic acetylcholine receptors (nAChRss) in the brain. Stimulation of nAChRss is also known to cause release of various neurotransmitters including glutamate and gamma-aminobutyric acid (GABA).", annotationSubgraph:["Acetylcholine signaling subgraph", "GABA subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19272425", citationType:"PubMed", citationRef:"19272425"}}, {start: {_id:1776}, end: {_id:1910}, properties:{evidence:"Galantamine and nefiracetam have been shown to potentiate the phasic activity of nicotinic acetylcholine receptors (nAChRss) in the brain. Stimulation of nAChRss is also known to cause release of various neurotransmitters including glutamate and gamma-aminobutyric acid (GABA).", annotationSubgraph:["Acetylcholine signaling subgraph", "GABA subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19272425", citationType:"PubMed", citationRef:"19272425"}}, {start: {_id:1778}, end: {_id:1910}, properties:{evidence:"Galantamine and nefiracetam have been shown to potentiate the phasic activity of nicotinic acetylcholine receptors (nAChRss) in the brain. Stimulation of nAChRss is also known to cause release of various neurotransmitters including glutamate and gamma-aminobutyric acid (GABA).", annotationSubgraph:["Acetylcholine signaling subgraph", "GABA subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19272425", citationType:"PubMed", citationRef:"19272425"}}, {start: {_id:1780}, end: {_id:1910}, properties:{evidence:"Galantamine and nefiracetam have been shown to potentiate the phasic activity of nicotinic acetylcholine receptors (nAChRss) in the brain. Stimulation of nAChRss is also known to cause release of various neurotransmitters including glutamate and gamma-aminobutyric acid (GABA).", annotationSubgraph:["Acetylcholine signaling subgraph", "GABA subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19272425", citationType:"PubMed", citationRef:"19272425"}}, {start: {_id:457}, end: {_id:3}, properties:{evidence:"These findings raise the possibility that the JNK pathway may also contribute to Abeta-dependent death in AD patients.", annotationSubgraph:["MAPK-JNK subgraph", "Amyloidogenic subgraph"], annotationSpecies:["9606"], annotationConfidence:["Medium"], pmid:"11567045", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"11567045"}}, {start: {_id:2312}, end: {_id:93}, properties:{evidence:"Activated gadd153 can generate oxidative damage and reactive oxygen species (ROS), increase beta-amyloid (Abeta) levels, disturb iron homeostasis and induce inflammation as well as cell death, which are all pathological hallmarks of AD.", annotationSubgraph:["Reactive oxygen species subgraph", "Response DNA damage"], annotationMeshdisease:["Inflammation", "Alzheimer Disease"], annotationConfidence:["Medium"], pmid:"22046282", citationType:"PubMed", citationRef:"22046282"}}, {start: {_id:2457}, end: {_id:3}, properties:{evidence:"We have previously reported that CysLT1R activation is involved in Abeta generation. In this study, we investigated rescuing effect of CysLT1R antagonist montelukast on Abeta1-42-induced neurotoxicity in primary neurons. Our data showed that Abeta1-42 elicited a marked increase of CysLT1R expression in primary mouse neurons. This increment of CysLT1R expression was accompanied by increases of inflammatory factors such as NF-ÎºB p65, tumor necrosis factor-Î± (TNFÎ±) and interleukin-1beta (IL-1beta) as well as pro-apoptotic protein Caspase-3 activation and anti-apoptotic process protein Bcl-2 reduction. This observation was confirmed with treatment of montelukast, a selective CysLT1R antagonist, which had significant effect on Abeta1-42-induced cytotoxicity. Moreover, blockade of CysLT1R with montelukast reversed Abeta1-42-mediated increase of CysLT1R expression, and concomitant changes of the pro-inflammatory factors and the apoptotic process-related proteins. The results demonstrate that montelukast rescued neurons against Abeta1-42-induced neurotoxicity, neuroinflammation and apoptosis by down-regulating CysLT1R-mediated NF-ÎºB signaling, suggesting that CysLT1R may be a potential target for AD, and its antagonist may have beneficial effects for treatment of AD.", annotationSubgraph:["Amyloidogenic subgraph"], annotationSpecies:["10090"], annotationConfidence:["Medium"], pmid:"24879954", citationType:"PubMed", citationRef:"24879954"}}, {start: {_id:2563}, end: {_id:93}, properties:{evidence:"Activation of PLA2 in cerebral ischemia has been shown while other studies have separately demonstrated increased lipid peroxidation. Dissecting the contribution of PLA2 to lipid peroxidation in cerebral ischemia is challenging due to multiple forms of PLA2, cardiolipin hydrolysis, diverse sources of ROS arising from arachidonic acid metabolism, catecholamine autoxidation, xanthine oxidase activity, mitochondrial dysfunction, activated neutrophils coupled with NADPH oxidase activity, and lack of specific inhibitors. Cardiolipin hydrolysis by mitochondrial sPLA2 disrupts the mitochondrial respiratory chain and increases production of reactive oxygen species (ROS). Oxidative metabolism of arachidonic acid also generates ROS.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["Medium"], pmid:"16443152", citationType:"PubMed", citationRef:"16443152"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"A pathogenic mutation at codons 670/671 in APP (APP Swedish) leads to enhanced cleavage at the beta-secretase scissile bond and increased Abeta formation.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"10500121", citationType:"PubMed", citationRef:"10500121"}}, {start: {_id:86}, end: {_id:3}, properties:{evidence:"These data suggest that BACE2 contributes to Abeta production in individuals bearing the Flemish mutation, and that selective inhibition of these highly similar proteases may be feasible and therapeutically advantageous.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"10931940", citationType:"PubMed", citationRef:"10931940"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The novel transmembrane aspartic protease BACE (for Beta-site APP Cleaving Enzyme) is the beta-secretase that cleaves amyloid precursor protein to initiate beta-amyloid formation.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"10956649", citationType:"PubMed", citationRef:"10956649"}}, {start: {_id:86}, end: {_id:3}, properties:{evidence:"BACE2 cleaves the amyloid precursor protein at the beta-secretase site and is thought to contribute to amyloid beta protein production.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12052539", citationType:"PubMed", citationRef:"12052539"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Amyloid-beta (Abeta) the primary component of the senile plaques found in Alzheimer's disease (AD) is generated by the rate-limiting cleavage of amyloid precursor protein (APP) by beta-secretase followed by gamma-secretase cleavage.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15452128", citationType:"PubMed", citationRef:"15452128"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The generation of beta-amyloid peptides requires the enzymatic activity of the beta-site APP-cleaving enzyme 1 (BACE1).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15465276", citationType:"PubMed", citationRef:"15465276"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The generation of beta-amyloid peptides by proteolytical processing of the amyloid precursor protein (APP) requires the enzymatic activity of the beta-site APP cleaving enzyme 1 (BACE1).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"15663471", citationType:"PubMed", citationRef:"15663471"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Sequential processing of amyloid precursor protein (APP) by membrane- bound proteases, BACE1 and gamma-secretase, plays a crucial role in the pathogenesis of Alzheimer disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15824102", citationType:"PubMed", citationRef:"15824102"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:21}, end: {_id:3}, properties:{evidence:"gamma-Secretase is a membrane protein complex that cleaves the beta- amyloid precursor protein (APP) within the transmembrane region, after prior processing by beta-secretase, producing amyloid beta peptides Abeta(40) and Abeta(42).", pmid:"15890777", citationType:"PubMed", citationRef:"15890777"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Release of Abeta from the amyloid precursor protein (APP) requires proteolysis by the beta-site APP-cleaving enzyme (BACE1).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16027115", citationType:"PubMed", citationRef:"16027115"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Abeta is produced from beta-amyloid precursor protein (APP) by beta- secretase and gamma-secretase. beta-Secretase has been identified as beta-site APP cleaving enzyme1 (BACE1).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16290302", citationType:"PubMed", citationRef:"16290302"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The beta-amyloid peptide (Abeta) is a major component of the Alzheimer's disease (AD)-associated senile plaques and is generated by sequential cleavage of the beta-amyloid precursor protein (APP) by beta-secretase and gamma-secretase.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16888322", citationType:"PubMed", citationRef:"16888322"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Amyloid beta-peptide (Abeta), which is a product of the proteolytic effect of beta-secretase (BACE) on an amyloid precursor protein, is closely associated with Alzheimer's disease (AD) pathogenesis.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17205046", citationType:"PubMed", citationRef:"17205046"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"TNF-alpha directly stimulated beta-site APP-cleaving enzyme (BACE1) expression and enhanced beta-processing of APP in astrocytes.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17255335", citationType:"PubMed", citationRef:"17255335"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Alzheimer's disease (AD) is associated with accumulation of the neurotoxic peptide amyloid-beta (Abeta), which is produced by sequential cleavage of amyloid precursor protein (APP) by the aspartyl protease beta-secretase and the presenilin-dependent protease gamma- secretase.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17360493", citationType:"PubMed", citationRef:"17360493"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Such an approach limits APP processing by beta-secretase, mainly through the endocytic pathway, and overcomes some of the limitations of BACE inhibition.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17536186", citationType:"PubMed", citationRef:"17536186"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Proteolytic processing of the amyloid precursor protein (APP) by beta- secretase, beta-site APP cleaving enzyme (BACE1), is the initial step in the production of the amyloid beta (Abeta) peptide, which is involved in the pathogenesis of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"17573534", citationType:"PubMed", citationRef:"17573534"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"To address this issue, temporal neocortex of 27 AD and 21 non-demented control brains was examined to assess mRNA levels of APP isoforms (total APP, APP containing the Kunitz protease inhibitor domain [APP- KPI] and APP770) and APP metabolic enzymatic partners (the APP cleaving enzymes beta-secretase [BACE] and presenilin-1 [PS-1], and putative clearance molecules, low-density lipoprotein receptor protein [LRP] and apolipoprotein E [apoE]).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17586478", citationType:"PubMed", citationRef:"17586478"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Pathologically, AD is characterized by the deposition in the brain of amyloid-beta peptides derived from proteolysis of amyloid precursor protein (APP) by beta-site APP cleaving enzyme 1 (BACE1) and gamma- secretase.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17611486", citationType:"PubMed", citationRef:"17611486"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Abeta is generated by proteolytic processing of amyloid precursor protein (APP) via beta and gamma-secretases.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17908048", citationType:"PubMed", citationRef:"17908048"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Proteolytic cleavage of amyloid precursor protein by beta-secretase (BACE-1) and gamma-secretase leads to formation of beta-amyloid (A beta) a key component of amyloid plaques, which are considered the hallmark of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18162398", citationType:"PubMed", citationRef:"18162398"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Here we describe that the two enzymatic activities responsible for Abeta production, beta-secretase and gamma-secretase, are inhibited in parallel by cholesterol reduction.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18308724", citationType:"PubMed", citationRef:"18308724"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"There was also an induced expression of the key APP processing enzyme i.e. beta-site APP cleaving enzyme 1 in both high fat/cholesterol-fed C57BL/6 and LDLR-/- mice accompanied by an increased generation of C-terminal fragments of APP.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18410513", citationType:"PubMed", citationRef:"18410513"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The study provides new cell-based assays for the profiling of small molecule inhibitors of QC and points to conspicuous differences in processing of APP depending on sequence at the beta-secretase cleavage site.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18570439", citationType:"PubMed", citationRef:"18570439"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The Abeta peptide results from cleavage of APP initially by BACE1 to produce the C99 fragment and releases soluble APPbeta (sAPPbeta); C99 is then further cleaved by gamma-secretase leading to the Abeta peptide.", pmid:"18609117", citationType:"PubMed", citationRef:"18609117"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Here, we show that lysines 587 and 595 of APP, which are immediately adjacent to the site of beta-secretase cleavage, are covalently pmodified by SUMO proteins in vivo.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"18675254", citationType:"PubMed", citationRef:"18675254"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Specifically, hypoxia significantly increases beta-site APP cleaving enzyme (BACE1) gene transcription through the over-expression of hypoxia inducible factor 1alpha, resulting in increased BACE1 secretase activity and amyloid-beta production.", annotationSubgraph:["Hypoxia response subgraph", "Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19196431", citationType:"PubMed", citationRef:"19196431"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"It is produced from amyloid precursor protein (APP) by proteolytic processing dependent on the beta-site APP-cleaving enzyme 1 (BACE1) and gamma-secretase, and is degraded by a broad range of proteases.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19199126", citationType:"PubMed", citationRef:"19199126"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:21}, end: {_id:3}, properties:{evidence:"Three-dimensional quantitative structure-activity relationship (3D-QSAR) pmodels were developed based on comparative molecular field analysis (CoMFA) and comparative molecular similarity indices analysis (CoMSIA), on a series of 43 hydroxyethylamine derivatives, acting as potent inhibitors of beta-site amyloid precursor protein (APP) cleavage enzyme (BACE-1).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19330459", citationType:"PubMed", citationRef:"19330459"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"beta-Site amyloid precursor protein (APP) cleaving enzyme 1 (BACE1) is a membrane-bound protease that is essential for the production of beta-amyloid protein (Abeta).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19405102", citationType:"PubMed", citationRef:"19405102"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Expression levels of the amyloid precursor protein (APP) and beta-site amyloid (Abeta) cleaving enzyme 1 (BACE1) have been implicated in Alzheimer disease (AD) progression.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19462468", citationType:"PubMed", citationRef:"19462468"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The effect of nicotine (2 mg/(kg day)) on Abeta-induced spatial learning and memory impairments was assessed by evaluation of performance in the radial arm water maze (RAWM), in vivo electrophysiological recordings of early-phase long-term potentiation (E-LTP) in urethane-anesthetized rats, and immunoblot analysis to determine changes in the levels of beta-site amyloid precursor protein (APP)-cleaving enzyme (BACE), Abeta and memory-related protei", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19464074", citationType:"PubMed", citationRef:"19464074"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Beta-site amyloid precursor protein cleaving enzyme (BACE1) is the rate-limiting enzyme for production of beta-amyloid peptides (Abeta), which are proposed to drive the pathological changes found in Alzheimer's disease (AD).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19669607", citationType:"PubMed", citationRef:"19669607"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Core CSF biomarkers include secreted Abeta and amyloid precursor protein (APP) isoforms, Abeta oligomers and beta-site APP-cleaving enzyme 1 (BACE1).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19698775", citationType:"PubMed", citationRef:"19698775"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"In the amyloidogenic pathway, a small proportion of APP is cleaved by beta- and gamma-secretases, known as beta-site APP-cleaving enzyme 1 (BACE1) and presenilin, respectively, leading to the secretion of Abeta peptides.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19729516", citationType:"PubMed", citationRef:"19729516"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"A beta is generated upon the sequential proteolytic cleavage of transmembrane amyloid precursor protein (APP) by two membrane-bound proteases, beta-secretase (BACE1) and the gamma-secretase complex comprising presenilin 1 (PS1), nicastrin, APH-1 and PEN-2.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19885829", citationType:"PubMed", citationRef:"19885829"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"In Alzheimer disease, this feedback loop is disrupted, and the increased level of Abeta oligomers bind to PrP(C) and prevent it from regulating BACE1 activity. PrP(C) interacts with and inhibits the beta-secretase BACE1, the rate-limiting enzyme in the production of Abeta.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19887909", citationType:"PubMed", citationRef:"19887909"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The beta-site APP cleaving enzyme (BACE1) is responsible for the first step in the production of the beta-amyloid protein of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20067575", citationType:"PubMed", citationRef:"20067575"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"beta-Site amyloid precursor protein cleaving enzyme 1 (BACE1) initiates amyloid-beta (Abeta) generation that is central to the pathophysiology of Alzheimer's disease (AD). Therefore, lowering Abeta levels by BACE1 manipulations represents a key therapeutic strategy, but it remains unclear whether partial inhibition of BACE1, as expected for AD treatments, can improve memory deficits.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20089133", citationType:"PubMed", citationRef:"20089133"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Abeta is generated from AbetaPP through an initial cleavage by the beta-secretase, BACE-1, which results in the generation of the soluble AbetaPPbeta fragment (sAbetaPPbeta) and the membrane bound C-terminal fragment beta (CTFbeta or C99).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20157255", citationType:"PubMed", citationRef:"20157255"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"We previously indicated that amyloid beta (Abeta) augments protein levels of beta-site amyloid precursor protein cleaving enzyme-1 (BACE-1) through oxidative stress.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20171164", citationType:"PubMed", citationRef:"20171164"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Abeta is derived from a type I transmembrane protein, amyloid precursor protein (APP), by the sequential proteolytic events mediated by beta-site APP cleaving enzyme 1 (BACE1) and gamma-secretase.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20303415", citationType:"PubMed", citationRef:"20303415"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Medium", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"20409323", citationType:"PubMed", citationRef:"20409323"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Basic understanding of the activities of the amyloid beta peptide (Abeta) and associated proteins such as beta-site APP-cleaving enzyme 1 (BACE1) is necessary to develop effective medical responses to AD.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20451519", citationType:"PubMed", citationRef:"20451519"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Cleavage of APP by BACE1 is the first proteolytic step in the production of amyloid-beta (Abeta), which accumulates in senile plaques in Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20685197", citationType:"PubMed", citationRef:"20685197"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Abeta is generated from the beta-amyloid precursor protein (APP) through the proteolysis of beta-site APP cleaving enzyme 1 (BACE1) and gamma-secretase.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20727383", citationType:"PubMed", citationRef:"20727383"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The Swedish mutation (K595N/M596L) of amyloid precursor protein (APP- swe) has been known to increase abnormal cleavage of cellular APP by Beta-secretase (BACE), which causes tau protein hyperphosphorylation and early-onset Alzheimer's disease (AD).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21034535", citationType:"PubMed", citationRef:"21034535"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Amyloid-beta peptide (Abeta) is generated by sequential cleavage of the amyloid precursor protein (APP) by beta-site amyloid precursor protein cleaving enzyme 1 (beta-secretase, or BACE1) and gamma- secretase.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21433051", citationType:"PubMed", citationRef:"21433051"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:21}, end: {_id:3}, properties:{evidence:"To release the amyloidogenic peptide A beta from the Alzheimer amyloid precursor protein (APP), two secretases act sequentially: first, beta- secretase cleaves close to the membrane within the ectodomain and then gamma-secretase cuts within the transmembrane domain.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"9623986", citationType:"PubMed", citationRef:"9623986"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Proteolytic processing of APP by beta-secretase, on the other hand, exposes the N-terminus of beta-amyloid, which is liberated after gamma-secretase cleavage at the variable amyloid C-terminus.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"9775403", citationType:"PubMed", citationRef:"9775403"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Pulse-chase experiments revealed beta-secretase cleavage from immature full-length amyloid precursor protein harboring the Swedish mutation.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"10096041", citationType:"PubMed", citationRef:"10096041"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Solubilized Asp2 protein cleaves a synthetic APP peptide substrate at the beta-secretase site, and the rate of cleavage is increased tenfold by a mutation associated with early-onset Alzheimer's disease in Sweden.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"10591213", citationType:"PubMed", citationRef:"10591213"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Recombinant memapsin 2 specifically hydrolyzed peptides derived from the beta-secretase site of both the wild-type and Swedish mutant beta- amyloid precursor protein (APP) with over 60-fold increase of catalytic efficiency for the latter. Human aspartic protease memapsin 2 cleaves the beta-secretase site of beta-amyloid precursor protein.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"10677483", citationType:"PubMed", citationRef:"10677483"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"IFNgamma in combination with TNFalpha or IL-1beta seems to trigger Abeta production by supporting beta-secretase cleavage of the immature APP molecule.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11114266", citationType:"PubMed", citationRef:"11114266"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Amyloid precursor protein/P-selectin, which is sorted from early to late endosomes, undergoes significantly less alpha-secretase cleavage, and more beta-secretase cleavage, than amyloid precursor protein/P-selectin768A, a mutant that recycles more efficiently to the cell surface.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11737828", citationType:"PubMed", citationRef:"11737828"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Homeostatic APPsbetaswe levels with aging suggest that progressive amyloid deposition in brain results not from increased beta-secretase cleavage of APP but from impaired Abeta/amyloid clearance mechanisms.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11839594", citationType:"PubMed", citationRef:"11839594"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"beta-Site APP-cleaving enzyme (BACE) initiates the processing of the amyloid precursor protein (APP) leading to the generation of beta- amyloid, the main component of Alzheimer's disease senile plaques.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11953458", citationType:"PubMed", citationRef:"11953458"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Beta-secretase cleavage represents the first step in the generation of Abeta polypeptides and initiates the amyloid cascade that leads to neurodegeneration in Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12112088", citationType:"PubMed", citationRef:"12112088"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Our recent knockout studies show that BACE1 is critical for Abeta generation, but the knockout mice show an otherwise normal phenotype, raising the possibility that therapeutic BACE1 inhibition could be accomplished without major mechanism based toxicity.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12470797", citationType:"PubMed", citationRef:"12470797"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"BACE1 is a membrane-bound aspartic protease that cleaves the amyloid precursor protein (APP) at the beta-secretase site, a critical step in the Alzheimer disease pathogenesis.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12473667", citationType:"PubMed", citationRef:"12473667"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"APP is cleaved either by beta-secretase or by alpha-secretase to initiate amyloidogenic (release of A beta) or nonamyloidogenic processing of APP, respectively.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12515826", citationType:"PubMed", citationRef:"12515826"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Employing a superior BACE1 cleavage sequence to probe cellular APP processing.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12603825", citationType:"PubMed", citationRef:"12603825"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"An integral membrane aspartyl protease, BACE, is responsible for beta- secretase processing of the beta-amyloid precursor protein (APP) to the large secreted sAPPbeta and membrane-bound CTFbeta of 99 residues.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"14501002", citationType:"PubMed", citationRef:"14501002"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Here we report evidence that heparan sulfate (HS) interacts with beta- site APP-cleaving enzyme (BACE) 1 and regulates its cleavage of APP.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"14530380", citationType:"PubMed", citationRef:"14530380"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Together, these results suggest that T668 phosphorylation may facilitate the BACE1 cleavage of APP to increase Abeta generation.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"14557249", citationType:"PubMed", citationRef:"14557249"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Our results indicate that BACE1 siRNA specifically impacts on beta- cleavage of APP and may be a potential therapeutic approach for treating AD.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"14600149", citationType:"PubMed", citationRef:"14600149"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The cerebral deposition of amyloid beta-peptide (Abeta) is a major factor in the etiology of Alzheimer's disease. beta-Secretase (BACE) initiates the generation of Abeta by cleaving the amyloid precursor protein at the beta-site and is therefore a prime target for therapeutic intervention.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"14622952", citationType:"PubMed", citationRef:"14622952"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"BACE1, the major beta-secretase involved in cleaving APP, has been identified as a type 1 membrane-associated aspartyl protease.", pmid:"14701757", citationType:"PubMed", citationRef:"14701757"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
