UNWIND [{start: {_id:21}, end: {_id:3}, properties:{evidence:"Beta-site APP-cleaving enzyme (BACE) is required for production of the Alzheimer's disease (AD)-associated Abeta protein.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17553422", citationType:"PubMed", citationRef:"17553422"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The aspartyl protease beta-site amyloid precursor protein cleaving enzyme 1 (BACE1) initiates processing of amyloid precursor protein (APP) into amyloid beta (Abeta) peptide, the major component of Alzheimer disease (AD) plaques.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17616527", citationType:"PubMed", citationRef:"17616527"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The proteolytic enzyme beta-secretase (BACE-1) produces amyloid beta (Abeta) peptide, the primary constituent of neurofibrillary plaques, implicated in Alzheimer's disease, by cleavage of the amyloid precursor protein.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18068983", citationType:"PubMed", citationRef:"18068983"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Beta-amyloid (Abeta) peptides that accumulate in Alzheimer disease are generated from the beta-amyloid precursor protein (betaAPP) by cleavages by beta-secretase BACE1 and by presenilin-dependent gamma- secretase activities.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18263584", citationType:"PubMed", citationRef:"18263584"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Consequently, inhibition of BACE-1, a rate-limiting enzyme in the production of Abeta, is an attractive therapeutic approach for the treatment of AD.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18295609", citationType:"PubMed", citationRef:"18295609"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"In our opinion, albeit based on limited available data, a future potential therapeutic strategy is to mimic the mechanism by which the normal cellular form of the prion protein inhibits the beta-secretase beta-site amyloid precursor protein cleaving enzyme-1 (BACE1), and hence the production of Abeta.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18479216", citationType:"PubMed", citationRef:"18479216"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"BACE-1 cleavage is limiting for the production of Abeta, making it a particularly good drug target for the generation of inhibitors that lower Abeta.", pmid:"18673212", citationType:"PubMed", citationRef:"18673212"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"One group described the poor kinetics of BACE 1 for cleaving the wild- type (WT) beta-secretase site of APP found in most AD patients.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18979625", citationType:"PubMed", citationRef:"18979625"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"These results indicate that post-translational S-palmitoylation of BACE1 is not required for APP processing, and that BACE1 can efficiently cleave APP in both raft and non-raft microdomains.", pmid:"19074428", citationType:"PubMed", citationRef:"19074428"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Because beta-site APP-cleaving enzyme 1 (BACE1), an essential protease for Abeta production, is up-regulated in cells overexpressing RAGE and in RAGE-injected brains of Tg2576 mice, the molecular mechanisms underlying RAGE, BACE1 expression, and Abeta production were examined.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19332646", citationType:"PubMed", citationRef:"19332646"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"However, unlike BRI2, the binding of BRI3 to the beta-secretase cleaved APP C-terminal fragment is negligible and BRI3 does not cause the massive accumulation of this APP fragment, suggesting that, unlike BRI2, BRI3 is a poor gamma-cleavage inhibitor.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19366692", citationType:"PubMed", citationRef:"19366692"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"BACE 1 (beta-site APP-cleaving enzyme 1 or beta-secretase), the key enzyme required for generating Abeta from the beta-amyloid precursor protein (APP), is regarded as an ideal target for AD therapeutic drug design.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19442147", citationType:"PubMed", citationRef:"19442147"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The beta-secretase, beta-site amyloid precursor protein cleaving enzyme (BACE1; also called Asp2, memapsin 2), is the enzyme responsible for initiating Abeta generation.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19828790", citationType:"PubMed", citationRef:"19828790"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"BACE1 initiates the amyloidogenic processing of APP; therefore, early or active amyloidogenic loci might exhibit site-specific BACE1 and Abeta elevation.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20092570", citationType:"PubMed", citationRef:"20092570"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Taken together, ATXN1 functions as a genetic risk pmodifier that contributes to AD pathogenesis through a loss-of-function mechanism by regulating beta-secretase cleavage of APP and Abeta levels.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20097758", citationType:"PubMed", citationRef:"20097758"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Three proteases that are involved in the processing of amyloid precursor protein-alpha-secretase, beta-secretase and gamma-secretase- are of particular interest as they are central to the generation and pmodulation of amyloid-beta peptide and can be targeted by small compounds in vitro and in vivo.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20139999", citationType:"PubMed", citationRef:"20139999"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Although pmoderate decreases of either gamma-secretase or BACE1 are not associated with mechanism-based toxicities, they provide only pmodest benefits in reducing Abeta in the brains of APPswe/PS1DeltaE9 mice.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20371462", citationType:"PubMed", citationRef:"20371462"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Reticulons are a group of membrane-bound proteins involved in diverse cellular functions, and are suggested to act as inhibitors of beta- secretase enzyme 1 (BACE1) activity that cleaves amyloid precursor protein.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20374499", citationType:"PubMed", citationRef:"20374499"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Here we tested the possibility of targeting the cellular environment of beta-secretase cleavage instead of the beta-secretase enzyme itself. beta-Secretase has an acidic pH optimum and cleaves the amyloid precursor protein in the acidic endosomes.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20592218", citationType:"PubMed", citationRef:"20592218"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"ABCA2 expression promoted b-secretase (BACE1) cleavage of APP not at the common Asp1 amino acid site (beta-site) of Abeta in APP but at the Glu11 site (beta'-site) to increase C89 carboxyl-terminal fragment levels (beta'-CTF/C89).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20704561", citationType:"PubMed", citationRef:"20704561"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:21}, end: {_id:3}, properties:{evidence:"We discovered a nonpeptidic compound, TAK-070, that inhibited BACE1, a rate-limiting protease for the generation of Abeta peptides that are considered causative for Alzheimer's disease (AD), in a noncompetitive manner.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20720123", citationType:"PubMed", citationRef:"20720123"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Western blot analyses detected increased levels of BACE1 protein and beta-site-cleavage amyloid precursor protein C-terminal fragments in plaque-bearing human and monkey cortex relative to controls.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20726888", citationType:"PubMed", citationRef:"20726888"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"beta-Site APP-cleaving enzyme 1 (BACE1) initiates amyloid-beta (Abeta) generation and thus represents a prime therapeutic target in treating Alzheimer's disease (AD).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20886088", citationType:"PubMed", citationRef:"20886088"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Importantly, recent evidence reveals that expression and activity levels of the beta-site APP cleaving enzyme 1 (BACE1), which initiates amyloid-beta (Abeta) production, are elevated in AD brains.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21059265", citationType:"PubMed", citationRef:"21059265"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"BACE1 (beta-site beta-amyloid precursor protein (APP)-cleaving enzyme 1) mediates the first proteolytic cleavage of APP, leading to amyloid beta-peptide (Abeta) production.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21245145", citationType:"PubMed", citationRef:"21245145"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Increased beta-secretase cleavage of APP after introduction of the Swedish double mutation causes apical missorting of about 20% of beta- secretase-cleaved APP.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"7876155", citationType:"PubMed", citationRef:"7876155"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Taken together, the data suggest that the processing pathway for betaPP is similar for both betaPP-wt and betaPP-sw cells and that increased Abeta production by betaPP-sw cells arises from enhanced cleavage of mutant betaPP by beta-secretase, the as-yet unidentified enzyme(s) that cleaves at the NH2 terminus of Abeta.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"8621560", citationType:"PubMed", citationRef:"8621560"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Heparin promotes beta-secretase cleavage of the Alzheimer's amyloid precursor protein.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"9152995", citationType:"PubMed", citationRef:"9152995"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Sequential proteolytic cleavage of APP by beta-secretase and gamma- secretase liberates Abeta from APP.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20731541", citationType:"PubMed", citationRef:"20731541"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"beta-Secretase (BACE) carries out the first of two proteolysis steps to generate the amyloid-beta peptides that accumulate in the senile plaques in Alzheimer's disease (AD).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15466887", citationType:"PubMed", citationRef:"15466887"}}, {start: {_id:3047}, end: {_id:3}, properties:{evidence:"Cathepsin B cleaves the wild-type beta-secretase site sequence in AbetaPP to produce Abeta, and cathepsin B inhibitors administered to animal pmodels expressing AbetaPP containing the wild-type beta- secretase site sequence reduce brain Abeta in a manner consistent with beta-secretase inhibition.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21613740", citationType:"PubMed", citationRef:"21613740"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"LRRTM3 promotes processing of amyloid-precursor protein by BACE1", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17098871", citationType:"PubMed", citationRef:"17098871"}}, {start: {_id:3190}, end: {_id:3}, properties:{evidence:"OBJECTIVE: Urinary-type plasminogen activator (uPA) binding to uPA receptor (uPAR) promotes the activation of matrix metalloproteinase-9 (MMP-9), which degrades amyloid beta protein (Abeta) in vitro.", annotationSubgraph:["Amyloidogenic subgraph", "Matrix metalloproteinase subgraph"], annotationConfidence:["Medium"], pmid:"11327298", citationType:"PubMed", citationRef:"11327298"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The complex mediates the intramembraneous proteolysis of beta- secretase cleaved beta-amyloid precursor protein (APP) leading to the secretion of the Alzheimer's disease-associated amyloid beta-peptide (Abeta).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15189355", citationType:"PubMed", citationRef:"15189355"}}, {start: {_id:3233}, end: {_id:3}, properties:{evidence:"This cleavage is similar to the PS-dependent gamma-secretase cleavage of the beta-amyloid precursor protein (betaAPP).", annotationSubgraph:["Gamma secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12374741", citationType:"PubMed", citationRef:"12374741"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The familial Alzheimer's disease gene product amyloid beta precursor protein (APP) is sequentially processed by beta- and gamma-secretases to generate the Abeta peptide.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11724784", citationType:"PubMed", citationRef:"11724784"}}, {start: {_id:215}, end: {_id:432}, properties:{evidence:"PS1 also modulates basal level of ERK1/2 activity through a ras-Raf- MEK-dependent pathway activated by a direct binding with the SH2 domain of Grb2. ERK family is one of the most ubiquitous cellular signaling mechanisms, whose activation links extracellular stimuli to cell proliferation, survival, and differentiation, but also cell death and apoptotic process. In this respect, it is worth of note to observe, as mentioned above, that ERK1/2 pathway is also modulated by AbetaPP", annotationSubgraph:["Gamma secretase subgraph", "MAPK-ERK subgraph"], annotationConfidence:["High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:3687}, end: {_id:3}, properties:{evidence:"In animal models as well as in humans, the activation of muscarinic M1 acetylcholine receptors increases a-secretase cleavage of APP and consequently reduces ABeta¸ levels [63, 64] whereas activation of NMDARs decreases a-secretase cleavage, consequently increasing ABeta¸ levels [65]. Stimulation with muscarinic agonists or activators of protein kinase C (PKC), such as phorbol esters causes the up- regulation of the a-secretase cleavage of APP", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:1905}, end: {_id:3}, properties:{evidence:"In animal models as well as in humans, the activation of muscarinic M1 acetylcholine receptors increases a-secretase cleavage of APP and consequently reduces ABeta¸ levels [63, 64] whereas activation of NMDARs decreases a-secretase cleavage, consequently increasing ABeta¸ levels [65]. Stimulation with muscarinic agonists or activators of protein kinase C (PKC), such as phorbol esters causes the up- regulation of the a-secretase cleavage of APP", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:3688}, end: {_id:3}, properties:{evidence:"In animal models as well as in humans, the activation of muscarinic M1 acetylcholine receptors increases a-secretase cleavage of APP and consequently reduces ABeta¸ levels [63, 64] whereas activation of NMDARs decreases a-secretase cleavage, consequently increasing ABeta¸ levels [65]. Stimulation with muscarinic agonists or activators of protein kinase C (PKC), such as phorbol esters causes the up- regulation of the a-secretase cleavage of APP", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}] AS row
