UNWIND [{start: {_id:2100}, end: {_id:2121}, properties:{evidence:"Hence, it is predicted that zif268 may regulate transcription of genes associated with glutamate receptors and/or GABA(A)Rs.", annotationSubgraph:["Gamma secretase subgraph", "GABA subgraph"], annotationConfidence:["Medium"], pmid:"19909279", citationType:"PubMed", citationRef:"19909279"}}, {start: {_id:2100}, end: {_id:2122}, properties:{evidence:"Hence, it is predicted that zif268 may regulate transcription of genes associated with glutamate receptors and/or GABA(A)Rs.", annotationSubgraph:["Gamma secretase subgraph", "GABA subgraph"], annotationConfidence:["Medium"], pmid:"19909279", citationType:"PubMed", citationRef:"19909279"}}, {start: {_id:2100}, end: {_id:2123}, properties:{evidence:"Hence, it is predicted that zif268 may regulate transcription of genes associated with glutamate receptors and/or GABA(A)Rs.", annotationSubgraph:["Gamma secretase subgraph", "GABA subgraph"], annotationConfidence:["Medium"], pmid:"19909279", citationType:"PubMed", citationRef:"19909279"}}, {start: {_id:2100}, end: {_id:165}, properties:{evidence:"Hence, it is predicted that zif268 may regulate transcription of genes associated with glutamate receptors and/or GABA(A)Rs.", annotationSubgraph:["Gamma secretase subgraph", "GABA subgraph"], annotationConfidence:["Medium"], pmid:"19909279", citationType:"PubMed", citationRef:"19909279"}}, {start: {_id:666}, end: {_id:6}, properties:{evidence:"Cellular prion protein regulates beta-secretase cleavage of the Alzheimer's amyloid precursor protein.", annotationSubgraph:["Beta secretase subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17573534", citationType:"PubMed", citationRef:"17573534"}}, {start: {_id:37}, end: {_id:389}, properties:{evidence:"For instance, PS1 binds to beta-catenin and pmodulates beta-catenin signaling.", annotationSubgraph:["Beta-Catenin subgraph", "Gamma secretase subgraph"], annotationConfidence:["High"], pmid:"11504726", citationType:"PubMed", citationRef:"11504726"}}, {start: {_id:2990}, end: {_id:118}, properties:{evidence:"Aberrant glycosylation pmodulates phosphorylation of tau by protein kinase A and dephosphorylation of tau by protein phosphatase 2A and 5.", annotationSubgraph:["Tau protein subgraph"], annotationConfidence:["High"], pmid:"12435421", citationType:"PubMed", citationRef:"12435421"}}, {start: {_id:450}, end: {_id:174}, properties:{evidence:"Cellular uptake and degradation by glial cells is one means by which ABeta¸ may be cleared from the brain. In the current study, we demonstrate that modulating levels of the low-density lipoprotein receptor (LDLR), a cell surface receptor that regulates the amount of apolipoprotein E (apoE) in the brain, altered both the uptake and degradation of ABeta¸ by astrocytes. Deletion of LDLR caused a decrease in ABeta¸ uptake, while increasing LDLR levels significantly enhanced both the uptake and clearance of ABeta¸. Increasing LDLR levels also enhanced the cellular degradation of ABeta¸ and facilitated the vesicular transport of ABeta¸ to lysosomes. Despite the fact that LDLR regulated the uptake of apoE by astrocytes, we found that the effect of LDLR on ABeta¸ uptake and clearance occurred in the absence of apoE. Finally, we provide evidence that ABeta¸ can directly bind to LDLR, suggesting an interaction between LDLR and ABeta¸ could be responsible for LDLR-mediated ABeta¸ uptake. Therefore, these results identify LDLR as a receptor that mediates ABeta¸ uptake and clearance by astrocytes, and provide evidence that increasing glial LDLR levels may promote ABeta¸ degradation within the brain", annotationSubgraph:["Low density lipoprotein subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"22383525", citationType:"PubMed", citationRef:"22383525"}}, {start: {_id:3771}, end: {_id:3769}, properties:{evidence:"We have previously identified the E3 ubiquitin ligase-inducible degrader of the low density lipoprotein receptor (LDLR) (Idol) as a post-translational modulator of LDLR levels. Idol is a direct target for regulation by liver X receptors (LXRs), and its expression is responsive to cellular sterol status independent of the sterol- response element-binding proteins. Here we demonstrate that Idol also targets two closely related LDLR family members, VLDLR and ApoE receptor 2 (ApoER2), proteins implicated in both neuronal development and lipid metabolism. Idol triggers ubiquitination of the VLDLR and ApoER2 on their cytoplasmic tails, leading to their degradation.We demonstrate that LXR activation results in decreased Reelin binding to VLDLR and reduced Dab1 phosphorylation. The identification of VLDLR and ApoER2 as Idol targets suggests potential roles for this LXR- inducible E3 ligase in the central nervous system in addition to lipid metabolism.", annotationSubgraph:["Ubiquitin degradation subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["Medium"], pmid:"20427281", citationType:"PubMed", citationRef:"20427281"}}, {start: {_id:3772}, end: {_id:3769}, properties:{evidence:"We have previously identified the E3 ubiquitin ligase-inducible degrader of the low density lipoprotein receptor (LDLR) (Idol) as a post-translational modulator of LDLR levels. Idol is a direct target for regulation by liver X receptors (LXRs), and its expression is responsive to cellular sterol status independent of the sterol- response element-binding proteins. Here we demonstrate that Idol also targets two closely related LDLR family members, VLDLR and ApoE receptor 2 (ApoER2), proteins implicated in both neuronal development and lipid metabolism. Idol triggers ubiquitination of the VLDLR and ApoER2 on their cytoplasmic tails, leading to their degradation.We demonstrate that LXR activation results in decreased Reelin binding to VLDLR and reduced Dab1 phosphorylation. The identification of VLDLR and ApoER2 as Idol targets suggests potential roles for this LXR- inducible E3 ligase in the central nervous system in addition to lipid metabolism.", annotationSubgraph:["Ubiquitin degradation subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["Medium"], pmid:"20427281", citationType:"PubMed", citationRef:"20427281"}}, {start: {_id:838}, end: {_id:144}, properties:{evidence:"Recently, it was proposed that some NSAIDs might activate the peroxisome proliferator-activated / receptor-gamma (PPAR-gamma). PPAR- gamma belongs to a family of nuclear receptors that are able to regulate the / transcription of pro-inflammatory molecules, such as iNOS.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Nitric oxide subgraph"], annotationConfidence:["Medium"], pmid:"16472958", citationType:"PubMed", citationRef:"16472958"}}, {start: {_id:4228}, end: {_id:4229}, properties:{evidence:"However, the enhanced binding of Runx1t1 to the LAT2 promoter could not repress the LAT2 expression when the BV2 microglia cells were treated with HDACi, indicating that Runx1t1 requires HDACs to transcriptionally repress the expression of LAT2.In conclusion, it is suggested that Runx1t1 controls proliferation and the neurotoxic effect of microglia by epigenetically regulating Cdk4 and LAT2 via its interaction with HDACs.", annotationSubgraph:["Cyclin-CDK subgraph"], annotationMeshanatomy:["Microglia"], annotationConfidence:["Medium"], pmid:"24586690", citationType:"PubMed", citationRef:"24586690"}}, {start: {_id:388}, end: {_id:4849}, properties:{evidence:"The scaffolding protein Axin uses separate domains to interact with GSK3, CK1α, and beta-catenin and coordinates sequential phosphorylation of beta-catenin at serine 45 by CK1α and then at threonine 41, serine 37 and serine 33 by GSK3 (Kimelman and Xu, 2006). beta-catenin phosphorylation at serine 33 and 37 creates a binding site for the E3 ubiquitin ligase beta-Trcp, leading to beta-catenin ubiquitination and degradation", annotationSubgraph:["Wnt signaling subgraph"], pmid:"19619488", citationType:"PubMed", citationRef:"19619488"}}, {start: {_id:122}, end: {_id:4851}, properties:{evidence:"The scaffolding protein Axin uses separate domains to interact with GSK3, CK1α, and beta-catenin and coordinates sequential phosphorylation of beta-catenin at serine 45 by CK1α and then at threonine 41, serine 37 and serine 33 by GSK3 (Kimelman and Xu, 2006). beta-catenin phosphorylation at serine 33 and 37 creates a binding site for the E3 ubiquitin ligase beta-Trcp, leading to beta-catenin ubiquitination and degradation", annotationSubgraph:["Wnt signaling subgraph"], pmid:"19619488", citationType:"PubMed", citationRef:"19619488"}}, {start: {_id:122}, end: {_id:4853}, properties:{evidence:"The scaffolding protein Axin uses separate domains to interact with GSK3, CK1α, and beta-catenin and coordinates sequential phosphorylation of beta-catenin at serine 45 by CK1α and then at threonine 41, serine 37 and serine 33 by GSK3 (Kimelman and Xu, 2006). beta-catenin phosphorylation at serine 33 and 37 creates a binding site for the E3 ubiquitin ligase beta-Trcp, leading to beta-catenin ubiquitination and degradation", annotationSubgraph:["Wnt signaling subgraph"], pmid:"19619488", citationType:"PubMed", citationRef:"19619488"}}] AS row
