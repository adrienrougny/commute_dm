UNWIND [{start: {_id:4136}, end: {_id:4511}, properties:{annotationExperimentalGroup:["Sedentary group"], annotationGender:["Female"], evidence:"Interestingly, miR28a-5p, miR-98-5p, and miR-148b-3p expression was significantly higher in sedentary SAMP8 compared with sedentary SAMR1 mice and this difference was further accentuated by exercise", annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["Medium"], pmid:"24688469", citationType:"PubMed", citationRef:"24688469"}}, {start: {_id:4136}, end: {_id:4512}, properties:{annotationExperimentalGroup:["Sedentary group"], annotationGender:["Female"], evidence:"Interestingly, miR28a-5p, miR-98-5p, and miR-148b-3p expression was significantly higher in sedentary SAMP8 compared with sedentary SAMR1 mice and this difference was further accentuated by exercise", annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["Medium"], pmid:"24688469", citationType:"PubMed", citationRef:"24688469"}}, {start: {_id:4136}, end: {_id:4513}, properties:{annotationExperimentalGroup:["Sedentary group"], annotationGender:["Female"], evidence:"Interestingly, miR28a-5p, miR-98-5p, and miR-148b-3p expression was significantly higher in sedentary SAMP8 compared with sedentary SAMR1 mice and this difference was further accentuated by exercise", annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["Medium"], pmid:"24688469", citationType:"PubMed", citationRef:"24688469"}}] AS row
