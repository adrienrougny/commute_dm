UNWIND [{start: {_id:1996}, end: {_id:27}, properties:{evidence:"A growing amount of evidence indicates that matrix metalloproteinases (MMPs) may play an important role in the pathogenesis of Alzheimer's disease (AD).", annotationSubgraph:["Matrix metalloproteinase subgraph"], annotationConfidence:["High"], pmid:"10672313", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"10672313"}}, {start: {_id:2213}, end: {_id:195}, properties:{evidence:"Positive association between an estrogen receptor gene polymorphism and Parkinson's disease with dementia.", annotationSubgraph:["Estrogen subgraph"], annotationSpecies:["9606"], pmid:"10362895", annotationDisease:["Parkinson's disease", "dementia"], citationType:"PubMed", citationRef:"10362895"}}, {start: {_id:2214}, end: {_id:2216}, properties:{evidence:"In addition, we assessed changes in endogenous net tPA activity in WT mice following morphine administration, epileptic seizures, traumatic brain injury and ischaemic stroke-neurological settings in which tPA has a known functional role.", annotationSubgraph:["Plasminogen activator subgraph"], annotationMeshdisease:["Epilepsy", "Brain Injuries, Traumatic", "Stroke"], annotationMeshanatomy:["Brain"], pmid:"21519332", citationType:"PubMed", citationRef:"21519332"}}, {start: {_id:2214}, end: {_id:27}, properties:{evidence:"Although conventionally associated with fibrin clot degradation, recent work has uncovered new functions for the tissue plasminogen activator (tPA)/plasminogen cascade in central nervous system physiology and pathology. This extracellular proteolytic cascade has been shown to have roles in learning and memory, stress, neuronal degeneration, addiction and Alzheimer's disease.", annotationSubgraph:["Plasminogen activator subgraph"], annotationMeshanatomy:["Central Nervous System"], pmid:"15841309", citationType:"PubMed", citationRef:"15841309"}}, {start: {_id:118}, end: {_id:27}, properties:{evidence:"We previously found phosphorylated pRb to be intimately associated with hyperphosphorylated tau-containing neurofibrillary tangles of Alzheimer disease (AD), the pathogenesis of which is believed to involve dysregulation of the cell cycle and marked neuronal death.", annotationSubgraph:["Tau protein subgraph", "Retinoblastoma subgraph"], annotationMeshanatomy:["Neurofibrillary Tangles"], annotationConfidence:["High"], pmid:"21666500", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21666500"}}, {start: {_id:1726}, end: {_id:1148}, properties:{evidence:"The vasoactive protein endothelin-1 (ET-1) is produced by vascular endothelial cells and participates in the regulation of vascular inflammation.", annotationSubgraph:["Inflammatory response subgraph", "Endothelin subgraph"], annotationMeshdisease:["Inflammation"], annotationCell:["endothelial cell"], annotationConfidence:["High"], pmid:"20634595", citationType:"PubMed", citationRef:"20634595"}}, {start: {_id:2300}, end: {_id:2025}, properties:{evidence:"The current experiments test the hypothesis that a vascular insult and aging are co-factors that contribute to dementia by evaluating the neuronal and functional integrity of the hippocampus following small, localized strokes induced by the potent vasoconstrictor, endothelin-1 (ET-1) in the rat model of hippocampal aging.", annotationSubgraph:["Endothelin subgraph"], annotationSpecies:["10116"], annotationMeshdisease:["Dementia", "Stroke"], annotationMeshanatomy:["Hippocampus"], pmid:"17561312", citationType:"PubMed", citationRef:"17561312"}}, {start: {_id:37}, end: {_id:27}, properties:{annotationCellstructure:["Endoplasmic Reticulum"], evidence:"Mutations in the presenilin-1 (PS1) gene cause early onset familial Alzheimer's disease (FAD) by a mechanism believed to involve perturbed endoplasmic reticulum (ER) function and altered proteolytic processing of the amyloid precursor protein.", annotationSubgraph:["Gamma secretase subgraph"], pmid:"12390529", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12390529"}}, {start: {_id:2147}, end: {_id:27}, properties:{evidence:"Recent studies have unraveled important roles of ABC transporters including ABCB1 (P-glycoprotein, P-gp), ABCG2 (breast cancer resistant protein, BCRP), ABCC1 (multidrug resistance protein 1, MRP1), and the cholesterol transporter ABCA1 in the pathogenesis of AD and Abeta peptides deposition inside the brain.", annotationSubgraph:["ATP binding cassette transport subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"23181169", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23181169"}}, {start: {_id:2341}, end: {_id:27}, properties:{evidence:"Recent studies have unraveled important roles of ABC transporters including ABCB1 (P-glycoprotein, P-gp), ABCG2 (breast cancer resistant protein, BCRP), ABCC1 (multidrug resistance protein 1, MRP1), and the cholesterol transporter ABCA1 in the pathogenesis of AD and Abeta peptides deposition inside the brain.", annotationSubgraph:["ATP binding cassette transport subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"23181169", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23181169"}}, {start: {_id:2342}, end: {_id:27}, properties:{evidence:"Recent studies have unraveled important roles of ABC transporters including ABCB1 (P-glycoprotein, P-gp), ABCG2 (breast cancer resistant protein, BCRP), ABCC1 (multidrug resistance protein 1, MRP1), and the cholesterol transporter ABCA1 in the pathogenesis of AD and Abeta peptides deposition inside the brain.", annotationSubgraph:["ATP binding cassette transport subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"23181169", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23181169"}}, {start: {_id:2343}, end: {_id:27}, properties:{evidence:"Recent studies have unraveled important roles of ABC transporters including ABCB1 (P-glycoprotein, P-gp), ABCG2 (breast cancer resistant protein, BCRP), ABCC1 (multidrug resistance protein 1, MRP1), and the cholesterol transporter ABCA1 in the pathogenesis of AD and Abeta peptides deposition inside the brain.", annotationSubgraph:["ATP binding cassette transport subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"23181169", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23181169"}}, {start: {_id:2147}, end: {_id:27}, properties:{evidence:"These findings support the validity of increasing Abeta clearance via ABCB1 up-regulation as a therapeutic approach to slowing or halting the progression of AD.", annotationSubgraph:["ATP binding cassette transport subgraph", "Amyloidogenic subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"23181169", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23181169"}}, {start: {_id:2398}, end: {_id:27}, properties:{evidence:"We previously showed that some familial Alzheimer's disease PS mutations cause increased basal and acetylcholine muscarinic receptor- stimulated phospholipase C (PLC) activity which was gamma-secretase dependent.", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], pmid:"17437536", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17437536"}}, {start: {_id:2511}, end: {_id:2183}, properties:{evidence:"Inoue et al. [37] demonstrated that suppressing caspase-9 by overexpressing XIAP in motor neurons effectively slowed the progression of ALS in G93A SOD1 Tg mice, while Reyes et al. documented that neuron-specific deletion of BCL-associated X protein (BAX) or BCL2-homologous antagonist/killer (BAK), which are both proapoptotic BCL-2 family proteins, delayed the onset and extended the longevity of disease in the same mice [38].", annotationSubgraph:["Electron transport chain", "Caspase subgraph", "XIAP subgraph