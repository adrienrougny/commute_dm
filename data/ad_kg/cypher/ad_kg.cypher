UNWIND [{start: {_id:27}, end: {_id:1435}, properties:{evidence:"Decreased relative expression levels of hsa-miR-590-3p was observed in patients with AD versus controls (0.685 ± Â°0.080 versus 0.931 ± Â°0.111, pÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â°=ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â°0.079), and correlated negatively with hnRNP-A1 mRNA levels (rÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â°=ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â°-0.615, pÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â°=ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â°0.0237). According to these findings, hnRNP-A1 and its transcription regulatory factor miR-590-3p are disregulated in patients with AD, and the hnRNP-A1 rs7967622 C/C genotype is likely a risk factor for FTLD in male populations.", annotationSubgraph:["miRNA subgraph"], pmid:"21548758", citationType:"PubMed", citationRef:"21548758"}}, {start: {_id:27}, end: {_id:1456}, properties:{evidence:"Delivery of a miR-153 antisense inhibitor to human fetal brain cultures significantly elevated APP expression. miR-153 delivery also reduced expression of the APP paralog APLP2. High functional redundancy between APP and APLP2 suggests that miR-153 may target biological pathways in which they both function. Interestingly, in a subset of human AD brain specimens with moderate AD pathology, miR-153 levels were reduced.", annotationSubgraph:["miRNA subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"22733824", citationType:"PubMed", citationRef:"22733824"}}, {start: {_id:27}, end: {_id:1386}, properties:{evidence:"The Expression of MicroRNA miR-107 Decreases Early in AlzheimerÃ¢â‚¬â„¢s Disease and May Accelerate Disease Progression through Regulation of beta-Site Amyloid Precursor Protein-Cleaving Enzyme 1. BACE1 mRNA levels tended to increase as miR-107 levels decreased in the progression of AD.", annotationSubgraph:["Beta secretase subgraph", "miRNA subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"18234899", citationType:"PubMed", citationRef:"18234899"}}, {start: {_id:27}, end: {_id:1386}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"HAT activity of p300 stimulates the PS1 and BACE1 promoter histone hyperacetylation", pmid:"25051175", citationType:"PubMed", citationRef:"25051175"}}] AS row
