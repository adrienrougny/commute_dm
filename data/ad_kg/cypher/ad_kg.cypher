UNWIND [{start: {_id:199}, end: {_id:27}, properties:{evidence:"12/15-Lipoxygenase (12/15-LO) is an enzyme widely distributed in the central nervous system, and it has been involved in the neurobiology of Alzheimer disease (AD).12/15-Lipoxygenase (12/15-LO) is an enzyme widely distributed in the central nervous system, and it has been involved in the neurobiology of Alzheimer disease (AD)", annotationSubgraph:["Eicosanoids signaling subgraph"], annotationConfidence:["Very High"], pmid:"22275252", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22275252"}}, {start: {_id:201}, end: {_id:27}, properties:{evidence:"12/15-Lipoxygenase (12/15-LO) is an enzyme widely distributed in the central nervous system, and it has been involved in the neurobiology of Alzheimer disease (AD).12/15-Lipoxygenase (12/15-LO) is an enzyme widely distributed in the central nervous system, and it has been involved in the neurobiology of Alzheimer disease (AD)", annotationSubgraph:["Eicosanoids signaling subgraph"], annotationConfidence:["Very High"], pmid:"22275252", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22275252"}}, {start: {_id:346}, end: {_id:27}, properties:{evidence:"Role of LPR8 activation in normal brain functioning and in neurodegeneration during AD.", annotationSubgraph:["Low density lipoprotein subgraph"], annotationConfidence:["Medium"], pmid:"22496686", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:1092}, end: {_id:733}, properties:{evidence:"Abnormal phosphorylation of tau and activation of mu-calpain are two key events in the pathology of AD. Importantly, these two events are also related with GCs and IR. We therefore speculate that tau phosphorylation and mu-calpain activation may mediate the GCs-induced IR. Akt phosphorylation at Ser-473 (pAkt) is commonly used as a marker for assessing IR.", annotationSubgraph:["Insulin signal transduction", "Calpastatin-calpain subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"22536436", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22536436"}}, {start: {_id:117}, end: {_id:260}, properties:{evidence:"Alzheimer's disease is an age-related form of dementia due to a progressive loss of neuronal functioning, also characterized by the deposition of extracellular amyloid throughout the brain (amyloid plaques) and a significant decrease in brain mass. An overactivity of the cyclin-dependent protein kinase CDK5 in the brain has been implicated in neuronal degeneration and the formation of neurofibrillary tangles due to hyperphosphorylation of essential neuronal proteins such as MAP and Tau (2). CDK5 is regulated by the neuron-specific and cyclin-related protein p35 (also known as p35Ncdk5a). During the development of Alzheimer's disease, p35 is processed to a smaller protein, p25, which is a constitutive activator of CDK5. The generation of p25 disrupts CDK5 localization and substrate preferences (2). In addition, the expression of p25 in neurons results in a collapse of microtubules, neurite retraction, and apoptosis (2).", annotationSubgraph:["Tau protein subgraph", "Cyclin-CDK subgraph"], annotationConfidence:["High"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:1152}, end: {_id:27}, properties:{evidence:"To test the hypothesis that polymorphic variation in insulin signalling genes may underlie the shared risk of dysfunctional insulin signalling and late onset Alzheimer's disease (AD).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"12185156", citationType:"PubMed", citationRef:"12185156"}}, {start: {_id:1608}, end: {_id:1609}, properties:{annotationCellstructure:["Lysosomes"], evidence:"In this regard, the activity of lysosomal glycohydrolases may of use, in light of the implication of these enzymes in early events that underlie AD pathology and an overt correlation, in diabetes, between altered metabolic homeostasis, abnormal glycohydrolase secretion in body fluids, and occurrence of diabetic complications.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationConfidence:["High"], pmid:"21321400", citationType:"PubMed", citationRef:"21321400"}}, {start: {_id:1608}, end: {_id:27}, properties:{annotationCellstructure:["Lysosomes"], evidence:"In this regard, the activity of lysosomal glycohydrolases may of use, in light of the implication of these enzymes in early events that underlie AD pathology and an overt correlation, in diabetes, between altered metabolic homeostasis, abnormal glycohydrolase secretion in body fluids, and occurrence of diabetic complications.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationConfidence:["High"], pmid:"21321400", citationType:"PubMed", citationRef:"21321400"}}, {start: {_id:213}, end: {_id:1148}, properties:{evidence:"We bring forward the hypothesis that inflammation via prolonged activation of key kinases (p38 and GSK-3beta) and activation of histone deacetylases gives rise to dysregulation of the NRF2 system in the brain, which contributes to oxidative stress and injury.", annotationSubgraph:["Inflammatory response subgraph", "MAPK-JNK subgraph"], annotationMeshdisease:["Inflammation", "Wounds and Injuries"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:123}, end: {_id:1148}, properties:{evidence:"We bring forward the hypothesis that inflammation via prolonged activation of key kinases (p38 and GSK-3beta) and activation of histone deacetylases gives rise to dysregulation of the NRF2 system in the brain, which contributes to oxidative stress and injury.", annotationSubgraph:["Inflammatory response subgraph", "GSK3 subgraph"], annotationMeshdisease:["Inflammation", "Wounds and Injuries"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:2187}, end: {_id:1982}, properties:{evidence:"We bring forward the hypothesis that inflammation via prolonged activation of key kinases (p38 and GSK-3beta) and activation of histone deacetylases gives rise to dysregulation of the NRF2 system in the brain, which contributes to oxidative stress and injury.", annotationSubgraph:["Inflammatory response subgraph", "Free radical formation subgraph"], annotationMeshdisease:["Inflammation", "Wounds and Injuries"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:21}, end: {_id:27}, properties:{evidence:"Our studies demonstrate, for the first time, that pmodulation of BACE1 activity may play a significant role in AD pathogenesis in vivo.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15452128", citationType:"PubMed", citationRef:"15452128"}}, {start: {_id:123}, end: {_id:27}, properties:{evidence:"Our findings indicate that the abnormal activation of glycogen synthase kinase 3beta can reduce neuronal viability and synaptic plasticity via modulating Presenilin 1/N-cadherin/beta-catenin interaction and thus have important implications in the pathophysiology of Alzheimer disease.", annotationSubgraph:["Beta-Catenin subgraph", "GSK3 subgraph", "Gamma secretase subgraph"], annotationConfidence:["High"], pmid:"17389597", citationType:"PubMed", citationRef:"17389597"}}, {start: {_id:116}, end: {_id:27}, properties:{evidence:"Both the hyperactivation of Cdk5 activity and subsequent hyperphosphorylation of neurofilaments and the microtubule-associated protein tau have been implicated in the pathogenesis of neurodegenerative disorders such as Alzheimer's disease and amyotrophic lateral sclerosis.", annotationSubgraph:["Tau protein subgraph", "Cyclin-CDK subgraph"], annotationConfidence:["High"], pmid:"14673212", citationType:"PubMed", citationRef:"14673212"}}, {start: {_id:116}, end: {_id:2183}, properties:{evidence:"Both the hyperactivation of Cdk5 activity and subsequent hyperphosphorylation of neurofilaments and the microtubule-associated protein tau have been implicated in the pathogenesis of neurodegenerative disorders such as Alzheimer's disease and amyotrophic lateral sclerosis.", annotationSubgraph:["Tau protein subgraph", "Cyclin-CDK subgraph"], annotationConfidence:["High"], pmid:"14673212", citationType:"PubMed", citationRef:"14673212"}}, {start: {_id:3392}, end: {_id:1250}, properties:{evidence:"The dysregulation of glycogen synthase kinase-3 (GSK3) has been implicated in Alzheimer disease (AD) pathogenesis and in Abeta-induced neurotoxicity, leading us to investigate it as a therapeutic target in an intracerebroventricular Abeta infusion pmodel.", annotationSubgraph:["MAPK-JNK subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19038340", citationType:"PubMed", citationRef:"19038340"}}, {start: {_id:4264}, end: {_id:825}, properties:{evidence:"Cannabinoid receptor subtype 2 (CB2) has been shown to be up-regulated in activated microglia and therefore plays an important role in neuroinflammatory and neurodegenerative diseases such as multiple sclerosis, amyotrophic lateral sclerosis and Alzheimer's disease.", annotationMeshdisease:["Multiple Sclerosis", "Amyotrophic Lateral Sclerosis", "Neurodegenerative Diseases", "Alzheimer Disease"], annotationMeshanatomy:["Microglia"], annotationConfidence:["Medium"], pmid:"24662272", citationType:"PubMed", citationRef:"24662272"}}, {start: {_id:4264}, end: {_id:27}, properties:{evidence:"Cannabinoid receptor subtype 2 (CB2) has been shown to be up-regulated in activated microglia and therefore plays an important role in neuroinflammatory and neurodegenerative diseases such as multiple sclerosis, amyotrophic lateral sclerosis and Alzheimer's disease.", annotationMeshdisease:["Multiple Sclerosis", "Amyotrophic Lateral Sclerosis"