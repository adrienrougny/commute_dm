UNWIND [{start: {_id:336}, end: {_id:351}, properties:{evidence:"In particular,in receptor TK, tyrosine residue can be phosphorylated to generate the NPXpY motif, which represents a docking sitefor several intracellular adaptor proteins through the phosphortyrosine- binding domain (PTB). Similarly, the adaptor proteins Shc and Grb2 can bind AbetaPP (or its CTFs) in the presence of phosphorylated tyrosine in this motif. However, AbetaPP (or its CTFs) and the AbetaPP-related proteins, APLP1 and APLP2, can also interact with several other signalling proteins, including X11, Fe65, mDab, c-Abl, JIP-1, and Numb, independently of the phosphorylation of the tyrosine residue within the YENPTY motif. From a functional point of view, the interaction between the neuron-specific adaptor protein Fe65 and AbetaPP via the second PTB domain of Fe65 was shown to modulate AbetaPP processing, favoring the generation of Abeta and AbetaPP trafficking, in several cell lines. Another adaptor that binds to AbetaPP is mDAB. It is a protein related to the Reelin subgraph and interacting with YENPTY motif through a PTB domain. mDAB is active during embryogenesis, where it regulates the position of neurons in the brain laminar structure, and mDAB binding increases the amounts of mature AbetaPP and Abeta formation. On the contrary, X11 stabilizes AbetaPP conformation in membrane, inhibiting Abeta secretion in cultured cells, likely impairing AbetaPP trafficking to sites containing active gamma-secretase complexes. JIP's are member of JNK- scaffolding family proteins kinases, implicated in different signal pathway, including neuronal apoptotic process. JNK-interacting proteins JIP1b and JIP2 bind to the cytoplasmic tail of AbetaPP. The expression of JIP1b stabilizes immature AbetaPP and decreases the AbetaPP ectodomain, Abeta40/Abeta42 and CTFs abundance.All these observations suggest that some of these protein-protein interactions may play a role in the modulation of the amyloidogenic pathway and thus might have a role in neurodegeneration.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:118}, end: {_id:772}, properties:{evidence:"Hyperphosphorylated tau protein is the basic structural component of the neurofibrillary tangle, a histopathological hallmark of Alzheimer's disease. The formation of hyperphosphorylated tau protein may impair learning and the synaptic plasticity of neurons. Tau is a protein that is associated with and stabilizes microtubules; hyperphosphorylated tau protein is unable to perform this stabilization function.", annotationSubgraph:["Tau protein subgraph"], annotationConfidence:["High"], pmid:"16504486", citationType:"PubMed", citationRef:"16504486"}}, {start: {_id:174}, end: {_id:772}, properties:{evidence:"Apolipoprotein E (ApoE) genotype is a significant risk factor for the development of Alzheimer disease (AD) and the ApoE protein is associated with senile plaques (SP) and neurofibrillary tangles (NFT)", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["High"], pmid:"7695621", citationType:"PubMed", citationRef:"7695621"}}, {start: {_id:2864}, end: {_id:2742}, properties:{evidence:"We found that BACE phosphorylation influences BACE-GGA interactions in cells using a new fluorescence-resonance-energy-transfer-based assay of protein proximity, fluorescence lifetime imaging.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15466887", citationType:"PubMed", citationRef:"15466887"}}, {start: {_id:35}, end: {_id:3219}, properties:{evidence:"APH-1 interacts with mature and immature forms of presenilins and nicastrin and may play a role in maturation of presenilin.nicastrin complexes.", annotationSubgraph:["Gamma secretase subgraph", "Notch signaling subgraph"], annotationConfidence:["High"], pmid:"12471034", citationType:"PubMed", citationRef:"12471034"}}, {start: {_id:118}, end: {_id:3376}, properties:{evidence:"This interaction is regulated by the phosphorylation of Tau at selected sites, by glycogen synthase kinase-3beta (GSK3beta) and cyclin-dependent kinase 5 (Cdk5), and requires an intact microtubule network.", annotationSubgraph:["Tau protein subgraph"], annotationConfidence:["High"], pmid:"15686969", citationType:"PubMed", citationRef:"15686969"}}, {start: {_id:336}, end: {_id:351}, properties:{evidence:"In this context, it was reported that other two adaptor proteins, which have been involved in the regulation of the amyloidogenic pathway, ShcA and growth factor receptor-bound protein 2 (Grb2) are able to interact with the cytodomain of AbetaPP in the presence of specific tyrosine 682 phosphorylation in the YENPTY motif of AbetaPP cytodomain. ShcA (or ShcC) adaptors connect growth factor receptors to specific signaling pathways (typically Ras/ERK1/2 pathway but also PI3K/Akt signalling) and are involved in cell proliferation differentiation and apoptotic process and neuronal development. Also the role of Grb2 in Ras-signaling pathway is well known as well as its involvement in the activation of the mitogen-activated protein kinase (MAPK) pathways cascade. It is worth noting that ERK1/2 activity is increased in AD brains and that activated MAPKs have been involved in the abnormal hyperphosphorylation of Tau in AD", annotationSubgraph:["MAPK-ERK subgraph"], annotationConfidence:["High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:4354}, end: {_id:4351}, properties:{evidence:"High levels of interferon-gamma, IL-1, tumor necrosis factor Î±, CXCL9, CXCL10, and CCL5 were found in GF-IL12 cerebelli and GF- IL12/CXCR3KO eyes.", annotationSubgraph:["Interleukin signaling subgraph", "Chemokine signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Eye", "Cerebellum"], pmid:"21925471", citationType:"PubMed", citationRef:"21925471"}}, {start: {_id:4355}, end: {_id:4351}, properties:{evidence:"High levels of interferon-gamma, IL-1, tumor necrosis factor Î±, CXCL9, CXCL10, and CCL5 were found in GF-IL12 cerebelli and GF- IL12/CXCR3KO eyes.", annotationSubgraph:["Interleukin signaling subgraph", "Chemokine signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Eye", "Cerebellum"], pmid:"21925471", citationType:"PubMed", citationRef:"21925471"}}, {start: {_id:2459}, end: {_id:4351}, properties:{evidence:"High levels of interferon-gamma, IL-1, tumor necrosis factor Î±, CXCL9, CXCL10, and CCL5 were found in GF-IL12 cerebelli and GF- IL12/CXCR3KO eyes.", annotationSubgraph:["Tumor necrosis factor subgraph", "Interleukin signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Eye", "Cerebellum"], pmid:"21925471", citationType:"PubMed", citationRef:"21925471"}}, {start: {_id:1141}, end: {_id:4351}, properties:{evidence:"High levels of interferon-gamma, IL-1, tumor necrosis factor Î±, CXCL9, CXCL10, and CCL5 were found in GF-IL12 cerebelli and GF- IL12/CXCR3KO eyes.", annotationSubgraph:["Interleukin signaling subgraph", "Chemokine signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Eye", "Cerebellum"], pmid:"21925471", citationType:"PubMed", citationRef:"21925471"}}, {start: {_id:4356}, end: {_id:4351}, properties:{evidence:"High levels of interferon-gamma, IL-1, tumor necrosis factor Î±, CXCL9, CXCL10, and CCL5 were found in GF-IL12 cerebelli and GF- IL12/CXCR3KO eyes.", annotationSubgraph:["Interleukin signaling subgraph", "Chemokine signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Eye", "Cerebellum"], pmid:"21925471", citationType:"PubMed", citationRef:"21925471"}}, {start: {_id:4817}, end: {_id:8}, properties:{evidence:"In cells, CRF treatment increases Abeta production and triggers CRF receptor 1 (CRFR1) and gamma-secretase internalization. Co- immunoprecipitation studies establish that gamma-secretase associates with CRFR1; this is mediated by beta-arrestin binding motifs.", annotationSubgraph:["CRH subgraph"], pmid:"25964433", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25964433"}}, {start: {_id:4831}, end: {_id:8}, properties:{evidence:"In cells, CRF treatment increases Abeta production and triggers CRF receptor 1 (CRFR1) and gamma-secretase internalization. Co- immunoprecipitation studies establish that gamma-secretase associates with CRFR1; this is mediated by beta-arrestin binding motifs.", annotationSubgraph:["CRH subgraph"], pmid:"25964433", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25964433"}}] AS row
