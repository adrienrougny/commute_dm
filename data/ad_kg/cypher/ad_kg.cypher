UNWIND [{start: {_id:2}, end: {_id:3}, properties:{evidence:"The statements inside this citation is included to connect two entity types or triples, which will exist as islands/subnetworks in the big model.", citationTitle:"Connectors", citationType:"Other", citationRef:"123"}}, {start: {_id:6}, end: {_id:3}, properties:{evidence:"The statements inside this citation is included to connect two entity types or triples, which will exist as islands/subnetworks in the big model.", citationTitle:"Connectors", citationType:"Other", citationRef:"123"}}, {start: {_id:1726}, end: {_id:1727}, properties:{evidence:"Our results show that freshly solubilized Abeta1Ã¢â‚¬ 40 enhances the vasoconstriction induced by endothelin-1 (ET-1) and increases resistance to relaxation triggered by nitric oxide (NO), suggesting that Abeta may oppose the NO/cGMP pathway. Using specific inhibitors and activators of the NO/cGMP pathway, we show that Abeta vasoactivity is not due to a modulation of nitric oxide synthase (NOS) or soluble guanylyl cyclase (sGC). However, we find that a selective cGMP phosphodiesterase (cGMP-PDE) inhibitor (dipyridamole) is able to interactively block the enhanced vasoconstriction as well as the opposition to relaxation induced by Abeta, suggesting that Abeta could effect the activity of this enzyme. Cyclic GMP levels, but not cAMP concentrations, are reduced after Abeta treatment of rat aortic rings, further substantiating this hypothesis.", annotationSubgraph:["Endothelin subgraph", "Blood vessel dilation subgraph"], annotationConfidence:["High"], pmid:"10222124", citationType:"PubMed", citationRef:"10222124"}}, {start: {_id:1726}, end: {_id:1727}, properties:{evidence:"In the brain, endothelin-1 (ET-1) is a locally acting vasoconstrictor, produced in neurons by endothelin-converting enzyme (ECE)-2 and in endothelial cells by ECE-1.", annotationSubgraph:["Endothelin subgraph"], annotationMeshanatomy:["Neurons"], pmid:"23629587", citationType:"PubMed", citationRef:"23629587"}}, {start: {_id:108}, end: {_id:2513}, properties:{evidence:"XIAP expression in motor neurons significantly slows disease progression, whereas p35, a broad caspase inhibitory protein, does not. However, p35, which potently inhibits capase-3, does not slow disease progression in mouse ALS. There are two explanations for this apparent discrepancy. Since caspase-9 remains active in the presence of p35, procaspase-3 may be continuously processed into active caspase-3, finally overriding inhibition by p35. Alternatively, caspase-9 may utilize a substrate other than caspase-3, leading to caspase-3-independent cell death", annotationSubgraph:["Electron transport chain", "Caspase subgraph", "XIAP subgraph"], annotationSpecies:["10090"], pmid:"14657037", citationType:"PubMed", citationRef:"14657037"}}, {start: {_id:666}, end: {_id:4803}, properties:{evidence:"Binding to HSPGs requires a heparin/heparan sulfate-binding domain consisting of a stretch of positively charged lysines or arginines on the ligand. Prion protein, beta-amyloid, tau, and alpha-synuclein all have putative heparin-binding domains(25, 44Ã¢â‚¬â€œ46).", annotationConfidence:["Medium"], pmid:"23898162", citationType:"PubMed", citationRef:"23898162"}}, {start: {_id:22}, end: {_id:4803}, properties:{evidence:"Binding to HSPGs requires a heparin/heparan sulfate-binding domain consisting of a stretch of positively charged lysines or arginines on the ligand. Prion protein, beta-amyloid, tau, and alpha-synuclein all have putative heparin-binding domains(25, 44Ã¢â‚¬â€œ46).", annotationConfidence:["Medium"], pmid:"23898162", citationType:"PubMed", citationRef:"23898162"}}, {start: {_id:203}, end: {_id:4803}, properties:{evidence:"Binding to HSPGs requires a heparin/heparan sulfate-binding domain consisting of a stretch of positively charged lysines or arginines on the ligand. Prion protein, beta-amyloid, tau, and alpha-synuclein all have putative heparin-binding domains(25, 44Ã¢â‚¬â€œ46).", annotationConfidence:["Medium"], pmid:"23898162", citationType:"PubMed", citationRef:"23898162"}}, {start: {_id:150}, end: {_id:4803}, properties:{evidence:"Binding to HSPGs requires a heparin/heparan sulfate-binding domain consisting of a stretch of positively charged lysines or arginines on the ligand. Prion protein, beta-amyloid, tau, and alpha-synuclein all have putative heparin-binding domains(25, 44Ã¢â‚¬â€œ46).", annotationConfidence:["Medium"], pmid:"23898162", citationType:"PubMed", citationRef:"23898162"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:IS_A]->(end) SET r += row.properties;
UNWIND [{start: {_id:605}, end: {_id:95}, properties:{evidence:"Acetylcholinesterase (AChE) is thought to play an important role during apoptotic process. Our results showed that H2O2 induced AChE activity, a functional marker in apoptotic process, increases in neuronal-like PC12 cells. Glutathione, which is involved in cellular redox homeostasis, inhibited the increase of AChE activity, suggesting that reactive oxygen species (ROS) play a key role in this process. Further investigation showed that the elevation of AChE was observed after the degradation of Akt, release of cytochrome c from mitochondria into the cytosol, and activation of caspase family members. When nerve growth factor (NGF) was present, with the maintenance of Akt level, the elevation of AChE, the cytochrome c diffusion, as well as apoptotic process were markedly attenuated in H2O2-treated PC12 cells", annotationSubgraph:["Acetylcholine signaling subgraph", "Caspase subgraph"], annotationConfidence:["High"], pmid:"17213958", citationType:"PubMed", citationRef:"17213958"}}, {start: {_id:187}, end: {_id:95}, properties:{evidence:"As indicated in Fig. 2, the presence of GSH protected the cells against H2O2-induced apoptosis and the increase in AChE activity. Therefore, the redox imbalance resulted in mitochondrial dysfunction and enhanced mitochondrial reactive oxygen species (ROS) generation.", annotationSubgraph:["Acetylcholine signaling subgraph", "Glutathione reductase subgraph"], annotationConfidence:["High"], pmid:"17213958", citationType:"PubMed", citationRef:"17213958"}}, {start: {_id:118}, end: {_id:768}, properties:{evidence:"During the course of AD tau becomes hyperphosphorylated and dissociates from microtubules which then depolymerize. The hyperphosphorylated tau self-aggregates and accumulates in the cell body where it forms paired-helical filaments (neurofibrillary tangles). As a consequence of accumulation of Abeta at synapses, Ca2+ regulation is impaired", annotationSubgraph:["Tau protein subgraph", "Regulation of actin cytoskeleton subgraph"], annotationMeshanatomy:["Synapses"], annotationConfidence:["High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}, {start: {_id:6}, end: {_id:460}, properties:{evidence:"During the course of AD tau becomes hyperphosphorylated and dissociates from microtubules which then depolymerize. The hyperphosphorylated tau self-aggregates and accumulates in the cell body where it forms paired-helical filaments (neurofibrillary tangles). As a consequence of accumulation of Abeta at synapses, Ca2+ regulation is impaired", annotationSubgraph:["Tau protein subgraph"], annotationMeshanatomy:["Synapses"], annotationConfidence:["High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}, {start: {_id:6}, end: {_id:158}, properties:{evidence:"During the course of AD tau becomes hyperphosphorylated and dissociates from microtubules which then depolymerize. The hyperphosphorylated tau self-aggregates and accumulates in the cell body where it forms paired-helical filaments (neurofibrillary tangles). As a consequence of accumulation of Abeta at synapses, Ca2+ regulation is impaired", annotationSubgraph:["Tau protein subgraph"], annotationMeshanatomy:["Synapses"], annotationConfidence:["High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}, {start: {_id:2}, end: {_id:460}, properties:{evidence:"During the course of AD tau becomes hyperphosphorylated and dissociates from microtubules which then depolymerize. The hyperphosphorylated tau self-aggregates and accumulates in the cell body where it forms paired-helical filaments (neurofibrillary tangles). As a consequence of accumulation of Abeta at synapses, Ca2+ regulation is impaired", annotationSubgraph:["Tau protein subgraph"], annotationMeshanatomy:["Synapses"], annotationConfidence:["High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}, {start: {_id:2}, end: {_id:158}, properties:{evidence:"During the course of AD tau becomes hyperphosphorylated and dissociates from microtubules which then depolymerize. The hyperphosphorylated tau self-aggregates and accumulates in the cell body where it forms paired-helical filaments (neurofibrillary tangles). As a consequence of accumulation of Abeta at synapses, Ca2+ regulation is impaired", annotationSubgraph:["Tau protein subgraph"], annotationMeshanatomy:["Synapses"], annotationConfidence:["High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}, {start: {_id:17}, end: {_id:855}, properties:{evidence:"Taken together, our results identify the AICD as a novel inhibitory factor of the canonical Wnt signalling pathway and suggest its regulatory role in neuronal cell proliferation and differentiation.", annotationSubgraph:["Wnt signaling subgraph"], annotationConfidence:["Medium"], pmid:"22613765", citationType:"PubMed", citationRef:"22613765"}}, {start: {_id:838}, end: {_id:3924}, properties:{evidence:"the evidence that PPARgamma stimulates the ubiquitination of APP supports the fact that the Abeta-lowering effect of PPARgamma is due to the proteasome-mediated degradation of APP. Another issue in the present study is the finding that PPARgamma, by decreasing Abeta secretion, protects the cells against H2O2-mediated necrosis", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Non-amyloidogenic subgraph", "Ubiquitin degradation subgraph"], annotationConfidence:["High"], pmid:"15946122", citationType:"PubMed", citationRef:"15946122"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTLY_DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1225}, end: {_id:1220}, properties:{evidence:"The concentration of glucose in the culture medium regulates p35 expression and p35/CDK5 kinase activity in INS-1 cells", annotationSubgraph:["Insulin signal transduction", "Cyclin-CDK subgraph"], annotationUserdefinedcellline:["INS-1 cells"], annotationConfidence:["Medium"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:62}, end: {_id:1641}, properties:{evidence:"The gamma-secretase complex comprises presenilins (PS1 or PS2), nicastrin, APH-1, and PEN-2. Herein, we find that PEN-2 can interact with ferritin light chain (FTL), an important component of the iron storage protein ferritin. In addition, we show that overexpression of FTL increases the protein levels of PEN-2 and PS1 amino-terminal fragment (NTF) and promotes gamma-secretase activity for more production of Abeta and notch intracellular domain (NICD). Furthermore, iron treatments increase the levels of FTL, PEN-2 and PS1 NTF and promote gamma-secretase-mediated NICD production. Moreover, downregulation of FTL decreases the levels of PEN-2 and PS1 NTF. Together, our results suggest that iron can increase gamma-secretase activity through promoting the level of FTL that interacts with and stabilizes PEN-2, providing a new molecular link between iron, PEN-2/gamma-secretase and Abeta generation in AD.", annotationSubgraph:["Binding and Uptake of Ligands by Scavenger Receptors", "Gamma secretase subgraph"], pmid:"23685131", citationType:"PubMed", citationRef:"23685131"}}, {start: {_id:1854}, end: {_id:1857}, properties:{evidence:"These results therefore suggest that arecoline exerts its excitatory actions by binding to M2-muscarinic receptors on the cell membrane of neurons of the locus coeruleus.", annotationSubgraph:["Regulation of actin cytoskeleton subgraph"], annotationSpecies:["10116"], pmid:"10857465", citationType:"PubMed", citationRef:"10857465"}}, {start: {_id:1898}, end: {_id:1925}, properties:{evidence:"The results of the present study, thus, suggest that nefiracetam enhances activity of nicotinic ACh receptors by interacting with a PKC pathway, thereby increasing glutamate release from presynaptic terminals, and then leading to a sustained facilitation of hippocampal neurotransmission. This may represent a cellular mechanism underlying the cognition-enhancing action of nefiracetam. The results also provide the possibility that nefiracetam could be developed as a promising therapeutic drug for senile dementia or Alzheimer's disease.", annotationSubgraph:["NMDA receptor", "Acetylcholine signaling subgraph", "GABA subgraph"], annotationConfidence:["High"], pmid:"11039729", citationType:"PubMed", citationRef:"11039729"}}, {start: {_id:1935}, end: {_id:1930}, properties:{evidence:"As expected, LPS strongly induced the formation of two NF-kappa B DNA- binding activities, one of which was identified as RelA/p50.", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], pmid:"9209268", citationType:"PubMed", citationRef:"9209268"}}, {start: {_id:1614}, end: {_id:2056}, properties:{evidence:"5-chloro-7-iodoquinolin-8-ol is capable of forming stable complexes with copper and currently used in clinics for treatment of Alzheimer's disease.", annotationSubgraph:["Androgen subgraph"], annotationConfidence:["Medium"], pmid:"17308104", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17308104"}}, {start: {_id:2678}, end: {_id:2682}, properties:{evidence:"The mediator neuroprotectin D1 (NPD1) is an enzymatic derivative of the omega-3 essential fatty acid docosahexaenoic acid. NPD1 stereoselectively and specifically binds to human retinal pigment epithelium (RPE) cells and neutrophils. In turn, this lipid mediator induces dephosphorylation of Bcl-x(L) in a PP2A-dependent manner and induces PI3K/Akt and mTOR/p70S6K pathways leading to RPE cell survival during oxidative stress-induced apoptotic process.", annotationSubgraph:["Neuroprotection subgraph", "Bcl-2 subgraph"], annotationConfidence:["Medium"], pmid:"21431475", citationType:"PubMed", citationRef:"21431475"}}, {start: {_id:2678}, end: {_id:2684}, properties:{evidence:"The mediator neuroprotectin D1 (NPD1) is an enzymatic derivative of the omega-3 essential fatty acid docosahexaenoic acid. NPD1 stereoselectively and specifically binds to human retinal pigment epithelium (RPE) cells and neutrophils. In turn, this lipid mediator induces dephosphorylation of Bcl-x(L) in a PP2A-dependent manner and induces PI3K/Akt and mTOR/p70S6K pathways leading to RPE cell survival during oxidative stress-induced apoptotic process.", annotationSubgraph:["Neuroprotection subgraph", "Bcl-2 subgraph"], annotationConfidence:["Medium"], pmid:"21431475", citationType:"PubMed", citationRef:"21431475"}}, {start: {_id:2722}, end: {_id:2665}, properties:{evidence:"Moreover, our recent studies further demonstrated that (1) apoE mediates sulfatide depletion in amyloid-beta precursor protein transgenic mice; (2) sulfatides enhance amyloid beta (Abeta) peptides binding to apoE-associated particles; (3) Abeta42 content notably correlates with sulfatide content in CSF;(4) sulfatides markedly enhance the uptake of Abeta peptides; and (5) abnormal sulfatide- facilitated Abeta uptake results in the accumulation of Abeta in lysosomes.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"20052565", citationType:"PubMed", citationRef:"20052565"}}, {start: {_id:3}, end: {_id:2924}, properties:{evidence:"We have shown that interaction of CD40 with CD40L enables microglial activation in response to amyloid-beta peptide (Abeta), which is associated with Alzheimer's disease (AD)-like neuronal tau hyperphosphorylation in vivo.", annotationSubgraph:["Tumor necrosis factor subgraph", "Tau protein subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12402041", citationType:"PubMed", citationRef:"12402041"}}, {start: {_id:328}, end: {_id:3501}, properties:{evidence:"S100beta interaction with tau is promoted by zinc and inhibited by hyperphosphorylation in Alzheimer's disease.", pmid:"11264299", citationType:"PubMed", citationRef:"11264299"}}, {start: {_id:4265}, end: {_id:4266}, properties:{evidence:"In vitro autoradiography of rat and mouse spleen slices, as spleen expresses a high physiological expression of CB2 receptors, demonstrated that [11C]KP23 exhibits specific binding towards CB2.", annotationSpecies:["10116", "10090"], annotationMeshanatomy:["Spleen"], annotationConfidence:["Medium"], pmid:"24662272", citationType:"PubMed", citationRef:"24662272"}}, {start: {_id:4286}, end: {_id:4288}, properties:{evidence:"In this study, we first showed that heptapeptide XD4 activates the class A scavenger receptor (SR-A) on the glia by increasing the binding of Abeta to SR-A, thereby promoting glial phagocytosis of Abeta oligomer in microglia and astrocytes and triggering intracellular mitogen-activated protein kinase (MAPK) signaling cascades.", annotationSubgraph:["MAPK-ERK subgraph"], annotationMeshanatomy:["Neuroglia", "Astrocytes", "Microglia"], annotationConfidence:["Medium"], citationType:"PubMed Central", citationRef:"PMC3981768"}}, {start: {_id:4778}, end: {_id:4784}, properties:{evidence:"By treatment of cells with octaarginine (R8), enhanced clustering of syndecan-4 on plasma membranes and binding of protein kinase Calpha (PKCalpha) to the cytoplasmic domain of syndecan-4 were observed; these events potentially lead to the macropinocytic uptake of R8.", annotationSubgraph:["Syndecan subgraph"], annotationConfidence:["Medium"], pmid:"24632200", citationType:"PubMed", citationRef:"24632200"}}, {start: {_id:4747}, end: {_id:4790}, properties:{evidence:"Among the SDC mutants, the highest luciferase activity could be detected on those expressing the HS chains (HSA.pSi4 and HAS.pSi1), while the lowest on the ones devoid of HS (CBD.pSi4 and .pSi4), thus showing the major role of polyanionic HS chains in attaching cationic lipoplexes like DMRIE-C (Fig 2B).", annotationSubgraph:["Syndecan subgraph"], annotationConfidence:["Medium"], pmid:"23732629", citationType:"PubMed", citationRef:"23732629"}}, {start: {_id:4806}, end: {_id:4807}, properties:{evidence:"In this work we strove to assess the role of heparan sulfate (HS) chains in HPV16 binding to the ECM and determine how HPV16 release from the ECM is regulated. We also assessed the extent to which capsids released from the ECM are infectious. We show that a large fraction of HPV16 particles binds to the ECM via HS chains, and that syndecan-1 (snd-1) molecules present in the ECM are involved in virus binding.", annotationConfidence:["Medium"], pmid:"26289843", citationType:"PubMed", citationRef:"26289843"}}, {start: {_id:4806}, end: {_id:4808}, properties:{evidence:"The entry of HPV particles into human keratinocyte (HK) host cells is a multistep process initiated by binding to primary attachment factors, most commonly the heparan sulfate (HS) chains of proteoglycans (HSPGs) (Joyce et al., 1999; Combita et al., 2001; Giroglou et al., 2001). Syndecan-1 (snd-1), the most abundant HSPG in keratinocytes, serves as an HPV attachment receptor (Selinka et al., 2002; Shafti-Keramat et al., 2003).", annotationCell:["keratinocyte"], annotationConfidence:["Medium"], pmid:"26289843", citationType:"PubMed", citationRef:"26289843"}}, {start: {_id:4806}, end: {_id:4807}, properties:{evidence:"The entry of HPV particles into human keratinocyte (HK) host cells is a multistep process initiated by binding to primary attachment factors, most commonly the heparan sulfate (HS) chains of proteoglycans (HSPGs) (Joyce et al., 1999; Combita et al., 2001; Giroglou et al., 2001). Syndecan-1 (snd-1), the most abundant HSPG in keratinocytes, serves as an HPV attachment receptor (Selinka et al., 2002; Shafti-Keramat et al., 2003).", annotationCell:["keratinocyte"], annotationConfidence:["Medium"], pmid:"26289843", citationType:"PubMed", citationRef:"26289843"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1107}, end: {_id:1225}, properties:{annotationGender:["Female"], evidence:"Clinical tr ials in health y hum ans under hyper insulin emic euglycemic clamp conditions showed a n egative shi ft in transcortica l direct current potentials, indicati ng that circ ulatÂ­ ing insulin can rapidly act on brain activity independent from its systemic effects [91 ]. Longitudinal studies revealed th at insulin resistance with persisting hyperi nsu linem i a comes along w ith an elevated risk for disturbed cognition, impa ired memory and A D (10, 92, 93]. In AD patients as well as i n h ealthy subjects hyperinsulinemic eug lycemic clamp studies revea led an i mproving effect of.insu li n on cognitive functio n (94, 95]. Intranasa l app l ication of insu lin in healthy hum ans directly entered th e CSF and improved memory function and cogn it ive capacity especi a lly in women with out in fluencing per i phera l blood gl ucose levels (96-98]. These gender speÂ­ cific findings suggest an influence of sex hormon es. Accord Â­ ingly, Cl egg el a!. d emonstrated th a t i nsul in sensitiv i ty in ra t brains differ, dependin g on estrogen levels (99].", annotationSubgraph:["Insulin signal transduction"], annotationMeshanatomy:["Blood"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}] AS row
