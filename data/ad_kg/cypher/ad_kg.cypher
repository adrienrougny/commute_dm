UNWIND [{start: {_id:2765}, end: {_id:2766}, properties:{evidence:"Furthermore, CAST overexpression prevented the decrease in the phosphorylation of the memory-related molecules CREB and ERK in the brain of APP/PS1 mice and improved spatial learning and memory.", annotationSubgraph:["Calpastatin-calpain subgraph", "Cell cycle subgraph", "CREB subgraph"], annotationConfidence:["High"], pmid:"20595388", citationType:"PubMed", citationRef:"20595388"}}, {start: {_id:2765}, end: {_id:888}, properties:{evidence:"Furthermore, CAST overexpression prevented the decrease in the phosphorylation of the memory-related molecules CREB and ERK in the brain of APP/PS1 mice and improved spatial learning and memory.", annotationSubgraph:["Calpastatin-calpain subgraph", "MAPK-ERK subgraph"], annotationConfidence:["High"], pmid:"20595388", citationType:"PubMed", citationRef:"20595388"}}, {start: {_id:2763}, end: {_id:20}, properties:{evidence:"Consistently, overexpression of calpain in heterologous APP expressing cells up-regulated the level of BACE1 and increased Abeta production.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20595388", citationType:"PubMed", citationRef:"20595388"}}, {start: {_id:1906}, end: {_id:22}, properties:{evidence:"It has also been shown in animal pmodels that under conditions of reduced M1/M3 muscarinic acetylcholine receptor stimulation the secretory pathway of APP processing is inhibited and that constitutive upregulation of M1/M3-associated PKC increases APP secretion.", annotationSubgraph:["Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"9775403", citationType:"PubMed", citationRef:"9775403"}}, {start: {_id:2859}, end: {_id:2862}, properties:{evidence:"We report that the SCF(Fbx2) -E3 ligase is involved in the binding and ubiquitination of BACE1 via its Trp 280 residue of F-box-associated domain.", annotationSubgraph:["Beta secretase subgraph"], pmid:"20854419", cita