otationConfidence:["Very High"], pmid:"19388207", citationType:"PubMed", citationRef:"19388207"}}, {start: {_id:4149}, end: {_id:4151}, properties:{evidence:"Evodiamine Induces Transient Receptor Potential Vanilloid-1-Mediated Protective Autophagy in U87-MG Astrocytes.", annotationMeshanatomy:["Astrocytes"], annotationConfidence:["Medium"], annotationCellline:["obsolete: U87 MG cell"], pmid:"24454492", citationType:"PubMed", citationRef:"24454492"}}, {start: {_id:4156}, end: {_id:1601}, properties:{evidence:"Furthermore, cellular signaling experiments showed that Pls enhanced phosphorylation of the phosphoinositide 3-kinase (PI3K)-dependent serine/threonine-specific protein kinase AKT and extracellular-signal- regulated kinases ERK1/2.", annotationMeshanatomy:["Serum"], annotationConfidence:["Medium"], pmid:"24357806", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:4188}, end: {_id:4193}, properties:{evidence:"TLR4 mediates the impairment of ubiquitin-proteasome and autophagy- lysosome pathways induced by ethanol treatment in brain.", annotationSubgraph:["Toll like receptor subgraph"], annotationMeshanatomy:["Brain", "Lysosomes"], pmid:"24556681", citationType:"PubMed", citationRef:"24556681"}}] AS row
