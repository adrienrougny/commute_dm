ationRef:"24456642"}}, {start: {_id:4163}, end: {_id:4160}, properties:{evidence:"These results show that IFNgamma, TGFbeta1 and M-CSF have species- and cell type-specific effects on human brain cells that may have implications for their roles in adult human brain inflammation.", annotationSpecies:["9606"], annotationMeshdisease:["Encephalitis"], annotationMeshanatomy:["Brain"], pmid:"24339874", citationType:"PubMed", citationRef:"24339874"}}, {start: {_id:4164}, end: {_id:534}, properties:{evidence:"We found that frontal CC regions were preserved with respect to the posterior ones in aMCI; in these individuals significant correlations were seen between DTI-derived metrics in frontal-parietal CC areas and Abeta42-stimulated BDNF-producing CD4+ T lymphocytes and PDL-1-expressing CD14+ cells.", annotationMeshanatomy:["T-Lymphocytes"], annotationConfidence:["High"], pmid:"24324435", citationType:"PubMed", citationRef:"24324435"}}, {start: {_id:1852}, end: {_id:4225}, properties:{evidence:"We report the effect of three structurally different PPARgamma agonists inducing apoptosis in human (U87MG and A172) and rat (C6) glioma cells.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationSpecies:["10116", "9606"], annotationMeshdisease:["Glioma"], annotationConfidence:["High"], pmid:"12065618", annotationCellline:["A172"], citationType:"PubMed", citationRef:"12065618"}}, {start: {_id:4272}, end: {_id:1141}, properties:{evidence:"Four weeks after rAAV2-IL-1beta transduction, we found significant reductions in 6E10 and Congo red staining of amyloid plaques that was confirmed by decreased levels of insoluble Abeta1-42 and Abeta1-40 in the inflamed hippocampus.", annotationSubgraph:["Interleukin signaling subgraph", "Amyloidogenic subgraph"], annotationMeshdisease:["Plaque, Amyloid"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24874542", citationType:"PubMed", citationRef:"24874542"}}, {start: {_id:2156}, end: {