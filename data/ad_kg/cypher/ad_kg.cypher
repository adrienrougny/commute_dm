UNWIND [{start: {_id:3631}, end: {_id:3}, properties:{evidence:"Defects in axonal transport are an early pathological feature in Alzheimer's disease and defective APP transport is known to increase ABeta¸ production. We show that calsyntenin-1 and APP are co- transported through axons and that siRNA-induced loss of calsyntenin-1 markedly disrupts axonal transport of APP. Thus, perturbation to axonal transport of APP on calsyntenin-1 containing carriers induces alterations to APP processing that increase production of ABeta¸. Together, our findings suggest that disruption of calsyntenin-1-associated axonal transport of APP is a pathogenic mechanism in Alzheimer's disease.", annotationSubgraph:["Amyloidogenic subgraph", "Axonal transport subgraph"], annotationMeshanatomy:["Axons"], annotationConfidence:["Medium"], pmid:"22434822", citationType:"PubMed", citationRef:"22434822"}}] AS row
