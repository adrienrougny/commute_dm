UNWIND [{start: {_id:2030}, end: {_id:1148}, properties:{evidence:"S-nitrosoglutathione (GSNO) is an endogenous nitric oxide carrier modulating endothelial function, inflammation, and neurotransmission.", annotationSubgraph:["Inflammatory response subgraph", "Nitric oxide subgraph"], annotationMeshdisease:["Inflammation"], annotationConfidence:["Medium"], pmid:"23254638", citationType:"PubMed", citationRef:"23254638"}}] AS row
