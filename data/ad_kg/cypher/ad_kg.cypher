UNWIND [{start: {_id:27}, end: {_id:189}, properties:{evidence:"The blood levels of catalase but not superoxide dismutase and glutathione were significantly decreased in the patients with severe AD when compared to controls (p < .01),", annotationSubgraph:["Glutathione reductase subgraph"], annotationMeshanatomy:["Blood"], annotationConfidence:["Medium"], pmid:"12094909", citationType:"PubMed", citationRef:"12094909"}}, {start: {_id:27}, end: {_id:1962}, properties:{evidence:"The APP ratio was slightly but not significantly decreased in AD patients, whereas CD40L and serotonin were unchanged.", annotationSubgraph:["T cells signaling"], pmid:"21875409", citationType:"PubMed", citationRef:"21875409"}}, {start: {_id:1160}, end: {_id:4267}, properties:{evidence:"The hippocampal lipid peroxidation correlated strongly with the increase of LOC positive fiber load, whereas neocortical TBARS levels were unrelated to amyloidosis. These data illustrate for the first time the progression of major AD related neuropathological features other than plaque load in the APPSL mouse model.", annotationSpecies:["10090"], annotationMeshdisease:["Plaque, Amyloid", "Amyloidosis"], annotationMeshanatomy:["Hippocampus", "Neocortex"], annotationConfidence:["Medium"], pmid:"24886182", citationType:"PubMed", citationRef:"24886182"}}] AS row
