UNWIND [{start: {_id:1117}, end: {_id:118}, properties:{evidence:"since around 2005, this field literally exploded with new information and a new concept, i.e., that primary brain insulin resistance and insulin deficiency mediate cognitive impairment and AD. This idea was fueled by evidence that tau gene expression and phosphorylation are regulated through insulin and insulin-like growth factor (IGF) signaling cascades.23,24", annotationSubgraph:["Insulin signal transduction", "Tau protein subgraph"], annotationMeshanatomy:["Adipocytes"], annotationConfidence:["Medium"], pmid:"19885299", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:855}, end: {_id:854}, properties:{evidence:"In the Wnt/beta-catenin cascade, signaling events converge on the regulation of ubiquitin-mediated degradation of the crucial transcriptional regulator beta-catenin.", annotationSubgraph:["Wnt signaling subgraph"], pmid:"20930545", citationType:"PubMed", citationRef:"20930545"}}] AS row
