UNWIND [{start: {_id:116}, end: {_id:772}, properties:{evidence:"Cyclin-dependent kinase 5 (Cdk5) activity is significantly increased in AD and contributes to all three hallmarks: neurotoxic amyloid-beta (Abeta), neurofibrillary tangles (NFT), and extensive cell death.", annotationSubgraph:["Amyloidogenic subgraph", "Cyclin-CDK subgraph"], annotationConfidence:["Medium"], pmid:"21389115", citationType:"PubMed", citationRef:"21389115"}}, {start: {_id:123}, end: {_id:3376}, properties:{evidence:"This interaction is regulated by the phosphorylation of Tau at selected sites, by glycogen synthase kinase-3beta (GSK3beta) and cyclin-dependent kinase 5 (Cdk5), and requires an intact microtubule network.", annotationSubgraph:["Tau protein subgraph", "Amyloidogenic subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"15686969", citationType:"PubMed", citationRef:"15686969"}}, {start: {_id:116}, end: {_id:3376}, properties:{evidence:"This interaction is regulated by the phosphorylation of Tau at selected sites, by glycogen synthase kinase-3beta (GSK3beta) and cyclin-dependent kinase 5 (Cdk5), and requires an intact microtubule network.", annotationSubgraph:["Tau protein subgraph", "Amyloidogenic subgraph", "Cyclin-CDK subgraph"], annotationConfidence:["High"], pmid:"15686969", citationType:"PubMed", citationRef:"15686969"}}] AS row
