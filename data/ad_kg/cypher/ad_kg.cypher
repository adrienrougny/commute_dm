UNWIND [{start: {_id:4885}, end: {_id:4874}, properties:{evidence:"Furthermore, following literature-curated searches and recent mass spectrometric analysis of IQGAP1-binding partners, we report that IQGAP1 recruits other small GTPases, including RhoC, Rac2, M-Ras, RhoQ, Rab10, and Rab5, small GTPase regulators, including Tiam1, RacGAP1, srGAP2 and HERC1, and small GTPase effectors, including PAK6, N-WASP, several sub-units of the Arp2/3 complex and the formin mDia1.", annotationSubgraph:["Regulation of actin cytoskeleton subgraph"], pmid:"24355937", citationType:"PubMed", citationRef:"24355937"}}, {start: {_id:30}, end: {_id:22}, properties:{evidence:"The transport of amyloid precursor protein is mediated through its interaction with kinesin light-chain 1 (KNS2).", annotationSubgraph:["Innate immune system subgraph", "Amyloidogenic subgraph", "Axonal transport subgraph"], annotationConfidence:["High"], pmid:"15364413", citationType:"PubMed", citationRef:"15364413"}}, {start: {_id:30}, end: {_id:203}, properties:{evidence:"The virus [HSV-1] is transported to the nucleus via the dynein and kinesin (KNS2) motors associated with the microtubule network (MAPT)... A viral protein is also able to delete mitochondrial DNA, a situation prevalent in Alzheimer's disease.", annotationSubgraph:["Innate immune system subgraph", "Tau protein subgraph", "Axonal transport subgraph"], annotationConfidence:["High"], pmid:"18164103", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18164103"}}, {start: {_id:30}, end: {_id:22}, properties:{evidence:"Second, reduced transport of APP by KLC1vE triggers an ER stress response that activates the amyloidogenic pathway.", annotationSubgraph:["Innate immune system subgraph", "Amyloidogenic subgraph", "Axonal transport subgraph"], annotationConfidence:["Medium"], pmid:"25394182", citationType:"PubMed", citationRef:"25394182"}}, {start: {_id:4888}, end: {_id:4891}, properties:{evidence:"p115 catalyzes the construction of a cognate GOS-28–syntaxin-5 (v-/t-SNARE) complex by first linking the SNAREs to promote their direct interaction.", annotationSubgraph:["Synaptic vesicle endocytosis subgraph"], pmid:"11927603", citationType:"PubMed", citationRef:"11927603"}}, {start: {_id:4892}, end: {_id:4891}, properties:{evidence:"p115 catalyzes the construction of a cognate GOS-28–syntaxin-5 (v-/t-SNARE) complex by first linking the SNAREs to promote their direct interaction.", annotationSubgraph:["Synaptic vesicle endocytosis subgraph"], pmid:"11927603", citationType:"PubMed", citationRef:"11927603"}}, {start: {_id:4891}, end: {_id:4893}, properties:{evidence:"Coimmunoprecipitation experiments suggest that GS15 exists in a distinct SNARE complex that contains SNAREs (syntaxin5, GS28, and Ykt6) that are implicated in both ER-to-Golgi and intra-Golgi transport but not with SNAREs involved exclusively in ER-to-Golgi traffic.", annotationSubgraph:["Endoplasmic reticulum-Golgi protein export"], pmid:"12388752", citationType:"PubMed", citationRef:"12388752"}}, {start: {_id:263}, end: {_id:2100}, properties:{evidence:"Importantly, expression of the CRE-driven immediate early gene, Egr-1 (Zif268) is decreased in the CA1 region of the hippocampus.", annotationSubgraph:["Gamma secretase subgraph"], pmid:"26682682", annotationAnatomy:["CA1 field of hippocampus"], citationType:"PubMed", citationRef:"26682682"}}, {start: {_id:3378}, end: {_id:6}, properties:{evidence:"Lower levels of TIMPs in AD patients with microbleeds suggest less MMP inhibition in patients with concurrent cerebral microbleeds, which may hypothetically lead to a more vulnerable blood-brain barrier in these patients.In addition, we assessed associations of MMPs and TIMPs with CSF amyloid-beta(1-42) (Abeta42), tau, and tau phosphorylated at threonine-181 (p-tau)", annotationSubgraph:["Amyloidogenic subgraph", "Matrix metalloproteinase subgraph"], annotationConfidence:["Medium"], pmid:"26402072", citationType:"PubMed", citationRef:"2