UNWIND [{start: {_id:2219}, end: {_id:2220}, properties:{evidence:"These findings extend the existing hypotheses that low tPA activity promotes AD, whereas increased tPA activity contributes to cerebellar degeneration.", annotationSubgraph:["Plasminogen activator subgraph"], pmid:"21519332", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21519332"}}, {start: {_id:229}, end: {_id:434}, properties:{evidence:"mTOR Hyperactivation in Down Syndrome Hippocampus Appears Early During Development.", annotationSubgraph:["mTOR signaling subgraph"], annotationMeshdisease:["Down Syndrome"], annotationMeshanatomy:["Hippocampus"], pmid:"24918639", citationType:"PubMed", citationRef:"24918639"}}, {start: {_id:2455}, end: {_id:27}, properties:{evidence:"Apoptosis plays a significant role in cell loss during neurodegenerative disorders such as Alzheimer's disease (AD) (Loh et al., 2006). A cascade of events like activation of caspases and aspartate-specific cysteine proteases has been proposed to play a key role in apoptosis (Nicholson and Thornberry ,1997). The major apoptotic pathway is characterized by mitochondrial dysfunction with the release of cytochrome c, activation of caspase-9, and subsequently of caspase-3. It has been suggested that caspase-3 is an ultimate effectors caspase whose activation leads to switch on the apoptotic cascade. Evidences of caspase-3 activation were also found in postmortem study conducted on the brain of AD patient (Engidawork et al., 2001).", annotationSubgraph:["Caspase subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"21893081", citationType:"PubMed", citationRef:"21893081"}}, {start: {_id:1362}, end: {_id:27}, properties:{evidence:"AIMS: Several observations point to the involvement of angiotensin- converting enzyme-1 (ACE-1) in Alzheimer's disease (AD): ACE-1 cleaves amyloid-beta peptide (Abeta) in vitro, the level and activity of ACE-1 are reportedly increased in AD, and variations in the ACE-1 gene are associated with AD.", annotationSubgraph:["Renin-angiotensin subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17973905", citationType:"PubMed", citationRef:"17973905"}}, {start: {_id:4536}, end: {_id:27}, properties:{evidence:"histone deacetylase (HDAC) activity is elevated in the AD model", pmid:"25058791", citationType:"PubMed", citationRef:"25058791"}}] AS row
