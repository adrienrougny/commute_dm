UNWIND [{start: {_id:27}, end: {_id:966}, properties:{evidence:"Alzheimer's disease (AD) is associated with accumulations of amyloid- beta (Abeta) peptides, oxidative damage, mitochondrial dysfunction, neurodegeneration, and dementia", annotationSubgraph:["Response to oxidative stress", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16687508", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"16687508"}}, {start: {_id:733}, end: {_id:27}, properties:{evidence:"Evidence has suggested that insulin resistance (IR) or high levels of glucocorticoids (GCs) may be linked with the pathogenesis and/or progression of Alzheimer's disease (AD).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"22536436", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22536436"}}, {start: {_id:27}, end: {_id:1098}, properties:{evidence:"a number of clinical and epidemiological studies have provided further direct evidence to strengthen the link between T2D and AD (1, 2)", annotationConfidence:["High"], pmid:"20385830", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"20385830"}}, {start: {_id:1160}, end: {_id:27}, properties:{evidence:"Amyloid is a term used to describe typically extracellular deposits of aggregated proteins, sometimes known as plaques. Abnormal accumulation of amyloid is Amyloidosis, a term associated with diseased organs and tissues, particularly neurodegenerative diseases such as Alzheimer's, Parkinson's and Huntingdon's. Amyloid deposits consist predominantly of amyloid fibrils, rigid, non-branching structures that form ordered assemblies, characteristically with a cross beta-sheet structure where the sheets run parallel to the direction of the fibril (Sawaya et al. 2007). Often the fibril has a left-handed twist (Nelson & Eisenberg 2006). At least 27 human proteins form amyloid fibrils (Sipe et al. 2010). Many of these proteins have non-pathological functions; the trigger that leads to abnormal aggregations differs between proteins and is not well understood but in many cases the peptides are abnormal fragments or mutant forms arising from polymorphisms, suggesting that the initial event may be aggregation of misfolded or unfolded peptides. Early studies of Amyloid-Beta assembly led to a widely accepted model that assembly was a nucleation-dependent polymerization reaction (Teplow 1998) but it is now understood to be more complex, with multiple 'off-pathway' events leading to a variety of oligomeric structures in addition to fibrils (Roychaudhuri et al. 2008). An increasing body of evidence suggests that these oligomeric forms are primarily responsible for the neurotoxic effects of Amyloid-beta (Roychaudhuri et al. 2008), alpha-synuclein (Winner et al. 2011) and tau (Dance & Strobel 2009, Meraz-Rios et al. 2010). Amyloid oligomers are believed to have a common structural motif that is independent of the protein involved and not present in fibrils (Kayed et al. 2003). Conformation dependent, aggregation specific antibodies suggest that there are 3 general classes of amyloid oligomer structures (Glabe 2009) including annular structures which may be responsible for the widely reported membrane permeabilization effect of amyloid oligomers. Toxicity of amyloid oligomers preceeds the appearance of plaques in mouse models (Ferretti et al. 2011). Fibrils are often associated with other molecules, notably heparan sulfate proteoglycans and Serum Amyloid P-component, which are universally associated and seem to stabilize fibrils, possibly by protecting them from degradation.", citationTitle:"Amyloids", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], citationType:"Online Resource", citationRef:"REACT_75925.2"}}, {start: {_id:1160}, end: {_id:195}, properties:{evidence:"Amyloid is a term used to describe typically extracellular deposits of aggregated proteins, sometimes known as plaques. Abnormal accumulation of amyloid is Amyloidosis, a term associated with diseased organs and tissues, particularly neurodegenerative diseases such as Alzheimer's, Parkinson's and Huntingdon's. Amyloid deposits consist predominantly of amyloid fibrils, rigid, non-branching structures that form ordered assemblies, characteristically with a cross beta-sheet structure where the sheets run parallel to the direction of the fibril (Sawaya et al. 2007). Often the fibril has a left-handed twist (Nelson & Eisenberg 2006). At least 27 human proteins form amyloid fibrils (Sipe et al. 2010). Many of these proteins have non-pathological functions; the trigger that leads to abnormal aggregations differs between proteins and is not well understood but in many cases the peptides are abnormal fragments or mutant forms arising from polymorphisms, suggesting that the initial event may be aggregation of misfolded or unfolded peptides. Early studies of Amyloid-Beta assembly led to a widely accepted model that assembly was a nucleation-dependent polymerization reaction (Teplow 1998) but it is now understood to be more complex, with multiple 'off-pathway' events leading to a variety of oligomeric structures in addition to fibrils (Roychaudhuri et al. 2008). An increasing body of evidence suggests that these oligomeric forms are primarily responsible for the neurotoxic effects of Amyloid-beta (Roychaudhuri et al. 2008), alpha-synuclein (Winner et al. 2011) and tau (Dance & Strobel 2009, Meraz-Rios et al. 2010). Amyloid oligomers are believed to have a common structural motif that is independent of the protein involved and not present in fibrils (Kayed et al. 2003). Conformation dependent, aggregation specific antibodies suggest that there are 3 general classes of amyloid oligomer structures (Glabe 2009) including annular structures which may be responsible for the widely reported membrane permeabilization effect of amyloid oligomers. Toxicity of amyloid oligomers preceeds the appearance of plaques in mouse models (Ferretti et al. 2011). Fibrils are often associated with other molecules, notably heparan sulfate proteoglycans and Serum Amyloid P-component, which are universally associated and seem to stabilize fibrils, possibly by protecting them from degradation.", citationTitle:"Amyloids", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], citationType:"Online Resource", citationRef:"REACT_75925.2"}}, {start: {_id:1160}, end: {_id:1161}, properties:{evidence:"Amyloid is a term used to describe typically extracellular deposits of aggregated proteins, sometimes known as plaques. Abnormal accumulation of amyloid is Amyloidosis, a term associated with diseased organs and tissues, particularly neurodegenerative diseases such as Alzheimer's, Parkinson's and Huntingdon's. Amyloid deposits consist predominantly of amyloid fibrils, rigid, non-branching structures that form ordered assemblies, characteristically with a cross beta-sheet structure where the sheets run parallel to the direction of the fibril (Sawaya et al. 2007). Often the fibril has a left-handed twist (Nelson & Eisenberg 2006). At least 27 human proteins form amyloid fibrils (Sipe et al. 2010). Many of these proteins have non-pathological functions; the trigger that leads to abnormal aggregations differs between proteins and is not well understood but in many cases the peptides are abnormal fragments or mutant forms arising from polymorphisms, suggesting that the initial event may be aggregation of misfolded or unfolded peptides. Early studies of Amyloid-Beta assembly led to a widely accepted model that assembly was a nucleation-dependent polymerization reaction (Teplow 1998) but it is now understood to be more complex, with multiple 'off-pathway' events leading to a variety of oligomeric structures in addition to fibrils (Roychaudhuri et al. 2008). An increasing body of evidence suggests that these oligomeric forms are primarily responsible for the neurotoxic effects of Amyloid-beta (Roychaudhuri et al. 2008), alpha-synuclein (Winner et al. 2011) and tau (Dance & Strobel 2009, Meraz-Rios et al. 2010). Amyloid oligomers are believed to have a common structural motif that is independent of the protein involved and not present in fibrils (Kayed et al. 2003). Conformation dependent, aggregation specific antibodies suggest that there are 3 general classes of amyloid oligomer structures (Glabe 2009) including annular structures which may be responsible for the widely reported membrane permeabilization effect of amyloid oligomers. Toxicity of amyloid oligomers preceeds the appearance of plaques in mouse models (Ferretti et al. 2011). Fibrils are often associated with other molecules, notably heparan sulfate proteoglycans and Serum Amyloid P-component, which are universally associated and seem to stabilize fibrils, possibly by protecting them from degradation.", citationTitle:"Amyloids", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], citationType:"Online Resource", citationRef:"REACT_75925.2"}}, {start: {_id:966}, end: {_id:1164}, properties:{annotationPatient:["APOE e4 +ve"], evidence:"Patients without an APOE ε4 allele require higher amounts of insulin to improve memory [Craft and Watson, 2004], consistent with the observation of insulin resistance and hyperinsulinemia in some studies of APOE ε4 allele negative individuals [Kuusisto et al., 1997]. Furthermore, the association between diabetes and dementia is particularly strong in APOE ε4 carriers [Peila et al., 2002].", annotationSubgraph:["Insulin signal transduction", "APOE subgraph"], annotationConfidence:["High"], pmid:"19885299", citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:1255}, end: {_id:1098}, properties:{evidence:"To some extent vascular complications of type 2 diabetes or glucose intolerance might be leading to neurodegeneration due to insufficient neuronal nutrient supply as well as imÂ­ paired -amyloid (A) clearance from the brain [12] . FurÂ­thermore, disturbed cerebral perfusion due to endothelial dysfunction and alteration of the blood brain barrier results in upregulation of amyloid precursor protein (APP) expresÂ­ sion and Adeposition [13]. Also, hyperinsulinemia as it is present in type 2 diabetes may play an important role in forÂ­ mation of senile plaques (14].", annotationSubgraph:["Insulin signal transduction"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:733}, end: {_id:27}, properties:{evidence:"Clinical tr ials in health y hum ans under hyper insulin emic euglycemic clamp conditions showed a n egative shi ft in transcortica l direct current potentials, indicati ng that circ ulatÂ­ ing insulin can rapidly act on brain activity independent from its systemic effects [91 ]. Longitudinal studies revealed th at insulin resistance with persisting hyperi nsu linem i a comes along w ith an elevated risk for disturbed cognition, impa ired memory and A D (10, 92, 93]. In AD patients as well as i n h ealthy subjects hyperinsulinemic eug lycemic clamp studies revea led an i mproving effect of.insu li n on cognitive functio n (94, 95]. Intranasa l app l ication of insu lin in healthy hum ans directly entered th e CSF and improved memory function and cogn it ive capacity especi a lly in women with out in fluencing per i phera l blood gl ucose levels (96-98]. These gender speÂ­ cific findings suggest an influence of sex hormon es. Accord Â­ ingly, Cl egg el a!. d emonstrated th a t i nsul in sensitiv i ty in ra t brains differ, dependin g on estrogen levels (99].", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"19519303", annotationDisease:["hyperinsulinism"], citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:1163}, end: {_id:1335}, properties:{evidence:"Craft et a!. found that AD patients have higher plasma insulin but lower CSF insulin levels [71]. A possible exp l aÂ­ nation could be that cen tra l hypoinsulin emia is caused by reduced transport via the BBB or that peri pheral h yper insulinemia might be react ive to central hypoinsulinem ia, mediÂ­ ated by so far non distinctiv.e pathways. V ery recent data suggest that intranasal insu lin administration in AD patients im proves mem ory as well, providin g a possible therapeutic option ( l 00]. Tschritter et a/. (101] used a magnetoencephalography approach during a two-step hyperinsulinemic euglycemic clamp to assess cerebrocortical insulin effects in humans. In lean humans, stimulated cortical activity inÂ­ creased with insulin infusion relative to saline. In obese huÂ­ mans, these effects were suppressed, suggesting cerebral insulin resistance in these patients. Moreover, cerebrocortical insulin resistance was found in individuals carrying the Gly972Arg polymorphism of IRS-I, which is considered to elevate the risk to develop type 2 diabetes [I 0 I].", annotationSubgraph:["Insulin signal transduction"], annotationMeshanatomy:["Peripheral Nervous System"], annotationConfidence:["Low"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:733}, end: {_id:27}, properties:{evidence:"The underlying mechanisms of the association between AD neuropathology and DM2 emanate from several factors, however cortical insulin resistance and inflammatory pathÂ­ ways appear to be key components of this association. SonÂ­ nen eta/. [14] demonstrated the AD cases with DM2 had higher levels of cortical IL-6 and greater frequency of miÂ­ crovascular infarcts when compared to AD cases without DM2. Further research by Freude et al. [15] has linked hy-perinsulinemia to tau hyperphosphorylation which is an imÂ­ portant component in the process underlying AD pathology. Schubert eta!. [16] demonstrated that impaired cortical insuÂ­ lin resistance is also linked to tau hyperphosphorylation. Martins et al. [17] also describe several studies implicating neuronal insulin resistance as a precursor to increased amyÂ­ loid deposition. Additional work by Kulstad et al. [18] sugÂ­ gested that insulin levels are associated with abnormal reguÂ­ lation of AP clearance which may also play a mechanistic role in the formation of AD pathology.", annotationSubgraph:["Insulin signal transduction", "Tau protein subgraph"], annotationMeshanatomy:["Cerebral Cortex"], annotationConfidence:["High"], pmid:"23627755", citationType:"PubMed", citationRef:"23627755"}}, {start: {_id:733}, end: {_id:1098}, properties:{evidence:"The underlying mechanisms of the association between AD neuropathology and DM2 emanate from several factors, however cortical insulin resistance and inflammatory pathÂ­ ways appear to be key components of this association. SonÂ­ nen eta/. [14] demonstrated the AD cases with DM2 had higher levels of cortical IL-6 and greater frequency of miÂ­ crovascular infarcts when compared to AD cases without DM2. Further research by Freude et al. [15] has linked hy-perinsulinemia to tau hyperphosphorylation which is an imÂ­ portant component in the process underlying AD pathology. Schubert eta!. [16] demonstrated that impaired cortical insuÂ­ lin resistance is also linked to tau hyperphosphorylation. Martins et al. [17] also describe several studies implicating neuronal insulin resistance as a precursor to increased amyÂ­ loid deposition. Additional work by Kulstad et al. [18] sugÂ­ gested that insulin levels are associated with abnormal reguÂ­ lation of AP clearance which may also play a mechanistic role in the formation of AD pathology.", annotationSubgraph:["Insulin signal transduction", "Tau protein subgraph"], annotationMeshanatomy:["Cerebral Cortex"], annotationConfidence:["High"], pmid:"23627755", citationType:"PubMed", citationRef:"23627755"}}, {start: {_id:1414}, end: {_id:434}, properties:{evidence:"Here we report that the levels of a human brain-enriched miRNA-125b are up-regulated in interleukin-6 (IL-6)-stressed normal human astrocytes (NHA), a treatment known to induce astrogliosis. In vitro, anti-miRNA-125b added exogenously to IL-6-stressed NHA cultures attenuated both glial cell proliferation and increased the expression of the cyclin-dependent kinase inhibitor 2A (CDKN2A), a miRNA-125b target and negative regulator of cell growth. A strong positive correlation between miRNA-125b abundance and the glial cell markers glial fibrillary acidic protein (GFAP) and vimentin, and CDKN2A down- regulation was noted in advanced Alzheimer's disease (AD) and in Down's syndrome (DS) brain, chronic neurological disorders associated with astrogliosis. The results suggest that miRNA-125b up-regulation contributes to astrogliosis and to defects in the cell cycle that are characteristic of degenerating brain tissues.", annotationSubgraph:["miRNA subgraph"], pmid:"20347935", citationType:"PubMed", citationRef:"20347935"}}, {start: {_id:1098}, end: {_id:966}, properties:{annotationCellstructure:["Lysosomes"], evidence:"Lysosomal beta-galactosidase and beta-hexosaminidase activities correlate with clinical stages of dementia associated with Alzheimer's disease and type 2 diabetes mellitus.", annotationSubgraph:["Insulin signal transduction", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"21321400", citationType:"PubMed", citationRef:"21321400"}}, {start: {_id:27}, end: {_id:966}, properties:{annotationCellstructure:["Lysosomes"], evidence:"Lysosomal beta-galactosidase and beta-hexosaminidase activities correlate with clinical stages of dementia associated with Alzheimer's disease and type 2 diabetes mellitus.", annotationSubgraph:["Insulin signal transduction", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"21321400", citationType:"PubMed", citationRef:"21321400"}}, {start: {_id:1623}, end: {_id:1098}, properties:{evidence:"Hyperamylinemia, a common pancreatic disorder in obese and insulin- resistant patients, is known to cause amylin oligomerization and cytotoxicity in pancreatic islets, leading to beta-cell mass depletion and development of type 2 diabetes.", pmid:"23794448", citationType:"PubMed", citationRef:"23794448"}}, {start: {_id:1425}, end: {_id:1938}, properties:{evidence:"Importantly, miR-16 inhibition decreased animal survival in a xenograft model of MM by increasing tumor load and host angiogenesis.", annotationMeshdisease:["Neoplasms", "Multiple Myeloma"], pmid:"20962322", citationType:"PubMed", citationRef:"20962322"}}, {start: {_id:27}, end: {_id:1982}, properties:{evidence:"Hippocampal neurons are vulnerable to injury induced by Alzheimer's disease.", annotationMeshdisease:["Wounds and Injuries"], annotationMeshanatomy:["Hippocampus", "Neurons"], pmid:"18687381", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18687381"}}, {start: {_id:1982}, end: {_id:1989}, properties:{evidence:"Neurosurgical procedures such as craniotomy and brain tumor resection could potentially lead to unavoidable cerebral injuries.", annotationMeshdisease:["Wounds and Injuries", "Brain Neoplasms"], annotationMeshanatomy:["Cerebrum"], pmid:"24397933", citationType:"PubMed", citationRef:"24397933"}}, {start: {_id:27}, end: {_id:1831}, properties:{evidence:"Neuropsychiatric disorders such as depression are frequently associated with Alzheimer's disease (AD) and the degeneration of cholinergic basal forebrain neurons and reductions in acetylcholine that occur in AD have been identified as potential mediators of these secondary neuropsychiatric symptomologies.", annotationMeshanatomy:["Prosencephalon", "Neurons"], pmid:"21723926", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21723926"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1998}, end: {_id:27}, properties:{evidence:"Alzheimer's disease (AD) is characterized by progressive cognitive decline associated with a featured neuropathology (neuritic plaques and neurofibrillary tangles).", annotationMeshdisease:["Plaque, Amyloid", "Alzheimer Disease"], annotationMeshanatomy:["Neurofibrillary Tangles"], pmid:"24936870", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24936870"}}, {start: {_id:2025}, end: {_id:2026}, properties:{evidence:"MMP-2/MMP-9 plasma level and brain expression in cerebral amyloid angiopathy-associated hemorrhagic stroke.", annotationSubgraph:["Matrix metalloproteinase subgraph"], annotationMeshdisease:["Cerebral Amyloid Angiopathy", "Stroke"], annotationMeshanatomy:["Plasma"], pmid:"21707819", citationType:"PubMed", citationRef:"21707819"}}, {start: {_id:27}, end: {_id:2051}, properties:{evidence:"These results indicate that SARM is efficacious for the treatment of not only osteoporosis and sarcopenia, but also Alzheimer's disease.", annotationSubgraph:["Androgen subgraph"], annotationMeshdisease:["Osteoporosis", "Sarcopenia", "Alzheimer Disease"], pmid:"24177288", citationType:"PubMed", citationRef:"24177288"}}, {start: {_id:1148}, end: {_id:27}, properties:{evidence:"Inflammation is believed to play a role in Alzheimer's disease (AD).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["High"], pmid:"20308780", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"20308780"}}, {start: {_id:825}, end: {_id:1148}, properties:{evidence:"Since these functions of OPN, and the events that it regulates, are involved with neurodegeneration, we examined whether OPN was differentially expressed in the hippocampus of the Alzheimer's disease (AD) compared with age-matched (59-93 years) control brain.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Hippocampus", "Brain"], annotationConfidence:["High"], pmid:"17316167", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:1148}, end: {_id:2018}, properties:{evidence:"The role of inflammation in Alzheimer's disease, Parkinson's disease, and multiple sclerosis has recently come under increased scrutiny.", annotationSubgraph:["Inflammatory response subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Multiple Sclerosis", "Parkinson Disease", "Inflammation", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"18554520", citationType:"PubMed", citationRef:"18554520"}}, {start: {_id:1148}, end: {_id:27}, properties:{evidence:"The role of inflammation in Alzheimer's disease, Parkinson's disease, and multiple sclerosis has recently come under increased scrutiny.", annotationSubgraph:["Inflammatory response subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Multiple Sclerosis", "Parkinson Disease", "Inflammation", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"18554520", citationType:"PubMed", citationRef:"18554520"}}, {start: {_id:1148}, end: {_id:195}, properties:{evidence:"The role of inflammation in Alzheimer's disease, Parkinson's disease, and multiple sclerosis has recently come under increased scrutiny.", annotationSubgraph:["Inflammatory response subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Multiple Sclerosis", "Parkinson Disease", "Inflammation", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"18554520", citationType:"PubMed", citationRef:"18554520"}}, {start: {_id:966}, end: {_id:27}, properties:{evidence:"Alzheimer's disease (AD) is the most common cause of dementia in the elderly.", annotationConfidence:["High"], pmid:"12946561", annotationDisease:["dementia", "Alzheimer's disease"], citationType:"PubMed", citationRef:"12946561"}}, {start: {_id:966}, end: {_id:27}, properties:{evidence:"Alzheimer's disease (AD) is the most common type of dementia accounting for 60-80% of the reported cases.", pmid:"23871825", annotationDisease:["dementia", "Alzheimer's disease"], citationType:"PubMed", citationRef:"23871825"}}, {start: {_id:27}, end: {_id:2025}, properties:{evidence:"For example, the occurrence of stroke increases with age and has been linked to neurodegenerative disorders like Alzheimer's disease (AD).", annotationMeshdisease:["Neurodegenerative Diseases", "Stroke", "Alzheimer Disease"], pmid:"17561312", citationType:"PubMed", citationRef:"17561312"}}, {start: {_id:27}, end: {_id:733}, properties:{evidence:"Alzheimer's disease (AD) is linked to CNS insulin resistance, decreased expression of insulin and insulin receptor genes, and lower cerebrospinal insulin levels.", annotationSubgraph:["Insulin signal transduction"], annotationMeshdisease:["Insulin Resistance", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"22142155", citationType:"PubMed", citationRef:"22142155"}}, {start: {_id:1098}, end: {_id:27}, properties:{evidence:"In late-onset sporadic Alzheimer disease changes in the brain are similar to those caused by non-insulin-dependent diabetes mellitus.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"15094078", citationType:"PubMed", citationRef:"15094078"}}, {start: {_id:27}, end: {_id:2026}, properties:{evidence:"The accumulation of fibrillar amyloid-beta protein (A beta) in cerebral blood vessels, a condition known as cerebral amyloid angiopathy (CAA), is a key pathological feature of Alzheimer's disease and certain related disorders and is intimately associated with cerebrovascular cell death both in vivo and in vitro.", annotationMeshdisease:["Cerebral Amyloid Angiopathy", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"12754271", annotationAnatomy:["cerebral blood vessel"], citationType:"PubMed", citationRef:"12754271"}}, {start: {_id:1998}, end: {_id:1148}, properties:{evidence:"The presence of activated microglia and astrocytes in the vicinity of amyloid plaques in the brains of Alzheimer's disease (AD) patients and mouse models implicates inflammation as a contributor to AD pathogenesis.", annotationSpecies:["9606", "10090"], annotationMeshdisease:["Plaque, Amyloid", "Inflammation", "Alzheimer Disease"], annotationMeshanatomy:["Astrocytes", "Microglia", "Brain"], annotationConfidence:["High"], pmid:"24369524", citationType:"PubMed", citationRef:"24369524"}}, {start: {_id:4071}, end: {_id:27}, properties:{evidence:"Neuroinflammation plays a critical role in the pathogenesis of Alzheimer's disease (AD) and involves activation of the innate immune response via recognition of diverse stimuli by pattern recognition receptors (PRRs).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Medium"], pmid:"24694234", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24694234"}}, {start: {_id:966}, end: {_id:825}, properties:{evidence:"Among neurodegenerative disorders, Alzheimer's disease (AD) represents the most common cause of dementia in the elderly.", annotationMeshdisease:["Neurodegenerative Diseases", "Dementia", "Alzheimer Disease"], pmid:"24860504", citationType:"PubMed", citationRef:"24860504"}}, {start: {_id:966}, end: {_id:27}, properties:{evidence:"Among neurodegenerative disorders, Alzheimer's disease (AD) represents the most common cause of dementia in the elderly.", annotationMeshdisease:["Neurodegenerative Diseases", "Dementia", "Alzheimer Disease"], pmid:"24860504", citationType:"PubMed", citationRef:"24860504"}}, {start: {_id:1148}, end: {_id:27}, properties:{evidence:"Neuroinflammation affects the pathobiology of Alzheimer's disease (AD).", annotationSubgraph:["Amyloidogenic subgraph"], annotationMeshdisease:["Amyloidosis", "Alzheimer Disease"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"23040664", citationType:"PubMed", citationRef:"23040664"}}, {start: {_id:1989}, end: {_id:4251}, properties:{evidence:"Malignant astrocytomas are among the most common brain tumours and few therapeutic options exist.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationMeshdisease:["Astrocytoma", "Brain Neoplasms"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"12065618", citationType:"PubMed", citationRef:"12065618"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:27}, end: {_id:260}, properties:{evidence:"Beyond cognitive decline, Alzheimer's disease (AD) is characterized by numerous neuropathological changes in the brain.", annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"24886182", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24886182"}}, {start: {_id:1414}, end: {_id:27}, properties:{evidence:"Specifically, we demonstrate that microgliosis and astrocytosis are prominent aspects of this AD mouse model.", annotationSpecies:["10090"], annotationMeshdisease:["Plaque, Amyloid", "Gliosis"], annotationConfidence:["Medium"], pmid:"24886182", citationType:"PubMed", citationRef:"24886182"}}, {start: {_id:1148}, end: {_id:27}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"AD frontal cortex showed disease-specific hypermethylation in the promoter region of CREB, which may exacerbate reduced BDNF. Hypomethylation of NF-κB in the AD cortex may explain reported increased neuroinflammation due to upregulated NF-κB activity associated with its reduced methylation state. Furthermore, altered synaptic plasticity in AD is associated with reduced protein and mRNA levels of synaptophysin, which may be due to the hypermethylated state of its promoter region in AD brain samples.", pmid:"22760556", citationType:"PubMed", citationRef:"22760556"}}, {start: {_id:4822}, end: {_id:27}, properties:{evidence:"Stress exposure or increased levels of corticotropin-releasing factor (CRF) induce hippocampal tau phosphorylation (tau-P) in rodent models, a process that is dependent on the type-1 CRF receptor (CRFR1).", annotationSpecies:["10116"], pmid:"26790099", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"26790099"}}, {start: {_id:4822}, end: {_id:27}, properties:{evidence:"Clinical and basic science research suggests that stress and/or changes in central stress signaling intermediates may be involved in Alzheimer's disease (AD) pathogenesis. Although the links between stress and AD remain unsettled, data from our group and others have established that stress exposure in rodents may confer susceptibility to AD pathology by inducing hippocampal tau phosphorylation (tau-P). Work in our laboratory has shown that stress-induced tau-P requires activation of the type-1 corticotropin-releasing factor receptor (CRFR1).", annotationSubgraph:["CRH subgraph"], annotationSpecies:["10116"], pmid:"25125464", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25125464"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:4333}, end: {_id:4334}, properties:{evidence:"Moreover, endocannabinoid signaling has been demonstrated to modulate numerous concomitant pathological processes, including neuroinflammation, excitotoxicity, mitochondrial dysfunction, and oxidative stress.", annotationMeshdisease:["Pathologic Processes"], annotationConfidence:["Medium"], pmid:"24634659", citationType:"PubMed", citationRef:"24634659"}}, {start: {_id:4333}, end: {_id:1144}, properties:{evidence:"Moreover, endocannabinoid signaling has been demonstrated to modulate numerous concomitant pathological processes, including neuroinflammation, excitotoxicity, mitochondrial dysfunction, and oxidative stress.", annotationMeshdisease:["Pathologic Processes"], annotationConfidence:["Medium"], pmid:"24634659", citationType:"PubMed", citationRef:"24634659"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:REGULATES]->(end) SET r += row.properties;
UNWIND [{start: {_id:27}, end: {_id:143}, properties:{evidence:"In vitro and in vivo studies have consistently demonstrated a link between cholinergic activation and APP metabolism.Reduction in cholinergic neurotransmission--experimental or pathological, such as in AD--leads to amyloidogenic metabolism and contributes to the neuropathology and cognitive dysfunction", annotationSubgraph:["Acetylcholine signaling subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"12675140", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12675140"}}, {start: {_id:1098}, end: {_id:193}, properties:{evidence:"Herein, we review the evidence that (1) T2DM causes brain insulin resistance, oxidative stress, and cognitive impairment, but its aggregate effects fall far short of mimicking AD; (2) extensive disturbances in brain insulin and insulin-like growth factor (IGF) signaling mechanisms represent early and progressive abnormalities and could account for the majority of molecular, biochemical, and histopathological lesions in AD; (3) experimental brain diabetes produced by intracerebral administration of streptozotocin shares many features with AD, including cognitive impairment and disturbances in acetylcholine homeostasis; and (4) experimental brain diabetes is treatable with insulin sensitizer agents, i.e., drugs currently used to treat T2DM", annotationSubgraph:["Reactive oxygen species subgraph", "Insulin signal transduction"], annotationConfidence:["High"], pmid:"19885299", citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:27}, end: {_id:1138}, properties:{evidence:"In that study, we demonstrated advanced AD to be associated with strikingly reduced levels of insulin and IGF-1 polypeptide and receptor genes in the brain (Figure 1). In addition, all the signaling pathways that mediate insulin and IGF-1-stimulated neuronal survival, tau expression, energy metabolism, and mitochondrial function were perturbed in AD.", annotationSubgraph:["Insulin signal transduction", "Energy metabolic subgraph"], annotationMeshanatomy:["Adipocytes"], annotationConfidence:["High"], pmid:"19885299", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:1148}, end: {_id:1118}, properties:{evidence:"Interestingly, brain inflammation has recently been proposed to underlie defective neuronal insulin signaling in AD [14] Several pathological features, including impaired insulin signaling and inflammation, appear to be shared by patients with diabetes and patients with AD.", annotationSubgraph:["Inflammatory response subgraph", "Insulin signal transduction"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"24529528", citationType:"PubMed", citationRef:"24529528"}}, {start: {_id:27}, end: {_id:1560}, properties:{evidence:"Moreover, reduction of beta-cell replication capabilities results in reduction of beta-cell mass in mammals, simultaneously with impaired glucose tolerance.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Low"], pmid:"21537460", citationType:"PubMed", citationRef:"21537460"}}, {start: {_id:1098}, end: {_id:1560}, properties:{evidence:"Moreover, reduction of beta-cell replication capabilities results in reduction of beta-cell mass in mammals, simultaneously with impaired glucose tolerance.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Low"], pmid:"21537460", citationType:"PubMed", citationRef:"21537460"}}, {start: {_id:27}, end: {_id:442}, properties:{evidence:"We previously found phosphorylated pRb to be intimately associated with hyperphosphorylated tau-containing neurofibrillary tangles of Alzheimer disease (AD), the pathogenesis of which is believed to involve dysregulation of the cell cycle and marked neuronal death.", annotationSubgraph:["Tau protein subgraph", "Retinoblastoma subgraph"], annotationMeshanatomy:["Neurofibrillary Tangles"], annotationConfidence:["High"], pmid:"21666500", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21666500"}}, {start: {_id:27}, end: {_id:217}, properties:{evidence:"We previously found phosphorylated pRb to be intimately associated with hyperphosphorylated tau-containing neurofibrillary tangles of Alzheimer disease (AD), the pathogenesis of which is believed to involve dysregulation of the cell cycle and marked neuronal death.", annotationSubgraph:["Tau protein subgraph", "Retinoblastoma subgraph"], annotationMeshanatomy:["Neurofibrillary Tangles"], annotationConfidence:["High"], pmid:"21666500", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21666500"}}, {start: {_id:27}, end: {_id:2274}, properties:{evidence:"Hypercortisolemia and glucocorticoid receptor-signaling insufficiency in Alzheimer's disease initiation and development.", pmid:"23906001", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23906001"}}, {start: {_id:1142}, end: {_id:193}, properties:{evidence:"The epidemic and experimental studies have confirmed that the obesity can lead to neuroinflammation, neurodegenerative diseases and adversely affect cognition.", annotationMeshdisease:["Neurodegenerative Diseases", "Obesity"], pmid:"24667364", citationType:"PubMed", citationRef:"24667364"}}, {start: {_id:27}, end: {_id:4920}, properties:{evidence:"This work provides evidence that chemotaxis and phagocytosis, two crucial innate immune functions, are impaired in AD and MCI patients. Correlations with miRNA levels suggest an epigenetic contribution to systemic immune dysfunction in AD.", annotationSubgraph:["Chemokine signaling subgraph"], pmid:"4879648", citationType:"PubMed", citationRef:"4879648"}}, {start: {_id:27}, end: {_id:1042}, properties:{evidence:"This work provides evidence that chemotaxis and phagocytosis, two crucial innate immune functions, are impaired in AD and MCI patients. Correlations with miRNA levels suggest an epigenetic contribution to systemic immune dysfunction in AD.", annotationSubgraph:["Chemokine signaling subgraph"], pmid:"4879648", citationType:"PubMed", citationRef:"4879648"}}] AS row
