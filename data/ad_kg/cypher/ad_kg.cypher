UNWIND [{start: {_id:287}, end: {_id:289}, properties:{evidence:"These data indicate that PICALM, an adaptor protein involved in clathrin-dependent endocytosis, regulates APP internalization and subsequent Abeta generation. PICALM contributes to amyloid plaque load in brain likely via its effect on Abeta metabolism.", annotationSubgraph:["Amyloidogenic subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["Very High"], pmid:"22539346", citationType:"PubMed", citationRef:"22539346"}}] AS row
