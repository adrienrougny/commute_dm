UNWIND [{start: {_id:1679}, end: {_id:4290}, properties:{evidence:"The data demonstrated that intracerebroventrical infusions of aggregated Abeta1-42 (410 pmol/mouse) produced deficits in learning ability and memory, as evidenced by increase in escape latency during acquisition trials and decreases in exploratory activities in the probe trial in Morris water maze (MWM) task, and by decrease in the number of correct choices and increase in latency to enter the shock- free compartment in Y-maze test, and caused significant increases in pro-inflammatory cytokines such as NF-ÎºB p65, TNF-Î± and IL-1beta as well as pro-apoptotic molecule caspase-3 activation and anti-apoptotic protein Bcl-2 downregulation in hippocampus and cortex.", annotationSubgraph:["Bcl-2 subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24456746", citationType:"PubMed", citationRef:"24456746"}}, {start: {_id:1680}, end: {_id:4290}, properties:{evidence:"The data demonstrated that intracerebroventrical infusions of aggregated Abeta1-42 (410 pmol/mouse) produced deficits in learning ability and memory, as evidenced by increase in escape latency during acquisition trials and decreases in exploratory activities in the probe trial in Morris water maze (MWM) task, and by decrease in the number of correct choices and increase in latency to enter the shock- free compartment in Y-maze test, and caused significant increases in pro-inflammatory cytokines such as NF-ÎºB p65, TNF-Î± and IL-1beta as well as pro-apoptotic molecule caspase-3 activation and anti-apoptotic protein Bcl-2 downregulation in hippocampus and cortex.", annotationSubgraph:["Caspase subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24456746", citationType:"PubMed", citationRef:"24456746"}}, {start: {_id:1141}, end: {_id:4290}, properties:{evidence:"The data demonstrated that intracerebroventrical infusions of aggregated Abeta1-42 (410 pmol/mouse) produced deficits in learning ability and memory, as evidenced by increase in escape latency during acquisition trials and decreases in exploratory activities in the probe trial in Morris water maze (MWM) task, and by decrease in the number of correct choices and increase in latency to enter the shock- free compartment in Y-maze test, and caused significant increases in pro-inflammatory cytokines such as NF-ÎºB p65, TNF-Î± and IL-1beta as well as pro-apoptotic molecule caspase-3 activation and anti-apoptotic protein Bcl-2 downregulation in hippocampus and cortex.", annotationSubgraph:["Interleukin signaling subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24456746", citationType:"PubMed", citationRef:"24456746"}}, {start: {_id:2459}, end: {_id:4290}, properties:{evidence:"The data demonstrated that intracerebroventrical infusions of aggregated Abeta1-42 (410 pmol/mouse) produced deficits in learning ability and memory, as evidenced by increase in escape latency during acquisition trials and decreases in exploratory activities in the probe trial in Morris water maze (MWM) task, and by decrease in the number of correct choices and increase in latency to enter the shock- free compartment in Y-maze test, and caused significant increases in pro-inflammatory cytokines such as NF-ÎºB p65, TNF-Î± and IL-1beta as well as pro-apoptotic molecule caspase-3 activation and anti-apoptotic protein Bcl-2 downregulation in hippocampus and cortex.", annotationSubgraph:["Tumor necrosis factor subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24456746", citationType:"PubMed", citationRef:"24456746"}}, {start: {_id:2456}, end: {_id:4284}, properties:{evidence:"Interestingly, this treatment resulted in upregulation of protein or mRNA of CysLT1R in both hippocampus and cortex.", annotationSubgraph:["Tumor necrosis factor subgraph", "Bcl-2 subgraph"], annotationMeshanatomy:["Hippocampus"], pmid:"24456746", citationType:"PubMed", citationRef:"24456746"}}, {start: {_id:2399}, end: {_id:4292}, properties:{evidence:"Evaluation of DSP-8658 in the amyloid precursor protein/presenilin 1 mouse model confirmed an increased microglial Abeta phagocytosis in vivo, which subsequently resulted in a reduction of cortical and hippocampal Abeta levels.", annotationSubgraph:["Gamma secretase subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["Medium"], pmid:"23197723", citationType:"PubMed", citationRef:"23197723"}}, {start: {_id:4305}, end: {_id:4306}, properties:{evidence:"The data indicate that apart from acetylsalicylic acid (aspirin) and simvastatin, several neurophysiologically-relevant concentrations of Abetapeptides and neurotoxic trace metals variably induced ROS induction, COX-2 and cPLA2 expression.", annotationSubgraph:["Prostaglandin subgraph"], annotationConfidence:["High"], pmid:"24619568", citationType:"PubMed", citationRef:"24619568"}}, {start: {_id:4277}, end: {_id:4306}, properties:{evidence:"The data indicate that apart from acetylsalicylic acid (aspirin) and simvastatin, several neurophysiologically-relevant concentrations of Abetapeptides and neurotoxic trace metals variably induced ROS induction, COX-2 and cPLA2 expression.", annotationSubgraph:["Prostaglandin subgraph"], annotationConfidence:["High"], pmid:"24619568", citationType:"PubMed", citationRef:"24619568"}}, {start: {_id:4305}, end: {_id:4138}, properties:{evidence:"The data indicate that apart from acetylsalicylic acid (aspirin) and simvastatin, several neurophysiologically-relevant concentrations of Abetapeptides and neurotoxic trace metals variably induced ROS induction, COX-2 and cPLA2 expression.", annotationSubgraph:["Prostaglandin subgraph"], annotationConfidence:["High"], pmid:"24619568", citationType:"PubMed", citationRef:"24619568"}}, {start: {_id:4277}, end: {_id:4138}, properties:{evidence:"The data indicate that apart from acetylsalicylic acid (aspirin) and simvastatin, several neurophysiologically-relevant concentrations of Abetapeptides and neurotoxic trace metals variably induced ROS induction, COX-2 and cPLA2 expression.", annotationSubgraph:["Prostaglandin subgraph"], annotationConfidence:["High"], pmid:"24619568", citationType:"PubMed", citationRef:"24619568"}}, {start: {_id:4277}, end: {_id:1567}, properties:{evidence:"Norepinephrine enhances the LPS-induced expression of COX-2 and secretion of PGE2 in primary rat microglia.", annotationSubgraph:["Prostaglandin subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Microglia", "Bodily Secretions"], pmid:"20064241", citationType:"PubMed", citationRef:"20064241"}}, {start: {_id:4277}, end: {_id:1935}, properties:{evidence:"Norepinephrine enhances the LPS-induced expression of COX-2 and secretion of PGE2 in primary rat microglia.", annotationSubgraph:["Prostaglandin subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Microglia", "Bodily Secretions"], pmid:"20064241", citationType:"PubMed", citationRef:"20064241"}}, {start: {_id:4277}, end: {_id:1567}, properties:{evidence:"In the present study, we investigate the role of norepinephrine on cyclooxygenase- (COX-)2 expression/synthesis and prostaglandin (PG)E2 production in rat primary microglia.Interestingly, norepinephrine increased COX-2 mRNA, but not protein expression.", annotationSubgraph:["Prostaglandin subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Microglia"], pmid:"20064241", citationType:"PubMed", citationRef:"20064241"}}, {start: {_id:4277}, end: {_id:1567}, properties:{evidence:"Norepinephrine strongly enhanced COX-2 expression and PGE2 production induced by lipopolysaccharide (LPS).", annotationSubgraph:["Prostaglandin subgraph"], pmid:"20064241", citationType:"PubMed", citationRef:"20064241"}}, {start: {_id:4682}, end: {_id:4732}, properties:{evidence:"TREM2 is highly expressed in white matter, as well as in the hippocampus and neocortex, which is partly consistent with the pathological features reported in AD brain, indicating the possible involvement of TREM2 in AD pathogenesis.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["High"], pmid:"23407992", citationType:"PubMed", citationRef:"23407992"}}, {start: {_id:4682}, end: {_id:4733}, properties:{evidence:"TREM2 is highly expressed in white matter, as well as in the hippocampus and neocortex, which is partly consistent with the pathological features reported in AD brain, indicating the possible involvement of TREM2 in AD pathogenesis.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["High"], pmid:"23407992", citationType:"PubMed", citationRef:"23407992"}}, {start: {_id:4682}, end: {_id:4734}, properties:{evidence:"TREM2 is highly expressed in white matter, as well as in the hippocampus and neocortex, which is partly consistent with the pathological features reported in AD brain, indicating the possible involvement of TREM2 in AD pathogenesis.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["High"], pmid:"23407992", citationType:"PubMed", citationRef:"23407992"}}, {start: {_id:1948}, end: {_id:1369}, properties:{evidence:"Cyclin D1 positive neurons are colocalized with AGEs [Advanced glycation end products] or directly surrounded by extracellular AGE deposits in AD brain.", annotationSubgraph:["Cell cycle subgraph", "Estrogen subgraph"], pmid:"25448604", citationType:"PubMed", citationRef:"25448604"}}, {start: {_id:4905}, end: {_id:4904}, properties:{evidence:"Within focal adhesions, structural proteins, such as vinculin and talin, anchor beta-integrins to the actin cytoskeleton, while signaling proteins, such as focal adhesion kinase (FAK), Pyk2, paxillin, and Src, mediate downstream signaling events in a transient and controlled manner", annotationSubgraph:["Unfolded protein response subgraph"], annotationConfidence:["Medium"], pmid:"22223749", citationType:"PubMed", citationRef:"22223749"}}] AS r