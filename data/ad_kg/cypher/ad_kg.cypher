UNWIND [{start: {_id:182}, end: {_id:2086}, properties:{evidence:"In animal models of ischemic stroke, statins have proven to reduce infarct size through up-regulation of endothelial nitric oxide synthases.", annotationSubgraph:["Nitric oxide subgraph"], annotationMeshanatomy:["Endothelium"], annotationConfidence:["High"], pmid:"12218642", citationType:"PubMed", citationRef:"12218642"}}, {start: {_id:2126}, end: {_id:2105}, properties:{evidence:"Egr1 expression is induced following glatiramer acetate immunotherapy in rodent models of glaucoma and Alzheimer's disease.", annotationSubgraph:["GABA subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Glaucoma", "Alzheimer Disease"], annotationConfidence:["Medium"], pmid:"21969301", citationType:"PubMed", citationRef:"21969301"}}, {start: {_id:2126}, end: {_id:2100}, properties:{evidence:"In AD-Tg mice, a significant increase in hippocampal EGR1 protein levels was also found in response to GA immunization.", annotationSubgraph:["Gamma secretase subgraph", "GABA subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["Medium"], pmid:"21969301", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21969301"}}, {start: {_id:2191}, end: {_id:2196}, properties:{evidence:"At age 10 weeks the rats were subjected to neurobehavioral testing, then sacrificed for measurement of AMPK, beta-amyloid and Fas ligand in the hippocampus. Oral and subcutaneous MSG both induced a lowering of hippocampal AMPK by 43% and 31% respectively (P<0.05 for both) and >2-fold increase in hippocampal Fas ligand, a mediator of apoptosis (P<0.001 for both).", annotationSubgraph:["Tumor necrosis factor subgraph"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24769037", citationType:"PubMed", citationRef:"24769037"}}, {start: {_id:2191}, end: {_id:6}, properties:{evidence:"Pioglitazone decreased hippocampal beta-amyloid accumulation and Fas ligand, but did not ameliorate the neurobehavioural deficits induced by MSG. MSG treatment enhances beta-amyloid accumulation in the rat hippocampus.", annotationSubgraph:["Non-amyloidogenic subgraph", "Tumor necrosis factor subgraph"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["Medium"], pmid:"24769037", citationType:"PubMed", citationRef:"24769037"}}, {start: {_id:3}, end: {_id:2196}, properties:{evidence:"Neurons in both AD brain and Abeta-treated cultures exhibited FasL upregulation and changes in immunoreactivity for Fas receptor.", annotationSubgraph:["Tumor necrosis factor subgraph", "Amyloidogenic subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["Medium"], pmid:"12742739", citationType:"PubMed", citationRef:"12742739"}}, {start: {_id:3}, end: {_id:2237}, properties:{annotationCellstructure:["Cytoplasm", "Neurites"], evidence:"E2F1 was distributed throughout the cytoplasm and neurites of PC12 cells in response to Abeta and in the cytoplasm of cells in AD brain.", annotationSubgraph:["Retinoblastoma subgraph", "Amyloidogenic subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"11640947", annotationDisease:["Alzheimer's disease"], annotationCellline:["PC-12 cell"], citationType:"PubMed", citationRef:"11640947"}}, {start: {_id:2263}, end: {_id:1534}, properties:{evidence:"The administration of exogenous neurohormone melatonin at pharmacological doses has been shown not only to be an effective scavenger of reactive oxygen and nitrogen species but also to enhance the levels of GSH and the expression and activities of the GSH-related enzymes including gamma-GCL, GPxs, and GSR.", annotationSubgraph:["Glutathione reductase subgraph"], pmid:"20868358", citationType:"PubMed", citationRef:"20868358"}}, {start: {_id:2263}, end: {_id:2265}, properties:{evidence:"The administration of exogenous neurohormone melatonin at pharmacological doses has been shown not only to be an effective scavenger of reactive oxygen and nitrogen species but also to enhance the levels of GSH and the expression and activities of the GSH-related enzymes including gamma-GCL, GPxs, and GSR.", annotationSubgraph:["Glutathione reductase subgraph"], pmid:"20868358", citationType:"PubMed", citationRef:"20868358"}}, {start: {_id:189}, end: {_id:2268}, properties:{evidence:"Melatonin also enhances the antioxidant potential of the cell by stimulating the synthesis of antioxidant enzymes like superoxide dismutase, glutathione peroxidase and glutathione reductase, and by augmenting glutathione levels.", annotationSubgraph:["Free radical formation subgraph"], annotationConfidence:["Very High"], pmid:"16179266", citationType:"PubMed", citationRef:"16179266"}}, {start: {_id:189}, end: {_id:2269}, properties:{evidence:"Melatonin also enhances the antioxidant potential of the cell by stimulating the synthesis of antioxidant enzymes like superoxide dismutase, glutathione peroxidase and glutathione reductase, and by augmenting glutathione levels.", annotationSubgraph:["Free radical formation subgraph"], annotationConfidence:["Very High"], pmid:"16179266", citationType:"PubMed", citationRef:"16179266"}}, {start: {_id:189}, end: {_id:2270}, properties:{evidence:"Melatonin also enhances the antioxidant potential of the cell by stimulating the synthesis of antioxidant enzymes like superoxide dismutase, glutathione peroxidase and glutathione reductase, and by augmenting glutathione levels.", annotationConfidence:["Very High"], pmid:"16179266", citationType:"PubMed", citationRef:"16179266"}}, {start: {_id:189}, end: {_id:1534}, properties:{evidence:"Melatonin also enhances the antioxidant potential of the cell by stimulating the synthesis of antioxidant enzymes like superoxide dismutase, glutathione peroxidase and glutathione reductase, and by augmenting glutathione levels.", annotationSubgraph:["Glutathione reductase subgraph"], annotationConfidence:["Very High"], pmid:"16179266", citationType:"PubMed", citationRef:"16179266"}}, {start: {_id:2278}, end: {_id:2291}, properties:{evidence:"We have previously shown that chronic nicotine treatment can increase CYP2E1 in rat liver and brain.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Brain"], pmid:"16434548", citationType:"PubMed", citationRef:"16434548"}}, {start: {_id:2278}, end: {_id:2279}, properties:{evidence:"In contrast, acute nicotine treatment did not induce CYP2E1 in frontal cortex and hippocampus but increased CYP2E1 in cerebellum 8 h after treatment (1.6-fold, p < 0.01).", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationMeshanatomy:["Cerebellum"], pmid:"16434548", citationType:"PubMed", citationRef:"16434548"}}, {start: {_id:3}, end: {_id:2307}, properties:{evidence:"C/EBP homologous protein (CHOP), a pro-apoptotic ER stress protein, was expressed at high levels but glucose-regulated protein 78 (GRP78), an anti-apoptotic ER stress protein with chaperone activity, was only slightly affected by treatment with beta-amyloid.", annotationSubgraph:["Amyloidogenic subgraph", "Response DNA damage"], annotationConfidence:["Medium"], pmid:"23558999", citationType:"PubMed", citationRef:"23558999"}}, {start: {_id:3}, end: {_id:2353}, properties:{evidence:"Amyloid beta-protein stimulates the expression of urokinase-type plasminogen activator (uPA) and its receptor (uPAR) in human cerebrovascular smooth muscle cells.", annotationSubgraph:["Plasminogen activator subgraph", "Amyloidogenic subgraph"], annotationSpecies:["9606"], annotationCell:["regular cardiac myocyte"], annotationConfidence:["Medium"], pmid:"12754271", citationType:"PubMed", citationRef:"12754271"}}, {start: {_id:3}, end: {_id:2350}, properties:{evidence:"Amyloid beta-protein stimulates the expression of urokinase-type plasminogen activator (uPA) and its receptor (uPAR) in human cerebrovascular smooth muscle cells.", annotationSubgraph:["Plasminogen activator subgraph", "Amyloidogenic subgraph"], annotationSpecies:["9606"], annotationCell:["regular cardiac myocyte"], annotationConfidence:["Medium"], pmid:"12754271", citationType:"PubMed", citationRef:"12754271"}}, {start: {_id:2392}, end: {_id:1917}, properties:{evidence:"Acrolein induces Hsp72 via both PKCdelta/JNK and calcium signaling pathways in human umbilical vein endothelial cells.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "JAK-STAT signaling subgraph"], annotationSpecies:["9606"], annotationCell:["endothelial cell of umbilical vein"], pmid:"16036326", citationType:"PubMed", citationRef:"16036326"}}, {start: {_id:2437}, end: {_id:2440}, properties:{evidence:"When fed to AD transgenic mice, CNB-001 also increases eIF2Î± phosphorylation and HSP90 and ATF4 levels, and limits the accumulation of soluble Abeta and ubiquitinated aggregated proteins.", annotationSubgraph:["Unfolded protein response subgraph", "MAPK-JNK subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"23785163", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23785163"}}] AS row
