UNWIND [{start: {_id:269}, end: {_id:271}, properties:{evidence:"HSPB8 is a small heat shock protein that forms a complex with the co- chaperone BAG3. Overexpression of the HSPB8-BAG3 complex in cells stimulates autophagy and facilitates the clearance of mutated aggregation-prone proteins, whose accumulation is a hallmark of many neurodegenerative disorders.", annotationSubgraph:["Autophagy signaling subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21696420", citationType:"PubMed", citationRef:"21696420"}}, {start: {_id:321}, end: {_id:322}, properties:{annotationCellstructure:["Synapses"], evidence:"Amyloid-beta accumulation in the synapses directly disturbs mitochondrial function, causing oxidative stress, decreased ATP, and increased Ca2+ influx. Furthermore, the interaction of mitochondrial amyloid-beta with its binding proteins, such as ABAD and CypD, exacerbates amyloid-beta-induced mitochondria and neuronal stress and malfunction.", annotationSubgraph:["Reactive oxygen species subgraph", "Response to oxidative stress"], annotationConfidence:["Medium"], pmid:"22523685", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22523685"}}, {start: {_id:324}, end: {_id:322}, properties:{annotationCellstructure:["Synapses"], evidence:"Amyloid-beta accumulation in the synapses directly disturbs mitochondrial function, causing oxidative stress, decreased ATP, and increased Ca2+ influx. Furthermore, the interaction of mitochondrial amyloid-beta with its binding proteins, such as ABAD and CypD, exacerbates amyloid-beta-induced mitochondria and neuronal stress and malfunction.", annotationSubgraph:["Reactive oxygen species subgraph", "Response to oxidative stress"], annotationConfidence:["Medium"], pmid:"22523685", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22523685"}}, {start: {_id:702}, end: {_id:686}, properties:{evidence:"Molecular mechanisms of APP cleavage products in the regulation of GD3S enzyme activity. (A) In absence of Ab peptides a-series ganglioside GM3 binds to GD3S and is converted to the b-series ganglioside GD3. In presence of Ab, Ab binds ganglioside GM3, forming an Ab-GM3 complex. This complex still binds to GD3S, but cannot be converted to GD3. (B) Dual function of Ab and AICD in GD3S regulation. Ab reduces enzyme activity of GD3S by forming an Ab-GM3 complex, resulting in reduced turnover of GM3 to GD3. AICD binds the adaptor protein Fe65 and reduces GD3S gene transcription, which also results in reduced turnover of GM3 to GD3.", annotationSubgraph:["Sphingolipid metabolic subgraph"], annotationMeshanatomy:["Autonomic Fibers, Postganglionic"], pmid:"22470521", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22470521"}}, {start: {_id:2667}, end: {_id:3}, properties:{evidence:"We hypothesized LRP2 may be involved in efflux of apoJ out of the CNS, and Abeta binding to apoJ may enhance clearance of highly pathogenic Abeta42. Our data show that both RAP and LRP2-specific antibody block apoJ clearance, indicating LRP2 is required for apoJ efflux at the BBB.", annotationSubgraph:["Non-amyloidogenic subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["Medium"], pmid:"17077814", citationType:"PubMed", citationRef:"17077814"}}, {start: {_id:2966}, end: {_id:2964}, properties:{evidence:"We demonstrate that Fyn-Cdk5 complex acts as a downstream mediator of Sema3A signaling cascades that induce growth cone collapse.", annotationSubgraph:["Cyclin-CDK subgraph"], annotationConfidence:["High"], pmid:"16866215", citationType:"PubMed", citationRef:"16866215"}}, {start: {_id:2831}, end: {_id:3}, properties:{evidence:"The phosphotyrosine binding domain of the neuronal protein X11alpha/mint-1 binds to the C-terminus of amyloid precursor protein (APP) and inhibits catabolism to beta-amyloid (Abeta), but the mechanism of this effect is unclear.", annotationSubgraph:["Non-amyloidogenic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"14756819", citationType:"PubMed", citationRef:"14756819"}}, {start: {_id:4080}, end: {_id:76}, properties:{evidence:"It has been shown that apoE increased the production of nitric oxide (NO) from human monocyte-derived macrophages (MDM); this effect could represent an important link between tissue redox balance and inflammation, since inflammation and oxidative stress are involved in chronic neurodegenerative disorders. Moreover, it has been evidenced that an overproduction of NO in the central nervous system (CNS) may play a key role in aging and that the glial cells (microglials cells and probably astrocytes) are able to form consistent amounts of NO through the induction of a nitric oxide synthase (iNOS) isoform so- called inducible or inflammatory.We observed a decreased NO production after incubation with both LDL and HDL and an increased peroxynitrite production. As it concerns NOS expression, densitometric analysis of bands indicated that iNOS protein levels were significantly higher in the cells incubated with both AD lipoproteins and offspring lipoproteins compared to cells incubated with control lipoproteins. These findings suggest the possibility to identify in NO pathway a precocious marker of AD.", annotationSubgraph:["Nitric oxide subgraph"], annotationConfidence:["Medium"], pmid:"16054114", citationType:"PubMed", citationRef:"16054114"}}, {start: {_id:4081}, end: {_id:76}, properties:{evidence:"It has been shown that apoE increased the production of nitric oxide (NO) from human monocyte-derived macrophages (MDM); this effect could represent an important link between tissue redox balance and inflammation, since inflammation and oxidative stress are involved in chronic neurodegenerative disorders. Moreover, it has been evidenced that an overproduction of NO in the central nervous system (CNS) may play a key role in aging and that the glial cells (microglials cells and probably astrocytes) are able to form consistent amounts of NO through the induction of a nitric oxide synthase (iNOS) isoform so- called inducible or inflammatory.We observed a decreased NO production after incubation with both LDL and HDL and an increased peroxynitrite production. As it concerns NOS expression, densitometric analysis of bands indicated that iNOS protein levels were significantly higher in the cells incubated with both AD lipoproteins and offspring lipoproteins compared to cells incubated with control lipoproteins. These findings suggest the possibility to identify in NO pathway a precocious marker of AD.", annotationSubgraph:["Nitric oxide subgraph"], annotationConfidence:["Medium"], pmid:"16054114", citationType:"PubMed", citationRef:"16054114"}}, {start: {_id:4080}, end: {_id:148}, properties:{evidence:"It has been shown that apoE increased the production of nitric oxide (NO) from human monocyte-derived macrophages (MDM); this effect could represent an important link between tissue redox balance and inflammation, since inflammation and oxidative stress are involved in chronic neurodegenerative disorders. Moreover, it has been evidenced that an overproduction of NO in the central nervous system (CNS) may play a key role in aging and that the glial cells (microglials cells and probably astrocytes) are able to form consistent amounts of NO through the induction of a nitric oxide synthase (iNOS) isoform so- called inducible or inflammatory.We observed a decreased NO production after incubation with both LDL and HDL and an increased peroxynitrite production. As it concerns NOS expression, densitometric analysis of bands indicated that iNOS protein levels were significantly higher in the cells incubated with both AD lipoproteins and offspring lipoproteins compared to cells incubated with control lipoproteins. These findings suggest the possibility to identify in NO pathway a precocious marker of AD.", annotationSubgraph:["Nitric oxide subgraph"], annotationConfidence:["Medium"], pmid:"16054114", citationType:"PubMed", citationRef:"16054114"}}, {start: {_id:4081}, end: {_id:148}, properties:{evidence:"It has been shown that apoE increased the production of nitric oxide (NO) from human monocyte-derived macrophages (MDM); this effect could represent an important link between tissue redox balance and inflammation, since inflammation and oxidative stress are involved in chronic neurodegenerative disorders. Moreover, it has been evidenced that an overproduction of NO in the central nervous system (CNS) may play a key role in aging and that the glial cells (microglials cells and probably astrocytes) are able to form consistent amounts of NO through the induction of a nitric oxide synthase (iNOS) isoform so- called inducible or inflammatory.We observed a decreased NO production after incubation with both LDL and HDL and an increased peroxynitrite production. As it concerns NOS expression, densitometric analysis of bands indicated that iNOS protein levels were significantly higher in the cells incubated with both AD lipoproteins and offspring lipoproteins compared to cells incubated with control lipoproteins. These findings suggest the possibility to identify in NO pathway a precocious marker of AD.", annotationSubgraph:["Nitric oxide subgraph"], annotationConfidence:["Medium"], pmid:"16054114", citationType:"PubMed", citationRef:"16054114"}}] AS row
