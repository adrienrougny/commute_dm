UNWIND [{start: {_id:118}, end: {_id:2499}, properties:{evidence:"Quantitative measures of ERK2 mRNA reveal that NFT-bearing neurons contain approximately 15% less ERK2 mRNA than nearest neighbors that do not contain NFT. NFT-bearing neurons contain approximately 25% less polyA mRNA, suggesting a relative preservation of ERK2 mRNA even in metabolically compromised cells.", annotationSubgraph:["Tau protein subgraph", "MAPK-ERK subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["Very High"], pmid:"8129042", citationType:"PubMed", citationRef:"8129042"}}, {start: {_id:4625}, end: {_id:4627}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"Ncstn was downregulated in aged 3xTg-AD brains with a condensation of chromatin and Sirt1 mRNA levels were decreased in these animals despite alterations in histone H3 acetylation", annotationSpecies:["10090"], annotationCell:["blood cell"], annotationUserdefinedcellline:["App transgenic"], pmid:"22728099", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22728099"}}, {start: {_id:4625}, end: {_id:4632}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"Ncstn was downregulated in aged 3xTg-AD brains with a condensation of chromatin and Sirt1 mRNA levels were decreased in these animals despite alterations in histone H3 acetylation", annotationSpecies:["10090"], annotationCell:["blood cell"], annotationUserdefinedcellline:["App transgenic"], pmid:"22728099", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22728099"}}] AS row
