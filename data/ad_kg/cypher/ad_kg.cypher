UNWIND [{start: {_id:3905}, end: {_id:6}, properties:{evidence:"we found that the Nogo-66 receptor (NgR) interacts physically with both Abeta and the amyloid precursor protein (APP). The inverse correlation of Abeta levels with NgR levels within the brain may reflect regulation of Abeta production and/or Abeta clearance.", annotationSubgraph:["Autophagy signaling subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"17182778", citationType:"PubMed", citationRef:"17182778"}}, {start: {_id:3910}, end: {_id:6}, properties:{evidence:"Using screening approaches in primary neurons, we identified brain- derived neurotrophic factor (BDNF) as a major inducer of Sorla that activates receptor gene transcription through the ERK (extracellular regulated kinase) pathway.These findings demonstrate that the beneficial effects ascribed to BDNF in APP metabolism act through induction of Sorla that encodes a negative regulator of neuronal APP processing", annotationSubgraph:["Non-amyloidogenic subgraph", "MAPK-ERK subgraph"], annotationConfidence:["Medium"], pmid:"20007471", citationType:"PubMed", citationRef:"20007471"}}, {start: {_id:2837}, end: {_id:6}, properties:{evidence:"Using screening approaches in primary neurons, we identified brain- derived neurotrophic factor (BDNF) as a major inducer of Sorla that activates receptor gene transcription through the ERK (extracellular regulated kinase) pathway.These findings demonstrate that the beneficial effects ascribed to BDNF in APP metabolism act through induction of Sorla that encodes a negative regulator of neuronal APP processing", annotationSubgraph:["Non-amyloidogenic subgraph", "MAPK-ERK subgraph"], annotationConfidence:["Medium"], pmid:"20007471", citationType:"PubMed", citationRef:"20007471"}}, {start: {_id:856}, end: {_id:6}, properties:{evidence:"Rosiglitazone is a TZD derivative that was recently observed to improve cognition in both APP transgenic mice and AD patients [Watson et al., 2005; Pedersen et al., 2006]. It activates PPARgamma leading to increased glucose disposal rates [Jung et al., 2005] and is also neuroprotective against Abeta neurotoxicity [Inestrosa et al., 2005]. Neuroprotection may result through modulation of Wnt signaling since an increase in beta-catenin and inhibition of GSK-3beta is observed upon exposure to rosiglitazone [Inestrosa et al., 2005], although a different study has shown that activation of PPARgamma by a potent ligand leads to beta-catenin degradation [Liu and Farmer 2004]. Nonetheless, in support of the role for PPARgamma activation in neuroprotection, PPARgamma agonists have potent anti-inflammatory effects [Luna-Medina et al., 2005], inhibit microglial activation [Bernardo et al., 2005; Heneka et al., 2005] and have been shown to improve verbal memory in AD patients with T2DM, possibly in a mechanism dependent on PPARgamma activation . A recent report demonstrates that overexpression of PPARgamma in cultured cells leads to a dramatic decrease in the production of Abeta, by increasing the rate of APP degradation via ubiquitination [D'Abramo et al., 2005]. This study also showed that by decreasing Abeta secretion, PPARgamma protects the cells against H2O2-mediated necrosis [D'Abramo et al., 2005].", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Non-amyloidogenic subgraph"], annotationUserdefinedcellline:["App transgenic"], annotationConfidence:["High"], annotationDisease:["Alzheimer's disease"], pmid:"19885299", citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:4476}, end: {_id:4477}, properties:{evidence:"two common MTHFR polymorphisms, namely 677C>T (Ala222Val) and 1298A>C (Glu429Ala), are known to reduce MTHFR activity.", annotationSubgraph:["Epigenetic modification subgraph"], pmid:"21119889", citationType:"PubMed", citationRef:"21119889"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:2301}, end: {_id:1183}, properties:{evidence:"These results collectively suggest that CopA3-mediated protein degradation of p27Kip1 may be the main mechanism through which CopA3 exerts neuroprotective and neurotropic effects.", annotationSubgraph:["Apoptosis signaling subgraph", "Cyclin-CDK subgraph", "Neuroprotection subgraph"], annotationConfidence:["High"], pmid:"23791873", citationType:"PubMed", citationRef:"23791873"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:954}, end: {_id:506}, properties:{evidence:"The amyloid hypothesis of AD suggests that -amyloid accumulation is the critical event in development of disease (I 49, I 50]. Lots of research has been done on the formation and accumulation of Al3, however, in the last years the mechanism' of amyloid clearance came into focus. For Al3 clearance several mechanisms are known (Fig. 2): i) EnzyÂ­ matic degradation by activated microglia or by insulin deÂ­ grading enzyme (IDE), neprilysin, endothelin converting enzyme (ECE), and angiotensin converting enzyme (ACE); ii) Receptor-mediated transport across the blood brain barrier (BBB) by binding to the low- density lipoprotein receptorÂ­ related protein (LRP) either directly or after binding to apolÂ­ ipoprotein E (ApoE) and/or a2-macroglobulin (a2M) to be delivered to peripheral sites of degradation, e.g., liver and kidney. (Review in [151 ]). Concerning insulin resistance it has been shown that IDE expression is stimulated by the IR/lGF-1 R cascade (152].", annotationSubgraph:["Low density lipoprotein subgraph", "Amyloidogenic subgraph", "Alpha 2 macroglobulin subgraph"], annotationConfidence:["Medium"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:76}, end: {_id:95}, properties:{evidence:"The extracellular amyloid deposits in senile plaques also trigger reactive glial changes and neuroinflammation that can also contribute to neuronal loss through production of reactive oxygen species (ROS), NO, and proinflammatory cytokines such as TNF-a and IL-1Abeta.", annotationSubgraph:["Reactive oxygen species subgraph", "Amyloidogenic subgraph", "Nitric oxide subgraph"], annotationConfidence:["Very High"], pmid:"15232608", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15232608"}}, {start: {_id:93}, end: {_id:95}, properties:{evidence:"The extracellular amyloid deposits in senile plaques also trigger reactive glial changes and neuroinflammation that can also contribute to neuronal loss through production of reactive oxygen species (ROS), NO, and proinflammatory cytokines such as TNF-a and IL-1Abeta.", annotationSubgraph:["Reactive oxygen species subgraph", "Amyloidogenic subgraph", "Nitric oxide subgraph"], annotationConfidence:["Very High"], pmid:"15232608", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15232608"}}, {start: {_id:43}, end: {_id:230}, properties:{evidence:"Mechanistically, glutamate-induced cholesterol loss requires high levels of intracellular Ca(2+), a functional stromal interaction molecule 2 (STIM2) and mobilization of CYP46A1 towards the plasma membrane. This study underscores the key role of excitatory neurotransmission in the control of membrane lipid composition, and consequently in neuronal membrane organization and function.", annotationSubgraph:["Calcium-dependent signal transduction", "Cholesterol metabolism subgraph", "Glutamatergic subgraph"], pmid:"22343944", citationType:"PubMed", citationRef:"22343944"}}, {start: {_id:3}, end: {_id:98}, properties:{annotationCellstructure:["Mitochondria"], evidence:"APP and amyloid-beta may block mitochondrial translocation of nuclear- encoded proteins, such as components of the electron transport chain, impairing mitochondrial function. Intramitochondrial amyloid-beta is able to perturb mitochondrial function in several ways by directly influencing extracellular transport chain complex activities, impairing mitochondrial dynamics, or disturbing calcium storage, thus increasing apoptotic pathways. Moreover, amyloid-beta interacts with mitochondrial matrix components inducing an improper mitochondrial complex function leads to a decreased mitochondrial membrane potential of the organelle and impairing ATP formation.", annotationSubgraph:["Apoptosis signaling subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"22523685", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22523685"}}, {start: {_id:93}, end: {_id:319}, properties:{evidence:"Increased ROS levels act at multiple levels to impair mitochondrial function: they induce mtDNA mutations that consequently negatively influence mitochondrial function, enhance amyloid-beta production by guiding APP cleavage pathway toward the amyloidogenesis, increase lipid peroxidation, activate mitophagy, leading to a reduced mitochondrial number, and augment tau hyperphosphorylation and NFT formation impairing organelle trafficking and neuronal function finally leading to apoptotic process.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["High"], pmid:"22523685", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22523685"}}, {start: {_id:93}, end: {_id:320}, properties:{evidence:"Increased ROS levels act at multiple levels to impair mitochondrial function: they induce mtDNA mutations that consequently negatively influence mitochondrial function, enhance amyloid-beta production by guiding APP cleavage pathway toward the amyloidogenesis, increase lipid peroxidation, activate mitophagy, leading to a reduced mitochondrial number, and augment tau hyperphosphorylation and NFT formation impairing organelle trafficking and neuronal function finally leading to apoptotic process.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["High"], pmid:"22523685", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22523685"}}, {start: {_id:93}, end: {_id:95}, properties:{evidence:"Increased ROS levels act at multiple levels to impair mitochondrial function: they induce mtDNA mutations that consequently negatively influence mitochondrial function, enhance amyloid-beta production by guiding APP cleavage pathway toward the amyloidogenesis, increase lipid peroxidation, activate mitophagy, leading to a reduced mitochondrial number, and augment tau hyperphosphorylation and NFT formation impairing organelle trafficking and neuronal function finally leading to apoptotic process.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["High"], pmid:"22523685", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22523685"}}, {start: {_id:93}, end: {_id:319}, properties:{annotationCellstructure:["Centrosome"], evidence:"Iron deposition in the brain is another important proposed mechanisms in the pathophysiology AD. Excessive iron can contribute to the formation of free radicals, leading to lipid peroxidation and neurotoxicity, which can result in cell membrane damage and cell death. Recently, it has been shown that iron concentration in AD patients brain was significantly higher than those of nondemented controls. In particular iron deposition in parietal cortex and hippocampus at the early stage of AD were positively correlated with the severity of patients cognitive impairment", annotationSubgraph:["Lipid peroxidation subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"22496686", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:3}, end: {_id:95}, properties:{evidence:"Abeta-Amyloid (Abeta) plaques in Alzheimer (AD) brains are surrounded by severe dendritic and axonal changes, including local spine loss, axonal swellings and distorted neurite trajectories. Whether and how plaques induce these neuropil abnormalities remains unknown. We tested the hypothesis that oligomeric assemblies of Abeta, seen in the periphery of plaques, mediate the neurodegenerative phenotype of AD by triggering activation of the enzyme GSK-3beta, which in turn appears to inhibit a transcriptional program mediated by CREB. We detect increased activity of GSK-3beta after exposure to oligomeric Abeta in neurons in culture, in the brain of double transgenic APP/tau mice and in AD brains. Activation of GSK-3beta, even in the absence of Abeta, is sufficient to produce a phenocopy of Abeta-induced dendritic spine loss in neurons in culture, while pharmacological inhibition of GSK-3beta prevents spine loss and increases expression of CREB-target genes like BDNF. Of note, in transgenic mice GSK-3beta inhibition ameliorated plaque-related neuritic changes and increased CREB- mediated gene expression. Moreover, GSK-3beta inhibition robustly decreased the oligomeric Abeta load in the mouse brain. All these findings support the idea that GSK3beta is aberrantly activated by the presence of Abeta, and contributes, at least in part, to the neuronal anatomical derangement associated with Abeta plaques in AD brains and to Abeta pathology itself.", annotationSubgraph:["Amyloidogenic subgraph", "GSK3 subgraph"], annotationConfidence:["Medium"], pmid:"21945540", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21945540"}}, {start: {_id:64}, end: {_id:95}, properties:{evidence:"Hydrogen peroxide was reported to initiate the apoptotic cascade by perturbing the intracellular redox balance. GSH is the most abundant low molecular weight thiol that maintains cellular redox homeostasis", annotationSubgraph:["Hydrogen peroxide subgraph"], annotationConfidence:["Medium"], pmid:"17213958", citationType:"PubMed", citationRef:"17213958"}}, {start: {_id:759}, end: {_id:755}, properties:{evidence:"It is believed that amyloid-beta peptide (Abeta) plays a central role in the pathogenesis of Alzheimer's disease (AD). Thus, the process of amyloid precursor protein (APP) cleavage is a key event and has raised much attention in the field of AD research. It is proposed that APP, beta- and gamma-secretases are all located on the lipid raft, and the meeting of them is an indispensable step for Abeta generation. Endocytosis can lead to clustering of APP, beta- and gamma-secretases from separate smaller lipid rafts into a larger one. On the other hand, for myristoylated alanine-rich C kinase substrate (MARCKS), phosphorylation by protein kinase C (PKC) or interaction with Ca(2+) can lead to its release from membrane into cytoplasm. This process induces the release of actins and phosphatidylinositol 4, 5-bisphosphate (PIP2), which are important factors for endocytosis. Thus, the present review proposes that MARCKS may be implicated in Abeta generation, by modulating free PIP2 level and actin movement, causing endocytosis", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], annotationConfidence:["Medium"], pmid:"20651816", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"20651816"}}, {start: {_id:64}, end: {_id:787}, properties:{annotationCellstructure:["Cell Membrane"], evidence:"Abeta can also interact with Fe2+ and Cu+ to generate hydrogen peroxide and hydroxyl radical (OH.) resulting in membrane lipid peroxidation which generates toxic aldehydes that impair the function of membrane ion-motive ATPases (Na+ and Ca2+ pumps)", annotationSubgraph:["Hydrogen peroxide subgraph"], annotationConfidence:["High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}, {start: {_id:802}, end: {_id:70}, properties:{evidence:"Cadmium (Cd), a toxic environmental contaminant, induces oxidative stress, leading to neurodegenerative disorders.", annotationSubgraph:["Response to oxidative stress"], annotationConfidence:["Very High"], pmid:"21544200", citationType:"PubMed", citationRef:"21544200"}}, {start: {_id:802}, end: {_id:95}, properties:{evidence:"Recently we have demonstrated that Cd induces neuronal apoptosis in part by activation of the mitogen-activated protein kineses (MAPK) and mammalian target of rapamycin (mTOR) pathways.", annotationSubgraph:["CREB subgraph"], annotationConfidence:["Very High"], pmid:"21544200", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21544200"}}, {start: {_id:802}, end: {_id:658}, properties:{evidence:"Recently we have demonstrated that Cd induces neuronal apoptosis in part by activation of the mitogen-activated protein kineses (MAPK) and mammalian target of rapamycin (mTOR) pathways.", annotationSubgraph:["mTOR signaling subgraph"], annotationConfidence:["Very High"], pmid:"21544200", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21544200"}}, {start: {_id:43}, end: {_id:658}, properties:{evidence:"Our findings indicate that Cd elevates [Ca+2](i), which induces ROS and activates MAPK and mTOR pathways, leading to neuronal apoptotic process.", annotationSubgraph:["mTOR signaling subgraph"], annotationConfidence:["Very High"], pmid:"21544200", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21544200"}}, {start: {_id:611}, end: {_id:818}, properties:{evidence:"Microglia produced only IL-12p40 and CXCL10, whereas astroglia produced these cytokines plus CCL2, CCL3, CCL5, CXCL1, G-CSF, IL-1beta, IL-6, IL-12p70, and IL-13.", annotationSubgraph:["Chemokine signaling subgraph"], pmid:"19710140", citationType:"PubMed", citationRef:"19710140"}}, {start: {_id:43}, end: {_id:460}, properties:{evidence:"Moreover, we demonstrate that neuronal activity upregulates CRP1 expression in hippocampal neurons via CaÂ²+ influx after depolarization. CaÂ²+/calmodulin-dependent protein kinase IV (CaMKIV) and cAMP response element binding protein mediate the CaÂ²+-induced upregulation of CRP1 expression. Furthermore, CRP1 is required for the dendritic growth induced by Ca+? influx or CaMKIV. Together, these data are the first to demonstrate a role for CRP1 in dendritic growth.", annotationSubgraph:["Calcium-dependent signal transduction", "CREB subgraph"], pmid:"22090504", citationType:"PubMed", citationRef:"22090504"}}, {start: {_id:90}, end: {_id:818}, properties:{evidence:"Inflammatory changes are a prominent feature of brains affected by Alzheimer's disease (AD) Activated glial cells release inflammatory cytokines which modulate the neurodegenerative process.These cytokines are encoded by genes representing several interleukins and TNFA, which are associated with AD. The gene coding for HLA-B associated transcript 1 (BAT1) lies adjacent to TNFA in the central major histocompatibility complex (MHC) BAT1, a member of the DEAD-box family of RNA helicases, appears to regulate the production of inflammatory cytokines associated with AD pathology.", annotationSubgraph:["Chemokine signaling subgraph"], annotationConfidence:["High"], pmid:"18715507", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18715507"}}, {start: {_id:3}, end: {_id:824}, properties:{evidence:"Neuritic plaques in the brain of Alzheimer's disease patients are characterized by beta-amyloid deposits associated with a glia-mediated inflammatory response.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Medium"], pmid:"15817521", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15817521"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:3}, end: {_id:964}, properties:{evidence:"Higher APP expression and elevated Abeta levels cause greater than required Cu export, leading to increased Cu in cerebrospinal fluid (CSF) and serum, and an intracellular (IC) Cu deficiency in the brain. Cu-deficient superoxide dismutase (SOD1) contributes to the reduced antioxidant capacity of the brain, allowing further oxidative stress.", annotationSubgraph:["Response to oxidative stress", "Amyloidogenic subgraph"], annotationMeshanatomy:["Cerebrospinal Fluid"], annotationConfidence:["Medium"], pmid:"15910549", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15910549"}}, {start: {_id:93}, end: {_id:95}, properties:{evidence:"Mitochondrial Abeta-binding alcohol dehydrogenase (ABAD): ABAD is a member of the short chain dehydrogenase reductase family in mitochondria that binds Abeta. Binding of Abeta to ABAD distorts the enzymebetas structure, rendering it inactive. In neurons, ABAD is predominately localized to mitochondria. Upon binding ABAD, Abeta triggers events leading to neuronal apoptosis through a mitochondrial pathway.Interestingly, mitochondrial ABAD is upregulated in neurons from AD patients. The ABAD-Abeta complex has been hypothesized to induce oxidant stress and mitochondrial dysfunction. Increased expression of ABAD exacerbates Abeta-mediated mitochondrial and neuronal stress. Abeta binding to ABAD causes free radical production and neuronal apoptotic process", annotationSubgraph:["Reactive oxygen species subgraph", "Apoptosis signaling subgraph"], annotationConfidence:["High"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:4}, end: {_id:982}, properties:{evidence:"Excessive ROS are locally generated in response to synaptic Abeta oligomer binding. This ROS formation can be totally blocked by the mitochondrial uncoupler, 2,4-dinitrophenol which suggests a central role of mitochondria in Abeta-induced oxidative stress.", annotationSubgraph:["Reactive oxygen species subgraph", "Response to oxidative stress"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:93}, end: {_id:98}, properties:{evidence:"The interaction of CypD with Abeta causes functional modification of this protein leading to MPTP opening. Abeta also binds with another mitochondrial protein, ABAD to distort the enzymebetas structure, rendering it inactive. This causes an increase in reactive oxygen species and oxidative stress leading to initiation of apoptotic process", annotationSubgraph:["Reactive oxygen species subgraph", "Response to oxidative stress"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:659}, end: {_id:270}, properties:{evidence:"Lysosomes are responsible for the degradation of macromolecules derived from the extracellular space through endocytosis or phagocytosis, as well as from the cytoplasm through autophagy.The main class of lysosomal proteases is represented by the cathepsin which is derived from the Greek term meaning â€˜to digestâ€™. Cathepsins are subdivided into three subgroups according to the amino acids of their active sites that confer catalytic activity: cysteine (cathepsins B, C, F, H, K, L, N, O, S, T, U, W, and X), aspartyl (cathepsins D and E), and serine cathepsins (cathepsins A and G).", annotationSubgraph:["Autophagy signaling subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"19499146", citationType:"PubMed", citationRef:"19499146"}}, {start: {_id:659}, end: {_id:755}, properties:{evidence:"Lysosomes are responsible for the degradation of macromolecules derived from the extracellular space through endocytosis or phagocytosis, as well as from the cytoplasm through autophagy.The main class of lysosomal proteases is represented by the cathepsin which is derived from the Greek term meaning â€˜to digestâ€™. Cathepsins are subdivided into three subgroups according to the amino acids of their active sites that confer catalytic activity: cysteine (cathepsins B, C, F, H, K, L, N, O, S, T, U, W, and X), aspartyl (cathepsins D and E), and serine cathepsins (cathepsins A and G).", annotationSubgraph:["Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"19499146", citationType:"PubMed", citationRef:"19499146"}}, {start: {_id:1180}, end: {_id:193}, properties:{evidence:"Rosiglitazone is a TZD derivative that was recently observed to improve cognition in both APP transgenic mice and AD patients [Watson et al., 2005; Pedersen et al., 2006]. It activates PPARgamma leading to increased glucose disposal rates [Jung et al., 2005] and is also neuroprotective against Abeta neurotoxicity [Inestrosa et al., 2005]. Neuroprotection may result through modulation of Wnt signaling since an increase in beta-catenin and inhibition of GSK-3beta is observed upon exposure to rosiglitazone [Inestrosa et al., 2005], although a different study has shown that activation of PPARgamma by a potent ligand leads to beta-catenin degradation [Liu and Farmer 2004]. Nonetheless, in support of the role for PPARgamma activation in neuroprotection, PPARgamma agonists have potent anti-inflammatory effects [Luna-Medina et al., 2005], inhibit microglial activation [Bernardo et al., 2005; Heneka et al., 2005] and have been shown to improve verbal memory in AD patients with T2DM, possibly in a mechanism dependent on PPARgamma activation . A recent report demonstrates that overexpression of PPARgamma in cultured cells leads to a dramatic decrease in the production of Abeta, by increasing the rate of APP degradation via ubiquitination [D'Abramo et al., 2005]. This study also showed that by decreasing Abeta secretion, PPARgamma protects the cells against H2O2-mediated necrosis [D'Abramo et al., 2005].", annotationSubgraph:["Lipid metabolism subgraph"], annotationUserdefinedcellline:["App transgenic"], annotationConfidence:["High"], annotationDisease:["Alzheimer's disease"], pmid:"19885299", citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:1185}, end: {_id:142}, properties:{evidence:"Rosiglitazone is a TZD derivative that was recently observed to improve cognition in both APP transgenic mice and AD patients [Watson et al., 2005; Pedersen et al., 2006]. It activates PPARgamma leading to increased glucose disposal rates [Jung et al., 2005] and is also neuroprotective against Abeta neurotoxicity [Inestrosa et al., 2005]. Neuroprotection may result through modulation of Wnt signaling since an increase in beta-catenin and inhibition of GSK-3beta is observed upon exposure to rosiglitazone [Inestrosa et al., 2005], although a different study has shown that activation of PPARgamma by a potent ligand leads to beta-catenin degradation [Liu and Farmer 2004]. Nonetheless, in support of the role for PPARgamma activation in neuroprotection, PPARgamma agonists have potent anti-inflammatory effects [Luna-Medina et al., 2005], inhibit microglial activation [Bernardo et al., 2005; Heneka et al., 2005] and have been shown to improve verbal memory in AD patients with T2DM, possibly in a mechanism dependent on PPARgamma activation . A recent report demonstrates that overexpression of PPARgamma in cultured cells leads to a dramatic decrease in the production of Abeta, by increasing the rate of APP degradation via ubiquitination [D'Abramo et al., 2005]. This study also showed that by decreasing Abeta secretion, PPARgamma protects the cells against H2O2-mediated necrosis [D'Abramo et al., 2005].", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationMeshdisease:["Diabetes Mellitus, Type 2", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"19885299", citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:1189}, end: {_id:1196}, properties:{evidence:"Metformin (GlucophageR, 1, 2-dimethylbiguanide hydrochloride; â‰ˆ36 million U.S. prescriptions in 2003) (30), is a biguanide that has pleiotropic effects on metabolism, including insulin-sensitization, increased glucose uptake, decreased hepatic glucose synthesis, activation of AMP activated protein kinase (AMPK, an enzyme involved in glucose and fatty acid metabolism), and mitochondria inhibition (31, 32).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"19237574", citationType:"PubMed", citationRef:"19237574"}}, {start: {_id:1189}, end: {_id:1182}, properties:{evidence:"Metformin (GlucophageR, 1, 2-dimethylbiguanide hydrochloride; â‰ˆ36 million U.S. prescriptions in 2003) (30), is a biguanide that has pleiotropic effects on metabolism, including insulin-sensitization, increased glucose uptake, decreased hepatic glucose synthesis, activation of AMP activated protein kinase (AMPK, an enzyme involved in glucose and fatty acid metabolism), and mitochondria inhibition (31, 32).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"19237574", citationType:"PubMed", citationRef:"19237574"}}, {start: {_id:3}, end: {_id:98}, properties:{evidence:"The role of miR-124 on the expression of beta-site APP cleaving enzyme 1 (BACE1), an important cleavager of amyloid precursor protein that plays a pivotal role in the beta-amyloid production, was studied in this paper using cellular models for Alzheimer' disease (AD) of cultured PC12 cell lines and primary cultured hippocampal neurons. The aim of the present study was to uncover novel potential miR-124 targets and shed light on its function in the cellular AD model. MiR-124 expression was steadily altered when its mimic and inhibitor were transfected in vitro. The results showed the expression of BACE1, one of the potential functional downstream targets of miR-124, was well correlated with cell death induced by Abeta neurotoxicity, and its expression level could be up- and down-regulated by suppression or over expression of miR-124 level respectively. These findings suggest that miR-124 may work as a basilic regulating factor to alleviate cell death in the process of AD by targeting BACE1, play an essential role in the control of BACE1 gene expression, and might be considered as a novel therapeutic target in treating AD.", annotationSubgraph:["Beta secretase subgraph", "miRNA subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"22178568", citationType:"PubMed", citationRef:"22178568"}}, {start: {_id:1568}, end: {_id:1118}, properties:{evidence:"They facilitate insulin signalling via the GLP-1 receptor (GLP-1R).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Medium"], pmid:"22443187", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"22443187"}}, {start: {_id:1243}, end: {_id:1118}, properties:{evidence:"They facilitate insulin signalling via the GLP-1 receptor (GLP-1R).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Medium"], pmid:"22443187", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"22443187"}}, {start: {_id:1582}, end: {_id:1594}, properties:{evidence:"Abeta1-42 and human amylin (hAmylin) increase cytosolic cAMP and Ca(2+), trigger multiple pathways involving the signal transduction mediators protein kinase A, MAPK, Akt, and cFos.", annotationSubgraph:["Amylin subgraph", "JAK-STAT signaling subgraph"], annotationConfidence:["High"], pmid:"22500019", citationType:"PubMed", citationRef:"22500019"}}, {start: {_id:1669}, end: {_id:848}, properties:{evidence:"We tested the effects of native GIP and the agonist N-AcGIP on synaptic plasticity [long-term potentiation (LTP)] in the hippocampus [15 nmol, administered intracerebroventricularly (icv)] and report for the first time that both peptides have enhancing effects on LTP. In contrast, the antagonist of GIP, Pro(3)GIP (15 nmol icv), reduced LTP. Injection of beta-amyloid(25-35) (100 nmol), a peptide that aggregates in brains of AD patients, also impaired LTP. The injection of N-AcGIP (15 nmol icv) 30 min prior to injection of amyloid(25-35) (100 nmol icv) fully reversed the impairment of LTP induced by beta-amyloid. The results demonstrate for the first time that GIP (particularly enzyme- resistant forms) not only directly modulates neurotransmitter release and LTP formation, but also protects synapses from the detrimental effects of beta-amyloid fragments on LTP formation.", annotationSpecies:["10116"], pmid:"18234983", citationType:"PubMed", citationRef:"18234983"}}, {start: {_id:1698}, end: {_id:1701}, properties:{evidence:"Ergoloid Mesylate may increase cerebral metabolism and blood flow. The role of this medication in the therapy of dementia is controversial. A recent controlled study in patients with Alzheimer's disease found that there was no advantage to the use of ergoloid mesylates compared to placebo, suggesting that ergoloid mesylates may lower scores on some cognitive and behavioral rating scales. Further study is needed to determine the risk-benefit profile of ergoloid mesylates in the treatment of dementia.", citationTitle:"AD_HBP", annotationSubgraph:["Serotonergic subgraph", "Dopaminergic subgraph"], annotationMeshanatomy:["Cerebrum"], citationType:"Online Resource", citationRef:"DB01049"}}, {start: {_id:1698}, end: {_id:1702}, properties:{evidence:"Ergoloid Mesylate may increase cerebral metabolism and blood flow. The role of this medication in the therapy of dementia is controversial. A recent controlled study in patients with Alzheimer's disease found that there was no advantage to the use of ergoloid mesylates compared to placebo, suggesting that ergoloid mesylates may lower scores on some cognitive and behavioral rating scales. Further study is needed to determine the risk-benefit profile of ergoloid mesylates in the treatment of dementia.", citationTitle:"AD_HBP", annotationSubgraph:["Serotonergic subgraph", "Dopaminergic subgraph"], annotationMeshanatomy:["Cerebrum"], citationType:"Online Resource", citationRef:"DB01049"}}, {start: {_id:1698}, end: {_id:1703}, properties:{evidence:"Ergoloid mesylates act centrally, decreasing vascular tone and slowing the heart rate, and acts peripherally to block alpha-receptors. One other possible mechanism is the effect of ergoloid mesylates on neuronal cell metabolism, resulting in improved oxygen uptake and cerebral metabolism, thereby normalizing depressed neurotransmitter levels.", citationTitle:"AD_HBP", annotationSubgraph:["Serotonergic subgraph", "Dopaminergic subgraph"], annotationMeshanatomy:["Cerebrum"], citationType:"Online Resource", citationRef:"DB01049"}}, {start: {_id:1698}, end: {_id:1704}, properties:{evidence:"Ergoloid mesylates act centrally, decreasing vascular tone and slowing the heart rate, and acts peripherally to block alpha-receptors. One other possible mechanism is the effect of ergoloid mesylates on neuronal cell metabolism, resulting in improved oxygen uptake and cerebral metabolism, thereby normalizing depressed neurotransmitter levels.", citationTitle:"AD_HBP", annotationSubgraph:["Serotonergic subgraph", "Dopaminergic subgraph"], annotationMeshanatomy:["Cerebrum"], citationType:"Online Resource", citationRef:"DB01049"}}, {start: {_id:1698}, end: {_id:1716}, properties:{evidence:"Ergoloid mesylates act centrally, decreasing vascular tone and slowing the heart rate, and acts peripherally to block alpha-receptors. One other possible mechanism is the effect of ergoloid mesylates on neuronal cell metabolism, resulting in improved oxygen uptake and cerebral metabolism, thereby normalizing depressed neurotransmitter levels.", citationTitle:"AD_HBP", annotationSubgraph:["Serotonergic subgraph", "Dopaminergic subgraph"], annotationMeshanatomy:["Cerebrum"], citationType:"Online Resource", citationRef:"DB01049"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:76}, end: {_id:1703}, properties:{evidence:"Our results show that freshly solubilized Abeta1Ã¢â‚¬ 40 enhances the vasoconstriction induced by endothelin-1 (ET-1) and increases resistance to relaxation triggered by nitric oxide (NO), suggesting that Abeta may oppose the NO/cGMP pathway. Using specific inhibitors and activators of the NO/cGMP pathway, we show that Abeta vasoactivity is not due to a modulation of nitric oxide synthase (NOS) or soluble guanylyl cyclase (sGC). However, we find that a selective cGMP phosphodiesterase (cGMP-PDE) inhibitor (dipyridamole) is able to interactively block the enhanced vasoconstriction as well as the opposition to relaxation induced by Abeta, suggesting that Abeta could effect the activity of this enzyme. Cyclic GMP levels, but not cAMP concentrations, are reduced after Abeta treatment of rat aortic rings, further substantiating this hypothesis.", annotationSubgraph:["Endothelin subgraph", "Blood vessel dilation subgraph"], annotationConfidence:["High"], pmid:"10222124", citationType:"PubMed", citationRef:"10222124"}}, {start: {_id:3}, end: {_id:1733}, properties:{evidence:"Moreover, in examination of this pathway in another cell type pertinent to AD, we find that Abeta induces a proinflammatory response in microglia as evidenced by increased leukotriene B4 release. We show that both dipyridamole and compounds which increase cGMP levels prevent Abeta-induced microglial inflammation. Our results suggest that therapeutic intervention aimed at reduction of microglial- mediated inflammation via inhibition of cGMP-PDE or elevation of cGMP may be beneficial in the treatment of AD.", annotationSubgraph:["Inflammatory response subgraph", "Blood vessel dilation subgraph"], annotationMeshanatomy:["Microglia"], annotationConfidence:["Medium"], pmid:"10222124", citationType:"PubMed", citationRef:"10222124"}}, {start: {_id:3}, end: {_id:91}, properties:{evidence:"Moreover, in examination of this pathway in another cell type pertinent to AD, we find that Abeta induces a proinflammatory response in microglia as evidenced by increased leukotriene B4 release. We show that both dipyridamole and compounds which increase cGMP levels prevent Abeta-induced microglial inflammation. Our results suggest that therapeutic intervention aimed at reduction of microglial- mediated inflammation via inhibition of cGMP-PDE or elevation of cGMP may be beneficial in the treatment of AD.", annotationSubgraph:["Inflammatory response subgraph", "Blood vessel dilation subgraph"], annotationMeshanatomy:["Microglia"], annotationConfidence:["Medium"], pmid:"10222124", citationType:"PubMed", citationRef:"10222124"}}, {start: {_id:1734}, end: {_id:1130}, properties:{evidence:"These pleiotropic effects of Cerebrolysin on Alzheimer's disease- related pathogenic events are consistent with a neurotrophic-like mode of action, and seems to involve the activation of the phosphatidylinositol 3-kinase/Akt/glycogen synthase kinase-3 beta intracellular signaling pathway.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "Nerve growth factor subgraph", "Akt subgraph"], annotationConfidence:["High"], pmid:"22013558", citationType:"PubMed", citationRef:"22013558"}}, {start: {_id:1734}, end: {_id:193}, properties:{evidence:"This study indicates that Cerebrolysin is a safe drug that improves the cognitive deficits and global function in patients with mild to moderate AD.", annotationSubgraph:["Nerve growth factor subgraph"], pmid:"11129744", citationType:"PubMed", citationRef:"11129744"}}, {start: {_id:1734}, end: {_id:1101}, properties:{evidence:"Cerebrolysin and E021 increased GluR1 density in most measured regions of the hippocampal formation in a highly significant way. These results correlate with the behavioural outcome, revealing an improvement in learning and memory of these rats after treatment with Cerebrolysin and E021.", annotationSubgraph:["Glutamatergic subgraph"], annotationSpecies:["10116"], pmid:"12197668", citationType:"PubMed", citationRef:"12197668"}}, {start: {_id:1734}, end: {_id:1014}, properties:{evidence:"Cerebrolysin is a peptide mixture with neurotrophic effects that might have the ability of both reducing amyloid burden and improving synaptic plasticity in Alzheimer's disease (AD).", annotationSubgraph:["Nerve growth factor subgraph", "Non-amyloidogenic subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"14628195", citationType:"PubMed", citationRef:"14628195"}}, {start: {_id:1760}, end: {_id:1702}, properties:{evidence:"Donepezil (10 mg/d) increased cerebral blood flow velocity and MMSE score in our AD patients, but more extensive trials are recommended.", annotationMeshanatomy:["Cerebrum"], pmid:"20831025", citationType:"PubMed", citationRef:"20831025"}}, {start: {_id:1760}, end: {_id:193}, properties:{evidence:"Donepezil 5 and 10 mg/day significantly improved cognition and global clinical function compared with placebo in well designed short term trials (14 to 30 weeks) in 161 to 818 patients with mild to moderate Alzheimer's disease.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationSpecies:["9606"], annotationConfidence:["High"], pmid:"18070217", citationType:"PubMed", citationRef:"18070217"}}, {start: {_id:1760}, end: {_id:142}, properties:{evidence:"The donepezil group demonstrated a greater likelihood of increases in both non-declarative and declarative processes.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationSpecies:["9606"], annotationConfidence:["High"], pmid:"17627484", citationType:"PubMed", citationRef:"17627484"}}, {start: {_id:1787}, end: {_id:193}, properties:{evidence:"Rivastigmine tartrate is a reversible cholinesterase inhibitor indicated for the symptomatic treatment of mild to moderate dementia. Rivastigmine has been shown to improve or maintain patients' performance in 3 major domains: cognitive function, global function (ADLs), and behavior.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["High"], pmid:"12860489", citationType:"PubMed", citationRef:"12860489"}}, {start: {_id:1787}, end: {_id:1788}, properties:{evidence:"Rivastigmine tartrate is a reversible cholinesterase inhibitor indicated for the symptomatic treatment of mild to moderate dementia. Rivastigmine has been shown to improve or maintain patients' performance in 3 major domains: cognitive function, global function (ADLs), and behavior.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["High"], pmid:"12860489", citationType:"PubMed", citationRef:"12860489"}}, {start: {_id:1795}, end: {_id:193}, properties:{evidence:"This study found that galantamine effected significant benefits on the cognitive, functional, and behavioral symptoms of mild to moderate AD in this population of Korean patients.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationSpecies:["9606"], annotationConfidence:["High"], pmid:"15598477", citationType:"PubMed", citationRef:"15598477"}}, {start: {_id:1795}, end: {_id:1788}, properties:{evidence:"This study found that galantamine effected significant benefits on the cognitive, functional, and behavioral symptoms of mild to moderate AD in this population of Korean patients.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationSpecies:["9606"], annotationConfidence:["High"], pmid:"15598477", citationType:"PubMed", citationRef:"15598477"}}, {start: {_id:1795}, end: {_id:1437}, properties:{evidence:"Galantamine increases the availability of ACh in the cholinergic synapse by competitively inhibiting AChE, the enzyme responsible for its breakdown. Galantamine also potentiates cholinergic neurotransmission by positively modulating the response of nAChRs to ACh.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["High"], pmid:"11230880", citationType:"PubMed", citationRef:"11230880"}}, {start: {_id:1797}, end: {_id:193}, properties:{evidence:"After the treatment, memantine-treated mice had restored cognition and significantly reduced the levels of insoluble amyloid-beta (Abeta), Abeta dodecamers (Abeta*56), prefibrillar soluble oligomers, and fibrillar oligomers. The effects on pathology were stronger in older, more impaired animals. Memantine treatment also was associated with a decline in the levels of total tau and hyperphosphorylated tau. Finally, memantine pre-incubation prevented Abeta-induced inhibition of long-term potentiation in hippocampal slices of cognitively normal mice.", annotationSubgraph:["NMDA receptor", "Glutamatergic subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"20042680", citationType:"PubMed", citationRef:"20042680"}}, {start: {_id:1797}, end: {_id:142}, properties:{evidence:"In this study, we found that memantine improved both hippocampus- and amygdala-dependent memory impairments in 3xTg-AD mice of three different ages and degrees of pathology.", annotationSubgraph:["NMDA receptor", "Glutamatergic subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"20042680", citationType:"PubMed", citationRef:"20042680"}}, {start: {_id:1803}, end: {_id:1788}, properties:{evidence:"Fluvoxamine was effective in controlling BPSD with AD. This finding shows that the pathophysiology of behavioral and psychological symptoms of dementia BPSD due to AD may occur because of a hyposerotonergic state in the brain.", annotationSubgraph:["NMDA receptor", "Glutamatergic subgraph"], annotationSpecies:["9606"], pmid:"17427765", citationType:"PubMed", citationRef:"17427765"}}, {start: {_id:1830}, end: {_id:1101}, properties:{evidence:"Administration of paroxetine, a SSRI, to 3x transgenic mice for 5 months reversed the memory impairment as assessed by the spatial version of the Morris water maze as well as decreased the AD-like neuropathology characteristic of these transgenic mice (Nelson et al., this issue).", annotationSubgraph:["Serotonergic subgraph"], annotationSpecies:["10090"], pmid:"17662278", citationType:"PubMed", citationRef:"17662278"}}, {start: {_id:1830}, end: {_id:193}, properties:{evidence:"Paroxetine treatment ameliorated the spatial navigation deficit in 3xTgAD male and female mice, without affecting swim speed or distance traveled, suggesting a preservation of cognitive function. Levels of amyloid beta-peptide (Abeta) and numbers of Abeta immunoreactive neurons were significantly reduced in the hippocampus of male and female paroxetine-treated 3xTgAD mice compared to saline-treated 3xTgAD mice.", annotationSubgraph:["Serotonergic subgraph", "Non-amyloidogenic subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"17368447", citationType:"PubMed", citationRef:"17368447"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1838}, end: {_id:106}, properties:{evidence:"Thus, we addressed this paradoxical condition of AD in rat neurons treated with okadaic acid (OA) which inhibits protein phosphatase-2A (PP2A) and induces tau hyperphosphorylation and cell death. Interestingly, OA also induces phosphorylation of GSK3beta at serine-9 and other substrates including tau, beta-catenin and CRMP2 like in AD brains. In this context, we observed that GSK3beta inhibitors such as lithium chloride and 6-bromoindirubin-3'-monoxime (6-BIO) reversed those phosphorylation events and protected neurons. These data suggest that GSK3beta may still have its kinase activity despite increase of its phosphorylation at serine-9 in AD brains at least in PP2A-compromised conditions and that GSK3beta inhibitors could be a valuable drug candidate in AD.", annotationSubgraph:["Tau protein subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"15314261", citationType:"PubMed", citationRef:"15314261"}}, {start: {_id:1097}, end: {_id:1183}, properties:{evidence:"Thus, we addressed this paradoxical condition of AD in rat neurons treated with okadaic acid (OA) which inhibits protein phosphatase-2A (PP2A) and induces tau hyperphosphorylation and cell death. Interestingly, OA also induces phosphorylation of GSK3beta at serine-9 and other substrates including tau, beta-catenin and CRMP2 like in AD brains. In this context, we observed that GSK3beta inhibitors such as lithium chloride and 6-bromoindirubin-3'-monoxime (6-BIO) reversed those phosphorylation events and protected neurons. These data suggest that GSK3beta may still have its kinase activity despite increase of its phosphorylation at serine-9 in AD brains at least in PP2A-compromised conditions and that GSK3beta inhibitors could be a valuable drug candidate in AD.", annotationSpecies:["10116"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"15314261", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15314261"}}, {start: {_id:1854}, end: {_id:1855}, properties:{evidence:"The action of arecoline on rat locus coeruleus neurons was studied by intracellular recording from the in vitro brain slice preparation. The arecoline-induced excitatory effects were antagonized by the muscarinic receptor antagonist, atropine, but not by the nicotinic receptor antagonist, hexamethonium. Methoctramine, a selective M2-muscarinic receptor antagonist, was also effective in reversing the arecoline-induced effects.", annotationSpecies:["10116"], annotationConfidence:["High"], pmid:"10857465", citationType:"PubMed", citationRef:"10857465"}}, {start: {_id:1854}, end: {_id:142}, properties:{evidence:"In an attempt to improve cognitive function in AD, arecoline (a muscarinic cholinergic receptor agonist) was given to patients with probable or possible AD in a two-phase design, and verbal memory function was examined. Results indicate that some patients demonstrate reliable improvements of verbal memory during arecoline treatment.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationSpecies:["9606"], annotationConfidence:["High"], pmid:"1775605", citationType:"PubMed", citationRef:"1775605"}}, {start: {_id:1854}, end: {_id:142}, properties:{evidence:"Treatment with the muscarinic agonist arecoline improves memory retention in patients with Alzheimer's disease (AD). In animal models, arecoline selectively increases local cerebral glucose utilization (LCGU).We examined (1) whether these focal increases in metabolism were coupled to local cerebral blood flow (LCBF) and (2) whether the effect of arecoline on LCGU and LCBF was dependent upon duration of drug administration. In general, LCBF correlated closely with LCGU following arecoline 2 mg/kg administration, but heterogeneous regions were present.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Cerebrum"], annotationConfidence:["High"], pmid:"8019853", citationType:"PubMed", citationRef:"8019853"}}, {start: {_id:1854}, end: {_id:636}, properties:{evidence:"Treatment with the muscarinic agonist arecoline improves memory retention in patients with Alzheimer's disease (AD). In animal models, arecoline selectively increases local cerebral glucose utilization (LCGU).We examined (1) whether these focal increases in metabolism were coupled to local cerebral blood flow (LCBF) and (2) whether the effect of arecoline on LCGU and LCBF was dependent upon duration of drug administration. In general, LCBF correlated closely with LCGU following arecoline 2 mg/kg administration, but heterogeneous regions were present.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Cerebrum"], annotationConfidence:["High"], pmid:"8019853", citationType:"PubMed", citationRef:"8019853"}}, {start: {_id:1854}, end: {_id:1702}, properties:{evidence:"Treatment with the muscarinic agonist arecoline improves memory retention in patients with Alzheimer's disease (AD). In animal models, arecoline selectively increases local cerebral glucose utilization (LCGU).We examined (1) whether these focal increases in metabolism were coupled to local cerebral blood flow (LCBF) and (2) whether the effect of arecoline on LCGU and LCBF was dependent upon duration of drug administration. In general, LCBF correlated closely with LCGU following arecoline 2 mg/kg administration, but heterogeneous regions were present.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Cerebrum"], annotationConfidence:["High"], pmid:"8019853", citationType:"PubMed", citationRef:"8019853"}}, {start: {_id:1854}, end: {_id:193}, properties:{evidence:"The mechanisms by which arecoline improves cognitive function are not known. We have demonstrated that arecoline can differentially influence cerebral blood flow and metabolism with both acute and chronic administration. Studies of cerebral glucose metabolism in patients with early or late onset of AD demonstrate glucose metabolic deficits in the temporal and parietal cortex. In advanced cases of AD, cerebral blood flow also can be reduced throughout the cortex.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationMeshanatomy:["Cerebrum"], annotationConfidence:["High"], pmid:"8019853", citationType:"PubMed", citationRef:"8019853"}}, {start: {_id:1861}, end: {_id:1877}, properties:{evidence:"Cumulative evidence from human and animal studies suggests that central activation of the HPA axis by cholinergic drugs can result in the elevation of plasma levels of several neuropeptides including adrenocorticotrophic hormone (ACTH), cortisol, b-endorphin, vasopressin, and epinephrine. Neuropeptides can modulate neurotransmission and can effect cognition. It has, therefore, been speculated that cognitive enhancement by cholinergic drugs could be mediated by the central activation of the HPA axis.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["Medium"], pmid:"8584603", citationType:"PubMed", citationRef:"8584603"}}, {start: {_id:1380}, end: {_id:1877}, properties:{evidence:"Cumulative evidence from human and animal studies suggests that central activation of the HPA axis by cholinergic drugs can result in the elevation of plasma levels of several neuropeptides including adrenocorticotrophic hormone (ACTH), cortisol, b-endorphin, vasopressin, and epinephrine. Neuropeptides can modulate neurotransmission and can effect cognition. It has, therefore, been speculated that cognitive enhancement by cholinergic drugs could be mediated by the central activation of the HPA axis.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["Medium"], pmid:"8584603", citationType:"PubMed", citationRef:"8584603"}}, {start: {_id:1864}, end: {_id:1877}, properties:{evidence:"Cumulative evidence from human and animal studies suggests that central activation of the HPA axis by cholinergic drugs can result in the elevation of plasma levels of several neuropeptides including adrenocorticotrophic hormone (ACTH), cortisol, b-endorphin, vasopressin, and epinephrine. Neuropeptides can modulate neurotransmission and can effect cognition. It has, therefore, been speculated that cognitive enhancement by cholinergic drugs could be mediated by the central activation of the HPA axis.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["Medium"], pmid:"8584603", citationType:"PubMed", citationRef:"8584603"}}, {start: {_id:1876}, end: {_id:1877}, properties:{evidence:"Cumulative evidence from human and animal studies suggests that central activation of the HPA axis by cholinergic drugs can result in the elevation of plasma levels of several neuropeptides including adrenocorticotrophic hormone (ACTH), cortisol, b-endorphin, vasopressin, and epinephrine. Neuropeptides can modulate neurotransmission and can effect cognition. It has, therefore, been speculated that cognitive enhancement by cholinergic drugs could be mediated by the central activation of the HPA axis.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["Medium"], pmid:"8584603", citationType:"PubMed", citationRef:"8584603"}}, {start: {_id:1861}, end: {_id:193}, properties:{evidence:"Cumulative evidence from human and animal studies suggests that central activation of the HPA axis by cholinergic drugs can result in the elevation of plasma levels of several neuropeptides including adrenocorticotrophic hormone (ACTH), cortisol, b-endorphin, vasopressin, and epinephrine. Neuropeptides can modulate neurotransmission and can effect cognition. It has, therefore, been speculated that cognitive enhancement by cholinergic drugs could be mediated by the central activation of the HPA axis.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["High"], pmid:"8584603", citationType:"PubMed", citationRef:"8584603"}}, {start: {_id:1380}, end: {_id:193}, properties:{evidence:"Cumulative evidence from human and animal studies suggests that central activation of the HPA axis by cholinergic drugs can result in the elevation of plasma levels of several neuropeptides including adrenocorticotrophic hormone (ACTH), cortisol, b-endorphin, vasopressin, and epinephrine. Neuropeptides can modulate neurotransmission and can effect cognition. It has, therefore, been speculated that cognitive enhancement by cholinergic drugs could be mediated by the central activation of the HPA axis.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["High"], pmid:"8584603", citationType:"PubMed", citationRef:"8584603"}}, {start: {_id:1864}, end: {_id:193}, properties:{evidence:"Cumulative evidence from human and animal studies suggests that central activation of the HPA axis by cholinergic drugs can result in the elevation of plasma levels of several neuropeptides including adrenocorticotrophic hormone (ACTH), cortisol, b-endorphin, vasopressin, and epinephrine. Neuropeptides can modulate neurotransmission and can effect cognition. It has, therefore, been speculated that cognitive enhancement by cholinergic drugs could be mediated by the central activation of the HPA axis.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["High"], pmid:"8584603", citationType:"PubMed", citationRef:"8584603"}}, {start: {_id:1876}, end: {_id:193}, properties:{evidence:"Cumulative evidence from human and animal studies suggests that central activation of the HPA axis by cholinergic drugs can result in the elevation of plasma levels of several neuropeptides including adrenocorticotrophic hormone (ACTH), cortisol, b-endorphin, vasopressin, and epinephrine. Neuropeptides can modulate neurotransmission and can effect cognition. It has, therefore, been speculated that cognitive enhancement by cholinergic drugs could be mediated by the central activation of the HPA axis.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationConfidence:["High"], pmid:"8584603", citationType:"PubMed", citationRef:"8584603"}}, {start: {_id:1761}, end: {_id:193}, properties:{evidence:"Currently available treatments for Alzheimer's disease (EC 3.1.1.7 (acetylcholinesterase) inhibitors and memantine) improve cognitive function, but do not slow the long-term progression of this disorder.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationDiseasestate:["Mild AD"], annotationConfidence:["High"], annotationFdastatus:["Phase 3"], pmid:"20170836", citationType:"PubMed", citationRef:"20170836"}}, {start: {_id:1797}, end: {_id:193}, properties:{evidence:"Currently available treatments for Alzheimer's disease (EC 3.1.1.7 (acetylcholinesterase) inhibitors and memantine) improve cognitive function, but do not slow the long-term progression of this disorder.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationDiseasestate:["Mild AD"], annotationConfidence:["High"], annotationFdastatus:["Phase 3"], pmid:"20170836", citationType:"PubMed", citationRef:"20170836"}}, {start: {_id:64}, end: {_id:95}, properties:{evidence:"The present investigation reports that clinically relevant concentrations of tarenflurbil (i.e., 1-5 microM) protect both cultured human neuroblastoma cell lines and primary neurons from cytotoxicity associated with exposure to Abeta_{42} or H_{2}O_{2}. In concert with this protection, there is an upregulation of neurotrophins [i.e., nerve growth factor (NGF) and brain-derived neurotrophic factor (BDNF)]. Furthermore, blocking exogenous NGF or BDNF by binding it to antibody prevents tarenflurbil from protecting human neuronal cells from Abeta_{42} and H_{2}O_{2} cytotoxicity. These findings suggest that up-regulation of neurotrophins might represent an underlying mechanism contributing to the beneficial effects seen with tarenflurbil in AD.", annotationSubgraph:["Inflammatory response subgraph", "Apoptosis signaling subgraph", "Hydrogen peroxide subgraph"], annotationConfidence:["High"], pmid:"18997293", citationType:"PubMed", citationRef:"18997293"}}, {start: {_id:1878}, end: {_id:1886}, properties:{evidence:"The present investigation reports that clinically relevant concentrations of tarenflurbil (i.e., 1-5 microM) protect both cultured human neuroblastoma cell lines and primary neurons from cytotoxicity associated with exposure to Abeta_{42} or H_{2}O_{2}. In concert with this protection, there is an upregulation of neurotrophins [i.e., nerve growth factor (NGF) and brain-derived neurotrophic factor (BDNF)]. Furthermore, blocking exogenous NGF or BDNF by binding it to antibody prevents tarenflurbil from protecting human neuronal cells from Abeta_{42} and H_{2}O_{2} cytotoxicity. These findings suggest that up-regulation of neurotrophins might represent an underlying mechanism contributing to the beneficial effects seen with tarenflurbil in AD.", annotationSubgraph:["Inflammatory response subgraph", "Nerve growth factor subgraph"], annotationConfidence:["High"], pmid:"18997293", citationType:"PubMed", citationRef:"18997293"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1898}, end: {_id:193}, properties:{evidence:"Nefiracetam is undergoing preclinical and clinical tests as a cognition-enhancing drug in Alzheimer's disease (AD).", annotationSubgraph:["Acetylcholine signaling subgraph", "GABA subgraph"], annotationConfidence:["High"], pmid:"9201800", citationType:"PubMed", citationRef:"9201800"}}, {start: {_id:1898}, end: {_id:193}, properties:{evidence:"The nootropic compound nefiracetam was evaluated in 88 older rabbits in a 750-ms delay paradigm of eyeblink classical conditioning (EBCC). Nefiracetam facilitated acquisition of EBCC in older rabbits. EBCC is performed poorly by older humans and is seriously impaired in Alzheimer's disease. These preclinical data in an animal model with clear parallels in humans suggest that nefiracetam may prove effective as a cognition enhancer in clinical trials.", annotationSubgraph:["GABA subgraph"], annotationConfidence:["High"], pmid:"7838908", citationType:"PubMed", citationRef:"7838908"}}, {start: {_id:1898}, end: {_id:193}, properties:{evidence:"In the brain of Alzheimer's disease patients, down-regulation of both cholinergic and glutamatergic systems have been found and is thought to play an important role in impairment of cognition, learning, and memory. Nefiracetam is a pyrrolidine-related nootropic drug exhibiting various pharmacological actions such as a cognitive-enhancing effect.", annotationSubgraph:["Glutamatergic subgraph"], annotationSpecies:["10116"], annotationConfidence:["High"], pmid:"21821968", citationType:"PubMed", citationRef:"21821968"}}, {start: {_id:1898}, end: {_id:848}, properties:{evidence:"Nefiracetam treatment significantly enhanced long-term potentiation (LTP) with the same bell-shaped dose-response curve. Furthermore, nefiracetam-induced LTP enhancement was closely associated with calcium/calmodulin-dependent protein kinase II (CaMKII) activation with increase in phosphorylation of AMPA-type glutamate receptor subunit 1 (GluA1) (Ser-831) as a postsynaptic CaMKII substrate.", annotationSubgraph:["GABA subgraph"], annotationSpecies:["10116"], annotationConfidence:["High"], pmid:"21821968", citationType:"PubMed", citationRef:"21821968"}}, {start: {_id:1898}, end: {_id:193}, properties:{evidence:"The results of the present study, thus, suggest that nefiracetam enhances activity of nicotinic ACh receptors by interacting with a PKC pathway, thereby increasing glutamate release from presynaptic terminals, and then leading to a sustained facilitation of hippocampal neurotransmission. This may represent a cellular mechanism underlying the cognition-enhancing action of nefiracetam. The results also provide the possibility that nefiracetam could be developed as a promising therapeutic drug for senile dementia or Alzheimer's disease.", annotationSubgraph:["NMDA receptor", "Acetylcholine signaling subgraph", "GABA subgraph"], annotationConfidence:["High"], pmid:"11039729", citationType:"PubMed", citationRef:"11039729"}}, {start: {_id:64}, end: {_id:95}, properties:{evidence:"Hydrogen peroxide (H2O2), one of the main reactive oxygen species, is converted into the highly toxic Â·OH radical in the presence of redox- active transition metals, which then oxidises nucleic acids, lipids and proteins, leading to neurodegeneration and cell death.", annotationSubgraph:["Hydrogen peroxide subgraph"], annotationMeshdisease:["Neurodegenerative Diseases"], annotationConfidence:["Medium"], pmid:"23653222", citationType:"PubMed", citationRef:"23653222"}}, {start: {_id:1960}, end: {_id:142}, properties:{evidence:"Furthermore, chronic treatment with pranlukast produced similar beneficial effects on memory behavior and hippocampal long-term potentiation to memantine or donepezil in intrahippocampal Abeta1-42-injected mice.", annotationSubgraph:["Caspase subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24269024", citationType:"PubMed", citationRef:"24269024"}}, {start: {_id:1960}, end: {_id:1100}, properties:{evidence:"Furthermore, chronic treatment with pranlukast produced similar beneficial effects on memory behavior and hippocampal long-term potentiation to memantine or donepezil in intrahippocampal Abeta1-42-injected mice.", annotationSubgraph:["Caspase subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24269024", citationType:"PubMed", citationRef:"24269024"}}, {start: {_id:1967}, end: {_id:142}, properties:{evidence:"Soybean isoflavone alleviates beta-amyloid 1-42 induced inflammatory response to improve learning and memory ability by down regulation of Toll-like receptor 4 expression and nuclear factor-ÎºB activity in rats.", annotationSubgraph:["Toll like receptor subgraph"], annotationConfidence:["High"], pmid:"21515354", citationType:"PubMed", citationRef:"21515354"}}, {start: {_id:1967}, end: {_id:1509}, properties:{evidence:"Soybean isoflavone alleviates beta-amyloid 1-42 induced inflammatory response to improve learning and memory ability by down regulation of Toll-like receptor 4 expression and nuclear factor-ÎºB activity in rats.", annotationSubgraph:["Toll like receptor subgraph"], annotationConfidence:["High"], pmid:"21515354", citationType:"PubMed", citationRef:"21515354"}}, {start: {_id:1979}, end: {_id:1183}, properties:{evidence:"alpha-Iso-cubebene exerts neuroprotective effects in amyloid beta stimulated microglia activation.", annotationMeshanatomy:["Microglia"], annotationConfidence:["Medium"], pmid:"24090820", citationType:"PubMed", citationRef:"24090820"}}, {start: {_id:1109}, end: {_id:106}, properties:{evidence:"In vitro studies revealed that (1) exposure of neural stem cells (NSCs) from the hippocampus to STZ strikingly increased intracellular reactive oxygen species (ROS) levels, induced cell death and perturbed cell proliferation and differentiation, (2) hydrogen peroxide induced similar cellular activities as STZ, (3) pre-incubation of STZ-treated NSCs with catalase, an antioxidant, suppressed all these cellular activities induced by STZ, and (4) likewise, pre-incubation of STZ- treated NSCs with salidroside, also an antioxidant, suppressed all these activities as catalase: reduction of ROS levels and NSC death with simultaneous increases in proliferation and differentiation.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationCell:["neuronal stem cell"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"22235318", citationType:"PubMed", citationRef:"22235318"}}, {start: {_id:64}, end: {_id:106}, properties:{evidence:"In vitro studies revealed that (1) exposure of neural stem cells (NSCs) from the hippocampus to STZ strikingly increased intracellular reactive oxygen species (ROS) levels, induced cell death and perturbed cell proliferation and differentiation, (2) hydrogen peroxide induced similar cellular activities as STZ, (3) pre-incubation of STZ-treated NSCs with catalase, an antioxidant, suppressed all these cellular activities induced by STZ, and (4) likewise, pre-incubation of STZ- treated NSCs with salidroside, also an antioxidant, suppressed all these activities as catalase: reduction of ROS levels and NSC death with simultaneous increases in proliferation and differentiation.", annotationSubgraph:["Hydrogen peroxide subgraph"], annotationCell:["neuronal stem cell"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"22235318", citationType:"PubMed", citationRef:"22235318"}}, {start: {_id:1981}, end: {_id:1503}, properties:{evidence:"Our findings indicated that the RCE improved the impaired hippocampal neurogenesis in the rat model of AD through protecting NSCs by its main ingredient salidroside which scavenged intracellular ROS.", annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], annotationCell:["neuronal stem cell"], annotationConfidence:["Medium"], annotationDisease:["Alzheimer's disease"], pmid:"22235318", citationType:"PubMed", citationRef:"22235318"}}, {start: {_id:1983}, end: {_id:1509}, properties:{evidence:"Isorhynchophylline improves learning and memory impairments induced by D-galactose in mice.", annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"24984171", citationType:"PubMed", citationRef:"24984171"}}, {start: {_id:1983}, end: {_id:142}, properties:{evidence:"Isorhynchophylline improves learning and memory impairments induced by D-galactose in mice.", annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"24984171", citationType:"PubMed", citationRef:"24984171"}}, {start: {_id:1983}, end: {_id:193}, properties:{evidence:"Isorhynchophylline (IRN), an alkaloid isolated from Uncaria rhynchophylla, has been reported to improve cognitive impairment induced by beta-amyloid in rats.", annotationSubgraph:["Amyloidogenic subgraph"], annotationSpecies:["10116"], annotationConfidence:["Medium"], pmid:"24984171", citationType:"PubMed", citationRef:"24984171"}}, {start: {_id:1983}, end: {_id:1985}, properties:{evidence:"In the mechanistic studies, IRN significantly increased the level of glutathione (GSH) and the activities of superoxide dismutase (SOD) and catalase (CAT), while decreased the level of malondialdehyde (MDA) in the brain tissues of the D-gal-treated mice.", annotationSubgraph:["Free radical formation subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"24984171", citationType:"PubMed", citationRef:"24984171"}}, {start: {_id:1333}, end: {_id:1183}, properties:{evidence:"In conclusion, the present study shows for the first time that MMP-2 and -9 give a main contribution to estrogen's neuroprotective effect.", annotationSubgraph:["Matrix metalloproteinase subgraph"], annotationConfidence:["High"], pmid:"22402435", citationType:"PubMed", citationRef:"22402435"}}, {start: {_id:2030}, end: {_id:142}, properties:{evidence:"GSNO treatment (50 Î¼g/kg/day for 2 months) significantly improved learning and memory performance of BCCAO rats and reduced the Abeta levels and ICAM-1/VCAM-1 expression in the brain.", annotationSubgraph:["Nitric oxide subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"23254638", citationType:"PubMed", citationRef:"23254638"}}] AS row
