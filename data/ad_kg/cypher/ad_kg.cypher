UNWIND [{start: {_id:1927}, end: {_id:1929}, properties:{evidence:"In addition, the expression of various NF-ÎºB target genes and of both NF-ÎºBp50 and NF-ÎºBp65 DNA-binding activity were increased in PBMC from AD patients in comparison with those from AA.", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], pmid:"21592054", annotationDisease:["dementia", "Alzheimer's disease"], citationType:"PubMed", citationRef:"21592054"}}, {start: {_id:1501}, end: {_id:1943}, properties:{evidence:"Human FECD endothelium exhibited increased levels of nuclear p21 protein.Our results identify endothelial Cdkn1a (p21) upregulation in a mouse model of early-onset FECD, confirm overexpression of p21 in late-onset human FECD endothelium, and suggest a role for premature senescence in FECD.", annotationSubgraph:["Cyclin-CDK subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Endothelium"], annotationConfidence:["High"], pmid:"22956607", citationType:"PubMed", citationRef:"22956607"}}, {start: {_id:1344}, end: {_id:2147}, properties:{evidence:"ABCB1 genotypes are presently not useful as a biomarker for dementia, as they were not significantly different between demented patients and age-matched control subjects.", annotationSubgraph:["ATP binding cassette transport subgraph"], annotationSpecies:["9606"], pmid:"16999857", annotationDisease:["dementia"], citationType:"PubMed", citationRef:"16999857"}}, {start: {_id:2164}, end: {_id:2165}, properties:{evidence:"The brain renin-angiotensin system (RAS) has been highlighted as having a pathological role in stroke, dementia, and neurodegenerative disease.", annotationSubgraph:["Renin-angiotensin subgraph"], annotationMeshdisease:["Neurodegenerative Diseases", "Dementia", "Stroke"], annotationMeshanatomy:["Brain"], pmid:"23304450", citationType:"PubMed", citationRef:"23304450"}}, {start: {_id:142}, end: {_id:2162}, properties:{evidence:"The functional involvements of the cerebral angiotensin IV in what concerns its possible participation in the normal neurochemical processes of memory and in the neurodegenerative processes of Alzheimer disease will be exposed, together with the vasodilating effects of angiotensin (1-7) as counteracting factor for the constricting effects of angiotensin II.", annotationSubgraph:["Renin-angiotensin subgraph"], annotationMeshanatomy:["Cerebrum"], pmid:"15529593", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15529593"}}, {start: {_id:106}, end: {_id:2178}, properties:{evidence:"In the chronic phase, concurrent activation of WOX1, CREB, and NF- kappaB occurs in small neurons just prior to apoptotic process.", annotationSubgraph:["Apoptosis signaling subgraph", "Nuclear factor Kappa beta subgraph"], annotationConfidence:["High"], pmid:"19918364", citationType:"PubMed", citationRef:"19918364"}}, {start: {_id:106}, end: {_id:2179}, properties:{evidence:"In the chronic phase, concurrent activation of WOX1, CREB, and NF- kappaB occurs in small neurons just prior to apoptotic process.", annotationSubgraph:["Apoptosis signaling subgraph", "Nuclear factor Kappa beta subgraph"], annotationConfidence:["High"], pmid:"19918364", citationType:"PubMed", citationRef:"19918364"}}, {start: {_id:106}, end: {_id:263}, properties:{evidence:"In the chronic phase, concurrent activation of WOX1, CREB, and NF- kappaB occurs in small neurons just prior to apoptotic process.", annotationSubgraph:["CREB subgraph"], annotationConfidence:["High"], pmid:"19918364", citationType:"PubMed", citationRef:"19918364"}}, {start: {_id:2330}, end: {_id:796}, properties:{evidence:"One selective inducer of ADAM10 gene expression is the X-box binding protein-1 (XBP-1).", annotationSubgraph:["ADAM Metallopeptidase subgraph", "Unfolded protein response subgraph"], pmid:"24165480", citationType:"PubMed", citationRef:"24165480"}}, {start: {_id:2330}, end: {_id:796}, properties:{evidence:"Our results demonstrate that XBP-1 is a driver of ADAM10 gene expression and that disturbance of this pathway might contribute to development or progression of AD.", annotationSubgraph:["ADAM Metallopeptidase subgraph", "Unfolded protein response subgraph"], pmid:"24165480", citationType:"PubMed", citationRef:"24165480"}}, {start: {_id:2362}, end: {_id:115}, properties:{evidence:"Here, we demonstrate that neuronal nitric oxide synthase (NOS1) interacts with Cdk5 and that the close proximity of the two proteins facilitates the formation of SNO-Cdk5.", annotationSubgraph:["Cyclin-CDK subgraph", "Nitric oxide subgraph"], annotationConfidence:["High"], pmid:"22874667", citationType:"PubMed", citationRef:"22874667"}}, {start: {_id:2845}, end: {_id:6}, properties:{evidence:"These results suggest that the breakdown of HRD1-mediated ERAD causes Abeta generation and ER stress, possibly linked to AD.", annotationSubgraph:["Unfolded protein response subgraph"], annotationConfidence:["High"], pmid:"20237263", citationType:"PubMed", citationRef:"20237263"}}, {start: {_id:3581}, end: {_id:3582}, properties:{evidence:"Both Abeta and presenilins seem to affect calcium homeostasis at very early stages of disease development affecting the synaptic transmission and function prior to neuritic plaque development. Altered calcium signaling differentially regulates genes such as calcineurin, calmodulin kinase II, MAP kinase etc and induces protein modifications and neurite degeneration. Since functional synapses and synaptic transmission are fundamental processes in memory formation, alterations in these processes can lead to neuronal dysfunction and memory deficit as seen in Alzheimer's disease.", annotationSubgraph:["Calcium-dependent signal transduction"], annotationConfidence:["High"], pmid:"22453989", citationType:"PubMed", citationRef:"22453989"}}, {start: {_id:3581}, end: {_id:486}, properties:{evidence:"Both Abeta and presenilins seem to affect calcium homeostasis at very early stages of disease development affecting the synaptic transmission and function prior to neuritic plaque development. Altered calcium signaling differentially regulates genes such as calcineurin, calmodulin kinase II, MAP kinase etc and induces protein modifications and neurite degeneration. Since functional synapses and synaptic transmission are fundamental processes in memory formation, alterations in these processes can lead to neuronal dysfunction and memory deficit as seen in Alzheimer's disease.", annotationSubgraph:["Calcium-dependent signal transduction"], annotationConfidence:["High"], pmid:"22453989", citationType:"PubMed", citationRef:"22453989"}}, {start: {_id:3581}, end: {_id:212}, properties:{evidence:"Both Abeta and presenilins seem to affect calcium homeostasis at very early stages of disease development affecting the synaptic transmission and function prior to neuritic plaque development. Altered calcium signaling differentially regulates genes such as calcineurin, calmodulin kinase II, MAP kinase etc and induces protein modifications and neurite degeneration. Since functional synapses and synaptic transmission are fundamental processes in memory formation, alterations in these processes can lead to neuronal dysfunction and memory deficit as seen in Alzheimer's disease.", annotationSubgraph:["Calcium-dependent signal transduction"], annotationConfidence:["High"], pmid:"22453989", citationType:"PubMed", citationRef:"22453989"}}, {start: {_id:3581}, end: {_id:214}, properties:{evidence:"Both Abeta and presenilins seem to affect calcium homeostasis at very early stages of disease development affecting the synaptic transmission and function prior to neuritic plaque development. Altered calcium signaling differentially regulates genes such as calcineurin, calmodulin kinase II, MAP kinase etc and induces protein modifications and neurite degeneration. Since functional synapses and synaptic transmission are fundamental processes in memory formation, alterations in these processes can lead to neuronal dysfunction and memory deficit as seen in