UNWIND [{start: {_id:123}, end: {_id:649}, properties:{evidence:"Treatment of PSer262 peptide or GSK 3 beta phosphorylated tau with alkaline phosphatase increased Ab262 immunoreactivity, indicating that Ab262 is a reagent useful for studying tau phosphorylation at the Ser262 residue.", annotationSubgraph:["Tau protein subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"8769876", citationType:"PubMed", citationRef:"8769876"}}, {start: {_id:123}, end: {_id:118}, properties:{evidence:"Colocalization of these epitopes suggests that tau protein kinase I/glycogen synthase kinase-3 beta abnormally phosphorylates tau and is in a position to disrupt neuronal metabolism in anatomical areas vulnerable to Alzheimer's disease.", annotationSubgraph:["Tau protein subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"8930358", citationType:"PubMed", citationRef:"8930358"}}, {start: {_id:117}, end: {_id:118}, properties:{evidence:"Phosphorylation of tau protein is regulated by several kinases, especially glycogen synthase kinase 3beta (GSK-3beta), cyclin- dependent protein kinase 5 (cdk5) and cAMP-dependent protein kinase (PKA).", annotationSubgraph:["Tau protein subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"17078951", citationType:"PubMed", citationRef:"17078951"}}, {start: {_id:117}, end: {_id:118}, properties:{evidence:"Two protein kinases, tau protein kinase I (TPK I or GSK 3beta) and tau protein kinase II (TPK II; cdk5/p20), have been isolated from bovine brain microtubules", annotationSubgraph:["Tau protein subgraph", "GSK3 subgraph"], annotationSpecies:["9913"], annotationConfidence:["High"], pmid:"11181841", citationType:"PubMed", citationRef:"11181841"}}, {start: {_id:123}, end: {_id:118}, properties:{evidence:"Two protein kinases, tau protein kinase I (TPK I or GSK 3beta) and tau protein kinase II (TPK II; cdk5/p20), have been isolated from bovine brain microtubules", annotationSubgraph:["Tau protein subgraph", "GSK3 subgraph"], annotationSpecies:["9913"], annotationConfidence:["High"], pmid:"11181841", citationType:"PubMed", citationRef:"11181841"}}, {start: {_id:123}, end: {_id:118}, properties:{evidence:"In situ, FRAT-2 significantly increased GSK3 beta-mediated phosphorylation of tau at a primed epitope while not significantly affecting the phosphorylation of unprimed sites.", annotationSubgraph:["Tau protein subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"15522877", citationType:"PubMed", citationRef:"15522877"}}, {start: {_id:123}, end: {_id:2936}, properties:{evidence:"The physiological relevance of the association between PS1 and beta- catenin remains controversial. In this study, we report the identification and functional characterization of a highly conserved glycogen synthase kinase-3beta consensus phosphorylation site within the hydrophilic loop domain of PS1. Site-directed mutagenesis, together with in vitro and in vivo phosphorylation assays, indicates that PS1 residues Ser(353) and Ser(357) are glycogen synthase kinase-3beta targets.", annotationSubgraph:["Gamma secretase subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"11104755", citationType:"PubMed", citationRef:"11104755"}}, {start: {_id:123}, end: {_id:2938}, properties:{evidence:"The physiological relevance of the association between PS1 and beta- catenin remains controversial. In this study, we report the identification and functional characterization of a highly conserved glycogen synthase kinase-3beta consensus phosphorylation site within the hydrophilic loop domain of PS1. Site-directed mutagenesis, together with in vitro and in vivo phosphorylation assays, indicates that PS1 residues Ser(353) and Ser(357) are glycogen synthase kinase-3beta targets.", annotationSubgraph:["Gamma secretase subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"11104755", citationType:"PubMed", citationRef:"11104755"}}, {start: {_id:123}, end: {_id:2940}, properties:{evidence:"Previously we described presenilin-1 (PS1) as a GSK-3beta substrate.", annotationSubgraph:["Gamma secretase subgraph", "GSK3 subgraph"], annotationConfidence:["Low"], pmid:"16814287", citationType:"PubMed", citationRef:"16814287"}}, {start: {_id:123}, end: {_id:2936}, properties:{evidence:"We demonstrate that phosphorylation of serines 353 and 357 by glycogen synthase kinase-3beta (GSK3beta) induces a structural change of the hydrophilic loop of PS1 that can also be mimicked by substitution of the phosphorylation sites by negatively charged amino acids in vitro and in cultured cells. The structural change of PS1 reduces the interaction with beta-catenin leading to decreased phosphorylation and ubiquitination of beta-catenin.", annotationSubgraph:["Gamma secretase subgraph", "Tau protein subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"17360711", citationType:"PubMed", citationRef:"17360711"}}, {start: {_id:123}, end: {_id:2938}, properties:{evidence:"We demonstrate that phosphorylation of serines 353 and 357 by glycogen synthase kinase-3beta (GSK3beta) induces a structural change of the hydrophilic loop of PS1 that can also be mimicked by substitution of the phosphorylation sites by negatively charged amino acids in vitro and in cultured cells. The structural change of PS1 reduces the interaction with beta-catenin leading to decreased phosphorylation and ubiquitination of beta-catenin.", annotationSubgraph:["Gamma secretase subgraph", "Tau protein subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"17360711", citationType:"PubMed", citationRef:"17360711"}}, {start: {_id:123}, end: {_id:2940}, properties:{evidence:"Glycogen synthase kinase 3beta-mediated phosphorylation of Presenilin 1 reduces its binding to N-cadherin, thereby down-regulating its cell- surface expression.", annotationSubgraph:["Gamma secretase subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"17389597", citationType:"PubMed", citationRef:"17389597"}}, {start: {_id:123}, end: {_id:2936}, properties:{evidence:"Site-directed mutagenesis, together with in vitro and in vivo phosphorylation assays, indicates that PS1 residues Ser(353) and Ser(357) are glycogen synthase kinase-3beta targets.", annotationSubgraph:["Gamma secretase subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"11104755", citationType:"PubMed", citationRef:"11104755"}}, {start: {_id:123}, end: {_id:2938}, properties:{evidence:"Site-directed mutagenesis, together with in vitro and in vivo phosphorylation assays, indicates that PS1 residues Ser(353) and Ser(357) are glycogen synthase kinase-3beta targets.", annotationSubgraph:["Gamma secretase subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"11104755", citationType:"PubMed", citationRef:"11104755"}}, {start: {_id:3233}, end: {_id:3275}, properties:{evidence:"First, we show that PS1 is phosphorylated by the Dyrk1A at Thr(354) and that this phosphorylation increases beta-secretase activity.", annotationSubgraph:["Gamma secretase subgraph", "DYRK1A subgraph"], pmid:"20456003", citationType:"PubMed", citationRef:"20456003"}}, {start: {_id:938}, end: {_id:3285}, properties:{evidence:"Furthermore, JNK has been shown to phosphorylate tau at Ser422(20), a site that is specifically phosphorylated in AD brains", annotationSubgraph:["MAPK-JNK subgraph"], annotationConfidence:["High"], pmid:"12191990", citationType:"PubMed", citationRef:"12191990"}}, {start: {_id:3288}, end: {_id:118}, properties:{evidence:"To further delineate this relationship, we investigated the role of p38, a stress activated protein kinase which phosphorylates tau protein at sites found in the NFT of AD", annotationSubgraph:["MAPK-JNK subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"11079778", citationType:"PubMed", citationRef:"11079778"}}, {start: {_id:3288}, end: {_id:118}, properties:{evidence:"Reactivating kinase/p38 phosphorylates tau protein in vitro.", annotationSubgraph:["MAPK-JNK subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"9202310", citationType:"PubMed", citationRef:"9202310"}}, {start: {_id:3291}, end: {_id:3293}, properties:{evidence:"Ser727 of STAT1 can be phosphorylated by diverse kinases, such as phosphatidylinositol 3-kinase/Akt, calcium/calpmodulin-dependent kinase II, protein kinase C, and MAPKs.", annotationSubgraph:["MAPK-JNK subgraph", "JAK-STAT signaling subgraph"], pmid:"17091494", citationType:"PubMed", citationRef:"17091494"}}, {start: {_id:2996}, end: {_id:3293}, properties:{evidence:"Ser727 of STAT1 can be phosphorylated by diverse kinases, such as phosphatidylinositol 3-kinase/Akt, calcium/calpmodulin-dependent kinase II, protein kinase C, and MAPKs.", annotationSubgraph:["MAPK-JNK subgraph", "JAK-STAT signaling subgraph"], pmid:"17091494", citationType:"PubMed", citationRef:"17091494"}}] AS row
