UNWIND [{start: {_id:2335}, end: {_id:3079}, properties:{evidence:"PERK, an ER-resident transmembrane protein kinase, is also a sensor for the unfolded protein response (UPR), causing phosphorylation of eukaryotic initiation factor 2alpha (eIF2alpha) to inhibit translation initiation.", annotationSubgraph:["Unfolded protein response subgraph", "Tumor necrosis factor subgraph"], pmid:"12163019", citationType:"PubMed", citationRef:"12163019"}}, {start: {_id:37}, end: {_id:122}, properties:{evidence:"Previously we described presenilin-1 (PS1) as a GSK-3beta substrate.", annotationSubgraph:["Gamma secretase subgraph", "GSK3 subgraph"], annotationConfidence:["Medium"], pmid:"16814287", citationType:"PubMed", citationRef:"16814287"}}, {start: {_id:3206}, end: {_id:1968}, properties:{evidence:"Up-regulation of MMP-9 expressed by SK-N-SH cells in the presence of Abeta(1-40) was mediated by alpha(3)beta(1) and alpha(2)beta(1) integrin receptors.", annotationSubgraph:["Matrix metalloproteinase subgraph"], annotationConfidence:["Medium"], pmid:"17761425", citationType:"PubMed", citationRef:"17761425"}}, {start: {_id:3207}, end: {_id:1968}, properties:{evidence:"Up-regulation of MMP-9 expressed by SK-N-SH cells in the presence of Abeta(1-40) was mediated by alpha(3)beta(1) and alpha(2)beta(1) integrin receptors.", annotationSubgraph:["Matrix metalloproteinase subgraph"], annotationConfidence:["Medium"], pmid:"17761425", citationType:"PubMed", citationRef:"17761425"}}, {start: {_id:1968}, end: {_id:798}, properties:{evidence:"Overexpression of MMP-9 or treatment of HEK/APP695 cells with activated recombinant MMP-9 resulted in enhanced secretion of soluble APP (sAPPalpha), a product of alpha-secretase cleavage, and reduction of Abeta release.", annotationSubgraph:["Amyloidogenic subgraph", "Matrix metalloproteinase subgraph"], annotationConfidence:["Medium"], pmid:"17761425", citationType:"PubMed", citationRef:"17761425"}}, {start: {_id:360}, end: {_id:2617}, properties:{evidence