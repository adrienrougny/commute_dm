UNWIND [{start: {_id:635}, end: {_id:639}, properties:{evidence:"AMPK activity decreases in AD brain, indicating decreased mitochondrial biogenesis and function. Emerging evidence demonstrates that AMPK activation is a potential target for improving perturbed brain energy metabolism that is involved in the pathogenesis of AD. The roles of AMPK in the pathogenesis of AD include Abeta-amyloid protein (Abeta) generation and tau phosphorylation. In particular, AMPK may regulate Abeta generation through modulating neuronal cholesterol and sphingomyelin levels and through regulating APP distribution in the lipid rafts. AMPK is activated by phosphorylation of Thr-172 by LKB1 complex in response to increase in the AMP/ATP ratio and by calmodulin-dependent protein kinase kinase-beta in response to elevated Ca(2+) levels, which contributes to regulating Abeta generation. AMPK is a physiological tau kinase and can increase the phosphorylation of tau at Ser-262. AMPK can also directly phosphorylate tau at Thr-231 and Ser-396/404. Furthermore, AMPK activation decreases mTOR signaling activity to facilitate autophagy and promotes lysosomal degradation of Abeta. However, AMPK activation has non-neuroprotective property and may lead to detrimental outcomes, including Abeta generation and tau phosphorylation. Therefore, it is still unclear whether AMPK could serve a potential therapeutic target for AD, and hence, further studies will be needed to clarify the role of AMPK in AD.", annotationSubgraph:["Cholesterol metabolism subgraph", "Sphingolipid metabolic subgraph", "Akt subgraph"], annotationConfidence:["Medium"], pmid:"22367557", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22367557"}}, {start: {_id:635}, end: {_id:181}, properties:{evidence:"AMPK activity decreases in AD brain, indicating decreased mitochondrial biogenesis and function. Emerging evidence demonstrates that AMPK activation is a potential target for improving perturbed brain energy metabolism that is involved in the pathogenesis of AD. The roles of AMPK in the pathogenesis of AD include Abeta-amyloid protein (Abeta) generation and tau phosphorylation. In particular, AMPK may regulate Abeta generation through modulating neuronal cholesterol and sphingomyelin levels and through regulating APP distribution in the lipid rafts. AMPK is activated by phosphorylation of Thr-172 by LKB1 complex in response to increase in the AMP/ATP ratio and by calmodulin-dependent protein kinase kinase-beta in response to elevated Ca(2+) levels, which contributes to regulating Abeta generation. AMPK is a physiological tau kinase and can increase the phosphorylation of tau at Ser-262. AMPK can also directly phosphorylate tau at Thr-231 and Ser-396/404. Furthermore, AMPK activation decreases mTOR signaling activity to facilitate autophagy and promotes lysosomal degradation of Abeta. However, AMPK activation has non-neuroprotective property and may lead to detrimental outcomes, including Abeta generation and tau phosphorylation. Therefore, it is still unclear whether AMPK could serve a potential therapeutic target for AD, and hence, further studies will be needed to clarify the role of AMPK in AD.", annotationSubgraph:["Cholesterol metabolism subgraph", "Sphingolipid metabolic subgraph", "Akt subgraph"], annotationConfidence:["Medium"], pmid:"22367557", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22367557"}}, {start: {_id:2086}, end: {_id:76}, properties:{evidence:"The endothelial nitric oxide synthase (NOS3) gene encodes endothelial NOS, an enzyme that regulates the production of the vasodilatory nitric oxide associated with the cerebral small vessel pathology observed in early AD.", annotationSubgraph:["Nitric oxide subgraph"], annotationMeshanatomy:["Cerebrum", "Endothelium"], annotationConfidence:["Medium"], pmid:"15016421", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15016421"}}, {start: {_id:1658}, end: {_id:3}, properties:{evidence:"Human serum albumin can regulate amyloid-beta peptide fiber growth in the brain interstitium: implications for Alzheimer disease.", annotationSubgraph:["Non-amyloidogenic subgraph", "Albumin subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"22718756", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22718756"}}, {start: {_id:4226}, end: {_id:76}, properties:{evidence:"Runx1t1 (Runt-related transcription factor 1; translocated to, 1) epigenetically regulates the proliferation and nitric oxide production of microglia.", annotationSubgraph:["Nitric oxide subgraph"], annotationMeshanatomy:["Microglia"], annotationConfidence:["Medium"], pmid:"24586690", citationType:"PubMed", citationRef:"24586690"}}, {start: {_id:4226}, end: {_id:90}, properties:{evidence:"Runx1t1 (Runt-related transcription factor 1; translocated to, 1) epigenetically regulates the proliferation and nitric oxide production of microglia.", annotationSubgraph:["Nitric oxide subgraph"], annotationMeshanatomy:["Microglia"], annotationConfidence:["Medium"], pmid:"24586690", citationType:"PubMed", citationRef:"24586690"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:REGULATES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1215}, end: {_id:1235}, properties:{evidence:"It is known that the expression of genes essential for the function of beta-cells, such as insulin, PDX-1 (pancreatic and duodenal homeobox-1), amylin, and glucose transporter 2, are closely regulated by extracellular concentrations of glucose. This circumstance suggests that the p35/CDK5 protein kinase pathway may play an important role in beta-cell function. In fact, our initial functional studies indicate that p35/CDK5 is involved in the expression of the insulin gene", annotationSubgraph:["Insulin signal transduction", "Amylin subgraph"], annotationConfidence:["Medium"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:1217}, end: {_id:1235}, properties:{evidence:"It is known that the expression of genes essential for the function of beta-cells, such as insulin, PDX-1 (pancreatic and duodenal homeobox-1), amylin, and glucose transporter 2, are closely regulated by extracellular concentrations of glucose. This circumstance suggests that the p35/CDK5 protein kinase pathway may play an important role in beta-cell function. In fact, our initial functional studies indicate that p35/CDK5 is involved in the expression of the insulin gene", annotationSubgraph:["Insulin signal transduction", "Amylin subgraph"], annotationConfidence:["Medium"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:1232}, end: {_id:1235}, properties:{evidence:"It is known that the expression of genes essential for the function of beta-cells, such as insulin, PDX-1 (pancreatic and duodenal homeobox-1), amylin, and glucose transporter 2, are closely regulated by extracellular concentrations of glucose. This circumstance suggests that the p35/CDK5 protein kinase pathway may play an important role in beta-cell function. In fact, our initial functional studies indicate that p35/CDK5 is involved in the expression of the insulin gene", annotationSubgraph:["Insulin signal transduction", "Amylin subgraph"], annotationConfidence:["Medium"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:1234}, end: {_id:1235}, properties:{evidence:"It is known that the expression of genes essential for the function of beta-cells, such as insulin, PDX-1 (pancreatic and duodenal homeobox-1), amylin, and glucose transporter 2, are closely regulated by extracellular concentrations of glucose. This circumstance suggests that the p35/CDK5 protein kinase pathway may play an important role in beta-cell function. In fact, our initial functional studies indicate that p35/CDK5 is involved in the expression of the insulin gene", annotationSubgraph:["Insulin signal transduction", "Amylin subgraph"], annotationConfidence:["Medium"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:1223}, end: {_id:1235}, properties:{evidence:"It is known that the expression of genes essential for the function of beta-cells, such as insulin, PDX-1 (pancreatic and duodenal homeobox-1), amylin, and glucose transporter 2, are closely regulated by extracellular concentrations of glucose. This circumstance suggests that the p35/CDK5 protein kinase pathway may play an important role in beta-cell function. In fact, our initial functional studies indicate that p35/CDK5 is involved in the expression of the insulin gene", annotationSubgraph:["Cyclin-CDK subgraph"], annotationConfidence:["High"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:213}, end: {_id:2187}, properties:{evidence:"We bring forward the hypothesis that inflammation via prolonged activation of key kinases (p38 and GSK-3beta) and activation of histone deacetylases gives rise to dysregulation of the NRF2 system in the brain, which contributes to oxidative stress and injury.", annotationSubgraph:["Inflammatory response subgraph", "Free radical formation subgraph"], annotationMeshdisease:["Inflammation", "Wounds and Injuries"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:123}, end: {_id:2187}, properties:{evidence:"We bring forward the hypothesis that inflammation via prolonged activation of key kinases (p38 and GSK-3beta) and activation of histone deacetylases gives rise to dysregulation of the NRF2 system in the brain, which contributes to oxidative stress and injury.", annotationSubgraph:["Inflammatory response subgraph", "GSK3 subgraph"], annotationMeshdisease:["Inflammation", "Wounds and Injuries"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:2457}, end: {_id:1964}, properties:{evidence:"We have previously reported that CysLT1R activation is involved in Abeta generation. In this study, we investigated rescuing effect of CysLT1R antagonist montelukast on Abeta1-42-induced neurotoxicity in primary neurons. Our data showed that Abeta1-42 elicited a marked increase of CysLT1R expression in primary mouse neurons. This increment of CysLT1R expression was accompanied by increases of inflammatory factors such as NF-ÎºB p65, tumor necrosis factor-Î± (TNFÎ±) and interleukin-1beta (IL-1beta) as well as pro-apoptotic protein Caspase-3 activation and anti-apoptotic process protein Bcl-2 reduction. This observation was confirmed with treatment of montelukast, a selective CysLT1R antagonist, which had significant effect on Abeta1-42-induced cytotoxicity. Moreover, blockade of CysLT1R with montelukast reversed Abeta1-42-mediated increase of CysLT1R expression, and concomitant changes of the pro-inflammatory factors and the apoptotic process-related proteins. The results demonstrate that montelukast rescued neurons against Abeta1-42-induced neurotoxicity, neuroinflammation and apoptosis by down-regulating CysLT1R-mediated NF-ÎºB signaling, suggesting that CysLT1R may be a potential target for AD, and its antagonist may have beneficial effects for treatment of AD.", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"24879954", citationType:"PubMed", citationRef:"24879954"}}, {start: {_id:4247}, end: {_id:4248}, properties:{evidence:"To this end, we now report that Ccl2 deficiency influences behavioral abnormalities and disease progression in Abeta precursor protein/presenilin-1 double-transgenic mice.", annotationSubgraph:["Gamma secretase subgraph"], annotationSpecies:["10090"], annotationConfidence:["Medium"], pmid:"23040664", citationType:"PubMed", citationRef:"23040664"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:51}, end: {_id:6}, properties:{evidence:"The main factors responsible for Abeta formation are mutation of APP or PS1 and PS2 genes or ApoE gene. All mutations associated with APP and PS proteins can lead to an increase in the production of Abeta peptides, specifically the more amyloidogenic form, Abeta42.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"15177383", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15177383"}}, {start: {_id:57}, end: {_id:6}, properties:{evidence:"The main factors responsible for Abeta formation are mutation of APP or PS1 and PS2 genes or ApoE gene. All mutations associated with APP and PS proteins can lead to an increase in the production of Abeta peptides, specifically the more amyloidogenic form, Abeta42.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"15177383", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15177383"}}, {start: {_id:1149}, end: {_id:22}, properties:{evidence:"Here, we present evidence that, besides APP expression regulation, miRNAs are equally involved in the regulation of neuronal APP mRNA alternative splicing. Lack of miRNAs in post-mitotic neurons in vivo is associated with APP exons 7 and 8 inclusion, while ectopic expression of miR-124, an abundant neuronal-specific miRNA, reversed these effects in cultured neurons. Similar results were obtained by depletion of endogenous polypyrimidine tract binding protein 1 (PTBP1) in cells, a recognized miR-124 target gene. Furthermore, PTBP1 levels correlate with the presence of APP exons 7 and 8, while PTBP2 levels correlate with the skipping of these exons during neuronal differentiation. Finally, we show that miR-124 is down-regulated in AD brain. In sum, our results suggest that specific miRNAs are involved in the fine-tuning of APP alternative splicing in neurons. Since abnormal neuronal splicing of APP affects beta-amyloid peptide production, these results could contribute to the understanding of the implication of miRNAs in brain health and disease.", annotationSubgraph:["miRNA subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"21062284", citationType:"PubMed", citationRef:"21062284"}}, {start: {_id:587}, end: {_id:6}, properties:{evidence:"The PSEN1 AD mutations giving rise to CWP produce unusually high levels of the amyloid beta peptide (Abeta) ending at position 42 or 43, and the main component of CWP is amino-terminally truncated forms of amyloid beta peptide starting after the alternative beta-secretase cleavage site at position 11.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"17995932", citationType:"PubMed", citationRef:"17995932"}}, {start: {_id:2793}, end: {_id:6}, properties:{evidence:"Using high-throughput siRNA screening technology, we assessed 15,200 genes for their role in Abeta42 secretion and identified leucine-rich repeat transmembrane 3 (LRRTM3) as a neuronal gene that promotes APP processing by BACE1. siRNAs targeting LRRTM3 inhibit the secretion of Abeta40, Abeta42, and sAPPbeta, the N-terminal APP fragment produced by BACE1 cleavage, from cultured cells and primary neurons by up to 60%, whereas overexpression increases Abeta secretion.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"17098871", citationType:"PubMed", citationRef:"17098871"}}, {start: {_id:4476}, end: {_id:4482}, properties:{evidence:"It has been shown that the MTHFR 677T allele is associated with increased total plasma Hcy levels (tHcy) and decreased serum folate levels, mainly in 677TT homozygous subjects. the MTHFR 677C>T polymorphism as a candidate AD risk factor", annotationSubgraph:["Epigenetic modification subgraph"], annotationMeshanatomy:["Serum"], pmid:"21119889", citationType:"PubMed", citationRef:"21119889"}}, {start: {_id:4485}, end: {_id:4486}, properties:{evidence:"RFC1 80G>A and MTHFR 677C>T polymorphisms in a large cohort of AD patients", annotationSubgraph:["Epigenetic modification subgraph"], pmid:"21119889", citationType:"PubMed", citationRef:"21119889"}}, {start: {_id:4490}, end: {_id:4492}, properties:{evidence:"A common TC 776C>G polymorphism results in the replacement of proline with arginine (Pro259Arg) and negatively affects vitamin B12 metabolism, thus increasing plasma Hcy levels", annotationSubgraph:["Vitamin subgraph"], pmid:"21119889", citationType:"PubMed", citationRef:"21119889"}}, {start: {_id:4498}, end: {_id:4477}, properties:{evidence:"Homocysteine metabolism is influenced by genetic polymorphisms of the methylenetetrahydrofolate reductase (MTHFR 677 C-->T and 1298 A-->C) and transcobalamin genes (TCN1 776 C-->G ). We evaluated the association of homocysteine with Alzheimer's disease (AD) and the influence of related polymorphisms and APOE,", annotationSubgraph:["Epigenetic modification subgraph"], pmid:"15073531", citationType:"PubMed", citationRef:"15073531"}}, {start: {_id:4506}, end: {_id:85}, properties:{evidence:"BACE1 and BACE2, are involved in the development of Alzheimer's disease by producing Abeta", annotationSpecies:["10090"], pmid:"22166205", citationType:"PubMed", citationRef:"22166205"}}, {start: {_id:4508}, end: {_id:1119}, properties:{annotationExperimentalGroup:["Physical exercised group"], annotationGender:["Female"], evidence:"Both exercised SAMR1 and SAMP8 mice showed significantly increased IGF1 plasma levels compared with their corresponding sedentary group", annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24688469", citationType:"PubMed", citationRef:"24688469"}}, {start: {_id:3910}, end: {_id:534}, properties:{annotationExperimentalGroup:["Sedentary group"], annotationGender:["Female"], evidence:"In the hippocampus, Bdnf gene was underexpressed in sedentary mice and both Bdnf and its receptor TrkB were significantly upregulated in response to the exercise intervention", annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24688469", citationType:"PubMed", citationRef:"24688469"}}, {start: {_id:4509}, end: {_id:4510}, properties:{annotationGender:["Female"], evidence:"after the exercise intervention Bdnf levels in SAMP8 mice were undistinguishable from those found in sedentary SAMR1 controls . Neuritin gene, a well characterized target of BDNF, was upregulated in both strains by exercise training", annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24688469", citationType:"PubMed", citationRef:"24688469"}}, {start: {_id:4516}, end: {_id:4515}, properties:{annotationGender:["Female"], evidence:"Voluntary exercise led to a significant decrease in Hdac3 gene expression exclusively in SAMP8 mice", annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24688469", citationType:"PubMed", citationRef:"24688469"}}, {start: {_id:4519}, end: {_id:4518}, properties:{annotationGender:["Female"], evidence:". ANOVA analysis showed a downregulation tendency for Hdac5 gene in exercised compared with sedentary SAMP8 mice", annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24688469", citationType:"PubMed", citationRef:"24688469"}}, {start: {_id:4522}, end: {_id:3115}, properties:{annotationGender:["Female"], evidence:"We found a downregulation of histone deacetylase Hdac6 in the hippocampus of sedentary SAMP8 mice", annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"24688469", citationType:"PubMed", citationRef:"24688469"}}, {start: {_id:4534}, end: {_id:1199}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"external application of beta-amyloid cerebral endothelial cell cultures results in extensive methylation at the neprilysin (NPE) gene promoter", annotationMeshanatomy:["Endothelium"], pmid:"21419233", citationType:"PubMed", citationRef:"21419233"}}, {start: {_id:1149}, end: {_id:22}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"hypomethylation at the APP gene promoter as a possible risk factor for AD", pmid:"21419233", citationType:"PubMed", citationRef:"21419233"}}, {start: {_id:4539}, end: {_id:4540}, properties:{evidence:"our new loci with differential methylation, RHBDF2, RPL13, C10orf54ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Å“CDH23 and ANK1, were independently identified in both studies, suggesting that these signals represent a real association with Alzheimer's disease risk", pmid:"25157507", citationType:"PubMed", citationRef:"25157507"}}, {start: {_id:4541}, end: {_id:4543}, properties:{evidence:"RHDBF2 was found to be part of the same network of interacting proteins as the Alzheimer's risk gene PTK2B, suggesting a potential role in microglia and macrophage activity.", annotationSubgraph:["Regulation of actin cytoskeleton subgraph", "Vascular endothelial growth factor subgraph"], pmid:"25157507", citationType:"PubMed", citationRef:"25157507"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:4612}, end: {_id:4613}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"Our results show that IGFBP3 promoter CpGs (25 out of 32) within the CpG island were hypermethylated in H4-sw cells", annotationSpecies:["10090"], annotationUserdefinedcellline:["App transgenic"], pmid:"24964199", citationType:"PubMed", citationRef:"24964199", annotationRace:["Swedish"]}}, {start: {_id:4621}, end: {_id:4622}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"Further chromatin immunoprecipitation and bisulfite sequencing studies illustrated the decreased cytosine methylation in the Cdk5 promoter region in hippocampal CA1 in the rodent model of AD", annotationSubgraph:["Cyclin-CDK subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], pmid:"25234403", citationType:"PubMed", citationRef:"25234403"}}, {start: {_id:4626}, end: {_id:1741}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"BACE1 mRNA levels were increased in aged 3xTg-AD mice as well as in AD PBMCs along with an increase in promoter accessibility and histone H3 acetylation, while the BACE1 promoter region was less accessible in PBMCs from MCI individuals", annotationSpecies:["10090"], annotationCell:["blood cell"], annotationUserdefinedcellline:["App transgenic"], pmid:"22728099", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22728099"}}, {start: {_id:4629}, end: {_id:4631}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"Ncstn was downregulated in aged 3xTg-AD brains with a condensation of chromatin and Sirt1 mRNA levels were decreased in these animals despite alterations in histone H3 acetylation", annotationSpecies:["10090"], annotationCell:["blood cell"], annotationUserdefinedcellline:["App transgenic"], pmid:"22728099", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22728099"}}, {start: {_id:4633}, end: {_id:4634}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"Ncstn was downregulated in aged 3xTg-AD brains with a condensation of chromatin and Sirt1 mRNA levels were decreased in these animals despite alterations in histone H3 acetylation", annotationSpecies:["10090"], annotationCell:["blood cell"], annotationUserdefinedcellline:["App transgenic"], pmid:"22728099", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22728099"}}, {start: {_id:4650}, end: {_id:2765}, properties:{evidence:"Trichostatin A increases calpastatin levels epigenetically via histone acetylations(H4K5-Ac(acetylation at lysine 5 of histone H4), H3K9-Ac and H3K14-Ac).", pmid:"24200051", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24200051"}}, {start: {_id:4666}, end: {_id:4667}, properties:{evidence:"We have shown that Mn activates YY1 via activation of NF-kB", pmid:"25064045", citationType:"PubMed", citationRef:"25064045"}}] AS row
