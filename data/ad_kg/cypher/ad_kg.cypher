UNWIND [{start: {_id:2277}, end: {_id:22}, properties:{evidence:"Mifepristone alters amyloid precursor protein processing to preclude amyloid beta and also reduces tau pathology.", annotationSubgraph:["Non-amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"23312564", citationType:"PubMed", citationRef:"23312564"}}, {start: {_id:2278}, end: {_id:2279}, properties:{evidence:"Induction and recovery time course of rat brain CYP2E1 after nicotine treatment.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Brain"], pmid:"16434548", citationType:"PubMed", citationRef:"16434548"}}, {start: {_id:2475}, end: {_id:2473}, properties:{evidence:"In support of this mechanism, in vitro, rapamycin significantly inhibits the production of NO, TNF-Î± in BV2 microglials by modulating NF-ÎºB signaling.", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "mTOR signaling subgraph"], annotationConfidence:["Medium"], pmid:"24923557", citationType:"PubMed", citationRef:"24923557"}}, {start: {_id:1787}, end: {_id:22}, properties:{evidence:"Over the last several years a number of reports have emerged suggesting that at least some ChEI might take part in betaAPP metabolism, influencing its secretion and Abeta differential cleavage. Moreover, we (Sob6w and Kloszewska 2005) and others (Basun et al. 2002, Zimmermann et al. 2005) have shown that the treatment with ChEI might influence BAPP metabolism in AD patients as measured by changes in plasma (including platelet-derived) metabolites. In our previous pilot study we have demonstrated that short-term treatment with ChEI rivastigmine exhibits a significant effect on plasma concentrations of Abeta-42 (mean increase after treatment reached 7.8 Â± 8.4 pg/ml) with a negative correlation to patients age, while no changes in Abeta-40 levels were detected.", annotationSubgraph:["Amyloidogenic subgraph"], annotationSpecies:["10116"], annotationConfidence:["Medium"], pmid:"17691220", citationType:"PubMed", citationRef:"17691220"}}, {start: {_id:690}, end: {_id:174}, properties:{evidence:"The sialic acid levels in the CSF apoE-containing lipoprotein fractions were 5.3 +/- 1.3% of the total CSF sialic acid, and were correlated with the CSF apoE concentrations.", annotationSubgraph:["APOE subgraph"], annotationConfidence:["Medium"], pmid:"19522249", citationType:"PubMed", citationRef:"19522249"}}, {start: {_id:611}, end: {_id:22}, properties:{evidence:"We conclude that astrocytes: (i) strongly regulate neuronal APP expression in primary neurons, and (ii) promote the amyloidogenic pathway in an apoE4-dependent manner. Thus, apoE and astrocytic factor(s) may pmodulate the pathogenesis of Alzheimer's disease.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11553277", citationType:"PubMed", citationRef:"11553277"}}, {start: {_id:3}, end: {_id:118}, properties:{evidence:"We have shown that interaction of CD40 with CD40L enables microglial activation in response to amyloid-beta peptide (Abeta), which is associated with Alzheimer's disease (AD)-like neuronal tau hyperphosphorylation in vivo.", annotationSubgraph:["Tumor necrosis factor subgraph", "Tau protein subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12402041", citationType:"PubMed", citationRef:"12402041"}}, {start: {_id:3}, end: {_id:3740}, properties:{evidence:"ABeta¸ directly interacts with Ca2+ channels such as voltage-dependent calcium channels (VDCC) and TRP cation channels (TRPC) to produce a transient increase in Ca2+ necessary for synaptic plasticity and neuronal survival. ABeta¸ interacts directly with the recombinant L-type Ca2+ channel (a1C) subunit to increase Ca2+ channel protein at the cell membrane and hence increased Ca2+ conductance [80]. Within the TRPC subfamily, TRPC3 and 6 have been shown to protect cerebellar granule neurons against serum deprivationÃ¢â‚¬â€œinduced cell death in cultures and promote