UNWIND [{start: {_id:6}, end: {_id:4700}, properties:{annotationCellstructure:["Mitochondria"], evidence:"Here we demonstrate that Hsp60, Hsp70, and Hsp90 both alone and in combination provide differential protection against intracellular beta-amyloid stress through the maintenance of mitochondrial oxidative phosphorylation and functionality of tricarboxylic acid cycle enzymes. Notably, beta-amyloid was found to selectively inhibit complex IV activity, an effect selectively neutralized by Hsp60. The combined effect of HSPs was to reduce the free radical burden, preserve ATP generation, decrease cytochrome c release, and prevent caspase-9 activation, all important mediators of beta-amyloid-induced neuronal dysfunction and death.", annotationSubgraph:["Chaperone subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Low"], pmid:"16887805", citationType:"PubMed", citationRef:"16887805"}}, {start: {_id:4697}, end: {_id:1050}, properties:{evidence:"Here we demonstrate that Hsp60, Hsp70, and Hsp90 both alone and in combination provide differential protection against intracellular beta-amyloid stress through the maintenance of mitochondrial oxidative phosphorylation and functionality of tricarboxylic acid cycle enzymes. Notably, beta-amyloid was found to selectively inhibit complex IV activity, an effect selectively neutralized by Hsp60. The combined effect of HSPs was to reduce the free radical burden, preserve ATP generation, decrease cytochrome c release, and prevent caspase-9 activation, all important mediators of beta-amyloid-induced neuronal dysfunction and death.", annotationSubgraph:["Caspase subgraph", "Chaperone subgraph"], annotationConfidence:["Low"], pmid:"16887805", citationType:"PubMed", citationRef:"16887805"}}, {start: {_id:2445}, end: {_id:1050}, properties:{evidence:"Here we demonstrate that Hsp60, Hsp70, and Hsp90 both alone and in combination provide differential protection against intracellular beta-amyloid stress through the maintenance of mitochondrial oxidative phosphorylation and functionality of tricarboxylic acid cycle enzymes. Notably, beta-amyloid was found to selectively inhibit complex IV activity, an effect selectively neutralized by Hsp60. The combined effect of HSPs was to reduce the free radical burden, preserve ATP generation, decrease cytochrome c release, and prevent caspase-9 activation, all important mediators of beta-amyloid-induced neuronal dysfunction and death.", annotationSubgraph:["Caspase subgraph", "Chaperone subgraph"], annotationConfidence:["Low"], pmid:"16887805", citationType:"PubMed", citationRef:"16887805"}}, {start: {_id:4100}, end: {_id:2650}, properties:{evidence:"However, in agreement with the proposed role of YKL-40 in limiting inflammation, it has recently been shown that YKL-40 also inhibits NF- κB activation and expression of IL-6", annotationSubgraph:["Inflammatory response subgraph", "Nuclear factor Kappa beta subgraph"], annotationConfidence:["Medium"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:4100}, end: {_id:2651}, properties:{evidence:"However, in agreement with the proposed role of YKL-40 in limiting inflammation, it has recently been shown that YKL-40 also inhibits NF- κB activation and expression of IL-6", annotationSubgraph:["Inflammatory response subgraph", "Nuclear factor Kappa beta subgraph"], annotationConfidence:["Medium"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:4862}, end: {_id:4861}, properties:{evidence:"As a result, the Polymerization of and MAP-2 and NF-H induced by Abeta25-35 could be significantly inhibited by Wnt3a(40 ng/ml), however enhanced by Dkk1(100 ng/ml).", annotationSubgraph:["DKK1 subgraph"], annotationConfidence:["Medium"], pmid:"26809093", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"26809093"}}, {start: {_id:4862}, end: {_id:4860}, properties:{evidence:"As a result, the Polymerization of and MAP-2 and NF-H induced by Abeta25-35 could be significantly inhibited by Wnt3a(40 ng/ml), however enhanced by Dkk1(100 ng/ml).", annotationSubgraph:["DKK1 subgraph"], annotationConfidence:["Medium"], pmid:"26809093", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"26809093"}}, {start: {_id:22}, end: {_id:1008}, properties:{evidence:"we observed that APP down regulates expression of four immediate early genes, Egr1, c-Fos, Bdnf and Arc. Whereas APP affected Egr1 promoter activity by reducing access of the CREB transcription factor.", annotationSubgraph:["CREB subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"24919190", citationType:"PubMed", citationRef:"24919190"}}] AS row
