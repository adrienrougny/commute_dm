ated signaling"], annotationConfidence:["Medium"], pmid:"24879954", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24879954"}}, {start: {_id:1958}, end: {_id:1679}, properties:{evidence:"This increment of CysLT1R expression was accompanied by increases of inflammatory factors such as NF-ÎºB p65, tumor necrosis factor-Î± (TNFÎ±) and interleukin-1beta (IL-1beta) as well as pro-apoptotic protein Caspase-3 activation and anti-apoptotic process protein Bcl-2 reduction.", annotationSubgraph:["G-protein-mediated signaling"], annotationConfidence:["Medium"], pmid:"24879954", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24879954"}}] AS row
