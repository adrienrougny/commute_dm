UNWIND [{start: {_id:21}, end: {_id:3}, properties:{evidence:"Alzheimer's beta-secretase (BACE1) is a membrane-bound protease that cleaves the amyloid precursor protein (APP) in the trans-Golgi network, an initial step in the pathogenesis of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"14973371", citationType:"PubMed", citationRef:"14973371"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The activity of BACE-1 as measured by the formation of the cleavage product of amyloid beta precursor protein, transiently increased up to 48 h after injury, but returned to basal level 7 days post injury.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15057522", citationType:"PubMed", citationRef:"15057522"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"BACE is an aspartyl protease that cleaves the amyloid precursor protein (APP) at the beta-secretase cleavage site and is involved in Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15080893", citationType:"PubMed", citationRef:"15080893"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"The beta-site APP-cleaving enzyme (BACE1) has been identified as the key enzyme leading to beta-amyloid formation, and cholinergic mechanisms have been shown to control APP processing.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15211591", citationType:"PubMed", citationRef:"15211591"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Because alpha-secretase and BACE-1 cleave APP within the secretory pathway, it is likely that the two enzymes compete for the APP substrate.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15314262", citationType:"PubMed", citationRef:"15314262"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Alzheimer's beta-secretase (BACE1) cleaves amyloid precursor protein to produce amyloid beta-peptide, which is a crucial initiation process of the pathogenesis of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15467394", citationType:"PubMed", citationRef:"15467394"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Mapping to the Down syndrome critical region (chromosome 21) and identified as a homologue of BACE1, BACE2 also cleaves amyloid precursor protein at the beta-site.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15473697", citationType:"PubMed", citationRef:"15473697"}}, {start: {_id:86}, end: {_id:3}, properties:{evidence:"Mapping to the Down syndrome critical region (chromosome 21) and identified as a homologue of BACE1, BACE2 also cleaves amyloid precursor protein at the beta-site.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15473697", citationType:"PubMed", citationRef:"15473697"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Although pmodest overexpression enhanced amyloid deposition, high BACE overexpression inhibited amyloid formation despite increased beta- cleavage of APP. BACE overexpression alters the subcellular processing of APP and inhibits Abeta deposition in vivo.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15642747", citationType:"PubMed", citationRef:"15642747"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Beta-secretase [beta-site amyloid precursor protein-cleaving enzyme 1 (BACE1)] is the key rate-limiting enzyme for the production of the beta-amyloid (Abeta) peptide involved in the pathogenesis of Alzheimer's disease (AD).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16306400", citationType:"PubMed", citationRef:"16306400"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"This was associated with inefficient plasminogen binding and plasmin activation, the displacement of beta-secretase (BACE) from DRMs to APP-containing membrane fractions, increased beta-cleavage of APP and high levels of Abeta peptides.", pmid:"16407971", citationType:"PubMed", citationRef:"16407971"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Heparin can promote beta-secretase cleavage of APP in neuroblastoma cells.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16716081", citationType:"PubMed", citationRef:"16716081"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"In AD, the specific inhibition of beta- or beta-secretase activities would decrease the production of Abeta from its precursor, in such a way that its relative concentration could be low enough to avoid the formation of aggregates.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16768248", citationType:"PubMed", citationRef:"16768248"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"BACE1 is a membrane-bound aspartyl protease that specifically cleaves amyloid precursor protein (APP) at the beta-secretase site.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16979658", citationType:"PubMed", citationRef:"16979658"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Hypoxia up-regulated beta-secretase cleavage of APP and amyloid-beta protein (Abeta) production by increasing BACE1 gene transcription and expression both in vitro and in vivo.", annotationSubgraph:["Hypoxia response subgraph", "Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17121991", citationType:"PubMed", citationRef:"17121991"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Consequently, inhibition of BACE-1, a rate-limiting enzyme in the production of Abeta, is an attractive therapeutic approach for the treatment of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17156133", citationType:"PubMed", citationRef:"17156133"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"In addition, we show that some NF-kappaB inhibitors decrease sAPPbeta and APP-CTFbeta suggesting that they reduce the beta-secretase cleavage of APP.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17223266", citationType:"PubMed", citationRef:"17223266"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Beta-site amyloid precursor protein cleaving enzyme 1 (BACE1) (beta- secretase) initiates generation of beta-amyloid (Abeta), which plays an early role in Alzheimer's disease (AD).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17409228", citationType:"PubMed", citationRef:"17409228"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Beta-secretase is a potential target for inhibitory drugs against Alzheimer's disease as it cleaves amyloid precursor protein (APP) to form insoluble amyloid plaques and vascular deposits in the brain.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17500040", citationType:"PubMed", citationRef:"17500040"}}, {start: {_id:21}, end: {_id:3}, properties:{evidence:"Consequently, inhibition of BACE-1, a rate-limiting enzyme in the production of Abeta, is an attractive therapeutic approach to the treatment of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17541560", citationType:"PubMed", citationRef:"17541560"}}] AS row
