UNWIND [{start: {_id:2081}, end: {_id:1229}, properties:{evidence:"OPN is involved in a number of physiologic and pathologic events including angiogenesis, apoptotic process, inflammation, oxidative stress, remyelination, wound healing, bone remodeling, cell migration and tumorigenesis.", annotationSubgraph:["Chemokine signaling subgraph"], annotationConfidence:["High"], pmid:"17316167", citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:2081}, end: {_id:333}, properties:{evidence:"Given that the induction of OPN expression (and amyloid-beta generation) is associated with remodeling and tumorigenesis, our results suggest that OPN may play a role in the aberrant re-entry of neurons into the cell cycle and/or neuronal remyelination in AD.", annotationMeshdisease:["Cell Transformation, Neoplastic", "Alzheimer Disease"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"17316167", citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:2100}, end: {_id:2101}, properties:{evidence:"Functional annotation of genes associated with EGR1 binding revealed a set of related networks including synaptic vesicle transport, clathrin-dependent endocytosis (CME), intracellular membrane fusion and transmission of signals elicited by Ca(2+) influx.", annotationSubgraph:["Synaptic vesicle endocytosis subgraph", "Gamma secretase subgraph"], pmid:"24269917", citationType:"PubMed", citationRef:"24269917"}}, {start: {_id:2100}, end: {_id:288}, properties:{evidence:"Functional annotation of genes associated with EGR1 binding revealed a set of related networks including synaptic vesicle transport, clathrin-dependent endocytosis (CME), intracellular membrane fusion and transmission of signals elicited by Ca(2+) influx.", annotationSubgraph:["Gamma secretase subgraph", "Endosomal lysosomal subgraph"], pmid:"24269917", citationType:"PubMed", citationRef:"24269917"}}, {start: {_id:2100}, end: {_id:2102}, properties:{evidence:"Functional annotation of genes as