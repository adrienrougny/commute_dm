GNC:\"NOTCH1\",frag(\"?\"))))"}}, {_id:3561, properties:{bel:"rxn(reactants(a(CHEBI:\"2-oxoglutaric acid\")),products(a(CHEBI:\"succinyl-CoA\")))"}}, {_id:3791, properties:{bel:"rxn(reactants(a(CHEBI:\"copper(2+)\")),products(a(CHEBI:\"copper(1+)\")))"}}, {_id:3842, properties:{bel:"rxn(reactants(p(FPLX:\"Notch\")),products(a(CONSO:\"Notch intracellular domain\")))"}}, {_id:3878, properties:{bel:"rxn(reactants(p(HGNC:\"APP\")),products(p(CONSO:\"YENPTY endocytosis motif (APP)\")))"}}, {_id:3902, properties:{bel:"rxn(reactants(p(HGNC:\"APP\")),products(p(HGNC:\"APP\",frag(\"?\"))))"}}] AS row
