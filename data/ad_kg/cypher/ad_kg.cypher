UNWIND [{start: {_id:611}, end: {_id:96}, properties:{evidence:"Following stimulation with IL-1beta and TNF-Î±, activated astrocytes newly produced IL-1beta, IL-1ra, TNF-Î±, IP-10 (CXCL10), MIP-1Î± (CCL3) and RANTES (CCL5), in addition to the induction of sICAM-1 and complement component 5. Database search indicated that most of cytokines and chemokines produced by non-stimulated and activated astrocytes are direct targets of the transcription factor NF-kB.", annotationSubgraph:["Tumor necrosis factor subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["High"], pmid:"24691121", citationType:"PubMed", citationRef:"24691121"}}, {start: {_id:611}, end: {_id:244}, properties:{evidence:"Following stimulation with IL-1beta and TNF-Î±, activated astrocytes newly produced IL-1beta, IL-1ra, TNF-Î±, IP-10 (CXCL10), MIP-1Î± (CCL3) and RANTES (CCL5), in addition to the induction of sICAM-1 and complement component 5. Database search indicated that most of cytokines and chemokines produced by non-stimulated and activated astrocytes are direct targets of the transcription factor NF-kB.", annotationSubgraph:["Chemokine signaling subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["High"], pmid:"24691121", citationType:"PubMed", citationRef:"24691121"}}, {start: {_id:611}, end: {_id:819}, properties:{evidence:"Following stimulation with IL-1beta and TNF-Î±, activated astrocytes newly produced IL-1beta, IL-1ra, TNF-Î±, IP-10 (CXCL10), MIP-1Î± (CCL3) and RANTES (CCL5), in addition to the induction of sICAM-1 and complement component 5. Database search indicated that most of cytokines and chemokines produced by non-stimulated and activated astrocytes are direct targets of the transcription factor NF-kB.", annotationSubgraph:["Chemokine signaling subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["High"], pmid:"24691121", citationType:"PubMed", citationRef:"24691121"}}, {start: {_id:611}, end: {_id:256}, properties:{evidence:"Following stimulation with IL-1beta and TNF-Î±, activated astrocytes newly produced IL-1beta, IL-1ra, TNF-Î±, IP-10 (CXCL10), MIP-1Î± (CCL3) and RANTES (CCL5), in addition to the induction of sICAM-1 and complement component 5. Database search indicated that most of cytokines and chemokines produced by non-stimulated and activated astrocytes are direct targets of the transcription factor NF-kB.", annotationSubgraph:["Chemokine signaling subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["High"], pmid:"24691121", citationType:"PubMed", citationRef:"24691121"}}, {start: {_id:611}, end: {_id:258}, properties:{evidence:"Following stimulation with IL-1beta and TNF-Î±, activated astrocytes newly produced IL-1beta, IL-1ra, TNF-Î±, IP-10 (CXCL10), MIP-1Î± (CCL3) and RANTES (CCL5), in addition to the induction of sICAM-1 and complement component 5. Database search indicated that most of cytokines and chemokines produced by non-stimulated and activated astrocytes are direct targets of the transcription factor NF-kB.", annotationSubgraph:["Low density lipoprotein subgraph", "Interleukin signaling subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["High"], pmid:"24691121", citationType:"PubMed", citationRef:"24691121"}}, {start: {_id:611}, end: {_id:4116}, properties:{evidence:"Following stimulation with IL-1beta and TNF-Î±, activated astrocytes newly produced IL-1beta, IL-1ra, TNF-Î±, IP-10 (CXCL10), MIP-1Î± (CCL3) and RANTES (CCL5), in addition to the induction of sICAM-1 and complement component 5. Database search indicated that most of cytokines and chemokines produced by non-stimulated and activated astrocytes are direct targets of the transcription factor NF-kB.", annotationSubgraph:["Complement system subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["High"], pmid:"24691121", citationType:"PubMed", citationRef:"24691121"}}, {start: {_id:611}, end: {_id:22}, properties:{evidence:"In addition, primary human astrocytes stimulated with the RIG-1 ligand 5'ppp RNA showed increased expression of amyloid precursor protein (APP) and amyloid-beta (Abeta), supporting the idea that RIG-1 is involved in the pathology of MCI associated with early progression to AD.These findings suggest that RIG-1 may play a critical role in incipient AD.", annotationSubgraph:["Amyloidogenic subgraph"], annotationMeshdisease:["Cognitive Dysfunction", "Alzheimer Disease"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["Medium"], pmid:"24694234", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24694234"}}, {start: {_id:4156}, end: {_id:4158}, properties:{evidence:"Furthermore, cellular signaling experiments showed that Pls enhanced phosphorylation of the phosphoinositide 3-kinase (PI3K)-dependent serine/threonine-specific protein kinase AKT and extracellular-signal- regulated kinases ERK1/2.", annotationMeshanatomy:["Serum"], annotationConfidence:["Medium"], pmid:"24357806", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:4156}, end: {_id:4159}, properties:{evidence:"Furthermore, cellular signaling experiments showed that Pls enhanced phosphorylation of the phosphoinositide 3-kinase (PI3K)-dependent serine/threonine-specific protein kinase AKT and extracellular-signal- regulated kinases ERK1/2.", annotationMeshanatomy:["Serum"], annotationConfidence:["High"], pmid:"24357806", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:4156}, end: {_id:1096}, properties:{evidence:"Furthermore, cellular signaling experiments showed that Pls enhanced phosphorylation of the phosphoinositide 3-kinase (PI3K)-dependent serine/threonine-specific protein kinase AKT and extracellular-signal- regulated kinases ERK1/2.", annotationMeshanatomy:["Serum"], annotationConfidence:["Medium"], pmid:"24357806", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:4183}, end: {_id:4184}, properties:{evidence:"Furthermore, luteolin increased the level of brain-derived neurotrophic factor (BDNF), the action of synapsin I (SYP) and postsynaptic density protein 95 (PSD-95) in the cortex and hippocampus as to that the behavioral performance in Morris water maze (MWM) and step-through task were significantly improved.", annotationMeshanatomy:["Hippocampus"], pmid:"24667364", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24667364"}}, {start: {_id:4183}, end: {_id:4185}, properties:{evidence:"Furthermore, luteolin increased the level of brain-derived neurotrophic factor (BDNF), the action of synapsin I (SYP) and postsynaptic density protein 95 (PSD-95) in the cortex and hippocampus as to that the behavioral performance in Morris water maze (MWM) and step-through task were significantly improved.", annotationMeshanatomy:["Hippocampus"], pmid:"24667364", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24667364"}}, {start: {_id:4183}, end: {_id:4186}, properties:{evidence:"Furthermore, luteolin increased the level of brain-derived neurotrophic factor (BDNF), the action of synapsin I (SYP) and postsynaptic density protein 95 (PSD-95) in the cortex and hippocampus as to that the behavioral performance in Morris water maze (MWM) and step-through task were significantly improved.", annotationMeshanatomy:["Hippocampus"], pmid:"24667364", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24667364"}}, {start: {_id:4183}, end: {_id:4187}, properties:{evidence:"Furthermore, luteolin increased the level of brain-derived neurotrophic factor (BDNF), the action of synapsin I (SYP) and postsynaptic density protein 95 (PSD-95) in the cortex and hippocampus as to that the behavioral performance in Morris water maze (MWM) and step-through task were significantly improved.", annotationMeshanatomy:["Hippocampus"], pmid:"24667364", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24667364"}}, {start: {_id:4188}, end: {_id:4194}, properties:{evidence:"TLR4 mediates the impairment of ubiquitin-proteasome and autophagy- lysosome pathways induced by ethanol treatment in brain.", annotationSubgraph:["Toll like receptor subgraph"], annotationMeshanatomy:["Brain", "Lysosomes"], pmid:"24556681", citationType:"PubMed", citationRef:"24556681"}}, {start: {_id:4188}, end: {_id:4195}, properties:{evidence:"Using the cerebral cortex of WT and TLR4-knockout mice with and without chronic ethanol treatment, we demonstrate that ethanol induces poly-ubiquitinated proteins accumulation and promotes immunoproteasome activation by inducing the expression of beta2i, beta5i and PA28Î±, although it decreases the 20S constitutive proteasome subunits (Î±2, beta5).", annotationSubgraph:["Toll like receptor subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Cerebral Cortex"], pmid:"24556681", citationType:"PubMed", citationRef:"24556681"}}, {start: {_id:4188}, end: {_id:4196}, properties:{evidence:"Ethanol also upregulates mTOR phosphorylation, leading to a downregulation of the autophagy-lysosome pathway (ATG12, ATG5, cathepsin B, p62, LC3) and alters the volume of autophagic vacuoles.", annotationSubgraph:["mTOR signaling subgraph"], annotationMeshanatomy:["Vacuoles", "Lysosomes"], pmid:"24556681", citationType:"PubMed", citationRef:"24556681"}}, {start: {_id:4268}, end: {_id:1550}, properties:{evidence:"Additionally, CDT also inhibited the increase of TNF-Î± and IL-6 level, and increased the expression of choline acetyltransferase (ChAT), receptor of activated protein kinase C1 (RACK1) and brain- derived neurotrophic factor (BDNF) in brain as compared to model mice.", annotationSpecies:["10090"], annotationMeshdisease:["Memory Disorders"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"24422705", citationType:"PubMed", citationRef:"24422705"}}, {start: {_id:4268}, end: {_id:4270}, properties:{evidence:"Additionally, CDT also inhibited the increase of TNF-Î± and IL-6 level, and increased the expression of choline acetyltransferase (ChAT), receptor of activated protein kinase C1 (RACK1) and brain- derived neurotrophic factor (BDNF) in brain as compared to model mice.", annotationSpecies:["10090"], annotationMeshdisease:["Memory Disorders"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"24422705", citationType:"PubMed", citationRef:"24422705"}}, {start: {_id:4268}, end: {_id:4185}, properties:{evidence:"Additionally, CDT also inhibited the increase of TNF-Î± and IL-6 level, and increased the expression of choline acetyltransferase (ChAT), receptor of activated protein kinase C1 (RACK1) and brain- derived neurotrophic factor (BDNF) in brain as compared to model mice.", annotationSpecies:["10090"], annotationMeshdisease:["Memory Disorders"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"24422705", citationType:"PubMed", citationRef:"24422705"}}] AS row
