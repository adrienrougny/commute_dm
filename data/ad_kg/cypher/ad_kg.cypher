UNWIND [{start: {_id:738}, end: {_id:739}, properties:{evidence:"Depletion of Hrs and Tsg101, acting early in the multivesicular body pathway, retained APP in early endosomes and reduced Abeta(40) production. Conversely, depletion of CHMP6 and VPS4, acting late in the pathway, rerouted endosomal APP to the TGN for enhanced APP processing. We found that VPS35 (retromer)-mediated APP recycling to the TGN was required for efficient Abeta(40) production.", annotationSubgraph:["Endosomal lysosomal subgraph", "Endoplasmic reticulum-Golgi protein export"], annotationConfidence:["High"], pmid:"22711829", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22711829"}}, {start: {_id:1933}, end: {_id:1934}, properties:{evidence:"Accordingly, immunoblot experiments showed that amongst NF-kappa B/Rel proteins, RelA and p50 are mobilized to the nucleus following microglial cell stimulation with A beta(25-35) plus IFN gamma.", annotationSubgraph:["Interferon signaling subgraph", "Nuclear factor Kappa beta subgraph"], pmid:"9209268", citationType:"PubMed", citationRef:"9209268"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
