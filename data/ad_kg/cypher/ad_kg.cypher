UNWIND [{start: {_id:27}, end: {_id:982}, properties:{evidence:"This is particularly the case with Alzheimer's disease, the most common age-related dementia associated with impairments in learning and memory accompanied by neuroinflammation, oxidative stress and neurodegeneration.", pmid:"24256258", annotationDisease:["dementia", "Alzheimer's disease"], citationType:"PubMed", citationRef:"24256258"}}, {start: {_id:27}, end: {_id:2498}, properties:{evidence:"Background: The components of the immune system have been indicated to be linked with the neurotoxicity in Alzheimer's disease (AD).", annotationMeshdisease:["Plaque, Amyloid", "Alzheimer Disease"], pmid:"24662962", citationType:"PubMed", citationRef:"24662962"}}, {start: {_id:1160}, end: {_id:172}, properties:{evidence:"The hippocampal lipid peroxidation correlated strongly with the increase of LOC positive fiber load, whereas neocortical TBARS levels were unrelated to amyloidosis. These data illustrate for the first time the progression of major AD related neuropathological features other than plaque load in the APPSL mouse model.", annotationSpecies:["10090"], annotationMeshdisease:["Plaque, Amyloid", "Amyloidosis"], annotationMeshanatomy:["Hippocampus", "Neocortex"], annotationConfidence:["Medium"], pmid:"24886182", citationType:"PubMed", citationRef:"24886182"}}] AS row
