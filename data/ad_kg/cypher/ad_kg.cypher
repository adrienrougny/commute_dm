UNWIND [{start: {_id:3520}, end: {_id:118}, properties:{evidence:"Finally, CaM kinase II is present in neurons but not in glial cells, thus suggesting no role of CaM kinase II in tau phosphorylation of glial cells. These observations, together with previous results of in vitro studies, support the idea that several MAPK/ERK, SAPK/JNK, p38 and CaM kinase II may participate in tau phosphorylation in tauopathies", annotationSubgraph:["Tau protein subgraph"], annotationMeshanatomy:["Microglia"], annotationConfidence:["High"], pmid:"11810404", citationType:"PubMed", citationRef:"11810404"}}, {start: {_id:4875}, end: {_id:547}, properties:{evidence:"Arhgef5 can strongly activate RhoA and RhoB and weakly RhoC and RhoG, but not Rac1, RhoQ, RhoD, or RhoV, in transfected human embryonic kidney 293 cells.", annotationSubgraph:["RhoA subgraph"], pmid:"19713215", annotationCellline:["HEK293"], citationType:"PubMed", citationRef:"19713215"}}, {start: {_id:4875}, end: {_id:4879}, properties:{evidence:"Arhgef5 can strongly activate RhoA and RhoB and weakly RhoC and RhoG, but not Rac1, RhoQ, RhoD, or RhoV, in transfected human embryonic kidney 293 cells.", annotationSubgraph:["RhoA subgraph"], pmid:"19713215", annotationCellline:["HEK293"], citationType:"PubMed", citationRef:"19713215"}}, {start: {_id:4875}, end: {_id:4874}, properties:{evidence:"Arhgef5 can strongly activate RhoA and RhoB and weakly RhoC and RhoG, but not Rac1, RhoQ, RhoD, or RhoV, in transfected human embryonic kidney 293 cells.", annotationSubgraph:["RhoA subgraph"], pmid:"19713215", annotationCellline:["HEK293"], citationType:"PubMed", citationRef:"19713215"}}, {start: {_id:4875}, end: {_id:4880}, properties:{evidence:"Arhgef5 can strongly activate RhoA and RhoB and weakly RhoC and RhoG, but not Rac1, RhoQ, RhoD, or RhoV, in transfected human embryonic kidney 293 cells.", annotationSubgraph:["RhoA subgraph"], pmid:"19713215", annotationCellline:["HEK293"], citationType:"PubMed", citationRef:"19713215"}}] AS row
