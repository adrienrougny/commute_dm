UNWIND [{start: {_id:6}, end: {_id:2236}, properties:{annotationCellstructure:["Cell Nucleus"], evidence:"We found that pRb exhibited increased levels of Ser795 phosphorylation in response to Abeta in the nucleus of PC12 cells and also in the nucleus of a subset of neurons during AD.", annotationSubgraph:["Retinoblastoma subgraph"], annotationMeshanatomy:["Brain", "Neurons"], annotationConfidence:["High"], pmid:"11640947", annotationDisease:["Alzheimer's disease"], annotationCellline:["PC-12 cell"], citationType:"PubMed", citationRef:"11640947"}}, {start: {_id:803}, end: {_id:2234}, properties:{evidence:"Besides mediating COX-2 expression, p38 MAPK is suggested to mediate cell cycle progression through phosphorylation of the retinoblastoma protein (pRb).", annotationSubgraph:["Retinoblastoma subgraph", "JAK-STAT signaling subgraph"], pmid:"15056456", citationType:"PubMed", citationRef:"15056456"}}, {start: {_id:108}, end: {_id:2239}, properties:{evidence:"Cdk5/p25 subsequently phosphorylates the nuclear transcription factor myocyte enhancer factor (MEF2), thereby inhibiting its prosurvival activity.", annotationSubgraph:["Cyclin-CDK subgraph"], annotationSpecies:["9606"], annotationConfidence:["High"], pmid:"17160145", citationType:"PubMed", citationRef:"17160145"}}, {start: {_id:96}, end: {_id:2254}, properties:{evidence:"Further, TNF-alpha upregulated the production of TSP1 and CD47 by myoblasts.", annotationSubgraph:["Immunoglobulin subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["High"], pmid:"17572512", citationType:"PubMed", citationRef:"17572512"}}, {start: {_id:96}, end: {_id:2251}, properties:{evidence:"Further, TNF-alpha upregulated the production of TSP1 and CD47 by myoblasts.", annotationSubgraph:["Cell adhesion subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["High"], pmid:"17572512", citationType:"PubMed", citationRef:"17572512"}}, {start: {_id:1359}, end: {_id:1726}, properties:{evidence:"In the brain, endothelin-1 (ET-1) is a locally acting vasoconstrictor, produced in neurons by endothelin-converting enzyme (ECE)-2 and in endothelial cells by ECE-1.", annotationSubgraph:["Endothelin subgraph"], annotationMeshanatomy:["Neurons"], pmid:"23629587", citationType:"PubMed", citationRef:"23629587"}}, {start: {_id:6}, end: {_id:1359}, properties:{evidence:"We previously showed ECE-2 and ET-1 to be elevated in postmortem temporal cortex from AD patients, and ECE-2 expression and ET-1 release to be upregulated by Abeta42 in vitro.", annotationSubgraph:["Endothelin subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Cerebral Cortex"], pmid:"23629587", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23629587"}}, {start: {_id:2295}, end: {_id:1726}, properties:{evidence:"ET-1 expression and secretion are both induced by the inflammatory and neurotoxic protein thrombin.", annotationSubgraph:["Endothelin subgraph", "Plasminogen activator subgraph", "Regulation of actin cytoskeleton subgraph"], annotationConfidence:["High"], pmid:"20634595", citationType:"PubMed", citationRef:"20634595"}}, {start: {_id:6}, end: {_id:1726}, properties:{evidence:"Abeta42 causes increased neuronal production and release of endothelin-1 (ET-1), a potent vasoconstrictor, and upregulation of endothelin-converting enzyme-2 (ECE-2), the enzyme which cleaves ET-1 from its inactive precursor.", annotationSubgraph:["Endothelin subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"21193044", citationType:"PubMed", citationRef:"21193044"}}, {start: {_id:6}, end: {_id:2297}, properties:{evidence:"Abeta42 causes increased neuronal production and release of endothelin-1 (ET-1), a potent vasoconstrictor, and upregulation of endothelin-converting enzyme-2 (ECE-2), the enzyme which cleaves ET-1 from its inactive precursor.", annotationSubgraph:["Endothelin subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"21193044", citationType:"PubMed", citationRef:"21193044"}}, {start: {_id:1944}, end: {_id:2234}, properties:{evidence:"These observations suggest that in AD cells the enhanced rates of cell proliferation and phosphorylation of pRb and the intracellular content of p27(kip1) may be interrelated events controlled by a mechanism dependent on the Ca(2+)/calmodulin signaling pathway.", annotationSubgraph:["Retinoblastoma subgraph", "Cyclin-CDK subgraph"], annotationCell:["lymphocyte"], pmid:"12901840", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12901840"}}, {start: {_id:2307}, end: {_id:2309}, properties:{evidence:"CHOP potentially co-operates with FOXO3a in neuronal cells to regulate PUMA and BIM expression in response to ER stress.", annotationSubgraph:["Response DNA damage", "Bcl-2 subgraph"], annotationMeshanatomy:["Neurons"], pmid:"22761832", citationType:"PubMed", citationRef:"22761832"}}, {start: {_id:2307}, end: {_id:1252}, properties:{evidence:"CHOP potentially co-operates with FOXO3a in neuronal cells to regulate PUMA and BIM expression in response to ER stress.", annotationSubgraph:["Response DNA damage", "Bcl-2 subgraph"], annotationMeshanatomy:["Neurons"], pmid:"22761832", citationType:"PubMed", citationRef:"22761832"}}, {start: {_id:37}, end: {_id:2307}, properties:{evidence:"We report that PS1 mutations cause a marked increase in basal protein levels of the pro-apoptotic transcription factor Gadd153. PS1 mutations increase Gadd153 protein translation without affecting mRNA levels, while decreasing levels of the anti-apoptotic protein Bcl-2.", annotationSubgraph:["Gamma secretase subgraph", "Response DNA damage"], pmid:"12390529", citationType:"PubMed", citationRef:"12390529"}}, {start: {_id:2316}, end: {_id:2317}, properties:{evidence:"In the rats injected with insulin, it was found that their learning and memory abilities were improved significantly (P < 0.01) and that the expression of the nicotinic acetylcholine receptors were increased and GFAP po