UNWIND [{start: {_id:27}, end: {_id:2383}, properties:{evidence:"Reduced serotonin 5-HT1A receptor binding in the temporal cortex correlates with aggressive behavior in Alzheimer disease.", pmid:"12742626", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12742626"}}] AS row
