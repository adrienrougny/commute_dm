UNWIND [{start: {_id:2159}, end: {_id:6}, properties:{evidence:"In this study, we aimed to investigate the possibility of P-gp as a potential therapeutic target for Alzheimer's disease by examining the impact of P-gp up-regulation on the clearance of Abeta, a neuropathological hallmark of Alzheimer's disease.Uptake studies for- radiolabelled Abeta Approximately 10-35% decrease in Abeta intracellular accumulation was observed in cells treated with rifampicin, dexamethasone, caffeine, verapamil, hyperforin, beta- estradiol and pentylenetetrazole compared with control.", annotationSubgraph:["Beta secretase subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21718295", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21718295"}}, {start: {_id:2197}, end: {_id:2196}, properties:{evidence:"Pioglitazone decreased hippocampal beta-amyloid accumulation and Fas ligand, but did not ameliorate the neurobehavioural deficits induced by MSG. MSG treatment enhances beta-amyloid accumulation in the rat hippocampus.", annotationSubgraph:["Non-amyloidogenic subgraph", "Tumor necrosis factor subgraph"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["Medium"], pmid:"24769037", citationType:"PubMed", citationRef:"24769037"}}, {start: {_id:2197}, end: {_id:6}, properties:{evidence:"Pioglitazone decreased hippocampal beta-amyloid accumulation and Fas ligand, but did not ameliorate the neurobehavioural deficits induced by MSG. MSG treatment enhances beta-amyloid accumulation in the rat hippocampus.", annotationSubgraph:["Non-amyloidogenic subgraph", "Tumor necrosis factor subgraph"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["Medium"], pmid:"24769037", citationType:"PubMed", citationRef:"24769037"}}, {start: {_id:1787}, end: {_id:746}, properties:{evidence:"Depending on the treatment received, a distinct inflammatory and oxidative stress profile was observed: in Rivastigmine-treated group, IL6 levels were 47% lower than the average value of the remaining AD patients; homocysteine and glutathione reductase were statistically unchanged in the Rivastigmine and Donepezil-Memantine, respectively Donepezil group.", annotationSubgraph:["Interleukin signaling subgraph"], annotationSpecies:["9606"], pmid:"23871825", citationType:"PubMed", citationRef:"23871825"}}, {start: {_id:2277}, end: {_id:6}, properties:{evidence:"Mifepristone alters amyloid precursor protein processing to preclude amyloid beta and also reduces tau pathology.", annotationSubgraph:["Non-amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"23312564", citationType:"PubMed", citationRef:"23312564"}}, {start: {_id:2352}, end: {_id:2350}, properties:{evidence:"Induction of uPAR surface expression by microglia was inhibited by the antioxidant N-acetyl-cysteine, indicating that this gene may be induced as a result of oxidative stress-related mechanisms.", annotationSubgraph:["Plasminogen activator subgraph"], annotationMeshanatomy:["Microglia"], pmid:"11814408", citationType:"PubMed", citationRef:"11814408"}}, {start: {_id:2377}, end: {_id:2367}, properties:{evidence:"Structural comparison between the three most representative families of compounds (kynurenines, kynurenamines and 4,5-dihydro-1H-pyrazole derivatives) allows the establishment of structure-activity relationships for the inhibition of nNOS, and a pharmacophore model that fulfills all of the observed SARs were developed.", annotationSubgraph:["Nitric oxide subgraph"], annotationConfidence:["High"], pmid:"22512552", citationType:"PubMed", citationRef:"22512552"}}, {start: {_id:2378}, end: {_id:2367}, properties:{evidence:"Structural comparison between the three most representative families of compounds (kynurenines, kynurenamines and 4,5-dihydro-1H-pyrazole derivatives) allows the establishment of structure-activity relationships for the inhibition of nNOS, and a pharmacophore model that fulfills all of the observed SARs were developed.", annotationSubgraph:["Nitric oxide subgraph"], annotationConfidence:["High"], pmid:"22512552", citationType:"PubMed", citationRef:"22512552"}}, {start: {_id:2410}, end: {_id:1917}, properties:{evidence:"In cells treated with wortmannin, protein kinase C delta fragments were observed, and the protein kinase C activity increased after 3 hours, whereas treatment of cells with z-DEVD-fmk, an inhibitor of caspase-3, inhibited fragmentation of protein kinase C delta and induced continuous activation of GSK-3.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "Caspase subgraph", "GSK3 subgraph"], annotationConfidence:["Medium"], pmid:"10850726", citationType:"PubMed", citationRef:"10850726"}}, {start: {_id:2437}, end: {_id:2431}, properties:{evidence:"pyrazole, CNB-001 is a potent inhibitor of 5-lipoxygenase (5-LOX), decreases 5-LOX expression, and increases proteasome activity.", annotationConfidence:["High"], pmid:"23785163", citationType:"PubMed", citationRef:"23785163"}}, {start: {_id:2437}, end: {_id:6}, properties:{evidence:"When fed to AD transgenic mice, CNB-001 also increases eIF2Î± phosphorylation and HSP90 and ATF4 levels, and limits the accumulation of soluble Abeta and ubiquitinated aggregated proteins.", annotationSubgraph:["Non-amyloidogenic subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"23785163", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23785163"}}, {start: {_id:2442}, end: {_id:567}, properties:{evidence:"In this study, we investigated whether AS-IV could prevent Abeta1-42-induced neurotoxicity in SK-N-SH cells via inhibiting the mPTP opening. The results showed that pretreatment of AS-IV significantly increased the viability of neuronal cells, reduced apoptotic process, decreased the generation of intracellular reactive oxygen species (ROS) and decreased mitochondrial superoxide in the presence of Abeta1-42. In addition, pretreatment of AS-IV inhibited the mPTP opening, rescued mitochondrial membrane potential, enhanced ATP generation, improved the activity of cytochrome c oxidase and blocked cytochrome c release from mitochondria in Abeta1-42 rich milieu. Moreover, pretreatment of AS-IV reduced the expression of Bax and cleaved caspase-3 and increased the expression of Bcl-2 in an Abeta1-42 rich environment. These data indicate that AS-IV prevents Abeta1-42-induced SK-N-SH cell apoptosis via inhibiting the mPTP opening and ROS generation.", annotationSubgraph:["Electron transport chain", "Caspase subgraph"], annotationConfidence:["High"], pmid:"24905226", citationType:"PubMed", citationRef:"24905226"}}, {start: {_id:2442}, end: {_id:1066}, properties:{evidence:"In this study, we investigated whether AS-IV could prevent Abeta1-42-induced neurotoxicity in SK-N-SH cells via inhibiting the mPTP opening. The results showed that pretreatment of AS-IV significantly increased the viability of neuronal cells, reduced apoptotic process, decreased the generation of intracellular reactive oxygen species (ROS) and decreased mitochondrial superoxide in the presence of Abeta1-42. In addition, pretreatment of AS-IV inhibited the mPTP opening, rescued mitochondrial membrane potential, enhanced ATP generation, improved the activity of cytochrome c oxidase and blocked cytochrome c release from mitochondria in Abeta1-42 rich milieu. Moreover, pretreatment of AS-IV reduced the expression of Bax and cleaved caspase-3 and increased the expression of Bcl-2 in an Abeta1-42 rich environment. These data indicate that AS-IV prevents Abeta1-42-induced SK-N-SH cell apoptosis via inhibiting the mPTP opening and ROS generation.", annotationSubgraph:["Electron transport chain", "Caspase subgraph", "Bcl-2 subgraph"], annotationConfidence:["High"], pmid:"24905226", citationType:"PubMed", citationRef:"24905226"}}, {start: {_id:2461}, end: {_id:2456}, properties:{evidence:"We have previously reported that CysLT1R activation is involved in Abeta generation. In this study, we investigated rescuing effect of CysLT1R antagonist montelukast on Abeta1-42-induced neurotoxicity in primary neurons. Our data showed that Abeta1-42 elicited a marked increase of CysLT1R expression in primary mouse neurons. This increment of CysLT1R expression was accompanied by increases of inflammatory factors such as NF-ÎºB p65, tumor necrosis factor-Î± (TNFÎ±) and interleukin-1beta (IL-1beta) as well as pro-apoptotic protein Caspase-3 activation and anti-apoptotic process protein Bcl-2 reduction. This observation was confirmed with treatment of montelukast, a selective CysLT1R antagonist, which had significant effect on Abeta1-42-induced cytotoxicity. Moreover, blockade of CysLT1R with montelukast reversed Abeta1-42-mediated increase of CysLT1R expression, and concomitant changes of the pro-inflammatory factors and the apoptotic process-related proteins. The results demonstrate that montelukast rescued neurons against Abeta1-42-induced neurotoxicity, neuroinflammation and apoptosis by down-regulating CysLT1R-mediated NF-ÎºB signaling, suggesting that CysLT1R may be a potential target for AD, and its antagonist may have beneficial effects for treatment of AD.", annotationSubgraph:["Non-amyloidogenic subgraph", "Bcl-2 subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"24879954", citationType:"PubMed", citationRef:"24879954"}}, {start: {_id:1797}, end: {_id:1739}, properties:{evidence:"The over-expressions of Abeta(1-42) and amyloid precursor protein (APP) were also decreased in the brains of APP/PS1 mice. Interestingly, MEM treatment improved the decreased NGF levels in APP/PS1 mice. Furthermore, NGF/TrkA signaling was activated by increasing the phosphorylation levels of tyrosine kinase (TrkA), proto-oncogene serine/threonine-protein kinase, Raf1 (c-Raf), extracellular regulated protein kinases (ERK)1/2 and cAMP-response element binding protein (CREB) after MEM treatment. Simultaneously, MEM also inhibited NGF/p75(NTR) signaling via decreasing the cleavage substrate of p75(NTR), increasing the JNK2 phosphorylation and decreasing the levels of p53 and cleaved-caspase 3.", annotationSubgraph:["Non-amyloidogenic subgraph"], annotationSpecies:["10090"], annotationConfidence:["Medium"], pmid:"24846616", citationType:"PubMed", citationRef:"24846616"}}, {start: {_id:1797}, end: {_id:1748}, properties:{evidence:"The over-expressions of Abeta(1-42) and amyloid precursor protein (APP) were also decreased in the brains of APP/PS1 mice. Interestingly, MEM treatment improved the decreased NGF levels in APP/PS1 mice. Furthermore, NGF/TrkA signaling was activated by increasing the phosphorylation levels of tyrosine kinase (TrkA), proto-oncogene serine/threonine-protein kinase, Raf1 (c-Raf), extracellular regulated protein kinases (ERK)1/2 and cAMP-response element binding protein (CREB) after MEM treatment. Simultaneously, MEM also inhibited NGF/p75(NTR) signaling via decreasing the cleavage substrate of p75(NTR), increasing the JNK2 phosphorylation and decreasing the levels of p53 and cleaved-caspase 3.", annotationSubgraph:["Non-amyloidogenic subgraph"], annotationSpecies:["10090"], annotationConfidence:["Medium"], pmid:"24846616", citationType:"PubMed", citationRef:"24846616"}}, {start: {_id:1797}, end: {_id:1680}, properties:{evidence:"The over-expressions of Abeta(1-42) and amyloid precursor protein (APP) were also decreased in the brains of APP/PS1 mice. Interestingly, MEM treatment improved the decreased NGF levels in APP/PS1 mice. Furthermore, NGF/TrkA signaling was activated by increasing the phosphorylation levels of tyrosine kinase (TrkA), proto-oncogene serine/threonine-protein kinase, Raf1 (c-Raf), extracellular regulated protein kinases (ERK)1/2 and cAMP-response element binding protein (CREB) after MEM treatment. Simultaneously, MEM also inhibited NGF/p75(NTR) signaling via decreasing the cleavage substrate of p75(NTR), increasing the JNK2 phosphorylation and decreasing the levels of p53 and cleaved-caspase 3.", annotationSubgraph:["Caspase subgraph"], annotationSpecies:["10090"], annotationConfidence:["Medium"], pmid:"24846616", citationType:"PubMed", citationRef:"24846616"}}, {start: {_id:1797}, end: {_id:2468}, properties:{evidence:"The over-expressions of Abeta(1-42) and amyloid precursor protein (APP) were also decreased in the brains of APP/PS1 mice. Interestingly, MEM treatment improved the decreased NGF levels in APP/PS1 mice. Furthermore, NGF/TrkA signaling was activated by increasing the phosphorylation levels of tyrosine kinase (TrkA), proto-oncogene serine/threonine-protein kinase, Raf1 (c-Raf), extracellular regulated protein kinases (ERK)1/2 and cAMP-response element binding protein (CREB) after MEM treatment. Simultaneously, MEM also inhibited NGF/p75(NTR) signaling via decreasing the cleavage substrate of p75(NTR), increasing the JNK2 phosphorylation and decreasing the levels of p53 and cleaved-caspase 3.", annotationSubgraph:["p53 stabilization subgraph"], annotationSpecies:["10090"], annotationConfidence:["Medium"], pmid:"24846616", citationType:"PubMed", citationRef:"24846616"}}, {start: {_id:2469}, end: {_id:2470}, properties:{evidence:"Glimepiride released CD14 from RAW 264 cells and microglial cells. Pre-treatment with glimepiride significantly reduced TNF, IL-1 and IL-6 secretion from RAW 264 and microglial cells incubated with LPS, Abeta42, alphaSN and PrP82-146. More recently, the concentrations of soluble CD14 were found to be elevated in AD and PD patients.", annotationSubgraph:["Immunoglobulin subgraph", "Regulation of actin cytoskeleton subgraph"], pmid:"24952384", citationType:"PubMed", citationRef:"24952384"}}, {start: {_id:2469}, end: {_id:96}, properties:{evidence:"Glimepiride released CD14 from RAW 264 cells and microglial cells. Pre-treatment with glimepiride significantly reduced TNF, IL-1 and IL-6 secretion from RAW 264 and microglial cells incubated with LPS, Abeta42, alphaSN and PrP82-146. More recently, the concentrations of soluble CD14 were found to be elevated in AD and PD patients.", annotationSubgraph:["Tumor necrosis factor subgraph"], pmid:"24952384", citationType:"PubMed", citationRef:"24952384"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
