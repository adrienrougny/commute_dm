UNWIND [{start: {_id:856}, end: {_id:824}, properties:{evidence:"the nuclear receptor peroxisome proliferator-activated receptor-gamma (PPARgamma) which acts to inhibit the expression of proinflammatory genes, this receptor appears a good candidate to mediate the observed anti-inflammatory effects", annotationSubgraph:["Inflammatory response subgraph", "Peroxisome proliferator activated receptor subgraph"], annotationConfidence:["High"], pmid:"15817521", citationType:"PubMed", citationRef:"15817521"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
