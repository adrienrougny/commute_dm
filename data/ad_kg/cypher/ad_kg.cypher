UNWIND [{start: {_id:825}, end: {_id:4156}, properties:{evidence:"Further studies on precise mechanisms of Pls-mediated protection against cell death may lead us to establish a novel therapeutic approach to cure neurodegenerative disorders.", annotationSpecies:["10090"], annotationMeshdisease:["Neurodegenerative Diseases"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], annotationDisease:["Alzheimer's disease"], pmid:"24357806", citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:27}, end: {_id:271}, properties:{evidence:"We speculate that higher affinity between Abeta and PLA2 has the therapeutic potential of decreasing the Abeta-Abeta interaction, thereby reducing the amyloid aggregation and plaque formation in AD.", annotationConfidence:["Medium"], pmid:"24619194", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:27}, end: {_id:4179}, properties:{evidence:"We also demonstrate that increased iron deposition in AD may contribute to the elevated expression of hBD-1 within the choroid plexus.", annotationMeshanatomy:["Choroid Plexus"], pmid:"24139179", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24139179"}}, {start: {_id:1142}, end: {_id:4183}, properties:{evidence:"Luteolin protects against high fat diet-induced cognitive deficits in obesity mice.", annotationSpecies:["10090"], annotationMeshdisease:["Obesity"], pmid:"24667364", citationType:"PubMed", citationRef:"24667364"}}, {start: {_id:27}, end: {_id:4261}, properties:{evidence:"Effects of Naproxen on Immune Responses in a Colchicine-Induced Rat Model of Alzheimer's Disease.", annotationSpecies:["10116"], pmid:"24662962", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24662962"}}, {start: {_id:27}, end: {_id:4260}, properties:{evidence:"Effects of Naproxen on Immune Responses in a Colchicine-Induced Rat Model of Alzheimer's Disease.", annotationSpecies:["10116"], pmid:"24662962", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24662962"}}, {start: {_id:1998}, end: {_id:4260}, properties:{evidence:"The participation of the immune system in the neurodegeneration in a rat model of colchicine-induced AD has not been explored.", annotationSpecies:["10116"], annotationMeshdisease:["Plaque, Amyloid"], pmid:"24662962", citationType:"PubMed", citationRef:"24662962"}}, {start: {_id:1998}, end: {_id:4261}, properties:{evidence:"Methods: In the present study, hippocampal neurodegeneration along with reactive oxygen species (ROS), nitrite and TNF-Î± in the hippocampus and some systemic immune responses were measured after 15 and 21 days of intracerebroventricular colchicine injection in rats and again after oral administration of different doses of the anti- inflammatory drug naproxen in AD rats.", annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], pmid:"24662962", citationType:"PubMed", citationRef:"24662962"}}, {start: {_id:1998}, end: {_id:4272}, properties:{evidence:"Four weeks after rAAV2-IL-1beta transduction, we found significant reductions in 6E10 and Congo red staining of amyloid plaques that was confirmed by decreased levels of insoluble Abeta1-42 and Abeta1-40 in the inflamed hippocampus.", annotationSubgraph:["Interleukin signaling subgraph", "Amyloidogenic subgraph"], annotationMeshdisease:["Plaque, Amyloid"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24874542", citationType:"PubMed", citationRef:"24874542"}}, {start: {_id:1148}, end: {_id:2995}, properties:{evidence:"Although neuropeptides such as bradykinin (BK), somatostatin (Sst), and endothelin (ET) are known to be important mediators of inflammation in the periphery, evidence of a similar function in brain is scarce.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"20937084", citationType:"PubMed", citationRef:"20937084"}}, {start: {_id:1148}, end: {_id:4273}, properties:{evidence:"Although neuropeptides such as bradykinin (BK), somatostatin (Sst), and endothelin (ET) are known to be important mediators of inflammation in the periphery, evidence of a similar function in brain is scarce.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"20937084", citationType:"PubMed", citationRef:"20937084"}}, {start: {_id:2206}, end: {_id:2461}, properties:{evidence:"Montelukast, known as a cysteinyl leukotriene receptor 1 (CysLT1R) antagonist, is currently used for treatment of inflammatory diseases such as asthma.", annotationMeshdisease:["Asthma"], pmid:"24456746", citationType:"PubMed", citationRef:"24456746"}}, {start: {_id:1098}, end: {_id:4292}, properties:{evidence:"The PPARgamma agonist pioglitazone and a novel selective PPARÎ±/gamma modulator, DSP-8658, currently in clinical development for the treatment of type 2 diabetes, enhanced the microglial uptake of Abeta in a PPARgamma-dependent manner.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationConfidence:["Medium"], pmid:"23197723", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"23197723"}}, {start: {_id:2224}, end: {_id:4319}, properties:{evidence:"Nicardipine is a calcium channel blocker that has been widely used to control blood pressure in severe hypertension following events such as ischemic stroke, traumatic brain injury, and intracerebral hemorrhage.", annotationMeshdisease:["Cerebral Hemorrhage", "Brain Injuries", "Stroke", "Hypertension"], annotationMeshanatomy:["Brain", "Blood"], annotationConfidence:["High"], pmid:"24621589", citationType:"PubMed", citationRef:"24621589"}}, {start: {_id:2216}, end: {_id:4319}, properties:{evidence:"Nicardipine is a calcium channel blocker that has been widely used to control blood pressure in severe hypertension following events such as ischemic stroke, traumatic brain injury, and intracerebral hemorrhage.", annotationMeshdisease:["Cerebral Hemorrhage", "Brain Injuries", "Stroke", "Hypertension"], annotationMeshanatomy:["Brain", "Blood"], annotationConfidence:["High"], pmid:"24621589", citationType:"PubMed", citationRef:"24621589"}}, {start: {_id:2025}, end: {_id:4319}, properties:{evidence:"Nicardipine is a calcium channel blocker that has been widely used to control blood pressure in severe hypertension following events such as ischemic stroke, traumatic brain injury, and intracerebral hemorrhage.", annotationMeshdisease:["Cerebral Hemorrhage", "Brain Injuries", "Stroke", "Hypertension"], annotationMeshanatomy:["Brain", "Blood"], annotationConfidence:["High"], pmid:"24621589", citationType:"PubMed", citationRef:"24621589"}}, {start: {_id:1720}, end: {_id:4319}, properties:{evidence:"Nicardipine is a calcium channel blocker that has been widely used to control blood pressure in severe hypertension following events such as ischemic stroke, traumatic brain injury, and intracerebral hemorrhage.", annotationMeshdisease:["Cerebral Hemorrhage", "Brain Injuries", "Stroke", "Hypertension"], annotationMeshanatomy:["Brain", "Blood"], annotationConfidence:["High"], pmid:"24621589", citationType:"PubMed", citationRef:"24621589"}}, {start: {_id:27}, end: {_id:4327}, properties:{evidence:"These results indicated that rutin is a promising agent for AD treatment because of its antioxidant, anti-inflammatory, and reducing Abeta oligomer activities.", annotationSubgraph:["Interleukin signaling subgraph"], annotationConfidence:["High"], pmid:"24512768", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24512768"}}] AS row
