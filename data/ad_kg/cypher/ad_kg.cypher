_id:1567}, end: {_id:4310}, properties:{evidence:"However, little is known about the effects of norepinephrine on prostanoid synthesis.", annotationSubgraph:["Prostaglandin subgraph"], pmid:"20064241", citationType:"PubMed", citationRef:"20064241"}}, {start: {_id:4310}, end: {_id:1567}, properties:{evidence:"However, little is known about the effects of norepinephrine on prostanoid synthesis.", annotationSubgraph:["Prostaglandin subgraph"], pmid:"20064241", citationType:"PubMed", citationRef:"20064241"}}] AS row
