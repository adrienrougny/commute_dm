UNWIND [{start: {_id:604}, end: {_id:597}, properties:{evidence:"Acetylcholinesterase (AChE) is thought to play an important role during apoptotic process. Our results showed that H2O2 induced AChE activity, a functional marker in apoptotic process, increases in neuronal-like PC12 cells. Glutathione, which is involved in cellular redox homeostasis, inhibited the increase of AChE activity, suggesting that reactive oxygen species (ROS) play a key role in this process. Further investigation showed that the elevation of AChE was observed after the degradation of Akt, release of cytochrome c from mitochondria into the cytosol, and activation of caspase family members. When nerve growth factor (NGF) was present, with the maintenance of Akt level, the elevation of AChE, the cytochrome c diffusion, as well as apoptotic process were markedly attenuated in H2O2-treated PC12 cells", annotationSubgraph:["Acetylcholine signaling subgraph", "Akt subgraph"], annotationConfidence:["High"], pmid:"17213958", citationType:"PubMed", citationRef:"17213958"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTLY_INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:3}, end: {_id:90}, properties:{evidence:"The extracellular amyloid deposits in senile plaques also trigger reactive glial changes and neuroinflammation that can also contribute to neuronal loss through production of reactive oxygen species (ROS), NO, and proinflammatory cytokines such as TNF-a and IL-1Abeta.", annotationSubgraph:["Inflammatory response subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"15232608", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15232608"}}, {start: {_id:3}, end: {_id:181}, properties:{evidence:"Yet several studies have demonstrated that oligomeric Abeta affects the cellular cholesterol level, which in turn has a variety of effects on AD related pathologies, including modulation of tau phosphorylation, synapse formation and maintenance of its function, and the neurodegenerative process.", annotationSubgraph:["Cholesterol metabolism subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12668899", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12668899"}}, {start: {_id:181}, end: {_id:3}, properties:{evidence:"Apolipoprotein E is the main lipid carrier in the brain and the best- established risk factor for late-onset Alzheimer's disease. Intracellular cholesterol levels influence the generation of amyloid- beta peptides, the toxic species thought to be a primary cause of Alzheimer's disease. Finally, compounds that modulate cholesterol metabolism affect amyloid-beta generation.", annotationSubgraph:["Cholesterol metabolism subgraph", "Amyloidogenic subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"17495608", citationType:"PubMed", citationRef:"17495608"}}, {start: {_id:90}, end: {_id:3}, properties:{evidence:"Mononuclear phagocytes including monocytes and microglia are the principal cells involved, and they accumulate at perivascular sites of beta-amyloid (Abeta) deposition and in senile plaques", annotationSubgraph:["Complement system subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20205643", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"20205643"}}, {start: {_id:828}, end: {_id:3}, properties:{evidence:"Mononuclear phagocytes including monocytes and microglia are the principal cells involved, and they accumulate at perivascular sites of beta-amyloid (Abeta) deposition and in senile plaques", annotationSubgraph:["Complement system subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20205643", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"20205643"}}, {start: {_id:322}, end: {_id:93}, properties:{evidence:"The fact that mitochondria are the major generators and direct targets of reactive oxygen species led several investigators to foster the idea that oxidative stress and damage in mitochondria are contributory factors to several disorders including Alzheimer's disease and diabetes.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["High"], pmid:"17316694", citationType:"PubMed", citationRef:"17316694"}}, {start: {_id:181}, end: {_id:1664}, properties:{evidence:"Treatment of neurons with ApoB-containing LDL cholesterol increased endolysosome accumulation of cholesterol, enlarged endolysosomes, and elevated endolysosome pH. In addition, ApoB-containing LDL cholesterol increased endolysosome accumulation of BACE-1, enhanced BACE-1 activity, increased Abeta levels, increased levels of phosphorylated tau, and decreased levels of synaptophysin.", annotationSubgraph:["Low density lipoprotein subgraph"], annotationUserdefinedcellline:["primary neuron"], annotationConfidence:["High"], pmid:"22580286", citationType:"PubMed", citationRef:"22580286"}}, {start: {_id:1622}, end: {_id:1962}, properties:{evidence:"5-HT depletion decreased ACh-induced c-Fos immunoreactivity in the dentate gyrus.", annotationSubgraph:["Serotonergic subgraph"], annotationMeshanatomy:["Dentate Gyrus"], annotationConfidence:["High"], pmid:"16426583", citationType:"PubMed", citationRef:"16426583"}}, {start: {_id:2059}, end: {_id:2058}, properties:{evidence:"Caffeine based measures of CYP1A2 activity correlate with oral clearance of tacrine in patients with Alzheimer's disease.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["9606"], pmid:"9764962", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"9764962"}}, {start: {_id:181}, end: {_id:3}, properties:{evidence:"Intracellular cholesterol levels influence the generation of amyloid- beta peptides, the toxic species thought to be a primary cause of Alzheimer's disease.", annotationSubgraph:["Cholesterol metabolism subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17495608", citationType:"PubMed", citationRef:"17495608"}}, {start: {_id:181}, end: {_id:3}, properties:{evidence:"In addition, growing evidence suggests a role of cholesterol in Alzheimer disease pathology and Abeta generation.", annotationSubgraph:["Cholesterol metabolism subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18308724", citationType:"PubMed", citationRef:"18308724"}}, {start: {_id:181}, end: {_id:3}, properties:{evidence:"It has been suggested that cholesterol may pmodulate amyloid-beta (Abeta) formation, a causative factor of Alzheimer's disease (AD), by regulating distribution of the three key proteins in the pathogenesis of AD (beta-amyloid precursor protein (APP), beta-secretase (BACE1) and/or presenilin 1 (PS1)) within lipid rafts.", annotationSubgraph:["Cholesterol metabolism subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20138836", citationType:"PubMed", citationRef:"20138836"}}, {start: {_id:4132}, end: {_id:271}, properties:{evidence:"The expression of inflammatory mediators, TLR4 and NF-ÎºB and the activity of NF-ÎºB were measured. The results showed that Gen could attenuate the cytotoxicity and inflammatory damage induced by Abeta25-35.", annotationMeshanatomy:["Microglia"], annotationConfidence:["Medium"], pmid:"24290604", citationType:"PubMed", citationRef:"24290604"}}, {start: {_id:4146}, end: {_id:4145}, properties:{evidence:"The S1P/sphingosine ratio was 66% and 64% lower in Braak stage III/IV hippocampus (pâ€‰=â€‰0.010) and inferior temporal cortex (pâ€‰=â€‰0.014), respectively, compared to controls.", annotationSubgraph:["Sphingolipid metabolic subgraph"], annotationMeshanatomy:["Hippocampus"], pmid:"24456642", citationType:"PubMed", citationRef:"24456642"}}, {start: {_id:4154}, end: {_id:4156}, properties:{evidence:"In the present study, we have found that plasmalogens (Pls), which are glycerophospholipids containing vinyl ether linkage at sn-1 position, can protect the neuronal cell death upon serum deprivation.", annotationMeshanatomy:["Serum"], annotationConfidence:["High"], pmid:"24357806", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:4157}, end: {_id:4156}, properties:{evidence:"In the present study, we have found that plasmalogens (Pls), which are glycerophospholipids containing vinyl ether linkage at sn-1 position, can protect the neuronal cell death upon serum deprivation.", annotationMeshanatomy:["Serum"], annotationConfidence:["High"], pmid:"24357806", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:4154}, end: {_id:4157}, properties:{evidence:"In the present study, we have found that plasmalogens (Pls), which are glycerophospholipids containing vinyl ether linkage at sn-1 position, can protect the neuronal cell death upon serum deprivation.", annotationMeshanatomy:["Serum"], annotationConfidence:["High"], pmid:"24357806", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:4172}, end: 