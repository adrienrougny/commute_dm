UNWIND [{start: {_id:74}, end: {_id:64}, properties:{evidence:"Superoxide is converted to H2O2 by the activity of superoxide dismutases (SOD) and superoxide can also interact with nitric oxide (NO) to produce peroxynitrite (ONOO*)", annotationSubgraph:["Hydrogen peroxide subgraph", "Free radical formation subgraph"], annotationConfidence:["Very High"], pmid:"15295589", citationType:"PubMed", citationRef:"15295589"}}, {start: {_id:64}, end: {_id:84}, properties:{evidence:"An alternative pathway is shown on the right side of the figure whereby superoxide or hydrogen peroxide (H2O2) oxidize lipids such as prostaglandins forming F2a-isoprostanes. Both H2O2 and F2a-isoprostanes are known to accelerate Abeta aggregation", annotationSubgraph:["Hydrogen peroxide subgraph", "Free radical formation subgraph"], annotationConfidence:["Very High"], pmid:"15864339", citationType:"PubMed", citationRef:"15864339"}}] AS row
