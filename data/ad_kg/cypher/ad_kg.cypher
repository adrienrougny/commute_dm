UNWIND [{start: {_id:1189}, end: {_id:506}, properties:{evidence:"Furthermore, the effect of metformin on Abeta generation is mediated by transcriptional up-regulation of beta-secretase (BACE1), which results in an elevated protein level and increased enzymatic activity. Unlike insulin, metformin exerts no effect on Abeta degradation. In addition, we found that glucose deprivation and various tyrphostins, known inhibitors of insulin-like growth factors/insulin receptor tyrosine kinases, do not modulate the effect of metformin on Abeta. Finally, inhibition of AMP-activated protein kinase (AMPK) by the pharmacological inhibitor Compound C largely suppresses metformin's effect on Abeta generation and BACE1 transcription, suggesting an AMPK-dependent mechanism. Although insulin and metformin display opposing effects on Abeta generation, in combined use, metformin enhances insulin's effect in reducing Abeta levels", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph", "Insulin signal transduction"], annotationConfidence:["Medium"], pmid:"19237574", citationType:"PubMed", citationRef:"19237574"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:1841}, end: {_id:1846}, properties:{evidence:"We found a significant reduction of calyculin A-induced tau hyperphosphorylation at Ser198/199/202, Ser396, Ser404, Thr205, and Thr231 24 h after treatment with 20 Î¼g/ml berberine. Berberine also restored protein phosphates 2A activity and reversed glycogen synthase kinase-3beta (GSK-3beta) activation, as determined by phosphatase activity assay and GSK-3beta phosphorylation at Tyr216 and Ser9, respectively. Furthermore, berberine reversed both the increase of malondialdehyde and the decrease of superoxide dismutase activity induced by calyculin A, indicating its role in anti-oxidative stress.", annotationSubgraph:["Tau protein subgraph"], annotationConfidence:["High"], pmid:"21297267", citationType:"PubMed", citationRef:"21297267"}}, {start: {_id:182}, end: {_id:2924}, properties:{evidence:"In addition, we examine potential therapeutic strategies such as statins, flavonoids, and human umbilical cord blood transplantation, all of which have been shown to pmodulate CD40-CD40L interaction in mouse pmodels of AD.", annotationSubgraph:["Tumor necrosis factor subgraph"], pmid:"20205645", citationType:"PubMed", citationRef:"20205645"}}, {start: {_id:2929}, end: {_id:2924}, properties:{evidence:"In addition, we examine potential therapeutic strategies such as statins, flavonoids, and human umbilical cord blood transplantation, all of which have been shown to pmodulate CD40-CD40L interaction in mouse pmodels of AD.", annotationSubgraph:["Tumor necrosis factor subgraph"], pmid:"20205645", citationType:"PubMed", citationRef:"20205645"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:2666}, end: {_id:3}, properties:{evidence:"The findings suggest that in cells that express both apoE and APP, such as astrocytes and microglia, a functional apoE:APP interaction may occur which pmodulates APP processing and Abeta production", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["High"], pmid:"11523796", citationType:"PubMed", citationRef:"11523796"}}, {start: {_id:2665}, end: {_id:3}, properties:{evidence:"It appears that the efficiency of binding between each of three main apoE isoforms and Abeta correlates inversely with the risk of developing late-onset familial AD and may indicate possible involvement of apoE in the binding and clearance of Abeta in vivo.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"9265639", citationType:"PubMed", citationRef:"9265639"}}, {start: {_id:2777}, end: {_id:3}, properties:{evidence:"Here we report evidence that heparan sulfate (HS) interacts with beta- site APP-cleaving enzyme (BACE) 1 and regulates its cleavage of APP.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"14530380", citationType:"PubMed", citationRef:"14530380"}}, {start: {_id:321}, end: {_id:1554}, properties:{evidence:"By interacting with intracellular amyloid-beta, ERAB may therefore contribute to the neuronal dysfunction associated with Alzheimer's disease.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"9338779", citationType:"PubMed", citationRef:"9338779"}}, {start: {_id:1316}, end: {_id:4156}, properties:{evidence:"Furthermore, cellular signaling experiments showed that Pls enhanced phosphorylation of the phosphoinositide 3-kinase (PI3K)-dependent serine/threonine-specific protein kinase AKT and extracellular-signal- regulated kinases ERK1/2.", annotationMeshanatomy:["Serum"], annotationConfidence:["Medium"], pmid:"24357806", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:2124}, end: {_id:4188}, properties:{evidence:"Using the cerebral cortex of WT and TLR4-knockout mice with and without chronic ethanol treatment, we demonstrate that ethanol induces poly-ubiquitinated proteins accumulation and promotes immunoproteasome activation by inducing the expression of beta2i, beta5i and PA28Î±, although it decreases the 20S constitutive proteasome subunits (Î±2, beta5).", annotationSubgraph:["Toll like receptor subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Cerebral Cortex"], pmid:"24556681", citationType:"PubMed", citationRef:"24556681"}}, {start: {_id:4281}, end: {_id:2156}, properties:{evidence:"Rifampicin protects PC12 cells from rotenone-induced cytotoxicity by activating GRP78 via PERK-eIF2Î±-ATF4 pathway.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshanatomy:["PC12 Cells"], pmid:"24638036", annotationCellline:["PC12"], citationType:"PubMed", citationRef:"24638036"}}, {start: {_id:4281}, end: {_id:4283}, properties:{evidence:"Rifampicin protects PC12 cells from rotenone-induced cytotoxicity by activating GRP78 via PERK-eIF2Î±-ATF4 pathway.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshanatomy:["PC12 Cells"], pmid:"24638036", annotationCellline:["PC12"], citationType:"PubMed", citationRef:"24638036"}}, {start: {_id:4281}, end: {_id:2156}, properties:{evidence:"Taken together, our data suggested that rifampicin induced GRP78 via the PERK-eIF2Î±-ATF4 pathway to protect neurons against rotenone- induced cell damage.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshanatomy:["Neurons"], pmid:"24638036", citationType:"PubMed", citationRef:"24638036"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:92}, end: {_id:27}, properties:{evidence:"Neuroinflammation contributes to the pathogenesis of sporadic Alzheimer's disease (AD)", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["High"], pmid:"22493750", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22493750"}}, {start: {_id:27}, end: {_id:1982}, properties:{evidence:"Hippocampal neurons are vulnerable to injury induced by Alzheimer's disease.", annotationMeshdisease:["Wounds and Injuries"], annotationMeshanatomy:["Hippocampus", "Neurons"], pmid:"18687381", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18687381"}}, {start: {_id:2089}, end: {_id:27}, properties:{evidence:"Vascular risk factors such as hypertension and hypercholesterolemia during midlife increase the risk for Alzheimer's disease (AD).", annotationSubgraph:["Nitric oxide subgraph"], annotationMeshdisease:["Hypertension", "Hypercholesterolemia", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"12218642", citationType:"PubMed", citationRef:"12218642"}}, {start: {_id:1720}, end: {_id:27}, properties:{evidence:"Vascular risk factors such as hypertension and hypercholesterolemia during midlife increase the risk for Alzheimer's disease (AD).", annotationSubgraph:["Nitric oxide subgraph"], annotationMeshdisease:["Hypertension", "Hypercholesterolemia", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"12218642", citationType:"PubMed", citationRef:"12218642"}}, {start: {_id:27}, end: {_id:1882}, properties:{evidence:"One of the reasons for the increased susceptibility to infections in patients with Alzheimer disease may be enhanced apoptotic death of their peripheral leukocytes.", annotationSubgraph:["Interleukin signaling subgraph"], annotationSpecies:["9606"], annotationCell:["leukocyte"], pmid:"12218646", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12218646"}}, {start: {_id:27}, end: {_id:1882}, properties:{evidence:"The production of superoxide anions was increased only by monocytes from the elderly groups.The results suggest that although the impaired immune function in patients with Alzheimer's disease is related to the aging process, the significant low IL-2 production in these patients may play a role in their increased susceptibility to infections.", annotationSubgraph:["Interleukin signaling subgraph"], pmid:"11961364", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"11961364"}}, {start: {_id:4071}, end: {_id:27}, properties:{evidence:"Glial activation and increased inflammation characterize neuropathology in Alzheimer's disease (AD). The aim was to develop a model for studying phagocytosis of beta-amyloid (Abeta) peptide by human microglia and to test effects thereupon by immunomodulatory substances. Human CHME3 microglia showed intracellular Abeta(1-42) colocalized with lysosome-associated membrane protein-2, indicating phagocytosis. This was increased by interferon-gamma, and to a lesser degree with Protollin, a proteosome-based adjuvant. Secretion of brain-derived neurotrophic factor (BDNF) was decreased by Abeta(1-42) and by interferon-gamma and interleukin-1beta. These cytokines, but not Abeta(1-42), stimulated interleukin-6 release. Microglia which phagocytosed Abeta(1-42) exhibited a higher degree of expression of interleukin-1 receptor type I and inducible nitric oxide synthase. In conclusion, we show that human microglia are able to phagocytose Abeta(1-42) and that this is associated with expression of inflammatory markers. Abeta(1-42) and interferon-gamma decreased BDNF secretion suggesting a new neuropathological role for Abeta(1-42) and the inflammation accompanying AD.", annotationSubgraph:["Chaperone subgraph"], annotationMeshanatomy:["Microglia"], pmid:"20798889", citationType:"PubMed", citationRef:"20798889"}}, {start: {_id:1994}, end: {_id:27}, properties:{evidence:"Markers of DNA damage, particularly oxidative DNA damage, have been largely found in brain regions, peripheral tissues, and biological fluids of Alzheimer's disease (AD) patients.", annotationSubgraph:["Response DNA damage", "Epigenetic modification subgraph"], pmid:"19199873", citationType:"PubMed", citationRef:"19199873"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1878}, end: {_id:25}, properties:{evidence:"The outcomes of the clinical trials of the gamma-secretase inhibitor Semagacestat (LY-450139) and the gamma-secretase modulator (GSM) Tarenflurbil were disappointing, but may not represent the end of the gamma-secretase era. gamma-Secretase modulators, by definition, only block the gamma-secretase cleavage of amyloid-beta protein precursor (AbetaPP) to generate the longer, 42-residue amyloid-beta (Abeta42) without changing the production of total Abeta. The first generation GSMs were shown to block Abeta42 generation while increasing Abeta38. The non-steroidal anti-inflammatory drug, Tarenflurbil, binds to AbetaPP and shifts the cleavage site from Abeta42 to Abeta38", annotationSubgraph:["Inflammatory response subgraph", "Gamma secretase subgraph", "Non-amyloidogenic subgraph"], annotationDiseasestate:["Mild AD"], annotationConfidence:["Medium"], annotationFdastatus:["Phase 2"], pmid:"22710916", citationType:"PubMed", citationRef:"22710916"}}, {start: {_id:7}, end: {_id:1892}, properties:{evidence:"gamma-Secretase inhibitor believed to be associated with the inhibition of the cleavage of Notch, a transmembrane receptor involved in regulating cell-fate decisions.", annotationSubgraph:["Gamma secretase subgraph", "Notch signaling subgraph"], annotationDiseasestate:["Mild AD"], annotationConfidence:["High"], annotationFdastatus:["Phase 3"], pmid:"22087836", citationType:"PubMed", citationRef:"22087836"}}, {start: {_id:2277}, end: {_id:1105}, properties:{evidence:"Hence, mifepristone induces a novel C-terminal cleavage of APP that prevents it being cleaved by Î±- or beta-secretase, thereby precluding Abeta generation in the central nervous system; this cleavage and the production of the 17-kDa APP fragment was generated by a calcium- dependent cysteine protease.", annotationSubgraph:["Beta secretase subgraph"], annotationMeshanatomy:["Central Nervous System"], annotationConfidence:["High"], pmid:"23312564", citationType:"PubMed", citationRef:"23312564"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:982}, end: {_id:2252}, properties:{evidence:"Because Abeta is known to induce oxidative stress in astrocytes, we examined the effects of the antioxidants tempol and apocynin on astrocytic TSP-1 levels and release.", annotationSubgraph:["Cell adhesion subgraph", "Response to oxidative stress"], annotationMeshanatomy:["Astrocytes"], pmid:"23860027", citationType:"PubMed", citationRef:"23860027"}}] AS row
