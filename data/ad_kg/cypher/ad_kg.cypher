UNWIND [{start: {_id:2504}, end: {_id:2503}, properties:{}}, {start: {_id:2559}, end: {_id:2558}, properties:{}}, {start: {_id:3585}, end: {_id:895}, properties:{}}, {start: {_id:3710}, end: {_id:3709}, properties:{}}, {start: {_id:3712}, end: {_id:3711}, properties:{}}, {start: {_id:4700}, end: {_id:315}, properties:{}}] AS row
