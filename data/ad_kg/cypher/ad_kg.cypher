UNWIND [{start: {_id:130}, end: {_id:217}, properties:{evidence:"Cytoplasmic p21Cip1 has been reported to interact with stress- activated protein kinases and ASK1 kinase and to inhibit their catalytic activities, thus preventing apoptotic process.59,60 p21Cip1 has also been shown to inhibit activation of caspase 3 and to resist Fas-mediated cell death.61 In the human P301S tau mice, nerve cell death occurs through a nonapoptotic mechanism,41 suggesting a possible link with the cytoplasmic expression of p21Cip1.", annotationSubgraph:["Tumor necrosis factor subgraph", "Cyclin-CDK subgraph"], annotationConfidence:["High"], pmid:"16507903", citationType:"PubMed", citationRef:"16507903"}}, {start: {_id:2187}, end: {_id:91}, properties:{evidence:"New findings have also linked activation of the NRF2 system to anti- inflammatory effects via interactions with NF-ÎºB.", annotationSubgraph:["Inflammatory response subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["Medium"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:2187}, end: {_id:2188}, properties:{evidence:"We bring forward the hypothesis that inflammation via prolonged activation of key kinases (p38 and GSK-3beta) and activation of histone deacetylases gives rise to dysregulation of the NRF2 system in the brain, which contributes to oxidative stress and injury.", annotationSubgraph:["Inflammatory response subgraph", "Free radical formation subgraph"], annotationMeshdisease:["Inflammation", "Wounds and Injuries"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:2187}, end: {_id:982}, properties:{evidence:"We bring forward the hypothesis that inflammation via prolonged activation of key kinases (p38 and GSK-3beta) and activation of histone deacetylases gives rise to dysregulation of the NRF2 system in the brain, which contributes to oxidative stress and injury.", annotationSubgraph:["Inflammatory response subgraph", "Free radical formation subgraph"], annotationMeshdisease:["Inflammation", "Wounds and Injuries"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:2211}, end: {_id:2071}, properties:{evidence:"In neuronal cells, MMP-3 expression is increased in response to cell stress, and the cleaved, active MMP-3 participates in apoptotic signaling.", annotationSubgraph:["Matrix metalloproteinase subgraph"], annotationMeshanatomy:["Neurons"], pmid:"21044079", citationType:"PubMed", citationRef:"21044079"}}, {start: {_id:2355}, end: {_id:1552}, properties:{evidence:"Although some studies support the role of protein kinase C (PKC) in amyloid precursor protein processing as well as in tau phosphorylation, a direct role for PKC in apoptotic neuronal death remains to be clarified.", annotationConfidence:["High"], pmid:"21707856", citationType:"PubMed", citationRef:"21707856"}}, {start: {_id:2384}, end: {_id:106}, properties:{evidence:"The proteolytic activation of PKCdelta plays a key role in promoting apoptotic cell death in various cell types, including neuronal cells.", annotationSubgraph:["Interferon signaling subgraph", "Response to oxidative stress", "Vascular endothelial growth factor subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"14580317", citationType:"PubMed", citationRef:"14580317"}}, {start: {_id:116}, end: {_id:106}, properties:{evidence:"Cyclin-dependent kinase 5 (Cdk5) activity is significantly increased in AD and contributes to all three hallmarks: neurotoxic amyloid-beta (Abeta), neurofibrillary tangles (NFT), and extensive cell death.", annotationSubgraph:["Amyloidogenic subgraph", "Cyclin-CDK subgraph"], annotationConfidence:["Medium"], pmid:"21389115", citationType:"PubMed", citationRef:"21389115"}}, {start: {_id:123}, end: {_id:98}, properties:{evidence:"Here, we show that cells overexpressing tau exhibit marked resistance to apoptosis induced by various apoptotic stimuli, which also causes correlated tau hyperphosphorylation and glycogen synthase kinase 3 (GSK-3) activation.", annotationSubgraph:["GSK3 subgraph"], annotationConfidence:["High"], pmid:"17360687", citationType:"PubMed", citationRef:"17360687"}}, {start: {_id:795}, end: {_id:1101}, properties:{evidence:"Abeta is widely accepted to be one of the major pathomechanisms underlying Alzheimer's disease (AD), although there is presently lively debate regarding the relative roles of particular species/forms of this peptide. Most recent evidence indicates that soluble oligomers rather than plaques are the major cause of synaptic dysfunction and ultimately neurodegeneration. Soluble oligomeric Abeta has been shown to interact with several proteins, for example glutamatergic receptors of the NMDA type and proteins responsible for maintaining glutamate homeostasis such as uptake and release. As NMDA receptors are critically involved in neuronal plasticity including learning and memory, we felt that it would be valuable to provide an up to date review of the evidence connecting Abeta to these receptors and related neuronal plasticity. Strong support for the clinical relevance of such interactions is provided by the NMDA receptor antagonist memantine. This substance is the only NMDA receptor antagonist used clinically in the treatment of AD and therefore offers an excellent tool to facilitate translational extrapolations from in vitro studies through in vivo animal experiments to its ultimate clinical utility", annotationSubgraph:["Low density lipoprotein subgraph"], annotationConfidence:["High"], pmid:"22646481", citationType:"PubMed", citationRef:" 22646481 "}}, {start: {_id:795}, end: {_id:668}, properties:{evidence:"The hippocampus, with its high density of glutamate receptors and in particular NMDA receptors, is known to be extremely important for some forms of learning and memory. Glutamatergic synapses can show pronounced plasticity in terms of the number and strength of individual synapses and are also characterized by their ability to express LTP Ã¢â‚¬â€œ a long-lasting strengthening of synaptic transmission", annotationSubgraph:["Low density lipoprotein subgraph"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"22646481", citationType:"PubMed", citationRef:" 22646481 "}}, {start: {_id:795}, end: {_id:1101}, properties:{evidence:"The hippocampus, with its high density of glutamate receptors and in particular NMDA receptors, is known to be extremely important for some forms of learning and memory. Glutamatergic synapses can show pronounced plasticity in terms of the number and strength of individual synapses and are also characterized by their ability to express LTP Ã¢â‚¬â€œ a long-lasting strengthening of synaptic transmission", annotationSubgraph:["Low density lipoprotein subgraph"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"22646481", citationType:"PubMed", citationRef:" 22646481 "}}, {start: {_id:795}, end: {_id:1156}, properties:{evidence:"The hippocampus, with its high density of glutamate receptors and in particular NMDA receptors, is known to be extremely important for some forms of learning and memory. Glutamatergic synapses can show pronounced plasticity in terms of the number and strength of individual synapses and are also characterized by their ability to express LTP Ã¢â‚¬â€œ a long-lasting strengthening of synaptic transmission", annotationSubgraph:["Low density lipoprotein subgraph"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"22646481", citationType:"PubMed", citationRef:" 22646481 "}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:708}, end: {_id:27}, properties:{evidence:"Binding to lipid and heparan sulfate proteoglycans (HSPG) induces apoE to adopt active conformations for binding to low-density lipoprotein receptor (LDLR) family. ApoE also interacts with beta amyloid peptide, manifests critical isoform-specific effects on Alzheimer's disease.", annotationSubgraph:["Low density lipoprotein subgraph", "APOE subgraph"], annotationConfidence:["High"], pmid:"21873229", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21873229"}}, {start: {_id:772}, end: {_id:27}, properties:{evidence:"Hyperphosphorylated tau protein is the basic structural component of the neurofibrillary tangle, a histopathological hallmark of Alzheimer's disease. The formation of hyperphosphorylated tau protein may impair learning and the synaptic plasticity of neurons. Tau is a protein that is associated with and stabilizes microtubules; hyperphosphorylated tau protein is unable to perform this stabilization function.", annotationSubgraph:["Tau protein subgraph"], annotationConfidence:["High"], pmid:"16504486", citationType:"PubMed", citationRef:"16504486"}}, {start: {_id:1551}, end: {_id:1098}, properties:{evidence:"We have recently identified in vitro a high affinity interaction between beta-amyloid peptide (Abeta) of AD and islet amyloid polypeptide (IAPP) of T2D which results in the formation of non- fibrillar and non-cytotoxic Abeta-IAPP hetero-oligomers.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"23713771", citationType:"PubMed", citationRef:"23713771"}}, {start: {_id:1551}, end: {_id:27}, properties:{evidence:"We have recently identified in vitro a high affinity interaction between beta-amyloid peptide (Abeta) of AD and islet amyloid polypeptide (IAPP) of T2D which results in the formation of non- fibrillar and non-cytotoxic Abeta-IAPP hetero-oligomers.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"23713771", citationType:"PubMed", citationRef:"23713771"}}, {start: {_id:1555}, end: {_id:27}, properties:{evidence:"The catalytic domain of insulin-degrading enzyme forms a denaturant- resistant complex with amyloid beta peptide: implications for Alzheimer disease pathogenesis.", annotationSubgraph:["Insulin signal transduction", "Non-amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"18411275", citationType:"PubMed", citationRef:"18411275"}}, {start: {_id:1656}, end: {_id:27}, properties:{evidence:"The interaction of Cu(2+) with the first 16 residues of the Alzheimer's amyliod beta peptide, Abeta(1-16), and human serum albumin (HSA) were studied in vitro by isothermal titration calorimetry at pH 7.2 and 310â€‰K in aqueous solution. The solvation parameters recovered from the extended solvation model indicate that HSA is involved in the transport of copper ion. Complexes between Abeta(1-16) and copper ions have been proposed to be an aberrant interaction in the development of Alzheimer's disease, where Cu(2+) is involved in Abeta(1-16) aggregation. The indexes of stability indicate that HSA removed Cu(2+) from Abeta(1-16), rapidly, decreased Cu-induced aggregation of Abeta(1-16), and reduced the toxicity of Abeta(1-16) + Cu(2+) significantly.", annotationSubgraph:["Amyloidogenic subgraph", "Albumin subgraph"], annotationConfidence:["High"], pmid:"22844264", citationType:"PubMed", citationRef:"22844264"}}, {start: {_id:2198}, end: {_id:260}, properties:{evidence:"Fas and Fas ligand are associated with neuritic degeneration in the AD brain and participate in beta-amyloid-induced neuronal death.", annotationSubgraph:["Tumor necrosis factor subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"12742739", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12742739"}}, {start: {_id:2198}, end: {_id:260}, properties:{evidence:"These findings suggest that Fas-FasL interactions may contribute to mechanisms of neuronal loss and neuritic degeneration in AD.", annotationSubgraph:["Tumor necrosis factor subgraph"], annotationConfidence:["High"], pmid:"12742739", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12742739"}}, {start: {_id:2226}, end: {_id:1998}, properties:{evidence:"Furthermore, elevated amounts of tissue plasminogen activator- neuroserpin complexes are seen in the Alzheimer brain, and immunohistochemical studies demonstrate that both tissue plasminogen activator and neuroserpin are associated with amyloid-beta plaques in Alzheimer brain tissue.", annotationSpecies:["9606"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"19222708", citationType:"PubMed", citationRef:"19222708"}}, {start: {_id:2306}, end: {_id:27}, properties:{evidence:"Recent data suggest that functional inactivation of TSC proteins might also be involved in the development of other diseases not associated with TSC, such as sporadic bladder cancer, breast cancer, ovarian carcinoma, gall bladder carcinoma, non-small-cell carcinoma of the lung, and Alzheimer's disease.", annotationSubgraph:["Cyclin-CDK subgraph"], annotationMeshdisease:["Carcinoma, Non-Small-Cell Lung", "Urinary Bladder Neoplasms", "Tuberous Sclerosis", "Breast Neoplasms", "Carcinoma", "Alzheimer Disease"], pmid:"16713332", citationType:"PubMed", citationRef:"16713332"}}, {start: {_id:8}, end: {_id:27}, properties:{evidence:"We previously showed that some familial Alzheimer's disease PS mutations cause increased basal and acetylcholine muscarinic receptor- stimulated phospholipase C (PLC) activity which was gamma-secretase dependent.", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], pmid:"17437536", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17437536"}}, {start: {_id:2665}, end: {_id:27}, properties:{evidence:"Role of apoe/Abeta interactions in the pathogenesis of Alzheimer's disease and cerebral amyloid angiopathy.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"11816788", citationType:"PubMed", citationRef:"11816788"}}, {start: {_id:2665}, end: {_id:27}, properties:{evidence:"Different apoE isoforms may alter AD pathogenesis via their interactions with the amyloid beta-peptide (Abeta).", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"16207708", citationType:"PubMed", citationRef:"16207708"}}, {start: {_id:2666}, end: {_id:27}, properties:{evidence:"APOE interacts with APP in human Alzheimer's brain", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"21297948", citationType:"PubMed", citationRef:"21297948"}}, {start: {_id:2665}, end: {_id:27}, properties:{evidence:"Apolipoprotein E binds avidly to beta amyloid (A beta) peptide, a major component of senile plaque of Alzheimer's disease, in an isoform-specific manner.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"8040342", citationType:"PubMed", citationRef:"8040342"}}, {start: {_id:2665}, end: {_id:27}, properties:{evidence:"It appears that the efficiency of binding between each of three main apoE isoforms and Abeta correlates inversely with the risk of developing late-onset familial AD and may indicate possible involvement of apoE in the binding and clearance of Abeta in vivo.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"9265639", citationType:"PubMed", citationRef:"9265639"}}, {start: {_id:2665}, end: {_id:27}, properties:{evidence:"Role of apoE/Abeta interactions in Alzheimer's disease: insights from transgenic mouse pmodels.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"11840304", citationType:"PubMed", citationRef:"11840304"}}, {start: {_id:2665}, end: {_id:27}, properties:{evidence:"We will continue to investigate the effect of apoE isoform and Abeta conformation on the structural and functional interactions between these two proteins in relation to the pathogenesis of AD.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"15181252", citationType:"PubMed", citationRef:"15181252"}}, {start: {_id:2665}, end: {_id:1998}, properties:{evidence:"These findings suggest that the interaction of ApoE with tau and amyloid-beta proteins in AD could play a important role in the formation of NFT and SP, respectively, contributing to the pathogenesis of AD.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"7695621", citationType:"PubMed", citationRef:"7695621"}}, {start: {_id:2665}, end: {_id:27}, properties:{evidence:"How apoE is involved in the pathogenesis of AD is unclear; however, evidence exists for a direct apoE/A beta interaction", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"8631862", citationType:"PubMed", citationRef:"8631862"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:2665}, end: {_id:27}, properties:{evidence:"To explore whether the genetic linkage between apolipoprotein E (ApoE) alleles and susceptibility to Alzheimer's disease might be attributable to a direct molecular interaction between ApoE and the amyloid peptide A beta, we have produced ApoE variants in Escherichia coli and studied their interactions with A beta under native conditions.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"8679539", citationType:"PubMed", citationRef:"8679539"}}, {start: {_id:2897}, end: {_id:27}, properties:{evidence:"Fetal Alz-50 clone 1 (FAC1) protein interacts with the Myc-associated zinc finger protein (ZF87/MAZ) and alters its transcriptional activity.", pmid:"10727212", citationType:"PubMed", citationRef:"10727212"}}, {start: {_id:2920}, end: {_id:27}, properties:{evidence:"Colocalization of cyclin C and its preferred binding partner, Cdk8, was only observed in astrocytes but not in neurons.", annotationSubgraph:["Cyclin-CDK subgraph"], pmid:"12600719", citationType:"PubMed", citationRef:"12600719"}}, {start: {_id:3010}, end: {_id:27}, properties:{evidence:"The EF-hand calcium binding protein Calmyrin (also called CIB-1) was shown to interact with presenilin-2 (PS-2), suggesting that this interaction might play a role in the pathogenesis of Alzheimer's disease (AD).", annotationSubgraph:["Gamma secretase subgraph"], pmid:"15885068", citationType:"PubMed", citationRef:"15885068"}}, {start: {_id:3010}, end: {_id:27}, properties:{evidence:"The interaction between the EF-hand Ca(2+)-binding protein calmyrin and presenilin 2 (PS2) has been suggested to play a role in Alzheimer's disease (AD).", pmid:"16257512", citationType:"PubMed", citationRef:"16257512"}}, {start: {_id:924}, end: {_id:27}, properties:{evidence:"These findings raise the intriguing possibility that PS1-beta-catenin interactions and subsequent activities may be consequential for the pathogenesis of AD.", annotationSubgraph:["Gamma secretase subgraph"], annotationConfidence:["High"], pmid:"10341227", citationType:"PubMed", citationRef:"10341227"}}, {start: {_id:3060}, end: {_id:27}, properties:{evidence:"It's possible that dUTPase is one of the proteins interacting with GIF in Alzheimer's disease human brain extracts.", pmid:"15468912", citationType:"PubMed", citationRef:"15468912"}}, {start: {_id:2759}, end: {_id:27}, properties:{evidence:"vitro studies and mouse pmodels of AD suggest that PrP may be involved in AD pathogenesis through a highly specific interaction with amyloidbeta (Abeta42) oligomers.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21393248", citationType:"PubMed", citationRef:"21393248"}}, {start: {_id:3232}, end: {_id:27}, properties:{evidence:"Thus, the interaction between PS1 and APP is central to the molecular mechanism of AD.", annotationSubgraph:["Gamma secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"11489281", citationType:"PubMed", citationRef:"11489281"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:372}, end: {_id:379}, properties:{evidence:"Besides their involvement in Abeta formation, PSs regulate the cleavage of other signaling receptors and transducers such as Notch-1, ErbB4, DC44, and LDL-receptor-related proteins and cadherins. PSs also affect different other signaling molecules, such as wingless-type MMTV integration site family (Wnt) signal transduction pathway, which is evolutionary conserved and controls many events during the embryogenesis . At cellular level, this pathway regulates morphology, proliferation, and motility of the cell. Wnt signaling pathway plays a central role during tumorigenesis, and the inappropriate activation of this pathway has been observed in several human cancers. It has been shown that Wnt-ligand-mediated signaling leads to the accumulation of cytosolic beta-catenin. Cytosolic beta-catenin will then translocate into the nucleus to bind to members of the T-cell factor (Tcf)/lymphoid-enhancing factor (Lef) family of DNA-binding proteins leading to the transcription of Wnt target genes.", annotationSubgraph:["Cell adhesion subgraph", "Gamma secretase subgraph"], annotationConfidence:["Medium"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:589}, end: {_id:9}, properties:{evidence:"Mutations in presenilin2 (PS2), a homolog of PS1, are also associated with FAD. While the precise mechanism on how these mutations cause AD is unknown, multiple theories have arisen to explain the role of PS1 and PS2 mutations on AD pathogenesis. These mutations lead to abnormal function of gamma- secretase, the beta-catenin pathway, calcium homoeostasis and the lysosomal/autophagy pathway as well as chaperones. Among these hypotheses, the effect of PS mutations on gamma-secretase has been extensively investigated. gamma-Secretase is composed of at least four subunits: PS, Nicastrin, Aph1 and Pen2; with a total of 19 putative transmembrane domains.", annotationSubgraph:["Gamma secretase subgraph"], annotationConfidence:["Medium"], pmid:"22461631", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22461631"}}, {start: {_id:906}, end: {_id:908}, properties:{evidence:"Reverse signaling through the ephrinB ligands is important for several morphogenetic events, such as axon guidance, neuronal plasticity, spine maturation, and synaptogenesis. Signaling is initiated by binding of EphB receptors to ephrinB ligands, stimulating their tyrosine phosphorylation via an unclear mechanism. Here we show that this mechanism involves presenilin1 (PS1)/gamma-secretase regulation of phosphoprotein associated with glycosphingolipid-enriched microdomains/Csk binding protein (PAG/Cbp), an adaptor protein that controls the activity of Src kinases.Using immunoprecipitation and Western blot of mouse primary neuronal and human embryonic kidney (HEK293) cell extracts overexpressing PAG/Cbp, we show that EphB2 induces tyrosine dephosphorylation of PAG/Cbp in a gamma-secretase- dependent manner. In these cells, PAG/Cbp dephosphorylation is promoted by the PS1/gamma-secretase-produced fragment of ephrinB2 cleavage (ephrinB2/CTF2), which forms complexes with PAG/Cbp when introduced exogenously. EphB2-induced tyrosine phosphorylation of ephrinB2 depends on PAG/Cbp because EphB2 cannot increase ephrinB2 phosphorylation in cells treated with anti-PAG siRNA or in PAG/Cbp- knockout (KO) cells. Furthermore, in contrast to WT PS1, familial Alzheimer disease (FAD) PS1 mutants expressed in PS1-KO mouse embryonic fibroblasts inhibited both the EphB2-induced dephosphorylation of PAG/Cbp and the phosphorylation of ephrinB2. PS1 FAD mutations may thus inhibit the function of ephrinB in the brain, promoting neurodegeneration in Alzheimer disease.", annotationSubgraph:["Gamma secretase subgraph", "Cell cycle subgraph"], pmid:"21746865", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21746865"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:206}, end: {_id:64}, properties:{evidence:"AChE activity was reported to be enhanced by low concentrations of H2O2. explanation is that mitochondrial efflux H2O2 modifies membrane structure through lipid peroxidation, and therefore contributes to modify the activity of the membrane-bound protein AChE [31]. AChE is synthesized as an inactive precursor and then matures into an active subunit in the endoplasmic reticulum [32]. Thus, the other explanation was that AChE could be exposed to cytoplasm when endoplasmic reticulum was destroyed by H2O2. At least one protein kinase (protein kinase A , PKA), was reported to increase the AChE activity by phosphorylation at non-consensus sites of this enzyme [33]. The apoptotic stimuli also enhanced the mRNA and protein levels of AChE in cells without background AChE expression, which were mediated by calcium signalling or the c-Jun kinase pathway", annotationSubgraph:["Acetylcholine signaling subgraph", "Hydrogen peroxide subgraph"], annotationConfidence:["Low"], pmid:"17213958", citationType:"PubMed", citationRef:"17213958"}}, {start: {_id:1113}, end: {_id:3}, properties:{evidence:"As far as the metabolism of amyloid precursor protein (APP) in late- onset sporadic Alzheimer disease is concerned, neuronal insulin receptor dysfunction may result in the intracellular accumulation of Abeta and in subsequent cellular damage.", annotationSubgraph:["Insulin signal transduction", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15094078", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15094078"}}, {start: {_id:4454}, end: {_id:4107}, properties:{evidence:"It has been proposed that an accumulation of oxo8dG in the AD brain might be a result of a decrease in the activity of Ogg1,", annotationSubgraph:["Reactive oxygen species subgraph"], annotationSpecies:["10116"], annotationConfidence:["High"], annotationDevelopmentalPhaseOfPatient:["Old"], pmid:"16484331", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"16484331"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:28}, end: {_id:3}, properties:{evidence:"Here, we show that siRNA-mediated loss of calsyntenin-1 in cultured neurons alters APP processing to increase production of Abeta. We also show that calsyntenin-1 is reduced in Alzheimer's disease brains and that the extent of this reduction correlates with increased Abeta levels.", annotationSubgraph:["Amyloidogenic subgraph", "Axonal transport subgraph", "Calsyntenin subgraph"], annotationTextlocation:["Abstract"], annotationConfidence:["Very High"], annotationDisease:["Alzheimer's disease"], pmid:"15491160", citationType:"PubMed", citationRef:"15491160"}}, {start: {_id:6}, end: {_id:75}, properties:{evidence:"Abeta can also cause mitochondrial oxidative stress and dysregulation of Ca2+ homeostasis resulting in impairment of the electron transport chain (ETC), increased production of superoxide anion radical. and decreased production of ATP.", annotationSubgraph:["Electron transport chain", "Amyloidogenic subgraph", "Free radical formation subgraph"], annotationConfidence:["High"], pmid:"15295589", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15295589"}}, {start: {_id:22}, end: {_id:75}, properties:{evidence:"Abeta can also cause mitochondrial oxidative stress and dysregulation of Ca2+ homeostasis resulting in impairment of the electron transport chain (ETC), increased production of superoxide anion radical. and decreased production of ATP.", annotationSubgraph:["Electron transport chain", "Amyloidogenic subgraph", "Free radical formation subgraph"], annotationConfidence:["High"], pmid:"15295589", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15295589"}}, {start: {_id:139}, end: {_id:3}, properties:{evidence:"Humanin (HN) is a short neuroprotective peptide abolishing Abeta neurotoxicity.", annotationSubgraph:["Neuroprotection subgraph"], annotationConfidence:["Very High"], pmid:"18813209", citationType:"PubMed", citationRef:"18813209"}}, {start: {_id:22}, end: {_id:75}, properties:{annotationCellstructure:["Mitochondria"], evidence:"APP and amyloid-beta may block mitochondrial translocation of nuclear- encoded proteins, such as components of the electron transport chain, impairing mitochondrial function. Intramitochondrial amyloid-beta is able to perturb mitochondrial function in several ways by directly influencing extracellular transport chain complex activities, impairing mitochondrial dynamics, or disturbing calcium storage, thus increasing apoptotic pathways. Moreover, amyloid-beta interacts with mitochondrial matrix components inducing an improper mitochondrial complex function leads to a decreased mitochondrial membrane potential of the organelle and impairing ATP formation.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"22523685", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22523685"}}, {start: {_id:6}, end: {_id:75}, properties:{annotationCellstructure:["Synapses"], evidence:"Amyloid-beta accumulation in the synapses directly disturbs mitochondrial function, causing oxidative stress, decreased ATP, and increased Ca2+ influx. Furthermore, the interaction of mitochondrial amyloid-beta with its binding proteins, such as ABAD and CypD, exacerbates amyloid-beta-induced mitochondria and neuronal stress and malfunction.", annotationSubgraph:["Reactive oxygen species subgraph", "Response to oxidative stress"], annotationConfidence:["Medium"], pmid:"22523685", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22523685"}}, {start: {_id:6}, end: {_id:963}, properties:{evidence:"Higher APP expression and elevated Abeta levels cause greater than required Cu export, leading to increased Cu in cerebrospinal fluid (CSF) and serum, and an intracellular (IC) Cu deficiency in the brain. Cu-deficient superoxide dismutase (SOD1) contributes to the reduced antioxidant capacity of the brain, allowing further oxidative stress.", annotationSubgraph:["Response to oxidative stress", "Amyloidogenic subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"15910549", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15910549"}}, {start: {_id:838}, end: {_id:3}, properties:{evidence:"Rosiglitazone is a TZD derivative that was recently observed to improve cognition in both APP transgenic mice and AD patients [Watson et al., 2005; Pedersen et al., 2006]. It activates PPARgamma leading to increased glucose disposal rates [Jung et al., 2005] and is also neuroprotective against Abeta neurotoxicity [Inestrosa et al., 2005]. Neuroprotection may result through modulation of Wnt signaling since an increase in beta-catenin and inhibition of GSK-3beta is observed upon exposure to rosiglitazone [Inestrosa et al., 2005], although a different study has shown that activation of PPARgamma by a potent ligand leads to beta-catenin degradation [Liu and Farmer 2004]. Nonetheless, in support of the role for PPARgamma activation in neuroprotection, PPARgamma agonists have potent anti-inflammatory effects [Luna-Medina et al., 2005], inhibit microglial activation [Bernardo et al., 2005; Heneka et al., 2005] and have been shown to improve verbal memory in AD patients with T2DM, possibly in a mechanism dependent on PPARgamma activation . A recent report demonstrates that overexpression of PPARgamma in cultured cells leads to a dramatic decrease in the production of Abeta, by increasing the rate of APP degradation via ubiquitination [D'Abramo et al., 2005]. This study also showed that by decreasing Abeta secretion, PPARgamma protects the cells against H2O2-mediated necrosis [D'Abramo et al., 2005].", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Non-amyloidogenic subgraph", "Ubiquitin degradation subgraph"], annotationConfidence:["Medium"], pmid:"19885299", citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:1241}, end: {_id:1225}, properties:{evidence:"One promising intervention is the use of the incretin hormone glucagon-like peptide-1 (GLP-1) as a treatment for neurodegenerative diseases [25] and [34]. GLP-1 enhances glucose-dependent insulin secretion and lowers blood glucose in subjects with T2DM [15]. Currently, the GLP-1 receptor agonist exenatide (Byetta) is approved for the treatment of T2DM, and many other GLP-1 analogues are in late stage clinical trials. GLP-1 also plays important roles in the brain. The GLP-1 receptor is expressed in neurons [19], and GLP-1 has growth factor-like properties and protects neurons from kainate-induced neurotoxicity [13] and [33], and of the effects of reduced NGF levels [3]. GLP-1 also reduces the induction of apoptosis of hippocampal neurons [13]", annotationSubgraph:["Glucagon subgraph", "Insulin signal transduction"], annotationMeshanatomy:["Blood"], annotationConfidence:["High"], pmid:"19573562", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"19573562"}}, {start: {_id:1401}, end: {_id:1400}, properties:{evidence:"Truncated phospholipids were essential elements of TNFalpha-induced apoptosis because overexpression of PAFAH2 (a phospholipase A(2) that selectively hydrolyzes truncated phospholipids) blocked TNFalpha- induced Az-PC accumulation without affecting phospholipid peroxidation. PAFAH2 also abolished apoptotic process. Thus, phospholipid oxidation and truncation to apoptotic phospholipids comprise an essential element connecting TNFalpha receptor signaling to mitochondrial damage and apoptotic death", annotationSubgraph:["Tumor necrosis factor subgraph"], annotationConfidence:["Medium"], pmid:"22433871", citationType:"PubMed", citationRef:"22433871"}}, {start: {_id:272}, end: {_id:1622}, properties:{evidence:"Hence, elevated butyrylcholinesterase and acetylcholinesterase concentrations will lead to a decrease in the levels of acetylcholine that could trigger the onset of low-grade systemic inflammation seen in type 2 diabetes and Alzheimer's disease.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationMeshdisease:["Diabetes Mellitus, Type 2", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"17553629", citationType:"PubMed", citationRef:"17553629"}}, {start: {_id:205}, end: {_id:1622}, properties:{evidence:"Hence, elevated butyrylcholinesterase and acetylcholinesterase concentrations will lead to a decrease in the levels of acetylcholine that could trigger the onset of low-grade systemic inflammation seen in type 2 diabetes and Alzheimer's disease.", annotationSubgraph:["Acetylcholine signaling subgraph"], annotationMeshdisease:["Diabetes Mellitus, Type 2", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"17553629", citationType:"PubMed", citationRef:"17553629"}}, {start: {_id:1241}, end: {_id:3}, properties:{evidence:"Pharmacological agents, such as dipeptidyl peptidase-4 (DPP-4) inhibitors, which increase the level of glucagon-like peptide-1 (GLP-1) and ameliorate T2D, have become valuable candidates as disease modifying agents in the treatment of AD. In addition, endogenous GLP-1 levels decrease amyloid beta (Abeta) peptide and tau phosphorylation in AD", annotationSubgraph:["Glucagon subgraph", "Tau protein subgraph", "Amyloidogenic subgraph", "Insulin signal transduction"], annotationConfidence:["Medium"], pmid:"23603201", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23603201"}}, {start: {_id:1691}, end: {_id:3}, properties:{evidence:"We have previously demonstrated that Leptin reduces extracellular amyloid beta (Abeta) protein both in vitro and in vivo, and intracellular tau phosphorylation in vitro. Further, we have shown that these effects are dependent on activation of AMP-activated protein kinase (AMPK) in vitro. Herein, we investigated downstream effectors of AMPK signaling directly linked to tau phosphorylation. One such target, of relevance to Alzheimer's disease (AD), may be GSK-3beta, which has been shown to be inactivated by Leptin. We therefore dissected the role of GSK-3beta in mediating Leptin's ability to reduce tau phosphorylation in neuronal cells. Our data suggest that Leptin regulates tau phosphorylation through a pathway involving both AMPK and GSK-3beta. This was based on the following: Leptin and the cell-permeable AMPK activator, 5-aminoimidazole-4-carboxyamide ribonucleoside (AICAR), reduced tau phosphorylation at AD-relevant sites similarly to the GSK-3beta inhibitor, lithium chloride (LiCl). Further, this reduction of tau phosphorylation was mimicked by the downregulation of GSK-3beta, achieved using siRNA technology and antagonized by the ectopic overexpression of GSK-3beta.", annotationSubgraph:["Non-amyloidogenic subgraph", "Leptin subgraph"], annotationConfidence:["High"], pmid:"19429119", citationType:"PubMed", citationRef:"19429119"}}, {start: {_id:6}, end: {_id:1732}, properties:{evidence:"Our results show that freshly solubilized Abeta1Ã¢â‚¬ 40 enhances the vasoconstriction induced by endothelin-1 (ET-1) and increases resistance to relaxation triggered by nitric oxide (NO), suggesting that Abeta may oppose the NO/cGMP pathway. Using specific inhibitors and activators of the NO/cGMP pathway, we show that Abeta vasoactivity is not due to a modulation of nitric oxide synthase (NOS) or soluble guanylyl cyclase (sGC). However, we find that a selective cGMP phosphodiesterase (cGMP-PDE) inhibitor (dipyridamole) is able to interactively block the enhanced vasoconstriction as well as the opposition to relaxation induced by Abeta, suggesting that Abeta could effect the activity of this enzyme. Cyclic GMP levels, but not cAMP concentrations, are reduced after Abeta treatment of rat aortic rings, further substantiating this hypothesis.", annotationSpecies:["10116"], annotationConfidence:["High"], pmid:"10222124", citationType:"PubMed", citationRef:"10222124"}}, {start: {_id:2020}, end: {_id:3}, properties:{evidence:"If this hydrolysis also occurs in the brain's extracellular matrix, the enzymatic action of gelatinase a could prevent the generation of amyloidogenic A beta 1-40(42).", annotationSubgraph:["Non-amyloidogenic subgraph", "Matrix metalloproteinase subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"7811262", citationType:"PubMed", citationRef:"7811262"}}, {start: {_id:2064}, end: {_id:3}, properties:{evidence:"Cells overexpressing Bcl-xL were significantly protected from beta- amyloid neurotoxicity and staurosporine-induced apoptosis compared to vector-transfected controls.", annotationSubgraph:["Amyloidogenic subgraph", "Bcl-2 subgraph"], annotationMeshdisease:["Wounds and Injuries"], annotationConfidence:["Medium"], pmid:"11226677", citationType:"PubMed", citationRef:"11226677"}}, {start: {_id:6}, end: {_id:2091}, properties:{evidence:"Concurrently, Abeta alters erythrocyte cell morphology, decreases nitrites and nitrates levels, and affects membrane acetylcholinesterase activity.", annotationSubgraph:["Nitric oxide subgraph"], annotationCell:["erythrocyte"], annotationConfidence:["High"], pmid:"22431227", citationType:"PubMed", citationRef:"22431227"}}, {start: {_id:6}, end: {_id:2092}, properties:{evidence:"Concurrently, Abeta alters erythrocyte cell morphology, decreases nitrites and nitrates levels, and affects membrane acetylcholinesterase activity.", annotationSubgraph:["Nitric oxide subgraph"], annotationCell:["erythrocyte"], annotationConfidence:["High"], pmid:"22431227", citationType:"PubMed", citationRef:"22431227"}}, {start: {_id:536}, end: {_id:3}, properties:{evidence:"First, Pin1 inhibits the production of Abeta, and enhances the activity of eNOS. Second, Abeta and eNOS form a mutual inhibition system. Third, the well-balanced feedback signaling loop avoids the development of AD, HTN, and CAA by inhibiting the frequent pathological characteristics of these diseases, including Abeta deposition in cerebral microvessels and cerebral microbleeds.", annotationSubgraph:["Non-amyloidogenic subgraph", "Nitric oxide subgraph"], annotationConfidence:["Medium"], pmid:"24332564", annotationAnatomy:["cerebral blood vessel"], citationType:"PubMed", citationRef:"24332564"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:2329}, end: {_id:43}, properties:{annotationCellstructure:["Cytosol"], evidence:"Trying to identify the mechanisms mediating XBP1s neuroprotection, we found that in PC12 cells treated with Abeta oligomers, XBP1s prevents the accumulation of free calcium (Ca(2+)) in the cytosol.", annotationSubgraph:["Unfolded protein response subgraph"], pmid:"21389082", citationType:"PubMed", citationRef:"21389082"}}, {start: {_id:2147}, end: {_id:3}, properties:{evidence:"These findings support the validity of increasing Abeta clearance via ABCB1 up-regulation as a therapeutic approach to slowing or halting the progression of AD.", annotationSubgraph:["ATP binding cassette transport subgraph", "Amyloidogenic subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"23181169", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23181169"}}, {start: {_id:2353}, end: {_id:3}, properties:{evidence:"This suggests that increased expression of uPA may initially serve as a protective mechanism leading to localized degradation and clearance of the pathogenic stimulus A beta.", annotationConfidence:["High"], pmid:"12754271", citationType:"PubMed", citationRef:"12754271"}}, {start: {_id:1658}, end: {_id:3}, properties:{evidence:"Human serum albumin (HSA) is a potent inhibitor of Abeta self- association and this novel, to our knowledge, function of HSA is of potential therapeutic interest for the treatment of Alzheimer's disease.", annotationSubgraph:["Non-amyloidogenic subgraph", "Albumin subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Serum"], annotationConfidence:["Medium"], pmid:"24094411", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24094411"}}, {start: {_id:1658}, end: {_id:2418}, properties:{evidence:"In serum-free medium, albumin (29 or 49 mg/ml) fully prevented the apoptotic effects of dotarizine, flunarizine and cyclopiazonic acid.", annotationSubgraph:["Apoptosis signaling subgraph", "Albumin subgraph"], annotationConfidence:["High"], pmid:"16153637", citationType:"PubMed", citationRef:"16153637"}}, {start: {_id:1658}, end: {_id:2419}, properties:{evidence:"In serum-free medium, albumin (29 or 49 mg/ml) fully prevented the apoptotic effects of dotarizine, flunarizine and cyclopiazonic acid.", annotationSubgraph:["Apoptosis signaling subgraph", "Albumin subgraph"], annotationConfidence:["High"], pmid:"16153637", citationType:"PubMed", citationRef:"16153637"}}, {start: {_id:1658}, end: {_id:2420}, properties:{evidence:"In serum-free medium, albumin (29 or 49 mg/ml) fully prevented the apoptotic effects of dotarizine, flunarizine and cyclopiazonic acid.", annotationSubgraph:["Apoptosis signaling subgraph", "Albumin subgraph"], annotationConfidence:["High"], pmid:"16153637", citationType:"PubMed", citationRef:"16153637"}}, {start: {_id:1477}, end: {_id:2448}, properties:{evidence:"Over-expression of hsp70 was found to reduce PQ-induced oxidative stress along with JNK and caspase-3 mediated dopaminergic neuronal cell death in exposed organism.", annotationSubgraph:["Electron transport chain", "Caspase subgraph", "Chaperone subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"24887138", citationType:"PubMed", citationRef:"24887138"}}, {start: {_id:1365}, end: {_id:3}, properties:{evidence:"alpha(2)-Macroglobulin (alpha(2)M) is an abundant plasma/extracellular space protein implicated in clearance of amyloid beta (Abeta)", annotationSubgraph:["Non-amyloidogenic subgraph", "Alpha 2 macroglobulin subgraph"], annotationConfidence:["Medium"], pmid:"14678766", citationType:"PubMed", citationRef:"14678766"}}, {start: {_id:1361}, end: {_id:271}, properties:{evidence:"ACE was found to significantly inhibit A beta aggregation in a dose response manner.", annotationSubgraph:["Renin-angiotensin subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11604391", citationType:"PubMed", citationRef:"11604391"}}, {start: {_id:796}, end: {_id:3}, properties:{evidence:"Our laboratory has previously shown that EGCG can increase non- amyloidogenic processing of APP through promotion of the beta- secretase ADAM10, which consequently reduced Abeta deposition and improved cognition in AD mice", annotationSubgraph:["ADAM Metallopeptidase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20849853", citationType:"PubMed", citationRef:"20849853"}}, {start: {_id:150}, end: {_id:1554}, properties:{evidence:"ApoE was not protective, but was injurious, as deletion of ApoE delayed the neurodegeneration caused by alpha-synuclein and suppressed the accumulation of Abeta.", annotationSubgraph:["Synuclein subgraph", "Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"18297066", citationType:"PubMed", citationRef:"18297066"}}, {start: {_id:174}, end: {_id:3}, properties:{evidence:"ApoE was not protective, but was injurious, as deletion of ApoE delayed the neurodegeneration caused by alpha-synuclein and suppressed the accumulation of Abeta.", annotationSubgraph:["Synuclein subgraph", "Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"18297066", citationType:"PubMed", citationRef:"18297066"}}, {start: {_id:174}, end: {_id:2722}, properties:{evidence:"Moreover, our recent studies further demonstrated that (1) apoE mediates sulfatide depletion in amyloid-beta precursor protein transgenic mice; (2) sulfatides enhance amyloid beta (Abeta) peptides binding to apoE-associated particles; (3) Abeta42 content notably correlates with sulfatide content in CSF;(4) sulfatides markedly enhance the uptake of Abeta peptides; and (5) abnormal sulfatide- facilitated Abeta uptake results in the accumulation of Abeta in lysosomes.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"20052565", citationType:"PubMed", citationRef:"20052565"}}, {start: {_id:2765}, end: {_id:3}, properties:{evidence:"We found that overexpression of endogenous calpain inhibitor calpastatin (CAST) under the control of the calcium/calpmodulin- dependent protein kinase II promoter in APP/PS1 mice caused a remarkable decrease of amyloid plaque burdens and prevented Tau phosphorylation and the loss of synapses.", annotationSubgraph:["Calpastatin-calpain subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20595388", citationType:"PubMed", citationRef:"20595388"}}, {start: {_id:630}, end: {_id:3}, properties:{evidence:"RNAi silencing of GGA3 also elevated levels of BACE and Abeta.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17553422", citationType:"PubMed", citationRef:"17553422"}}, {start: {_id:666}, end: {_id:3}, properties:{evidence:"In our opinion, albeit based on limited available data, a future potential therapeutic strategy is to mimic the mechanism by which the normal cellular form of the prion protein inhibits the beta-secretase beta-site amyloid precursor protein cleaving enzyme-1 (BACE1), and hence the production of Abeta.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18479216", citationType:"PubMed", citationRef:"18479216"}}, {start: {_id:1691}, end: {_id:3}, properties:{evidence:"Treatment with leptin reversed the 27-OHC-induced increase in Abeta and phosphorylated tau by decreasing the levels of BACE-1 and GSK-3beta respectively.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20157255", citationType:"PubMed", citationRef:"20157255"}}, {start: {_id:285}, end: {_id:3}, properties:{evidence:"We report here that (i) a single amino acid mutation at the Thr-668 residue of APP695, located 14 amino acids toward the amino-terminal end from the (682)YENPTY(687) motif, reduced the interaction between members of the Fe65 family of proteins and APP, whereas interaction of APP with the phosphotyrosine interaction domain of other APP binders such as X11-like and mammalian disabled-1 was not influenced by this mutation; (ii) the phosphorylation of APP at Thr-668 diminished the interaction of APP with Fe65 by causing a conformational change in the cytoplasmic domain that contains the Fe65-binding motif, YENPTY; and (iii) the expression of Fe65 slightly suppressed maturation of APP and decreased production of beta-amyloid (Abeta).", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11517218", citationType:"PubMed", citationRef:"11517218"}}, {start: {_id:450}, end: {_id:271}, properties:{evidence:"Furthermore, LDLR overexpression dramatically reduced A beta aggregation and enhanced A beta clearance from the brain extracellular space.", annotationSubgraph:["Non-amyloidogenic subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["Medium"], pmid:"20005821", citationType:"PubMed", citationRef:"20005821"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:174}, end: {_id:3434}, properties:{evidence:"Apolipoprotein E3 (apoE3) and apoE4 suppressed oligomeric Abeta- induced production of inducible nitric oxide synthase and cyclo- oxygenase-2, supporting an anti- inflammatory role for apoE.", annotationSubgraph:["APOE subgraph", "Nitric oxide subgraph"], annotationConfidence:["Medium"], pmid:"15181248", citationType:"PubMed", citationRef:"15181248"}}, {start: {_id:28}, end: {_id:3}, properties:{evidence:"Understanding the mechanisms that control processing of the amyloid precursor protein (APP) to produce amyloid-ÃƒÅ¸ (ABeta¸) peptide represents a key area of Alzheimer's disease research. We also show that calsyntenin-1 is reduced in Alzheimer's disease brains and that the extent of this reduction correlates with increased ABeta¸ levels. Calsyntenin-1 is a ligand for kinesin-1 light chains and APP is transported through axons on kinesin-1 molecular motors.", annotationSubgraph:["Amyloidogenic subgraph", "Calsyntenin subgraph"], annotationMeshanatomy:["Axons"], annotationConfidence:["Medium"], pmid:"22434822", citationType:"PubMed", citationRef:"22434822"}}, {start: {_id:1751}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:1752}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:1753}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:1754}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:463}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:462}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:1900}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:1901}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:1902}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:1903}, end: {_id:3694}, properties:{evidence:"Physiological levels of ABeta¸ also have trophic and neuroprotective actions in trophic deprived conditions [95]. Many ABeta¸ has a physiological role in normal synapse function. In organotypic hippocampal slices, BACE activity is increased by synaptic activity and the resulting ABeta¸ peptides depress excitatory transmission through a-amino-3-hydroxyl-5-methyl-4-isoxazole-propionate (AMPA) and N-methyl-D-aspartic acid (NMDA) receptors, suggesting a role for ABeta¸ in homeostatic plasticity [29]. ABeta¸ may have an important physiological role in synapse elimination during brain development", annotationSubgraph:["Glutamatergic subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:6}, end: {_id:3754}, properties:{evidence:"Antioxidant: The three histidine residues in ABeta¸ control the redox activity of iron, indicating that ABeta¸ is likely to be an important antioxidant. ABeta¸40 at 5 Ã‚ÂµM was found to protect primary neuronal cultures from the neurotoxicity of iron [94]. Nakamura et al. [177] found that ABeta¸40 or ABeta¸42 inhibits Fe3+ or Cu+2-catalyzed ascorbate oxidation and hydroxyl radical generation. Nanomolar concentrations of ABeta¸ can block neuronal apoptosis following oxidative damage, which suggests that ABeta¸ has a protective role against oxidative stress [178] and is essential for neuronal survival [28, 94]. Monomeric ABeta¸40 was found to protect neurons cultured in a medium containing 1.5 Ã‚ÂµM Fe2+ without antioxidant molecules. However, the antioxidant protection of monomeric ABeta¸40 depends on the type of oxidant used. ABeta¸40 inhibits cultured neurondeath caused by Cu2+, Fe2+, and Fe3+ but does not protect neurons against H2O2-induced damage [94]. In cerebral cortical neuronal cultures, monomeric ABeta¸40 inhibits the reduction of Fe3+ induced by vitamin C and the generation of superoxides and prevents lipid peroxidation induced by Fe2+ [94]. Moreover, monomeric forms of ABeta¸42 also exhibited antioxidant and neuroprotective effects. However, oligomeric or aggregated ABeta¸40 and ABeta¸42 were devoid of such antioxidant activity and their neuroprotective activity was demolished. Thus, depriving neurons of the protective activity of ABeta¸42 monomers may also be an important factor in neurodegeneration [97]. These findings provide novel insights on a normal antioxidant role of ABeta¸ and indicate that monomeric ABeta¸ protects neurons by quenching metal- inducible oxygen radical generation and thereby inhibits neurotoxicity.", annotationSubgraph:["Free radical formation subgraph", "Glutathione reductase subgraph"], annotationConfidence:["High"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:6}, end: {_id:327}, properties:{evidence:"Antioxidant: The three histidine residues in ABeta¸ control the redox activity of iron, indicating that ABeta¸ is likely to be an important antioxidant. ABeta¸40 at 5 Ã‚ÂµM was found to protect primary neuronal cultures from the neurotoxicity of iron [94]. Nakamura et al. [177] found that ABeta¸40 or ABeta¸42 inhibits Fe3+ or Cu+2-catalyzed ascorbate oxidation and hydroxyl radical generation. Nanomolar concentrations of ABeta¸ can block neuronal apoptosis following oxidative damage, which suggests that ABeta¸ has a protective role against oxidative stress [178] and is essential for neuronal survival [28, 94]. Monomeric ABeta¸40 was found to protect neurons cultured in a medium containing 1.5 Ã‚ÂµM Fe2+ without antioxidant molecules. However, the antioxidant protection of monomeric ABeta¸40 depends on the type of oxidant used. ABeta¸40 inhibits cultured neurondeath caused by Cu2+, Fe2+, and Fe3+ but does not protect neurons against H2O2-induced damage [94]. In cerebral cortical neuronal cultures, monomeric ABeta¸40 inhibits the reduction of Fe3+ induced by vitamin C and the generation of superoxides and prevents lipid peroxidation induced by Fe2+ [94]. Moreover, monomeric forms of ABeta¸42 also exhibited antioxidant and neuroprotective effects. However, oligomeric or aggregated ABeta¸40 and ABeta¸42 were devoid of such antioxidant activity and their neuroprotective activity was demolished. Thus, depriving neurons of the protective activity of ABeta¸42 monomers may also be an important factor in neurodegeneration [97]. These findings provide novel insights on a normal antioxidant role of ABeta¸ and indicate that monomeric ABeta¸ protects neurons by quenching metal- inducible oxygen radical generation and thereby inhibits neurotoxicity.", annotationSubgraph:["Free radical formation subgraph", "Glutathione reductase subgraph"], annotationConfidence:["High"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:748}, end: {_id:659}, properties:{evidence:"During early AD pathogenesis, amyloid beta (Abeta), S100B and IL-1beta could bring about a vicious cycle of Abeta/ generation between astrocytes and neurons leading to chronic, sustained and progressive neuroinflammation. In advanced/ stages of AD, TRAIL secreted from astrocytes have been shown to bind to death receptor 5 (DR5) on neurons to trigger / apoptotic process in a caspase-8-dependent manner. Furthermore, astrocytes could be reactivated by TGFbeta1 to generate more Abeta and / to undergo the aggravating astrogliosis. TGFbeta2 was also observed to cooperate with Abeta to cause neuronal demise by / destroying the stability of lysosomes in neurons.", annotationSubgraph:["TGF-Beta subgraph"], annotationConfidence:["Medium"], pmid:"21143158", citationType:"PubMed", citationRef:"21143158"}}, {start: {_id:838}, end: {_id:90}, properties:{evidence:"PPARgamma activation leads to the inhibition of microglial activation and the expression of a broad/ range of proinflammatory molecules", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationConfidence:["Medium"], pmid:"11755002", citationType:"PubMed", citationRef:"11755002"}}, {start: {_id:4234}, end: {_id:76}, properties:{evidence:"Further, Runx1t1 and HDACs were shown to promote neurotoxic effect of microglia by repressing expression of LAT2, L-aminoacid transporter-2 (cationic amino acid transporter, y+ system), which normally inhibits NO production.", annotationMeshanatomy:["Microglia"], annotationConfidence:["High"], pmid:"24586690", citationType:"PubMed", citationRef:"24586690"}}, {start: {_id:4280}, end: {_id:2156}, properties:{evidence:"Using RNA interference, we found that GRP78 gene knockdown significantly attenuated the neuroprotective effects of rifampicin.", annotationSubgraph:["Chaperone subgraph"], pmid:"24638036", citationType:"PubMed", citationRef:"24638036"}}, {start: {_id:838}, end: {_id:90}, properties:{evidence:"The peroxisome proliferator-activated receptor-gamma (PPAR-gamma) is a ligand-inducible transcription factor that suppresses microglial inflammatory responses and inhibits amyloid beta (Abeta) production through promoting cholesterol efflux from glial cells. PPAR-gamma agonists have been advanced as a new disease altering approach to Alzheimer's disease (AD), with rosiglitazone therapy having improved cognition in those AD patients that did not possess an Apolipoprotein E (APOE) ε4 allele", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationConfidence:["High"], pmid:"19660836", citationType:"PubMed", citationRef:"19660836"}}, {start: {_id:838}, end: {_id:3}, properties:{evidence:"PPARgamma activity decreases Abeta production by promoting harmless catabolism of amyloid precursor protein while blocking the up- regulatory impact of cytokines on beta-secretase expression.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16828233", citationType:"PubMed", citationRef:"16828233"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:4492}, end: {_id:4472}, properties:{evidence:"A common TC 776C>G polymorphism results in the replacement of proline with arginine (Pro259Arg) and negatively affects vitamin B12 metabolism, thus increasing plasma Hcy levels", annotationSubgraph:["Vitamin subgraph"], pmid:"21119889", citationType:"PubMed", citationRef:"21119889"}}, {start: {_id:4724}, end: {_id:4725}, properties:{evidence:"In disease state, LPS (lipoploysacharide) induces TLR4, which increases NFKB1 activities. NFKB1 increases MIR34A which targets TREM2, decreasing normal TREM2 and increases the mutant variant. Recent GWAS studies associated SNP rs75932628 with TREM2 in LOAD patients. Also there are studies suggesting the link of this TREM2 variant with certain clinical and neuroimaging AD features such as frontobasal gray atrophy. Moreover, in disease brain TREM2 forms complex with TYROBP which triggers immune responses through activating macrophages and dendritic cells which leads to chronic neuroinflammation.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Medium"], pmid:"25681350", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:2818}, end: {_id:3}, properties:{evidence:"Specifically, conditional loss of beta1-integrin prevented Abeta42O-induced Cofilin activation, and allosteric modulation or activation of beta1-integrin significantly reduced Abeta42O binding to neurons while blocking Abeta42O-induced reactive oxygen species (ROS) production, mitochondrial dysfunction, depletion of F-actin/focal Vinculin, and apoptotic process.", annotationSubgraph:["Amyloidogenic subgraph", "Regulation of actin cytoskeleton subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["Medium"], pmid:"25698445", citationType:"PubMed", citationRef:"25698445"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:3574}, end: {_id:535}, properties:{evidence:"Utilizing a novel microfluidic culture chamber, we demonstrate that Abeta oligomers compromise BDNF-mediated retrograde transport by impairing endosomal vesicle velocities, resulting in impaired downstream signaling driven by BDNF/TrkB, including ERK5 activation, and CREB-dependent gene regulation. Our data suggest that a key mechanism mediating the deficit involves ubiquitin C-terminal hydrolase L1 (UCH-L1), a deubiquitinating enzyme that functions to regulate cellular ubiquitin. Abeta-induced deficits in BDNF trafficking and signaling are mimicked by LDN (an inhibitor of UCH-L1) and can be reversed by increasing cellular UCH-L1 levels, demonstrated here using a transducible TAT-UCH-L1 strategy. Finally, our data reveal that UCH-L1 mRNA levels are decreased in the hippocampi of AD brains. Taken together, our data implicate that UCH-L1 is important for regulating neurotrophin receptor sorting to signaling endosomes and supporting retrograde transport. Further, our results support the idea that in AD, Abeta may down-regulate UCH-L1 in the AD brain, which in turn impairs BDNF/TrkB-mediated retrograde signaling, compromising synaptic plasticity and neuronal survival.", annotationSubgraph:["Nerve growth factor subgraph"], pmid:"23599427", citationType:"PubMed", citationRef:"23599427"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:677}, end: {_id:1034}, properties:{evidence:"Picalm is a key component of clathrin-dependent endocytosis. It recruits clathrin and adaptor protein 2 (AP-2) to the plasma membrane and, along with, AP-2 recognizes target proteins. The attached clathrin triskelions cause membrane deformation around the target proteins enclosing them within clathrin-coated vesicles to be processed in lysosomes or endosomes.The transport of Abeta across vessel walls and into the bloodstream is a major pathway of Abeta removal from the brain and picalm is ideally situated within endothelial cells to participate in this process", annotationSubgraph:["Endosomal lysosomal subgraph"], pmid:"20838239", citationType:"PubMed", citationRef:"20838239"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1180}, end: {_id:1184}, properties:{evidence:"Rosiglitazone is a TZD derivative that was recently observed to improve cognition in both APP transgenic mice and AD patients [Watson et al., 2005; Pedersen et al., 2006]. It activates PPARgamma leading to increased glucose disposal rates [Jung et al., 2005] and is also neuroprotective against Abeta neurotoxicity [Inestrosa et al., 2005]. Neuroprotection may result through modulation of Wnt signaling since an increase in beta-catenin and inhibition of GSK-3beta is observed upon exposure to rosiglitazone [Inestrosa et al., 2005], although a different study has shown that activation of PPARgamma by a potent ligand leads to beta-catenin degradation [Liu and Farmer 2004]. Nonetheless, in support of the role for PPARgamma activation in neuroprotection, PPARgamma agonists have potent anti-inflammatory effects [Luna-Medina et al., 2005], inhibit microglial activation [Bernardo et al., 2005; Heneka et al., 2005] and have been shown to improve verbal memory in AD patients with T2DM, possibly in a mechanism dependent on PPARgamma activation . A recent report demonstrates that overexpression of PPARgamma in cultured cells leads to a dramatic decrease in the production of Abeta, by increasing the rate of APP degradation via ubiquitination [D'Abramo et al., 2005]. This study also showed that by decreasing Abeta secretion, PPARgamma protects the cells against H2O2-mediated necrosis [D'Abramo et al., 2005].", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], annotationUserdefinedcellline:["App transgenic"], annotationConfidence:["High"], annotationDisease:["Alzheimer's disease"], pmid:"19885299", citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:3002}, end: {_id:123}, properties:{evidence:"We show that alsterpaullone is able to inhibit the in vivo phosphorylation of tau at AD-specific sites by GSK-3beta and the in vivo phosphorylation of DARPP-32 in isolated striatum slices by CDK5.", annotationSubgraph:["GSK3 subgraph", "Cyclin-CDK subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"10998059", citationType:"PubMed", citationRef:"10998059"}}, {start: {_id:3002}, end: {_id:117}, properties:{evidence:"We show that alsterpaullone is able to inhibit the in vivo phosphorylation of tau at AD-specific sites by GSK-3beta and the in vivo phosphorylation of DARPP-32 in isolated striatum slices by CDK5.", annotationSubgraph:["GSK3 subgraph", "Cyclin-CDK subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"10998059", citationType:"PubMed", citationRef:"10998059"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:123}, end: {_id:1342}, properties:{evidence:"In SHSY5Y cells, a human neuroblastoma cell line, as well as in primary cultu res of rat cortical neurons insulin administration leads to tau hyperphosphorylation (111-113]. In contrast, insulin and IGF- 1 administration in NT2N cells, cultured human neurons, decreases tau phosphorylation [114]. In primary cortical neuron cultures, M esk e et a/ . (115J found that insulin treatment causes a regulatory interaction between PP2A and GSK-3. Inhibition of Pl3-kinase leads to activat ion of GSK-3and PP2A. Enzyme activity of both enzymes al ways changed in the same direction. This balÂ­ anced response seemed to induce a steady state in tau phosÂ­ phorylation at GSK-3/PP2A-dependent sites (115]. Thus, on ly a dysbalance of insulin/IGF-1 regulated tau kinases and phosphatases might lead to tau hyperphosphorylation, partially explaining the different resu lts obtained under different conditions.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:1321}, end: {_id:1342}, properties:{evidence:"In SHSY5Y cells, a human neuroblastoma cell line, as well as in primary cultu res of rat cortical neurons insulin administration leads to tau hyperphosphorylation (111-113]. In contrast, insulin and IGF- 1 administration in NT2N cells, cultured human neurons, decreases tau phosphorylation [114]. In primary cortical neuron cultures, M esk e et a/ . (115J found that insulin treatment causes a regulatory interaction between PP2A and GSK-3. Inhibition of Pl3-kinase leads to activat ion of GSK-3and PP2A. Enzyme activity of both enzymes al ways changed in the same direction. This balÂ­ anced response seemed to induce a steady state in tau phosÂ­ phorylation at GSK-3/PP2A-dependent sites (115]. Thus, on ly a dysbalance of insulin/IGF-1 regulated tau kinases and phosphatases might lead to tau hyperphosphorylation, partially explaining the different resu lts obtained under different conditions.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:IS_A]->(end) SET r += row.properties;
UNWIND [{start: {_id:729}, end: {_id:3633}, properties:{evidence:"SORLA is proposed to act as a retention factor for APP in the TGN, preventing the release of precursor molecules into the processing pathways. Consequently, over-expression of SORLA in neurons prevents the targeting of APP from TGN to the cell surface and to endosomes and reduces the production of Abeta peptides [9-11]. The importance of SORLA for AD is further supported by low levels of receptor expression seen in patients suffering from the disease", annotationSubgraph:["Non-amyloidogenic subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["High"], pmid:"22727043", citationType:"PubMed", citationRef:"22727043"}}, {start: {_id:729}, end: {_id:994}, properties:{evidence:"SORLA is proposed to act as a retention factor for APP in the TGN, preventing the release of precursor molecules into the processing pathways. Consequently, over-expression of SORLA in neurons prevents the targeting of APP from TGN to the cell surface and to endosomes and reduces the production of Abeta peptides [9-11]. The importance of SORLA for AD is further supported by low levels of receptor expression seen in patients suffering from the disease", annotationSubgraph:["Non-amyloidogenic subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["High"], pmid:"22727043", citationType:"PubMed", citationRef:"22727043"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:155}, end: {_id:156}, properties:{evidence:"Normal cells respond to ER stress by increasing transcription of genes encoding ER-resident chaperones such as GRP78/BiP, GRP94 and protein disulfide isomerase to facilitate protein folding. This induction system is termed the unfolded protein response. Familial Alzheimer's disease-linked presenilin-1 (PS1) mutation downregulates the unfolded protein response and leads to vulnerability to ER stress.", annotationSubgraph:["Gamma secretase subgraph", "Unfolded protein response subgraph"], annotationConfidence:["Very High"], pmid:"11406343", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"11406343"}}, {start: {_id:155}, end: {_id:151}, properties:{evidence:"Normal cells respond to ER stress by increasing transcription of genes encoding ER-resident chaperones such as GRP78/BiP, GRP94 and protein disulfide isomerase to facilitate protein folding. This induction system is termed the unfolded protein response. Familial Alzheimer's disease-linked presenilin-1 (PS1) mutation downregulates the unfolded protein response and leads to vulnerability to ER stress.", annotationSubgraph:["Gamma secretase subgraph", "Unfolded protein response subgraph"], annotationConfidence:["Very High"], pmid:"11406343", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"11406343"}}, {start: {_id:155}, end: {_id:157}, properties:{evidence:"PS1 mutations cause abnormalities in ER calcium homoeostasis, enhancing the calcium responses to stimuli that activate IP3- and ryanodine-sensitive ER calcium pools.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "Gamma secretase subgraph"], annotationConfidence:["Very High"], pmid:"11447832", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"11447832"}}, {start: {_id:155}, end: {_id:158}, properties:{evidence:"PS1 mutations cause abnormalities in ER calcium homoeostasis, enhancing the calcium responses to stimuli that activate IP3- and ryanodine-sensitive ER calcium pools.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "Gamma secretase subgraph"], annotationConfidence:["Very High"], pmid:"11447832", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"11447832"}}, {start: {_id:845}, end: {_id:290}, properties:{evidence:"Nevertheless, the precise relationship between mitochondrial accumulation of APP and ApoE genotyping in the pathogenesis of AD subjects is not known. However, it is noteworthy to mention that recent studies have shown mutations on TOM40 gene, which is located on the chromosome (19q) in close proximity to upstream of ApoE, as a possible risk factor in the genesis of AD (118,119). Based on this, one can speculate that mutations on TOM40 gene may result in the dysfunction of general import pore TOM40 protein, which may in turn accentuate the mitochondrial translocational arrest of APP and associated mitochondrial dysfunction. However, it remains to be seen whether mutations render impairment of TOM40 functions during the pathogenesis of AD.", annotationSubgraph:["Mitochondrial translocation subgraph"], annotationConfidence:["High"], pmid:"19619643", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"19619643"}}, {start: {_id:587}, end: {_id:156}, properties:{evidence:"Alzheimer's disease (AD) is a chronic disorder that slowly destroys neurons and causes serious cognitive disability. AD is associated with senile plaques and neurofibrillary tangles (NFTs). Amyloid-beta (Abeta), a major component of senile plaques, has various pathological effects on cell and organelle function. The extracellular Abeta oligomers may activate caspases through activation of cell surface death receptors. Alternatively, intracellular Abeta may contribute to pathology by facilitating tau hyper-phosphorylation, disrupting mitochondria function, and triggering calcium dysfunction. To date genetic studies have revealed four genes that may be linked to autosomal dominant or familial early onset AD (FAD). These four genes include: amyloid precursor protein (APP), presenilin 1 (PS1), presenilin 2 (PS2) and apolipoprotein E (ApoE). All mutations associated with APP and PS proteins can lead to an increase in the production of Abeta peptides, specfically the more amyloidogenic form, Abeta42. FAD-linked PS1 mutation downregulates the unfolded protein response and leads to vulnerability to ER stress.", citationTitle:"Alzheimer's disease - Homo sapiens (human)", annotationSubgraph:["Gamma secretase subgraph", "Unfolded protein response subgraph"], annotationConfidence:["Medium"], citationType:"Online Resource", citationRef:"hsa05010"}}, {start: {_id:856}, end: {_id:91}, properties:{evidence:"the nuclear receptor peroxisome proliferator-activated receptor-gamma (PPARgamma) which acts to inhibit the expression of proinflammatory genes, this receptor appears a good candidate to mediate the observed anti-inflammatory effects", annotationSubgraph:["Inflammatory response subgraph", "Peroxisome proliferator activated receptor subgraph"], annotationConfidence:["Medium"], pmid:"15817521", citationType:"PubMed", citationRef:"15817521"}}, {start: {_id:4857}, end: {_id:855}, properties:{evidence:"A positive role of K63-linked ubiquitylation was recently uncovered by the identification of the DUB enzyme and tumor suppressor CYLD as a negative regulator of upstream Wnt/beta-catenin signaling.", annotationSubgraph:["Wnt signaling subgraph"], pmid:"20930545", citationType:"PubMed", citationRef:"20930545"}}, {start: {_id:4967}, end: {_id:193}, properties:{evidence:"More specifically, carriers of BamI and TaqI polymorphisms presented with worse cognitive functioning unlike carrier of the ApaI variant. Examination of ApaI and TaqI gene polymorphisms in 255 AD cases and 260 cognitively screened elderly controls revealed that the presence of each of these haplotypes was associated with the risk of AD.", annotationSubgraph:["Vitamin subgraph"], annotationConfidence:["High"], pmid:"27176073", citationType:"PubMed", citationRef:"27176073"}}, {start: {_id:4968}, end: {_id:193}, properties:{evidence:"More specifically, carriers of BamI and TaqI polymorphisms presented with worse cognitive functioning unlike carrier of the ApaI variant. Examination of ApaI and TaqI gene polymorphisms in 255 AD cases and 260 cognitively screened elderly controls revealed that the presence of each of these haplotypes was associated with the risk of AD.", annotationSubgraph:["Vitamin subgraph"], annotationConfidence:["High"], pmid:"27176073", citationType:"PubMed", citationRef:"27176073"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:179}, end: {_id:176}, properties:{evidence:"in addition to lipid transport mediated by apoE, cholesterol homeostasis in the brain is markedly altered in response to changes in the HMGR pathway; suggesting a possible explanation for the potentially beneficial effect of statins in common AD.", annotationSubgraph:["Cholesterol metabolism subgraph", "Lipid metabolism subgraph"], annotationConfidence:["Very High"], pmid:"15639314", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"15639314"}}, {start: {_id:460}, end: {_id:215}, properties:{annotationCellstructure:["Centrosome"], evidence:"ApoE was reported to induce Dab1 phosphorylation and ERK1/2 activation and JNK inhibition via LRPs. This pathway depends on the presence of Ca++ influx through the NMDA receptor, but it is independent of Dab1.Overall these data indicate a likely involvement of LRP8 as modulator of AbetaPP processing, by affecting its endocytic trafficking and the proportion of AbetaPP present in lipid rafts. These events may have consequence on the gamma-secretase-mediated cleavage of AbetaPP and on its neurodegeneration-related signaling activity.", annotationSubgraph:["Calcium-dependent signal transduction", "MAPK-ERK subgraph"], annotationConfidence:["Very High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:460}, end: {_id:457}, properties:{annotationCellstructure:["Centrosome"], evidence:"ApoE was reported to induce Dab1 phosphorylation and ERK1/2 activation and JNK inhibition via LRPs. This pathway depends on the presence of Ca++ influx through the NMDA receptor, but it is independent of Dab1.Overall these data indicate a likely involvement of LRP8 as modulator of AbetaPP processing, by affecting its endocytic trafficking and the proportion of AbetaPP present in lipid rafts. These events may have consequence on the gamma-secretase-mediated cleavage of AbetaPP and on its neurodegeneration-related signaling activity.", annotationSubgraph:["Calcium-dependent signal transduction", "JAK-STAT signaling subgraph"], annotationConfidence:["Very High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:658}, end: {_id:1321}, properties:{evidence:"CerebraiiR/IGF-1 signaling in APP metabolism. Binding of insulin and IGF-1 to their receptors leads to autophosphorylation of the -subunit of the IR/IGF-IR and recruitment of IRS-1 /-2. IRS proteins activate mainly two pathways, the PI3 kinase pathway, and the RAS-RAF-MAP kinase cascade. Tau phosphorylation via IR/IGF-1 signaling is influenced by GSK-3 and the tau phosphatase PP2A. InterÂ­ estingly, mTOR signaling couples the activity ofPP2A and GSK-3in a way that the activities of both enzymes change always in the same direction. suggesting that only a dysregulation of either PP2A or GSK-3induces tau hyperphosphorylation. The PI3K pathway as well as the RAS-RAF-MAPK cascade regulate different transcription factors involved in transcriptional regulation of metabolism and clearance of Â­ amyloid. APP is cleaved by a.-, -secretase (BACE-1) and y-secretase (presenilin). - and subsequent y-cleavage of APP leads to generation of -amyloid 1 -4o/ t-42â€¢ IGF-1 signaling promotes a switch lrom TrkA to p75NTR expression leading to increased -secretase activity due to an upregulation of BACE-1 expression. Recent data suggest that not only BACE-1 is int1uenced by IRIIGF- IR mediated signals but also a.Â­ secretase activity is stimulated by the PI3K pathway.", annotationSubgraph:["Tau protein subgraph", "mTOR signaling subgraph"], annotationConfidence:["Medium"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:658}, end: {_id:123}, properties:{evidence:"CerebraiiR/IGF-1 signaling in APP metabolism. Binding of insulin and IGF-1 to their receptors leads to autophosphorylation of the -subunit of the IR/IGF-IR and recruitment of IRS-1 /-2. IRS proteins activate mainly two pathways, the PI3 kinase pathway, and the RAS-RAF-MAP kinase cascade. Tau phosphorylation via IR/IGF-1 signaling is influenced by GSK-3 and the tau phosphatase PP2A. InterÂ­ estingly, mTOR signaling couples the activity ofPP2A and GSK-3in a way that the activities of both enzymes change always in the same direction. suggesting that only a dysregulation of either PP2A or GSK-3induces tau hyperphosphorylation. The PI3K pathway as well as the RAS-RAF-MAPK cascade regulate different transcription factors involved in transcriptional regulation of metabolism and clearance of Â­ amyloid. APP is cleaved by a.-, -secretase (BACE-1) and y-secretase (presenilin). - and subsequent y-cleavage of APP leads to generation of -amyloid 1 -4o/ t-42â€¢ IGF-1 signaling promotes a switch lrom TrkA to p75NTR expression leading to increased -secretase activity due to an upregulation of BACE-1 expression. Recent data suggest that not only BACE-1 is int1uenced by IRIIGF- IR mediated signals but also a.Â­ secretase activity is stimulated by the PI3K pathway.", annotationSubgraph:["GSK3 subgraph", "mTOR signaling subgraph"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:1322}, end: {_id:991}, properties:{evidence:"CerebraiiR/IGF-1 signaling in APP metabolism. Binding of insulin and IGF-1 to their receptors leads to autophosphorylation of the -subunit of the IR/IGF-IR and recruitment of IRS-1 /-2. IRS proteins activate mainly two pathways, the PI3 kinase pathway, and the RAS-RAF-MAP kinase cascade. Tau phosphorylation via IR/IGF-1 signaling is influenced by GSK-3 and the tau phosphatase PP2A. InterÂ­ estingly, mTOR signaling couples the activity ofPP2A and GSK-3in a way that the activities of both enzymes change always in the same direction. suggesting that only a dysregulation of either PP2A or GSK-3induces tau hyperphosphorylation. The PI3K pathway as well as the RAS-RAF-MAPK cascade regulate different transcription factors involved in transcriptional regulation of metabolism and clearance of Â­ amyloid. APP is cleaved by a.-, -secretase (BACE-1) and y-secretase (presenilin). - and subsequent y-cleavage of APP leads to generation of -amyloid 1 -4o/ t-42â€¢ IGF-1 signaling promotes a switch lrom TrkA to p75NTR expression leading to increased -secretase activity due to an upregulation of BACE-1 expression. Recent data suggest that not only BACE-1 is int1uenced by IRIIGF- IR mediated signals but also a.Â­ secretase activity is stimulated by the PI3K pathway.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "Cell adhesion subgraph"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:954}, end: {_id:1152}, properties:{evidence:"Taken together, the BBB is an important interface between the blood and the CNS compartment reguÂ­ lating uptake of insulin and IGF-1 into the bra in. However, the molecul ar mech anisms by which different conditions like aging or AD decrease insulin 's transport to the brain are not known yet. Wh eth er these mech anisms contribute to th e pathogenesis of AD and cognitive decline is still unclear.", annotationSubgraph:["Insulin signal transduction"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:954}, end: {_id:1151}, properties:{evidence:"Taken together, the BBB is an important interface between the blood and the CNS compartment reguÂ­ lating uptake of insulin and IGF-1 into the bra in. However, the molecul ar mech anisms by which different conditions like aging or AD decrease insulin 's transport to the brain are not known yet. Wh eth er these mech anisms contribute to th e pathogenesis of AD and cognitive decline is still unclear.", annotationSubgraph:["Insulin signal transduction"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:1118}, end: {_id:1368}, properties:{evidence:"The amyloid hypothesis of AD suggests that -amyloid accumulation is the critical event in development of disease (I 49, I 50]. Lots of research has been done on the formation and accumulation of Al3, however, in the last years the mechanism' of amyloid clearance came into focus. For Al3 clearance several mechanisms are known (Fig. 2): i) EnzyÂ­ matic degradation by activated microglia or by insulin deÂ­ grading enzyme (IDE), neprilysin, endothelin converting enzyme (ECE), and angiotensin converting enzyme (ACE); ii) Receptor-mediated transport across the blood brain barrier (BBB) by binding to the low- density lipoprotein receptorÂ­ related protein (LRP) either directly or after binding to apolÂ­ ipoprotein E (ApoE) and/or a2-macroglobulin (a2M) to be delivered to peripheral sites of degradation, e.g., liver and kidney. (Review in [151 ]). Concerning insulin resistance it has been shown that IDE expression is stimulated by the IR/lGF-1 R cascade (152].", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Medium"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:1179}, end: {_id:1637}, properties:{evidence:"Recently, it has been shown that PEN-2 mutations could be involved in Alzheimer's disease (AD). We performed a mutational screening of all PEN-2 coding and promoter regions in a FAD cohort derived from Southern Italy. Four hundred and fifty-two subjects (FAD: 97; Controls: 355) were recruited for this study. We identified for the first time in a key region necessary for the promoter activity a novel 3 bp deletion in a subject with early-FAD. Our genetic data demonstrate that the mutant allele may influence the transcriptional activity of the PEN-2 gene.", annotationSubgraph:["Gamma secretase subgraph"], pmid:"22055974", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22055974"}}, {start: {_id:2397}, end: {_id:1868}, properties:{evidence:"We previously showed that some familial Alzheimer's disease PS mutations cause increased basal and acetylcholine muscarinic receptor- stimulated phospholipase C (PLC) activity which was gamma-secretase dependent.", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], pmid:"17437536", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17437536"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:465}, end: {_id:466}, properties:{annotationCellstructure:["Centrosome"], evidence:"Upon binding, LRP8 transduces reelin signaling during neuronal development, and recent evidence has indicated that it interacts with the NR2A and NR2B subunits of NMDA receptor, being involved in neuronal functions such as maturation of NMDA receptor composition in the hippocampus, and the regulation of long-term potentiation. Subsequently, a novel interaction between reelin and AbetaPP was discovered, leading to increase in the cell surface levels of AbetaPP and affecting AbetaPP processing and Abeta production. It was shown that reelin signaling in excitatory synapses can restore normal synaptic plasticity, which is impaired by oligomeric Abeta peptides at concentrations within the range detectable in the brains of AD patients. At high concentrations of Abeta peptides, reelin can no longer overcome the Abeta-induced functional suppression, and this condition coincides with a complete blockade of the reelin-dependent phosphorylation of NR2 subunits in NMDA receptors. This reversal requires the LRP receptor-dependent activation of tyrosine kinases of the Src family.", annotationSubgraph:["Amyloidogenic subgraph", "Reelin signaling subgraph"], annotationConfidence:["Medium"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:708}, end: {_id:923}, properties:{evidence:"Medium", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["High"], pmid:"17077814", citationType:"PubMed", citationRef:"17077814"}}, {start: {_id:4377}, end: {_id:4381}, properties:{evidence:"Alzheimer's disease (AD) is associated with an altered immune response, resulting in chronic increased inflammatory cytokine production with a prominent role of TNF-Î±. TNF-Î± signals are mediated by two receptors: TNF receptor 1 (TNFR1) and TNF receptor 2 (TNFR2). Signaling through TNFR2 is associated with neuroprotection, whereas signaling through TNFR1 is generally proinflammatory and proapoptotic. Here, we have identified a TNF-Î±-induced proinflammatory agent, lipocalin 2 (Lcn2) via gene array in murine primary cortical neurons. Further investigation showed that Lcn2 protein production and secretion were activated solely upon TNFR1 stimulation when primary murine neurons, astrocytes, and microglia were treated with TNFR1 and TNFR2 agonistic antibodies. Lcn2 was found to be significantly decreased in CSF of human patients with mild cognitive impairment and AD and increased in brain regions associated with AD pathology in human postmortem brain tissue. Mechanistic studies in cultures of primary cortical neurons showed that Lcn2 sensitizes nerve cells to beta-amyloid toxicity. Moreover, Lcn2 silences a TNFR2-mediated protective neuronal signaling cascade in neurons, pivotal for TNF-Î±-mediated neuroprotection. The present study introduces Lcn2 as a molecular actor in neuroinflammation in early clinical stages of AD.", annotationSubgraph:["Inflammatory response subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["Medium"], pmid:"22441986", citationType:"PubMed", citationRef:"22441986"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:2100}, end: {_id:2124}, properties:{evidence:"Induction of zif268 in neurons leads to altered expression of proteasome subunit and proteasome-regulatory genes, thereby changing the capacity of the neuron to degrade synaptic proteins, including receptors and receptor subunits.", annotationSubgraph:["Ubiquitin degradation subgraph", "GABA subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["Medium"], pmid:"19909279", citationType:"PubMed", citationRef:"19909279"}}, {start: {_id:2100}, end: {_id:1220}, properties:{evidence:"Hippocampal expression levels of Egr1 have been shown to positively correlate with disease progression in AD, whereas the overexpression of EGR1 in rat brain induces tau phosphorylation via its target, and regulator of cdk5, p35.", annotationSubgraph:["Gamma secretase subgraph", "Cyclin-CDK subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:REGULATES]->(end) SET r += row.properties;
UNWIND [{start: {_id:856}, end: {_id:1186}, properties:{evidence:"Rosiglitazone is a TZD derivative that was recently observed to improve cognition in both APP transgenic mice and AD patients [Watson et al., 2005; Pedersen et al., 2006]. It activates PPARgamma leading to increased glucose disposal rates [Jung et al., 2005] and is also neuroprotective against Abeta neurotoxicity [Inestrosa et al., 2005]. Neuroprotection may result through modulation of Wnt signaling since an increase in beta-catenin and inhibition of GSK-3beta is observed upon exposure to rosiglitazone [Inestrosa et al., 2005], although a different study has shown that activation of PPARgamma by a potent ligand leads to beta-catenin degradation [Liu and Farmer 2004]. Nonetheless, in support of the role for PPARgamma activation in neuroprotection, PPARgamma agonists have potent anti-inflammatory effects [Luna-Medina et al., 2005], inhibit microglial activation [Bernardo et al., 2005; Heneka et al., 2005] and have been shown to improve verbal memory in AD patients with T2DM, possibly in a mechanism dependent on PPARgamma activation . A recent report demonstrates that overexpression of PPARgamma in cultured cells leads to a dramatic decrease in the production of Abeta, by increasing the rate of APP degradation via ubiquitination [D'Abramo et al., 2005]. This study also showed that by decreasing Abeta secretion, PPARgamma protects the cells against H2O2-mediated necrosis [D'Abramo et al., 2005].", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Non-amyloidogenic subgraph"], annotationUserdefinedcellline:["App transgenic"], annotationConfidence:["High"], annotationDisease:["Alzheimer's disease"], pmid:"19885299", citationType:"PubMed", citationRef:"19885299"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:27}, end: {_id:91}, properties:{evidence:"Part of the inflammatory response in Alzheimer's disease (AD) is the upregulation of the inducible nitric oxide synthase (NOS2) resulting in increased NO production.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"21903077", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21903077"}}, {start: {_id:27}, end: {_id:95}, properties:{evidence:"Alzheimer's disease (AD) is a neurodegenerative disease with progressive dementia accompanied by three main structural changes in the brain: diffuse loss of neurons; intracellular protein deposits termed neurofibrillary tangles (NFT) and extracellular protein deposits termed amyloid or senile plaques, surrounded by dystrophic neurites. Recent studies have suggested that the trafficking process of membrane associated proteins is modulated by the FAD-linked presenilin (PS) proteins, and that amyloid beta-peptide deposition may be initiated intracellularly, through the secretory pathway. Current hypotheses concerning presenilin function are based upon its cellular localization and its putative interaction as macromolecular complexes with the cell-adhesion/signaling beta-catenin molecule and the glycogen synthase kinase 3beta (GSK-3beta) enzyme. Developmental studies have shown that PS proteins function as components in the Notch signal transduction cascade and that beta-catenin and GSK-3beta are transducers of the Wnt signaling pathway. Both pathways are thought to have an important role in brain development, and they have been connected through Dishevelled (Dvl) protein, a known transducer of the Wnt signaling pathway. In addition to a review of the current state of research on the subject, we present a cell signaling model in which a sustained loss of function of Wnt signaling components would trigger a series of misrecognition events, determining the onset and development of AD.", annotationSubgraph:["Gamma secretase subgraph"], annotationConfidence:["High"], pmid:"10967351", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"10967351"}}, {start: {_id:27}, end: {_id:190}, properties:{evidence:"Alzheimer's disease (AD) is associated with accumulations of amyloid- beta (Abeta) peptides, oxidative damage, mitochondrial dysfunction, neurodegeneration, and dementia", annotationSubgraph:["Response to oxidative stress", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16687508", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"16687508"}}, {start: {_id:27}, end: {_id:217}, properties:{evidence:"Alzheimer's disease (AD) is associated with accumulations of amyloid- beta (Abeta) peptides, oxidative damage, mitochondrial dysfunction, neurodegeneration, and dementia", annotationSubgraph:["Response to oxidative stress", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16687508", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"16687508"}}, {start: {_id:27}, end: {_id:982}, properties:{evidence:"The fact that mitochondria are the major generators and direct targets of reactive oxygen species led several investigators to foster the idea that oxidative stress and damage in mitochondria are contributory factors to several disorders including Alzheimer's disease and diabetes.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["High"], pmid:"17316694", citationType:"PubMed", citationRef:"17316694"}}, {start: {_id:1098}, end: {_id:982}, properties:{evidence:"The fact that mitochondria are the major generators and direct targets of reactive oxygen species led several investigators to foster the idea that oxidative stress and damage in mitochondria are contributory factors to several disorders including Alzheimer's disease and diabetes.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["High"], pmid:"17316694", citationType:"PubMed", citationRef:"17316694"}}, {start: {_id:27}, end: {_id:217}, properties:{evidence:"Repair of oxidative DNA damage, cell-cycle regulation and neuronal death may influence the clinical manifestation of Alzheimer's disease.", annotationConfidence:["Medium"], pmid:"24936870", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24936870"}}, {start: {_id:2076}, end: {_id:1937}, properties:{evidence:"Cerebral hypoxia is a potent stimulus for vascular activation and angiogenesis.", annotationSubgraph:["Hypoxia response subgraph"], annotationMeshdisease:["Hypoxia, Brain"], annotationMeshanatomy:["Cerebrum"], pmid:"21904637", citationType:"PubMed", citationRef:"21904637"}}, {start: {_id:825}, end: {_id:1937}, properties:{evidence:"Since these functions of OPN, and the events that it regulates, are involved with neurodegeneration, we examined whether OPN was differentially expressed in the hippocampus of the Alzheimer's disease (AD) compared with age-matched (59-93 years) control brain.", annotationMeshanatomy:["Hippocampus", "Brain"], annotationConfidence:["High"], pmid:"17316167", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:825}, end: {_id:98}, properties:{evidence:"Since these functions of OPN, and the events that it regulates, are involved with neurodegeneration, we examined whether OPN was differentially expressed in the hippocampus of the Alzheimer's disease (AD) compared with age-matched (59-93 years) control brain.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationMeshanatomy:["Hippocampus", "Brain"], annotationConfidence:["High"], pmid:"17316167", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:825}, end: {_id:982}, properties:{evidence:"Since these functions of OPN, and the events that it regulates, are involved with neurodegeneration, we examined whether OPN was differentially expressed in the hippocampus of the Alzheimer's disease (AD) compared with age-matched (59-93 years) control brain.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshanatomy:["Hippocampus", "Brain"], annotationConfidence:["High"], pmid:"17316167", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:825}, end: {_id:1424}, properties:{evidence:"Since these functions of OPN, and the events that it regulates, are involved with neurodegeneration, we examined whether OPN was differentially expressed in the hippocampus of the Alzheimer's disease (AD) compared with age-matched (59-93 years) control brain.", annotationMeshanatomy:["Hippocampus", "Brain"], annotationConfidence:["High"], pmid:"17316167", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:825}, end: {_id:2084}, properties:{evidence:"Since these functions of OPN, and the events that it regulates, are involved with neurodegeneration, we examined whether OPN was differentially expressed in the hippocampus of the Alzheimer's disease (AD) compared with age-matched (59-93 years) control brain.", annotationMeshanatomy:["Hippocampus", "Brain"], annotationConfidence:["High"], pmid:"17316167", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:825}, end: {_id:2085}, properties:{evidence:"Since these functions of OPN, and the events that it regulates, are involved with neurodegeneration, we examined whether OPN was differentially expressed in the hippocampus of the Alzheimer's disease (AD) compared with age-matched (59-93 years) control brain.", annotationMeshanatomy:["Hippocampus", "Brain"], annotationConfidence:["High"], pmid:"17316167", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:825}, end: {_id:1229}, properties:{evidence:"Since these functions of OPN, and the events that it regulates, are involved with neurodegeneration, we examined whether OPN was differentially expressed in the hippocampus of the Alzheimer's disease (AD) compared with age-matched (59-93 years) control brain.", annotationMeshanatomy:["Hippocampus", "Brain"], annotationConfidence:["High"], pmid:"17316167", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17316167"}}, {start: {_id:27}, end: {_id:151}, properties:{annotationCellstructure:["Endoplasmic Reticulum"], evidence:"Endoplasmic reticulum (ER) stress is suggested to play a key role in the pathogenesis of neurodegenerative diseases including Alzheimer's disease (AD).", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshdisease:["Neurodegenerative Diseases"], annotationConfidence:["Medium"], pmid:"22046282", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22046282"}}, {start: {_id:27}, end: {_id:178}, properties:{evidence:"Several lines of evidence also implicate lipid transporters of the A-branch of ABC transporters in pathogenesis.", annotationConfidence:["High"], pmid:"23789959", citationType:"PubMed", citationRef:"23789959"}}, {start: {_id:2217}, end: {_id:2345}, properties:{evidence:"The role of the urokinase receptor in epilepsy, in disorders of language, cognition, communication and behavior, and in the central nervous system.", annotationSubgraph:["Plasminogen activator subgraph"], annotationMeshdisease:["Epilepsy"], annotationMeshanatomy:["Central Nervous System"], pmid:"21711233", citationType:"PubMed", citationRef:"21711233"}}, {start: {_id:27}, end: {_id:2396}, properties:{evidence:"We previously showed that some familial Alzheimer's disease PS mutations cause increased basal and acetylcholine muscarinic receptor- stimulated phospholipase C (PLC) activity which was gamma-secretase dependent.", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], pmid:"17437536", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17437536"}}, {start: {_id:1414}, end: {_id:2927}, properties:{evidence:"Astrocyte is the most abundant type of glial cells in the central nervous system (CNS) and appears to be/ involved in the induction of neuroinflammation. Under stress and injury, astrocytes become astrogliotic leading to an / upregulation of the expression of proinflammatory cytokines and chemokines, which are associated with the pathogenesis of AD.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["Very High"], pmid:"21143158", citationType:"PubMed", citationRef:"21143158"}}] AS row
