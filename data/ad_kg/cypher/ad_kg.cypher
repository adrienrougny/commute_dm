UNWIND [{start: {_id:22}, end: {_id:2808}, properties:{evidence:"Alzheimer precursor protein interaction with the Nogo-66 receptor reduces amyloid-beta plaque deposition.", annotationSubgraph:["Autophagy signaling subgraph", "Axonal guidance subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16452662", citationType:"PubMed", citationRef:"16452662"}}, {start: {_id:22}, end: {_id:2841}, properties:{evidence:"Despite the wealth of in vivo and in vitro data that have accumulated regarding the connection of APP to kinesin transport, it is not yet clear if APP is coupled to its specific motor protein via an intracellular interaction partner, such as the c-Jun N-terminal kinase-interacting protein, or by yet another unknown molecular mechanism", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17047360", citationType:"PubMed", citationRef:"17047360"}}, {start: {_id:22}, end: {_id:174}, properties:{evidence:"The beta-amyloid precursor protein (APP) shares intracellular and extracellular-binding partners with the family of receptors for apolipoprotein E (apoE).", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"18415033", citationType:"PubMed", citationRef:"18415033"}}, {start: {_id:2895}, end: {_id:2896}, properties:{evidence:"Fetal Alz-50 clone 1 (FAC1) protein interacts with the Myc-associated zinc finger protein (ZF87/MAZ) and alters its transcriptional activity.", pmid:"10727212", citationType:"PubMed", citationRef:"10727212"}}, {start: {_id:2928}, end: {_id:6}, properties:{evidence:"CD40 ligation in the presence of Abeta(1-42) leads to adaptive activation of microglia, as evidenced by increased co-localization of MHC class II with Abeta.", annotationSubgraph:["Tumor necrosis factor subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15688347", citationType:"PubMed", citationRef:"15688347"}}, {start: {_id:830}, end: {_id:3125}, properties:{evidence:"IDE is known to bind the cytoplasmic intermediate filament protein nestin with high affinity.", annotationConfidence:["Medium"], pmid:"21185309", citationType:"PubMed", citationRef:"21185309"}}, {start: {_id:1119}, end: {_id:413}, properties:{evidence:"We have now analyzed this process in greater detail and found that the IGF-I receptor interacts with the transmembrane region of megalin, whereas the perimembrane domain of megalin is required for IGF-I internalization.", annotationSubgraph:["Insulin signal transduction", "Low density lipoprotein subgraph"], annotationConfidence:["Medium"], pmid:"20351102", citationType:"PubMed", citationRef:"20351102"}}, {start: {_id:376}, end: {_id:22}, properties:{evidence:"Increasing evidence suggests that the low density lipoprotein receptor-related protein ( LRP ) affects the processing of amyloid precursor protein ( APP ) and amyloid beta ( Abeta ) protein production as well as mediates the clearance of Abeta from the brain.", annotationSubgraph:["Non-amyloidogenic subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["Medium"], pmid:"15772078", citationType:"PubMed", citationRef:"15772078"}}, {start: {_id:3220}, end: {_id:2}, properties:{evidence:"XB51 protein is known to interact with the amino-terminal of the X11L protein and to be involved in Abeta40 generation, a hallmark of Alzheimer's disease.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"19035353", citationType:"PubMed", citationRef:"19035353"}}, {start: {_id:37}, end: {_id:6}, properties:{evidence:"Presenilin 1 (PS1) plays a critical role in the gamma-secretase processing of the amyloid precursor protein to generate the beta- amyloid peptide, which accumulates in plaques in the pathogenesis of Alzheimer's disease (AD).", annotationSubgraph:["Gamma secretase subgraph"], annotationConfidence:["High"], pmid:"18299393", citationType:"PubMed", citationRef:"18299393"}}, {start: {_id:37}, end: {_i