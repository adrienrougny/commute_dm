UNWIND [{start: {_id:2156}, end: {_id:4280}, properties:{evidence:"Rifampicin protects PC12 cells from rotenone-induced cytotoxicity by activating GRP78 via PERK-eIF2Î±-ATF4 pathway.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshanatomy:["PC12 Cells"], pmid:"24638036", annotationCellline:["PC12"], citationType:"PubMed", citationRef:"24638036"}}, {start: {_id:2156}, end: {_id:4280}, properties:{evidence:"Taken together, our data suggested that rifampicin induced GRP78 via the PERK-eIF2Î±-ATF4 pathway to protect neurons against rotenone- induced cell damage.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshanatomy:["Neurons"], pmid:"24638036", citationType:"PubMed", citationRef:"24638036"}}, {start: {_id:4321}, end: {_id:4326}, properties:{evidence:"Results demonstrated that orally administered rutin significantly attenuated memory deficits in AD transgenic mice, decreased oligomeric Abeta level, increased super oxide dismutase (SOD) activity and glutathione (GSH)/glutathione disulfide (GSSG) ratio, reduced GSSG and malondialdehyde (MDA) levels, downregulated microgliosis and astrocytosis, and decreased interleukin (IL)-1beta and IL-6 levels in the brain.", annotationSubgraph:["Glutathione reductase subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"24512768", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24512768"}}, {start: {_id:611}, end: {_id:4350}, properties:{evidence:"Here we report that the expression of COX-2 and glial fibrillary acidic protein were enhanced and that of/ peroxisome proliferator- activated receptor gamma (PPARgamma) was decreased in Abeta(25-35)-treated astrocytes. In line/ with these results, nuclear factor-kappaB translocation was increased in the presence of Abeta.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Prostaglandin subgraph"], annotationMeshanatomy:["Astrocytes", "Microglia"], annotationConfidence:["High"], pmid:"20413894", citationType:"PubMed", citationRef:"20413894"}}, {start: {_id:611}, end: {_id:4277}, properties:{evidence:"Here we report that the expression of COX-2 and glial fibrillary acidic protein were enhanced and that of/ peroxisome proliferator- activated receptor gamma (PPARgamma) was decreased in Abeta(25-35)-treated astrocytes. In line/ with these results, nuclear factor-kappaB translocation was increased in the presence of Abeta.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Prostaglandin subgraph"], annotationMeshanatomy:["Astrocytes", "Microglia"], annotationConfidence:["Medium"], pmid:"20413894", citationType:"PubMed", citationRef:"20413894"}}, {start: {_id:1567}, end: {_id:4225}, properties:{evidence:"Experimental evidence suggests that cortical noradrenaline (NA) depletion due to degeneration of the locus/ ceruleus (LC) - a pathological hallmark of AD - plays a permissive role in the development of inflammation in AD. Our/ results indicate for the first time that PPARgamma expression can be modulated by the cAMP signalling pathway, and/ suggest that the anti-inflammatory effects of NA on brain cells may be partly mediated by increasing PPARgamma levels./ Conversely, decreased NA due to LC cell death in AD may reduce endogenous PPARgamma expression and therefore potentiate/ neuroinflammatory processes.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph"], pmid:"12887689", citationType:"PubMed", citationRef:"12887689"}}, {start: {_id:552}, end: {_id:6}, properties:{evidence:"We found that palmitic acid significantly increased de-novo synthesis of ceramide in astroglia, which/ in turn was involved in inducing both increased production of the Abeta protein and hyperphosphorylation of the tau/ protein. Increased amyloidogenesis and hyperphoshorylation of tau lead to formation of the two most important/ pathophysiological characteristics associated with AD, Abeta or senile plaques and neurofibrillary tangles, respectively./ In addition to these pathophysiological changes, AD is also characterized by certain metabolic changes; abnormal/ cerebral glucose metabolism is one of the distinct characteristics of AD. In this context, we found that palmitic/ acid significantly decreased the levels of astroglial glucose transporter (GLUT1) and down-regulated glucose uptake/ and lactate release by astroglia. Our present data establish an underlying mechanism by which saturated fatty acids/ induce AD-associated pathophysiological as well as metabolic changes, placing 'astroglial fatty acid metabolism' at/ the center of the pathogenic cascade in AD.", annotationSubgraph:["Sphingolipid metabolic subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"17908174", citationType:"PubMed", citationRef:"17908174"}}, {start: {_id:552}, end: {_id:1801}, properties:{evidence:"We found that palmitic acid significantly increased de-novo synthesis of ceramide in astroglia, which/ in turn was involved in inducing both increased production of the Abeta protein and hyperphosphorylation of the tau/ protein. Increased amyloidogenesis and hyperphoshorylation of tau lead to formation of the two most important/ pathophysiological characteristics associated with AD, Abeta or senile plaques and neurofibrillary tangles, respectively./ In addition to these pathophysiological changes, AD is also characterized by certain metabolic changes; abnormal/ cerebral glucose metabolism is one of the distinct characteristics of AD. In this context, we found that palmitic/ acid significantly decreased the levels of astroglial glucose transporter (GLUT1) and down-regulated glucose uptake/ and lactate release by astroglia. Our present data establish an underlying mechanism by which saturated fatty acids/ induce AD-associated pathophysiological as well as metabolic changes, placing 'astroglial fatty acid metabolism' at/ the center of the pathogenic cascade in AD.", annotationSubgraph:["Sphingolipid metabolic subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"17908174", citationType:"PubMed", citationRef:"17908174"}}, {start: {_id:4371}, end: {_id:4370}, properties:{evidence:"Heme oxygenase-1 (HO-1) is a 32kDa stress protein that degrades heme to biliverdin, free iron and carbon/ monoxide. Our laboratory has shown that cysteamine, dopamine, beta-amyloid, IL-1beta and TNF-alpha up-regulate HO-1/ followed by mitochondrial sequestration of non- transferrin-derived 55Fe in cultured rat astroglia. In these cells and / in rat astroglia transfected with the human HO-1 gene, mitochondrial iron trapping is abrogated by the HO-1 inhibitors, / tin-mesoporphyrin and dexamethasone.We determined that HO-1 immunoreactivity is enhanced greatly in neurons and astrocytes/ of the hippocampus and cerebral cortex of Alzheimer subjects and co-localizes to senile plaques and neurofibrillary/ tangles (NFT). HO-1 staining is also augmented in astrocytes and decorates neuronal Lewy bodies in the Parkinson nigra./ Collectively, our findings suggest that HO-1 over-expression contributes to the pathological iron deposition and/ mitochondrial damage documented in these aging-related neurodegenerative disorders.", pmid:"11053673", citationType:"PubMed", citationRef:"11053673"}}, {start: {_id:4372}, end: {_id:4370}, properties:{evidence:"Heme oxygenase-1 (HO-1) is a 32kDa stress protein that degrades heme to biliverdin, free iron and carbon/ monoxide. Our laboratory has shown that cysteamine, dopamine, beta-amyloid, IL-1beta and TNF-alpha up-regulate HO-1/ followed by mitochondrial sequestration of non- transferrin-derived 55Fe in cultured rat astroglia. In these cells and / in rat astroglia transfected with the human HO-1 gene, mitochondrial iron trapping is abrogated by the HO-1 inhibitors, / tin-mesoporphyrin and dexamethasone.We determined that HO-1 immunoreactivity is enhanced greatly in neurons and astrocytes/ of the hippocampus and cerebral cortex of Alzheimer subjects and co-localizes to senile plaques and neurofibrillary/ tangles (NFT). HO-1 staining is also augmented in astrocytes and decorates neuronal Lewy bodies in the Parkinson nigra./ Collectively, our findings suggest that HO-1 over-expression contributes to the pathological iron deposition and/ mitochondrial damage documented in these aging-related neurodegenerative disorders.", pmid:"11053673", citationType:"PubMed", citationRef:"11053673"}}, {start: {_id:4396}, end: {_id:4242}, properties:{evidence:"Isotretinoin results in increased expression of S100A9 mRNA", annotationSubgraph:["Vitamin subgraph", "Toll like receptor subgraph"], pmid:"15982314", citationType:"PubMed", citationRef:"15982314"}}, {start: {_id:4306}, end: {_id:4242}, properties:{evidence:"Simvastatin results in increased expression of S100A9 mRNA", annotationSubgraph:["Cholesterol metabolism subgraph", "Toll like receptor subgraph"], pmid:"17428261", citationType:"PubMed", citationRef:"17428261"}}, {start: {_id:4394}, end: {_id:838}, properties:{evidence:"Estradiol results in increased expression of PPARG protein", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Estrogen subgraph"], pmid:"15964169", citationType:"PubMed", citationRef:"15964169"}}, {start: {_id:1180}, end: {_id:4437}, properties:{evidence:"JAK-STAT signaling as an anti-inflammatory target. JAK-STAT signaling mediates the brain inflammation induced by LPS, IFN-gamma, ganglioside and thrombin. Curcumin activates SH2-containing phosphatase 2 (SHP2), while rosiglitazone and 15d-PGJ2 increase the expressions of SOCS1 and SOCS3. SHP2 and the SOCS proteins are typical negative feedback molecules of the JAK-STAT pathway.", annotationSubgraph:["Inflammatory response subgraph", "JAK-STAT signaling subgraph"], annotationConfidence:["Medium"], pmid:"26113788", citationType:"PubMed", citationRef:"26113788"}}, {start: {_id:1180}, end: {_id:4438}, properties:{evidence:"JAK-STAT signaling as an anti-inflammatory target. JAK-STAT signaling mediates the brain inflammation induced by LPS, IFN-gamma, ganglioside and thrombin. Curcumin activates SH2-containing phosphatase 2 (SHP2), while rosiglitazone and 15d-PGJ2 increase the expressions of SOCS1 and SOCS3. SHP2 and the SOCS proteins are typical negative feedback molecules of the JAK-STAT pathway.", annotationSubgraph:["Inflammatory response subgraph", "JAK-STAT signaling subgraph"], annotationConfidence:["Medium"], pmid:"26113788", citationType:"PubMed", citationRef:"26113788"}}, {start: {_id:4439}, end: {_id:4438}, properties:{evidence:"JAK-STAT signaling as an anti-inflammatory target. JAK-STAT signaling mediates the brain inflammation induced by LPS, IFN-gamma, ganglioside and thrombin. Curcumin activates SH2-containing phosphatase 2 (SHP2), while rosiglitazone and 15d-PGJ2 increase the expressions of SOCS1 and SOCS3. SHP2 and the SOCS proteins are typical negative feedback molecules of the JAK-STAT pathway.", annotationSubgraph:["Inflammatory response subgraph", "JAK-STAT signaling subgraph"], annotationConfidence:["Medium"], pmid:"26113788", citationType:"PubMed", citationRef:"26113788"}}, {start: {_id:4442}, end: {_id:1748}, properties:{evidence:"developmental exposure of rodents to the heavy metal lead (Pb) increases APP (amyloid precursor protein) and Abeta production later in the aging brain", annotationSubgraph:["Epigenetic modification subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Brain"], pmid:"18157652", citationType:"PubMed", citationRef:"18157652"}}, {start: {_id:4442}, end: {_id:6}, properties:{evidence:"developmental exposure of rodents to the heavy metal lead (Pb) increases APP (amyloid precursor protein) and Abeta production later in the aging brain", annotationSubgraph:["Epigenetic modification subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Brain"], pmid:"18157652", citationType:"PubMed", citationRef:"18157652"}}, {start: {_id:4448}, end: {_id:4446}, properties:{evidence:"We found that specificity protein 1(Sp1) expression exhibited a high level of induction after Pb exposure; we have shown that exposure to Pb increases the expression of the APP gene and the activity of Sp1", annotationSubgraph:["Epigenetic modification subgraph"], annotationSpecies:["10090"], annotationConfidence:["Medium"], pmid:"15673661", citationType:"PubMed", citationRef:"15673661"}}, {start: {_id:4448}, end: {_id:1748}, properties:{evidence:"We found that specificity protein 1(Sp1) expression exhibited a high level of induction after Pb exposure; we have shown that exposure to Pb increases the expression of the APP gene and the activity of Sp1", annotationSubgraph:["Amyloidogenic subgraph", "Epigenetic modification subgraph"], annotationSpecies:["10090"], annotationConfidence:["Medium"], pmid:"15673661", citationType:"PubMed", citationRef:"15673661"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:802}, end: {_id:4449}, properties:{evidence:"More recently, it was reported that subchronic exposure to Cd inhibited DNA-methyltransferase activity in cultured cells, while chronic exposure enhanced the activity of the DNA-methyltransferase.", annotationSubgraph:["Epigenetic modification subgraph"], annotationSpecies:["10090"], annotationConfidence:["High"], pmid:"19245828", annotationDurationOfChemicalExposure:["Chronic"], citationType:"PubMed", citationRef:"19245828"}}, {start: {_id:2041}, end: {_id:4480}, properties:{evidence:"It has been shown that the MTHFR 677T allele is associated with increased total plasma Hcy levels (tHcy) and decreased serum folate levels, mainly in 677TT homozygous subjects. the MTHFR 677C>T polymorphism as a candidate AD risk factor", annotationSubgraph:["Epigenetic modification subgraph"], annotationMeshanatomy:["Plasma"], pmid:"21119889", citationType:"PubMed", citationRef:"21119889"}}, {start: {_id:2041}, end: {_id:4479}, properties:{evidence:"It has been shown that the MTHFR 677T allele is associated with increased total plasma Hcy levels (tHcy) and decreased serum folate levels, mainly in 677TT homozygous subjects. the MTHFR 677C>T polymorphism as a candidate AD risk factor", annotationSubgraph:["Epigenetic modification subgraph"], annotationMeshanatomy:["Plasma"], pmid:"21119889", citationType:"PubMed", citationRef:"21119889"}}, {start: {_id:4503}, end: {_id:1741}, properties:{evidence:"5-Aza increased both BACE1 mRNA and protein levels in a dose-dependent manner in two CpG sites at positions +298 and +351 in the 5'-UTR in BV-2 microglial cells.", annotationSpecies:["10090"], annotationCell:["microglial cell"], pmid:"22166205", annotationTranscriptionallyActiveRegion:["5 prime UTR"], citationType:"PubMed", citationRef:"22166205"}}, {start: {_id:4529}, end: {_id:4523}, properties:{evidence:"HDAC inhibitor trichostatin A (TSA) resulted in prolonged p65 acetylation", pmid:"21419233", citationType:"PubMed", citationRef:"21419233"}}, {start: {_id:4529}, end: {_id:4520}, properties:{evidence:"HDAC inhibitor trichostatin A (TSA) resulted in prolonged p65 acetylation", pmid:"21419233", citationType:"PubMed", citationRef:"21419233"}}, {start: {_id:4503}, end: {_id:4613}, properties:{evidence:"Treatment with the DNA methyltransferase inhibitor 5-aza-2ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â²-deoxycytidine restored suppressed IGFBP3 expression", annotationSpecies:["10090"], annotationUserdefinedcellline:["App transgenic"], pmid:"24964199", citationType:"PubMed", citationRef:"24964199", annotationRace:["Swedish"]}}, {start: {_id:4635}, end: {_id:796}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"the expression of ADAM 10 was slightly increased after anisomycin treatment", pmid:"21843603", citationType:"PubMed", citationRef:"21843603"}}, {start: {_id:4529}, end: {_id:2765}, properties:{evidence:"TSA increased both the mRNA and protein levels of calpastatin,", pmid:"24200051", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24200051"}}, {start: {_id:4529}, end: {_id:4525}, properties:{evidence:"Trichostatin A increases calpastatin levels epigenetically via histone acetylations(H4K5-Ac(acetylation at lysine 5 of histone H4), H3K9-Ac and H3K14-Ac).", pmid:"24200051", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24200051"}}, {start: {_id:4529}, end: {_id:4652}, properties:{evidence:"Trichostatin A increases calpastatin levels epigenetically via histone acetylations(H4K5-Ac(acetylation at lysine 5 of histone H4), H3K9-Ac and H3K14-Ac).", pmid:"24200051", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24200051"}}, {start: {_id:4529}, end: {_id:4654}, properties:{evidence:"Trichostatin A increases calpastatin levels epigenetically via histone acetylations(H4K5-Ac(acetylation at lysine 5 of histone H4), H3K9-Ac and H3K14-Ac).", pmid:"24200051", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24200051"}}, {start: {_id:4672}, end: {_id:4520}, properties:{evidence:"sodium butyrate (a well-known HDAC inhibitor) increased DHCR24 expression in SH-SY5Y cells by recruiting acetylated core histones H3 and H4 to the enhancer region, as demonstrated by transient transfection and chromatin immunoprecipitation assays.", annotationMeshanatomy:["Cerebral Cortex"], pmid:"20568014", citationType:"PubMed", citationRef:"20568014"}}, {start: {_id:4471}, end: {_id:6}, properties:{evidence:"we demonstrate that BACE (beta-secretase), as well as PS1, is regulated by methylation and that the reduction of folate and vitamin B12 in culture medium can cause a reduction of SAM levels with consequent increase in presenilin1 and BACE levels and with increase in Abeta production.", pmid:"15607954", citationType:"PubMed", citationRef:"15607954"}}, {start: {_id:4529}, end: {_id:4520}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"Inhibition of HDAC2 activity by trichostatin A substantially recovered the histone H3 acetylation in the promoter region of Bdnf exon VI and BDNF expression, thus mitigating the synaptic dysfunction and memory deficiency induced by amyloid fibrils.", pmid:"25242807", citationType:"PubMed", citationRef:"25242807"}}, {start: {_id:4442}, end: {_id:22}, properties:{evidence:"lead (Pb) exposure in early life may increase amyloid precursor protein (APP) expression and promote the pathogenesis of Alzheimer's disease in old age.", pmid:"22764079", citationType:"PubMed", citationRef:"22764079"}}, {start: {_id:0}, end: {_id:4693}, properties:{evidence:"Two specific OSPs were identified by mass spectrometry as heat shock protein 60 (HSP 60) and vimentin. Exposure of the cells to Abeta(25-35) resulted in a twofold increase in the level of oxidation of these two OSPs in the cells derived from controls, but a ninefold increase in their level of oxidation in the fibroblasts from AD subjects.", annotationSubgraph:["Chaperone subgraph", "Regulation of actin cytoskeleton subgraph"], annotationCell:["fibroblast"], annotationConfidence:["Medium"], pmid:"12633901", citationType:"PubMed", citationRef:"12633901"}}, {start: {_id:0}, end: {_id:4694}, properties:{evidence:"Two specific OSPs were identified by mass spectrometry as heat shock protein 60 (HSP 60) and vimentin. Exposure of the cells to Abeta(25-35) resulted in a twofold increase in the level of oxidation of these two OSPs in the cells derived from controls, but a ninefold increase in their level of oxidation in the fibroblasts from AD subjects.", annotationSubgraph:["Chaperone subgraph", "Regulation of actin cytoskeleton subgraph"], annotationCell:["fibroblast"], annotationConfidence:["Medium"], pmid:"12633901", citationType:"PubMed", citationRef:"12633901"}}, {start: {_id:1935}, end: {_id:1512}, properties:{evidence:"In disease state, LPS (lipoploysacharide) induces TLR4, which increases NFKB1 activities. NFKB1 increases MIR34A which targets TREM2, decreasing normal TREM2 and increases the mutant variant. Recent GWAS studies associated SNP rs75932628 with TREM2 in LOAD patients. Also there are studies suggesting the link of this TREM2 variant with certain clinical and neuroimaging AD features such as frontobasal gray atrophy. Moreover, in disease brain TREM2 forms complex with TYROBP which triggers immune responses through activating macrophages and dendritic cells which leads to chronic neuroinflammation.", annotationSubgraph:["Inflammatory response subgraph", "Toll like receptor subgraph"], annotationConfidence:["Medium"], pmid:"25681350", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:4778}, end: {_id:4773}, properties:{evidence:"By treatment of cells with octaarginine (R8), enhanced clustering of syndecan-4 on plasma membranes and binding of protein kinase Calpha (PKCalpha) to the cytoplasmic domain of syndecan-4 were observed; these events potentially lead to the macropinocytic uptake of R8.", annotationSubgraph:["Syndecan subgraph"], annotationConfidence:["Medium"], pmid:"24632200", citationType:"PubMed", citationRef:"24632200"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:4778}, end: {_id:4773}, properties:{evidence:"This observation suggests that R8 enhances Syn-4 clustering on plasma membranes during this short period of 30 min.", annotationSubgraph:["Syndecan subgraph"], annotationConfidence:["Medium"], pmid:"24632200", citationType:"PubMed", citationRef:"24632200"}}, {start: {_id:1248}, end: {_id:4817}, properties:{evidence:"Kainic Acid results in increased expression of CRHR1 mRNA", annotationSpecies:["10116"], pmid:"12093084", citationType:"PubMed", citationRef:"12093084"}}, {start: {_id:76}, end: {_id:4817}, properties:{evidence:"Nitric Oxide results in increased expression of CRHR1 mRNA", annotationSpecies:["10116"], pmid:"10460269", citationType:"PubMed", citationRef:"10460269"}}, {start: {_id:4394}, end: {_id:4831}, properties:{evidence:"Estradiol results in increased expression of CRHR1 mRNA alternative form", annotationSubgraph:["CRH subgraph"], pmid:"20702571", citationType:"PubMed", citationRef:"20702571"}}, {start: {_id:3}, end: {_id:4058}, properties:{evidence:"Although the mechanism of Abeta action in the pathogenesis of Alzheimer's disease (AD) has remained elusive, it is known to increase the expression of the antagonist of canonical wnt signalling, Dickkopf-1 (Dkk1)", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:3}, end: {_id:4912}, properties:{evidence:"Abeta increased intracellular clusterin and decreased clusterin protein secretion, resulting in the p53-dependent induction of DKK1. To further elucidate how the clusterin-dependent induction of Dkk1 by Abeta mediates neurotoxicity, we measured the effects of Abeta and Dkk1 protein on whole-genome expression in primary neurons, finding a common pathway suggestive of activation of wnt–planar cell polarity (PCP)–c-Jun N-terminal kinase (JNK) signalling leading to the induction of genes including EGR1 (early growth response-1), NAB2 (Ngfi-A-binding protein-2) and KLF10 (Krüppel-like factor-10) that, when individually silenced, protected against Abeta neurotoxicity and/or tau phosphorylation", annotationSubgraph:["Amyloidogenic subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["Very High"], pmid:"23164821", citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:4928}, end: {_id:4929}, properties:{evidence:"By contrast, junD and ΔfosB mRNA were both upregulated significantly above control levels after an acute injection of l-DOPA.", pmid:"17055656", annotationAnatomy:["corpus striatum"], citationType:"PubMed", citationRef:"17055656"}}, {start: {_id:3}, end: {_id:1996}, properties:{evidence:"However, MMPs can degrade both soluble and fibrillar forms of amyloid- beta (Abeta). It has also been shown that Abeta enhances the expression of MMPs in neuroglial cultures and induces the release of TIMP-1 by brain cell", annotationSubgraph:["Amyloidogenic subgraph", "Matrix metalloproteinase subgraph"], annotationMeshanatomy:["Brain", "Microglia"], annotationConfidence:["Medium"], pmid:"23792694", citationType:"PubMed", citationRef:"23792694"}}, {start: {_id:3}, end: {_id:3378}, properties:{evidence:"However, MMPs can degrade both soluble and fibrillar forms of amyloid- beta (Abeta). It has also been shown that Abeta enhances the expression of MMPs in neuroglial cultures and induces the release of TIMP-1 by brain cell", annotationSubgraph:["Amyloidogenic subgraph", "Matrix metalloproteinase subgraph"], annotationMeshanatomy:["Brain", "Microglia"], annotationConfidence:["Medium"], pmid:"23792694", citationType:"PubMed", citationRef:"23792694"}}, {start: {_id:4949}, end: {_id:4947}, properties:{evidence:"We demonstrate that desferrioxamine (DFX), an iron chelator used in clinics for the treatment of iron overload, neoplasias, and Alzheimer disease, stimulates the expression and secretion of CCL20, a chemoattractant for immature dendritic cells, activated/memory T lymphocytes, and naive B cells,in primary human monocytes and monocyte-derived macrophages.", annotationSubgraph:["Chemokine signaling subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"25313834", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25313834"}}, {start: {_id:4949}, end: {_id:4947}, properties:{evidence:"Iron chelation was part of the mechanism by which DFX induced CCL20, because addition of iron sulfate counteracted its stimulatory effects", annotationSubgraph:["Chemokine signaling subgraph"], pmid:"19939449", citationType:"PubMed", citationRef:"19939449"}}, {start: {_id:4972}, end: {_id:605}, properties:{evidence:"AD-like context have also shown that vitamin D treatment, regardless of the model tested, the dosage, the molecule chosen, and the time of treatment decreases the amyloid burden, suggesting a link between vitamin D function and amyloidogenesis. The behavioral changes reported in the study by Yu and colleagues were accompanied by a diminished Abeta load, along with an increase in astrocytic reactivity, NGF levels, and decreased TNFalpha in the brain of treated mice.", annotationSubgraph:["Nerve growth factor subgraph", "Vitamin subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"27176073", citationType:"PubMed", citationRef:"27176073"}}, {start: {_id:4972}, end: {_id:4973}, properties:{evidence:"Vitamin D can i) upregulate expression of several neurotrophins, ii) increase secretion of the anti-inflammatory cytokine IL-4, iii) reduce secretion of pro-inflammatory cytokines TNF-beta and interleukin-1 beta (IL-1), and iv) inhibit differentiation of dendritic cells.", annotationSubgraph:["Vitamin subgraph"], annotationConfidence:["High"], pmid:"27176073", citationType:"PubMed", citationRef:"27176073"}}, {start: {_id:4972}, end: {_id:4976}, properties:{evidence:"First, a prenatal vitamin D deficiency disrupts brain development and alters the expression of growth factors and neurotrophin receptors in the adult dentate gyrus.", annotationMeshanatomy:["Dentate Gyrus"], pmid:"29318446", citationType:"PubMed", citationRef:"29318446"}}, {start: {_id:4972}, end: {_id:4977}, properties:{evidence:"First, a prenatal vitamin D deficiency disrupts brain development and alters the expression of growth factors and neurotrophin receptors in the adult dentate gyrus.", annotationMeshanatomy:["Dentate Gyrus"], annotationConfidence:["Medium"], pmid:"29318446", citationType:"PubMed", citationRef:"29318446"}}, {start: {_id:4972}, end: {_id:605}, properties:{evidence:"Second, vitamin D stimulates the synthesis of NGF within the hippocampus, leading to an enhanced neurite outgrowth and a reduced cellular proliferation.", annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"29318446", citationType:"PubMed", citationRef:"29318446"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:3}, end: {_id:169}, properties:{evidence:"beta amyloid peptides cause an elevation in intracellular calcium levels and enhance calcium responses to depolarization and calcium ion-ophore.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"1346802", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"1346802"}}, {start: {_id:43}, end: {_id:779}, properties:{annotationCellstructure:["Cell Membrane"], evidence:"The interaction of Abeta with the plasma membrane may be facilitated by binding to phosphatidylserine (PtdS); age/AD-related mitochondrial impairment (ATP depletion) may trigger flipping of PtdS from the inner portion of the plasma membrane to the cell surface. The PtdS flipping may also result from Ca2+ influx or release from the endoplasmic reticulum (ER) or mitochondria which can activate a phospholipid scramblase (PLSCR1)", annotationSubgraph:["Calcium-dependent signal transduction", "Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}, {start: {_id:93}, end: {_id:604}, properties:{evidence:"Apoptosis is the most common form of physiological cell death in multicellular organisms. Apoptosis signaling is classically composed of two principle pathways. One is a direct pathway from death receptor (CD95, TNF-R1, and TRAIL-R1/TRAIL-R2 [9]) ligation to caspase cascade activation and cell death. Death receptor ligation triggers recruitment of the precursor form of caspase-8 to a death-inducing complex, through the adaptor protein FADD, which leads to caspase-8 activation. The other pathway triggered by stimuli such as drugs, radiation, infectious agents, and reactive oxygen species is initiated in mitochondria. After cytochrome c is released into the cytosol from the mitochondria, it binds to Apaf1 and ATP, which then activate caspase-9.", annotationSubgraph:["Reactive oxygen species subgraph", "Electron transport chain", "Response to oxidative stress", "XIAP subgraph"], annotationConfidence:["Medium"], pmid:"19499146", citationType:"PubMed", citationRef:"19499146"}}, {start: {_id:4795}, end: {_id:4802}, properties:{evidence:"Taken together, these data indicate that tau and alpha-synuclein use a similar mechanism for uptake based on binding HSPGs, whereas Htt exon 1 fibril uptake is distinct.", annotationConfidence:["Medium"], pmid:"23898162", citationType:"PubMed", citationRef:"23898162"}}, {start: {_id:4795}, end: {_id:4804}, properties:{evidence:"Aggregate Uptake by Macropinocytosis. Based on pharmacologic studies and colocalization with Ã¯Â¬â€šuid phase markers, macropinocytosis was previously suggested as the mechanism for cell uptake of SOD1 (36). Likewise, macropinocytosis and HSPGs have been previously implicated in prion protein uptake (14, 37).", annotationConfidence:["Medium"], pmid:"23898162", citationType:"PubMed", citationRef:"23898162"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:2301}, end: {_id:98}, properties:{evidence:"Insect peptide CopA3-induced protein degradation of p27Kip1 stimulates proliferation and protects neuronal cells from apoptotic process.", annotationSubgraph:["Cyclin-CDK subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"23791873", citationType:"PubMed", citationRef:"23791873"}}] AS row
