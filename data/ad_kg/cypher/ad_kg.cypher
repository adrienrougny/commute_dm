UNWIND [{start: {_id:2030}, end: {_id:1509}, properties:{evidence:"GSNO treatment (50 Î¼g/kg/day for 2 months) significantly improved learning and memory performance of BCCAO rats and reduced the Abeta levels and ICAM-1/VCAM-1 expression in the brain.", annotationSubgraph:["Nitric oxide subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"23254638", citationType:"PubMed", citationRef:"23254638"}}, {start: {_id:2046}, end: {_id:2047}, properties:{evidence:"Testosterone-mediated neuroprotection through the androgen receptor in human primary neurons.", annotationSubgraph:["Androgen subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Neurons"], pmid:"11389183", citationType:"PubMed", citationRef:"11389183"}}, {start: {_id:1614}, end: {_id:98}, properties:{evidence:"5-chloro-7-iodoquinolin-8-ol, a therapeutic agent for Alzheimer's disease, has proteasome-inhibitory, androgen receptor-suppressing, apoptotic process-inducing, and antitumor activities in human prostate cancer cells and xenografts.", annotationSubgraph:["Androgen subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Prostatic Neoplasms", "Alzheimer Disease"], annotationMeshanatomy:["Prostate"], annotationConfidence:["Medium"], pmid:"17308104", citationType:"PubMed", citationRef:"17308104"}}, {start: {_id:1614}, end: {_id:98}, properties:{evidence:"In addition, '5-chloro-7-iodoquinolin-8-ol' alone exhibits similar effects in prostate cancer cell lines with elevated copper at concentrations similar to those found in patients. Our study provides strong evidence that 5-chloro-7-iodoquinolin-8-ol is able to target tumor proteasome in vivo in a copper-dependent manner, resulting in formation of an active AR inhibitor and apoptosis inducer that is responsible for its observed antiprostate tumor effect.", annotationSubgraph:["Androgen subgraph"], annotationMeshdisease:["Prostatic Neoplasms"], annotationMeshanatomy:["Prostate"], annotationConfidence:["High"], pmid:"17308104", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"17308104"}}, {start: {_id:64}, end: {_id:982}, properties:{evidence:"Bcl-xL protein was also up-regulated during oxidative stress induced by exposure to hydrogen peroxide (3-100microM) or ferric ions (1-10microM).", annotationSubgraph:["Hydrogen peroxide subgraph", "Bcl-2 subgraph"], annotationMeshdisease:["Wounds and Injuries"], annotationConfidence:["High"], pmid:"11226677", citationType:"PubMed", citationRef:"11226677"}}, {start: {_id:64}, end: {_id:982}, properties:{evidence:"In contrast, Bcl-xL overexpression only conferred a mild protection against oxidative injury induced by hydrogen peroxide.", annotationSubgraph:["Hydrogen peroxide subgraph", "Bcl-2 subgraph"], annotationMeshdisease:["Wounds and Injuries"], annotationConfidence:["Medium"], pmid:"11226677", citationType:"PubMed", citationRef:"11226677"}}, {start: {_id:64}, end: {_id:98}, properties:{evidence:"Piceatannol attenuates hydrogen-peroxide- and peroxynitrite-induced apoptosis of PC12 cells by blocking down-regulation of Bcl-XL and activation of JNK.", annotationSubgraph:["Apoptosis signaling subgraph", "Hydrogen peroxide subgraph"], annotationConfidence:["Medium"], annotationCellline:["PC-12 cell"], pmid:"17869087", citationType:"PubMed", citationRef:"17869087"}}, {start: {_id:148}, end: {_id:98}, properties:{evidence:"Piceatannol attenuates hydrogen-peroxide- and peroxynitrite-induced apoptosis of PC12 cells by blocking down-regulation of Bcl-XL and activation of JNK.", annotationSubgraph:["Apoptosis signaling subgraph", "Hydrogen peroxide subgraph"], annotationConfidence:["Medium"], annotationCellline:["PC-12 cell"], pmid:"17869087", citationType:"PubMed", citationRef:"17869087"}}, {start: {_id:2126}, end: {_id:1183}, properties:{evidence:"Moreover, it identifies EGR1 transcription factor as a potential mediator for GA-induced neuroprotection in both glaucoma and AD.", annotationSubgraph:["Gamma secretase subgraph", "GABA subgraph"], annotationMeshdisease:["Glaucoma", "Alzheimer Disease"], annotationConfidence:["Medium"], pmid:"21969301", citationType:"PubMed", citationRef:"21969301"}}, {start: {_id:2172}, end: {_id:193}, properties:{evidence:"In studies of dementias and Alzheimer's disease (AD), some studies have shown that antihypertensive drugs, including angiotensin- converting enzyme inhibitors, have some moderate effects on cognitive decline, but that the angiotensin receptor antagonist losartan has a significantly beneficial effect.", annotationSubgraph:["Renin-angiotensin subgraph"], pmid:"14996614", annotationDisease:["dementia", "Alzheimer's disease"], citationType:"PubMed", citationRef:"14996614"}}, {start: {_id:2171}, end: {_id:193}, properties:{evidence:"In studies of dementias and Alzheimer's disease (AD), some studies have shown that antihypertensive drugs, including angiotensin- converting enzyme inhibitors, have some moderate effects on cognitive decline, but that the angiotensin receptor antagonist losartan has a significantly beneficial effect.", annotationSubgraph:["Renin-angiotensin subgraph"], pmid:"14996614", annotationDisease:["dementia", "Alzheimer's disease"], citationType:"PubMed", citationRef:"14996614"}}, {start: {_id:3}, end: {_id:106}, properties:{evidence:"These findings raise the possibility that the JNK pathway may also contribute to Abeta-dependent death in AD patients.", annotationSubgraph:["MAPK-JNK subgraph", "Amyloidogenic subgraph"], annotationSpecies:["9606"], annotationConfidence:["Medium"], pmid:"11567045", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"11567045"}}, {start: {_id:1333}, end: {_id:1183}, properties:{evidence:"Emerging evidence has demonstrated the neuroprotection of estrogen in Alzheimer's disease (AD).", annotationSubgraph:["Estrogen subgraph", "Neuroprotection subgraph"], pmid:"12819990", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12819990"}}, {start: {_id:2059}, end: {_id:1702}, properties:{evidence:"NO donors coupled to the tacrine moiety may exert an additional beneficial effect on AD via an increased blood supply to the brain and by reducing inflammation.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshdisease:["Alzheimer Disease"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"20533758", citationType:"PubMed", citationRef:"20533758"}}, {start: {_id:2315}, end: {_id:1183}, properties:{evidence:"With respect to neuroprotection, DCI greatly enhances the ability of insulin to prevent ADDL-induced synapse damage (EC(50) of 90 nM).", annotationSubgraph:["Insulin signal transduction", "Neuroprotection subgraph"], annotationConfidence:["High"], pmid:"23073831", citationType:"PubMed", citationRef:"23073831"}}, {start: {_id:2392}, end: {_id:982}, properties:{evidence:"A number of studies have reported that acrolein evokes downstream signaling via an elevation in cellular oxidative stress.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "JAK-STAT signaling subgraph"], pmid:"16036326", citationType:"PubMed", citationRef:"16036326"}}, {start: {_id:2417}, end: {_id:98}, properties:{evidence:"Dotarizine (30--50 microM) enhanced basal apoptosis to 18--43%, flunarizine (30--50 microM) to 15%, thapsigargin (1--10 microM) to 21 --35%, and cyclopiazonic acid (100 microM) to 10%.", pmid:"16153637", citationType:"PubMed", citationRef:"16153637"}}, {start: {_id:2418}, end: {_id:98}, properties:{evidence:"Dotarizine (30--50 microM) enhanced basal apoptosis to 18--43%, flunarizine (30--50 microM) to 15%, thapsigargin (1--10 microM) to 21 --35%, and cyclopiazonic acid (100 microM) to 10%.", pmid:"16153637", citationType:"PubMed", citationRef:"16153637"}}, {start: {_id:2419}, end: {_id:98}, properties:{evidence:"Dotarizine (30--50 microM) enhanced basal apoptosis to 18--43%, flunarizine (30--50 microM) to 15%, thapsigargin (1--10 microM) to 21 --35%, and cyclopiazonic acid (100 microM) to 10%.", pmid:"16153637", citationType:"PubMed", citationRef:"16153637"}}, {start: {_id:2420}, end: {_id:98}, properties:{evidence:"Dotarizine (30--50 microM) enhanced basal apoptosis to 18--43%, flunarizine (30--50 microM) to 15%, thapsigargin (1--10 microM) to 21 --35%, and cyclopiazonic acid (100 microM) to 10%.", pmid:"16153637", citationType:"PubMed", citationRef:"16153637"}}] AS row
