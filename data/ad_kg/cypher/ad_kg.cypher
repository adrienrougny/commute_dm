UNWIND [{start: {_id:733}, end: {_id:1337}, properties:{evidence:"Craft et a!. found that AD patients have higher plasma insulin but lower CSF insulin levels [71]. A possible exp l aÂ­ nation could be that cen tra l hypoinsulin emia is caused by reduced transport via the BBB or that peri pheral h yper insulinemia might be react ive to central hypoinsulinem ia, mediÂ­ ated by so far non distinctiv.e pathways. V ery recent data suggest that intranasal insu lin administration in AD patients im proves mem ory as well, providin g a possible therapeutic option ( l 00]. Tschritter et a/. (101] used a magnetoencephalography approach during a two-step hyperinsulinemic euglycemic clamp to assess cerebrocortical insulin effects in humans. In lean humans, stimulated cortical activity inÂ­ creased with insulin infusion relative to saline. In obese huÂ­ mans, these effects were suppressed, suggesting cerebral insulin resistance in these patients. Moreover, cerebrocortical insulin resistance was found in individuals carrying the Gly972Arg polymorphism of IRS-I, which is considered to elevate the risk to develop type 2 diabetes [I 0 I].", annotationSubgraph:["Insulin signal transduction"], annotationMeshanatomy:["Cerebral Cortex"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:733}, end: {_id:118}, properties:{evidence:"The underlying mechanisms of the association between AD neuropathology and DM2 emanate from several factors, however cortical insulin resistance and inflammatory pathÂ­ ways appear to be key components of this association. SonÂ­ nen eta/. [14] demonstrated the AD cases with DM2 had higher levels of cortical IL-6 and greater frequency of miÂ­ crovascular infarcts when compared to AD cases without DM2. Further research by Freude et al. [15] has linked hy-perinsulinemia to tau hyperphosphorylation which is an imÂ­ portant component in the process underlying AD pathology. Schubert eta!. [16] demonstrated that impaired cortical insuÂ­ lin resistance is also linked to tau hyperphosphorylation. Martins et al. [17] also describe several studies implicating neuronal insulin resistance as a precursor to increased amyÂ­ loid deposition. Additional work by Kulstad et al. [18] sugÂ­ gested that insulin levels are associated with abnormal reguÂ­ lation of AP clearance which may also play a mechanistic role in the formation of AD pathology.", annotationSubgraph:["Insulin signal transduction", "Tau protein subgraph"], annotationMeshanatomy:["Cerebral Cortex"], annotationConfidence:["High"], pmid:"23627755", citationType:"PubMed", citationRef:"23627755"}}, {start: {_id:1163}, end: {_id:118}, properties:{evidence:"The underlying mechanisms of the association between AD neuropathology and DM2 emanate from several factors, however cortical insulin resistance and inflammatory pathÂ­ ways appear to be key components of this association. SonÂ­ nen eta/. [14] demonstrated the AD cases with DM2 had higher levels of cortical IL-6 and greater frequency of miÂ­ crovascular infarcts when compared to AD cases without DM2. Further research by Freude et al. [15] has linked hy-perinsulinemia to tau hyperphosphorylation which is an imÂ­ portant component in the process underlying AD pathology. Schubert eta!. [16] demonstrated that impaired cortical insuÂ­ lin resistance is also linked to tau hyperphosphorylation. Martins et al. [17] also describe several studies implicating neuronal insulin resistance as a precursor to increased amyÂ­ loid deposition. Additional work by Kulstad et al. [18] sugÂ­ gested that insulin levels are associated with abnormal reguÂ­ lation of AP clearance which may also play a mechanistic role in the formation of AD pathology.", annotationSubgraph:["Insulin signal transduction", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"23627755", citationType:"PubMed", citationRef:"23627755"}}, {start: {_id:260}, end: {_id:118}, properties:{evidence:"Interestingly, neuronal degeneration coincides with the hyperphosphorylation of endogenous tau at several epitopes previously associated with neurofibrillary pathology. Transcriptome analysis of enzymes involved in tau phosphorylation identified ERK1 as one of the candidate kinases responsible for this event in vivo. We further demonstrate that miRNAs belonging to the miR-15 family are potent regulators of ERK1 expression in mouse neuronal cells and co-expressed with ERK1/2 in vivo. Finally, we show that miR-15a is specifically downregulated in Alzheimer's disease brain.", annotationSubgraph:["miRNA subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"20660113", citationType:"PubMed", citationRef:"20660113"}}, {start: {_id:1098}, end: {_id:6}, properties:{evidence:"Abeta autoantibody levels were increased in T2DM compared with age- matched controls by 45.4 +/- 8.1% (p< 0.001).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"20061608", citationType:"PubMed", citationRef:"20061608"}}, {start: {_id:733}, end: {_id:205}, properties:{evidence:"Butyrylcholinesterase and acetylcholinesterase related proteins were found common to both Alzheimer's disease and diabetes; they may play an etiological role via influencing insulin resistance and lipid metabolism.", annotationSubgraph:["Acetylcholine signaling subgraph", "Insulin signal transduction"], annotationConfidence:["High"], pmid:"17096857", citationType:"PubMed", citationRef:"17096857"}}, {start: {_id:27}, end: {_id:1561}, properties:{evidence:"Adiponectin as a new paradigm for approaching Alzheimer's disease.", annotationSubgraph:["Lipid metabolism subgraph", "Beta-Oxidation of Fatty Acids"], annotationConfidence:["High"], pmid:"24386594", citationType:"PubMed", citationRef:"24386594"}}, {start: {_id:1142}, end: {_id:1561}, properties:{evidence:"Adiponectin is an adipocytokine released by the adipose tissue and has multiple roles in the immune system and in the metabolic syndromes such as cardiovascular disease, Type 2 diabetes, obesity and also in the neurodegenerative disorders including Alzheimer's disease.", annotationSubgraph:["Beta-Oxidation of Fatty Acids"], annotationConfidence:["High"], pmid:"24386594", citationType:"PubMed", citationRef:"24386594"}}, {start: {_id:1098}, end: {_id:1561}, properties:{evidence:"Adiponectin is an adipocytokine released by the adipose tissue and has multiple roles in the immune system and in the metabolic syndromes such as cardiovascular disease, Type 2 diabetes, obesity and also in the neurodegenerative disorders including Alzheimer's disease.", annotationSubgraph:["Beta-Oxidation of Fatty Acids"], annotationConfidence:["High"], pmid:"24386594", citationType:"PubMed", citationRef:"24386594"}}, {start: {_id:1098}, end: {_id:118}, properties:{evidence:"Phosphorylation of tau at some of the AD abnormal hyperphosphorylation sites was increased in T2DM brain.", annotationSubgraph:["Insulin signal transduction", "Tau protein subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"19659459", citationType:"PubMed", citationRef:"19659459"}}, {start: {_id:1946}, end: {_id:536}, properties:{evidence:"Pin1 is overexpressed in breast cancer and cooperates with Ras signaling in increasing the transcriptional activity of c-Jun towards cyclin D1.", annotationSubgraph:["MAPK-ERK subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Breast Neoplasms"], annotationConfidence:["High"], pmid:"11432833", citationType:"PubMed", citationRef:"11432833"}}, {start: {_id:1425}, end: {_id:536}, properties:{evidence:"However, little is known about the role of Pin1 in cancer or in modulating transcription factor activity.", annotationMeshdisease:["Neoplasms"], annotationConfidence:["High"], pmid:"11432833", citationType:"PubMed", citationRef:"11432833"}}, {start: {_id:27}, end: {_id:20}, properties:{evidence:"Increased NF-ÎºB signalling up-regulates BACE1 expression and its therapeutic potential in Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Nuclear factor Kappa beta subgraph"], annotationConfidence:["High"], pmid:"21329555", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21329555"}}, {start: {_id:1977}, end: {_id:1943}, properties:{evidence:"p21 also up-regulates multiple genes that have been associated with senescence or implicated in age-related diseases, including atherosclerosis, Alzheimer's disease, amyloidosis, and arthritis.", annotationSubgraph:["Cell cycle subgraph", "Cyclin-CDK subgraph"], annotationMeshdisease:["Atherosclerosis", "Arthritis", "Amyloidosis", "Alzheimer Disease"], pmid:"10760295", citationType:"PubMed", citationRef:"10760295"}}, {start: {_id:1160}, end: {_id:1943}, properties:{evidence:"p21 also up-regulates multiple genes that have been associated with senescence or implicated in age-related diseases, including atherosclerosis, Alzheimer's disease, amyloidosis, and arthritis.", annotationSubgraph:["Cell cycle subgraph", "Cyclin-CDK subgraph"], annotationMeshdisease:["Atherosclerosis", "Arthritis", "Amyloidosis", "Alzheimer Disease"], pmid:"10760295", citationType:"PubMed", citationRef:"10760295"}}, {start: {_id:27}, end: {_id:1943}, properties:{evidence:"p21 also up-regulates multiple genes that have been associated with senescence or implicated in age-related diseases, including atherosclerosis, Alzheimer's disease, amyloidosis, and arthritis.", annotationSubgraph:["Cell cycle subgraph", "Cyclin-CDK subgraph"], annotationMeshdisease:["Atherosclerosis", "Arthritis", "Amyloidosis", "Alzheimer Disease"], pmid:"10760295", citationType:"PubMed", citationRef:"10760295"}}, {start: {_id:1978}, end: {_id:1943}, properties:{evidence:"p21 also up-regulates multiple genes that have been associated with senescence or implicated in age-related diseases, including atherosclerosis, Alzheimer's disease, amyloidosis, and arthritis.", annotationSubgraph:["Cell cycle subgraph", "Cyclin-CDK subgraph"], annotationMeshdisease:["Atherosclerosis", "Arthritis", "Amyloidosis", "Alzheimer Disease"], pmid:"10760295", citationType:"PubMed", citationRef:"10760295"}}, {start: {_id:27}, end: {_id:567}, properties:{evidence:"The present findings are in line with the previous studies showing tau products cleaved by caspase-3, as recognized by s pecific tau-cleaved antibodies, in Alzheimer's disease and other tauopathies.", annotationSubgraph:["Caspase subgraph"], annotationMeshdisease:["Tauopathies", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"16496165", citationType:"PubMed", citationRef:"16496165"}}, {start: {_id:209}, end: {_id:567}, properties:{evidence:"The present findings are in line with the previous studies showing tau products cleaved by caspase-3, as recognized by s pecific tau-cleaved antibodies, in Alzheimer's disease and other tauopathies.", annotationSubgraph:["Caspase subgraph"], annotationMeshdisease:["Tauopathies", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"16496165", citationType:"PubMed", citationRef:"16496165"}}, {start: {_id:27}, end: {_id:214}, properties:{evidence:"Downregulation of extracellular signal-regulated kinase 1/2 activity by calmodulin KII modulates p21Cip1 levels and survival of immortalized lymphocytes from Alzheimer's disease patients.", annotationSubgraph:["MAPK-ERK subgraph"], annotationSpecies:["9606"], annotationCell:["lymphocyte"], annotationConfidence:["High"], pmid:"23153928", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23153928"}}] AS row
