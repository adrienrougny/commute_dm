UNWIND [{start: {_id:795}, end: {_id:460}, properties:{evidence:"Interaction of the protein reelin with the apolipoprotein E receptor (ApoER2) enhances Ca2+ influx through NMDA receptor channels by a mechanism involving a src family tyrosine kinsase (SFk); ApoE can block this effect of reelin", annotationSubgraph:["Low density lipoprotein subgraph", "Reelin signaling subgraph"], annotationConfidence:["High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}, {start: {_id:1671}, end: {_id:848}, properties:{evidence:"We tested the effects of native GIP and the agonist N-AcGIP on synaptic plasticity [long-term potentiation (LTP)] in the hippocampus [15 nmol, administered intracerebroventricularly (icv)] and report for the first time that both peptides have enhancing effects on LTP. In contrast, the antagonist of GIP, Pro(3)GIP (15 nmol icv), reduced LTP. Injection of beta-amyloid(25-35) (100 nmol), a peptide that aggregates in brains of AD patients, also impaired LTP. The injection of N-AcGIP (15 nmol icv) 30 min prior to injection of amyloid(25-35) (100 nmol icv) fully reversed the impairment of LTP induced by beta-amyloid. The results demonstrate for the first time that GIP (particularly enzyme- resistant forms) not only directly modulates neurotransmitter release and LTP formation, but also protects synapses from the detrimental effects of beta-amyloid fragments on LTP formation.", annotationSpecies:["10116"], pmid:"18234983", citationType:"PubMed", citationRef:"18234983"}}, {start: {_id:1671}, end: {_id:1673}, properties:{evidence:"We tested the effects of native GIP and the agonist N-AcGIP on synaptic plasticity [long-term potentiation (LTP)] in the hippocampus [15 nmol, administered intracerebroventricularly (icv)] and report for the first time that both peptides have enhancing effects on LTP. In contrast, the antagonist of GIP, Pro(3)GIP (15 nmol icv), reduced LTP. Injection of beta-amyloid(25-35) (100 nmol), a peptide that aggregates in brains of AD patients, also impaired LTP. The injection of N-AcGIP (15 nmol icv) 30 min prior to injection of amyloid(25-35) (100 nmol icv) fully reversed the impairment of LTP induced by beta-amyloid. The results demonstrate for the first time that GIP (particularly enzyme- resistant forms) not only directly modulates neurotransmitter release and LTP formation, but also protects synapses from the detrimental effects of beta-amyloid fragments on LTP formation.", annotationSpecies:["10116"], pmid:"18234983", citationType:"PubMed", citationRef:"18234983"}}, {start: {_id:21}, end: {_id:98}, properties:{evidence:"It may be inferred from these data that beta-secretase cleavage of FAD mutants of APP allows the appropriate caspase access to its site of action to produce C31, which directly causes neuronal apoptotic process.", annotationSubgraph:["Apoptosis signaling subgraph", "Beta secretase subgraph"], annotationConfidence:["High"], pmid:"11744168", citationType:"PubMed", citationRef:"11744168"}}, {start: {_id:3648}, end: {_id:3649}, properties:{evidence:"We have previously proposed that CLU-client complexes serve as vehicles to dispose of damaged misfolded extracellular proteins in vivo via receptor-mediated endocytosis", annotationSubgraph:["Non-amyloidogenic subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"19996109", citationType:"PubMed", citationRef:"19996109"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTLY_INCREASES]->(end) SET r += row.properties;
