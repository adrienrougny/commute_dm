UNWIND [{start: {_id:37}, end: {_id:123}, properties:{evidence:"It was reported that beta-catenin interacts with PSs, and that PS1 promotes beta-catenin degradation regulating phosphorylation by cyclin-dependent kinase 5 (CDK5) and GSK-3beta. Importantly, GSK-3beta was implicated in various neurological disorders, including AD.", annotationConfidence:["Medium"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:37}, end: {_id:117}, properties:{evidence:"It was reported that beta-catenin interacts with PSs, and that PS1 promotes beta-catenin degradation regulating phosphorylation by cyclin-dependent kinase 5 (CDK5) and GSK-3beta. Importantly, GSK-3beta was implicated in various neurological disorders, including AD.", annotationConfidence:["Medium"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:1420}, end: {_id:1197}, properties:{evidence:"ATXN1 functions as a genetic risk modifier that contributes to AD pathogenesis through a loss-of-function mechanism by regulating beta- secretase cleavage of APP and Abeta levels.", annotationSubgraph:["Beta secretase subgraph", "Akt subgraph"], annotationConfidence:["Medium"], pmid:"20097758", citationType:"PubMed", citationRef:"20097758"}}, {start: {_id:1561}, end: {_id:1563}, properties:{evidence:"Adiponectin regulates the sensitivity of insulin, fatty acid catabolism, glucose homeostasis and anti-inflammatory system through various mechanisms.", annotationSubgraph:["Insulin signal transduction", "Lipid metabolism subgraph", "Beta-Oxidation of Fatty Acids"], annotationConfidence:["Medium"], pmid:"24386594", citationType:"PubMed", citationRef:"24386594"}}, {start: {_id:122}, end: {_id:2595}, properties:{evidence:"Here, we show that GSK-3beta phosphorylates and regulates the activity of Bax, a pro-apoptotic Bcl-2 family member that stimulates the intrinsic (mitochondrial) death pathway by eliciting cytochrome c release from mitochondria.", annotationSubgraph:["GSK3 subgraph", "Bcl-2 subgraph"], annotationConfidence:["Medium"], pmid:"15525785", citationType:"PubMed", citationRef:"15525785"}}, {start: {_id:1365}, end: {_id:2602}, properties:{evidence:"alpha(2)M also regulates proteinase and growth factor activities", annotationSubgraph:["Alpha 2 macroglobulin subgraph"], annotationConfidence:["Medium"], pmid:"14678766", citationType:"PubMed", citationRef:"14678766"}}, {start: {_id:1420}, end: {_id:21}, properties:{evidence:"Regarding the underlying molecular mechanism, we show that the effect of ATXN1 expression on Abeta levels is pmodulated via beta-secretase cleavage of APP.", annotationSubgraph:["Beta secretase subgraph", "Akt subgraph"], annotationConfidence:["Medium"], pmid:"20139999", citationType:"PubMed", citationRef:"20139999"}}, {start: {_id:22}, end: {_id:2836}, properties:{evidence:"At the cellular level, we show that APP and CHT can be found in Rab5-positive endosomal compartments and that APP affects CHT endocytosis.", annotationSubgraph:["Acetylcholine signaling subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17709753", citationType:"PubMed", citationRef:"17709753"}}, {start: {_id:666}, end: {_id:21}, properties:{evidence:"Cellular prion protein regulates beta-secretase cleavage of the Alzheimer's amyloid precursor protein.", annotationSubgraph:["Beta secretase subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17573534", citationType:"PubMed", citationRef:"17573534"}}, {start: {_id:37}, end: {_id:123}, properties:{evidence:"It was reported that beta-catenin interacts with PSs, and that PS1 promotes beta-catenin degradation regulating phosphorylation by cyclin-dependent kinase 5 (CDK5) and GSK-3beta. Importantly, GSK-3beta was implicated in various neurological disorders, including AD", annotationSubgraph:["Beta-Catenin subgraph", "Gamma secretase subgraph"], annotationConfidence:["High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:37}, end: {_id:117}, properties:{evidence:"It was reported that beta-catenin interacts with PSs, and that PS1 promotes beta-catenin degradation regulating phosphorylation by cyclin-dependent kinase 5 (CDK5) and GSK-3beta. Importantly, GSK-3beta was implicated in various neurological disorders, including AD", annotationSubgraph:["Beta-Catenin subgraph", "Gamma secretase subgraph"], annotationConfidence:["High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:37}, end: {_id:215}, properties:{evidence:"PS1 also modulates basal level of ERK1/2 activity through a ras-Raf- MEK-dependent pathway activated by a direct binding with the SH2 domain of Grb2. ERK family is one of the most ubiquitous cellular signaling mechanisms, whose activation links extracellular stimuli to cell proliferation, survival, and differentiation, but also cell death and apoptotic process. In this respect, it is worth of note to observe, as mentioned above, that ERK1/2 pathway is also modulated by AbetaPP", annotationSubgraph:["Gamma secretase subgraph", "MAPK-ERK subgraph"], annotationConfidence:["Medium"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:365}, end: {_id:607}, properties:{evidence:"We find that NGF induces tyrosine phosphorylation of APP, and that APP interacts with TrkA and this interaction requires Y(682). Unpredictably, we also uncover that APP, and specifically Y(682), regulates activation of the NGF/TrkA signaling pathway in vivo, the subcellular distribution of TrkA and the sensitivity of neurons to the trophic action of NGF.", annotationSubgraph:["Nerve growth factor subgraph", "Non-amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21849536", citationType:"PubMed", citationRef:"21849536"}}] AS row
