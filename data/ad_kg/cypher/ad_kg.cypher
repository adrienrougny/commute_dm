UNWIND [{start: {_id:2177}, end: {_id:2175}, properties:{evidence:"Results from chromatin immunoprecipitation-quantitative polymerase chain reaction confirmed that ATF3 binds to the promoter region of the CCL4 gene, consistent with a potential role in regulating CCL4 transcription.", annotationSubgraph:["CREB subgraph", "Chemokine signaling subgraph"], annotationSpecies:["10090"], pmid:"24607962", citationType:"PubMed", citationRef:"24607962"}}] AS row
