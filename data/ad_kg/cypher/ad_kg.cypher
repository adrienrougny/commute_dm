idence:["High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}, {start: {_id:794}, end: {_id:795}, properties:{evidence:"Interaction of the protein reelin with the apolipoprotein E receptor (ApoER2) enhances Ca2+ influx through NMDA receptor channels by a mechanism involving a src family tyrosine kinsase (SFk); ApoE can block this effect of reelin", annotationSubgraph:["Low density lipoprotein subgraph", "Reelin signaling subgraph"], annotationConfidence:["High"], pmid:"18675468", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"18675468"}}] AS row
