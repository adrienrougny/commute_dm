UNWIND [{start: {_id:1117}, end: {_id:1116}, properties:{evidence:"since around 2005, this field literally exploded with new information and a new concept, i.e., that primary brain insulin resistance and insulin deficiency mediate cognitive impairment and AD. This idea was fueled by evidence that tau gene expression and phosphorylation are regulated through insulin and insulin-like growth factor (IGF) signaling cascades.23,24", annotationSubgraph:["Insulin signal transduction", "Tau protein subgraph"], annotationMeshanatomy:["Adipocytes"], annotationConfidence:["Medium"], pmid:"19885299", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:4952}, end: {_id:4953}, properties:{evidence:"Functional studies of the CCL20 promoter, using a series of 5'-deleted and mutated reporter constructs, demonstrated that CCL20 mRNA induction was dependent on gene transcription activation and mediated by the NF-kappaB pathway.", pmid:"19939449", citationType:"PubMed", citationRef:"19939449"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
