UNWIND [{start: {_id:1251}, end: {_id:98}, properties:{evidence:"One promising intervention is the use of the incretin hormone glucagon-like peptide-1 (GLP-1) as a treatment for neurodegenerative diseases [25] and [34]. GLP-1 enhances glucose-dependent insulin secretion and lowers blood glucose in subjects with T2DM [15]. Currently, the GLP-1 receptor agonist exenatide (Byetta) is approved for the treatment of T2DM, and many other GLP-1 analogues are in late stage clinical trials. GLP-1 also plays important roles in the brain. The GLP-1 receptor is expressed in neurons [19], and GLP-1 has growth factor-like properties and protects neurons from kainate-induced neurotoxicity [13] and [33], and of the effects of reduced NGF levels [3]. GLP-1 also reduces the induction of apoptosis of hippocampal neurons [13]", annotationSubgraph:["Glucagon subgraph", "Nerve growth factor subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["Medium"], pmid:"19573562", citationType:"PubMed", citationRef:"19573562"}}, {start: {_id:1358}, end: {_id:1344}, properties:{evidence:"Further, IDE expression is affected by aging, with IDE activity significantly decreased in both the muscles and liver of old animals as compared to young animals [76].", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Medium"], pmid:"16399206", citationType:"PubMed", citationRef:"16399206"}}, {start: {_id:1565}, end: {_id:1101}, properties:{evidence:"Previous studies demonstrated that adiponectin modulates memory and cognitive impairment and contributes to the deregulated glucose metabolism and mitochondrial dysfunction observed in Alzheimer's disease.", annotationSubgraph:["Lipid metabolism subgraph", "Beta-Oxidation of Fatty Acids"], annotationConfidence:["High"], pmid:"24386594", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24386594"}}, {start: {_id:1565}, end: {_id:636}, properties:{evidence:"Previous studies demonstrated that adiponectin modulates memory and cognitive impairment and contributes to the deregulated glucose metabolism and mitochondrial dysfunction observed in Alzheimer's disease.", annotationSubgraph:["Lipid metabolism subgraph", "Beta-Oxidation of Fatty Acids"], annotationConfidence:["High"], pmid:"24386594", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24386594"}}, {start: {_id:1151}, end: {_id:217}, properties:{evidence:"Insulin not only regulates blood sugar concentrations but also acts as a growth factor on all cell including neurons in the central nervous system [38]. Brain resistance to insulin/IGF-I accounts for neuronal atrophy and death, tangle formation and brain amyloidosis typical of AD pathology [47].", annotationSubgraph:["Insulin signal transduction"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"23557940", citationType:"PubMed", citationRef:"23557940"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:2510}, end: {_id:2515}, properties:{evidence:"Caspase-9 activation is mainly triggered by cytochrome c release from the mitochondria, which occurs at the asymptomatic stage prior to disease onset (Guebetagan et al., 2001). Cytochrome c, together with ATP/ADP, Apaf-1 and procaspase-9, forms a complex termed `apoptosome', in which caspase-9 is activated. Caspase-9 then cleaves procaspase-3 to generate active caspase-3. Both caspase-9 and caspase-3 cleave procaspase-9 to form an `amplication loop' of caspase-9 activation. XIAP does not inhibit `apoptosome' formation and its upstream events, but suppresses the downstream `amplibetacation loop' by inhibition of caspase-9 and -3. Therefore, the activation of caspase-9 preceded by cytochrome c release can occur in the presence of a potent caspase-9 inhibitor XIAP and be considered an indicator of disease onset, regardless of the level of caspase-9.", annotationSubgraph:["Electron transport chain", "Caspase subgraph", "XIAP subgraph"], annotationSpecies:["10090"], pmid:"14657037", citationType:"PubMed", citationRef:"14657037"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:2871}, end: {_id:2874}, properties:{evidence:"Overexpression of BAG-1 induced an increase in Tau levels, which is shown to be due to an inhibition of protein degradation.", annotationSubgraph:["Ubiquitin degradation subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"17954934", citationType:"PubMed", citationRef:"17954934"}}, {start: {_id:2871}, end: {_id:2874}, properties:{evidence:"We further show that BAG-1 can inhibit the degradation of Tau protein by the 20 S proteasome but does not affect the ubiquitination of Tau protein.", annotationSubgraph:["Ubiquitin degradation subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"17954934", citationType:"PubMed", citationRef:"17954934"}}, {start: {_id:2930}, end: {_id:2874}, properties:{evidence:"We found that suppression of Cdc37 destabilized tau, leading to its clearance, whereas Cdc37 overexpression preserved tau.", annotationSubgraph:["Chaperone subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"21367866", citationType:"PubMed", citationRef:"21367866"}}, {start: {_id:2940}, end: {_id:2941}, properties:{evidence:"Furthermore, phosphorylation of Presenilin 1 hinders epsilon-cleavage of N-cadherin, whereas epsilon-cleavage of APP remained unchanged.", annotationSubgraph:["Gamma secretase subgraph"], annotationConfidence:["High"], pmid:"17389597", citationType:"PubMed", citationRef:"17389597"}}, {start: {_id:540}, end: {_id:289}, properties:{evidence:"In the present study, we demonstrate that APP phosphorylated at Thr668 is less vulnerable to cytoplasmic cleavage by caspase-3 and caspase-8.", annotationSubgraph:["Caspase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15178331", citationType:"PubMed", citationRef:"15178331"}}, {start: {_id:174}, end: {_id:506}, properties:{evidence:"Alzheimer's disease is associated with impaired clearance of Abeta- amyloid from the brain, a process normally facilitated by apolipoprotein E (ApoE)", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"22323736", citationType:"PubMed", citationRef:"22323736"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
