UNWIND [{start: {_id:2540}, end: {_id:2551}, properties:{evidence:"The multiple actions of riluzole on a variety of neuronal cation channels, including block of Na+ and Ca2+ channels and activation of K+ channels, would all be expected to contribute to decreased excitability and decreased transmitter release.", pmid:"15378511", citationType:"PubMed", citationRef:"15378511"}}, {start: {_id:1787}, end: {_id:991}, properties:{evidence:"Rivastigmine shifts APP processing toward the Î±-secretase pathway. Together, these results suggest that rivastigmine alters the activities of the Î±- and beta-secretase pathways in favor of sAPPÎ± production.", annotationSubgraph:["Non-amyloidogenic subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"21799757", citationType:"PubMed", citationRef:"21799757"}}, {start: {_id:1787}, end: {_id:1479}, properties:{evidence:"Thus, we propose that elevated hippocampal ACh levels observed in OBX mice after rivastigmine treatment increase 5-HT levels and underlie neurogenesis via ERK and Akt activation in the DG. We observed inhibition of rivastigmine-induced phosphorylation of Akt (Ser-473) and ERK following WAY-100635 administration. We conclude that stimulation of the 5-HT1A receptor induced by rivastigmine accounts for hippocampal neurogenesis.", annotationSubgraph:["MAPK-ERK subgraph"], pmid:"24797332", citationType:"PubMed", citationRef:"24797332"}}, {start: {_id:1787}, end: {_id:1290}, properties:{evidence:"Thus, we propose that elevated hippocampal ACh levels observed in OBX mice after rivastigmine treatment increase 5-HT levels and underlie neurogenesis via ERK and Akt activation in the DG. We observed inhibition of rivastigmine-induced phosphorylation of Akt (Ser-473) and ERK following WAY-100635 administration. We conclude that stimulation of the 5-HT1A receptor induced by rivastigmine accounts for hippocampal neurogenesis.", annotationSubgraph:["Akt subgraph"], pmid:"24797332", citationType:"PubMed", citationRef:"24797332"}}, {start: {_id:1787}, end: {_id:2380}, properties:{evidence:"Thus, we propose that elevated hippocampal ACh levels observed in OBX mice after rivastigmine treatment increase 5-HT levels and underlie neurogenesis via ERK and Akt activation in the DG. We observed inhibition of rivastigmine-induced phosphorylation of Akt (Ser-473) and ERK following WAY-100635 administration. We conclude that stimulation of the 5-HT1A receptor induced by rivastigmine accounts for hippocampal neurogenesis.", annotationSubgraph:["Serotonergic subgraph"], pmid:"24797332", citationType:"PubMed", citationRef:"24797332"}}, {start: {_id:1787}, end: {_id:2567}, properties:{evidence:"The cells were exposed to various concentrations of rivastigmine to determine whether the drug protected cells from toxic injury and induced the 1st phase of the cellular heat shock response. In all, 100-Î¼mol/L rivastigmine decreases cell death by 40% compared with untreated cells. This concentration enhances Hsf1 activation by strengthening both its multimerization and its phosphorylation, which leads to increased messenger RNA (mRNA) for hsp70. Therefore, one of the putative neuroprotective mechanisms of rivastigmine seems to be mediated through the heat shock response.", annotationSubgraph:["Chaperone subgraph"], annotationConfidence:["Medium"], pmid:"18692909", citationType:"PubMed", citationRef:"18692909"}}, {start: {_id:1787}, end: {_id:2583}, properties:{evidence:"Taken together, the stimulation of CaMKII activity in the hippocampus is essential for rivastigmine-induced memory improvement in OBX mice.", pmid:"24164423", citationType:"PubMed", citationRef:"24164423"}}, {start: {_id:2590}, end: {_id:1131}, properties:{evidence:"Activation of PI3K after CsA treatment appeared to trigger opposite effects. First, CsA induced PI3K-dependent activation of Akt, which mediated cellular responses against cell injury. Akt activation led to transient phosphorylation and inhibition of the pro-apoptotic GSK3beta and Bad, thus preventing GSK3beta-mediated phosphorylation and activation of the pro-apoptotic Bax, and Bad-sequestering of Bcl-2.", annotationSubgraph:["GSK3 subgraph", "Bcl-2 subgraph"], annotationConfidence:["High"], pmid:"16316932", citationType:"PubMed", citationRef:"16316932"}}, {start: {_id:2678}, end: {_id:991}, properties:{evidence:"Moreover, NPD1 suppresses Abeta42 peptide shedding by down-regulating beta-secretase-1 (BACE1) while activating the beta-secretase ADAM10 and up-regulating sAPPalpha, thus shifting the cleavage of betaAPP holoenzyme from an amyloidogenic into the non-amyloidogenic pathway.", annotationSubgraph:["ADAM Metallopeptidase subgraph", "Non-amyloidogenic subgraph", "Beta secretase subgraph", "Neuroprotection subgraph"], annotationConfidence:["Medium"], pmid:"21246057", citationType:"PubMed", citationRef:"21246057"}}, {start: {_id:2678}, end: {_id:991}, properties:{evidence:"We also show that NPD1 downregulates Abeta42-triggered expression of the pro-inflammatory enzyme cyclooxygenase-2 (COX-2) and of B-94 (a TNF-alpha-inducible pro-inflammatory element) and apoptosis in HNG cells. Moreover, NPD1 suppresses Abeta42 peptide shedding by down- regulating beta-secretase-1 (BACE1) while activating the beta- secretase ADAM10 and up-regulating sAPPalpha, thus shifting the cleavage of betaAPP holoenzyme from an amyloidogenic into the non- amyloidogenic pathway.", annotationSubgraph:["ADAM Metallopeptidase subgraph", "Neuroprotection subgraph"], annotationConfidence:["Medium"], pmid:"21246057", citationType:"PubMed", citationRef:"21246057"}}, {start: {_id:2678}, end: {_id:991}, properties:{evidence:"In human neural cells overexpressing beta-amyloid precursor protein (betaAPP), the lipid mediator suppressed Abeta42 shedding by downregulating beta-secretase (BACE1) while activating the alpha- secretase (ADAM10), thus shifting the alphaAPP cleavage from the noxious amyloidogenic pathway into a non-amyloidogenic, neurotrophic pathway.", annotationSubgraph:["ADAM Metallopeptidase subgraph", "Non-amyloidogenic subgraph", "Beta secretase subgraph", "Neuroprotection subgraph"], annotationConfidence:["Medium"], pmid:"21431475", citationType:"PubMed", citationRef:"21431475"}}, {start: {_id:2761}, end: {_id:21}, properties:{evidence:"We previously showed that the glycosaminoglycan (GAG) heparin can increase the enzyme activity of proBACE1.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"20067575", citationType:"PubMed", citationRef:"20067575"}}, {start: {_id:2784}, end: {_id:21}, properties:{evidence:"Heparin can promote beta-secretase cleavage of APP in neuroblastoma cells.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16716081", citationType:"PubMed", citationRef:"16716081"}}, {start: {_id:2784}, end: {_id:21}, properties:{evidence:"Heparin promotes beta-secretase cleavage of the Alzheimer's amyloid precursor protein.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"9152995", citationType:"PubMed", citationRef:"9152995"}}, {start: {_id:93}, end: {_id:211}, properties:{evidence:"In the second phase, Cdk5 activates c-Jun via ROS-mediated activation of JNK. Rapid c-Jun activation is supported by in vivo data showing c-Jun phosphorylation in cerebral cortex upon p25 induction in transgenic mice.", annotationSubgraph:["MAPK-JNK subgraph", "Cyclin-CDK subgraph"], pmid:"19776350", citationType:"PubMed", citationRef:"19776350"}}, {start: {_id:2993}, end: {_id:2994}, properties:{evidence:"The basal kinase activities of protein kinase-A (PKA), CaM Kinase II and GSK-3 were stimulated more than two-fold by isoproterenol, bradykinin and wortmannin, respectively.", annotationSubgraph:["Tau protein subgraph"], annotationConfidence:["High"], pmid:"17120162", citationType:"PubMed", citationRef:"17120162"}}, {start: {_id:2995}, end: {_id:1383}, properties:{evidence:"The basal kinase activities of protein kinase-A (PKA), CaM Kinase II and GSK-3 were stimulated more than two-fold by isoproterenol, bradykinin and wortmannin, respectively.", annotationSubgraph:["Calcium-dependent signal transduction"], annotationConfidence:["High"], pmid:"17120162", citationType:"PubMed", citationRef:"17120162"}}, {start: {_id:2409}, end: {_id:123}, properties:{evidence:"The basal kinase activities of protein kinase-A (PKA), CaM Kinase II and GSK-3 were stimulated more than two-fold by isoproterenol, bradykinin and wortmannin, respectively.", annotationSubgraph:["GSK3 subgraph"], annotationConfidence:["High"], pmid:"17120162", citationType:"PubMed", citationRef:"17120162"}}, {start: {_id:2993}, end: {_id:116}, properties:{evidence:"We found that cdk5 activity was co-stimulated with PKA by isoproterenol.", annotationSubgraph:["Cyclin-CDK subgraph"], annotationConfidence:["High"], pmid:"17120162", citationType:"PubMed", citationRef:"17120162"}}, {start: {_id:43}, end: {_id:568}, properties:{evidence:"Chelation of intracellular Ca(2+) markedly suppressed APP-induced activation of caspase-3.", annotationSubgraph:["Caspase subgraph"], annotationConfidence:["Medium"], pmid:"12425945", citationType:"PubMed", citationRef:"12425945"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:3}, end: {_id:123}, properties:{evidence:"In the present review, we discuss our initial in vitro results and additional investigations showing that Abeta activates GSK-3beta through impairment of phosphatidylinositol-3 (PI3)/Akt signaling; that Abeta-activated GSK-3beta induces hyperphosphorylation of tau, NFT formation, neuronal death, and synaptic loss (all found in the AD brain); that GSK-3beta can induce memory deficits in vivo; and that inhibition of GSK-3alpha (an isoform of GSK-3beta) reduces Abeta production.", annotationSubgraph:["Tau protein subgraph", "Amyloidogenic subgraph", "GSK3 subgraph"], annotationConfidence:["High"], pmid:"16914869", citationType:"PubMed", citationRef:"16914869"}}, {start: {_id:3}, end: {_id:121}, properties:{evidence:"Compared to vehicle, Abeta increased GSK3 activity, and was associated with elevations in levels of ptau, caspase-3, the tau kinase phospho- c-jun N-terminal kinase (pJNK), neuronal DNA fragmentation, and gliosis.", annotationSubgraph:["Amyloidogenic subgraph", "GSK3 subgraph"], annotationConfidence:["Medium"], pmid:"19038340", citationType:"PubMed", citationRef:"19038340"}}, {start: {_id:3}, end: {_id:2000}, properties:{evidence:"The receptor activation assays revealed that apoE as well as beta amyloid activated the CASR and that the level of activation appeared to be isoform dependent for apoE.", annotationSubgraph:["Calcium-dependent signal transduction", "Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"19035514", citationType:"PubMed", citationRef:"19035514"}}, {start: {_id:43}, end: {_id:912}, properties:{evidence:"The induction of long-term potentiation at CA3-CA1 synapses is caused by an N-methyl-d-aspartate (NMDA) receptordependent accumulation of intracellular Ca(2+), followed by Src family kinase activation and a positive feedback enhancement of NMDA receptors (NMDARs). Nevertheless, the amplitude of baseline transmission remains remarkably constant even though low frequency stimulation is also associated with an NMDAR-dependent influx of Ca(2+) into dendritic spines. We show here that an interaction between C-terminal Src kinase (Csk) and NMDARs controls the Src-dependent regulation of NMDAR activity. Csk associates with the NMDAR signaling complex in the adult brain, inhibiting the Src-dependent potentiation of NMDARs in CA1 neurons and attenuating the Src-dependent induction of long-term potentiation. Csk associates directly with Src-phosphorylated NR2 subunits in vitro. An inhibitory antibody for Csk disrupts this physical association, potentiates NMDAR mediated excitatory postsynaptic currents, and induces long-term potentiation at CA3-CA1 synapses. Thus, Csk serves to maintain the constancy of baseline excitatory synaptic transmission by inhibiting Src kinase-dependent synaptic plasticity in the hippocampus", annotationSubgraph:["NMDA receptor"], pmid:"18445593", citationType:"PubMed", citationRef:"18445593"}}, {start: {_id:43}, end: {_id:2780}, properties:{evidence:"Protein kinase C: PKC is part of a multigene family of serine- threonine kinases central to many signal transduction pathways [138] with a prominent role in memory [139]. It is likely that ABeta¸-induced increases in cytosolic Ca2+ signals are transmitted to PKC for PKC-mediated transcriptional activation. In addition, PKC activates ERK by interacting with Ras or Raf-1 [140] to initiate CREB phosphorylation. While PKC levels decline in AD [141], their activation restores K+ channel function in cells from AD patients [142]. In addition, activation of PKC directly or indirectly enhances the a-processing cleavage of APP [143].", annotationSubgraph:["MAPK-ERK subgraph"], annotationConfidence:["High"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:3892}, end: {_id:3716}, properties:{evidence:"The increase in intracellular copper was correlated with a dramatic and rapid decrease in levels of extracellular ABeta¸ including ABeta¸1Ã¢â‚¬â€œ40 and 1Ã¢â‚¬â€œ42. It has been previously reported that CQ/copper complexes trigger the activation of PI3K and its downstream modulator Akt and the inhibition of glycogen synthase kinase 3 that in turn potentiated ERK1/2 phosphorylation.It is not clear if and how environmental factors take part to pathway discussed in this review, in which both ABeta¸PP and PS1 participate in the same signaling pathway leading, through Grb2 binding, to ERK1/2 activation and neurodegeneration. However, we may speculate that ERK1/2 activation by copper may contribute to the signal transduction system activated by ABeta¸PP, and PSs.", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], annotationConfidence:["High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686 "}}, {start: {_id:3892}, end: {_id:1131}, properties:{evidence:"The increase in intracellular copper was correlated with a dramatic and rapid decrease in levels of extracellular ABeta¸ including ABeta¸1Ã¢â‚¬â€œ40 and 1Ã¢â‚¬â€œ42. It has been previously reported that CQ/copper complexes trigger the activation of PI3K and its downstream modulator Akt and the inhibition of glycogen synthase kinase 3 that in turn potentiated ERK1/2 phosphorylation.It is not clear if and how environmental factors take part to pathway discussed in this review, in which both ABeta¸PP and PS1 participate in the same signaling pathway leading, through Grb2 binding, to ERK1/2 activation and neurodegeneration. However, we may speculate that ERK1/2 activation by copper may contribute to the signal transduction system activated by ABeta¸PP, and PSs.", annotationSubgraph:["Akt subgraph"], annotationConfidence:["High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686 "}}, {start: {_id:4036}, end: {_id:4038}, properties:{evidence:"As the levels of proinflammatory prostaglandins increase, PGT must also increase to maintain clearance of the/ prostaglandins and prevent additional inflammation. Because our data indicate lower than normal levels of PGT protein in AD/ brains, it is possible that the prostaglandins might not be cleared fast enough to limit the inflammatory cascade, which/ then could lead to neuronal cell death; however more work addressing this specific question is warranted.", annotationSubgraph:["Prostaglandin subgraph"], pmid:"18353443", citationType:"PubMed", citationRef:"18353443"}}, {start: {_id:3}, end: {_id:4049}, properties:{evidence:"increased production of amyloid-beta peptide species can activate the innate immunity system via pattern recognition receptors (PRRs) and evoke Alzheimer's pathology. We will focus on the role of innate immunity system of brain in the initiation and the propagation of inflammatory process in AD. We examine here in detail the significance of amyloid-beta oligomers and fibrils as danger-associated molecular patterns (DAMPs) in the activation of a wide array of PRRs in glial cells and neurons, such as Toll-like, NOD-like, formyl peptide, RAGE and scavenger receptors along with complement and pentraxin systems.", annotationSubgraph:["Inflammatory response subgraph", "Toll like receptor subgraph"], annotationConfidence:["Very High"], pmid:"19388207", citationType:"PubMed", citationRef:"19388207"}}, {start: {_id:3}, end: {_id:4050}, properties:{evidence:"increased production of amyloid-beta peptide species can activate the innate immunity system via pattern recognition receptors (PRRs) and evoke Alzheimer's pathology. We will focus on the role of innate immunity system of brain in the initiation and the propagation of inflammatory process in AD. We examine here in detail the significance of amyloid-beta oligomers and fibrils as danger-associated molecular patterns (DAMPs) in the activation of a wide array of PRRs in glial cells and neurons, such as Toll-like, NOD-like, formyl peptide, RAGE and scavenger receptors along with complement and pentraxin systems.", annotationSubgraph:["Inflammatory response subgraph", "Toll like receptor subgraph"], annotationConfidence:["Very High"], pmid:"19388207", citationType:"PubMed", citationRef:"19388207"}}, {start: {_id:3}, end: {_id:4052}, properties:{evidence:"increased production of amyloid-beta peptide species can activate the innate immunity system via pattern recognition receptors (PRRs) and evoke Alzheimer's pathology. We will focus on the role of innate immunity system of brain in the initiation and the propagation of inflammatory process in AD. We examine here in detail the significance of amyloid-beta oligomers and fibrils as danger-associated molecular patterns (DAMPs) in the activation of a wide array of PRRs in glial cells and neurons, such as Toll-like, NOD-like, formyl peptide, RAGE and scavenger receptors along with complement and pentraxin systems.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19388207", citationType:"PubMed", citationRef:"19388207"}}, {start: {_id:3}, end: {_id:4053}, properties:{evidence:"increased production of amyloid-beta peptide species can activate the innate immunity system via pattern recognition receptors (PRRs) and evoke Alzheimer's pathology. We will focus on the role of innate immunity system of brain in the initiation and the propagation of inflammatory process in AD. We examine here in detail the significance of amyloid-beta oligomers and fibrils as danger-associated molecular patterns (DAMPs) in the activation of a wide array of PRRs in glial cells and neurons, such as Toll-like, NOD-like, formyl peptide, RAGE and scavenger receptors along with complement and pentraxin systems.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19388207", citationType:"PubMed", citationRef:"19388207"}}, {start: {_id:3}, end: {_id:4055}, properties:{evidence:"increased production of amyloid-beta peptide species can activate the innate immunity system via pattern recognition receptors (PRRs) and evoke Alzheimer's pathology. We will focus on the role of innate immunity system of brain in the initiation and the propagation of inflammatory process in AD. We examine here in detail the significance of amyloid-beta oligomers and fibrils as danger-associated molecular patterns (DAMPs) in the activation of a wide array of PRRs in glial cells and neurons, such as Toll-like, NOD-like, formyl peptide, RAGE and scavenger receptors along with complement and pentraxin systems.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19388207", citationType:"PubMed", citationRef:"19388207"}}, {start: {_id:3}, end: {_id:2655}, properties:{evidence:"increased production of amyloid-beta peptide species can activate the innate immunity system via pattern recognition receptors (PRRs) and evoke Alzheimer's pathology. We will focus on the role of innate immunity system of brain in the initiation and the propagation of inflammatory process in AD. We examine here in detail the significance of amyloid-beta oligomers and fibrils as danger-associated molecular patterns (DAMPs) in the activation of a wide array of PRRs in glial cells and neurons, such as Toll-like, NOD-like, formyl peptide, RAGE and scavenger receptors along with complement and pentraxin systems.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19388207", citationType:"PubMed", citationRef:"19388207"}}, {start: {_id:3}, end: {_id:220}, properties:{evidence:"increased production of amyloid-beta peptide species can activate the innate immunity system via pattern recognition receptors (PRRs) and evoke Alzheimer's pathology. We will focus on the role of innate immunity system of brain in the initiation and the propagation of inflammatory process in AD. We examine here in detail the significance of amyloid-beta oligomers and fibrils as danger-associated molecular patterns (DAMPs) in the activation of a wide array of PRRs in glial cells and neurons, such as