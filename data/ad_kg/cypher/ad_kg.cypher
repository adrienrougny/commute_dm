ph:["Beta secretase subgraph", "miRNA subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21785276", citationType:"PubMed", citationRef:"21785276"}}, {start: {_id:1496}, end: {_id:21}, properties:{evidence:"Such possibility is further corroborated by the observation that a significant decrease in miR-106b expression was found in sporadic AD patients.On the other hand, two miRNAs (miR-298 and miR-328) was found to regulate BACE mRNA translation, while BACE was responsible for APP processing and Abeta production", annotationSubgraph:["Beta secretase subgraph", "miRNA subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"21785276", citationType:"PubMed", citationRef:"21785276"}}] AS row
