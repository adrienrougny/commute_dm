UNWIND [{start: {_id:1149}, end: {_id:27}, properties:{evidence:"The genes for both the beta-amyloid precursor protein and apolipoprotein E (ApoE) have been linked to Alzheimer's disease.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["High"], pmid:"9202294", citationType:"PubMed", citationRef:"9202294"}}, {start: {_id:669}, end: {_id:27}, properties:{evidence:"The genes for both the beta-amyloid precursor protein and apolipoprotein E (ApoE) have been linked to Alzheimer's disease.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["High"], pmid:"9202294", citationType:"PubMed", citationRef:"9202294"}}, {start: {_id:2837}, end: {_id:2838}, properties:{evidence:"SORCS1 is also genetically associated with types 1 and 2 diabetes mellitus (T1DM, T2DM).", pmid:"20881129", citationType:"PubMed", citationRef:"20881129"}}, {start: {_id:2837}, end: {_id:1098}, properties:{evidence:"SORCS1 is also genetically associated with types 1 and 2 diabetes mellitus (T1DM, T2DM).", pmid:"20881129", citationType:"PubMed", citationRef:"20881129"}}, {start: {_id:4541}, end: {_id:27}, properties:{evidence:"RHDBF2 was found to be part of the same network of interacting proteins as the Alzheimer's risk gene PTK2B, suggesting a potential role in microglia and macrophage activity.", annotationSubgraph:["Regulation of actin cytoskeleton subgraph", "Vascular endothelial growth factor subgraph"], pmid:"25157507", citationType:"PubMed", citationRef:"25157507"}}, {start: {_id:680}, end: {_id:27}, properties:{evidence:"cg02308560 in the ABCA7 locus is associated to AD pathology", annotationSubgraph:["ATP binding cassette transport subgraph"], pmid:"25129075", citationType:"PubMed", citationRef:"25129075"}}] AS row
