UNWIND [{start: {_id:215}, end: {_id:432}, properties:{evidence:"PS1 also modulates basal level of ERK1/2 activity through a ras-Raf- MEK-dependent pathway activated by a direct binding with the SH2 domain of Grb2. ERK family is one of the most ubiquitous cellular signaling mechanisms, whose activation links extracellular stimuli to cell proliferation, survival, and differentiation, but also cell death and apoptotic process. In this respect, it is worth of note to observe, as mentioned above, that ERK1/2 pathway is also modulated by AbetaPP", annotationSubgraph:["Cytokine signaling subgraph", "MAPK-ERK subgraph"], annotationConfidence:["High"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:1092}, end: {_id:1090}, properties:{evidence:"Abnormal phosphorylation of tau and activation of mu-calpain are two key events in the pathology of AD. Importantly, these two events are also related with GCs and IR. We therefore speculate that tau phosphorylation and mu-calpain activation may mediate the GCs-induced IR. Akt phosphorylation at Ser-473 (pAkt) is commonly used as a marker for assessing IR.", annotationSubgraph:["Insulin signal transduction", "Calpastatin-calpain subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"22536436", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22536436"}}, {start: {_id:1191}, end: {_id:1189}, properties:{evidence:"BACE1 transcription has recently been reported to be regulated by the PPARgamma pathway (36). We now demonstrate that the diabetes drug metformin can also modulate BACE1 transcription, likely independently of the PPARgamma pathway despite the presence of several PPAR/RXR binding sites in the promoter (31, 32). Metformin-mediated transcriptional activation of BACE1 appears to depended on a pathway involving AMPK.", annotationSubgraph:["Beta secretase subgraph", "Peroxisome proliferator activated receptor subgraph"], annotationConfidence:["Medium"], pmid:"19237574", citationType:"PubMed", citationRef:"19237574"}}, {start: {_id:215}, end: {_id:3}, properties:{evidence:"CerebraiiR/IGF-1 signaling in APP metabolism. Binding of insulin and IGF-1 to their receptors leads to autophosphorylation of the -subunit of the IR/IGF-IR and recruitment of IRS-1 /-2. IRS proteins activate mainly two pathways, the PI3 kinase pathway, and the RAS-RAF-MAP kinase cascade. Tau phosphorylation via IR/IGF-1 signaling is influenced by GSK-3 and the tau phosphatase PP2A. InterÂ­ estingly, mTOR signaling couples the activity ofPP2A and GSK-3in a way that the activities of both enzymes change always in the same direction. suggesting that only a dysregulation of either PP2A or GSK-3induces tau hyperphosphorylation. The PI3K pathway as well as the RAS-RAF-MAPK cascade regulate different transcription factors involved in transcriptional regulation of metabolism and clearance of Â­ amyloid. APP is cleaved by a.-, -secretase (BACE-1) and y-secretase (presenilin). - and subsequent y-cleavage of APP leads to generation of -amyloid 1 -4o/ t-42â€¢ IGF-1 signaling promotes a switch lrom TrkA to p75NTR expression leading to increased -secretase activity due to an upregulation of BACE-1 expression. Recent data suggest that not only BACE-1 is int1uenced by IRIIGF- IR mediated signals but also a.Â­ secretase activity is stimulated by the PI3K pathway.", annotationSubgraph:["Amyloidogenic subgraph", "MAPK-ERK subgraph"], annotationConfidence:["Medium"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:1152}, end: {_id:3}, properties:{evidence:"This abnormality along with a reduction in brain insulin concentration is assumed to induce a cascade-like process of disturbances including cellular glucose, acetylcholine, cholesterol, and ATP associated with abnormalities in membrane pathology and the formation of both amyloidogenic derivatives and hyperphosphorylated tau protein.", annotationSubgraph:["Insulin signal transduction", "Amyloidogenic subgraph"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"11956956", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"11956956"}}, {start: {_id:206}, end: {_id:1622}, properties:{evidence:"Acetylcholinesterase (AChE), an enzyme involved in the hydrolysis of the neurotransmitter acetylcholine, consistently colocalizes with the amyloid deposits characteristic of Alzheimer's disease and may contribute to the generation of amyloid proteins and/or physically affect fibril assembly.", annotationSubgraph:["Acetylcholine signaling subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"9325095", citationType:"PubMed", citationRef:"9325095"}}, {start: {_id:116}, end: {_id:3}, properties:{evidence:"Cyclin-dependent kinase 5 (Cdk5) activity is significantly increased in AD and contributes to all three hallmarks: neurotoxic amyloid-beta (Abeta), neurofibrillary tangles (NFT), and extensive cell death.", annotationSubgraph:["Amyloidogenic subgraph", "Cyclin-CDK subgraph"], annotationConfidence:["Medium"], pmid:"21389115", citationType:"PubMed", citationRef:"21389115"}}, {start: {_id:4140}, end: {_id:432}, properties:{evidence:"These results indicated that cultured human astrocytes express a distinct set of NF-kB-target cytokines and chemokines in resting and activated conditions, suggesting that the NF-kB signaling pathway differentially regulates gene expression of cytokines and chemokines in human astrocytes under physiological and inflammatory conditions.", annotationSubgraph:["Cytokine signaling subgraph", "Nuclear factor Kappa beta subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["Medium"], pmid:"24691121", citationType:"PubMed", citationRef:"24691121"}}, {start: {_id:4140}, end: {_id:4029}, properties:{evidence:"These results indicated that cultured human astrocytes express a distinct set of NF-kB-target cytokines and chemokines in resting and activated conditions, suggesting that the NF-kB signaling pathway differentially regulates gene expression of cytokines and chemokines in human astrocytes under physiological and inflammatory conditions.", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "Chemokine signaling subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["Medium"], pmid:"24691121", citationType:"PubMed", citationRef:"24691121"}}, {start: {_id:1131}, end: {_id:4156}, properties:{evidence:"Furthermore, cellular signaling experiments showed that Pls enhanced phosphorylation of the phosphoinositide 3-kinase (PI3K)-dependent serine/threonine-specific protein kinase AKT and extracellular-signal- regulated kinases ERK1/2.", annotationMeshanatomy:["Serum"], annotationConfidence:["Medium"], pmid:"24357806", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24357806"}}, {start: {_id:2563}, end: {_id:4171}, properties:{evidence:"Structure of N-terminal sequence Asp-Ala-Glu-Phe-Arg-His-Asp-Ser of Abeta-peptide with phospholipase A2 from venom of Andaman Cobra sub- species Naja naja sagittifera at 2.0 Ã… resolution.", annotationMeshanatomy:["Venoms"], annotationConfidence:["Medium"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:2563}, end: {_id:4173}, properties:{evidence:"Structure of N-terminal sequence Asp-Ala-Glu-Phe-Arg-His-Asp-Ser of Abeta-peptide with phospholipase A2 from venom of Andaman Cobra sub- species Naja naja sagittifera at 2.0 Ã… resolution.", annotationMeshanatomy:["Venoms"], annotationConfidence:["Medium"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:2563}, end: {_id:4172}, properties:{evidence:"Structure of N-terminal sequence Asp-Ala-Glu-Phe-Arg-His-Asp-Ser of Abeta-peptide with phospholipase A2 from venom of Andaman Cobra sub- species Naja naja sagittifera at 2.0 Ã… resolution.", annotationMeshanatomy:["Venoms"], annotationConfidence:["Medium"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:2563}, end: {_id:4171}, properties:{evidence:"In the current communication, we report the structure determined by X-ray crystallography of N-terminal sequence Asp-Ala-Glu-Phe-Arg-His- Asp-Ser (DAEFRHDS) of Abeta-peptide with a Group I PLA2 purified from venom of Andaman Cobra sub-species Naja naja sagittifera at 2.0 Ã… resolution (Protein Data Bank (PDB) Code: 3JQ5).", annotationMeshanatomy:["Venoms"], annotationConfidence:["Medium"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:2563}, end: {_id:4173}, properties:{evidence:"In the current communication, we report the structure determined by X-ray crystallography of N-terminal sequence Asp-Ala-Glu-Phe-Arg-His- Asp-Ser (DAEFRHDS) of Abeta-peptide with a Group I PLA2 purified from venom of Andaman Cobra sub-species Naja naja sagittifera at 2.0 Ã… resolution (Protein Data Bank (PDB) Code: 3JQ5).", annotationMeshanatomy:["Venoms"], annotationConfidence:["Medium"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:2563}, end: {_id:4172}, properties:{evidence:"In the current communication, we report the structure determined by X-ray crystallography of N-terminal sequence Asp-Ala-Glu-Phe-Arg-His- Asp-Ser (DAEFRHDS) of Abeta-peptide with a Group I PLA2 purified from venom of Andaman Cobra sub-species Naja naja sagittifera at 2.0 Ã… resolution (Protein Data Bank (PDB) Code: 3JQ5).", annotationMeshanatomy:["Venoms"], annotationConfidence:["Medium"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}] AS row
