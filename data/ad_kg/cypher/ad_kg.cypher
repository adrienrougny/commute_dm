UNWIND [{start: {_id:1210}, end: {_id:1211}, properties:{evidence:"Genes such as enolase, tetanus toxin receptor, and the A2B5 antigen initially found in the nervous system were later found to be expressed in beta-cells (3). Another group of genes normally expressed in islet of Langerhans has been shown to be present in the nervous system. Some of these genes are only temporally expressed in the developing brain, such as insulin and the transcription factor IDX-1 (islet and duodenum homeobox-1) [PDX-1 (pancreatic and duodenal homeobox-1)] (4, 5, 6, 7), whereas other genes are permanently expressed, such as the genes for ATP-sensitive K+ channel (8, 9) and the LIM (Lin-11, Isl-1, and Mec-3) homeodomain protein islet-1 (10).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Medium"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:1210}, end: {_id:949}, properties:{evidence:"Genes such as enolase, tetanus toxin receptor, and the A2B5 antigen initially found in the nervous system were later found to be expressed in beta-cells (3). Another group of genes normally expressed in islet of Langerhans has been shown to be present in the nervous system. Some of these genes are only temporally expressed in the developing brain, such as insulin and the transcription factor IDX-1 (islet and duodenum homeobox-1) [PDX-1 (pancreatic and duodenal homeobox-1)] (4, 5, 6, 7), whereas other genes are permanently expressed, such as the genes for ATP-sensitive K+ channel (8, 9) and the LIM (Lin-11, Isl-1, and Mec-3) homeodomain protein islet-1 (10).", annotationSubgraph:["Insulin signal transduction"], annotationMeshanatomy:["Nervous System"], annotationConfidence:["Low"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
