UNWIND [{start: {_id:289}, end: {_id:3}, properties:{evidence:"Alzheimer's disease (AD), one of the major causes of disability and mortality in Western societies, is a progressive age-related neurodegenerative disorder. Increasing evidence suggests that the etiology of AD may involve disruptions of zinc (Zn) homeostasis. This review discusses current evidence supporting a potential role of Zn and zinc transporters (ZnTs) in processing of the amyloid beta protein precursor (APP) and amyloid beta (Abeta) peptide generation and aggregation.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Very High"], pmid:"22447723", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22447723"}}, {start: {_id:289}, end: {_id:3}, properties:{evidence:"Abeta is derived from proteolytic processing of the amyloid precursor protein (APP), which interacts with several members of the LDLR family.", annotationSubgraph:["Low density lipoprotein subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17185504", citationType:"PubMed", citationRef:"17185504"}}] AS row
