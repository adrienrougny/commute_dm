UNWIND [{start: {_id:2718}, end: {_id:961}, properties:{evidence:"Medium", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["High"], pmid:"17077814", citationType:"PubMed", citationRef:"17077814"}}, {start: {_id:2800}, end: {_id:466}, properties:{evidence:"Additionally, coexpression with PS2 resulted in a decrease of APP secretion, suggesting a direct participation of presenilins in the intracellular sorting, trafficking and processing of APP molecule", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"9055862", citationType:"PubMed", citationRef:"9055862"}}] AS row
