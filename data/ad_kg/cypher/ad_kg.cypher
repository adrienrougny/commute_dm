UNWIND [{start: {_id:187}, end: {_id:598}, properties:{evidence:"Hydrogen peroxide was reported to initiate the apoptotic cascade by perturbing the intracellular redox balance. GSH is the most abundant low molecular weight thiol that maintains cellular redox homeostasis", annotationSubgraph:["Glutathione reductase subgraph"], annotationConfidence:["High"], pmid:"17213958", citationType:"PubMed", citationRef:"17213958"}}, {start: {_id:17}, end: {_id:370}, properties:{evidence:"Taken together, our results identify the AICD as a novel inhibitory factor of the canonical Wnt signalling pathway and suggest its regulatory role in neuronal cell proliferation and differentiation.", annotationSubgraph:["Wnt signaling subgraph"], annotationConfidence:["Medium"], pmid:"22613765", citationType:"PubMed", citationRef:"22613765"}}, {start: {_id:921}, end: {_id:193}, properties:{evidence:"absence of CPE leads to degeneration of the CA3 neurons and perturbation of the cytoarchitecture of the hippocampus. Ex vivo studies showed that overexpression of CPE in cultured hippocampal neurons protected them against H(2)O(2) oxidative-stress induced cell death. These findings taken together indicate that CPE is essential for the survival of adult hippocampal CA3 neurons to maintain normal cognitive function.", annotationSubgraph:["Protein biosynthesis subgraph"], pmid:"18570185", citationType:"PubMed", citationRef:"18570185"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
