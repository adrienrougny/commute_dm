UNWIND [{start: {_id:1449}, end: {_id:1504}, properties:{evidence:"Here, we provide direct evidence of binding of miR-155 to a predicted binding site and the ability of miR-155 to repress SMAD2 protein expression. We employed a lentivirally transduced monocyte cell line (THP1-155) containing an inducible miR-155 transgene to show that endogenous levels of SMAD2 protein were decreased after sustained overexpression of miR-155. This decrease in SMAD2 led to a reduction in both TGF-beta-induced SMAD-2 phosphorylation and SMAD-2-dependent activation of the expression of the CAGA(12)LUC reporter plasmid. Overexpression of miR-155 altered the cellular responses to TGF-beta by changing the expression of a set of genes that is involved in inflammation, fibrosis, and angiogenesis. Our study provides firm evidence of a role for miR-155 in directly repressing SMAD2 expression, and our results demonstrate the relevance of one of the two predicted target sites in SMAD2 3'-UTR. Altogether, our data uncover an important role for miR-155 in modulating the cellular response to TGF-beta with possible implications in several human diseases where homeostasis of TGF-beta might be altered.", annotationSubgraph:["miRNA subgraph", "Smad subgraph", "TGF-Beta subgraph"], annotationConfidence:["High"], pmid:"21036908", citationType:"PubMed", citationRef:"21036908"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:2041}, end: {_id:4476}, properties:{evidence:"MTHFR 677TT homozygous AD subjects had higher plasma tHcy values and/or decreased folate values compared to carriers of the MTHFR 677CT or 677CC genotypes", annotationSubgraph:["Epigenetic modification subgraph"], annotationMeshanatomy:["Plasma"], pmid:"21119889", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"21119889"}}, {start: {_id:4665}, end: {_id:4666}, properties:{evidence:"We have shown that Mn activates YY1 via activation of NF-kB", pmid:"25064045", citationType:"PubMed", citationRef:"25064045"}}] AS row
