UNWIND [{start: {_id:6}, end: {_id:3568}, properties:{annotationCellstructure:["Mitochondria"], evidence:"The present review raises the hypothesis that the onset of AD pathology is closely related with mitochondrial dysfunction induced by Abeta and brain-derived neurotrophic factor (BDNF) axonal transport deficits. It is well-known that axonal transport defect and attenuation of BDNF-neurotrophic tyrosine receptor kinase 2 (TrkB) signal are fatal to neuronal function and survival.We hypothesized that abnormal amyloid precursor protein (APP) processing and Abeta production in mitochondria disturb the axonal transport by impairing mitochondrial function and attenuate BDNF-neurotrophic tyrosine receptor kinase 2 signal subsequently.", annotationSubgraph:["Nerve growth factor subgraph"], annotationConfidence:["Medium"], pmid:"22212405", citationType:"PubMed", citationRef:"22212405"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTLY_DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:27}, end: {_id:985}, properties:{evidence:"The fact that mitochondria are the major generators and direct targets of reactive oxygen species led several investigators to foster the idea that oxidative stress and damage in mitochondria are contributory factors to several disorders including Alzheimer's disease and diabetes.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["Medium"], pmid:"17316694", citationType:"PubMed", citationRef:"17316694"}}, {start: {_id:1098}, end: {_id:985}, properties:{evidence:"The fact that mitochondria are the major generators and direct targets of reactive oxygen species led several investigators to foster the idea that oxidative stress and damage in mitochondria are contributory factors to several disorders including Alzheimer's disease and diabetes.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationConfidence:["Medium"], pmid:"17316694", citationType:"PubMed", citationRef:"17316694"}}, {start: {_id:1098}, end: {_id:1606}, properties:{annotationCellstructure:["Lysosomes"], evidence:"Lysosomal beta-galactosidase and beta-hexosaminidase activities correlate with clinical stages of dementia associated with Alzheimer's disease and type 2 diabetes mellitus.", annotationSubgraph:["Insulin signal transduction", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"21321400", citationType:"PubMed", citationRef:"21321400"}}, {start: {_id:27}, end: {_id:1606}, properties:{annotationCellstructure:["Lysosomes"], evidence:"Lysosomal beta-galactosidase and beta-hexosaminidase activities correlate with clinical stages of dementia associated with Alzheimer's disease and type 2 diabetes mellitus.", annotationSubgraph:["Insulin signal transduction", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"21321400", citationType:"PubMed", citationRef:"21321400"}}, {start: {_id:966}, end: {_id:1606}, properties:{annotationCellstructure:["Lysosomes"], evidence:"Lysosomal beta-galactosidase and beta-hexosaminidase activities correlate with clinical stages of dementia associated with Alzheimer's disease and type 2 diabetes mellitus.", annotationSubgraph:["Insulin signal transduction", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"21321400", citationType:"PubMed", citationRef:"21321400"}}, {start: {_id:2183}, end: {_id:2187}, properties:{evidence:"Insufficient NRF2 activation in humans has been linked to chronic diseases such as Parkinson's disease, Alzheimer's disease and amyotrophic lateral sclerosis.", annotationSubgraph:["Inflammatory response subgraph", "Free radical formation subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Amyotrophic Lateral Sclerosis", "Parkinson Disease", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:27}, end: {_id:2187}, properties:{evidence:"Insufficient NRF2 activation in humans has been linked to chronic diseases such as Parkinson's disease, Alzheimer's disease and amyotrophic lateral sclerosis.", annotationSubgraph:["Inflammatory response subgraph", "Free radical formation subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Amyotrophic Lateral Sclerosis", "Parkinson Disease", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:195}, end: {_id:2187}, properties:{evidence:"Insufficient NRF2 activation in humans has been linked to chronic diseases such as Parkinson's disease, Alzheimer's disease and amyotrophic lateral sclerosis.", annotationSubgraph:["Inflammatory response subgraph", "Free radical formation subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Amyotrophic Lateral Sclerosis", "Parkinson Disease", "Alzheimer Disease"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:1148}, end: {_id:2187}, properties:{evidence:"We bring forward the hypothesis that inflammation via prolonged activation of key kinases (p38 and GSK-3beta) and activation of histone deacetylases gives rise to dysregulation of the NRF2 system in the brain, which contributes to oxidative stress and injury.", annotationSubgraph:["Inflammatory response subgraph", "Free radical formation subgraph"], annotationMeshdisease:["Inflammation", "Wounds and Injuries"], annotationConfidence:["High"], pmid:"24262633", citationType:"PubMed", citationRef:"24262633"}}, {start: {_id:27}, end: {_id:2563}, properties:{evidence:"We speculate that higher affinity between Abeta and PLA2 has the therapeutic potential of decreasing the Abeta-Abeta interaction, thereby reducing the amyloid aggregation and plaque formation in AD.", annotationConfidence:["Medium"], pmid:"24619194", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:4215}, end: {_id:4216}, properties:{evidence:"CNS-targeted production of IL-17A induces glial activation, microvascular pathology and enhances the neuroinflammatory response to systemic endotoxemia.", annotationSubgraph:["Interleukin signaling subgraph"], annotationMeshdisease:["Endotoxemia"], annotationMeshanatomy:["Neuroglia"], annotationConfidence:["Medium"], pmid:"23468966", citationType:"PubMed", citationRef:"23468966"}}] AS row
