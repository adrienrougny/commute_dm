UNWIND [{start: {_id:4346}, end: {_id:4347}, properties:{evidence:"Opposing roles for CXCR3 signaling in central nervous system versus ocular inflammation mediated by the astrocyte-targeted production of IL-12.", annotationSubgraph:["Chemokine signaling subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Central Nervous System", "Astrocytes"], pmid:"21925471", citationType:"PubMed", citationRef:"21925471"}}, {start: {_id:4346}, end: {_id:4348}, properties:{evidence:"Opposing roles for CXCR3 signaling in central nervous system versus ocular inflammation mediated by the astrocyte-targeted production of IL-12.", annotationSubgraph:["Chemokine signaling subgraph"], annotationMeshdisease:["Inflammation"], annotationMeshanatomy:["Central Nervous System", "Astrocytes"], pmid:"21925471", citationType:"PubMed", citationRef:"21925471"}}, {start: {_id:6}, end: {_id:4277}, properties:{evidence:"Accumulating data indicate that astrocytes play an important role in the neuroinflammation related to the/ pathogenesis of AD. It has been shown that microglia and astrocytes are activated in AD brain and amyloid-beta (Abeta)/ can increase the expression of cyclooxygenase 2 (COX-2), interleukin-1, and interleukin-6.", annotationSubgraph:["Prostaglandin subgraph"], annotationMeshanatomy:["Astrocytes", "Microglia"], annotationConfidence:["Medium"], pmid:"20413894", citationType:"PubMed", citationRef:"20413894"}}, {start: {_id:6}, end: {_id:4363}, properties:{evidence:"Accumulating data indicate that astrocytes play an important role in the neuroinflammation related to the/ pathogenesis of AD. It has been shown that microglia and astrocytes are activated in AD brain and amyloid-beta (Abeta)/ can increase the expression of cyclooxygenase 2 (COX-2), interleukin-1, and interleukin-6.", annotationSubgraph:["Interleukin signaling subgraph"], annotationMeshanatomy:["Astrocytes", "Microglia"], annotationConfidence:["High"], pmid:"20413894", citationType:"PubMed", citationRef:"20413894"}}, {start: {_id:6}, end: {_id:4269}, properties:{evidence:"Accumulating data indicate that astrocytes play an important role in the neuroinflammation related to the/ pathogenesis of AD. It has been shown that microglia and astrocytes are activated in AD brain and amyloid-beta (Abeta)/ can increase the expression of cyclooxygenase 2 (COX-2), interleukin-1, and interleukin-6.", annotationSubgraph:["Interleukin signaling subgraph"], annotationMeshanatomy:["Astrocytes", "Microglia"], annotationConfidence:["High"], pmid:"20413894", citationType:"PubMed", citationRef:"20413894"}}, {start: {_id:6}, end: {_id:4350}, properties:{evidence:"Here we report that the expression of COX-2 and glial fibrillary acidic protein were enhanced and that of/ peroxisome proliferator- activated receptor gamma (PPARgamma) was decreased in Abeta(25-35)-treated astrocytes. In line/ with these results, nuclear factor-kappaB translocation was increased in the presence of Abeta.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Prostaglandin subgraph"], annotationMeshanatomy:["Astrocytes", "Microglia"], annotationConfidence:["High"], pmid:"20413894", citationType:"PubMed", citationRef:"20413894"}}, {start: {_id:6}, end: {_id:4277}, properties:{evidence:"Here we report that the expression of COX-2 and glial fibrillary acidic protein were enhanced and that of/ peroxisome proliferator- activated receptor gamma (PPARgamma) was decreased in Abeta(25-35)-treated astrocytes. In line/ with these results, nuclear factor-kappaB translocation was increased in the presence of Abeta.", annotationSubgraph:["Peroxisome proliferator activated receptor subgraph", "Prostaglandin subgraph"], annotationMeshanatomy:["Astrocytes", "Microglia"], annotationConfidence:["Medium"], pmid:"20413894", citationType:"PubMed", citationRef:"20413894"}}, {start: {_id:2459}, end: {_id:1741}, properties:{evidence:"Cytokines including TNF-Î±+IFN-gamma increase levels of endogenous BACE1, APP, and Abeta and stimulate amyloidogenic/ APP processing in astrocytes. Oligomeric and fibrillar Abeta42 also increase levels of astrocytic BACE1, APP, and beta-secretase/ processing. Together, our results suggest a cytokine- and Abeta42-driven feed-forward mechanism that promotes astrocytic Abeta/ production. Given that astrocytes greatly outnumber neurons, activated astrocytes may represent significant sources of Abeta/ during neuroinflammation in AD", annotationSubgraph:["Tumor necrosis factor subgraph", "Amyloidogenic subgraph"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["Medium"], pmid:"22047170", citationType:"PubMed", citationRef:"22047170"}}, {start: {_id:2459}, end: {_id:1748}, properties:{evidence:"Cytokines including TNF-Î±+IFN-gamma increase levels of endogenous BACE1, APP, and Abeta and stimulate amyloidogenic/ APP processing in astrocytes. Oligomeric and fibrillar Abeta42 also increase levels of astrocytic BACE1, APP, and beta-secretase/ processing. Together, our results suggest a cytokine- and Abeta42-driven feed-forward mechanism that promotes astrocytic Abeta/ production. Given that astrocytes greatly outnumber neurons, activated astrocytes may represent significant sources of Abeta/ during neuroinflammation in AD", annotationSubgraph:["Tumor necrosis factor subgraph", "Amyloidogenic subgraph"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["Medium"], pmid:"22047170", citationType:"PubMed", citationRef:"22047170"}}, {start: {_id:4189}, end: {_id:1741}, properties:{evidence:"Cytokines including TNF-Î±+IFN-gamma increase levels of endogenous BACE1, APP, and Abeta and stimulate amyloidogenic/ APP processing in astrocytes. Oligomeric and fibrillar Abeta42 also increase levels of astrocytic BACE1, APP, and beta-secretase/ processing. Together, our results suggest a cytokine- and Abeta42-driven feed-forward mechanism that promotes astrocytic Abeta/ production. Given that astrocytes greatly outnumber neurons, activated astrocytes may represent significant sources of Abeta/ during neuroinflammation in AD", annotationSubgraph:["Interferon signaling subgraph", "Amyloidogenic subgraph"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["Medium"], pmid:"22047170", citationType:"PubMed", citationRef:"22047170"}}, {start: {_id:4189}, end: {_id:1748}, properties:{evidence:"Cytokines including TNF-Î±+IFN-gamma increase levels of endogenous BACE1, APP, and Abeta and stimulate amyloidogenic/ APP processing in astrocytes. Oligomeric and fibrillar Abeta42 also increase levels of astrocytic BACE1, APP, and beta-secretase/ processing. Together, our results suggest a cytokine- and Abeta42-driven feed-forward mechanism that promotes astrocytic Abeta/ production. Given that astrocytes greatly outnumber neurons, activated astrocytes may represent significant sources of Abeta/ during neuroinflammation in AD", annotationSubgraph:["Interferon signaling subgraph", "Amyloidogenic subgraph"], annotationMeshanatomy:["Astrocytes"], annotationConfidence:["Medium"], pmid:"22047170", citationType:"PubMed", citationRef:"22047170"}}, {start: {_id:4365}, end: {_id:6}, properties:{evidence:"Chronic neuroinflammatory processes including glial activation may play a role in the pathogenesis of/ Alzheimer's disease (AD). The immune and inflammatory mediator CD40 ligand (CD40L) can augment the activation of/ cultured microglia by amyloid beta-protein (Abeta) and promote neuron death. We investigated whether CD40L is/ increased in AD and in animal models of AD and neuroinflammation. These findings indicate that astrocytes are / the predominant source of CD40L in brain, and are consistent with the proposed role of CD40L-mediated neurotoxic/ inflammation in AD.", annotationSubgraph:["Inflammatory response subgraph"], annotationCell:["microglial cell"], annotationConfidence:["Medium"], pmid:"11755016", citationType:"PubMed", citationRef:"11755016"}}, {start: {_id:6}, end: {_id:4370}, properties:{evidence:"Heme oxygenase-1 (HO-1) is a 32kDa stress protein that degrades heme to biliverdin, free iron and carbon/ monoxide. Our laboratory has shown that cysteamine, dopamine, beta-amyloid, IL-1beta and TNF-alpha up-regulate HO-1/ followed by mitochondrial sequestration of non- transferrin-derived 55Fe in cultured rat astroglia. In these cells and / in rat astroglia transfected with the human HO-1 gene, mitochondrial iron trapping is abrogated by the HO-1 inhibitors, / tin-mesoporphyrin and dexamethasone.We determined that HO-1 immunoreactivity is enhanced greatly in neurons and astrocytes/ of the hippocampus and cerebral cortex of Alzheimer subjects and co-localizes to senile plaques and neurofibrillary/ tangles (NFT). HO-1 staining is also augmented in astrocytes and decorates neuronal Lewy bodies in the Parkinson nigra./ Collectively, our findings suggest that HO-1 over-expression contributes to the pathological iron deposition and/ mitochondrial damage documented in these aging-related neurodegenerative disorders.", pmid:"11053673", citationType:"PubMed", citationRef:"11053673"}}, {start: {_id:2029}, end: {_id:4370}, properties:{evidence:"Heme oxygenase-1 (HO-1) is a 32kDa stress protein that degrades heme to biliverdin, free iron and carbon/ monoxide. Our laboratory has shown that cysteamine, dopamine, beta-amyloid, IL-1beta and TNF-alpha up-regulate HO-1/ followed by mitochondrial sequestration of non- transferrin-derived 55Fe in cultured rat astroglia. In these cells and / in rat astroglia transfected with the human HO-1 gene, mitochondrial iron trapping is abrogated by the HO-1 inhibitors, / tin-mesoporphyrin and dexamethasone.We determined that HO-1 immunoreactivity is enhanced greatly in neurons and astrocytes/ of the hippocampus and cerebral cortex of Alzheimer subjects and co-localizes to senile plaques and neurofibrillary/ tangles (NFT). HO-1 staining is also augmented in astrocytes and decorates neuronal Lewy bodies in the Parkinson nigra./ Collectively, our findings suggest that HO-1 over-expression contributes to the pathological iron deposition and/ mitochondrial damage documented in these aging-related neurodegenerative disorders.", pmid:"11053673", citationType:"PubMed", citationRef:"11053673"}}, {start: {_id:2459}, end: {_id:4370}, properties:{evidence:"Heme oxygenase-1 (HO-1) is a 32kDa stress protein that degrades heme to biliverdin, free iron and carbon/ monoxide. Our laboratory has shown that cysteamine, dopamine, beta-amyloid, IL-1beta and TNF-alpha up-regulate HO-1/ followed by mitochondrial sequestration of non- transferrin-derived 55Fe in cultured rat astroglia. In these cells and / in rat astroglia transfected with the human HO-1 gene, mitochondrial iron trapping is abrogated by the HO-1 inhibitors, / tin-mesoporphyrin and dexamethasone.We determined that HO-1 immunoreactivity is enhanced greatly in neurons and astrocytes/ of the hippocampus and cerebral cortex of Alzheimer subjects and co-localizes to senile plaques and neurofibrillary/ tangles (NFT). HO-1 staining is also augmented in astrocytes and decorates neuronal Lewy bodies in the Parkinson nigra./ Collectively, our findings suggest that HO-1 over-expression contributes to the pathological iron deposition and/ mitochondrial damage documented in these aging-related neurodegenerative disorders.", pmid:"11053673", citationType:"PubMed", citationRef:"11053673"}}, {start: {_id:4373}, end: {_id:2459}, properties:{evidence:"PKR inhibition prevented Abeta42-induced activation of IÎºB and NF- ÎºB, strongly decreased production and release/ of tumor necrosis factor (TNFÎ±) and interleukin (IL)-1beta, and limited apoptotic process.", annotationSubgraph:["Tumor necrosis factor subgraph"], annotationConfidence:["Medium"], pmid:"21699726", citationType:"PubMed", citationRef:"21699726"}}, {start: {_id:4373}, end: {_id:2029}, properties:{evidence:"PKR inhibition prevented Abeta42-induced activation of IÎºB and NF- ÎºB, strongly decreased production and release/ of tumor necrosis factor (TNFÎ±) and interleukin (IL)-1beta, and limited apoptotic process.", annotationSubgraph:["Interleukin signaling subgraph"], annotationConfidence:["High"], pmid:"21699726", citationType:"PubMed", citationRef:"21699726"}}, {start: {_id:4390}, end: {_id:22}, properties:{evidence:"Acat1-targeting AAV delivered to the brains of AD mice decreased the levels of brain amyloid-beta and full-length human amyloid precursor protein (hAPP), to levels similar to complete genetic ablation of Acat1. This study provides support for the potential therapeutic use of Acat1 knockdown gene therapy in AD.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"23774792", citationType:"PubMed", citationRef:"23774792"}}, {start: {_id:6}, end: {_id:534}, properties:{evidence:"We found that frontal CC regions were preserved with respect to the posterior ones in aMCI; in these individuals significant correlations were seen between DTI-derived metrics in frontal-parietal CC areas and Abeta42-stimulated BDNF-producing CD4+ T lymphocytes and PDL-1-expressing CD14+ cells.", annotationSubgraph:["T cells signaling", "Nerve growth factor subgraph"], annotationMeshanatomy:["T-Lymphocytes"], annotationConfidence:["High"], pmid:"24324435", citationType:"PubMed", citationRef:"24324435"}}, {start: {_id:534}, end: {_id:4166}, properties:{evidence:"We found that frontal CC regions were preserved with respect to the posterior ones in aMCI; in these individuals significant correlations were seen between DTI-derived metrics in frontal-parietal CC areas and Abeta42-stimulated BDNF-producing CD4+ T lymphocytes and PDL-1-expressing CD14+ cells.", annotationSubgraph:["T cells signaling", "Nerve growth factor subgraph"], annotationMeshanatomy:["T-Lymphocytes"], annotationConfidence:["High"], pmid:"24324435", citationType:"PubMed", citationRef:"24324435"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:4166}, end: {_id:955}, properties:{evidence:"The interaction between PD1 on T lymphocytes and PD-L1 on antigen presenting cells (APC) modulates the balance between inflammation and tolerance by inducing IL-10 production and apoptosis of antigen- specific cells.", annotationSubgraph:["T cells signaling"], pmid:"21514692", citationType:"PubMed", citationRef:"21514692"}}, {start: {_id:4404}, end: {_id:567}, properties:{evidence:"Dysregulation of type I programmed cell death (apoptotic process) leads to a variety of diseases, among which cancer, cardiovascular and neurodegenerative disorders are the most prominent and widespread. Effector caspases such as caspases-3 and -7 get activated during the apoptotic signaling cascade and hence represent a biological target for the diagnosis and therapy of apoptotic process-associated diseases.", annotationSubgraph:["T cells signaling", "Caspase subgraph"], annotationConfidence:["High"], pmid:"23223301", citationType:"PubMed", citationRef:"23223301"}}, {start: {_id:4404}, end: {_id:2359}, properties:{evidence:"Dysregulation of type I programmed cell death (apoptotic process) leads to a variety of diseases, among which cancer, cardiovascular and neurodegenerative disorders are the most prominent and widespread. Effector caspases such as caspases-3 and -7 get activated during the apoptotic signaling cascade and hence represent a biological target for the diagnosis and therapy of apoptotic process-associated diseases.", annotationSubgraph:["T cells signaling", "Caspase subgraph"], annotationConfidence:["High"], pmid:"23223301", citationType:"PubMed", citationRef:"23223301"}}, {start: {_id:4450}, end: {_id:4447}, properties:{evidence:"Down regulation of DNMT results in hypomethylation of BACE1 and APP which are involved in Abeta production and causes upregulation of their protein expression; in turn SP1 transcription factor increases which finally results in Abeta production.", annotationSubgraph:["Amyloidogenic subgraph", "Epigenetic modification subgraph"], annotationSpecies:["10090"], annotationConfidence:["Medium"], pmid:"19245828", citationType:"PubMed", citationRef:"19245828"}}, {start: {_id:1741}, end: {_id:6}, properties:{evidence:"BACE1 and BACE2, are involved in the development of Alzheimer's disease by producing Abeta", annotationSpecies:["10090"], pmid:"22166205", citationType:"PubMed", citationRef:"22166205"}}, {start: {_id:4505}, end: {_id:6}, properties:{evidence:"BACE1 and BACE2, are involved in the development of Alzheimer's disease by producing Abeta", annotationSpecies:["10090"], pmid:"22166205", citationType:"PubMed", citationRef:"22166205"}}, {start: {_id:22}, end: {_id:4525}, properties:{annotationEncodeFeatureTypes:["Promoter"], annotationKnockoutmice:["App transgenic"], evidence:"APP Specifically Regulates Acetylation of Histone H4 at Lysines 5 and 12", annotationConfidence:["High"], pmid:"24919190", citationType:"PubMed", citationRef:"24919190"}}, {start: {_id:22}, end: {_id:4527}, properties:{annotationEncodeFeatureTypes:["Promoter"], annotationKnockoutmice:["App transgenic"], evidence:"APP Specifically Regulates Acetylation of Histone H4 at Lysines 5 and 12", annotationConfidence:["High"], pmid:"24919190", citationType:"PubMed", citationRef:"24919190"}}, {start: {_id:3998}, end: {_id:4525}, properties:{annotationEncodeFeatureTypes:["Promoter"], annotationKnockoutmice:["App transgenic"], evidence:"H4K5 and H4K12 are known to be acetylated by Tip60", annotationConfidence:["High"], pmid:"24919190", citationType:"PubMed", citationRef:"24919190"}}, {start: {_id:3998}, end: {_id:4527}, properties:{annotationEncodeFeatureTypes:["Promoter"], annotationKnockoutmice:["App transgenic"], evidence:"H4K5 and H4K12 are known to be acetylated by Tip60", annotationConfidence:["High"], pmid:"24919190", citationType:"PubMed", citationRef:"24919190"}}, {start: {_id:37}, end: {_id:6}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"hypomethylation of the promoter of the presenilin 1 (PS1) gene, which will lead to overexpression of presenilin 1 and, consequently, to increased Abeta(1-42) (Abeta42) formation", pmid:"16040194", citationType:"PubMed", citationRef:"16040194"}}, {start: {_id:4520}, end: {_id:6}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"We also found that the increasing trend of cellular histone H3 acetylation is consistent with the increased expression of Abeta1-42 and Abeta1-40 peptides in N2a/APPswe and N2a/APPwt cells. This data suggested that the cellular histone hyperacetylation may regulate the genes that produce the Abeta peptides", pmid:"25051175", citationType:"PubMed", citationRef:"25051175"}}, {start: {_id:4624}, end: {_id:4520}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"HAT activity of p300 stimulates the PS1 and BACE1 promoter histone hyperacetylation", pmid:"25051175", citationType:"PubMed", citationRef:"25051175"}}, {start: {_id:4520}, end: {_id:1647}, properties:{evidence:"sodium butyrate (a well-known HDAC inhibitor) increased DHCR24 expression in SH-SY5Y cells by recruiting acetylated core histones H3 and H4 to the enhancer region, as demonstrated by transient transfection and chromatin immunoprecipitation assays.", annotationMeshanatomy:["Cerebral Cortex"], pmid:"20568014", citationType:"PubMed", citationRef:"20568014"}}, {start: {_id:4520}, end: {_id:22}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"show that T3 treatment decreases both histone H3 acetylation and histone H3 lysine 4 methylation at the APP promoter and that chemical inhibitors of histone deacetylases and histone lysine demethylase abrogate T3-dependent APP silencing.", pmid:"21458529", citationType:"PubMed", citationRef:"21458529"}}, {start: {_id:4675}, end: {_id:22}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"show that T3 treatment decreases both histone H3 acetylation and histone H3 lysine 4 methylation at the APP promoter and that chemical inhibitors of histone deacetylases and histone lysine demethylase abrogate T3-dependent APP silencing.", pmid:"21458529", citationType:"PubMed", citationRef:"21458529"}}, {start: {_id:6}, end: {_id:4520}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"We found that bilateral microinjection of amyloid beta (Abeta)1-40 fibrils into the hippocampal CA1 area of resulted in significant upregulation of CX3CR1 messenger RNA (mRNA) and protein expression (via increasing histone H3 acetylation in the Cx3cr1 promoter region), synaptic dysfunction, and cognitive impairment,", annotationMeshanatomy:["Hippocampus"], pmid:"23855980", citationType:"PubMed", citationRef:"23855980"}}, {start: {_id:4520}, end: {_id:823}, properties:{annotationEncodeFeatureTypes:["Promoter"], evidence:"We found that bilateral microinjection of amyloid beta (Abeta)1-40 fibrils into the hippocampal CA1 area of resulted in significant upregulation of CX3CR1 messenger RNA (mRNA) and protein expression (via increasing histone H3 acetylation in the Cx3cr1 promoter region), synaptic dysfunction, and cognitive impairment,", annotationMeshanatomy:["Hippocampus"], pmid:"23855980", citationType:"PubMed", citationRef:"23855980"}}, {start: {_id:4680}, end: {_id:4681}, properties:{evidence:"PEBP plays a pivotal modulatory role in several signal transduction pathways. PEBP inhibits the MAPK pathway through interacting with Raf-1, so it's also known as Raf-1 kinase inhibitor protein (RKIP). PEBP is involved in the regulation of PKC, G-protein-coupled receptor and NF-kappaB signaling pathway as well. In clinical researches, it was found that as the precursor of hippocampal cholinergic neurostimulating peptide (HCNP), PEBP has an important effect on the development of Alzheimer's disease.", pmid:"19803424", citationType:"PubMed", citationRef:"19803424"}}, {start: {_id:6}, end: {_id:4280}, properties:{annotationCellstructure:["Endoplasmic Reticulum"], evidence:"We found Abeta oligomer accumulation in the endoplasmic reticulum (ER), endosomes/lysosomes, and mitochondria in hippocampal neurons of 22-month-old mice. We also detected up-regulation of Grp78 and HRD1 (an E3 ubiquitin ligase), leakage of cathepsin D from endosomes/lysosomes into cytoplasm, cytochrome c release from mitochondria, and activation of caspase-3 in the hippocampi of 18-month-old mice.", annotationSubgraph:["Chaperone subgraph"], pmid:"21488093", citationType:"PubMed", citationRef:"21488093"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:4708}, end: {_id:4709}, properties:{evidence:"Taken together, these studies indicate that SULT4A1 stability is regulated by post-translational modification that involves the ERK pathway and PP2A. The phosphorylation of SULT4A1 allows interaction with Pin1, which then promotes degradation of the sulfotransferase.", annotationSubgraph:["MAPK-JNK subgraph"], pmid:"20920535", citationType:"PubMed", citationRef:"20920535"}}, {start: {_id:2033}, end: {_id:4100}, properties:{evidence:"We propose that IL-1 and the IL-6 family of cytokines regulate YKL-40 expression during sterile inflammation via both STAT3 and RelB/p50 complexes", annotationSubgraph:["Inflammatory response subgraph", "JAK-STAT signaling subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:746}, end: {_id:4100}, properties:{evidence:"In addition, IL-6 and OSM moderately upregulate YKL-40 expression in human astrocytes [...] demonstrate that YKL-40 expression correlates with the expression of both IL-1beta and IL-6", annotationSubgraph:["Inflammatory response subgraph", "Interleukin signaling subgraph"], annotationConfidence:["Medium"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:4425}, end: {_id:4100}, properties:{evidence:"In addition, IL-6 and OSM moderately upregulate YKL-40 expression in human astrocytes [...] demonstrate that YKL-40 expression correlates with the expression of both IL-1beta and IL-6", annotationSubgraph:["Inflammatory response subgraph", "Interleukin signaling subgraph"], annotationConfidence:["Medium"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:837}, end: {_id:1926}, properties:{evidence:"It is generally accepted that IL-1 triggers a classical NF-κB pathway in many cell types, which leads to the induction of p65/p50 target genes, including those encoding proinflammatory cytokines such as IL-8 and IL-6", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "Interleukin signaling subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:837}, end: {_id:1407}, properties:{evidence:"It is generally accepted that IL-1 triggers a classical NF-κB pathway in many cell types, which leads to the induction of p65/p50 target genes, including those encoding proinflammatory cytokines such as IL-8 and IL-6", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "Interleukin signaling subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:1926}, end: {_id:4713}, properties:{evidence:"It is also accepted that RelB is activated in lymphoid cells, such as dendritic cells, by a noncanonical NF-κB pathway and generation of RelB/p52 complexes that are important for proper dendritic cell functions", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:1407}, end: {_id:4713}, properties:{evidence:"It is also accepted that RelB is activated in lymphoid cells, such as dendritic cells, by a noncanonical NF-κB pathway and generation of RelB/p52 complexes that are important for proper dendritic cell functions", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:4717}, end: {_id:821}, properties:{evidence:"In fact YKL-40 induces the interaction of αvbeta3 integrins with syndecan-1 in endothelial cells (27), it activates ERK, AKT, and Wnt/beta-catenin signaling in macrophages via IL-13 receptor alpha 2-dependent mechanism (55),", annotationSubgraph:["Interleukin signaling subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:96}, end: {_id:1926}, properties:{evidence:"Both IL-1 and TNF are known to trigger a classical IκB kinase (IKK)gamma-dependent activation of NF-κB,", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:96}, end: {_id:1407}, properties:{evidence:"Both IL-1 and TNF are known to trigger a classical IκB kinase (IKK)gamma-dependent activation of NF-κB,", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:97}, end: {_id:1407}, properties:{evidence:"Both IL-1 and TNF are known to trigger a classical IκB kinase (IKK)gamma-dependent activation of NF-κB,", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:837}, end: {_id:1926}, properties:{evidence:"Both IL-1 and TNF are known to trigger a classical IκB kinase (IKK)gamma-dependent activation of NF-κB,", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:837}, end: {_id:1407}, properties:{evidence:"Both IL-1 and TNF are known to trigger a classical IκB kinase (IKK)gamma-dependent activation of NF-κB,", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:97}, end: {_id:1926}, properties:{evidence:"Both IL-1 and TNF are known to trigger a classical IκB kinase (IKK)gamma-dependent activation of NF-κB,", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["High"], pmid:"25681350", citationType:"PubMed", citationRef:"25681350"}}, {start: {_id:4682}, end: {_id:4721}, properties:{evidence:"TREM-2 regulates dendritic cell function by inducing CCR7 expression on peripheral dendritic cells and directing them from the periphery to the draining lymph node.", annotationSubgraph:["Inflammatory response subgraph", "Cytokine signaling subgraph"], annotationCell:["dendritic cell"], annotationConfidence:["Medium"], pmid:"19149696", citationType:"PubMed", citationRef:"19149696"}}, {start: {_id:760}, end: {_id:4750}, properties:{evidence:"Protein kinase C is also recruited into the large multiprotein complex forming at the adhesion point where it regulates the associations. Previous studies have underlined the involvement of PKC in HSPG- dependent phagocytosis in HeLa cells", annotationSubgraph:["Syndecan subgraph"], pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:1996}, end: {_id:4811}, properties:{evidence:"The ectodomains of all HS-chain-enriched snd-1 molecules are constitutively released (i.e. shed) from cell membranes as part of normal physiology (Bishop et al.,2007). Proteases, including matrix metalloproteinases (MMPs) and ADAM sheddases, mediate the ectodomain shedding of membrane-bound proteins (such as snd-1). Previously, we showed snd-1 shedding plays an active role in HPV16 infection in cultured HKs (Surviladze et al., 2012).", annotationSubgraph:["Syndecan subgraph"], pmid:"26289843", citationType:"PubMed", citationRef:"26289843"}}, {start: {_id:4812}, end: {_id:4811}, properties:{evidence:"The ectodomains of all HS-chain-enriched snd-1 molecules are constitutively released (i.e. shed) from cell membranes as part of normal physiology (Bishop et al.,2007). Proteases, including matrix metalloproteinases (MMPs) and ADAM sheddases, mediate the ectodomain shedding of membrane-bound proteins (such as snd-1). Previously, we showed snd-1 shedding plays an active role in HPV16 infection in cultured HKs (Surviladze et al., 2012).", annotationSubgraph:["Syndecan subgraph"], pmid:"26289843", citationType:"PubMed", citationRef:"26289843"}}, {start: {_id:4817}, end: {_id:4821}, properties:{evidence:"overexpression of CRF or exposure to chronic stress in rodents can induce phosphorylation and solubility changes in the microtubule- associated protein, tau, a process that is reliant on CRFR1. Furthermore, exposing rodents to chronic emotional stress results in increased phosphorylation and decreased solubility of the tau protein; changes that are also strictly dependent on CRFR1 signaling. In addition to work on tau, several reports demonstrate that CRF or stress exposure can impact Abeta production and accumulation in AD models and that stress-induced Abeta plaque formation in adult AD mice can be reduced by CRFR1 antagonism . In particular, our recently published work demonstrates that genetic ablation of CRFR1 greatly reduces the production of APP CTFs and accumulation of Abeta in the brains of AD mice.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["10090"], pmid:"26555315", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"26555315"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:4817}, end: {_id:4821}, properties:{evidence:"Stress exposure or increased levels of corticotropin-releasing factor (CRF) induce hippocampal tau phosphorylation (tau-P) in rodent models, a process that is dependent on the type-1 CRF receptor (CRFR1).", annotationSpecies:["10116"], pmid:"26790099", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"26790099"}}, {start: {_id:4823}, end: {_id:6}, properties:{evidence:"In cells, CRF treatment increases Abeta production and triggers CRF receptor 1 (CRFR1) and gamma-secretase internalization. Co- immunoprecipitation studies establish that gamma-secretase associates with CRFR1; this is mediated by beta-arrestin binding motifs.", annotationSubgraph:["CRH subgraph"], pmid:"25964433", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25964433"}}, {start: {_id:6}, end: {_id:4817}, properties:{evidence:"In cells, CRF treatment increases Abeta production and triggers CRF receptor 1 (CRFR1) and gamma-secretase internalization. Co- immunoprecipitation studies establish that gamma-secretase associates with CRFR1; this is mediated by beta-arrestin binding motifs.", annotationSubgraph:["CRH subgraph"], pmid:"25964433", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25964433"}}, {start: {_id:4817}, end: {_id:4821}, properties:{evidence:"Clinical and basic science research suggests that stress and/or changes in central stress signaling intermediates may be involved in Alzheimer's disease (AD) pathogenesis. Although the links between stress and AD remain unsettled, data from our group and others have established that stress exposure in rodents may confer susceptibility to AD pathology by inducing hippocampal tau phosphorylation (tau-P). Work in our laboratory has shown that stress-induced tau-P requires activation of the type-1 corticotropin-releasing factor receptor (CRFR1).", annotationSubgraph:["CRH subgraph"], annotationSpecies:["10116"], pmid:"25125464", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25125464"}}, {start: {_id:4817}, end: {_id:6}, properties:{evidence:"We found that both PSAPP-R1(+/-) and PSAPP-R1(-/-) had significantly reduced Abeta burden in the hippocampus, insular, rhinal, and retrosplenial cortices. Accordingly, we observed dramatic reductions in Abeta peptides and AbetaPP-CTFs, providing support for a direct relationship between CRFR1 and Abeta production pathways. In summary, our results suggest that interference of CRFR1 in an AD model is tolerable and is efficacious in impacting Abeta neuropathology.", annotationSpecies:["10090"], pmid:"25697705", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25697705"}}, {start: {_id:4817}, end: {_id:4821}, properties:{evidence:"When tested in hippocampal extracts from wt and knock-out mice, each of the stress-responsive kinase forms or regulators also exhibited modulation as a function of CRFR status that mirrored some or all of the effects of genotype on restraint-induced tau-P. The activated (pY216) form of GSK-3beta, implicated in phosphorylating tau at S199, S212, T231, and PHF-1 sites, was most similar in that the stress- induced increment seen in wt mice was not evident in CRFR1−/− animals and was exaggerated in CRFR2−/− mice. Phosphorylation responses of both JNK isoforms were also significantly greater in CRFR2 knock-outs than in wt controls (p < 0.05). These kinases also exhibited pronounced elevations in basal phosphorylation in CRFR1-deficient mice, whose magnitude rivaled or exceeded stress-induced levels in wt mice. This may relate to the elevated tau-P levels seen under this condition at the AT8 and PHF-1 sites, although less-marked elevations of phosphorylated GSK-3beta and ERK2, and of p35 levels, in unstressed CRFR1−/− mice may also contribute in this regard. Overall, these results identify several tau kinases as potential effectors of CRFR- dependent effects of acute emotional stress on tau-P.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["10090"], pmid:"25697705", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25697705"}}, {start: {_id:4817}, end: {_id:4824}, properties:{evidence:"When tested in hippocampal extracts from wt and knock-out mice, each of the stress-responsive kinase forms or regulators also exhibited modulation as a function of CRFR status that mirrored some or all of the effects of genotype on restraint-induced tau-P. The activated (pY216) form of GSK-3beta, implicated in phosphorylating tau at S199, S212, T231, and PHF-1 sites, was most similar in that the stress- induced increment seen in wt mice was not evident in CRFR1−/− animals and was exaggerated in CRFR2−/− mice. Phosphorylation responses of both JNK isoforms were also significantly greater in CRFR2 knock-outs than in wt controls (p < 0.05). These kinases also exhibited pronounced elevations in basal phosphorylation in CRFR1-deficient mice, whose magnitude rivaled or exceeded stress-induced levels in wt mice. This may relate to the elevated tau-P levels seen under this condition at the AT8 and PHF-1 sites, although less-marked elevations of phosphorylated GSK-3beta and ERK2, and of p35 levels, in unstressed CRFR1−/− mice may also contribute in this regard. Overall, these results identify several tau kinases as potential effectors of CRFR- dependent effects of acute emotional stress on tau-P.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["10090"], pmid:"25697705", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25697705"}}, {start: {_id:4817}, end: {_id:4825}, properties:{evidence:"When tested in hippocampal extracts from wt and knock-out mice, each of the stress-responsive kinase forms or regulators also exhibited modulation as a function of CRFR status that mirrored some or all of the effects of genotype on restraint-induced tau-P. The activated (pY216) form of GSK-3beta, implicated in phosphorylating tau at S199, S212, T231, and PHF-1 sites, was most similar in that the stress- induced increment seen in wt mice was not evident in CRFR1−/− animals and was exaggerated in CRFR2−/− mice. Phosphorylation responses of both JNK isoforms were also significantly greater in CRFR2 knock-outs than in wt controls (p < 0.05). These kinases also exhibited pronounced elevations in basal phosphorylation in CRFR1-deficient mice, whose magnitude rivaled or exceeded stress-induced levels in wt mice. This may relate to the elevated tau-P levels seen under this condition at the AT8 and PHF-1 sites, although less-marked elevations of phosphorylated GSK-3beta and ERK2, and of p35 levels, in unstressed CRFR1−/− mice may also contribute in this regard. Overall, these results identify several tau kinases as potential effectors of CRFR- dependent effects of acute emotional stress on tau-P.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["10090"], pmid:"25697705", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25697705"}}, {start: {_id:4817}, end: {_id:4826}, properties:{evidence:"When tested in hippocampal extracts from wt and knock-out mice, each of the stress-responsive kinase forms or regulators also exhibited modulation as a function of CRFR status that mirrored some or all of the effects of genotype on restraint-induced tau-P. The activated (pY216) form of GSK-3beta, implicated in phosphorylating tau at S199, S212, T231, and PHF-1 sites, was most similar in that the stress- induced increment seen in wt mice was not evident in CRFR1−/− animals and was exaggerated in CRFR2−/− mice. Phosphorylation responses of both JNK isoforms were also significantly greater in CRFR2 knock-outs than in wt controls (p < 0.05). These kinases also exhibited pronounced elevations in basal phosphorylation in CRFR1-deficient mice, whose magnitude rivaled or exceeded stress-induced levels in wt mice. This may relate to the elevated tau-P levels seen under this condition at the AT8 and PHF-1 sites, although less-marked elevations of phosphorylated GSK-3beta and ERK2, and of p35 levels, in unstressed CRFR1−/− mice may also contribute in this regard. Overall, these results identify several tau kinases as potential effectors of CRFR- dependent effects of acute emotional stress on tau-P.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["10090"], pmid:"25697705", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25697705"}}, {start: {_id:4817}, end: {_id:4827}, properties:{evidence:"When tested in hippocampal extracts from wt and knock-out mice, each of the stress-responsive kinase forms or regulators also exhibited modulation as a function of CRFR status that mirrored some or all of the effects of genotype on restraint-induced tau-P. The activated (pY216) form of GSK-3beta, implicated in phosphorylating tau at S199, S212, T231, and PHF-1 sites, was most similar in that the stress- induced increment seen in wt mice was not evident in CRFR1−/− animals and was exaggerated in CRFR2−/− mice. Phosphorylation responses of both JNK isoforms were also significantly greater in CRFR2 knock-outs than in wt controls (p < 0.05). These kinases also exhibited pronounced elevations in basal phosphorylation in CRFR1-deficient mice, whose magnitude rivaled or exceeded stress-induced levels in wt mice. This may relate to the elevated tau-P levels seen under this condition at the AT8 and PHF-1 sites, although less-marked elevations of phosphorylated GSK-3beta and ERK2, and of p35 levels, in unstressed CRFR1−/− mice may also contribute in this regard. Overall, these results identify several tau kinases as potential effectors of CRFR- dependent effects of acute emotional stress on tau-P.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["10090"], pmid:"25697705", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25697705"}}, {start: {_id:261}, end: {_id:6}, properties:{evidence:"In cells, CRF treatment increases Abeta production and triggers CRF receptor 1 (CRFR1) and gamma-secretase internalization. Co- immunoprecipitation studies establish that gamma-secretase associates with CRFR1; this is mediated by beta-arrestin binding motifs.", annotationSubgraph:["CRH subgraph"], pmid:"25964433", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25964433"}}, {start: {_id:6}, end: {_id:4831}, properties:{evidence:"In cells, CRF treatment increases Abeta production and triggers CRF receptor 1 (CRFR1) and gamma-secretase internalization. Co- immunoprecipitation studies establish that gamma-secretase associates with CRFR1; this is mediated by beta-arrestin binding motifs.", annotationSubgraph:["CRH subgraph"], pmid:"25964433", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"25964433"}}, {start: {_id:6}, end: {_id:4058}, properties:{evidence:"Although the mechanism of Ab action in the pathogenesis of Alzheimer’s disease (AD) has remained elusive, it is known to increase the expression of the antagonist of canonical wnt signalling, Dickkopf-1 (Dkk1), whereas the silencing of Dkk1 blocks Ab neurotoxicity.", annotationSubgraph:["DKK1 subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:4135}, end: {_id:4058}, properties:{evidence:"Caricasole et al demonstrated that the Abeta peptide fragment, Abeta25-35, induces neuronal expression of the wnt antagonist Dkk1 and that silencing of DKK1 blocks Abeta neurotoxicity.", annotationSubgraph:["DKK1 subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:6}, end: {_id:4837}, properties:{evidence:"Knockdown of clusterin in primary neurons reduced Abeta toxicity and DKK1 upregulation and, conversely, Abeta increased intracellular clusterin and decreased clusterin protein secretion, resulting in the p53-dependent induction of DKK1.", annotationSubgraph:["DKK1 subgraph", "Endosomal lysosomal subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:2100}, end: {_id:118}, properties:{evidence:"To further elucidate how the clusterin-dependent induction of Dkk1 by Abeta mediates neurotoxicity, we measured the effects of Abeta and Dkk1 protein on whole-genome expression in primary neurons, finding a common pathway suggestive of activation of wnt–planar cell polarity (PCP)–c-Jun N-terminal kinase (JNK) signalling leading to the induction of genes including EGR1 (early growth response-1), NAB2 (Ngfi-A-binding protein-2) and KLF10 (Krüppel-like factor-10) that, when individually silenced, protected against Abeta neurotoxicity and/or tau phosphorylation. To summarise, we show that Ab-induced neurotoxicity, including tau phosphorylation at specific epitopes, is via the CLU-dependent induction of Dkk1, with Dkk1 then driving wnt–PCP signalling to increase expression of genes that we have identified and shown to be necessary mediators of these pathological processes.", annotationSubgraph:["Gamma secretase subgraph", "DKK1 subgraph", "Tau protein subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:4841}, end: {_id:118}, properties:{evidence:"To further elucidate how the clusterin-dependent induction of Dkk1 by Abeta mediates neurotoxicity, we measured the effects of Abeta and Dkk1 protein on whole-genome expression in primary neurons, finding a common pathway suggestive of activation of wnt–planar cell polarity (PCP)–c-Jun N-terminal kinase (JNK) signalling leading to the induction of genes including EGR1 (early growth response-1), NAB2 (Ngfi-A-binding protein-2) and KLF10 (Krüppel-like factor-10) that, when individually silenced, protected against Abeta neurotoxicity and/or tau phosphorylation. To summarise, we show that Ab-induced neurotoxicity, including tau phosphorylation at specific epitopes, is via the CLU-dependent induction of Dkk1, with Dkk1 then driving wnt–PCP signalling to increase expression of genes that we have identified and shown to be necessary mediators of these pathological processes.", annotationSubgraph:["Gamma secretase subgraph", "DKK1 subgraph", "Tau protein subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:4842}, end: {_id:118}, properties:{evidence:"To further elucidate how the clusterin-dependent induction of Dkk1 by Abeta mediates neurotoxicity, we measured the effects of Abeta and Dkk1 protein on whole-genome expression in primary neurons, finding a common pathway suggestive of activation of wnt–planar cell polarity (PCP)–c-Jun N-terminal kinase (JNK) signalling leading to the induction of genes including EGR1 (early growth response-1), NAB2 (Ngfi-A-binding protein-2) and KLF10 (Krüppel-like factor-10) that, when individually silenced, protected against Abeta neurotoxicity and/or tau phosphorylation. To summarise, we show that Ab-induced neurotoxicity, including tau phosphorylation at specific epitopes, is via the CLU-dependent induction of Dkk1, with Dkk1 then driving wnt–PCP signalling to increase expression of genes that we have identified and shown to be necessary mediators of these pathological processes.", annotationSubgraph:["Gamma secretase subgraph", "DKK1 subgraph", "Tau protein subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:4058}, end: {_id:2100}, properties:{evidence:"Dkk4 and Dkk1 induced EGR1 (Figure 6b) and FOS (data not shown) whereas Dkk2 and Dkk3 did not, mirroring the abilities of the Dkk1 family to antagonise canonical wnt.", annotationSubgraph:["Gamma secretase subgraph", "DKK1 subgraph"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:4844}, end: {_id:2100}, properties:{evidence:"Dkk4 and Dkk1 induced EGR1 (Figure 6b) and FOS (data not shown) whereas Dkk2 and Dkk3 did not, mirroring the abilities of the Dkk1 family to antagonise canonical wnt.", annotationSubgraph:["Gamma secretase subgraph", "DKK1 subgraph"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:4058}, end: {_id:1595}, properties:{evidence:"Dkk4 and Dkk1 induced EGR1 (Figure 6b) and FOS (data not shown) whereas Dkk2 and Dkk3 did not, mirroring the abilities of the Dkk1 family to antagonise canonical wnt.", annotationSubgraph:["DKK1 subgraph"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:4844}, end: {_id:1595}, properties:{evidence:"Dkk4 and Dkk1 induced EGR1 (Figure 6b) and FOS (data not shown) whereas Dkk2 and Dkk3 did not, mirroring the abilities of the Dkk1 family to antagonise canonical wnt.", annotationSubgraph:["DKK1 subgraph"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:2100}, end: {_id:118}, properties:{evidence:"Hippocampal expression levels of Egr1 have been shown to positively correlate with disease progression in AD, whereas the overexpression of EGR1 in rat brain induces tau phosphorylation via its target, and regulator of cdk5, p35.", annotationSubgraph:["Gamma secretase subgraph", "Tau protein subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Brain"], annotationConfidence:["High"], pmid:"23164821", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:380}, end: {_id:4854}, properties:{evidence:"Wnt signaling requires both Fz and LRP6 (or LRP5), likely through a Wnt-induced Fz-LRP6 complex (Figure 1). Wnt-induced LRP6 phosphorylation is a key event in receptor activation (Tamai et al., 2004). LRP6, LRP5 and Arrow each have five reiterated PPPSPxS motifs (P, proline; S, serine or threonine, x, a variable residue), which are essential for LRP6 function and are each transferrable to a heterologous receptor to result in constitutive beta-catenin signaling (MacDonald et al., 2008;Tamai et al., 2004;Zeng et al., 2005).", annotationSubgraph:["Wnt signaling subgraph"], pmid:"19619488", citationType:"PubMed", citationRef:"19619488"}}, {start: {_id:4135}, end: {_id:3225}, properties:{evidence:"As a result, the Polymerization of and MAP-2 and NF-H induced by Abeta25-35 could be significantly inhibited by Wnt3a(40 ng/ml), however enhanced by Dkk1(100 ng/ml).", annotationSubgraph:["DKK1 subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"26809093", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"26809093"}}, {start: {_id:4135}, end: {_id:3428}, properties:{evidence:"As a result, the Polymerization of and MAP-2 and NF-H induced by Abeta25-35 could be significantly inhibited by Wnt3a(40 ng/ml), however enhanced by Dkk1(100 ng/ml).", annotationSubgraph:["DKK1 subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"26809093", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"26809093"}}, {start: {_id:4058}, end: {_id:118}, properties:{evidence:"Meanwhile, the protein abundance of phosphorylated tau in several sites is decreased by Wnt3a, but increased by Dkk1 significantly compared with the control group.", annotationSubgraph:["DKK1 subgraph", "Tau protein subgraph"], annotationConfidence:["High"], pmid:"26809093", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"26809093"}}, {start: {_id:4058}, end: {_id:20}, properties:{evidence:"In this study, activation of the Wnt pathway by overexpression of the agonist Wnt3a or beta-catenin or by inhibition of glycogen kinase synthase-3 in N2a cells resulted in a reduction in Abeta levels and in the activity and expression of BACE1 (beta-APP cleaving enzyme). Conversely, inhibition of the pathway by transfection of the antagonists secreted frizzled receptor protein-1 or dickkopf-1 produced the opposite effects.", annotationSubgraph:["Beta secretase subgraph", "DKK1 subgraph"], annotationConfidence:["High"], pmid:"25384422", citationType:"PubMed", citationRef:"25384422"}}, {start: {_id:6}, end: {_id:4058}, properties:{evidence:"Although the mechanism of Abeta action in the pathogenesis of Alzheimer's disease (AD) has remained elusive, it is known to increase the expression of the antagonist of canonical wnt signalling, Dickkopf-1 (Dkk1), whereas the silencing of Dkk1 blocks Abeta neurotoxicity.", annotationSubgraph:["DKK1 subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"23164821", citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:6}, end: {_id:4058}, properties:{evidence:"Knockdown of clusterin in primary neurons reduced Abeta toxicity and DKK1 upregulation and, conversely, Abeta increased intracellular clusterin and decreased clusterin protein secretion, resulting in the p53-dependent induction of DKK1", annotationSubgraph:["DKK1 subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["High"], pmid:"23164821", citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:6}, end: {_id:4837}, properties:{evidence:"Knockdown of clusterin in primary neurons reduced Abeta toxicity and DKK1 upregulation and, conversely, Abeta increased intracellular clusterin and decreased clusterin protein secretion, resulting in the p53-dependent induction of DKK1", annotationSubgraph:["DKK1 subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["Medium"], pmid:"23164821", citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:6}, end: {_id:4058}, properties:{evidence:"Thus, we have identified a pathway whereby Abeta induces a clusterin/p53/Dkk1/wnt-PCP-JNK pathway, which drives the upregulation of several genes that mediate the development of AD-like neuropathologies, thereby providing new mechanistic insights into the action of Abeta in neurodegenerative diseases.", annotationSubgraph:["DKK1 subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"23164821", citationType:"PubMed", citationRef:"23164821"}}, {start: {_id:4867}, end: {_id:4868}, properties:{evidence:"Here, we report that the Wnt antagonist Dkk-1 selectively increases tau phosphorylation in the hippocampus of aged rats at Ser199/202, Ser396/404, and Ser214 sites", annotationSubgraph:["DKK1 subgraph", "Tau protein subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24270208", citationType:"PubMed", citationRef:"24270208"}}, {start: {_id:4867}, end: {_id:4869}, properties:{evidence:"Here, we report that the Wnt antagonist Dkk-1 selectively increases tau phosphorylation in the hippocampus of aged rats at Ser199/202, Ser396/404, and Ser214 sites", annotationSubgraph:["DKK1 subgraph", "Tau protein subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24270208", citationType:"PubMed", citationRef:"24270208"}}, {start: {_id:4867}, end: {_id:4870}, properties:{evidence:"Here, we report that the Wnt antagonist Dkk-1 selectively increases tau phosphorylation in the hippocampus of aged rats at Ser199/202, Ser396/404, and Ser214 sites", annotationSubgraph:["DKK1 subgraph", "Tau protein subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24270208", citationType:"PubMed", citationRef:"24270208"}}, {start: {_id:4867}, end: {_id:4871}, properties:{evidence:"Here, we report that the Wnt antagonist Dkk-1 selectively increases tau phosphorylation in the hippocampus of aged rats at Ser199/202, Ser396/404, and Ser214 sites", annotationSubgraph:["DKK1 subgraph", "Tau protein subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24270208", citationType:"PubMed", citationRef:"24270208"}}, {start: {_id:4867}, end: {_id:4872}, properties:{evidence:"Here, we report that the Wnt antagonist Dkk-1 selectively increases tau phosphorylation in the hippocampus of aged rats at Ser199/202, Ser396/404, and Ser214 sites", annotationSubgraph:["DKK1 subgraph", "Tau protein subgraph"], annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["High"], pmid:"24270208", citationType:"PubMed", citationRef:"24270208"}}, {start: {_id:4875}, end: {_id:4876}, properties:{evidence:"Arhgef5 can strongly activate RhoA and RhoB and weakly RhoC and RhoG, but not Rac1, RhoQ, RhoD, or RhoV, in transfected human embryonic kidney 293 cells.", annotationSubgraph:["RhoA subgraph"], pmid:"19713215", annotationCellline:["HEK293"], citationType:"PubMed", citationRef:"19713215"}}, {start: {_id:4875}, end: {_id:891}, properties:{evidence:"Arhgef5 can strongly activate RhoA and RhoB and weakly RhoC and RhoG, but not Rac1, RhoQ, RhoD, or RhoV, in transfected human embryonic kidney 293 cells.", annotationSubgraph:["RhoA subgraph"], pmid:"19713215", annotationCellline:["HEK293"], citationType:"PubMed", citationRef:"19713215"}}, {start: {_id:4875}, end: {_id:4877}, properties:{evidence:"Arhgef5 can strongly activate RhoA and RhoB and weakly RhoC and RhoG, but not Rac1, RhoQ, RhoD, or RhoV, in transfected human embryonic kidney 293 cells.", annotationSubgraph:["RhoA subgraph"], pmid:"19713215", annotationCellline:["HEK293"], citationType:"PubMed", citationRef:"19713215"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
