UNWIND [{start: {_id:3487}, end: {_id:118}, properties:{evidence:"Aberrant glycosylation pmodulates phosphorylation of tau by protein kinase A and dephosphorylation of tau by protein phosphatase 2A and 5.", annotationSubgraph:["Tau protein subgraph"], annotationConfidence:["High"], pmid:"12435421", citationType:"PubMed", citationRef:"12435421"}}, {start: {_id:3641}, end: {_id:6}, properties:{evidence:"it has been demonstrated that LRP1 might bind to APP independent of the KPI domain in APP. This APP - LRP1 interaction is facilitated through a trimeric complex of APP-FE65-LRP1, which has a functional role in APP processing. Along with LRP1, APP is transported from the early secretory compartments to the cell surface and subsequently internalised into the endosomal / lysosomal compartments. Recent investigations indicate that ApoER2 and SorLA fulfil a similar role in shifting APP localisation in the cell, which affects APP processing and the production of the APP derived amyloid beta-peptide (Abeta)", annotationSubgraph:["Non-amyloidogenic subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["High"], pmid:"18288927", citationType:"PubMed", citationRef:"18288927"}}, {start: {_id:3648}, end: {_id:6}, properties:{evidence:"We have previously proposed that CLU-client complexes serve as vehicles to dispose of damaged misfolded extracellular proteins in vivo via receptor-mediated endocytosis", annotationSubgraph:["Non-amyloidogenic subgraph", "Endosomal lysosomal subgraph"], annotationConfidence:["Medium"], pmid:"19996109", citationType:"PubMed", citationRef:"19996109"}}, {start: {_id:3779}, end: {_id:455}, properties:{evidence:"We have previously identified the E3 ubiquitin ligase-inducible degrader of the low density lipoprotein receptor (LDLR) (Idol) as a post-translational modulator of LDLR levels. Idol is a direct target for regulation by liver X receptors (LXRs), and its expression is responsive to cellular sterol status independent of the sterol- response element-binding proteins. Here we demonstrate that Idol also targets two closely related LDLR family members, VLDLR and ApoE receptor 2 (ApoER2), proteins implicated in both neuronal development and lipid metabolism. Idol triggers ubiquitination of the VLDLR and ApoER2 on their cytoplasmic tails, leading to their degradation.We demonstrate that LXR activation results in decreased Reelin binding to VLDLR and reduced Dab1 phosphorylation. The identification of VLDLR and ApoER2 as Idol targets suggests potential roles for this LXR- inducible E3 ligase in the central nervous system in addition to lipid metabolism.", annotationSubgraph:["Ubiquitin degradation subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["Medium"], pmid:"20427281", citationType:"PubMed", citationRef:"20427281"}}, {start: {_id:3780}, end: {_id:455}, properties:{evidence:"We have previously identified the E3 ubiquitin ligase-inducible degrader of the low density lipoprotein receptor (LDLR) (Idol) as a post-translational modulator of LDLR levels. Idol is a direct target for regulation by liver X receptors (LXRs), and its expression is responsive to cellular sterol status independent of the sterol- response element-binding proteins. Here we demonstrate that Idol also targets two closely related LDLR family members, VLDLR and ApoE receptor 2 (ApoER2), proteins implicated in both neuronal development and lipid metabolism. Idol triggers ubiquitination of the VLDLR and ApoER2 on their cytoplasmic tails, leading to their degradation.We demonstrate that LXR activation results in decreased Reelin binding to VLDLR and reduced Dab1 phosphorylation. The identification of VLDLR and ApoER2 as Idol targets suggests potential roles for this LXR- inducible E3 ligase in the central nervous system in addition to lipid metabolism.", annotationSubgraph:["Ubiquitin degradation subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["Medium"], pmid:"20427281", citationType:"PubMed", citationRef:"20427281"}}, {start: {_id:3907}, end: {_id:6}, properties:{evidence:"These data indicate that ABCA1 and ABCG1 play a significant role in the regulation of neuronal cholesterol efflux to apoE discs and in suppression of APP processing to generate Abeta peptides.", annotationMeshanatomy:["Neurons"], pmid:"17121837", citationType:"PubMed", citationRef:"17121837"}}, {start: {_id:3909}, end: {_id:6}, properties:{evidence:"These data indicate that ABCA1 and ABCG1 play a significant role in the regulation of neuronal cholesterol efflux to apoE discs and in suppression of APP processing to generate Abeta peptides.", annotationMeshanatomy:["Neurons"], pmid:"17121837", citationType:"PubMed", citationRef:"17121837"}}, {start: {_id:211}, end: {_id:4150}, properties:{evidence:"Finally, Evo-induced c-Jun N-terminal kinases (JNK) activation was reduced by a TRPV1 antagonist, indicating that Evo-induced autophagy may occur through a calcium/c-Jun N-terminal kinase (JNK) pathway.", annotationConfidence:["Medium"], pmid:"24454492", citationType:"PubMed", citationRef:"24454492"}}] AS row
