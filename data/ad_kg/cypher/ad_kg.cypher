CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:3}, end: {_id:710}, properties:{evidence:"The low-density lipoprotein receptor (LDLR) has the highest affinity for apoE and plays an important role in brain cholesterol metabolism.These data suggest that increased APP expression and Abeta exposure alters microtubule function, leading to reduced transport of LDLR to the plasma membrane. Consequent deleterious effects on apoE uptake and function will have implications for AD pathogenesis and/or progression", annotationSubgraph:["Cholesterol metabolism subgraph", "Low density lipoprotein subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"20049331", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"20049331"}}, {start: {_id:552}, end: {_id:21}, properties:{evidence:"During aging changes in the cerebral expression levels of the neurotrophin receptors, TrkA (tyrosine kinase receptor A) and p75l'lTR (p75 neurotrophin receptor) have been deÂ­ scribed. In the human neuroblastoma cell line SHSY5Y as well as in primary cultured neurons chronic treatment with IGF-1 leads to a switch from TrkA to p75NTR expression as seen in aging brains [128]. This switch causes increased 13- secretase activity indirectly by activation of neuronal sphinÂ­ gomyelinase which is responsible for hydrolysis of sphinÂ­ gomyelin and the active liberation of the second messenger ceramide (review in (129]). Ceramide is responsible for the molecular stabilization of BACE-1, the 13-secretase which is rate-limiting for generation of A[130]. This process leads to accumulation of Ap, connecting IGF-1 R signaling to neuÂ­ rotrophin action (Fig. l).", annotationSubgraph:["Beta secretase subgraph", "Sphingolipid metabolic subgraph"], annotationConfidence:["High"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:1614}, end: {_id:1617}, properties:{evidence:"Comparative investigation of the signalling properties of a panel of these compounds demonstrates that CQ alone exhibits FOXO1a regulation without diabetogenicity.", pmid:"22248233", citationType:"PubMed", citationRef:"22248233"}}, {start: {_id:328}, end: {_id:1617}, properties:{evidence:"Our results suggest that Zn2+-dependent regulation of FOXOs and gluconeogenesis may contribute to the therapeutic properties of this drug.", pmid:"22248233", citationType:"PubMed", citationRef:"22248233"}}, {start: {_id:1803}, end: {_id:1808}, properties:{evidence:"The endoplasmic reticulum protein sigma-1 receptors play a key role in Ca2+ signalling and cell survival, and have been shown to regulate a number of neurotransmitter systems in the brain. The selective serotonin reuptake inhibitor (SSRI) fluvoxamine is a very potent agonist at sigma-1 receptors, which are also implicated in cognition and the pathophysiology of neuropsychiatric diseases. A study using the selective sigma-1 receptor agonist [11C]-SA4503 and positron emission tomography demonstrated that fluvoxamine binds to sigma-1 receptors in living human brain at therapeutic doses, suggesting that sigma-1 receptors might play a role in the mechanism of action of fluvoxamine", annotationSubgraph:["NMDA receptor", "Glutamatergic subgraph"], annotationSpecies:["9606"], pmid:"20148109", citationType:"PubMed", citationRef:"20148109"}}, {start: {_id:2475}, end: {_id:1964}, properties:{evidence:"In support of this mechanism, in vitro, rapamycin significantly inhibits the production of NO, TNF-Î± in BV2 microglials by modulating NF-ÎºB signaling.", annotationSubgraph:["Nuclear factor Kappa beta subgraph", "mTOR signaling subgraph"], annotationConfidence:["High"], pmid:"24923557", citationType:"PubMed", citationRef:"24923557"}}, {start: {_id:93}, end: {_id:2517}, properties:{evidence:"Moreover, the scavengers of reactive oxygen species (ROS) including Trolox and N-acetylcysteine (NAC) abrogated the SOD1(G93A)-induced increase in ASK1 activity (Supplementary Figure 2), suggesting that SOD1(G93A) induces ASK1 activation in a ROS-dependent manner.", annotationSpecies:["10090"], annotationMeshanatomy:["Neurons"], annotationConfidence:["High"], pmid:"25018698", citationType:"PubMed", citationRef:"25018698"}}, {start: {_id:3}, end: {_id:985}, properties:{evidence:"Abeta progressively accumulates in mitochondria and mediates mitochondrial toxicity", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17424907", citationType:"PubMed", citationRef:"17424907"}}, {start: {_id:2776}, end: {_id:21}, properties:{evidence:"Here we report evidence that heparan sulfate (HS) interacts with beta- site APP-cleaving enzyme (BACE) 1 and regulates its cleavage of APP.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"14530380", citationType:"PubMed", citationRef:"14530380"}}, {start: {_id:734}, end: {_id:2933}, properties:{evidence:"We have reported recently that the microtubule-associated protein tau is phosphorylated in vitro by Akt , an important kinase in anti- apoptotic signaling regulated by insulin and growth factors.", annotationSubgraph:["Tau protein subgraph", "Akt subgraph"], annotationConfidence:["High"], pmid:"15283963", citationType:"PubMed", citationRef:"15283963"}}, {start: {_id:271}, end: {_id:2563}, properties:{evidence:"We speculate that higher affinity between Abeta and PLA2 has the therapeutic potential of decreasing the Abeta-Abeta interaction, thereby reducing the amyloid aggregation and plaque formation in AD.", annotationConfidence:["Medium"], pmid:"24619194", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:3}, end: {_id:795}, properties:{evidence:"Soluble oligomers of the Amyloid beta peptide accumulate in Alzheimer's disease (AD) brain and have been implicated in mechanisms of pathogenesis. The neurotoxicity of Amyloid beta appears to be, at least in part, due to dysregulation of glutamate signaling. Here, we show that Amyloid beta promote extracellular accumulation of glutamate and d-serine, a co-agonist at glutamate receptors of the N-methyl-d- aspartate subtype (NMDARs), in hippocampal neuronal cultures. Activation of inhibitory GABA(A) receptors by taurine blocked the increase in extracellular glutamate levels, suggesting that selective pharmacological inhibition of neuronal activity can counteract the impact of Amyloid beta on glutamate dyshomeostasis. Results reveal a novel mechanism by which Ab oligomers promote abnormal release of glutamate in hippocampal neurons, which may contribute to dysregulation of excitatory signaling in the brain", annotationSubgraph:["Low density lipoprotein subgraph"], annotationMeshanatomy:["Hippocampus"], annotationConfidence:["Medium"], pmid:"21244351", citationType:"PubMed", citationRef:"21244351"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:2083}, end: {_id:27}, properties:{evidence:"In conclusion, the G-463A polymorphism of MPO was statistically associated with AD in a gender-specific manner. However, given the low significance of P value we suggest no causal effect of the MPO gene in AD, as also evidenced in a recent meta-analysis.", annotationConfidence:["Medium"], pmid:"12946561", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"12946561"}}, {start: {_id:2259}, end: {_id:27}, properties:{evidence:"In conclusion, the involvement of GSTP1 alleles in individual susceptibility to AD was not confirmed as statistically significant in the tested Croatian Caucasian population.", annotationSubgraph:["Glutathione reductase subgraph"], pmid:"15080568", citationType:"PubMed", citationRef:"15080568"}}, {start: {_id:108}, end: {_id:2183}, properties:{evidence:"XIAP expression in motor neurons significantly slows disease progression, whereas p35, a broad caspase inhibitory protein, does not. However, p35, which potently inhibits capase-3, does not slow disease progression in mouse ALS. There are two explanations for this apparent discrepancy. Since caspase-9 remains active in the presence of p35, procaspase-3 may be continuously processed into active caspase-3, finally overriding inhibition by p35. Alternatively, caspase-9 may utilize a substrate other than caspase-3, leading to caspase-3-independent cell death", annotationSubgraph:["Electron transport chain", "Caspase subgraph", "XIAP subgraph"], annotationSpecies:["10090"], pmid:"14657037", citationType:"PubMed", citationRef:"14657037"}}, {start: {_id:4291}, end: {_id:2272}, properties:{evidence:"Exogenous application of VEGF can increase the permeability of the BBB without causing brain edema.", annotationSubgraph:["Vascular endothelial growth factor subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Brain Edema"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"24551038", citationType:"PubMed", citationRef:"24551038"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:348}, end: {_id:349}, properties:{evidence:"Recent data have demonstrated that AbetaPP may signal to the nucleus also using a Abeta-secretase-independent mechanism that involves membrane sequestration and phosphorylation of Tip60.More recently, Stante et al. have suggested that the presence of Fe65 into the nucleus may have a protective role, and that its translocation depends on AbetaPP. They propose that DNA repair defects could significantly contribute to the neurodysfunction and neurodegeneration observed in AD, and that an involvement of the Fe65-APP complex in the response of the cells to DNA damage and in the DNA repair machinery could represent a possible mechanism contributing to neuronal degeneration observed in AD pathology", annotationSubgraph:["Apoptosis signaling subgraph", "Response DNA damage"], annotationConfidence:["Medium"], pmid:"22496686", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:914}, end: {_id:848}, properties:{evidence:"The induction of long-term potentiation at CA3-CA1 synapses is caused by an N-methyl-d-aspartate (NMDA) receptordependent accumulation of intracellular Ca(2+), followed by Src family kinase activation and a positive feedback enhancement of NMDA receptors (NMDARs). Nevertheless, the amplitude of baseline transmission remains remarkably constant even though low frequency stimulation is also associated with an NMDAR-dependent influx of Ca(2+) into dendritic spines. We show here that an interaction between C-terminal Src kinase (Csk) and NMDARs controls the Src-dependent regulation of NMDAR activity. Csk associates with the NMDAR signaling complex in the adult brain, inhibiting the Src-dependent potentiation of NMDARs in CA1 neurons and attenuating the Src-dependent induction of long-term potentiation. Csk associates directly with Src-phosphorylated NR2 subunits in vitro. An inhibitory antibody for Csk disrupts this physical association, potentiates NMDAR mediated excitatory postsynaptic currents, and induces long-term potentiation at CA3-CA1 synapses. Thus, Csk serves to maintain the constancy of baseline excitatory synaptic transmission by inhibiting Src kinase-dependent synaptic plasticity in the hippocampus", annotationSubgraph:["Glutamatergic subgraph"], pmid:"18445593", citationType:"PubMed", citationRef:"18445593"}}, {start: {_id:1220}, end: {_id:1222}, properties:{evidence:"To determine whether the p35 and CDK5 proteins detected in pancreatic islets interact with one another and form a functional complex, we immunoprecipitated the complex from human islets and determined its protein kinase activity as previously described (16). Immunoprecipitation with a p35 antibody, followed by kinase activity determination in the immunoprecipitate using histone H1 as a substrate, demonstrate that p35 and CDK5 form a functional complex capable of phosphorylating histone H1 (Fig. 1D). No kinase activity was detected in the absence of antibody or in the presence of an unrelated control antibody (Fig. 1D).", annotationSubgraph:["Cyclin-CDK subgraph"], annotationMeshanatomy:["Pancreas", "Islets of Langerhans"], annotationConfidence:["High"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:1316}, end: {_id:1115}, properties:{evidence:"The levels and the activation of the insulin-PI3K-AKT signalling components correlated negatively with the level of tau phosphorylation and positively with protein O-GlcNAcylation, suggesting that impaired insulin-PI3K-AKT signalling might contribute to neurodegeneration in AD through down-regulation of O-GlcNAcylation and the consequent promotion of abnormal tau hyperphosphorylation and neurodegeneration.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "Insulin signal transduction"], annotationConfidence:["High"], pmid:"21598254", citationType:"PubMed", citationRef:"21598254"}}, {start: {_id:1930}, end: {_id:1927}, properties:{evidence:"As expected, LPS strongly induced the formation of two NF-kappa B DNA- binding activities, one of which was identified as RelA/p50.", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], pmid:"9209268", citationType:"PubMed", citationRef:"9209268"}}, {start: {_id:2070}, end: {_id:98}, properties:{annotationCellstructure:["Mitochondria"], evidence:"Furthermore, hyperoside inhibited mitochondria-dependent downstream caspase-mediated apoptotic pathway, such as that involving caspase-9, caspase-3, and poly ADP-ribose polymerase (PARP).", annotationSubgraph:["Caspase subgraph"], annotationConfidence:["High"], pmid:"21978835", citationType:"PubMed", citationRef:"21978835"}}, {start: {_id:2070}, end: {_id:2071}, properties:{annotationCellstructure:["Mitochondria"], evidence:"Furthermore, hyperoside inhibited mitochondria-dependent downstream caspase-mediated apoptotic pathway, such as that involving caspase-9, caspase-3, and poly ADP-ribose polymerase (PARP).", annotationSubgraph:["Caspase subgraph"], annotationConfidence:["High"], pmid:"21978835", citationType:"PubMed", citationRef:"21978835"}}, {start: {_id:2255}, end: {_id:2256}, properties:{evidence:"The TSP1/CD36/CD47-complex is involved in T cell expansion and inflammatory responses to beta-amyloid, both relevant to IBM.", annotationSubgraph:["T cells signaling", "Cell adhesion subgraph"], annotationConfidence:["High"], pmid:"17572512", citationType:"PubMed", citationRef:"17572512"}}, {start: {_id:2255}, end: {_id:91}, properties:{evidence:"The TSP1/CD36/CD47-complex is involved in T cell expansion and inflammatory responses to beta-amyloid, both relevant to IBM.", annotationSubgraph:["Inflammatory response subgraph", "Cell adhesion subgraph"], annotationConfidence:["High"], pmid:"17572512", citationType:"PubMed", citationRef:"17572512"}}, {start: {_id:2665}, end: {_id:2670}, properties:{evidence:"In vitro, apoE, and in particular its apoE4 isoform, can bind to and promote fibrillogenesis of the amyloid A beta peptide, the main constituent of senile plaques.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"7615568", citationType:"PubMed", citationRef:"7615568"}}, {start: {_id:2666}, end: {_id:2717}, properties:{evidence:"The findings suggest that in cells that express both apoE and APP, such as astrocytes and microglia, a functional apoE:APP interaction may occur which pmodulates APP processing and Abeta production", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["High"], pmid:"11523796", citationType:"PubMed", citationRef:"11523796"}}, {start: {_id:2665}, end: {_id:2370}, properties:{evidence:"Early studies of the pathological roles of ApoE in neurodegenerative disease showed that ApoE binds in vitro to synthetic Abeta in an isoform-specific manner, potentially enhancing Abeta fibrillization and deposition23", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["High"], pmid:"18297066", citationType:"PubMed", citationRef:"18297066"}}, {start: {_id:2665}, end: {_id:2370}, properties:{evidence:"Apo E and apo E4 in particular have been shown to pmodulate amyloid fibril formation by amyloid-beta peptides in vitro.", annotationSubgraph:["Amyloidogenic subgraph", "APOE subgraph"], annotationConfidence:["Medium"], pmid:"7639323", citationType:"PubMed", citationRef:"7639323"}}, {start: {_id:367}, end: {_id:2828}, properties:{evidence:"Signal transduction through tyrosine-phosphorylated C-terminal fragments of amyloid precursor protein via an enhanced interaction with Shc/Grb2 adaptor proteins in reactive astrocytes of Alzheimer's disease brain.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12084708", citationType:"PubMed", citationRef:"12084708"}}, {start: {_id:351}, end: {_id:2828}, properties:{evidence:"Signal transduction through tyrosine-phosphorylated C-terminal fragments of amyloid precursor protein via an enhanced interaction with Shc/Grb2 adaptor proteins in reactive astrocytes of Alzheimer's disease brain.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"12084708", citationType:"PubMed", citationRef:"12084708"}}, {start: {_id:348}, end: {_id:98}, properties:{evidence:"The cytoplasmic tail of APP interacts with phosphotyrosine binding (PTB) domain containing proteins (Fe65, X11, mDab-1, and JIP-1) and may pmodulate gene expression and apoptotic process.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11877420", citationType:"PubMed", citationRef:"11877420"}}, {start: {_id:2831}, end: {_id:98}, properties:{evidence:"The cytoplasmic tail of APP interacts with phosphotyrosine binding (PTB) domain containing proteins (Fe65, X11, mDab-1, and JIP-1) and may pmodulate gene expression and apoptotic process.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11877420", citationType:"PubMed", citationRef:"11877420"}}, {start: {_id:2832}, end: {_id:98}, properties:{evidence:"The cytoplasmic tail of APP interacts with phosphotyrosine binding (PTB) domain containing proteins (Fe65, X11, mDab-1, and JIP-1) and may pmodulate gene expression and apoptotic process.", annotationSubgraph:["Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"11877420", citationType:"PubMed", citationRef:"11877420"}}, {start: {_id:2924}, end: {_id:840}, properties:{evidence:"We show that ligation of CD40 by CD40L pmodulates Abeta-induced innate immune responses in microglia, including decreased microglia phagocytosis of exogenous Abeta(1-42) and increased production of pro- inflammatory cytokines.", annotationSubgraph:["Inflammatory response subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["Medium"], pmid:"15688347", citationType:"PubMed", citationRef:"15688347"}}, {start: {_id:3010}, end: {_id:106}, properties:{evidence:"Functionally, calmyrin and PS2 increase cell death when cotransfected into HeLa cells.", annotationSubgraph:["Gamma secretase subgraph"], pmid:"10366599", citationType:"PubMed", citationRef:"10366599"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:3057}, end: {_id:1183}, properties:{evidence:"A synthetic peptide, S3 peptide, which acts as a specific competitor for ADF/cofilin phosphorylation by LIMK1, inhibited fAbeta-induced ADF/cofilin phosphorylation, preventing actin filament repmodeling and neuronal degeneration, indicating the involvement of LIMK1 in Abeta- induced neuronal degeneration in vitro.", annotationSubgraph:["Regulation of actin cytoskeleton subgraph"], pmid:"16775141", citationType:"PubMed", citationRef:"16775141"}}, {start: {_id:3084}, end: {_id:349}, properties:{evidence:"In addition, a physical interaction between XPB and OGG1 may account for a potential mechanism involving these DNA repair responses.", annotationSubgraph:["Response DNA damage"], pmid:"19765189", citationType:"PubMed", citationRef:"19765189"}}, {start: {_id:573}, end: {_id:98}, properties:{evidence:"We show here that exogenous expression of a familial AD (FAD) mutant of APP or of the APP binding protein APP-BP1 in neurons causes enlargement of early endosomes, increased receptor-mediated endocytosis via a pathway dependent on APP-BP1 binding to APP, and apoptotic process.", annotationSubgraph:["Gamma secretase subgraph", "Ubiquitin degradation subgraph"], pmid:"17611268", citationType:"PubMed", citationRef:"17611268"}}, {start: {_id:3217}, end: {_id:3452}, properties:{evidence:"APH-1 interacts with mature and immature forms of presenilins and nicastrin and may play a role in maturation of presenilin.nicastrin complexes.", annotationSubgraph:["Gamma secretase subgraph", "Notch signaling subgraph"], annotationConfidence:["Medium"], pmid:"12471034", citationType:"PubMed", citationRef:"12471034"}}, {start: {_id:3453}, end: {_id:3452}, properties:{evidence:"APH-1 interacts with mature and immature forms of presenilins and nicastrin and may play a role in maturation of presenilin.nicastrin complexes.", annotationSubgraph:["Gamma secretase subgraph", "Notch signaling subgraph"], annotationConfidence:["Medium"], pmid:"12471034", citationType:"PubMed", citationRef:"12471034"}}, {start: {_id:3215}, end: {_id:3452}, properties:{evidence:"APH-1 interacts with mature and immature forms of presenilins and nicastrin and may play a role in maturation of presenilin.nicastrin complexes.", annotationSubgraph:["Gamma secretase subgraph", "Notch signaling subgraph"], annotationConfidence:["Medium"], pmid:"12471034", citationType:"PubMed", citationRef:"12471034"}}, {start: {_id:3554}, end: {_id:98}, properties:{evidence:"Apoptosis pathways and DNA synthesis are activated in neurons in the brains of individuals with Alzheimer disease (AD). However, the signaling mechanisms that mediate these events have not been defined. We show that expression of familial AD (FAD) mutants of the amyloid precursor protein (APP) in primary neurons in culture causes apoptosis and DNA synthesis. Both the apoptosis and the DNA synthesis are mediated by the p21 activated kinase PAK3, a serine-threonine kinase that interacts with APP. A dominant-negative kinase mutant of PAK3 inhibits the neuronal apoptosis and DNA synthesis; this effect is abolished by deletion of the PAK3 APP-binding domain or by coexpression of a peptide representing this binding domain. The involvement of PAK3 specifically in FAD APP-mediated apoptosis rather than in general apoptotic pathways is suggested by the facts that a dominant-positive mutant of PAK3 does not alone cause neuronal apoptosis and that the dominant-negative mutant of PAK3 does not inhibit chemically induced apoptotic process.", annotationSubgraph:["Regulation of actin cytoskeleton subgraph"], annotationConfidence:["High"], pmid:"12890786", citationType:"PubMed", citationRef:"12890786"}}, {start: {_id:791}, end: {_id:3763}, properties:{evidence:"integrins play important roles in neurite development, neuronal migration, and synapse functions. Several studies show that Reelin signaling has an important role in neuronal migration through its interaction with ApoE receptor 2 and the VLDL receptor, and the subsequent phosphorylation of Disabled-1. After removal of anyof these components (Reelin, receptors, or Disabled-1), cortical layer formation is severely disrupted, leading to the model that these interactions are important for laminar organization in development.In synapses, Reelin promotes tyrosine phosphorylation of NMDA receptor subunits (e.g., NR2A) and facilitates LTP. Reelin signaling has an important role in NMDA and AMPA receptor function, maturation of glutamatergic synapses.ÃƒÅ¸1 integrin facilitates reorganization of actin filaments and affects neuronal migration and neurite outgrowth. The Reelin-a3ÃƒÅ¸1 integrin interaction regulates neuronal migration, perhaps by reorganizing the actin cytoskeleton, or by stabilizing the cytoskeleton through n-cofilin phosphorylation. Integrins also regulate synaptic glutamate receptor function, synaptic plasticity, working memory, and LTP. The APP-ÃƒÅ¸1 integrin interaction is also important in neurite outgrowth. We suggest that the functions of Reelin and ÃƒÅ¸1 integrins on these processes may be modulated by APP (or other APP family members).", annotationSubgraph:["Low density lipoprotein subgraph", "APOE subgraph", "Reelin signaling subgraph"], annotationConfidence:["Medium"], pmid:"19515914", citationType:"PubMed", citationRef:"19515914"}}, {start: {_id:3427}, end: {_id:3763}, properties:{evidence:"integrins play important roles in neurite development, neuronal migration, and synapse functions. Several studies show that Reelin signaling has an important role in neuronal migration through its interaction with ApoE receptor 2 and the VLDL receptor, and the subsequent phosphorylation of Disabled-1. After removal of anyof these components (Reelin, receptors, or Disabled-1), cortical layer formation is severely disrupted, leading to the model that these interactions are important for laminar organization in development.In synapses, Reelin promotes tyrosine phosphorylation of NMDA receptor subunits (e.g., NR2A) and facilitates LTP. Reelin signaling has an important role in NMDA and AMPA receptor function, maturation of glutamatergic synapses.ÃƒÅ¸1 integrin facilitates reorganization of actin filaments and affects neuronal migration and neurite outgrowth. The Reelin-a3ÃƒÅ¸1 integrin interaction regulates neuronal migration, perhaps by reorganizing the actin cytoskeleton, or by stabilizing the cytoskeleton through n-cofilin phosphorylation. Integrins also regulate synaptic glutamate receptor function, synaptic plasticity, working memory, and LTP. The APP-ÃƒÅ¸1 integrin interaction is also important in neurite outgrowth. We suggest that the functions of Reelin and ÃƒÅ¸1 integrins on these processes may be modulated by APP (or other APP family members).", annotationSubgraph:["Low density lipoprotein subgraph", "APOE subgraph", "Reelin signaling subgraph"], annotationConfidence:["Medium"], pmid:"19515914", citationType:"PubMed", citationRef:"19515914"}}, {start: {_id:3801}, end: {_id:3802}, properties:{evidence:"Investigations of conserved domains support an adhesion property for all members of the APP family. The extracellular sequence of APP has been found to interact with various extracellular matrix components, such as heparin (Clarris et al. 1997; Mok et al. 1997), collagen type I (Beher et al. 1996), and laminin (Kibbey et al. 1993), indicating a role of APP in cell-matrix adhesion. Structural and functional studies also implicate a role of the APP extracellular domains in facilitating cellÃ¢â‚¬â€œcell adhesion through transcellular interactions.", annotationSubgraph:["Binding and Uptake of Ligands by Scavenger Receptors", "Inflammatory response subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"22355794", citationType:"PubMed", citationRef:"22355794"}}, {start: {_id:3805}, end: {_id:3802}, properties:{evidence:"Investigations of conserved domains support an adhesion property for all members of the APP family. The extracellular sequence of APP has been found to interact with various extracellular matrix components, such as heparin (Clarris et al. 1997; Mok et al. 1997), collagen type I (Beher et al. 1996), and laminin (Kibbey et al. 1993), indicating a role of APP in cell-matrix adhesion. Structural and functional studies also implicate a role of the APP extracellular domains in facilitating cellÃ¢â‚¬â€œcell adhesion through transcellular interactions.", annotationSubgraph:["Binding and Uptake of Ligands by Scavenger Receptors", "Inflammatory response subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"22355794", citationType:"PubMed", citationRef:"22355794"}}, {start: {_id:3807}, end: {_id:3802}, properties:{evidence:"Investigations of conserved domains support an adhesion property for all members of the APP family. The extracellular sequence of APP has been found to interact with various extracellular matrix components, such as heparin (Clarris et al. 1997; Mok et al. 1997), collagen type I (Beher et al. 1996), and laminin (Kibbey et al. 1993), indicating a role of APP in cell-matrix adhesion. Structural and functional studies also implicate a role of the APP extracellular domains in facilitating cellÃ¢â‚¬â€œcell adhesion through transcellular interactions.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Medium"], pmid:"22355794", citationType:"PubMed", citationRef:"22355794"}}, {start: {_id:4245}, end: {_id:4246}, properties:{evidence:"One important control for such cell activation is through the CC- chemokine ligand 2 (Ccl2) and its receptor, the CC-chemokine receptor 2. Both affect microglia and peripheral macrophage immune responses and for the latter, cell ingress across the blood-brain barrier.", annotationSubgraph:["Chemokine signaling subgraph"], annotationMeshanatomy:["Macrophages", "Blood-Brain Barrier", "Microglia"], annotationConfidence:["Medium"], pmid:"23040664", citationType:"PubMed", citationRef:"23040664"}}, {start: {_id:4245}, end: {_id:721}, properties:{evidence:"One important control for such cell activation is through the CC- chemokine ligand 2 (Ccl2) and its receptor, the CC-chemokine receptor 2. Both affect microglia and peripheral macrophage immune responses and for the latter, cell ingress across the blood-brain barrier.", annotationSubgraph:["Chemokine signaling subgraph"], annotationMeshanatomy:["Macrophages", "Blood-Brain Barrier", "Microglia"], annotationConfidence:["Medium"], pmid:"23040664", citationType:"PubMed", citationRef:"23040664"}}, {start: {_id:4345}, end: {_id:721}, properties:{evidence:"Cx3cl1/Cx3cr1 signalling is thought to maintain microglia in their resting state and disrupting this equilibrium may allow microglia to become activated.", annotationSubgraph:["Chemokine signaling subgraph"], annotationMeshanatomy:["Microglia"], pmid:"24655482", citationType:"PubMed", citationRef:"24655482"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:175}, end: {_id:180}, properties:{evidence:"HMG-CoA reductase (3-hydroxy-3-methyl-glutaryl-coenzyme A reductase, officially abbreviated HMGCR) is the rate-controlling enzyme (NADH- dependent, EC 1.1.1.88; NADPH-dependent, EC 1.1.1.34) of the mevalonate pathway, the metabolic pathway that produces cholesterol and other isoprenoids. Statins, also known as HMG-CoA reductase inhibitors, are a class of lipid-lowering medications.", annotationSubgraph:["Cholesterol metabolism subgraph", "Lipid metabolism subgraph"], annotationConfidence:["Very High"], pmid:"15639314", citationType:"PubMed", citationRef:"15639314"}}, {start: {_id:635}, end: {_id:265}, properties:{evidence:"AMP-activated protein kinase (AMPK), a master regulator of cellular energy homeostasis and a central player in glucose and lipid metabolism, is potentially implicated in the pathogenesis of Alzheimer's disease (AD).", annotationSubgraph:["Autophagy signaling subgraph", "Tau protein subgraph", "Sphingolipid metabolic subgraph"], annotationConfidence:["Very High"], pmid:"22367557", citationType:"PubMed", citationRef:"22367557"}}, {start: {_id:635}, end: {_id:636}, properties:{evidence:"AMP-activated protein kinase (AMPK), a master regulator of cellular energy homeostasis and a central player in glucose and lipid metabolism, is potentially implicated in the pathogenesis of Alzheimer's disease (AD).", annotationSubgraph:["Autophagy signaling subgraph", "Tau protein subgraph", "Sphingolipid metabolic subgraph"], annotationConfidence:["Very High"], pmid:"22367557", citationType:"PubMed", citationRef:"22367557"}}, {start: {_id:635}, end: {_id:637}, properties:{evidence:"AMP-activated protein kinase (AMPK), a master regulator of cellular energy homeostasis and a central player in glucose and lipid metabolism, is potentially implicated in the pathogenesis of Alzheimer's disease (AD).", annotationSubgraph:["Autophagy signaling subgraph", "Tau protein subgraph", "Sphingolipid metabolic subgraph"], annotationConfidence:["Very High"], pmid:"22367557", citationType:"PubMed", citationRef:"22367557"}}, {start: {_id:1107}, end: {_id:193}, properties:{evidence:"Glucose transport within the brain is mostly insulin independent, suggesting that the primary role of brain insulin might be in signal transduction pathways involved in cognitive processes [Schulingkamp et al., 2000]. Indeed, studies have shown that insulin and insulin receptors are abundantly but selectively distributed in brain areas that are important for learning and memory [Schulingkamp et al., 2000], and treatment of both normal healthy individuals and patients with mild AD with insulin has been shown to improve cognition [Watson and Craft, 2004].", annotationSubgraph:["Insulin signal transduction"], annotationMeshanatomy:["Brain"], annotationConfidence:["Medium"], pmid:"19885299", citationType:"PubMed", citationRef:"19885299"}}, {start: {_id:1237}, end: {_id:1238}, properties:{evidence:"In neurons, p35/CDK5 regulates not only cytoskeletal dynamics and cell migration, but also the cAMP-dependent protein kinase A and the calcium-mediated signaling pathway (14). It also regulates dopamine signaling through phosphorylation of DARPP-32, which converts it into an inhibitor of protein kinase A (25). Therefore, we anticipate that in beta-cells the presence of p35/CDK5 could be involved in the regulation of additional functional pathways. Our findings also indicate that in insulin-producing beta-cells, CDK5 activity is predominantly regulated by variations in the expression of its activator p35, which, in turn, is regulated by extracellular glucose concentrations. During brain development, the expression of p35 seems to be constitutive, and regulation of CDK5 activity is dependent on its subcellular localization, phosphorylation by other protein kinases such as Abl, and association with other regulatory proteins (Dab1 and Cables) (14). However, up-regulation of p35 at the level of transcription can also occur, as shown after stimulation by laminin in cultured neurons (26), nerve growth factor in PC12 cells (27), neuroregulin in cultured myotubules (23), and chronic cocaine administration to rats (28).", annotationSubgraph:["Dopaminergic subgraph", "Cyclin-CDK subgraph"], annotationMeshanatomy:["Neurons"], annotationConfidence:["Medium"], pmid:"14976144", citationType:"PubMed", citationRef:"14976144"}}, {start: {_id:1107}, end: {_id:1302}, properties:{evidence:"Another major physiological role of insulin and IGF-1 is the regulation of gene transcription via the MAP kinase casÂ­ cade. Following insulin and IGF-1 stimulation, IRS prote ins and GAB(GRB-2 associated binder)- I bind to the Sl-12 doÂ­ mains of several small adaptor proteins such as GRB-2. These proteins then interact with the GDP/GTP exchanoe factor SOS (son of sevenless) leading to activation of the small G-protein RAS and subsequently to the recruitment of CRAF to the membrane. Activated CRAF activates MEK which then activates extracellular signal-regulated kinase (ERK)-11-2 (37]. ERK-1/-2 mediated signals are involved in I?n -lasting neuronal plasticity, including long-term potenÂ­ tiatiOn and memory consolidation (review in [38]). In conÂ­ trast, (over-)activation of ERK-1 /-2 also leads to apoptotic eeldeath i.n cae of oxidative stress or growth factor depriÂ­ vation (review m [39]). However, ERKs seems to be an esÂ­ sential gene since animals lacking ERK-2 die in early emÂ­ bryonic development (40].", annotationSubgraph:["Insulin signal transduction", "MAPK-ERK subgraph"], annotationConfidence:["Medium"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:1119}, end: {_id:1302}, properties:{evidence:"Another major physiological role of insulin and IGF-1 is the regulation of gene transcription via the MAP kinase casÂ­ cade. Following insulin and IGF-1 stimulation, IRS prote ins and GAB(GRB-2 associated binder)- I bind to the Sl-12 doÂ­ mains of several small adaptor proteins such as GRB-2. These proteins then interact with the GDP/GTP exchanoe factor SOS (son of sevenless) leading to activation of the small G-protein RAS and subsequently to the recruitment of CRAF to the membrane. Activated CRAF activates MEK which then activates extracellular signal-regulated kinase (ERK)-11-2 (37]. ERK-1/-2 mediated signals are involved in I?n -lasting neuronal plasticity, including long-term potenÂ­ tiatiOn and memory consolidation (review in [38]). In conÂ­ trast, (over-)activation of ERK-1 /-2 also leads to apoptotic eeldeath i.n cae of oxidative stress or growth factor depriÂ­ vation (review m [39]). However, ERKs seems to be an esÂ­ sential gene since animals lacking ERK-2 die in early emÂ­ bryonic development (40].", annotationSubgraph:["Insulin signal transduction", "MAPK-ERK subgraph"], annotationConfidence:["Medium"], pmid:"19519303", citationType:"PubMed", citationRef:"19519303"}}, {start: {_id:1436}, end: {_id:1438}, properties:{evidence:"HnRNP A1 plays several key roles in neuronal functioning and its depletion, either due to debilitated cholinergic neurotransmission or under autoimmune reactions causes drastic changes in RNA metabolism. Consequently, hnRNP A1 decline contributes to the severity of symptoms in several neurodegenerative diseases, including Alzheimer's disease (AD),", annotationConfidence:["Medium"], pmid:"23247072", citationType:"PubMed", citationRef:"23247072"}}, {start: {_id:272}, end: {_id:637}, properties:{evidence:"Butyrylcholinesterase and acetylcholinesterase related proteins were found common to both Alzheimer's disease and diabetes; they may play an etiological role via influencing insulin resistance and lipid metabolism.", annotationSubgraph:["Acetylcholine signaling subgraph", "Insulin signal transduction"], annotationConfidence:["High"], pmid:"17096857", citationType:"PubMed", citationRef:"17096857"}}, {start: {_id:205}, end: {_id:637}, properties:{evidence:"Butyrylcholinesterase and acetylcholinesterase related proteins were found common to both Alzheimer's disease and diabetes; they may play an etiological role via influencing insulin resistance and lipid metabolism.", annotationSubgraph:["Acetylcholine signaling subgraph", "Insulin signal transduction"], annotationConfidence:["Medium"], pmid:"17096857", citationType:"PubMed", citationRef:"17096857"}}, {start: {_id:1561}, end: {_id:1564}, properties:{evidence:"Adiponectin regulates the sensitivity of insulin, fatty acid catabolism, glucose homeostasis and anti-inflammatory system through various mechanisms.", annotationSubgraph:["Insulin signal transduction", "Lipid metabolism subgraph", "Beta-Oxidation of Fatty Acids"], annotationConfidence:["Medium"], pmid:"24386594", citationType:"PubMed", citationRef:"24386594"}}, {start: {_id:1561}, end: {_id:1557}, properties:{evidence:"Adiponectin regulates the sensitivity of insulin, fatty acid catabolism, glucose homeostasis and anti-inflammatory system through various mechanisms.", annotationSubgraph:["Insulin signal transduction", "Lipid metabolism subgraph", "Beta-Oxidation of Fatty Acids"], annotationConfidence:["Medium"], pmid:"24386594", citationType:"PubMed", citationRef:"24386594"}}, {start: {_id:1241}, end: {_id:1613}, properties:{evidence:"Furthermore, GLP-1 peptides are not only effective in modulating insulin-release and achieving glycaemic control in type 2 diabetes, but are also effective in modulating synaptic plasticity.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Medium"], pmid:"20035739", annotationDisease:["type 2 diabetes mellitus"], citationType:"PubMed", citationRef:"20035739"}}, {start: {_id:2231}, end: {_id:2232}, properties:{evidence:"One critical function of pRb is the control of the G1-to-S phase checkpoint of the cell cycle.", annotationSubgraph:["Cell cycle subgraph", "Retinoblastoma subgraph"], annotationConfidence:["Medium"], pmid:"21666500", citationType:"PubMed", citationRef:"21666500"}}, {start: {_id:1365}, end: {_id:2626}, properties:{evidence:"alpha(2)M also regulates proteinase and growth factor activities", annotationSubgraph:["Alpha 2 macroglobulin subgraph"], annotationConfidence:["Medium"], pmid:"14678766", citationType:"PubMed", citationRef:"14678766"}}, {start: {_id:115}, end: {_id:2967}, properties:{evidence:"Collapsin response mediator protein 2 (CRMP2) is an abundant brain- enriched protein that can regulate microtubule assembly in neurons.", annotationSubgraph:["Cyclin-CDK subgraph", "Regulation of actin cytoskeleton subgraph"], annotationConfidence:["Medium"], pmid:"17683481", citationType:"PubMed", citationRef:"17683481"}}, {start: {_id:376}, end: {_id:2338}, properties:{evidence:"Increasing evidence suggests that the low density lipoprotein receptor-related protein ( LRP ) affects the processing of amyloid precursor protein ( APP ) and amyloid beta ( Abeta ) protein production as well as mediates the clearance of Abeta from the brain.", annotationSubgraph:["Non-amyloidogenic subgraph", "Low density lipoprotein subgraph"], annotationConfidence:["Medium"], pmid:"15772078", citationType:"PubMed", citationRef:"15772078"}}, {start: {_id:6}, end: {_id:333}, properties:{evidence:"Genetically, AD is linked to mutations in few proteins amyloid precursor protein (APP) and presenilin 1 and 2 (PS1 and PS2). The molecular mechanisms underlying neurodegeneration in AD as well as the physiological function of APP are not yet known. A recent theory has proposed that APP and PS1 modulate intracellular signals to induce cell-cycle abnormalities responsible for neuronal death and possibly amyloid deposition.", annotationSubgraph:["Gamma secretase subgraph"], annotationConfidence:["Low"], pmid:"22496686", citationType:"PubMed", citationRef:"22496686"}}, {start: {_id:4226}, end: {_id:4227}, properties:{evidence:"Runx1t1 (Runt-related transcription factor 1, translocated to 1) has been implicated in recruiting histone deacetylases (HDACs) for transcriptional repression, thereby regulating cell proliferation.", annotationSubgraph:["Nitric oxide subgraph"], annotationMeshanatomy:["Microglia"], annotationConfidence:["Medium"], pmid:"24586690", citationType:"PubMed", citationRef:"24586690"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
