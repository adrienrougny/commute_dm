UNWIND [{start: {_id:21}, end: {_id:289}, properties:{evidence:"Sequential processing of amyloid precursor protein (APP) by membrane- bound proteases, BACE1 and gamma-secretase, plays a crucial role in the pathogenesis of Alzheimer disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15824102", citationType:"PubMed", citationRef:"15824102"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Release of Abeta from the amyloid precursor protein (APP) requires proteolysis by the beta-site APP-cleaving enzyme (BACE1).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16027115", citationType:"PubMed", citationRef:"16027115"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Abeta is produced from beta-amyloid precursor protein (APP) by beta- secretase and gamma-secretase. beta-Secretase has been identified as beta-site APP cleaving enzyme1 (BACE1).", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16290302", citationType:"PubMed", citationRef:"16290302"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"The beta-amyloid peptide (Abeta) is a major component of the Alzheimer's disease (AD)-associated senile plaques and is generated by sequential cleavage of the beta-amyloid precursor protein (APP) by beta-secretase and gamma-secretase.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16888322", citationType:"PubMed", citationRef:"16888322"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Amyloid beta-peptide (Abeta), which is a product of the proteolytic effect of beta-secretase (BACE) on an amyloid precursor protein, is closely associated with Alzheimer's disease (AD) pathogenesis.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17205046", citationType:"PubMed", citationRef:"17205046"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Proteolytic processing of the amyloid precursor protein (APP) by beta- secretase, beta-site APP cleaving enzyme (BACE1), is the initial step in the production of the amyloid beta (Abeta) peptide, which is involved in the pathogenesis of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["High"], pmid:"17573534", citationType:"PubMed", citationRef:"17573534"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Pathologically, AD is characterized by the deposition in the brain of amyloid-beta peptides derived from proteolysis of amyloid precursor protein (APP) by beta-site APP cleaving enzyme 1 (BACE1) and gamma- secretase.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17611486", citationType:"PubMed", citationRef:"17611486"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Abeta is generated by proteolytic processing of amyloid precursor protein (APP) via beta and gamma-secretases.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17908048", citationType:"PubMed", citationRef:"17908048"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Proteolytic cleavage of amyloid precursor protein by beta-secretase (BACE-1) and gamma-secretase leads to formation of beta-amyloid (A beta) a key component of amyloid plaques, which are considered the hallmark of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"18162398", citationType:"PubMed", citationRef:"18162398"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"In the amyloidogenic pathway, a small proportion of APP is cleaved by beta- and gamma-secretases, known as beta-site APP-cleaving enzyme 1 (BACE1) and presenilin, respectively, leading to the secretion of Abeta peptides.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"19729516", citationType:"PubMed", citationRef:"19729516"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Alzheimer's beta-secretase (BACE1) cleaves amyloid precursor protein to produce amyloid beta-peptide, which is a crucial initiation process of the pathogenesis of Alzheimer's disease.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15467394", citationType:"PubMed", citationRef:"15467394"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Mapping to the Down syndrome critical region (chromosome 21) and identified as a homologue of BACE1, BACE2 also cleaves amyloid precursor protein at the beta-site.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15473697", citationType:"PubMed", citationRef:"15473697"}}, {start: {_id:2783}, end: {_id:289}, properties:{evidence:"Mapping to the Down syndrome critical region (chromosome 21) and identified as a homologue of BACE1, BACE2 also cleaves amyloid precursor protein at the beta-site.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"15473697", citationType:"PubMed", citationRef:"15473697"}}, {start: {_id:473}, end: {_id:289}, properties:{evidence:"Gamma-secretase (PSEN1, PSEN2, NCSTN) cleaves LRP1 and LRP8 as well as APP and their degradation products control transcription factor TFCP2, which regulates thymidylate synthase (TS) and GSK3B expression.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16973241", citationType:"PubMed", citationRef:"16973241"}}, {start: {_id:476}, end: {_id:289}, properties:{evidence:"Gamma-secretase (PSEN1, PSEN2, NCSTN) cleaves LRP1 and LRP8 as well as APP and their degradation products control transcription factor TFCP2, which regulates thymidylate synthase (TS) and GSK3B expression.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16973241", citationType:"PubMed", citationRef:"16973241"}}, {start: {_id:2792}, end: {_id:289}, properties:{evidence:"Gamma-secretase (PSEN1, PSEN2, NCSTN) cleaves LRP1 and LRP8 as well as APP and their degradation products control transcription factor TFCP2, which regulates thymidylate synthase (TS) and GSK3B expression.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16973241", citationType:"PubMed", citationRef:"16973241"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"BACE1 is a membrane-bound aspartyl protease that specifically cleaves amyloid precursor protein (APP) at the beta-secretase site.", annotationSubgraph:["Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"16979658", citationType:"PubMed", citationRef:"16979658"}}, {start: {_id:21}, end: {_id:289}, properties:{evidence:"Hypoxia up-regulated beta-secretase cleavage of APP and amyloid-beta protein (Abeta) production by increasing BACE1 gene transcription and expression both in vitro and in vivo.", annotationSubgraph:["Hypoxia response subgraph", "Beta secretase subgraph", "Amyloidogenic subgraph"], annotationConfidence:["Medium"], pmid:"17121991", citationType:"PubMed", citationRef:"17121991"}}] AS row
