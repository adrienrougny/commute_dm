bgraph"], annotationConfidence:["High"], pmid:"20847424", citationType:"PubMed", citationRef:"20847424"}}, {start: {_id:2563}, end: {_id:96}, properties:{evidence:"This study involves the reductionist fragment-based approach to understand the structure adopted by N-terminal fragment of Alzheimer's Abeta peptide in its complex with PLA2.", annotationConfidence:["Medium"], pmid:"24619194", citationType:"PubMed", citationRef:"24619194"}}, {start: {_id:2457}, end: {_id:1748}, properties:{evidence:"We have previously reported that CysLT1R activation is involved in Abeta generation.", annotationSubgraph:["G-protein-mediated signaling"], annotationConfidence:["Medium"], pmid:"24879954", annotationDisease:["Alzheimer's disease"], citationType:"PubMed", citationRef:"24879954"}}] AS row
