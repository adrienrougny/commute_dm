##############
# Statements #
##############
SET Citation = {"PubMed", "31967327"}

SET Support = "Coronaviruses (CoVs) are important pathogens for human and vertebrates. They can infect respiratory, gastrointestinal, hepatic, and central nervous system of human, livestock, birds, bat, mouse, and many other wild animals."
SET Anatomy = {"respiratory system", "digestive tract", "liver", "central nervous system"}
a(MESH:"Coronavirus") -> path(MESHD:"Infection")
UNSET Anatomy

SET Support = "The genome and subgenomes of a typical CoV contain at least six ORFs. The first ORFs (ORF1a/b), about two‐thirds of the whole genome length, encode 16 nsps (nsp1‐16), except Gammacoronavirus that lacks nsp1."
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("1_180"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("1_180"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("819_2763"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("2764_3263"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("3264_3569"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("3570_3859"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("3860_3942"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("3943_4140"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("4141_4253"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("4254_4392"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("4393_5324"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("5325_5925"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("5926_6452"))
r(UNIPROT:"P0DTD1") >> p(UNIPROT:"P0DTD1", frag("6453_6798"))


SET Support = "CoVs belong to the subfamily Coronavirinae in the family of Coronaviridae of the order Nidovirales, and this subfamily includes four genera: Alphacoronavirus, Betacoronavirus, Gammacoronavirus,and Deltacoronavirus."
a(NCBITAXON:"Orthocoronavirinae") isA a(NCBITAXON:"Coronaviridae")
a(NCBITAXON:"Coronaviridae") isA a(NCBITAXON:"Nidovirales")
a(NCBITAXON:"Orthocoronavirinae") hasMembers list(a(NCBITAXON:"Alphacoronavirus"), a(NCBITAXON:"Betacoronavirus"),a(NCBITAXON:"Gammacoronavirus"),a(NCBITAXON:"Deltacoronavirus"))

SET Support = "These polypeptides are processed by virally encoded chymotrypsin‐like protease (3CLpro) or main protease (Mpro) and one or two papain‐like protease into 16 nsps."
p(UNIPROT:"P0DTD1", frag("3264_3569")) isA p(ECCODE:"3.4.21.39")

SET Support = "Sequence analysis shows that the 2019‐nCoV possesses a typical genome structure of CoV and belongs to the cluster of betacoronaviruses that includes Bat‐SARS‐like (SL)‐ZC45, Bat‐SL ZXC21, SARS‐CoV, and MERS‐CoV."
a(NCBITAXON:"Severe acute respiratory syndrome coronavirus 2") isA a(NCBITAXON:"Betacoronavirus")
a(NCBITAXON:"Severe acute respiratory syndrome-related coronavirus") isA a(NCBITAXON:"Betacoronavirus")
a(NCBITAXON:"Middle East respiratory syndrome-related coronavirus") isA a(NCBITAXON:"Betacoronavirus")

SET Species = "2697049"
SET Support = "nsp1 function: Cellular mRNA degradation, inhibiting IFN signaling."
p(UNIPROT:"P0DTD1", frag("1_180")) -> deg(r(MESHC:"RNA, Messenger"))

SET Support = "nsp3 function: PLP, polypeptides cleaving, blocking host innate immune response, promoting cytokine expression."
p(UNIPROT:"P0DTD1", frag("819_2763")) -| bp(GOBP:"innate immune response")
p(UNIPROT:"P0DTD1", frag("819_2763")) -> bp(GOBP:"cytokine production")

SET Support = "nsp4 function: DMV formation."
p(UNIPROT:"P0DTD1", frag("2764_3263")) -> a(GOCC:"double membrane vesicle viral factory")

SET Support = "nsp6 function: Restricting autophagosome expansion, DMV formation."
p(UNIPROT:"P0DTD1", frag("3570_3859")) -> a(GOCC:"double membrane vesicle viral factory")

SET Support = "nsp7 function: Cofactor with nsp8 and nsp12."
complex(p(UNIPROT:"P0DTD1", frag("3860_3942")),p(UNIPROT:"P0DTD1", frag("3943_4140")), p(UNIPROT:"P0DTD1", frag("4393_5324")))

SET Support = "nsp9 function: Dimerization and RNA binding."
act(p(UNIPROT:"P0DTD1", frag("4141_4253")),ma(GO:"protein dimerization activity"))
act(p(UNIPROT:"P0DTD1", frag("4141_4253")),ma(GO:"RNA binding"))

SET Support = "nsp10 function: Scaffold protein for nsp14 and nsp16."
complex(p(UNIPROT:"P0DTD1", frag("4254_4392")), p(UNIPROT:"P0DTD1", frag("5926_6452")))
complex(p(UNIPROT:"P0DTD1", frag("4254_4392")),p(UNIPROT:"P0DTD1", frag("6799_7096")))

SET Support = "nsp12 function: Primer dependent RdRp."
p(UNIPROT:"P0DTD1", frag("4393_5324")) isA p(ECCODE:"2.7.7.48")

SET Support = "nsp13 function: RNA helicase, 5′ triphosphatase."
p(UNIPROT:"P0DTD1", frag("5325_5925")) isA p(ECCODE:"3.6.4.13")

SET Support = "nsp14 function: Exoribonuclease, N7‐MTase."
p(UNIPROT:"P0DTD1", frag("5926_6452")) isA p(ECCODE:"2.1.1.56")

SET Support = "nsp16 function: 2′‐O‐MTase; avoiding MDA5 recognition,negatively regulating innate immunity."
p(UNIPROT:"P0DTD1", frag("6799_7096")) isA p(ECCODE:"2.1.1.57")
p(UNIPROT:"P0DTD1", frag("6799_7096")) -| bp(GOBP:"innate immune response")

SET Support = "Homotrimers of S proteins make up the spikes on the viral surface and they are responsible for attachment to host receptors."
p(UNIPROT:"P0DTC2") -> bp(MESHPP:"Virus Attachment")
UNSET Species

SET Support = "Before 2019, there were only six CoVs that were known to infect human and cause respiratory diseases. HCoV‐229E, HCoV‐OC43, HCoV‐NL63, and HKU1 cause only mild upper respiratory disease, and in rare cases some of them can cause severe infection in infants, young children and elders."
a(NCBITAXON:"Human coronavirus 229E") isA a(MESH:"Coronavirus")
a(NCBITAXON:"Human coronavirus 229E") -> path(DO:"Coronavirus infection")
a(NCBITAXON:"Human coronavirus 229E") -> path(DO:"respiratory system disease")
a(NCBITAXON:"Human coronavirus OC43") isA a(MESH:"Coronavirus")
a(NCBITAXON:"Human coronavirus OC43") -> path(DO:"Coronavirus infection")
a(NCBITAXON:"Human coronavirus OC43") -> path(DO:"respiratory system disease")
a(NCBITAXON:"Human coronavirus NL63") isA a(MESH:"Coronavirus")
a(NCBITAXON:"Human coronavirus NL63") -> path(DO:"Coronavirus infection")
a(NCBITAXON:"Human coronavirus NL63") -> path(DO:"respiratory system disease")
a(NCBITAXON:"Human coronavirus HKU1") isA a(MESH:"Coronavirus")
a(NCBITAXON:"Human coronavirus HKU1") -> path(DO:"Coronavirus infection")
a(NCBITAXON:"Human coronavirus HKU1") -> path(DO:"respiratory system disease")

SET Support = "SARS‐CoV and MERS‐CoV can infect lower respiratory tract and cause severe respiratory syndrome in human."
a(NCBITAXON:"Severe acute respiratory syndrome-related coronavirus") isA a(MESH:"Coronavirus")
a(NCBITAXON:"Severe acute respiratory syndrome-related coronavirus") -> path(DO:"Coronavirus infection")
a(NCBITAXON:"Severe acute respiratory syndrome-related coronavirus") -> path(DO:"lower respiratory tract disease")
a(NCBITAXON:"Middle East respiratory syndrome-related coronavirus") isA a(MESH:"Coronavirus")
a(NCBITAXON:"Middle East respiratory syndrome-related coronavirus") -> path(DO:"Coronavirus infection")
a(NCBITAXON:"Middle East respiratory syndrome-related coronavirus") -> path(DO:"lower respiratory tract disease")

SET Support = "The new CoV, 2019‐nCoV, which belongs to betacoronaviruses based on sequence analysis (Figure 1A), can also infect the lower respiratory tract and cause pneumonia in human, but it seems that the symptoms are milder than SARS and MERS."
a(NCBITAXON:"Severe acute respiratory syndrome coronavirus 2") -> path(DO:"lower respiratory tract disease")
a(NCBITAXON:"Severe acute respiratory syndrome coronavirus 2") -> path(DO:"pneumonia")

SET Support = "Among the six death cases, four patients with published information are elder people of over 60 years old and have other illnesses before the infection, such as abdominal tumor and chronic liver disease, myocarditis and renal dysfunction, and cardiovascular disease."
path(MESHD:"Abdominal Neoplasms") -- path(DO:"COVID-19")
path(DO:"myocarditis") -- path(DO:"COVID-19")
path(DO:"cardiovascular system disease") -- path(DO:"COVID-19")
path(MESHD:"Renal Insufficiency") -- path(DO:"COVID-19")

SET Support = "Virus PRCV/ISU‐1, Genus Alpha, Host Pig, Symptoms Mild respiratory tract infections."
# The host is pig
a(NCBITAXON:"PRCV ISU-1") isA a(NCBITAXON:"Alphacoronavirus")
a(NCBITAXON:"PRCV ISU-1") -> path(MESHD:"Respiratory Tract Diseases")

SET Support = "Virus Camel alphacoronavirus isolate camel/Riyadh, Genus Alpha, Host Camel, Symptoms Asymptomatic."
# The host is camel
a(NCBITAXON:"Camel alphacoronavirus") isA a(NCBITAXON:"Alphacoronavirus")

SET Support = "Virus MHV‐A59, Genus Beta, Host Mouse, Symptoms Acute pneumonia and severe lung injuries."
# The host is mouse
a(NCBITAXON:"Murine coronavirus inf-MHV-A59") isA a(NCBITAXON:"Betacoronavirus")
a(NCBITAXON:"Murine coronavirus inf-MHV-A59") -> a(MESHD:"Pneumonia")
a(NCBITAXON:"Murine coronavirus inf-MHV-A59") -> a(MESHD:"Lung Injury")

SET Support = "Virus Beluga Whale CoV/SW1, Genus Gamma, Host Whale, Symptoms Pulmonary disease, terminal acute liver failure."
# The host is Whale
a(NCBITAXON:"Beluga whale coronavirus SW1") isA a(NCBITAXON:"Gammacoronavirus")
a(NCBITAXON:"Beluga whale coronavirus SW1") -> a(MESHD:"Liver Failure, Acute")

SET Support = "Virus IBV, Genus Gamma, Host Chicken, Symptoms Severe respiratory disease."
# The host is Chicken
a(NCBITAXON:"Infectious bronchitis virus") isA a(NCBITAXON:"Gammacoronavirus")
a(NCBITAXON:"Infectious bronchitis virus") -> path(MESHD:"Respiratory Tract Diseases")

SET Support = "Virus Bulbul coronavirus HKU11, Genus Delta, Host Bulbul, Symptoms Respiratory disease (collected from respiratory tract of dead wild birds)."
# The host is Bulbul
a(NCBITAXON:"Bulbul coronavirus HKU11") isA a(NCBITAXON:"Deltacoronavirus")
a(NCBITAXON:"Bulbul coronavirus HKU11") -> path(MESHD:"Respiratory Tract Diseases")

SET Support = "Virus Sparrow coronavirus HKU17, Genus Delta, Host Sparrow, Symptoms Respiratory disease (collected from respiratory tract of dead wild birds)."
# The host is Sparrow
a(NCBITAXON:"Sparrow coronavirus HKU17") isA a(NCBITAXON:"Deltacoronavirus")
a(NCBITAXON:"Sparrow coronavirus HKU17") -> path(MESHD:"Respiratory Tract Diseases")

SET Support = "Plasma and antibodies obtained from the convalescent patients have been proposed for use in treatment."
bp(MESH:"Immunization, Passive") -| path(DO:"COVID-19")

SET Support = "In addition, various vaccine strategies, such as using inactivated viruses, live‐attenuated viruses, viral vector‐based vaccines, subunit vaccines, recombinant proteins, and DNA vaccines, have been developed but have only been evaluated in animals so far."
a(MESHC:"Vaccines, Subunit") -| path(DO:"COVID-19")
a(MESHC:"Recombinant Proteins") -| path(DO:"COVID-19")
a(MESHC:"Vaccines, DNA")  -| path(DO:"COVID-19")
a(MESHC:"Vaccines, Inactivated") -| path(DO:"COVID-19")
a(MESHC:"Vaccines, Attenuated") -| path(DO:"COVID-19")
