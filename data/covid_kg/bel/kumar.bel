##############
# Statements #
##############
SET Citation = {"chemrxiv", "https://doi.org/10.26434/chemrxiv.11860011.v2"}

SET Support = "The recent outbreak of coronavirus disease 2019 (COVID-19) caused by SARS-CoV-2 in China has been the cause of major concern for the global community as the number of people infected with the virus has been continuously increasing with a significant geographical spread."
a(NCBITAXON:"Severe acute respiratory syndrome coronavirus 2") -> path(DO:"COVID-19")

SET Support = "China’s National Health Commission has recommended using HIV-1 protease inhibitors, lopinavir, and ritonavir as an ad hoc treatment against the infection while Wang et al. have tested seven approved drugs in vitro against the clinical isolate of the virus."
a(PUBCHEM:92727) isA a(CHEBI:"HIV protease inhibitor")
a(PUBCHEM:392622) isA a(CHEBI:"HIV protease inhibitor")
# PUBCHEM:92727 corresponds to Lopinavir
# PUBCHEM:392622 corresponds to ritonavir

SET Support = "It encodes for two large polyproteins that are further processed by virally encoded cysteine proteases, namely, the papain-like protease (PLpro) and the 3-chymotrypsin-like protease (3CLpro, also known as the main protease-Mpro)."
p(UNIPROT:"P0DTD1", frag("3264_3569")) isA p(ECCODE:"3.4.22.-")
p(UNIPROT:"P0DTD1", frag("819_2763")) isA p(ECCODE:"3.4.22.-")
# EC 3.4.22.- corresponds to cysteine proteases

SET Support = " Apart from proteolytic processing, PLpro also has a deubiquitinase and deISGylating activity."
p(UNIPROT:"P0DTD1", frag("819_2763")) isA p(ECCODE:"3.4.19.12")

SET Support = "Sixteen FDA approved drugs showing the best affinity to SARS-COV-2 PLpro. Name Biltricide, Current Application Anthelmintic."
complex(a(PUBCHEM:4891), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:4891) isA a(CHEBI:"anthelminthic drug")
a(PUBCHEM:4891) -| path(DO:"COVID-19")
# PUBCHEM:4891 corresponds to Biltricide

SET Support = "Name Cinacalcet, Current Application Calcimimetic to treat hyperparathyroidism."
complex(a(PUBCHEM:156419), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:156419) isA a(CHEBI:"calcimimetic")
a(PUBCHEM:156419) -| path(DO:"hyperparathyroidism")
a(PUBCHEM:156419) -| path(DO:"COVID-19")
# PUBCHEM:156419 corresponds to Cinacalcet

SET Support = "Name Procainamide, Current Application Antiarrhythmic."
complex(a(PUBCHEM:4913), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:4913) isA a(CHEBI:"anti-arrhythmia drug")
a(PUBCHEM:4913) -| path(DO:"COVID-19")
# PUBCHEM:4913 corresponds to Procainamide

SET Support = "Name Terbinafine, Current Application Anti-fungal."
complex(a(PUBCHEM:1549008), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:1549008) isA a(CHEBI:"antifungal drug")
a(PUBCHEM:1549008) -| path(DO:"COVID-19")
# PUBCHEM:1549008 corresponds to Terbinafine

SET Support = "Name Pethidine, Current Application Narcotic analgesic."
complex(a(PUBCHEM:4058), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:4058) isA a(CHEBI:"opioid analgesic")
a(PUBCHEM:4058) -| path(DO:"COVID-19")
# PUBCHEM:4058 corresponds to Pethidine

SET Support = "Name Labetalol, Current Application To treat hypertension."
complex(a(PUBCHEM:3869), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:3869) isA a(CHEBI:"antihypertensive agent")
a(PUBCHEM:3869) -| path(DO:"COVID-19")
# PUBCHEM: corresponds to Labetalol

SET Support = "Name Tetrahydrozoline, Current Application Over the counter eye drops and nasal spray."
complex(a(PUBCHEM:5419), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:5419) -| path(DO:"COVID-19")
# PUBCHEM: corresponds to Tetrahydrozoline

SET Support = "Name Ticlopidine, Current Application Inhibitor of platelet aggregation."
complex(a(PUBCHEM:5472), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:5472) isA a(CHEBI:"platelet aggregation inhibitor")
a(PUBCHEM:5472) -| path(DO:"COVID-19")
# PUBCHEM:5472 corresponds to Ticlopidine

SET Support = "Name Ethoheptazine, Current Application Opioid analgesic."
complex(a(PUBCHEM:6469), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:6469) isA a(CHEBI:"opioid analgesic")
a(PUBCHEM:6469) -| path(DO:"COVID-19")
# PUBCHEM:6469 corresponds to Ethoheptazine

SET Support = "Name Levamisole, Current Application Antihelminthic used for parasitic viral and bacterial infections."
complex(a(PUBCHEM:26879), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:26879) isA a(CHEBI:"anthelminthic drug")
a(PUBCHEM:26879) -| path(DO:"COVID-19")
# PUBCHEM:26879 corresponds to Levamisole

SET Support = "Name Amitriptyline, Current Application antidepressant with analgesic properties."
complex(a(PUBCHEM:2160), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:2160) isA a(CHEBI:"antidepressant")
a(PUBCHEM:2160) -| path(DO:"COVID-19")
# PUBCHEM:2160 corresponds to Amitriptyline

SET Support = "Name Naphazoline, Current Application Decongestant in over the counter eye drops and nasal preparations."
complex(a(PUBCHEM:4436), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:4436) isA a(CHEBI:"nasal decongestant")
a(PUBCHEM:4436) -| path(DO:"COVID-19")
# PUBCHEM:4436 corresponds to Naphazoline

SET Support = "Name Formoterol, Current Application Management of COPD and asthma."
complex(a(PUBCHEM: 3083544), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:3083544) -| path(DO:"chronic obstructive pulmonary disease")
a(PUBCHEM:3083544) -| path(DO:"asthma")
a(PUBCHEM:3083544) -| path(DO:"COVID-19")
# PUBCHEM:3083544 corresponds to Formoterol

SET Support = "Name Benzylpenicillin, Current Application Narrow-spectrum antibiotic."
complex(a(PUBCHEM:5904), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:5904) isA a(CHEBI:"antibacterial drug")
a(PUBCHEM:5904) -| path(DO:"COVID-19")
# PUBCHEM:5904 corresponds to Benzylpenicillin

SET Support = "Name Chloroquine, Current Application Antimalarial agent."
complex(a(PUBCHEM:2719), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:2719) isA a(CHEBI:"antimalarial")
a(PUBCHEM:2719) -| path(DO:"COVID-19")
# PUBCHEM:2719 corresponds to Chloroquine

SET Support = "Name Chlorothiazide, Current Application Diuretic."
complex(a(PUBCHEM:2720), p(UNIPROT:"P0DTD1", frag("819_2763")))
a(PUBCHEM:2720) isA a(CHEBI:"diuretic")
a(PUBCHEM:2720) -| path(DO:"COVID-19")
# PUBCHEM: corresponds to Chlorothiazide
