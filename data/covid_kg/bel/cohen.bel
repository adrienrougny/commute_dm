# --------------------------------------------------------------------------------

##############
# Statements #
##############
SET Citation = {"preprints", "10.20944/preprints202003.0302.v1"}

SET Support = "As of March 17th, 2020, the COVID-19 disease, caused by the SARS-CoV-2 virus (a.k.a 2019-nCoV), has become a pandemic with 179,111 confirmed cases and 7,426 deaths in more than 100 countries."
a(NCBITAXON:"Severe acute respiratory syndrome coronavirus 2") -> path(DO:"COVID-19")

SET Support = "Among those pathways, the Unfolded Protein Response (UPR) and Autophagy pathways are tightly interconnected and were shown to be essential for viral infection by multiple previous studies."
bp(GOBP:"cellular response to unfolded protein") -- bp(PW:"cellular autophagy pathway")
bp(GOBP:"cellular response to unfolded protein") -- path(DO:"viral infectious disease")
bp(PW:"cellular autophagy pathway") -- path(DO:"viral infectious disease")

SET Support = "Briefly, these two pathways are involved in the regulation of protein homeostasis, apoptosis, and play pivotal roles in the control of innate immunity, including the clearance of viral particles."
bp(GOBP:"cellular response to unfolded protein") reg bp(MESH:"Proteostasis")
bp(GOBP:"cellular response to unfolded protein") reg bp(MESHPP:"Apoptosis")
bp(GOBP:"cellular response to unfolded protein") reg bp(GOBP:"innate immune response")
bp(PW:"cellular autophagy pathway") reg bp(MESH:"Proteostasis")
bp(PW:"cellular autophagy pathway") reg bp(MESHPP:"Apoptosis")
bp(PW:"cellular autophagy pathway") reg bp(GOBP:"innate immune response")

SET Support = "For example, recent work showed that the MERS-CoV virus induces reduced levels of the Beclin1 (BECN1) protein, which blocks the fusion of autophagosomes and lysosomes and the inhibition of the S-phase kinase-associated protein 2 (SKP2), an E3 ubiquitin ligase which promotes BECN1 degradation, enhances autophagy and reduces the replication of MERS-CoV up to 28,000-fold."
SET Disease = "Middle East respiratory syndrome"
a(NCBITAXON:"Middle East respiratory syndrome-related coronavirus") -| p(HGNC:"BECN1")
p(HGNC:"SKP2") -| bp(MESHPP:"Virus Replication")
UNSET Disease
p(HGNC:"BECN1") -> bp(GO:"autophagosome-lysosome fusion")
p(HGNC:"BECN1") -| act(p(HGNC:"SKP2"))
p(HGNC:"SKP2") isA p(ECCODE:"2.3.2.27")
p(HGNC:"SKP2") -> deg(p(HGNC:"BECN1"))
p(HGNC:"SKP2") -> bp(GOBP:"autophagy")

SET Support = "In addition, viruses are also able to modify and use the UPR/Autophagy signaling networks to complete their life cycle (e.g., enter the host cell, produce large quantities of their viral proteins)."
SET Disease = {"Middle East respiratory syndrome","Severe acute respiratory syndrome-related coronavirus", "COVID-19"}
bp(GOBP:"cellular response to unfolded protein") -- bp(GOBP:"viral entry into host cell")
bp(PW:"cellular autophagy pathway") -- bp(GOBP:"viral entry into host cell")
UNSET Disease

SET Support = "Based on these findings, we suggest that two additional pathways, which are linked to the UPR/Autophagy pathways, are important for the viral cycle of SARS-CoV-2: the NLRP3 inflammasome signaling pathway and the pro-apoptotic mitochondrial signaling pathway."
SET Disease = "Severe acute respiratory syndrome coronavirus 2"
bp(REACTOME:"The NLRP3 inflammasome") -- bp(GOBP:"viral life cycle")
UNSET Disease

SET Support = "Numerous genes on our list are directly implicated in the host cell immune response. Including, for instance, a large group of cytokines and their receptors (e.g., IL-3, IL-15, CXCL11, TNF, TNFRSF1A, CXCR3)."
SET Disease = {"Severe acute respiratory syndrome-related coronavirus", "Severe acute respiratory syndrome coronavirus 2"}
p(HGNC:"IL3") -- bp(GOBP:"immune response")
p(HGNC:"IL15") -- bp(GOBP:"immune response")
p(HGNC:"CXCL11") -- bp(GOBP:"immune response")
p(HGNC:"TNF") -- bp(GOBP:"immune response")
p(HGNC:"TNFRSF1A") -- bp(GOBP:"immune response")
p(HGNC:"CXCR3") -- bp(GOBP:"immune response")

SET Support = "Expectedly, we also found the ACE2 gene, which encodes a receptor, both used by the SARS-CoV and SARS-CoV-2 viruses to enter the host cell."
p(HGNC:"ACE2") -- bp(GOBP:"viral entry into host cell")
UNSET Disease

SET Support = "Among the statistically enriched pathways (p < 0.05), our pathway enrichment analysis identified numerous signaling pathways involved in the immune response, in particular, the following pathways: “pattern recognition receptors signaling”, “interferon induction”, “inflammasome pathway”, which are directly implicated in the antiviral innate immune response."
bp(GOBP:"pattern recognition receptor signaling pathway") -- bp(GOBP:"innate immune response")
p(GFAM:"Interferons") -- bp(GOBP:"innate immune response")
bp(REACTOME:"The NLRP3 inflammasome") -- bp(GOBP:"innate immune response")

SET Support = "Also, among those statistically enriched pathways, we found the “endoplasmic reticulum stress pathway”, the “unfolded protein response signaling,” and the “phagosome maturation pathway”, thereby supporting the aforementioned link between the UPR pathway and coronaviruses infections."
bp(GOBP:"cellular response to unfolded protein") -- bp(GOBP:"innate immune response")
bp(GOBP:"phagosome maturation") -- bp(GOBP:"innate immune response")

SET Support = "Then, our PPI analysis confirmed the putative role of “pattern recognition receptors signaling” and “inflammasome pathway” in coronavirus infections but also allowed us to connect these two immune pathways and UPR/autophagy signaling into a single molecular framework of the host cell viral infection."
bp(GOBP:"pattern recognition receptor signaling pathway") -- path(MESHD:"Coronavirus Infections")
bp(REACTOME:"The NLRP3 inflammasome") -- path(MESHD:"Coronavirus Infections")

SET Support = "For instance, the NLRP3 inflammasome could be activated by the RIG-I-like and TLR4 receptors-mediated signaling but is also modulated by the autophagy flux."
bp(GOBP:"RIG-I signaling pathway") -> act(complex(GOCC:"NLRP3 inflammasome complex"))
bp(GOBP:"toll-like receptor 4 signaling pathway") -> act(complex(GOCC:"NLRP3 inflammasome complex"))
bp(GOBP:"autophagy") reg act(complex(GOCC:"NLRP3 inflammasome complex"))

SET Support = "In turn, the autophagy pathway can be activated either by the canonical ATF4 and DDIT3(CHOP) transcription factors cascade or by the RIG-I-like receptors establishing functional feedback-loops in this signaling network."
complex(GOCC:"CHOP-ATF4 complex") -> bp(GOBP:"autophagy")

SET Support = "Remarkably, recent publications linked the activation of NLRP3 inflammasome to cytokine storms, which were reported to be involved in severe forms of COVID-19."
act(complex(GOCC:"NLRP3 inflammasome complex")) -- path(NCIT:"Cytokine Release Syndrome")
path(NCIT:"Cytokine Release Syndrome") -- path(DO:"COVID-19")

SET Support = "The ATF4 and DDIT3(a.k.a. CHOP) transcription factors are also involved in the regulation of intrinsic (mitochondria-mediated) apoptosis pathways through the downregulation of the BCL2 protein (which can also modulate the autophagy flux), a constitutive component of the mitochondrial permeability transition pore complex (MPTP), a core regulator of apoptosis and target for several approved drugs."
complex(GOCC:"CHOP-ATF4 complex") reg bp(GOBP:"intrinsic apoptotic signaling pathway")
complex(GOCC:"CHOP-ATF4 complex") -| p(HGNC:"BCL2")
complex(GOCC:"mitochondrial permeability transition pore complex") hasComponent p(HGNC:"BCL2")
p(HGNC:"BCL2") reg bp(MESHPP:"Apoptosis")

SET Support = "Indeed, based on our findings and the proposed framework, it is reasonable to hypothesize that some inhibitors of autophagy (e.g., chloroquine, currently undergoing clinical trial, cf. Table 1) would prevent the virus from entering the host cell and could thereby be used to prevent SARS-CoV-2 infections while activators of autophagy (e.g., interferon-alpha 2a/2b, also undergoing clinical trial), which would help the host cell clear the viral particles, could be used to treat severe forms of COVID-19."
SET Disease = "Severe acute respiratory syndrome coronavirus 2"
a(CHEBI:"autophagy inhibitor") -| bp(GOBP:"viral entry into host cell")
a(PUBCHEM:2719) isA a(CHEBI:"autophagy inhibitor")
UNSET Disease
# PUBCHEM:2719 corresponds to chloroquine

SET Support = "For instance, statins, anti-diabetics, and antagonists of the angiotensin receptor 1, which are used to treat hyperlipidemia, type 2 diabetes, and hypertension, respectively, all of which are very common diseases. "
a(CHEBI:"statin") -| path(DO:"familial hyperlipidemia")
a(CHEBI:"statin") -| path(DO:"COVID-19")
a(MESHC:"Hypoglycemic Agents") -| path(DO:"type 2 diabetes mellitus")
a(MESHC:"Hypoglycemic Agents") -| path(DO:"COVID-19")
a(CHEBI:"angiotensin receptor antagonist") -| path(DO:"hypertension")
a(CHEBI:"angiotensin receptor antagonist") -| path(DO:"COVID-19")

SET Support = "In addition, type 2 diabetes and hypertension are known to be linked to an aggravated COVID-19 prognosis."
path(DO:"type 2 diabetes mellitus") -- path(DO:"COVID-19")
path(DO:"hypertension") -- path(DO:"COVID-19")

SET Support = "Interferon alfa-2a / 2b : UPR/autophagy modulator"
p(CHEBI:"Interferon alfa-2a") -| path(DO:"COVID-19")
p(CHEBI:"Interferon alfa-2a") reg bp(GOBP:"cellular response to unfolded protein")
p(CHEBI:"Interferon alfa-2a") -> bp(GOBP:"regulation of autophagy")
p(PUBCHEM:71306834) -| path(DO:"COVID-19")
p(PUBCHEM:71306834) reg bp(GOBP:"cellular response to unfolded protein")
p(PUBCHEM:71306834) -> bp(GOBP:"regulation of autophagy")
# PUBCHEM:71306834 corresponds to Interferon alfa-2B

SET Support = "Chloroquine : UPR/autophagy modulator"
a(PUBCHEM:2719) -| path(DO:"COVID-19")
a(PUBCHEM:2719) reg bp(GOBP:"cellular response to unfolded protein")
a(PUBCHEM:2719) -> bp(GOBP:"regulation of autophagy")
# PUBCHEM:2719 corresponds to Chloroquine

