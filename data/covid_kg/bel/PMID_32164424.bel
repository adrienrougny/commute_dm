SET Support = "Recent press release from the State Council of China indicated that preliminary datashowed that chloroquine was effective in preventing the deterioration of COVID-19 related pneumonia (0 case out of 130 trial cases, including 5 severe cases)."
a(PUBCHEM:2719) -| path(DO:"pneumonia")
# PUBCHEM:2719 corresponds to chloroquine