composite(p(UNIPROT:P0DTC5,loc(GOCC:"endomembrane system")),a(GO:"vacuolar proton-transporting V-type ATPase complex",loc(GOCC:"endomembrane system"))) reg bp(MESHPP:"Virus Replication")
composite(p(UNIPROT:P0DTC7,loc(GOCC:"endomembrane system")),p(MESH:"rab GTP-Binding Proteins",loc(GOCC:"endomembrane system"))) reg bp(MESHPP:"Virus Replication")
