composite(p(FIXME:nsp13),p(HGNC:TBKBP1)) reg bp(GOBP:"type I interferon signaling pathway")
p(HGNC:TBK1) ->  composite(p(HGNC:TBK1),p(HGNC:TBKBP1))
composite(p(HGNC:TBK1),p(HGNC:TBKBP1)) -> complex(p(HGNC:TBK1),p(HGNC:TBKBP1),complex(GO:"IkappaB kinase complex"))
complex(p(HGNC:TBK1),p(HGNC:TBKBP1),complex(GO:"IkappaB kinase complex")) -> act(p(HGNC:IRF1))
act(p(HGNC:IRF1)) -> bp(MESHPP:"Transcription, Genetic")

