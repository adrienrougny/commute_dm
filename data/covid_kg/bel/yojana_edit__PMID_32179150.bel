##############
# Statements #
##############
SET Citation = {"PubMed", "32179150"}

SET Support = "Chloroquine/hydroxychloroquine, a front-line drug used in the \
treatment and prophylaxis of malaria also used in autoimmune disease \
had been shown to inhibit the replication of several DNA and RNA \
viruses, including most of human coronaviruses [3]."

a(CHEBI:chloroquine) neg path(DO:malaria)
a(CHEBI:hydroxychloroquine) neg path(DO:malaria)
a(CHEBI:chloroquine) neg path(EFO:"autoimmune disease")
a(CHEBI:hydroxychloroquine) neg path(EFO:"autoimmune disease")
a(CHEBI:chloroquine) -| bp(GOBP:"viral genome replication")
a(CHEBI:hydroxychloroquine) -| bp(GOBP:"viral genome replication")

SET Support = "Recently, chloroquine was found to inhibit SARS-CoV-2 in vitro and its \
hydroxylated form has been proposed as a possible therapy to treat \
patients infected with SARS-CoV-2 [4,5]."

a(CHEBI:chloroquine) -| path(DO:"COVID-19")

SET Support = "Teicoplanin, a glycopeptide antibiotic routinely used to treat \
bacterial infection was found to be active in vitro against SARS-CoV, \
has joined the list of molecules that could be used as herapeutic \
arsenal against COVID-19 [7]"

a(CHEBI:teicoplanin) isA a(MESHC:"Anti-Bacterial Agents")
a(CHEBI:teicoplanin) -| path(DO:"COVID-19")

SET Support = "According to Zhou and colleagues, in coronaviruses, teicoplanin acts \
on the early step of the viral life cycle by inhibiting the low pH \
cleavage of the viral spike protein by cathepsin L in the late \
endosomes thereby preventing the release of genomic viral RNA and the \
continuation of virus replication cycle."

SET MeSHAnatomy = "Endosomes"
a(CHEBI:teicoplanin) -| bp(GOBP:"viral life cycle")
bp(GOBP:"response to acidic pH") -> act(p(HGNC:CTSL))
act(p(HGNC:CTSL)) -> p(MESH:"Spike Glycoprotein, Coronavirus",frag("?"))
p(MESH:"Spike Glycoprotein, Coronavirus",frag("?")) -> complex(GO:"viral replication complex",loc(GOCC:intracellular))
complex(GO:"viral replication complex",loc(GOCC:intracellular)) -> bp(GOBP:"viral life cycle")
UNSET MeSHAnatomy
