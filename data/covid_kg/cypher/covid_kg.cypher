UNWIND [{start: {_id:546}, end: {_id:547}, properties:{evidence:"Mycophenolic Acid It targets Nucleosides and/or nucleotides to inhibit synthesis of guanine monophosphate. Effective against wide range of viruses, however combinatorial therapy with interferon beta-1b may be useful for SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:549}, end: {_id:547}, properties:{evidence:"Mycophenolic Acid It targets Nucleosides and/or nucleotides to inhibit synthesis of guanine monophosphate. Effective against wide range of viruses, however combinatorial therapy with interferon beta-1b may be useful for SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:1109}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"As reflected from the docking scores, the eight compounds, including the physiological GTP and UTP and the four drugs IDX-184, Sofosbuvir, Ribavirin, and Remidisvir can bind to both COVID-19 and SARS HCoV RdRps with good binding energy (−6.5 up to −9.0 kcal/mol).", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1111}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"As reflected from the docking scores, the eight compounds, including the physiological GTP and UTP and the four drugs IDX-184, Sofosbuvir, Ribavirin, and Remidisvir can bind to both COVID-19 and SARS HCoV RdRps with good binding energy (−6.5 up to −9.0 kcal/mol).", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1112}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"As reflected from the docking scores, the eight compounds, including the physiological GTP and UTP and the four drugs IDX-184, Sofosbuvir, Ribavirin, and Remidisvir can bind to both COVID-19 and SARS HCoV RdRps with good binding energy (−6.5 up to −9.0 kcal/mol).", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1113}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"As reflected from the docking scores, the eight compounds, including the physiological GTP and UTP and the four drugs IDX-184, Sofosbuvir, Ribavirin, and Remidisvir can bind to both COVID-19 and SARS HCoV RdRps with good binding energy (−6.5 up to −9.0 kcal/mol).", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1114}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"As reflected from the docking scores, the eight compounds, including the physiological GTP and UTP and the four drugs IDX-184, Sofosbuvir, Ribavirin, and Remidisvir can bind to both COVID-19 and SARS HCoV RdRps with good binding energy (−6.5 up to −9.0 kcal/mol).", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1117}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"Only one salt bridge (yellow spheres connected by a dashed line) is formed in the case of IDX-184 with D514, which is responsible for the increased stabilization of the formed complex, reflected on the docking score.", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1121}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"On the other hand, IDX-184 and Sofosbuvir both form metal interaction through the Mg+2 with D652 (two interactions) and E702, respectively.", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1122}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"On the other hand, IDX-184 and Sofosbuvir both form metal interaction through the Mg+2 with D652 (two interactions) and E702, respectively.", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1125}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"On the other hand, IDX-184 and Sofosbuvir both form metal interaction through the Mg+2 with D652 (two interactions) and E702, respectively.", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1126}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"On the other hand, IDX-184 and Sofosbuvir both form metal interaction through the Mg+2 with D652 (two interactions) and E702, respectively.", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1129}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"Additionally, Sofosbuvir formed two hydrophobic interactions with Y510 and D651 of the COVID-19 RdRp.", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1132}, end: {_id:1104}, properties:{annotationExperiment:["Molecular docking"], evidence:"Additionally, Sofosbuvir formed two hydrophobic interactions with Y510 and D651 of the COVID-19 RdRp.", citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}] AS row
