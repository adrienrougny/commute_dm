UNWIND [{start: {_id:79}, end: {_id:80}, properties:{evidence:"The folding, maturation, and assembly of the gigantic S trimeric glycoprotein rely heavily on the protein chaperons inside the ER, such as calnexin. In fact, the N-terminal part of the S2 domain of SARS-CoV S protein has been found to interact with calnexin, and knock-down of calnexin decreases the infectivity of pseudotyped lentivirus carrying the SARS-CoV S protein (Fukushi et al., 2012).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:REGULATES]->(end) SET r += row.properties;
UNWIND [{start: {_id:263}, end: {_id:255}, properties:{evidence:"Of note,ferrocene (or aminoferrocene) alone or in combination with CQ (equimolar concentrations) did not induce PC3M prostate cancer cell death.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:264}, end: {_id:255}, properties:{evidence:"Of note,ferrocene (or aminoferrocene) alone or in combination with CQ (equimolar concentrations) did not induce PC3M prostate cancer cell death.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:263}, end: {_id:257}, properties:{evidence:"We also tested the effect of ferrocene and ferrocene + CQ on the viability of PNT1A, C42, LNCaP and PC3 cells, and in all the cases treatments were without significant effect on cell viability.", pmid:"29162859", annotationCellline:["LNCAP cell", "PNT1A cell"], citationType:"PubMed", citationRef:"29162859"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:83}, end: {_id:81}, properties:{evidence:"Also, treatment of α-glucosidase inhibitors, which inhibit the interactions of calnexin with its substrates, dose dependently inhibits the incorporationof S into pseudovirus and suppresses SARS-CoV replication in cell cultures (Fukushi et al., 2012).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:1283}, end: {_id:1285}, properties:{evidence:"SGs are induced by protein kinase R (PKR)-mediated phosphorylation of eIF2α upon viral dsRNA recognition [57]. Promoting G3BP aggregation via the eIF4A inhibitor Zotatafin [58,59] or reducing SG disassembly by Silmitasertib inhibition of CK2 [60] warrant investigation for treatment of SARS-CoV-2. The mTOR inhibitor rapamycin disrupts the binding of LARP1 to mTORC1 [61] and has been shown to reduce MERS infection by ∼60% in vitro [62], another drug that could be tested for repurposing.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1516}, end: {_id:1519}, properties:{evidence:"The result showed that there was an interaction between CD147 and SP (RBD), which was consistent with the SPR assay (Figure 2B). In addition, the interaction of CD147-SP (RBD) was also confirmed by ELISA assay (Figure 2C). In the meanwhile, competitive inhibition assay showed that Meplazumab could competitively inhibit the binding of SP and CD147, with an IC50 of 16.44 μg/mL (Figure 2D). These results confirm the interaction of CD147 and SP, indicating a novel potential route for SARS-CoV-2 to invade host cells.", annotationCells:["Vero E6"], citationType:"biorvix", citationRef:"https://doi.org/10.1101/2020.03.14.988345"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
