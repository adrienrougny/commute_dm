nd that both GRP94 and GRP78 were induced in SARS-CoV-infected FRhK4 cells.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:386}, end: {_id:411}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:386}, end: {_id:412}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:386}, end: {_id:413}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:386}, end: {_id:414}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:386}, end: {_id:415}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:386}, end: {_id:426}, properties:{evidence:"The most common symptoms at onset of COVID-19 illness are fever, cough, and fatigue, while other symptoms include sputum production, headache, haemoptysis, diarrhoea, dyspnoea, and lymphopenia [5,6,8,13].", pmid:"32113704", citationType:"PubMed", citationRef:"32113704"}}, {start: {_id:386}, end: {_id:427}, properties:{evidence:"The most common