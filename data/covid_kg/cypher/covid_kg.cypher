UNWIND [{start: {_id:16}, end: {_id:18}, properties:{evidence:"After uncoating, the genomic RNA first acts as an mRNA for translation of the replicase polyprotein.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:55}, end: {_id:56}, properties:{evidence:"Consistently,the mRNA level of homocysteine-inducible, ER stress-inducible, ubiquitin-like domain member 1 (HERPUD1), an ER stress marker, was up-regulated in L cells infected with mouse hepatitis virus (MHV) or SARS-CoV (Versteeg et al., 2007).", pmid:"24987391", annotationCellline:["L Cells cell"], citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:53}, end: {_id:56}, properties:{evidence:"Consistently,the mRNA level of homocysteine-inducible, ER stress-inducible, ubiquitin-like domain member 1 (HERPUD1), an ER stress marker, was up-regulated in L cells infected with mouse hepatitis virus (MHV) or SARS-CoV (Versteeg et al., 2007).", pmid:"24987391", annotationCellline:["L Cells cell"], citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:50}, end: {_id:150}, properties:{evidence:"Previous studies have shown that the mRNA and protein levels of DUSP1 are modulated by ER stress (Boutros et al., 2008;Li et al., 2011). ER stress-induced DUSP1 up-regulation is likely to be mediated by ATF3 in the PERK pathway, since knock-down of ATF3 significantly reduced DUSP1 induction in cells under ER stress (Gora et al., 2010).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:147}, end: {_id:162}, properties:{evidence:"In IBV-infected Vero cells, significant splicing of XBP1 mRNA was detected starting from 12 to 16 h post-infection till the late stage of infection. The mRNA levels of XBP1 effector genes (EDEM1, ERdj4, and p58IPK) were up-regulated in IBV-infected Vero cells", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:386}, end: {_id:56}, properties:{evidence:"Consistently,the mRNA level of homocysteine-inducible