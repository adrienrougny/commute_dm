UNWIND [{start: {_id:333}, end: {_id:553}, properties:{evidence:"Ribavirin It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. Effective against wide range of viruses including MERS-CoV and SARS-CoV but high doses are required which may have severe side effects. It may be reevaluated for SARS-CoV-2and recommended if low doses are found effective.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:555}, end: {_id:553}, properties:{evidence:"Bcx4430 It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. It isbroad-spectrum and effective against SARS-CoV and MERS-CoV, thus may be effective against SARS-CoV-2 however, evaluation using animals’ models is required.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DIRECTLY_DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:224}, end: {_id:227}, properties:{evidence:"Together, we demonstrate antiviral efficacy in HAE against both SARS-CoV and MERS-CoV at concentrations that are at least 100-fold lower than those with observable cytotoxicity.", annotationBioassay:["in vitro"], annotationCell:["respiratory epithelial cell"], pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:228}, properties:{evidence:"Together, we demonstrate antiviral efficacy in HAE against both SARS-CoV and MERS-CoV at concentrations that are at least 100-fold lower than those with observable cytotoxicity.", annotationBioassay:["in vitro"], annotationCell:["respiratory epithelial cell"], pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:237}, properties:{evidence:"As shown in Fig. 5A, prophylactic administration at 50 mg/kg QD or 25 mg/kg BID ameliorated SARS-CoV–induced weight loss seen with vehicle treatment.", annotationSpecies:["10090"], pmid:"28659436", annotationDisease:["Severe acute respiratory syndrome-related coronavirus"], citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:238}, properties:{evidence:"Treatment with GS-5734 also reduced SARS-CoV–induced lung pathology, including denuding bronchiolitis, perivascular accumulation of inflammatory infiltrates (that is, “cuffing”), and intra-alveolar edema associated with diffuse alveolar damage as compared to vehicle-treated animals.", annotationSpecies:["10090"], pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:239}, properties:{evidence:"Treatment with GS-5734 also reduced SARS-CoV–induced lung pathology, including denuding bronchiolitis, perivascular accumulation of inflammatory infiltrates (that is, “cuffing”), and intra-alveolar edema associated with diffuse alveolar damage as compared to vehicle-treated animals.", annotationSpecies:["10090"], pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:240}, properties:{evidence:"Treatment with GS-5734 also reduced SARS-CoV–induced lung pathology, including denuding bronchiolitis, perivascular accumulation of inflammatory infiltrates (that is, “cuffing”), and intra-alveolar edema associated with diffuse alveolar damage as compared to vehicle-treated animals.", annotationSpecies:["10090"], pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:227}, properties:{evidence:"Therapeutic GS-5734 substantially reduced the SARS-CoV–induced weight loss in infected animals and significantly suppressed virus lung titers (P = 0.0059), thus demonstrating that therapeutic administration of GS-5734 can reduce disease and suppress replication during an ongoing infection.", pmid:"28659436", annotationDisease:["Severe acute respiratory syndrome-related coronavirus"], citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:228}, properties:{evidence:"Nevertheless, our studies provide data that strongly support the testing of GS-5734 in nonhuman primates and suggest that therapeutic treatment of MERS-CoV–infected humans with GS-5734 will help diminish virus replication and disease if administered early enough during the course of infection.", pmid:"28659436", annotationDisease:["Middle East respiratory syndrome"], citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:249}, properties:{evidence:"Overall, our work provides evidence that GS-5734 may protect CoV-infected patients from progression to severe disease and could prophylactically protect health care workers in areas with existing endemic MERS-CoV and that its broad-spectrum activity may prove valuable when a novel CoV emerges in the future.", pmid:"28659436", annotationDisease:["Severe acute respiratory syndrome-related coronavirus", "Middle East respiratory syndrome", "Severe acute respiratory syndrome coronavirus 2"], citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:253}, end: {_id:292}, properties:{evidence:"Overall, these results suggest that FQ has antitumorigenic potential in vivo, however the final effect of FQ on tumor growth in vivo could apparently depend on tumor type and stage.", annotationBioassay:["in vivo"], pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:254}, end: {_id:293}, properties:{evidence:"Noteworthy, organometallic compounds (e.g. cisplatin, carboplatin, oxaliplatin) are well known for their anticancer activity and are now in clinical use.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:277}, end: {_id:293}, properties:{evidence:"Noteworthy, organometallic compounds (e.g. cisplatin, carboplatin, oxaliplatin) are well known for their anticancer activity and are now in clinical use.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:294}, end: {_id:293}, properties:{evidence:"Noteworthy, organometallic compounds (e.g. cisplatin, carboplatin, oxaliplatin) are well known for their anticancer activity and are now in clinical use.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:295}, end: {_id:293}, properties:{evidence:"Noteworthy, organometallic compounds (e.g. cisplatin, carboplatin, oxaliplatin) are well known for their anticancer activity and are now in clinical use.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:402}, end: {_id:386}, properties:{evidence:"In addition, various vaccine strategies, such as using inactivated viruses, live‐attenuated viruses, viral vector‐based vaccines, subunit vaccines, recombinant proteins, and DNA vaccines, have been developed but have only been evaluated in animals so far.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:403}, end: {_id:386}, properties:{evidence:"In addition, various vaccine strategies, such as using inactivated viruses, live‐attenuated viruses, viral vector‐based vaccines, subunit vaccines, recombinant proteins, and DNA vaccines, have been developed but have only been evaluated in animals so far.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:404}, end: {_id:386}, properties:{evidence:"In addition, various vaccine strategies, such as using inactivated viruses, live‐attenuated viruses, viral vector‐based vaccines, subunit vaccines, recombinant proteins, and DNA vaccines, have been developed but have only been evaluated in animals so far.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:405}, end: {_id:386}, properties:{evidence:"In addition, various vaccine strategies, such as using inactivated viruses, live‐attenuated viruses, viral vector‐based vaccines, subunit vaccines, recombinant proteins, and DNA vaccines, have been developed but have only been evaluated in animals so far.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:406}, end: {_id:386}, properties:{evidence:"In addition, various vaccine strategies, such as using inactivated viruses, live‐attenuated viruses, viral vector‐based vaccines, subunit vaccines, recombinant proteins, and DNA vaccines, have been developed but have only been evaluated in animals so far.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:417}, end: {_id:407}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
