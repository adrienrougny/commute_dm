UNWIND [{start: {_id:221}, end: {_id:304}, properties:{evidence:"In children, severe respiratory tract CoV infections require hospitalization in about 10% of cases and have been associated with febrile seizure in those less than 1 year old.", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:385}, end: {_id:386}, properties:{evidence:"Among the six death cases, four patients with published information are elder people of over 60 years old and have other illnesses before the infection, such as abdominal tumor and chronic liver disease, myocarditis and renal dysfunction, and cardiovascular disease.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:387}, end: {_id:386}, properties:{evidence:"Among the six death cases, four patients with published information are elder people of over 60 years old and have other illnesses before the infection, such as abdominal tumor and chronic liver disease, myocarditis and renal dysfunction, and cardiovascular disease.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:388}, end: {_id:386}, properties:{evidence:"Among the six death cases, four patients with published information are elder people of over 60 years old and have other illnesses before the infection, such as abdominal tumor and chronic liver disease, myocarditis and renal dysfunction, and cardiovascular disease.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:389}, end: {_id:386}, properties:{evidence:"Among the six death cases, four patients with published information are elder people of over 60 years old and have other illnesses before the infection, such as abdominal tumor and chronic liver disease, myocarditis and renal dysfunction, and cardiovascular disease.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:407}, end: {_id:408}, properties:{evidence:"Among adult patients, cardiovascular disease and hypertension were