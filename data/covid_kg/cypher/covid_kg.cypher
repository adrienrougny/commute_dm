UNWIND [{start: {_id:416}, end: {_id:137}, properties:{evidence:"In some cases, the multiple peripheral ground-glass opacities were observed in subpleural regions of both lungs [14] that likely induced both systemic and localized immune response that led to increased inflammation.", pmid:"32113704", annotationAnatomy:["pleural cavity"], citationType:"PubMed", citationRef:"32113704"}}, {start: {_id:424}, end: {_id:723}, properties:{evidence:"In the influenza virus model, it was reported that chloroquine improve the cross-presentation of non-replicating virus antigen by dendritic cells to CD8+ T-cells recruited to lymph nodes draining the site of infection, eliciting a broadly protective immune response [71].", annotationMeshdisease:["Influenza, Human"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:1236}, end: {_id:1237}, properties:{evidence:"We also identified an interaction of Nsp5 (C145A) with tRNA methyltransferase 1 (TRMT1), which is responsible for synthesis of the dimethylguanosine (m2,2G) base modification on both nuclear and mitochondrial tRNAs [40]. We predict TRMT1 is also cleaved by Nsp5, removing its zinc finger and nuclear localization signal and likely resulting in an exclusively mitochondrial localization (Extended Data Fig. 7).", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1236}, end: {_id:1238}, properties:{evidence:"We also identified an interaction of Nsp5 (C145A) with tRNA methyltransferase 1 (TRMT1), which is responsible for synthesis of the dimethylguanosine (m2,2G) base modification on both nuclear and mitochondrial tRNAs [40]. We predict TRMT1 is also cleaved by Nsp5, removing its zinc finger and nuclear localization signal and likely resulting in an exclusively mitochondrial localization (Extended Data Fig. 7).", annotationMeshanatomy:["Cell Nucleus"], citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:386}, end: {_id:1533}, properties:{evidence:"We observed that the proportion of the CD1C+_B dendritic cells (clusters 7, 13, and 30), CD8 cytotoxic T cells (cluster 9), and plasmacytoid dendritic cells (cluster 36) increased in patients with COVID-19, while the B cells (cluster 16) and CD4+ T helper cells (cluster 51）decreased in the COVID-19 patients compared to the normal controls, indicating that the number of specific clusters of immune cells adjusts to fight SARS-CoV-2 aggression.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1534}, properties:{evidence:"We observed that the proportion of the CD1C+_B dendritic cells (clusters 7, 13, and 30), CD8 cytotoxic T cells (cluster 9), and plasmacytoid dendritic cells (cluster 36) increased in patients with COVID-19, while the B cells (cluster 16) and CD4+ T helper cells (cluster 51）decreased in the COVID-19 patients compared to the normal controls, indicating that the number of specific clusters of immune cells adjusts to fight SARS-CoV-2 aggression.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1535}, properties:{evidence:"For the critical condition (patient 1), the proportion of 40 out of the 56 cell subtypes decreased; some subtypes, including CD8+ T cell (cluster 52), CD4+ T cell (cluster 55,56) and plasmacytoid dendritic cell (cluster 53), disappeared.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1536}, properties:{evidence:"For the critical condition (patient 1), the proportion of 40 out of the 56 cell subtypes decreased; some subtypes, including CD8+ T cell (cluster 52), CD4+ T cell (cluster 55,56) and plasmacytoid dendritic cell (cluster 53), disappeared.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1532}, properties:{evidence:"For the critical condition (patient 1), the proportion of 40 out of the 56 cell subtypes decreased; some subtypes, including CD8+ T cell (cluster 52), CD4+ T cell (cluster 55,56) and plasmacytoid dendritic cell (cluster 53), disappeared.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1537}, properties:{evidence:"This is consistent with the lower number of lymphocytes in the patient (0.75 × 109/L) compared to the normal range (1.1-3.2 × 109/L, Table S1).", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
