UNWIND [{start: {_id:70}, end: {_id:71}, properties:{evidence:"The glycosylation of M protein is proposed to play a certain function in alpha interferon (IFN) induction and in vivo tissue tropism (Charley and Laude, 1988;Laude et al.,1992;de Haan et al., 2003).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:70}, end: {_id:72}, properties:{evidence:"The glycosylation of M protein is proposed to play a certain function in alpha interferon (IFN) induction and in vivo tissue tropism (Charley and Laude, 1988;Laude et al.,1992;de Haan et al., 2003).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:134}, end: {_id:135}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro-inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:646}, end: {_id:647}, properties:{evidence:"Usually, Toll-like receptor (TLR) 3, TLR7, TLR8, and TLR9 sense viral RNA and DNA in the endosome [60, 61]. The viral RNA receptor retinoic-acid inducible gene I (RIG-I) [62], cytosolic receptor melanoma differentiation-associated gene 5 (MDA5) and nucleotidyl transferase cyclic GMP-AMP synthase (cGAS) [63] are responsible for the recognition of viral RNA and DNA in the cytoplasm.", annotationMeshanatomy:["Endosomes"], pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:648}, end: {_id:647}, properties:{evidence:"Usually, Toll-like receptor (TLR) 3, TLR7, TLR8, and TLR9 sense viral RNA and DNA in the endosome [60, 61]. The viral RNA receptor retinoic-acid inducible gene I (RIG-I) [62], cytosolic receptor melanoma differentiation-associated gene 5 (MDA5) and nucleotidyl transferase cyclic GMP-AMP synthase (cGAS) [63] are responsible for the recognition of viral RNA and DNA in the cytoplasm.", annotationMeshanatomy:["Endosomes"], pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:649}, end: {_id:647}, properties:{evidence:"Usually, Toll-like receptor (TLR) 3, TLR7, TLR8, and TLR9 sense viral RNA and DNA in the endosome [60, 61]. The viral RNA receptor retinoic-acid inducible gene I (RIG-I) [62], cytosolic receptor melanoma differentiation-associated gene 5 (MDA5) and nucleotidyl transferase cyclic GMP-AMP synthase (cGAS) [63] are responsible for the recognition of viral RNA and DNA in the cytoplasm.", annotationMeshanatomy:["Endosomes"], pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:650}, end: {_id:647}, properties:{evidence:"Usually, Toll-like receptor (TLR) 3, TLR7, TLR8, and TLR9 sense viral RNA and DNA in the endosome [60, 61]. The viral RNA receptor retinoic-acid inducible gene I (RIG-I) [62], cytosolic receptor melanoma differentiation-associated gene 5 (MDA5) and nucleotidyl transferase cyclic GMP-AMP synthase (cGAS) [63] are responsible for the recognition of viral RNA and DNA in the cytoplasm.", annotationMeshanatomy:["Endosomes"], pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:651}, end: {_id:647}, properties:{evidence:"Usually, Toll-like receptor (TLR) 3, TLR7, TLR8, and TLR9 sense viral RNA and DNA in the endosome [60, 61]. The viral RNA receptor retinoic-acid inducible gene I (RIG-I) [62], cytosolic receptor melanoma differentiation-associated gene 5 (MDA5) and nucleotidyl transferase cyclic GMP-AMP synthase (cGAS) [63] are responsible for the recognition of viral RNA and DNA in the cytoplasm.", annotationMeshanatomy:["Cytoplasm"], pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:127}, end: {_id:647}, properties:{evidence:"Usually, Toll-like receptor (TLR) 3, TLR7, TLR8, and TLR9 sense viral RNA and DNA in the endosome [60, 61]. The viral RNA receptor retinoic-acid inducible gene I (RIG-I) [62], cytosolic receptor melanoma differentiation-associated gene 5 (MDA5) and nucleotidyl transferase cyclic GMP-AMP synthase (cGAS) [63] are responsible for the recognition of viral RNA and DNA in the cytoplasm.", annotationMeshanatomy:["Cytoplasm"], pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:652}, end: {_id:647}, properties:{evidence:"Usually, Toll-like receptor (TLR) 3, TLR7, TLR8, and TLR9 sense viral RNA and DNA in the endosome [60, 61]. The viral RNA receptor retinoic-acid inducible gene I (RIG-I) [62], cytosolic receptor melanoma differentiation-associated gene 5 (MDA5) and nucleotidyl transferase cyclic GMP-AMP synthase (cGAS) [63] are responsible for the recognition of viral RNA and DNA in the cytoplasm.", annotationMeshanatomy:["Cytoplasm"], pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:667}, end: {_id:641}, properties:{evidence:"The other antiviral drugs include nitazoxanide, favipiravir, nafamostat, and so on (See Table 1 for details).", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:1263}, end: {_id:368}, properties:{evidence:"N targets stress granule protein G3BP1, an essential antiviral protein which is known to induce innate immune response through multiple mechanisms [52–54].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:944}, end: {_id:1464}, properties:{evidence:"On the other hand, treatment failure was seen in case of later injection of IFN-β, because the virus titer went up, and monocytes, macrophages, and neutrophils were accumulated and activated in the lungs, and proinflammatory cytokines were induced, which finally led to severe lethal pneumonia.", annotationMeshanatomy:["Lung"], annotationCell:["naive T cell"], annotationDisease:["Severe acute respiratory syndrome-related coronavirus"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:944}, end: {_id:1450}, properties:{evidence:"On the other hand, treatment failure was seen in case of later injection of IFN-β, because the virus titer went up, and monocytes, macrophages, and neutrophils were accumulated and activated in the lungs, and proinflammatory cytokines were induced, which finally led to severe lethal pneumonia.", annotationMeshanatomy:["Lung"], annotationCell:["naive T cell"], annotationDisease:["Severe acute respiratory syndrome-related coronavirus"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:944}, end: {_id:1465}, properties:{evidence:"On the other hand, treatment failure was seen in case of later injection of IFN-β, because the virus titer went up, and monocytes, macrophages, and neutrophils were accumulated and activated in the lungs, and proinflammatory cytokines were induced, which finally led to severe lethal pneumonia.", annotationMeshanatomy:["Lung"], annotationCell:["naive T cell"], annotationDisease:["Severe acute respiratory syndrome-related coronavirus"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:789}, end: {_id:231}, properties:{evidence:"Accordingly, we infected the cells with SARS-CoV-, or 2019-nCoV-S-pseudotyped HIV-1 viruses after siRNA-mediated knockdown of the expression of cathepsin L and TMPRSS2 and found that both cathepsin L and TMPRSS2 depletion impaired the cell entry of pseudoviruses (Figure 1C), indicating that both cathepsin L and TMPRSS2 are required for 2019-nCoV cell entry.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:480}, end: {_id:231}, properties:{evidence:"Accordingly, we infected the cells with SARS-CoV-, or 2019-nCoV-S-pseudotyped HIV-1 viruses after siRNA-mediated knockdown of the expression of cathepsin L and TMPRSS2 and found that both cathepsin L and TMPRSS2 depletion impaired the cell entry of pseudoviruses (Figure 1C), indicating that both cathepsin L and TMPRSS2 are required for 2019-nCoV cell entry.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:134}, end: {_id:135}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro- inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:154}, end: {_id:2671}, properties:{evidence:"Besides p38, DUSP1 has also been shown to dephosphorylate c-Jun N-terminal kinase (JNK) and ERK (Sun et al.,1993;Franklin and Kraft, 1997). It has been long proposed that ERK phosphorylation promotes cell survival, whereas prolonged JNK and p38 phosphorylation is linked to the induction of apoptosis (Xia et al., 1995).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:646}, end: {_id:647}, properties:{evidence:"Usually, Toll-like receptor (TLR) 3, TLR7, TLR8, and TLR9 sense viral RNA and DNA in the endosome [60, 61]. The viral RNA receptor retinoic- acid inducible gene I (RIG-I) [62], cytosolic receptor melanoma differentiation-associated gene 5 (MDA5) and nucleotidyl transferase cyclic GMP-AMP synthase (cGAS) [63] are responsible for the recognition of viral RNA and DNA in the cytoplasm.", annotationMeshanatomy:["Endosomes"], pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}] AS row
