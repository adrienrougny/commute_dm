UNWIND [{start: {_id:1448}, end: {_id:922}, properties:{evidence:"IL-12 activation would lead to the induction of interferons (IFNs).", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:1472}, end: {_id:922}, properties:{evidence:"In addition to TLR-3 agonists (poly ICLC, poly (I:C), and rintatolimod) and phytohaemagglutinin (PHA) can induce IFN production in the human body as well.", annotationCell:["naive T cell"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:2654}, end: {_id:21}, properties:{evidence:"The replicase gene consists of two open reading frames (ORF1a and ORF1b). Translation of ORF1a produces the polyprotein 1a (pp1a). Meanwhile, a ribosomal frameshifting occurs at the junction of ORF1a and ORF1b,allowing translation to continue onto ORF1b, producing a larger polyprotein 1ab (pp1ab;Brierley et al., 1987).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:105}, end: {_id:109}, properties:{evidence:"One of ATF4’s target genes is the growth arrest and DNA damage- inducible protein 153 (GADD153, also knownas C/EBP homologous protein, or CHOP). GADD153 induces the growth arrest and DNA damage-inducible protein 34 (GADD34), which recruits protein phosphatase 1 (PP1) to dephosphorylate eIF2α and release the translation block.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:109}, end: {_id:110}, properties:{evidence:"One of ATF4’s target genes is the growth arrest and DNA damage- inducible protein 153 (GADD153, also knownas C/EBP homologous protein, or CHOP). GADD153 induces the growth arrest and DNA damage-inducible protein 34 (GADD34), which recruits protein phosphatase 1 (PP1) to dephosphorylate eIF2α and release the translation block.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:2664}, properties:{evidence:"One of ATF4’s target genes is the growth arrest and DNA damage- inducible protein 153 (GADD153, also knownas C/EBP homologous protein, or CHOP). GADD153 induces the growth arrest and DNA damage-inducible protein 34 (GADD34), which recruits protein phosphatase 1 (PP1) to dephosphorylate eIF2α and release the translation block.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:136}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro- inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:2672}, end: {_id:63}, properties:{evidence:"Moreover, UPR downstream genes known to be activated by XBP1s, such as ER DNA J domain-containing protein 4 (ERdj4), EDEM1, and protein kinase inhibitor of 58kDa (p58IPK), are not significantly induced after infection (Bechillet al., 2008).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:2672}, end: {_id:175}, properties:{evidence:"Moreover, UPR downstream genes known to be activated by XBP1s, such as ER DNA J domain-containing protein 4 (ERdj4), EDEM1, and protein kinase inhibitor of 58kDa (p58IPK), are not significantly induced after infection (Bechillet al., 2008).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:157}, end: {_id:177}, properties:{evidence:"Interestingly, an earlier onset and more significant apoptosis induction in IRE1-knockdown IBV-infected cells was observed, which is associated with hyperphosphorylation of pro-apoptotic kinase JNK and hypophosphorylation of pro-survival kinase RAC-alpha serine/threonine- protein kinase (Akt).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:212}, end: {_id:199}, properties:{evidence:"On the other hand, the accessory protein 8ab of SARS-CoV has been identified to induce ATF6 activation (Sung et al.,2009). ATF6 cleavage and nuclear translocation was observed in cells transfected with SARS- CoV 8ab (Sung et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:212}, end: {_id:214}, properties:{evidence:"On the other hand, the accessory protein 8ab of SARS-CoV has been identified to induce ATF6 activation (Sung et al.,2009). ATF6 cleavage and nuclear translocation was observed in cells transfected with SARS- CoV 8ab (Sung et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:646}, end: {_id:653}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain- containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:646}, end: {_id:654}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain- containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:646}, end: