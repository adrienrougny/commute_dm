erties:{evidence:"Among adult patients, cardiovascular disease and hypertension were the most common underlying diseases, followed by diabetes mellitus.", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:386}, end: {_id:410}, properties:{evidence:"Among adult patients, cardiovascular disease and hypertension were the most common underlying diseases, followed by diabetes mellitus.", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}] AS row
