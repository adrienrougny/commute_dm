UNWIND [{start: {_id:171}, end: {_id:113}, properties:{evidence:"Apart from the XBP1 pathway, activated IRE1 has been shown to recruit TNF receptor-associated factor 2 (TRAF2) and induce apoptosis by activating the JNK (Urano et al., 2000). This IRE1-JNK pathway is independent of IRE1’s RNase activity, but it requires IRE1’s kinase domain and involves TRAF2-dependent activation of caspase-12 (Yonedaet al.,2001).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:204}, end: {_id:113}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress-induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:206}, end: {_id:118}, properties:{evidence:"For WNV,it has been shown that ATF6 activation promotes efficient WNV replication by suppressing signal transducer and activator of transcription 1 (STAT1) phosphorylation and late-phase IFN signaling (Ambrose and Mackenzie, 2013).", annotationMeshdisease:["West Nile Fever"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:720}, end: {_id:647}, properties:{evidence:"Beside affecting the virus maturation process, pH modulation by chloroquine can impair the proper maturation of viral protein [32] and the recognition of viral antigen by dendritic cells, which occurs through a Toll-like receptor-dependent pathway that requires endosomal acidification [69].", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:1249}, end: {_id:552}, properties:{evidence:"Interestingly, we found that Nsp13 interacts with two key players of IFN signaling pathway including TANK-binding kinase 1 (TBK1) and TANK-binding kinase 1-binding protein 1 (TBKBP1/SINTBAD).SINTBAD acts as a critical adaptor protein between TBK1 and IKKi and therefore mediates induction of IRF-dependent transcription [41]. ", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1251}, end: {_id:128}, properties:{evidence:"RNF41/Nrdp1, an E3 ubiquitin ligase is targeted by Nsp15 protein which promotes activation of TBK1 and IRF3 and therefore increases type I interferon production [45].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:660}, end: {_id:128}, properties:{evidence:"RNF41/Nrdp1, an E3 ubiquitin ligase is targeted by Nsp15 protein which promotes activation of TBK1 and IRF3 and therefore increases type I interferon production [45].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1564}, end: {_id:641}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:166}, end: {_id:2675}, properties:{evidence:"On the other hand, the kinase but not the RNAse activity of IRE1 has been associated with ER-stress-induced NF-kB activation (Tam et al., 2012). Under ER stress, IRE1 has been shown to phosphorylate TRAF2, which activates the IκB kinase (IKK) and contributes to its basal activity (Figure 4). IKK inturn phosphorylates IκBα and promotes its proteasomal degradation, releasing NF-κB to activate downstream genes (Tam et al.,2012).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:204}, end: {_id:113}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress- induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:1249}, end: {_id:552}, properties:{evidence:"Interestingly, we found that Nsp13 interacts with two key players of IFN signaling pathway including TANK-binding kinase 1 (TBK1) and TANK- binding kinase 1-binding protein 1 (TBKBP1/SINTBAD).SINTBAD acts as a critical adaptor protein between TBK1 and IKKi and therefore mediates induction of IRF-dependent transcription [41].", citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:2766}, end: {_id:641}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:456}, end: {_id:457}, properties:{evidence:"Ribavirin  is  a  nucleoside  analogue  with  a  broad-spectrum  of  antiviral  effects.  A  study  compared  111  patients  with  severe  acute  respiratory  syndrome  (SARS)  treated  with  ribavirin  monotherapy  and  41  patients  with  SARS  treated  with  lopinavir/ritonavir and ribavirin; patients treated with the combined therapy  had  a  lower  risk  of  acute  respiratory  distress  syndrome  (ARDS)  and  death  (6).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:456}, end: {_id:457}, properties:{evidence:"Ribavirin is a nucleoside analogue with a broad-spectrum of antiviral effects. A study compared 111 patients with severe acute respiratory syndrome (SARS) treated with ribavirin monotherapy and 41 patients with SARS treated with lopinavir/ritonavir and ribavirin; patients treated with the combined therapy had a lower risk of acute respiratory distress syndrome (ARDS) and death (6).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:229}, end: {_id:230}, properties:{evidence:"CoV host specificity and entry into host cells are guided by the viral spike glycoprotein whose extensive genetic variation is a reflection of host species diversity and variation in virus receptor usage.", pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:229}, end: {_id:231}, properties:{evidence:"CoV host specificity and entry into host cells are guided by the viral spike glycoprotein whose extensive genetic variation is a reflection of host species diversity and variation in virus receptor usage.", pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:636}, end: {_id:72}, properties:{evidence:" S glycoprotein includes two sub-units, S1 and S2 [30]. S1 determines the virus-host range and cellular tropism with the key function domain−RBD, while S2 mediates virus-cell membrane fusion by two tandem domains, heptad repeats 1 (HR1) [31] and HR2[32].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:637}, end: {_id:641}, properties:{evidence:" S glycoprotein includes two sub-units, S1 and S2 [30]. S1 determines the virus-host range and cellular tropism with the key function domain−RBD, while S2 mediates virus-cell membrane fusion by two tandem domains, heptad repeats 1 (HR1) [31] and HR2[32].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:697}, end: {_id:698}, properties:{evidence:"Chloroquine can also impair another early stage of virus replication by interfering with the pH-dependent endosome-mediated viral entry of enveloped viruses such as Dengue virus or Chikungunya virus [60,61].", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:749}, end: {_id:225}, properties:{evidence:"The ~306 aa long main protease (Mpro), a key enzyme for coronavirus replication, is also encoded by the polypeptide and responsible for processing the polypeptide into functional proteins (Lai and Holmes, 2001).", annotationMeshdisease:["Coronavirus Infections"], pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:112}, end: {_id:908}, properties:{evidence:"The ATF4 and DDIT3(a.k.a. CHOP) transcription factors are also involved in the regulation of intrinsic (mitochondria-mediated) apoptosis pathways through the downregulation of the BCL2 protein (which can also modulate the autophagy flux), a constitutive component of the mitochondrial permeability transition pore complex (MPTP), a core regulator of apoptosis and target for several approved drugs.", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:936}, end: {_id:904}, properties:{evidence:"Interferon alfa-2a / 2b : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:938}, end: {_id:904}, properties:{evidence:"Interferon alfa-2a / 2b : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:944}, end: {_id:904}, properties:{evidence:"FN-β1a (IFNB1) : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:945}, end: {_id:904}, properties:{evidence:"IFN-gamma : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:1142}, end: {_id:1211}, properties:{evidence:"Host interactions of Nsp8 (signal recognition particle), Orf8 (endoplasmic reticulum quality control), M (ER structural morphology proteins), Nsp13 (golgins) may facilitate the dramatic reconfiguration of ER/Golgi trafficking during coronavirus infection, and interactions in peripheral compartments by Nsp6 and M (vacuolar ATPase), Nsp7 (Rabs), Nsp10 (AP2), E (AP3), and Orf3a (HOPS) may also modify endomembrane compartments to favor coronavirus replication.", annotationMeshdisease:["Coronavirus Infections"], citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1180}, end: {_id:1211}, properties:{evidence:"Host interactions of Nsp8 (signal recognition particle), Orf8 (endoplasmic reticulum quality control), M (ER structural morphology proteins), Nsp13 (golgins) may facilitate the dramatic reconfiguration of ER/Golgi trafficking during coronavirus infection, and interactions in peripheral compartments by Nsp6 and M (vacuolar ATPase), Nsp7 (Rabs), Nsp10 (AP2), E (AP3), and Orf3a (HOPS) may also modify endomembrane compartments to favor coronavirus replication.", annotationMeshdisease:["Coronavirus Infections"], citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1175}, end: {_id:1211}, properties:{evidence:"Host interactions of Nsp8 (signal recognition particle), Orf8 (endoplasmic reticulum quality control), M (ER structural morphology proteins), Nsp13 (golgins) may facilitate the dramatic reconfiguration of ER/Golgi trafficking during coronavirus infection, and interactions in peripheral compartments by Nsp6 and M (vacuolar ATPase), Nsp7 (Rabs), Nsp10 (AP2), E (AP3), and Orf3a (HOPS) may also modify endomembrane compartments to favor coronavirus replication.", annotationMeshdisease:["Coronavirus Infections"], citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1147}, end: {_id:1211}, properties:{evidence:"Host interactions of Nsp8 (signal recognition particle), Orf8 (endoplasmic reticulum quality control), M (ER structural morphology proteins), Nsp13 (golgins) may facilitate the dramatic reconfiguration of ER/Golgi trafficking during coronavirus infection, and interactions in peripheral compartments by Nsp6 and M (vacuolar ATPase), Nsp7 (Rabs), Nsp10 (AP2), E (AP3), and Orf3a (HOPS) may also modify endomembrane compartments to favor coronavirus replication.", annotationMeshdisease:["Coronavirus Infections"], citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1252}, end: {_id:368}, properties:{evidence:"Two other E3 ubiquitin ligases, TRIM59 and MIB1 regulate antiviral innate immune signaling and are usurped by Orf3a and Nsp9, respectively [46,47].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1254}, end: {_id:368}, properties:{evidence:"Two other E3 ubiquitin ligases, TRIM59 and MIB1 regulate antiviral innate immune signaling and are usurped by Orf3a and Nsp9, respectively [46,47].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1323}, end: {_id:1393}, properties:{annotationExperiment:["Expert identified"], evidence:"As a final example, we were intrigued to observe that the SARS-CoV-2 Nsp6 protein interacts with the Sigma receptor, which is thought to regulate ER stress response [71].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1556}, end: {_id:1557}, properties:{evidence:"BST2, which was previously shown to play a role in pre-B-cell growth, also showed upexpression in COVID-19 patients.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:1550}, end: {_id:725}, properties:{evidence:"Consistent with our single cell transcription data, the expression profile of FOS, which is a transcription factor mediating MAPK pathway signaling, showed up-regulation in COVID-19 patients but down-regulation in cured patients.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:REGULATES]->(end) SET r += row.properties;
UNWIND [{start: {_id:636}, end: {_id:72}, properties:{evidence:"S glycoprotein includes two sub-units, S1 and S2 [30]. S1 determines the virus-host range and cellular tropism with the key function domain−RBD, while S2 mediates virus-cell membrane fusion by two tandem domains, heptad repeats 1 (HR1) [31] and HR2[32].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:637}, end: {_id:641}, properties:{evidence:"S glycoprotein includes two sub-units, S1 and S2 [30]. S1 determines the virus-host range and cellular tropism with the key function domain−RBD, while S2 mediates virus-cell membrane fusion by two tandem domains, heptad repeats 1 (HR1) [31] and HR2[32].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:2691}, end: {_id:225}, properties:{evidence:"The ~306 aa long main protease (Mpro), a key enzyme for coronavirus replication, is also encoded by the polypeptide and responsible for processing the polypeptide into functional proteins (Lai and Holmes, 2001).", annotationMeshdisease:["Coronavirus Infections"], pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:2708}, end: {_id:1211}, properties:{evidence:"Host interactions of Nsp8 (signal recognition particle), Orf8 (endoplasmic reticulum quality control), M (ER structural morphology proteins), Nsp13 (golgins) may facilitate the dramatic reconfiguration of ER/Golgi trafficking during coronavirus infection, and interactions in peripheral compartments by Nsp6 and M (vacuolar ATPase), Nsp7 (Rabs), Nsp10 (AP2), E (AP3), and Orf3a (HOPS) may also modify endomembrane compartments to favor coronavirus replication.", annotationMeshdisease:["Coronavirus Infections"], citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:2719}, end: {_id:1211}, properties:{evidence:"Host interactions of Nsp8 (signal recognition particle), Orf8 (endoplasmic reticulum quality control), M (ER structural morphology proteins), Nsp13 (golgins) may facilitate the dramatic reconfiguration of ER/Golgi trafficking during coronavirus infection, and interactions in peripheral compartments by Nsp6 and M (vacuolar ATPase), Nsp7 (Rabs), Nsp10 (AP2), E (AP3), and Orf3a (HOPS) may also modify endomembrane compartments to favor coronavirus replication.", annotationMeshdisease:["Coronavirus Infections"], citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:2718}, end: {_id:1211}, properties:{evidence:"Host interactions of Nsp8 (signal recognition particle), Orf8 (endoplasmic reticulum quality control), M (ER structural morphology proteins), Nsp13 (golgins) may facilitate the dramatic reconfiguration of ER/Golgi trafficking during coronavirus infection, and interactions in peripheral compartments by Nsp6 and M (vacuolar ATPase), Nsp7 (Rabs), Nsp10 (AP2), E (AP3), and Orf3a (HOPS) may also modify endomembrane compartments to favor coronavirus replication.", annotationMeshdisease:["Coronavirus Infections"], citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1252}, end: {_id:2744}, properties:{evidence:"Two other E3 ubiquitin ligases, TRIM59 and MIB1 regulate antiviral innate immune signaling and are usurped by Orf3a and Nsp9, respectively [46,47].", citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1254}, end: {_id:2744}, properties:{evidence:"Two other E3 ubiquitin ligases, TRIM59 and MIB1 regulate antiviral innate immune signaling and are usurped by Orf3a and Nsp9, respectively [46,47].", citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:REGULATES]->(end) SET r += row.properties;
UNWIND [{start: {_id:53}, end: {_id:62}, properties:{evidence:"Also, co-localization has been observed between SARS-CoV non-structural proteins and protein disulfide isomerase (PDI), an ER marker (Snijder et al., 2006).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:55}, end: {_id:66}, properties:{evidence:"The EDEMosomes are COPII-independent vesicles that export from the ER, which are normally used to fine-tune the level of ER degradation enhancer, mannosidase alpha-like 1 (EDEM1), a regulator of ER-associated degradation (ERAD;Calì et al., 2008). It has been demonstrated that MHV infection causes accumulation of EDEM1 and osteosarcoma amplified 9 (OS-9, another EDEMosome cargo),and that both EDEM1 and OS-9 co-localize with the RTCs of MHV (Reggiori et al., 2010).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:55}, end: {_id:68}, properties:{evidence:"The EDEMosomes are COPII-independent vesicles that export from the ER, which are normally used to fine-tune the level of ER degradation enhancer, mannosidase alpha-like 1 (EDEM1), a regulator of ER-associated degradation (ERAD;Calì et al., 2008). It has been demonstrated that MHV infection causes accumulation of EDEM1 and osteosarcoma amplified 9 (OS-9, another EDEMosome cargo),and that both EDEM1 and OS-9 co-localize with the RTCs of MHV (Reggiori et al., 2010).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:386}, end: {_id:62}, properties:{evidence:"Also, co-localization has been observed between SARS-CoV non- structural proteins and protein disulfide isomerase (PDI), an ER marker (Snijder et al., 2006).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:459}, end: {_id:2688}, properties:{evidence:"In vitro, chloroquine appears as a versatile bioactive agent reported to possess antiviral activity against RNA viruses as diverse as rabies virus [16], poliovirus [17], HIV [12,[18], [19], [20], hepatitis A virus [21,22], hepatitis C virus [23], influenza A and B viruses [24], [25], [26], [27], influenza A H5N1 virus [28], Chikungunya virus [29], [30], [31], Dengue virus [32,33], Zika virus [34], Lassa virus [35], Hendra and Nipah viruses [36,37], Crimean–Congo hemorrhagic fever virus [38] and Ebola virus [39], as well as various DNA viruses such as hepatitis B virus [40] and herpes simplex virus [41].", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:172}, end: {_id:170}, properties:{evidence:"It was found that the kinase domain but not the RNase activity of IRE1 was required, and treatment of a JNK inhibitor (SP600125) abolished autophagosome formation after ER stress (Ogata et al.,2006).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:253}, end: {_id:287}, properties:{evidence:"Treatment of LNCaP cells with FQ (30 μM) for 2 h reduced HIF-1α expression, suggesting that FQ has HIF-1α inhibitory activity in serum-starved conditions.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:479}, end: {_id:480}, properties:{evidence:"Other  potential  drugs  include  type  II  transmembrane  serine protease (TMSPSS2) inhibitors and BCR-ABL kinase  inhibitor  imatinib.", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:479}, end: {_id:481}, properties:{evidence:"Other  potential  drugs  include  type  II  transmembrane  serine protease (TMSPSS2) inhibitors and BCR-ABL kinase  inhibitor  imatinib.", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:424}, end: {_id:133}, properties:{evidence:"Moreover, chloroquine has immunomodulatory effects, suppressing the production/release of TNF-α and IL-6. It also works as a novel class of autophagy inhibitor [81], which may interfere with viral infection and replication.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:424}, end: {_id:136}, properties:{evidence:"Moreover, chloroquine has immunomodulatory effects, suppressing the production/release of TNF-α and IL-6. It also works as a novel class of autophagy inhibitor [81], which may interfere with viral infection and replication.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:666}, end: {_id:667}, properties:{evidence:"The other antiviral drugs include nitazoxanide, favipiravir, nafamostat, and so on (See Table 1 for details).", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:424}, end: {_id:692}, properties:{evidence:"Chloroquine was shown to inhibit quinone reductase 2 [56], a structural neighbour of UDP-N-acetylglucosamine 2-epimerases [57] that are involved in the biosynthesis of sialic acids. The sialic acids are acidic monosaccharides found at the extremity of sugar chains present on cell transmembrane proteins and are critical components of ligand recognition. The possible interference of chloroquine with sialic acid biosynthesis could account for the broad antiviral spectrum of that drug since viruses such as the human coronavirus HCoV-O43 and the orthomyxoviruses use sialic acid moieties as receptors [58].", annotationCellculture:["HCoV-O43"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:696}, properties:{evidence:"The potent anti-SARS-CoV-1 effects of chloroquine in vitro were considered attributable to a deficit in the glycosylation of a virus cell surface receptor, the angiotensin-converting enzyme 2 (ACE2) on Vero cells [59].", pmid:"32171740", annotationCellline:["Vero cell"], citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:709}, properties:{evidence:"For HIV, the antiretroviral effect of chloroquine is attributable to a post-transcriptional inhibition of glycosylation of the gp120 envelope glycoprotein, and the neosynthesised virus particles are non-infectious [19,65].", pmid:"32171740", annotationDisease:["human immunodeficiency virus infectious disease"], citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:0}, properties:{evidence:"Chloroquine also inhibits the replication Dengue-2 virus by affecting the normal proteolytic processing of the flavivirus prM protein to M protein [32].", annotationMeshdisease:["Dengue"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:148}, properties:{evidence:"Chloroquine is known to inhibit phosphorylation (activation) of the p38 mitogen-activated protein kinase (MAPK) in THP-1 cells as well as caspase-1 [72]. Activation of cells via MAPK signalling is frequently required by viruses to achieve their replication cycle [73]. In the model of HCoV-229 coronavirus, chloroquine-induced virus inhibition occurs through inhibition of p38 MAPK [44].", pmid:"32171740", annotationCellline:["THP-1 cell"], citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:724}, properties:{evidence:"Chloroquine is known to inhibit phosphorylation (activation) of the p38 mitogen-activated protein kinase (MAPK) in THP-1 cells as well as caspase-1 [72]. Activation of cells via MAPK signalling is frequently required by viruses to achieve their replication cycle [73]. In the model of HCoV-229 coronavirus, chloroquine-induced virus inhibition occurs through inhibition of p38 MAPK [44].", pmid:"32171740", annotationCellline:["THP-1 cell"], citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:188}, properties:{evidence:"Chloroquine inhibits interleukin-1 beta (IL-1β) mRNA expression in THP-1 cells and reduces IL-1β release [72].", pmid:"32171740", annotationCellline:["THP-1 cell"], citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:728}, properties:{evidence:"Chloroquine-induced reduction of IL-1 and IL-6 cytokines was also found in monocytes/macrophages [79].", annotationMeshanatomy:["Macrophages"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:133}, properties:{evidence:"Chloroquine-induced reduction of IL-1 and IL-6 cytokines was also found in monocytes/macrophages [79].", annotationMeshanatomy:["Macrophages"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:136}, properties:{evidence:"Chloroquine-induced inhibition of tumour necrosis factor-alpha (TNFα) production by immune cells was reported to occur either through disruption of cellular iron metabolism [80], blockade of the conversion of pro-TNF into soluble mature TNFα molecules [81] and/or inhibition of TNFα mRNA expression [72,82,83].", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:732}, properties:{evidence:"Inhibition of the TNFα receptor was also reported in U937 monocytic cells treated with chloroquine [84]. In the Dengue virus model, chloroquine was found to inhibit interferon-alpha (IFNα), IFNβ, IFNγ, TNFα, IL-6 and IL-12 gene expression in U937 cells infected with Dengue-2 virus [33].", annotationCellculture:["U937"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:766}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:767}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:768}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:769}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:770}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:771}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:772}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:773}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:774}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:775}, end: {_id:749}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:616}, end: {_id:73}, properties:{evidence:"ACE inhibitors, AT1R blockers and mineralocorticoid receptor blockers (MRB), pioglitazone and ibuprofen included, are reported to have direct effects on suppression of the ACE-Ang II-AT1R axis, often increasing ACE2 and Ang (1–7) significantly, in contrast with the inhibitory effects on the ACE2-ANG(1-7) axis by glucocorticoids", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:892}, end: {_id:857}, properties:{evidence:"losartan: ACE DOWN", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:844}, end: {_id:73}, properties:{evidence:"ANGII: ACE2 DOWN", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:310}, end: {_id:909}, properties:{evidence:"For example, recent work showed that the MERS-CoV virus induces reduced levels of the Beclin1 (BECN1) protein, which blocks the fusion of autophagosomes and lysosomes and the inhibition of the S-phase kinase-associated protein 2 (SKP2), an E3 ubiquitin ligase which promotes BECN1 degradation, enhances autophagy and reduces the replication of MERS-CoV up to 28,000-fold.", annotationDisease:["Middle East respiratory syndrome"], citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:1105}, end: {_id:19}, properties:{evidence:"Different directly acting antiviral drugs are approved against other viruses, by the Food and Drugs Administration (FDA), such as Sofosbuvir, Ribavirin against RdRp of Hepatitis C Virus (HCV).", annotationMeshdisease:["Hepatitis, Viral, Human"], citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:456}, end: {_id:19}, properties:{evidence:"Different directly acting antiviral drugs are approved against other viruses, by the Food and Drugs Administration (FDA), such as Sofosbuvir, Ribavirin against RdRp of Hepatitis C Virus (HCV).", annotationMeshdisease:["Hepatitis, Viral, Human"], citationType:"elsevier", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}, {start: {_id:1281}, end: {_id:1273}, properties:{evidence:"SGs are induced by protein kinase R (PKR)-mediated phosphorylation of eIF2α upon viral dsRNA recognition [57]. Promoting G3BP aggregation via the eIF4A inhibitor Zotatafin [58,59] or reducing SG disassembly by Silmitasertib inhibition of CK2 [60] warrant investigation for treatment of SARS-CoV-2. The mTOR inhibitor rapamycin disrupts the binding of LARP1 to mTORC1 [61] and has been shown to reduce MERS infection by ∼60% in vitro [62], another drug that could be tested for repurposing.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1283}, end: {_id:1271}, properties:{evidence:"SGs are induced by protein kinase R (PKR)-mediated phosphorylation of eIF2α upon viral dsRNA recognition [57]. Promoting G3BP aggregation via the eIF4A inhibitor Zotatafin [58,59] or reducing SG disassembly by Silmitasertib inhibition of CK2 [60] warrant investigation for treatment of SARS-CoV-2. The mTOR inhibitor rapamycin disrupts the binding of LARP1 to mTORC1 [61] and has been shown to reduce MERS infection by ∼60% in vitro [62], another drug that could be tested for repurposing.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1315}, end: {_id:1304}, properties:{annotationExperiment:["Literature derived"], evidence:"Chemoinformatics searches yielded 15 approved drugs, four investigational new drugs (clinical), and 18 pre-clinical candidates (Table 1a), while specialist knowledge revealed 12 approved drugs, 10 investigational new drugs (clinical), and 10 preclinical candidates (Table 1b).", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1315}, end: {_id:1308}, properties:{annotationExperiment:["Literature derived"], evidence:"Chemoinformatics searches yielded 15 approved drugs, four investigational new drugs (clinical), and 18 pre-clinical candidates (Table 1a), while specialist knowledge revealed 12 approved drugs, 10 investigational new drugs (clinical), and 10 preclinical candidates (Table 1b).", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1316}, end: {_id:1304}, properties:{annotationExperiment:["Literature derived"], evidence:"Chemoinformatics searches yielded 15 approved drugs, four investigational new drugs (clinical), and 18 pre-clinical candidates (Table 1a), while specialist knowledge revealed 12 approved drugs, 10 investigational new drugs (clinical), and 10 preclinical candidates (Table 1b).", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1316}, end: {_id:1308}, properties:{annotationExperiment:["Literature derived"], evidence:"Chemoinformatics searches yielded 15 approved drugs, four investigational new drugs (clinical), and 18 pre-clinical candidates (Table 1a), while specialist knowledge revealed 12 approved drugs, 10 investigational new drugs (clinical), and 10 preclinical candidates (Table 1b).", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}] AS row
