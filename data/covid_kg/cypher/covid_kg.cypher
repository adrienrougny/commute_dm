UNWIND [{start: {_id:224}, end: {_id:226}, properties:{evidence:"GS-5734 is a prodrug that requires metabolism by the host cell to the pharmacologically active triphosphate (TP) to inhibit virus replication.", pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:232}, end: {_id:216}, properties:{evidence:"Treatment of HAE cultures with GS-5734 infected with human CoV NL63, a circulating group 1 human CoV that typically causes bronchitis, resulted in a pronounced 3 log10 reduction in virus production at 0.1 mM and undetectable virus at higher concentrations.", pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:250}, end: {_id:251}, properties:{evidence:"Out of different classes of compounds targeting autophagic-lysosomal function in cancer, two antimalarial drugs chloroquine (CQ) and hydroxychloroquine (HCQ) are currently being investigated in clinical trials for cancer therapy.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:252}, end: {_id:251}, properties:{evidence:"Out of different classes of compounds targeting autophagic-lysosomal function in cancer, two antimalarial drugs chloroquine (CQ) and hydroxychloroquine (HCQ) are currently being investigated in clinical trials for cancer therapy.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:254}, properties:{evidence:"Interestingly, unlike all the other CQ analogues currently used for malaria treatment, FQ represents an organometallic compound in which ferrocene molecule (an iron atom sandwiched between two aromatic rings) is covalently bound to a 4-aminoquinoline and a basic alkylamine.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:251}, properties:{evidence:"FQ has strong antimalarial activity that greatly surpasses that of CQ, and it is active against CQ-resistant and multiresistant parasite strains.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:224}, end: {_id:226}, properties:{evidence:"Remdesivir (RDV, GS-5734) is a monophosphoramidate prodrug of an adenosine analog with demonstrated antiviral activity against an array of RNA virus families including Filoviridae, Paramyxoviridae, Pneumoviridae, and CoV.", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:232}, end: {_id:216}, properties:{evidence:"We previously reported the antiviral activity of RDV against a genetically diverse panel of human endemic, emerging and zoonotic CoV including HCoV-NL63 (alpha 1b), mouse hepatitis virus (MHV, beta 2a), SARS-CoV and related Bat CoVs WIV1 and SHC014 (beta 2b), as well as MERS-CoV and related Bat CoV HKU5 (beta 2c).", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:308}, end: {_id:217}, properties:{evidence:"We previously reported the antiviral activity of RDV against a genetically diverse panel of human endemic, emerging and zoonotic CoV including HCoV-NL63 (alpha 1b), mouse hepatitis virus (MHV, beta 2a), SARS-CoV and related Bat CoVs WIV1 and SHC014 (beta 2b), as well as MERS-CoV and related Bat CoV HKU5 (beta 2c).", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:234}, end: {_id:217}, properties:{evidence:"We previously reported the antiviral activity of RDV against a genetically diverse panel of human endemic, emerging and zoonotic CoV including HCoV-NL63 (alpha 1b), mouse hepatitis virus (MHV, beta 2a), SARS-CoV and related Bat CoVs WIV1 and SHC014 (beta 2b), as well as MERS-CoV and related Bat CoV HKU5 (beta 2c).", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:309}, end: {_id:217}, properties:{evidence:"We previously reported the antiviral activity of RDV against a genetically diverse panel of human endemic, emerging and zoonotic CoV including HCoV-NL63 (alpha 1b), mouse hepatitis virus (MHV, beta 2a), SARS-CoV and related Bat CoVs WIV1 and SHC014 (beta 2b), as well as MERS-CoV and related Bat CoV HKU5 (beta 2c).", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:310}, end: {_id:217}, properties:{evidence:"We previously reported the antiviral activity of RDV against a genetically diverse panel of human endemic, emerging and zoonotic CoV including HCoV-NL63 (alpha 1b), mouse hepatitis virus (MHV, beta 2a), SARS-CoV and related Bat CoVs WIV1 and SHC014 (beta 2b), as well as MERS-CoV and related Bat CoV HKU5 (beta 2c).", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:313}, end: {_id:314}, properties:{evidence:"Inhibition of viral protease has also been evaluated with lopinavir, a protease inhibitor designed for human immunodeficiency virus, which like chloroquine exerts a moderate antiviral effect on CoV replication (EC50 values: MERS-CoV 8 μM, SARSCoV 17.1 μM, HCoV-229E 6.6 μM).", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:224}, end: {_id:316}, properties:{evidence:"RDV is a broad-spectrum antiviral drug with potent in vitro antiviral activity andin vivo therapeutic efficacy against CoV.", annotationBioassay:["in vivo", "in vitro"], pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:299}, end: {_id:218}, properties:{evidence:"Here, we show that PDCoV, a member of the deltacoronavirus genus, is exquisitely sensitive to RDV despite naturally harboring a one of the two RdRp resistance mutations identified in MHV.", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:333}, end: {_id:334}, properties:{evidence:"Interestingly, uptake and the antiviral activity of ribavirin, another nucleoside analog, was reported to vary significantly among human liver cell lines, which was directly correlated with antiviral activity against poliovirus indicating that variation in small molecule uptake/transport can impact antiviral efficacy.", pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:300}, end: {_id:363}, properties:{evidence:"CoVs belong to the subfamily Coronavirinae in the family of Coronaviridae of the order Nidovirales, and this subfamily includes four genera: Alphacoronavirus, Betacoronavirus, Gammacoronavirus,and Deltacoronavirus.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:363}, end: {_id:364}, properties:{evidence:"CoVs belong to the subfamily Coronavirinae in the family of Coronaviridae of the order Nidovirales, and this subfamily includes four genera: Alphacoronavirus, Betacoronavirus, Gammacoronavirus,and Deltacoronavirus.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:320}, end: {_id:217}, properties:{evidence:"Sequence analysis shows that the 2019‐nCoV possesses a typical genome structure of CoV and belongs to the cluster of betacoronaviruses that includes Bat‐SARS‐like (SL)‐ZC45, Bat‐SL ZXC21, SARS‐CoV, and MERS‐CoV.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:234}, end: {_id:217}, properties:{evidence:"Sequence analysis shows that the 2019‐nCoV possesses a typical genome structure of CoV and belongs to the cluster of betacoronaviruses that includes Bat‐SARS‐like (SL)‐ZC45, Bat‐SL ZXC21, SARS‐CoV, and MERS‐CoV.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}] AS row
