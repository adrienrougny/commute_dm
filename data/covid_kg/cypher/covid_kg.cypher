}, {start: {_id:1065}, end: {_id:1041}, properties:{evidence:"Propranolol suppressor of UPR stress antihypertensive drug; antianginal drug; antiarrhythmic drug", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:1066}, end: {_id:1041}, properties:{evidence:"Metoprolol suppressor of UPR stress antianginal drug; antihypertensive drug", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:1281}, end: {_id:1282}, properties:{evidence:"SGs are induced by protein kinase R (PKR)-mediated phosphorylation of eIF2α upon viral dsRNA recognition [57]. Promoting G3BP aggregation via the eIF4A inhibitor Zotatafin [58,59] or reducing SG disassembly by Silmitasertib inhibition of CK2 [60] warrant investigation for treatment of SARS-CoV-2. The mTOR inhibitor rapamycin disrupts the binding of LARP1 to mTORC1 [61] and has been shown to reduce MERS infection by ∼60% in vitro [62], another drug that could be tested for repurposing.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1319}, end: {_id:703}, properties:{annotationExperiment:["Expert identified"], evidence:"Among them, the well-known chemical probe, Bafilomycin A1, is a potent inhibitor of the V1-ATPase, subunits of which interact with Nsp6 and M. Bafilomycin’s inhibition of this cotransporter acts to prevent the acidification of the lysosome, inhibiting autophagy and endosome trafficking pathways, which may impact the viral life-cycle.", annotationMeshanatomy:["Lysosomes"], citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1319}, end: {_id:174}, properties:{annotationExperiment:["Expert identified"], evidence:"Among them, the well-known chemical probe, Bafilomycin A1, is a potent inhibitor of the V1-ATPase, subunits of which interact with Nsp6 and M. Bafilomycin’s inhibition of this cotransporter acts to prevent the acidification of the lysosome, inhibiting autophagy and endosome trafficking pathways, which may impact the viral life-cycle.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1319}, end: {_id:1391}, properties:{annotationExperiment:["Expert identified"], evidence:"Among them, the well-known chemical probe, Bafilomycin A1, is a potent inhibitor of the V1-ATPase, subunits of which interact with Nsp6 and M. Bafilomycin’s inhibition of this cotransporter acts to prevent the acidification of the lysosome, inhibiting autophagy and endosome trafficking pathways, which may impact the viral life-cycle.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:320}, end: {_id:1454}, properties:{evidence:"Daczkowski et al. demonstrated that CoV could interact with IFN stimulated gene 15 (ISG15) and antagonize the IFN-mediated antiviral response.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:234}, end: {_id:1454}, properties:{evidence:"Daczkowski et al. demonstrated that CoV could interact with IFN stimulated gene 15 (ISG15) and antagonize the IFN-mediated antiviral response.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:310}, end: {_id:1454}, properties:{evidence:"Daczkowski et al. demonstrated that CoV could interact with IFN stimulated gene 15 (ISG15) and antagonize the IFN-mediated antiviral response.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:224}, end: {_id:225}, properties:{annotationCellstructure:["Endoplasmic Reticulum", "Golgi Apparatus"], evidence:"Remdesivir only and in combination with chloroquine or interferon beta significantly blocked the SARSCoV-2 replication and patients were declared as clinically recovered.", annotationDisease:["Severe acute respiratory syndrome coronavirus 2"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:786}, end: {_id:231}, properties:{evidence:"Here, we identified that teicoplanin acted specifically as a 2019-nCoV entry inhibitor in a dose-dependent manner (Figure 2B).", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:786}, end: {_id:231}, properties:{evidence:"The data showed that teicoplanin also effectively repressed virus entrance into HEK293T cells (Figure. 3A), and Huh7 cells (Figure 3B).", annotationCellline:["HEK293T", "Huh7 cell"], citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:1566}, end: {_id:231}, properties:{evidence:"The data illustrated that the dalbavancin also repressed the entry of 2019-nCoV in a dose-dependent manner (Figure 3C).", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:449}, end: {_id:118}, properties:{evidence:"IFN-α is a broad-spectrum antiviral that is usually used to treat hepatitis, though it is reported to inhibit SARS-CoV reproduction in vitro (4).", annotationMeshdisease:["Severe Acute Respiratory Syndrome"], pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:477}, end: {_id:225}, properties:{evidence:"Studies have also revealed some other drugs may have potential efficacy in treating COVID-19. One is darunavir, which is a second- generation of HIV-1 protease inhibitor. On February 4, 2020, researchers in China announced that darunavir inhibited SARS-CoV-2 infection in vitro (9). Cell experiments indicated that darunavir significantly inhibited viral replication at a concentration of 300 μM in vitro and that its inhibition efficiency was 280-fold that in the untreated group (9).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:479}, end: {_id:482}, properties:{evidence:"Imatinib has anti-coronal activity primarily because it inhibits the fusion of virions with the endosomal membrane (18).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
