UNWIND [{start: {_id:320}, end: {_id:922}, properties:{evidence:"CoV can impede the interferon induction in humans.", annotationDisease:["Severe acute respiratory syndrome coronavirus 2"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:1477}, end: {_id:728}, properties:{evidence:"However, in hyperinflammation, immunosuppression is likely to be beneficial. Re-analysis of data from a phase 3 randomised controlled trial of IL-1 blockade (anakinra) in sepsis, showed significant survival benefit in patients with hyperinflammation, without increased adverse events.[8]", citationType:"lancet", citationRef:"https://doi.org/10.1016/S0140-6736(20)30628-0"}}, {start: {_id:1479}, end: {_id:1480}, properties:{evidence:"A multicentre, randomised controlled trial of tocilizumab (IL-6 receptor blockade, licensed for cytokine release syndrome), has been approved in patients with COVID-19 pneumonia and elevated IL-6 in China (ChiCTR2000029765) [9]. Janus kinase (JAK) inhibition could affect both inflammation and cellular viral entry in COVID-19 [10].", citationType:"lancet", citationRef:"https://doi.org/10.1016/S0140-6736(20)30628-0"}}, {start: {_id:1516}, end: {_id:1517}, properties:{evidence:"These results show that blocking CD147 on the host cells has an inhibitory effect on SARS-CoV-2, suggesting an essential role of CD147 in facilitating SARS-CoV-2 invasion for host cells.", annotationCells:["Vero E6"], citationType:"biorvix", citationRef:"https://doi.org/10.1101/2020.03.14.988345"}}, {start: {_id:786}, end: {_id:789}, properties:{evidence:"Here, we identified that teicoplanin acted specifically as a 2019-nCoV entry inhibitor in a dose-dependent manner (Figure 2B).", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:1566}, end: {_id:789}, properties:{evidence:"The data illustrated that the dalbavancin also repressed the entry of 2019-nCoV in a dose-dependent manner (Figure 3C).", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:2670}, end: {_id:148}, properties:{evidence:"Interestingly, a protein phosphatase called dual-specificity phosphatase 1 (DUSP1) was also up-regulated in IBV-infected cells and dephosphorylated p38 to modulate pro-inflammatory cytokine production (Liao et al., 2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:479}, end: {_id:480}, properties:{evidence:"Other potential drugs include type II transmembrane serine protease (TMSPSS2) inhibitors and BCR-ABL kinase inhibitor imatinib.", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:479}, end: {_id:481}, properties:{evidence:"Other potential drugs include type II transmembrane serine protease (TMSPSS2) inhibitors and BCR-ABL kinase inhibitor imatinib.", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:424}, end: {_id:709}, properties:{evidence:"For HIV, the antiretroviral effect of chloroquine is attributable to a post-transcriptional inhibition of glycosylation of the gp120 envelope glycoprotein, and the neosynthesised virus particles are non- infectious [19,65].", pmid:"32171740", annotationDisease:["human immunodeficiency virus infectious disease"], citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:766}, end: {_id:2691}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:767}, end: {_id:2691}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:768}, end: {_id:2691}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:769}, end: {_id:2691}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:770}, end: {_id:2691}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:771}, end: {_id:2691}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking to screen for commercial medicines in the DrugBank database that could bind to the above mentioned pocket site of 2019-nCoV Mpro, and identified 10 candidate clinical medicines (Table 1; Figs. 1B and S3).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:772}, end: {_id:2691}, properties:{annotationPpi:["VirtualDocking"], evidence:"Based on these results, we performed virtual docking 