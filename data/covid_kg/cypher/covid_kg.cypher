UNWIND [{start: {_id:4}, end: {_id:49}, properties:{evidence:"These S proteins cause fusion of the infected cell with neighboring uninfected cells,resulting in the formation of a large, multinucleated cell known as a syncytium, which enablesthe virus to spread without being released into the extracellular space (Masters, 2006).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:114}, end: {_id:113}, properties:{evidence:"However, if ER stress persists, GADD153 can induce apoptosis by suppressing the anti-apoptotic protein B-cell lymphoma 2 (Bcl-2) and inducing the pro-apoptotic proteins such as Bcl-2-interacting mediator of cell death (Bim;Puthalakath et al., 2007). GADD153 also activates ER oxidoreductin-1α (ERO1α), which encodes an ER oxidase. The increase protein influx to a hyperoxidizing ER aggravates ER stress and induces apoptosis (Marciniak et al., 2004;Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:109}, end: {_id:113}, properties:{evidence:"However, if ER stress persists, GADD153 can induce apoptosis by suppressing the anti-apoptotic protein B-cell lymphoma 2 (Bcl-2) and inducing the pro-apoptotic proteins such as Bcl-2-interacting mediator of cell death (Bim;Puthalakath et al., 2007). GADD153 also activates ER oxidoreductin-1α (ERO1α), which encodes an ER oxidase. The increase protein influx to a hyperoxidizing ER aggravates ER stress and induces apoptosis (Marciniak et al., 2004;Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:115}, end: {_id:113}, properties:{evidence:"However, if ER stress persists, GADD153 can induce apoptosis by suppressing the anti-apoptotic protein B-cell lymphoma 2 (Bcl-2) and inducing the pro-apoptotic proteins such as Bcl-2-interacting mediator of cell death (Bim;Puthalakath et al., 2007). GADD153 also activates ER oxidoreductin-1α (ERO1α), which encodes an ER oxidase. The increase protein influx to a hyperoxidizing ER aggravates ER stress and induces apoptosis (Marciniak et al., 2004;Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:90}, end: {_id:116}, properties:{evidence:"However, similar to PKR, viruses have adopted counter measures to inhibit PERK-mediated translation attenuation.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:129}, end: {_id:113}, properties:{evidence:"The up-regulation of GADD153 promotes apoptosis in IBV-infected cells, possibly via inducing the pro-apoptotic protein tribbles-related protein 3 (TRIB3) and suppressing the pro-survival kinase extracellular signal-related kinase (ERK;Liaoet al., 2013).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:132}, properties:{evidence:"Interestingly, GADD34 expression did not significantly affect protein synthesis in DCs, but was shown to be crucial for the production of interferon β (IFN-β) and pro-inflammatory cytokines interleukin-6 (IL-6;Clavarino et al.,2012).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:136}, end: {_id:137}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro-inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:133}, end: {_id:137}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro-inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:146}, end: {_id:116}, properties:{evidence:"Under various stress conditions, phosphorylation of eIF2α leads to global translation repression and a net decrease in IκBα protein level (Jiang et al., 2003).This then results in the activation of NF-κB and induction of pro-inflammatory response (Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:146}, end: {_id:137}, properties:{evidence:"Under various stress conditions, phosphorylation of eIF2α leads to global translation repression and a net decrease in IκBα protein level (Jiang et al., 2003).This then results in the activation of NF-κB and induction of pro-inflammatory response (Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:153}, end: {_id:113}, properties:{evidence:"Besides p38, DUSP1 has also been shown to dephosphorylate c-Jun N-terminal kinase (JNK) and ERK (Sun et al.,1993;Franklin and Kraft, 1997). It has been long proposed that ERK phosphorylation promotes cell survival, whereas prolonged JNK and p38 phosphorylation is linked to the induction of apoptosis (Xia et al., 1995).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:154}, end: {_id:113}, properties:{evidence:"Besides p38, DUSP1 has also been shown to dephosphorylate c-Jun N-terminal kinase (JNK) and ERK (Sun et al.,1993;Franklin and Kraft, 1997). It has been long proposed that ERK phosphorylation promotes cell survival, whereas prolonged JNK and p38 phosphorylation is linked to the induction of apoptosis (Xia et al., 1995).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:194}, end: {_id:203}, properties:{evidence:"Previously, it was proposed the ATF6 pathway is mainly pro-survival, as it enhances the ER protein folding capacity to counteract ER stress (Szegezdiet al., 2006).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:205}, end: {_id:113}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress-induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:194}, end: {_id:113}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress-induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:209}, end: {_id:210}, properties:{evidence:"The NS4B protein of HCV has been shown to activate ATF6 signaling in cultured cells (Li et al.,2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:330}, end: {_id:332}, properties:{evidence:"Interestingly, Kirchdorfer and Ward suggest the V557L (V553L in MHV) resistance mutation in the SARS-CoV RdRp increases stringency of base pairing thereby increasing polymerase fidelity allowing for better exclusion of RDV from the active site.", annotationSpecies:["694009"], pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:326}, end: {_id:332}, properties:{evidence:"Interestingly, Kirchdorfer and Ward suggest the V557L (V553L in MHV) resistance mutation in the SARS-CoV RdRp increases stringency of base pairing thereby increasing polymerase fidelity allowing for better exclusion of RDV from the active site.", annotationSpecies:["11138"], pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:342}, end: {_id:369}, properties:{evidence:"nsp3 function: PLP, polypeptides cleaving, blocking host innate immune response, promoting cytokine expression.", annotationSpecies:["2697049"], pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:229}, end: {_id:382}, properties:{evidence:"Homotrimers of S proteins make up the spikes on the viral surface and they are responsible for attachment to host receptors.", annotationSpecies:["2697049"], pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:520}, end: {_id:521}, properties:{evidence:"The surface spike glycoprotein (S) is an important potential target for anti-viral agents, due to its vital role in the interaction between the virus and the cell receptor", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:229}, end: {_id:521}, properties:{evidence:"The surface spike glycoprotein (S) is an important potential target for anti-viral agents, due to its vital role in the interaction between the virus and the cell receptor", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:707}, end: {_id:118}, properties:{evidence:"A pH-dependant mechanism of entry of coronavirus into target cells was also reported for SARS-CoV-1 after binding of the DC-SIGN receptor [62]. The activation step that occurs in endosomes at acidic pH results in fusion of the viral and endosomal membranes leading to the release of the viral SARS-CoV-1 genome into the cytosol [63].In the absence of antiviral drug, the virus is targeted to the lysosomal compartment where the low pH, along with the action of enzymes, disrupts the viral particle, thus liberating the infectious nucleic acid and, in several cases, enzymes necessary for its replication [64].", annotationMeshdisease:["Coronavirus Infections"], annotationMeshanatomy:["Endosomes"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:148}, end: {_id:725}, properties:{evidence:"Chloroquine is known to inhibit phosphorylation (activation) of the p38 mitogen-activated protein kinase (MAPK) in THP-1 cells as well as caspase-1 [72]. Activation of cells via MAPK signalling is frequently required by viruses to achieve their replication cycle [73]. In the model of HCoV-229 coronavirus, chloroquine-induced virus inhibition occurs through inhibition of p38 MAPK [44].", pmid:"32171740", annotationCellline:["THP-1 cell"], citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:229}, end: {_id:794}, properties:{evidence:"S proteins of coronaviruses are large membrane linked glycoproteins that are responsible both for binding to receptors on host cells and for membrane fusion.", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:73}, end: {_id:231}, properties:{evidence:"SARS-CoV-2, instead, it requires the angiotensin-converting enzyme 2 (ACE2) to enter cells.", annotationDisease:["Severe acute respiratory syndrome coronavirus 2"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:480}, end: {_id:794}, properties:{evidence:"TMPRSS2 had previously been revealed as a host cell factor that is critical for entry in the cells and not for viral replication, affecting the S protein at the cell surface and inducing virus-plasma membrane fusion.", annotationDisease:["Severe acute respiratory syndrome-related coronavirus", "Severe acute respiratory syndrome coronavirus 2"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:73}, end: {_id:873}, properties:{evidence:"The overwhelming scientific production in the field also reports on the spread role of ACE2 increase as anti-inflammatory and anti-oxidant agent, in several tissues, lungs, liver, in neuroprotection, and also in atherosclerosis, cerebral ischemia, obesity, chronic kidney disease, and asthma.", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:909}, end: {_id:911}, properties:{evidence:"For example, recent work showed that the MERS-CoV virus induces reduced levels of the Beclin1 (BECN1) protein, which blocks the fusion of autophagosomes and lysosomes and the inhibition of the S-phase kinase-associated protein 2 (SKP2), an E3 ubiquitin ligase which promotes BECN1 degradation, enhances autophagy and reduces the replication of MERS-CoV up to 28,000-fold.", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:910}, end: {_id:174}, properties:{evidence:"For example, recent work showed that the MERS-CoV virus induces reduced levels of the Beclin1 (BECN1) protein, which blocks the fusion of autophagosomes and lysosomes and the inhibition of the S-phase kinase-associated protein 2 (SKP2), an E3 ubiquitin ligase which promotes BECN1 degradation, enhances autophagy and reduces the replication of MERS-CoV up to 28,000-fold.", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:936}, end: {_id:937}, properties:{evidence:"Interferon alfa-2a / 2b : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:938}, end: {_id:937}, properties:{evidence:"Interferon alfa-2a / 2b : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:944}, end: {_id:937}, properties:{evidence:"FN-β1a (IFNB1) : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:945}, end: {_id:937}, properties:{evidence:"IFN-gamma : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:1250}, end: {_id:128}, properties:{evidence:"RNF41/Nrdp1, an E3 ubiquitin ligase is targeted by Nsp15 protein which promotes activation of TBK1 and IRF3 and therefore increases type I interferon production [45].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1276}, end: {_id:1277}, properties:{evidence:"SGs are induced by protein kinase R (PKR)-mediated phosphorylation of eIF2α upon viral dsRNA recognition [57]. Promoting G3BP aggregation via the eIF4A inhibitor Zotatafin [58,59] or reducing SG disassembly by Silmitasertib inhibition of CK2 [60] warrant investigation for treatment of SARS-CoV-2. The mTOR inhibitor rapamycin disrupts the binding of LARP1 to mTORC1 [61] and has been shown to reduce MERS infection by ∼60% in vitro [62], another drug that could be tested for repurposing.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:922}, end: {_id:1449}, properties:{evidence:"IFNs are a group of cytokines, which communicate between cells against pathogens and have a critical role in the immune system, such as activating natural killer (NK) cells and macrophages, in addition to the flu-like symptoms of various diseases.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:922}, end: {_id:1450}, properties:{evidence:"IFNs are a group of cytokines, which communicate between cells against pathogens and have a critical role in the immune system, such as activating natural killer (NK) cells and macrophages, in addition to the flu-like symptoms of various diseases.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:229}, end: {_id:521}, properties:{evidence:"The glycoprotein spikes on the outer surface of coronaviruses are responsible for the attachment and entry of the virus to host cells.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:520}, end: {_id:521}, properties:{evidence:"The glycoprotein spikes on the outer surface of coronaviruses are responsible for the attachment and entry of the virus to host cells.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1499}, end: {_id:523}, properties:{evidence:"The entry mechanism of a coronavirus depends upon cellular proteases which include, human airway trypsin-like protease (HAT), cathepsins and transmembrane protease serine 2 (TMPRSS2) that split the spike protein and establish further penetration changes.", annotationDisease:["Severe acute respiratory syndrome coronavirus 2"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:480}, end: {_id:523}, properties:{evidence:"The entry mechanism of a coronavirus depends upon cellular proteases which include, human airway trypsin-like protease (HAT), cathepsins and transmembrane protease serine 2 (TMPRSS2) that split the spike protein and establish further penetration changes.", annotationDisease:["Severe acute respiratory syndrome coronavirus 2"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:513}, end: {_id:523}, properties:{evidence:"MERS-coronavirus employs dipeptidyl peptidase 4 (DPP4), while HCoV-NL63 and SARS-coronavirus require angiotensin-converting enzyme 2 (ACE2) as a key receptor.", annotationDisease:["Middle East respiratory syndrome"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1543}, end: {_id:368}, properties:{evidence:"Among them, interferon α-inducible protein 27 (IFI27), originally known to involve in innate immunity and to intervene in cell proliferation, was increasingly expressed in many cell types, including CD1C+_B dendritic cells, CD1C-CD141- dendritic cells, CD141+CLEC9A+ dendritic cells, CD8 cytotoxic T cells, and plasmacytoid dendritic cells.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:1543}, end: {_id:1544}, properties:{evidence:"Among them, interferon α-inducible protein 27 (IFI27), originally known to involve in innate immunity and to intervene in cell proliferation, was increasingly expressed in many cell types, including CD1C+_B dendritic cells, CD1C-CD141- dendritic cells, CD141+CLEC9A+ dendritic cells, CD8 cytotoxic T cells, and plasmacytoid dendritic cells.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:1560}, end: {_id:698}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:136}, end: {_id:137}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro- inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:133}, end: {_id:137}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro- inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:194}, end: {_id:2675}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress- induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:205}, end: {_id:113}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress- induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:194}, end: {_id:113}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress- induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:2678}, end: {_id:210}, properties:{evidence:"The NS4B protein of HCV has been shown to activate ATF6 signaling in cultured cells (Li et al.,2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:2689}, end: {_id:118}, properties:{evidence:"A pH-dependant mechanism of entry of coronavirus into target cells was also reported for SARS-CoV-1 after binding of the DC-SIGN receptor [62]. The activation step that occurs in endosomes at acidic pH results in fusion of the viral and endosomal membranes leading to the release of the viral SARS-CoV-1 genome into the cytosol [63].In the absence of antiviral drug, the virus is targeted to the lysosomal compartment where the low pH, along with the action of enzymes, disrupts the viral particle, thus liberating the infectious nucleic acid and, in several cases, enzymes necessary for its replication [64].", annotationMeshdisease:["Coronavirus Infections"], annotationMeshanatomy:["Cytoplasm"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:2765}, end: {_id:698}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
