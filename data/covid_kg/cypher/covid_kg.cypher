UNWIND [{start: {_id:111}, end: {_id:92}, properties:{evidence:"One of ATF4’s target genes is the growth arrest and DNA damage-inducible protein 153 (GADD153, also knownas C/EBP homologous protein, or CHOP). GADD153 induces the growth arrest and DNA damage-inducible protein 34 (GADD34), which recruits protein phosphatase 1 (PP1) to dephosphorylate eIF2α and release the translation block.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:109}, end: {_id:112}, properties:{evidence:"However, if ER stress persists, GADD153 can induce apoptosis by suppressing the anti-apoptotic protein B-cell lymphoma 2 (Bcl-2) and inducing the pro-apoptotic proteins such as Bcl-2-interacting mediator of cell death (Bim;Puthalakath et al., 2007). GADD153 also activates ER oxidoreductin-1α (ERO1α), which encodes an ER oxidase. The increase protein influx to a hyperoxidizing ER aggravates ER stress and induces apoptosis (Marciniak et al., 2004;Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:92}, properties:{evidence:"The rapid dephosphorylation of eIF2α is likely due to the accumulation of GADD34, which is a component of the PP1 complex and a downstream target gene induced by GADD153 (Wang et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:109}, end: {_id:130}, properties:{evidence:"The up-regulation of GADD153 promotes apoptosis in IBV-infected cells, possibly via inducing the pro-apoptotic protein tribbles-related protein 3 (TRIB3) and suppressing the pro-survival kinase extracellular signal-related kinase (ERK;Liaoet al., 2013).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:134}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro-inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:134}, end: {_id:133}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro-inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:134}, end: {_id:136}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro-inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:146}, end: {_id:141}, properties:{evidence:"Under various stress conditions, phosphorylation of eIF2α leads to global translation repression and a net decrease in IκBα protein level (Jiang et al., 2003).This then results in the activation of NF-κB and induction of pro-inflammatory response (Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:152}, end: {_id:153}, properties:{evidence:"Besides p38, DUSP1 has also been shown to dephosphorylate c-Jun N-terminal kinase (JNK) and ERK (Sun et al.,1993;Franklin and Kraft, 1997). It has been long proposed that ERK phosphorylation promotes cell survival, whereas prolonged JNK and p38 phosphorylation is linked to the induction of apoptosis (Xia et al., 1995).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:152}, end: {_id:154}, properties:{evidence:"Besides p38, DUSP1 has also been shown to dephosphorylate c-Jun N-terminal kinase (JNK) and ERK (Sun et al.,1993;Franklin and Kraft, 1997). It has been long proposed that ERK phosphorylation promotes cell survival, whereas prolonged JNK and p38 phosphorylation is linked to the induction of apoptosis (Xia et al., 1995).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:149}, end: {_id:153}, properties:{evidence:"Besides p38, DUSP1 has also been shown to dephosphorylate c-Jun N-terminal kinase (JNK) and ERK (Sun et al.,1993;Franklin and Kraft, 1997). It has been long proposed that ERK phosphorylation promotes cell survival, whereas prolonged JNK and p38 phosphorylation is linked to the induction of apoptosis (Xia et al., 1995).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:149}, end: {_id:154}, properties:{evidence:"Besides p38, DUSP1 has also been shown to dephosphorylate c-Jun N-terminal kinase (JNK) and ERK (Sun et al.,1993;Franklin and Kraft, 1997). It has been long proposed that ERK phosphorylation promotes cell survival, whereas prolonged JNK and p38 phosphorylation is linked to the induction of apoptosis (Xia et al., 1995).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:157}, end: {_id:178}, properties:{evidence:"Interestingly, an earlier onset and more significant apoptosis induction in IRE1-knockdown IBV-infected cells was observed, which is associated with hyperphosphorylation of pro-apoptotic kinase JNK and hypophosphorylation of pro-survival kinase RAC-alpha serine/threonine-protein kinase (Akt).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:194}, end: {_id:205}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress-induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:211}, end: {_id:194}, properties:{evidence:"The authors thus conclude that global translation shutdown via eIF2α phosphorylation prevents accumulation of ATF6 and activation of ATF6 target genes (Bechill et al., 2008).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:836}, end: {_id:789}, properties:{evidence:"Interleukin 6 (IL-6) leads a relevant increase in cathepsin L, whereas TGF-beta1 decreases the amount of cathepsin L, at both mRNA and protein levels, proving that the cytokines IL-6 and TGF-beta 1 modulate cathepsin gene expression.", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:73}, end: {_id:880}, properties:{evidence:"As an example among the many, the loss of ACE2 function in mouse shows the release of pro-inflammatory chemokines, such as C-X-C motif chemokine 5 (CXCL5), macrophage inflammatory protein-2 (MIP2), C-X-C motif chemokine 1 (KC), and TNF-α from airway epithelia, increased neutrophil infiltration, and exaggerated lung inflammation and injury.", annotationSpecies:["10090"], annotationMeshanatomy:["Respiratory System"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:73}, end: {_id:881}, properties:{evidence:"As an example among the many, the loss of ACE2 function in mouse shows the release of pro-inflammatory chemokines, such as C-X-C motif chemokine 5 (CXCL5), macrophage inflammatory protein-2 (MIP2), C-X-C motif chemokine 1 (KC), and TNF-α from airway epithelia, increased neutrophil infiltration, and exaggerated lung inflammation and injury.", annotationSpecies:["10090"], annotationMeshanatomy:["Respiratory System"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:73}, end: {_id:882}, properties:{evidence:"As an example among the many, the loss of ACE2 function in mouse shows the release of pro-inflammatory chemokines, such as C-X-C motif chemokine 5 (CXCL5), macrophage inflammatory protein-2 (MIP2), C-X-C motif chemokine 1 (KC), and TNF-α from airway epithelia, increased neutrophil infiltration, and exaggerated lung inflammation and injury.", annotationSpecies:["10090"], annotationMeshanatomy:["Respiratory System"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:73}, end: {_id:883}, properties:{evidence:"As an example among the many, the loss of ACE2 function in mouse shows the release of pro-inflammatory chemokines, such as C-X-C motif chemokine 5 (CXCL5), macrophage inflammatory protein-2 (MIP2), C-X-C motif chemokine 1 (KC), and TNF-α from airway epithelia, increased neutrophil infiltration, and exaggerated lung inflammation and injury.", annotationSpecies:["10090"], annotationMeshanatomy:["Respiratory System"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1139}, end: {_id:1230}, properties:{evidence:"For wild-type Nsp5, we identified one high-confidence interaction, the epigenetic regulator histone deacetylase 2 (HDAC2), and predicted a cleavage site between the HDAC domain and the nuclear localization sequence, suggesting that Nsp5 may inhibit HDAC2 transport into the nucleus (Extended Data Fig. 7), potentially impacting the published functions of HDAC2 in mediating inflammation and interferon response [38,39].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1278}, end: {_id:1280}, properties:{evidence:"SGs are induced by protein kinase R (PKR)-mediated phosphorylation of eIF2α upon viral dsRNA recognition [57]. Promoting G3BP aggregation via the eIF4A inhibitor Zotatafin [58,59] or reducing SG disassembly by Silmitasertib inhibition of CK2 [60] warrant investigation for treatment of SARS-CoV-2. The mTOR inhibitor rapamycin disrupts the binding of LARP1 to mTORC1 [61] and has been shown to reduce MERS infection by ∼60% in vitro [62], another drug that could be tested for repurposing.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:2664}, end: {_id:92}, properties:{evidence:"One of ATF4’s target genes is the growth arrest and DNA damage- inducible protein 153 (GADD153, also knownas C/EBP homologous protein, or CHOP). GADD153 induces the growth arrest and DNA damage-inducible protein 34 (GADD34), which recruits protein phosphatase 1 (PP1) to dephosphorylate eIF2α and release the translation block.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:134}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro- inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:134}, end: {_id:133}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro- inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:134}, end: {_id:136}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro- inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:157}, end: {_id:2674}, properties:{evidence:"Interestingly, an earlier onset and more significant apoptosis induction in IRE1-knockdown IBV-infected cells was observed, which is associated with hyperphosphorylation of pro-apoptotic kinase JNK and hypophosphorylation of pro-survival kinase RAC-alpha serine/threonine- protein kinase (Akt).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:179}, end: {_id:2672}, properties:{evidence:"Using a recombinant SARS-CoV that lacks the E protein (rSARS-CoV- delE), it is found that both XBP1 splicing and induction of UPR genes significantly increase in the absence of E protein.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:194}, end: {_id:205}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress- induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:92}, end: {_id:194}, properties:{evidence:"The authors thus conclude that global translation shutdown via eIF2α phosphorylation prevents accumulation of ATF6 and activation of ATF6 target genes (Bechill et al., 2008).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:146}, end: {_id:145}, properties:{evidence:"Under various stress conditions, phosphorylation of eIF2α leads to global translation repression and a net decrease in IκBα protein level (Jiang et al., 2003).This then results in the activation of NF-κB and induction of pro-inflammatory response (Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:167}, end: {_id:169}, properties:{evidence:"Apart from the XBP1 pathway, activated IRE1 has been shown to recruit TNF receptor-associated factor 2 (TRAF2) and induce apoptosis by activating the JNK (Urano et al., 2000). This IRE1-JNK pathway is independent of IRE1’s RNase activity, but it requires IRE1’s kinase domain and involves TRAF2-dependent activation of caspase-12 (Yonedaet al.,2001).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:189}, end: {_id:191}, properties:{evidence:"On the other hand, the kinase but not the RNAse activity of IRE1 has been associated with ER-stress-induced NF-kB activation (Tam et al., 2012). Under ER stress, IRE1 has been shown to phosphorylate TRAF2, which activates the IκB kinase (IKK) and contributes to its basal activity (Figure 4). IKK inturn phosphorylates IκBα and promotes its proteasomal degradation, releasing NF-κB to activate downstream genes (Tam et al.,2012).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:194}, end: {_id:204}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress-induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:212}, end: {_id:206}, properties:{evidence:"On the other hand, the accessory protein 8ab of SARS-CoV has been identified to induce ATF6 activation (Sung et al.,2009). ATF6 cleavage and nuclear translocation was observed in cells transfected with SARS-CoV 8ab (Sung et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:656}, end: {_id:658}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain-containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:656}, end: {_id:660}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain-containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:656}, end: {_id:662}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain-containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:656}, end: {_id:663}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain-containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:1250}, end: {_id:1251}, properties:{evidence:"RNF41/Nrdp1, an E3 ubiquitin ligase is targeted by Nsp15 protein which promotes activation of TBK1 and IRF3 and therefore increases type I interferon production [45].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1250}, end: {_id:660}, properties:{evidence:"RNF41/Nrdp1, an E3 ubiquitin ligase is targeted by Nsp15 protein which promotes activation of TBK1 and IRF3 and therefore increases type I interferon production [45].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1505}, end: {_id:1506}, properties:{annotationCellstructure:["Endoplasmic Reticulum", "Golgi Apparatus"], evidence:"The single N501T mutation in SARS-CoV-2's Spike protein may have significantly enhanced its binding affinity for ACE2.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1560}, end: {_id:1564}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:194}, end: {_id:204}, properties:{evidence:"However, recent studies have demonstrated that, under certain circumstances, ATF6-mediated signals may also contribute to ER-stress- induced apoptosis, possibly via activation of CHOP and/or suppression of myeloid cell leukemia sequence 1 (Mcl-1;Gotoh et al., 2002;Nakanishi et al., 2005;Morishima et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:212}, end: {_id:206}, properties:{evidence:"On the other hand, the accessory protein 8ab of SARS-CoV has been identified to induce ATF6 activation (Sung et al.,2009). ATF6 cleavage and nuclear translocation was observed in cells transfected with SARS- CoV 8ab (Sung et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:656}, end: {_id:658}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain- containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:656}, end: {_id:660}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain- containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:656}, end: {_id:662}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain- containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:656}, end: {_id:663}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain- containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:2765}, end: {_id:2766}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:424}, end: {_id:727}, properties:{evidence:"Chloroquine inhibits interleukin-1 beta (IL-1β) mRNA expression in THP-1 cells and reduces IL-1β release [72].", pmid:"32171740", annotationCellline:["THP-1 cell"], citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:731}, properties:{evidence:"Chloroquine-induced inhibition of tumour necrosis factor-alpha (TNFα) production by immune cells was reported to occur either through disruption of cellular iron metabolism [80], blockade of the conversion of pro-TNF into soluble mature TNFα molecules [81] and/or inhibition of TNFα mRNA expression [72,82,83].", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:892}, end: {_id:897}, properties:{evidence:"losartan: ace DOWN", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:844}, end: {_id:895}, properties:{evidence:"ANGII: ace2 DOWN", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:250}, end: {_id:1470}, properties:{evidence:"Interestingly, chloroquine, a recently proposed medication for COVID-19, interacts with poly (I:C) as an endosomal acidification inhibitor, which inhibits poly (I:C)-mediated IFN-β expression.", annotationCell:["naive T cell"], annotationDisease:["Severe acute respiratory syndrome coronavirus 2"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
