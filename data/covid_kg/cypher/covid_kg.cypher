UNWIND [{start: {_id:900}, end: {_id:899}, properties:{evidence:"Interestingly, the results here reported highlight that the treatments with sartans alone, or in combination with ACE inhibitors determine high activity of ACE2, while treatments with ACE inhibitors determine no changes in ACE2 activity.", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:1262}, end: {_id:660}, properties:{evidence:"We also found that Orf9b interacts with a mitochondrial import receptor, Tom70, which acts as an essential adaptor linking MAVS to TBK1/IRF3, resulting in the activation of IRF-3 [51].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1443}, end: {_id:1249}, properties:{evidence:"Another study, demonstrated that IFN-α and -γ co-administration caused hyper-activated IRF-1 and STAT1, which finally led to a more robust antiviral symphony against virus replication.", annotationCell:["naive T cell"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:1443}, end: {_id:1440}, properties:{evidence:"Another study, demonstrated that IFN-α and -γ co-administration caused hyper-activated IRF-1 and STAT1, which finally led to a more robust antiviral symphony against virus replication.", annotationCell:["naive T cell"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:2745}, end: {_id:660}, properties:{evidence:"We also found that Orf9b interacts with a mitochondrial import receptor, Tom70, which acts as an essential adaptor linking MAVS to TBK1/IRF3, resulting in the activation of IRF-3 [51].", citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}] AS row
