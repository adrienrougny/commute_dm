UNWIND [{start: {_id:83}, end: {_id:84}, properties:{evidence:"Also, treatment of α-glucosidase inhibitors, which inhibit the interactions of calnexin with its substrates, dose dependently inhibits the incorporationof S into pseudovirus and suppresses SARS-CoV replication in cell cultures (Fukushi et al., 2012).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:172}, end: {_id:173}, properties:{evidence:"It was found that the kinase domain but not the RNase activity of IRE1 was required, and treatment of a JNK inhibitor (SP600125) abolished autophagosome formation after ER stress (Ogata et al.,2006).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:224}, end: {_id:225}, properties:{evidence:"GS-5734 prevents SARS-CoV and MERS-CoV replication in human airway epithelial cells.", annotationBioassay:["in vitro"], annotationCell:["respiratory epithelial cell"], annotationDisease:["Severe acute respiratory syndrome-related coronavirus", "Middle East respiratory syndrome"], pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:241}, properties:{evidence:"Metrics of labored breathing, such as increased exhalation time and extended pause in between the end of one breath and the beginning of the next, were increased in vehicle-treated animals as compared to those administered with GS-5734 (Fig. 5F).", pmid:"28659436", citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:224}, end: {_id:242}, properties:{evidence:"Therapeutic GS-5734 substantially reduced the SARS-CoV–induced weight loss in infected animals and significantly suppressed virus lung titers (P = 0.0059), thus demonstrating that therapeutic administration of GS-5734 can reduce disease and suppress replication during an ongoing infection.", pmid:"28659436", annotationDisease:["Severe acute respiratory syndrome-related coronavirus"], citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:253}, end: {_id:257}, properties:{evidence:"In addition to LNCaP cells, FQ effectively reduced the viability of all other cancer cell lines tested (prostate cancer cell lines PC3M, C4-2, PC3, DU-145; pancreatic cancer cell lines MiaPaCa2, Panc1; breast cancer cell line MCF7) with IC50 values in a low micromolar range.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:257}, properties:{evidence:"FQ also reduced the viability of immortalized human normal prostate epithelial cells (PNT1A), although these cells tended to be more resistant to FQ treatments compared to most prostate cancer cell lines.", pmid:"29162859", annotationCellline:["PNT1A cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:258}, properties:{evidence:"Flow cytometry analysis revealed that FQ (7 μM, 72 h) reduced the proportion of LNCaP cells in S and G2/M phases of cell cycle, thus inducing proliferative blockade via cell cycle arrest in G0/G1-phase.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:259}, properties:{evidence:"Flow cytometry analysis revealed that FQ (7 μM, 72 h) reduced the proportion of LNCaP cells in S and G2/M phases of cell cycle, thus inducing proliferative blockade via cell cycle arrest in G0/G1-phase.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:260}, properties:{evidence:"Flow cytometry analysis revealed that FQ (7 μM, 72 h) reduced the proportion of LNCaP cells in S and G2/M phases of cell cycle, thus inducing proliferative blockade via cell cycle arrest in G0/G1-phase.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:277}, end: {_id:257}, properties:{evidence:"To determine whether FQ also has a potential to be used as an adjuvant to anticancer chemotherapy, we treated LNCaP cells for 48 h with different chemotherapeutic drugs (cisplatin 5 μM, docetaxel 2.5 nM, doxorubicin 25 nM, paclitaxel 5 nM and phenethyl isothiocyanate (PEITC) 10 μM) alone or in combination with FQ (10 μM). For combination treatments LNCaP cells were first incubated with chemotherapeutic drugs for 12 h and then FQ was added to the medium for the last 36 h. Analysis of cell viability by MTS assay revealed modest but statistically significant reduction in cell viability in the case of combined treatments with FQ and chemotherapy drugs compared to chemotherapy or FQ treatments alone.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:278}, end: {_id:257}, properties:{evidence:"To determine whether FQ also has a potential to be used as an adjuvant to anticancer chemotherapy, we treated LNCaP cells for 48 h with different chemotherapeutic drugs (cisplatin 5 μM, docetaxel 2.5 nM, doxorubicin 25 nM, paclitaxel 5 nM and phenethyl isothiocyanate (PEITC) 10 μM) alone or in combination with FQ (10 μM). For combination treatments LNCaP cells were first incubated with chemotherapeutic drugs for 12 h and then FQ was added to the medium for the last 36 h. Analysis of cell viability by MTS assay revealed modest but statistically significant reduction in cell viability in the case of combined treatments with FQ and chemotherapy drugs compared to chemotherapy or FQ treatments alone.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:279}, end: {_id:257}, properties:{evidence:"To determine whether FQ also has a potential to be used as an adjuvant to anticancer chemotherapy, we treated LNCaP cells for 48 h with different chemotherapeutic drugs (cisplatin 5 μM, docetaxel 2.5 nM, doxorubicin 25 nM, paclitaxel 5 nM and phenethyl isothiocyanate (PEITC) 10 μM) alone or in combination with FQ (10 μM). For combination treatments LNCaP cells were first incubated with chemotherapeutic drugs for 12 h and then FQ was added to the medium for the last 36 h. Analysis of cell viability by MTS assay revealed modest but statistically significant reduction in cell viability in the case of combined treatments with FQ and chemotherapy drugs compared to chemotherapy or FQ treatments alone.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:280}, end: {_id:257}, properties:{evidence:"To determine whether FQ also has a potential to be used as an adjuvant to anticancer chemotherapy, we treated LNCaP cells for 48 h with different chemotherapeutic drugs (cisplatin 5 μM, docetaxel 2.5 nM, doxorubicin 25 nM, paclitaxel 5 nM and phenethyl isothiocyanate (PEITC) 10 μM) alone or in combination with FQ (10 μM). For combination treatments LNCaP cells were first incubated with chemotherapeutic drugs for 12 h and then FQ was added to the medium for the last 36 h. Analysis of cell viability by MTS assay revealed modest but statistically significant reduction in cell viability in the case of combined treatments with FQ and chemotherapy drugs compared to chemotherapy or FQ treatments alone.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:281}, end: {_id:257}, properties:{evidence:"To determine whether FQ also has a potential to be used as an adjuvant to anticancer chemotherapy, we treated LNCaP cells for 48 h with different chemotherapeutic drugs (cisplatin 5 μM, docetaxel 2.5 nM, doxorubicin 25 nM, paclitaxel 5 nM and phenethyl isothiocyanate (PEITC) 10 μM) alone or in combination with FQ (10 μM). For combination treatments LNCaP cells were first incubated with chemotherapeutic drugs for 12 h and then FQ was added to the medium for the last 36 h. Analysis of cell viability by MTS assay revealed modest but statistically significant reduction in cell viability in the case of combined treatments with FQ and chemotherapy drugs compared to chemotherapy or FQ treatments alone.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:288}, properties:{annotationCellstructure:["Mitochondria"], evidence:"This analysis revealed that FQ induced a moderate yet significant decrease in ΔΨ", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:174}, properties:{evidence:"Nevertheless, this result shows that FQ has a clear tendency to inhibit autophagy in vivo.", annotationBioassay:["in vivo"], pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:224}, end: {_id:225}, properties:{evidence:"An RDV dose-dependent reduction in HCoV-229E replication was observed without drug-induced cytotoxicity.", annotationSpecies:["11137"], pmid:"31233808", citationType:"PubMed", citationRef:"31233808"}}, {start: {_id:421}, end: {_id:422}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:423}, end: {_id:422}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}] AS row
