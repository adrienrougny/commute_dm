UNWIND [{start: {_id:95}, end: {_id:93}, properties:{evidence:"PKR is induced by IFN and activated by the binding of double-stranded RNA (dsRNA) after virus infection (Clemens and Elia, 1997). HRI is activated in red blood cells and hepatocytes by low levels of heme (McEwenet al., 2005). GCN2 senses amino acid deficiency and is activated via binding to uncharged transfer RNAs (Sood et al., 2000).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:253}, end: {_id:289}, properties:{evidence:"LC3 immunoblotting analysis demonstrated that FQ induced accumulation of LC3-II protein in LNCaP cells in a dose-dependent manner.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:250}, end: {_id:290}, properties:{evidence:" Immunoblot analysis of another autophagic marker, p62 (which is autophagy substrate protein degraded by autophagy), showed its accumulation in a dose-dependent manner following CQ or FQ treatments indicating that autophagy is inhibited by FQ and autophagy substrates are not degraded ", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:290}, properties:{evidence:" Immunoblot analysis of another autophagic marker, p62 (which is autophagy substrate protein degraded by autophagy), showed its accumulation in a dose-dependent manner following CQ or FQ treatments indicating that autophagy is inhibited by FQ and autophagy substrates are not degraded ", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:289}, properties:{evidence:"Of note, FQ also caused an increase in LC3-II levels in prostate cancer PC3 and PC3M cells but not in DU-145 cells lacking full-length autophagy-related gene 5 (ATG5) (which is essential for LC3 lipidation), suggesting the necessity of the functional autophagic lipidation machinery.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:272}, end: {_id:289}, properties:{evidence:"Bafilomycin A1 (100 nM, 1 h) alone effectively induced accumulation of LC3-II in LNCaP cells.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:320}, end: {_id:188}, properties:{evidence:"Significantly high blood levels of cytokines and chemokines were noted in patients with COVID-19 infection that included IL1-β, IL1RA, IL7, IL8, IL9, IL10, basic FGF2, GCSF, GMCSF, IFNγ, IP10, MCP1, MIP1α, MIP1β, PDGFB, TNFα, and VEGFA. Some of the severe cases that were admitted to the intensive care unit showed high levels of pro-inflammatory cytokines including IL2, IL7, IL10, GCSF, IP10, MCP1, MIP1α, and TNFα that are reasoned to promote disease severity [6].", pmid:"32113704", annotationAnatomy:["blood plasma"], citationType:"PubMed", citationRef:"32113704"}}, {start: {_id:320}, end: {_id:432}, properties:{evidence:"Significantly high blood levels of cytokines and chemokines were noted in patients with COVID-19 infection that included IL1-β, IL1RA, IL7, IL8, IL9, IL10, basic FGF2, GCSF, GMCSF, IFNγ, IP10, MCP1, MIP1α, MIP1β, PDGFB, TNFα, and VEGFA. Some of the severe cases that were admitted to the intensive care unit showed high levels of pro-inflammatory cytokines including IL2, IL7, IL10, GCSF, IP10, MCP1, MIP1α, and TNFα that are reasoned to promote disease severity [6].", pmid:"32113704", annotationAnatomy:["blood plasma"], citationType:"PubMed", citationRef:"32113704"}}, {start: {_id:320}, end: {_id:433}, properties:{evidence:"Significantly high blood levels of cytokines and chemokines were noted in patients with COVID-19 infection that included IL1-β, IL1RA, IL7, IL8, IL9, IL10, basic FGF2, GCSF, GMCSF, IFNγ, IP10, MCP1, MIP1α, MIP1β, PDGFB, TNFα, and VEGFA. Some of the severe cases that were admitted to the intensive care unit showed high levels of pro-inflammatory cytokines including IL2,