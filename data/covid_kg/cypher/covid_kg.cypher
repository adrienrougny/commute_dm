UNWIND [{start: {_id:386}, end: {_id:128}, properties:{evidence:"Likewise, the impaired innate IFN secretion in the elderly is well documented in several studies.", annotationCell:["naive T cell"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:227}, end: {_id:128}, properties:{evidence:"Likewise, the impaired innate IFN secretion in the elderly is well documented in several studies.", annotationCell:["naive T cell"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:228}, end: {_id:128}, properties:{evidence:"Likewise, the impaired innate IFN secretion in the elderly is well documented in several studies.", annotationCell:["naive T cell"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:1459}, end: {_id:1457}, properties:{evidence:"Channappanavar et al. also demonstrated that suboptimal T cell responses occurred in SARS-CoV-infected BALB/c mice.", annotationSpecies:["10090"], annotationCell:["naive T cell"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:1475}, end: {_id:2758}, properties:{evidence:"However, in hyperinflammation, immunosuppression is likely to be beneficial. Re-analysis of data from a phase 3 randomised controlled trial of IL-1 blockade (anakinra) in sepsis, showed significant survival benefit in patients with hyperinflammation, without increased adverse events.[8]", citationType:"DOI", citationRef:"https://doi.org/10.1016/S0140-6736(20)30628-0"}}] AS row
