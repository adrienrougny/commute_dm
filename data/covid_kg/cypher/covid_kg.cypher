UNWIND [{start: {_id:862}, end: {_id:865}, properties:{evidence:"ACE2 may also convert angiotensin I to angiotensin (1–9), which has a prothrombotic activity.", annotationMeshanatomy:["Adrenal Cortex"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:888}, end: {_id:902}, properties:{evidence:"In the case of ARBs (Sartans) and ACE inhibitor treatments, the model reveals that ARBs alone, or in combined treatments, that confer an increased ACE2 activity on the cell membranes, results in higher risk for viral infection.", annotationDisease:["Severe acute respiratory syndrome coronavirus 2"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:320}, end: {_id:386}, properties:{evidence:"As of March 17th, 2020, the COVID-19 disease, caused by the SARS-CoV-2 virus (a.k.a 2019-nCoV), has become a pandemic with 179,111 confirmed cases and 7,426 deaths in more than 100 countries.", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:320}, end: {_id:386}, properties:{evidence:"The recent outbreak of coronavirus disease 2019 (COVID-19) caused by SARS-CoV-2 in China has been the cause of major concern for the global community as the number of people infected with the virus has been continuously increasing with a significant geographical spread.", citationType:"chemrxiv", citationRef:"https://doi.org/10.26434/chemrxiv.11860011.v2"}}, {start: {_id:320}, end: {_id:1445}, properties:{evidence:"They mainly cause respiratory disease and common cold, but can also cause central nervous system (CNS) infection.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:320}, end: {_id:386}, properties:{evidence:"COVID-19 is caused by a novel coronavirus species, named SARS-CoV-2.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:320}, end: {_id:386}, properties:{evidence:"The coronavirus disease 19 (COVID-19) is a highly transmittable and pathogenic viral infection caused by severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2), which emerged in Wuhan, China and spread around the world", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:234}, end: {_id:1491}, properties:{evidence:"The severe acute respiratory syndrome coronavirus (SARS-CoV), H5N1 influenza A, H1N1 2009 and Middle East respiratory syndrome coronavirus (MERS-CoV) cause acute lung injury (ALI) and acute respiratory distress syndrome (ARDS) which leads to pulmonary failure and result in fatality.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:1491}, properties:{evidence:"The severe acute respiratory syndrome coronavirus (SARS-CoV), H5N1 influenza A, H1N1 2009 and Middle East respiratory syndrome coronavirus (MERS-CoV) cause acute lung injury (ALI) and acute respiratory distress syndrome (ARDS) which leads to pulmonary failure and result in fatality.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:234}, end: {_id:236}, properties:{evidence:"The severe acute respiratory syndrome coronavirus (SARS-CoV), H5N1 influenza A, H1N1 2009 and Middle East respiratory syndrome coronavirus (MERS-CoV) cause acute lung injury (ALI) and acute respiratory distress syndrome (ARDS) which leads to pulmonary failure and result in fatality.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:236}, properties:{evidence:"The severe acute respiratory syndrome coronavirus (SARS-CoV), H5N1 influenza A, H1N1 2009 and Middle East respiratory syndrome coronavirus (MERS-CoV) cause acute lung injury (ALI) and acute respiratory distress syndrome (ARDS) which leads to pulmonary failure and result in fatality.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:234}, end: {_id:515}, properties:{evidence:"The severe acute respiratory syndrome coronavirus (SARS-CoV), H5N1 influenza A, H1N1 2009 and Middle East respiratory syndrome coronavirus (MERS-CoV) cause acute lung injury (ALI) and acute respiratory distress syndrome (ARDS) which leads to pulmonary failure and result in fatality.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:515}, properties:{evidence:"The severe acute respiratory syndrome coronavirus (SARS-CoV), H5N1 influenza A, H1N1 2009 and Middle East respiratory syndrome coronavirus (MERS-CoV) cause acute lung injury (ALI) and acute respiratory distress syndrome (ARDS) which leads to pulmonary failure and result in fatality.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:234}, end: {_id:227}, properties:{evidence:"In 2003, the Chinese population was infected with a virus causing Severe Acute Respiratory Syndrome (SARS) in Guangdong province. The virus was confirmed as a member of the Betacoronavirus subgroup and was named SARS-CoV.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:234}, end: {_id:311}, properties:{evidence:"The infected patients exhibited pneumonia symptoms with a diffused alveolar injury which lead to acute respiratory distress syndrome (ARDS).", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:383}, properties:{evidence:"The infection of MERSCoV initiates from a mild upper respiratory injury while progression leads to severe respiratory disease.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:311}, properties:{evidence:"Similar to SARScoronavirus, patients infected with MERS-coronavirus suffer pneumonia, followed by ARDS and renal failure.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:516}, properties:{evidence:"Similar to SARScoronavirus, patients infected with MERS-coronavirus suffer pneumonia, followed by ARDS and renal failure.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:234}, end: {_id:563}, properties:{evidence:"SARS-CoV Sign and symptoms fever, malaise, myalgia, headache, diarrhoea, shivering, cough and shortness of breath.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:234}, end: {_id:1496}, properties:{evidence:"SARS-CoV Sign and symptoms fever, malaise, myalgia, headache, diarrhoea, shivering, cough and shortness of breath.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}] AS row
