UNWIND [{start: {_id:310}, end: {_id:217}, properties:{evidence:"Sequence analysis shows that the 2019‐nCoV possesses a typical genome structure of CoV and belongs to the cluster of betacoronaviruses that includes Bat‐SARS‐like (SL)‐ZC45, Bat‐SL ZXC21, SARS‐CoV, and MERS‐CoV.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:297}, end: {_id:336}, properties:{evidence:"Before 2019, there were only six CoVs that were known to infect human and cause respiratory diseases. HCoV‐229E, HCoV‐OC43, HCoV‐NL63, and HKU1 cause only mild upper respiratory disease, and in rare cases some of them can cause severe infection in infants, young children and elders.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:296}, end: {_id:336}, properties:{evidence:"Before 2019, there were only six CoVs that were known to infect human and cause respiratory diseases. HCoV‐229E, HCoV‐OC43, HCoV‐NL63, and HKU1 cause only mild upper respiratory disease, and in rare cases some of them can cause severe infection in infants, young children and elders.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:232}, end: {_id:336}, properties:{evidence:"Before 2019, there were only six CoVs that were known to infect human and cause respiratory diseases. HCoV‐229E, HCoV‐OC43, HCoV‐NL63, and HKU1 cause only mild upper respiratory disease, and in rare cases some of them can cause severe infection in infants, young children and elders.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:302}, end: {_id:336}, properties:{evidence:"Before 2019, there were only six CoVs that were known to infect human and cause respiratory diseases. HCoV‐229E, HCoV‐OC43, HCoV‐NL63, and HKU1 cause only mild upper respiratory disease, and in rare cases some of them can cause severe infection in infants, young children and elders.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:234}, end: {_id:336}, properties:{evidence:"SARS‐CoV and MERS‐CoV can infect lower respiratory tract and cause severe respiratory syndrome in human.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:310}, end: {_id:336}, properties:{evidence:"SARS‐CoV and MERS‐CoV can infect lower respiratory tract and cause severe respiratory syndrome in human.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:390}, end: {_id:216}, properties:{evidence:"Virus PRCV/ISU‐1, Genus Alpha, Host Pig, Symptoms Mild respiratory tract infections.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:392}, end: {_id:216}, properties:{evidence:"Virus Camel alphacoronavirus isolate camel/Riyadh, Genus Alpha, Host Camel, Symptoms Asymptomatic.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:393}, end: {_id:217}, properties:{evidence:"Virus MHV‐A59, Genus Beta, Host Mouse, Symptoms Acute pneumonia and severe lung injuries.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:396}, end: {_id:219}, properties:{evidence:"Virus Beluga Whale CoV/SW1, Genus Gamma, Host Whale, Symptoms Pulmonary disease, terminal acute liver failure.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:398}, end: {_id:219}, properties:{evidence:"Virus IBV, Genus Gamma, Host Chicken, Symptoms Severe respiratory disease.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:399}, end: {_id:218}, properties:{evidence:"Virus Bulbul coronavirus HKU11, Genus Delta, Host Bulbul, Symptoms Respiratory disease (collected from respiratory tract of dead wild birds).", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:400}, end: {_id:218}, properties:{evidence:"Virus Sparrow coronavirus HKU17, Genus Delta, Host Sparrow, Symptoms Respiratory disease (collected from respiratory tract of dead wild birds).", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:449}, end: {_id:450}, properties:{evidence:"IFN-α is a broad-spectrum antiviral that is usually used  to  treat  hepatitis,  though  it  is  reported  to  inhibit  SARS-CoV reproduction in vitro (4).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:424}, end: {_id:458}, properties:{evidence:"Chloroquine  is  a  widely used antimalarial that was found to be a potential broad-spectrum  antiviral  in  2006  (7).  Chloroquine  was  found  to  block  SARS-CoV-2  infection  at  low-micromolar concentration, with a half-maximal effective concentration  (EC50) of 1.13 μM and a half-cytotoxic concentration  (CC50) greater than 100 μM (8).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:420}, end: {_id:450}, properties:{evidence:"Arbidol  is  an  antiviral  that  can  be  used  to  treat  influenza  virus.  A  study  has  revealed  that  arbidol  can  effectively  inhibit  SARS-CoV-2 infection at a concentration of 10-30 μM in vitro (9).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:224}, end: {_id:450}, properties:{evidence:"Remdesivir  is  a  nucleoside  analogue  and  a  broad-spectrum  antiviral.  Animal  experiments  (13)  indicated  that  remdesivir  can  effectively  reduce  the  viral load in lung tissue of mice infected with MERS-CoV,  improve  lung  function,  and  alleviate  pathological  damage to lung tissue.", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:477}, end: {_id:478}, properties:{evidence:"Studies  have  also  revealed  some  other  drugs  may  have  potential  efficacy  in  treating  COVID-19.  One  is  darunavir,  which  is  a  second-generation  of  HIV-1  protease  inhibitor.  On  February  4,  2020,  researchers  in  China  announced  that  darunavir  inhibited  SARS-CoV-2  infection in  vitro  (9).  Cell  experiments  indicated  that  darunavir  significantly  inhibited  viral  replication  at  a  concentration of 300 μM in  vitro  and  that  its  inhibition  efficiency  was  280-fold  that  in  the  untreated  group  (9).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:320}, end: {_id:300}, properties:{evidence:"Coronaviruses are members of the subfamily “Coronavirinae” (family; Coronaviridae, order; Nidovirales) that contains four genera alpha-coronavirus, beta-coronavirus, gamma-coronavirus and delta-coronavirus", pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:IS_A]->(end) SET r += row.properties;
