UNWIND [{start: {_id:85}, end: {_id:157}, properties:{evidence:"Taken together,IRE1 may modulate IBV-induced apoptosis and serve as a survival factor during coronavirus infection.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:407}, end: {_id:778}, properties:{evidence:"The enrolled patients showed increase in alanine aminotransferase (23 [33%] of 69 patients) and aspartate aminotransferase (19 [28%] of 69 patients), most of which count less than 100 U/L.", pmid:"32176772", citationType:"PubMed", citationRef:"32176772"}}, {start: {_id:407}, end: {_id:779}, properties:{evidence:"The enrolled patients showed increase in alanine aminotransferase (23 [33%] of 69 patients) and aspartate aminotransferase (19 [28%] of 69 patients), most of which count less than 100 U/L.", pmid:"32176772", citationType:"PubMed", citationRef:"32176772"}}, {start: {_id:407}, end: {_id:780}, properties:{evidence:"In terms of inflammation indicators, patients on  admission showed increase in lactate dehydrogenase (25 [41%] of 61 patients), c reactive protein (42 [67%] of 63 patients), and erythrocyte sedimentation rate (30 [52%] of 58 patients), but not procalcitonin. ", pmid:"32176772", citationType:"PubMed", citationRef:"32176772"}}, {start: {_id:407}, end: {_id:568}, properties:{evidence:"In terms of inflammation indicators, patients on  admission showed increase in lactate dehydrogenase (25 [41%] of 61 patients), c reactive protein (42 [67%] of 63 patients), and erythrocyte sedimentation rate (30 [52%] of 58 patients), but not procalcitonin. ", pmid:"32176772", citationType:"PubMed", citationRef:"32176772"}}, {start: {_id:386}, end: {_id:1543}, properties:{evidence:"Among them, interferon α-inducible protein 27 (IFI27), originally known to involve in innate immunity and to intervene in cell proliferation, was increasingly expressed in many cell types, including CD1C+_B dendritic cells, CD1C-CD141- dendritic cells, CD141+CLEC9A+ dendritic cells, CD8 cytotoxic T cells, and plasmacytoid dendritic cells.", annotationCell:["CD8-positive, alpha-beta cytotoxic T cell", "plasmacytoid dendritic cell"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1545}, properties:{evidence:"Second, the expressions of IFITM1, IFITM3, and IFI6, which were shown to be related to interferon-related pathway and associated with Influenza and West Nile Virus, were strikingly up-regulated in all of these cells.", annotationCell:["CD8-positive, alpha-beta cytotoxic T cell", "plasmacytoid dendritic cell"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1547}, properties:{evidence:"Second, the expressions of IFITM1, IFITM3, and IFI6, which were shown to be related to interferon-related pathway and associated with Influenza and West Nile Virus, were strikingly up-regulated in all of these cells.", annotationCell:["CD8-positive, alpha-beta cytotoxic T cell", "plasmacytoid dendritic cell"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1548}, properties:{evidence:"Second, the expressions of IFITM1, IFITM3, and IFI6, which were shown to be related to interferon-related pathway and associated with Influenza and West Nile Virus, were strikingly up-regulated in all of these cells.", annotationCell:["CD8-positive, alpha-beta cytotoxic T cell", "plasmacytoid dendritic cell"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1550}, properties:{evidence:"Then, in the downstream of the interferon signaling, we found that MAPK signaling pathway transcription factors were activated in hospitalized patients with COVID-19, including high expressions of FOS, JUN, JUNB, and DUSP1.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1551}, properties:{evidence:"Then, in the downstream of the interferon signaling, we found that MAPK signaling pathway transcription factors were activated in hospitalized patients with COVID-19, including high expressions of FOS, JUN, JUNB, and DUSP1.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1552}, properties:{evidence:"Then, in the downstream of the interferon signaling, we found that MAPK signaling pathway transcription factors were activated in hospitalized patients with COVID-19, including high expressions of FOS, JUN, JUNB, and DUSP1.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:149}, properties:{evidence:"Then, in the downstream of the interferon signaling, we found that MAPK signaling pathway transcription factors were activated in hospitalized patients with COVID-19, including high expressions of FOS, JUN, JUNB, and DUSP1.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1550}, properties:{evidence:"In three groups of inpatients with different conditions, the up-regulated expression of these genes was observed in CD1C+_B dendritic cell, CD1C-CD141- dendritic cell, CD141+CLEC9A+ dendritic cell, CD8 cytotoxic T cells, and plasmacytoid dendritic cells.", annotationCell:["CD8-positive, alpha-beta cytotoxic T cell", "plasmacytoid dendritic cell"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1551}, properties:{evidence:"In three groups of inpatients with different conditions, the up-regulated expression of these genes was observed in CD1C+_B dendritic cell, CD1C-CD141- dendritic cell, CD141+CLEC9A+ dendritic cell, CD8 cytotoxic T cells, and plasmacytoid dendritic cells.", annotationCell:["CD8-positive, alpha-beta cytotoxic T cell", "plasmacytoid dendritic cell"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1552}, properties:{evidence:"In three groups of inpatients with different conditions, the up-regulated expression of these genes was observed in CD1C+_B dendritic cell, CD1C-CD141- dendritic cell, CD141+CLEC9A+ dendritic cell, CD8 cytotoxic T cells, and plasmacytoid dendritic cells.", annotationCell:["CD8-positive, alpha-beta cytotoxic T cell", "plasmacytoid dendritic cell"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:149}, properties:{evidence:"In three groups of inpatients with different conditions, the up-regulated expression of these genes was observed in CD1C+_B dendritic cell, CD1C-CD141- dendritic cell, CD141+CLEC9A+ dendritic cell, CD8 cytotoxic T cells, and plasmacytoid dendritic cells.", annotationCell:["CD8-positive, alpha-beta cytotoxic T cell", "plasmacytoid dendritic cell"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1545}, properties:{evidence:"IFI27, an immune biomarker which was reported to be related to cell proliferation and invasion and could discriminate between influenza and bacteria in patients with suspected respiratory infection, showed the most strongest up-regulation in COVID-2019 patients’ PBMCs in the interferon signaling pathway in the single cell transcriptome data.", annotationCell:["peripheral blood mononuclear cell"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1556}, properties:{evidence:"BST2, which was previously shown to play a role in pre-B-cell growth, also showed upexpression in COVID-19 patients.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1543}, properties:{evidence:"Immunofluorescence staining showed that IFI27 was highly expressed in the whole lymphocyte of patients with COVID-19, but only partially expressed on the lymphocyte of the controls.", annotationCell:["lymphocyte"], citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}] AS row
