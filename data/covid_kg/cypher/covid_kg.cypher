UNWIND [{start: {_id:449}, end: {_id:451}, properties:{evidence:"IFN-α is a broad-spectrum antiviral that is usually used  to  treat  hepatitis,  though  it  is  reported  to  inhibit  SARS-CoV reproduction in vitro (4).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:420}, end: {_id:460}, properties:{evidence:"Arbidol  is  an  antiviral  that  can  be  used  to  treat  influenza  virus.  A  study  has  revealed  that  arbidol  can  effectively  inhibit  SARS-CoV-2 infection at a concentration of 10-30 μM in vitro (9).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:461}, end: {_id:464}, properties:{evidence:"Favipiravir is a new type of RNA-dependent RNA polymerase (RdRp) inhibitor. In addition to its anti-influenza  virus  activity,  favipiravir  is  capable  of  blocking  the  replication  of  flavi-,  alpha-,  filo-,  bunya-,  arena-, noro-, and other RNA viruses (10).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:461}, end: {_id:465}, properties:{evidence:"Favipiravir is a new type of RNA-dependent RNA polymerase (RdRp) inhibitor. In addition to its anti-influenza  virus  activity,  favipiravir  is  capable  of  blocking  the  replication  of  flavi-,  alpha-,  filo-,  bunya-,  arena-, noro-, and other RNA viruses (10).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:461}, end: {_id:466}, properties:{evidence:"Favipiravir is a new type of RNA-dependent RNA polymerase (RdRp) inhibitor. In addition to its anti-influenza  virus  activity,  favipiravir  is  capable  of  blocking  the  replication  of  flavi-,  alpha-,  filo-,  bunya-,  arena-, noro-, and other RNA viruses (10).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:461}, end: {_id:467}, properties:{evidence:"Favipiravir is a new type of RNA-dependent RNA polymerase (RdRp) inhibitor. In addition to its anti-influenza  virus  activity,  favipi