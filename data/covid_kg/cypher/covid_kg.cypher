UNWIND [{start: {_id:418}, end: {_id:407}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:419}, end: {_id:407}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:420}, end: {_id:407}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:421}, end: {_id:407}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:423}, end: {_id:407}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:456}, end: {_id:430}, properties:{evidence:"Ribavirin  is  a  nucleoside  analogue  with  a  broad-spectrum  of  antiviral  effects.  A  study  compared  111  patients  with  severe  acute  respiratory  syndrome  (SARS)  treated  with  ribavirin  monotherapy  and  41  patients  with  SARS  treated  with  lopinavir/ritonavir and ribavirin; patients treated with the combined therapy  had  a  lower  risk  of  acute  respiratory  distress  syndrome  (ARDS)  and  death  (6).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:456}, end: {_id:429}, properties:{evidence:"Ribavirin  is  a  nucleoside  analogue  with  a  broad-spectrum  of  antiviral  effects.  A  study  compared  111  patients  with  severe  acute  respiratory  syndrome  (SARS)  treated  with  ribavirin  monotherapy  and  41  patients  with  SARS  treated  with  lopinavir/ritonavir and ribavirin; patients treated with the combined therapy  had  a  lower  risk  of  acute  respiratory  distress  syndrome  (ARDS)  and  death  (6).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:224}, end: {_id:473}, properties:{evidence:"Remdesivir  is  a  nucleoside  analogue  and  a  broad-spectrum  antiviral.  Animal  experiments  (13)  indicated  that  remdesivir  can  effectively  reduce  the  viral load in lung tissue of mice infected with MERS-CoV,  improve  lung  function,  and  alleviate  pathological  damage to lung tissue.", annotationSpecies:["10090"], annotationMeshanatomy:["Lung"], pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:224}, end: {_id:386}, properties:{evidence:"Remdesivir and chloroquine were found highly effective in vitro for the control of 2019-nCoV infection ", annotationSpecies:["9606"], annotationBioassay:["in vitro"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:250}, end: {_id:386}, properties:{evidence:"Remdesivir and chloroquine were found highly effective in vitro for the control of 2019-nCoV infection ", annotationSpecies:["9606"], annotationBioassay:["in vitro"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:528}, end: {_id:386}, properties:{evidence:"Inhibitors of endosomal cysteine protease and transmembrane protease serine 2 can partially block viral entry into the cell", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:529}, end: {_id:386}, properties:{evidence:"Inhibitors of endosomal cysteine protease and transmembrane protease serine 2 can partially block viral entry into the cell", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:530}, end: {_id:386}, properties:{evidence:"On the other hand thiopurine compounds, naphthalene inhibitors, protease inhibitors, zinc,and mercury conjugates target 3CLpro (3C-like protease) and PLpro (papain-like protease) enzymes in coronaviruses and can block the pathogenicity of coronaviruses. Therefore,combinational therapy of these antiviral agents with DRACO may enhance the overall impact on the recovery of patients", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:532}, end: {_id:386}, properties:{evidence:"On the other hand thiopurine compounds, naphthalene inhibitors, protease inhibitors, zinc,and mercury conjugates target 3CLpro (3C-like protease) and PLpro (papain-like protease) enzymes in coronaviruses and can block the pathogenicity of coronaviruses. Therefore,combinational therapy of these antiviral agents with DRACO may enhance the overall impact on the recovery of patients", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:314}, end: {_id:386}, properties:{evidence:"On the other hand thiopurine compounds, naphthalene inhibitors, protease inhibitors, zinc,and mercury conjugates target 3CLpro (3C-like protease) and PLpro (papain-like protease) enzymes in coronaviruses and can block the pathogenicity of coronaviruses. Therefore,combinational therapy of these antiviral agents with DRACO may enhance the overall impact on the recovery of patients", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:534}, end: {_id:386}, properties:{evidence:"This response can be augmented by the utilization of interferon inducers or recombinant interferons ", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:406}, end: {_id:227}, properties:{evidence:"Live-attenuated vaccines, designed for SARS, maybe evaluated for SARS-CoV-2 infected patients.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:406}, end: {_id:386}, properties:{evidence:"Live-attenuated vaccines, designed for SARS, maybe evaluated for SARS-CoV-2 infected patients.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:551}, end: {_id:386}, properties:{evidence:"Lopinavir It targets 3CLpro enzyme to inhibit its activity. Effective against wide range of viruses including SARS-CoV and MERS-CoV, thus could be suitable choice for treatment of SARS-CoV-2 infection.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:551}, end: {_id:227}, properties:{evidence:"Lopinavir It targets 3CLpro enzyme to inhibit its activity. Effective against wide range of viruses including SARS-CoV and MERS-CoV, thus could be suitable choice for treatment of SARS-CoV-2 infection.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:551}, end: {_id:228}, properties:{evidence:"Lopinavir It targets 3CLpro enzyme to inhibit its activity. Effective against wide range of viruses including SARS-CoV and MERS-CoV, thus could be suitable choice for treatment of SARS-CoV-2 infection.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:224}, end: {_id:386}, properties:{evidence:"Remdesivir It terminates transcription of the viral RNA transcription at premature level. Effective against wide range of viruses including SARS-CoV and MERS-CoV, thus could be suitable choice for treatment of SARS-CoV-2infection.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:224}, end: {_id:227}, properties:{evidence:"Remdesivir It terminates transcription of the viral RNA transcription at premature level. Effective against wide range of viruses including SARS-CoV and MERS-CoV, thus could be suitable choice for treatment of SARS-CoV-2infection.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:224}, end: {_id:228}, properties:{evidence:"Remdesivir It terminates transcription of the viral RNA transcription at premature level. Effective against wide range of viruses including SARS-CoV and MERS-CoV, thus could be suitable choice for treatment of SARS-CoV-2infection.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:333}, end: {_id:227}, properties:{evidence:"Ribavirin It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. Effective against wide range of viruses including MERS-CoV and SARS-CoV but high doses are required which may have severe side effects. It may be reevaluated for SARS-CoV-2and recommended if low doses are found effective.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:333}, end: {_id:228}, properties:{evidence:"Ribavirin It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. Effective against wide range of viruses including MERS-CoV and SARS-CoV but high doses are required which may have severe side effects. It may be reevaluated for SARS-CoV-2and recommended if low doses are found effective.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:333}, end: {_id:386}, properties:{evidence:"Ribavirin It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. Effective against wide range of viruses including MERS-CoV and SARS-CoV but high doses are required which may have severe side effects. It may be reevaluated for SARS-CoV-2and recommended if low doses are found effective.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:555}, end: {_id:227}, properties:{evidence:"Bcx4430 It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. It isbroad-spectrum and effective against SARS-CoV and MERS-CoV, thus may be effective against SARS-CoV-2 however, evaluation using animals’ models is required.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:555}, end: {_id:228}, properties:{evidence:"Bcx4430 It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. It isbroad-spectrum and effective against SARS-CoV and MERS-CoV, thus may be effective against SARS-CoV-2 however, evaluation using animals’ models is required.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:555}, end: {_id:386}, properties:{evidence:"Bcx4430 It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. It isbroad-spectrum and effective against SARS-CoV and MERS-CoV, thus may be effective against SARS-CoV-2 however, evaluation using animals’ models is required.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:556}, end: {_id:227}, properties:{evidence:"Griffithsin It targets Oligosaccharides on S to block viral binding with host cell. It has been found effective against SARS/MERS-CoV and other high pathogenic viruses, thus can be used against SARS-CoV-2", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:556}, end: {_id:228}, properties:{evidence:"Griffithsin It targets Oligosaccharides on S to block viral binding with host cell. It has been found effective against SARS/MERS-CoV and other high pathogenic viruses, thus can be used against SARS-CoV-2", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:556}, end: {_id:386}, properties:{evidence:"Griffithsin It targets Oligosaccharides on S to block viral binding with host cell. It has been found effective against SARS/MERS-CoV and other high pathogenic viruses, thus can be used against SARS-CoV-2", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:557}, end: {_id:386}, properties:{evidence:"Hexamethylene Amiloride It targets viral envelope to inhibit ion channel activity. It is effective against different coronaviruses thus a one of the most suitable treatment options for SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:558}, end: {_id:386}, properties:{evidence:"Nitazoxanide These induce the innate interferon responses against viral pathogens. Inducing immuneresponses through recombinant interferons has been found effective against a wide range of viruses and may be promising to use against SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:559}, end: {_id:386}, properties:{evidence:"Cyclosporine, Alisporivir It inhibits cyclophilin to affect calcineurin–NFAT pathway. These agents can inhibit broad-spectrum viruses specifically coronaviruses and thus could be suitable option to treat people infected with SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:560}, end: {_id:227}, properties:{evidence:"Rapamycin It inhibits kinase signaling associated pathways to block viral entry. It is effective against SARS/MERS-CoV and possibly be effective against SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:560}, end: {_id:228}, properties:{evidence:"Rapamycin It inhibits kinase signaling associated pathways to block viral entry. It is effective against SARS/MERS-CoV and possibly be effective against SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:560}, end: {_id:386}, properties:{evidence:"Rapamycin It inhibits kinase signaling associated pathways to block viral entry. It is effective against SARS/MERS-CoV and possibly be effective against SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:561}, end: {_id:227}, properties:{evidence:"Imatinib It inhibits kinase signaling associated pathways to block viral entry. It is effective against SARS/MERS-CoV and possibly be effective against SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}] AS row
