UNWIND [{start: {_id:46}, end: {_id:47}, properties:{evidence:"The virions budded into the ERGIC are exported through secretory pathway in smooth-wall vesicles, which ultimately fuse with the plasma membrane and release the mature virus particles (Krijnse-Locker et al., 1994).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:253}, end: {_id:255}, properties:{evidence:"Analysis by light microscopy revealed significant morphological alterations as well as pronounced death of the lymph node carcinoma of the prostate (LNCaP) cells following treatment with FQ.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:265}, properties:{evidence:"Overall, our results confirmed, that FQ as a monotherapy effectively provokes proliferative arrest and cancer cell death in vitro.", annotationBioassay:["in vitro"], pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:253}, end: {_id:255}, properties:{evidence:"Overall, our results confirmed, that FQ as a monotherapy effectively provokes proliferative arrest and cancer cell death in vitro.", annotationBioassay:["in vitro"], pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:424}, end: {_id:700}, properties:{evidence:"Due to the alkalisation of endosomes, chloroquine was an effective in vitro treatment against Chikungunya virus when added to Vero cells prior to virus exposure [30].", annotationMeshanatomy:["Endosomes"], pmid:"32171740", annotationCellline:["Vero cell"], citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:647}, properties:{evidence:"Beside affecting the virus maturation process, pH modulation by chloroquine can impair the proper maturation of viral protein [32] and the recognition of viral antigen by dendritic cells, which occurs through a Toll-like receptor-dependent pathway that requires endosomal acidification [69].", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:721}, end: {_id:722}, properties:{evidence:"On the contrary, other proposed effects of chloroquine on the immune system include increasing the export of soluble antigens into the cytosol of dendritic cells and the enhancement of human cytotoxic CD8+ T-cell responses against viral antigens [70].", annotationMeshanatomy:["Dendritic Cells"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:744}, end: {_id:745}, properties:{evidence:"However, corticosteroid therapy could be associated with delayed MERS-CoV RNA clearance (adjusted hazard ratio, 0.35; 95% CI, 0.17–0.72; p = 0.005) for critically ill patients with MERS,[40] and early corticosteroid treatment could be associated with higher subsequent plasma RNA load of SARS-CoV for adults with SARS.[41] Moreover, corticosteroid-associated psychosis and diabetes were observed in the treatment of SARS.[42,43].", pmid:"32173241", citationType:"PubMed", citationRef:"32173241"}}, {start: {_id:854}, end: {_id:856}, properties:{evidence:"ANGII also stimulates the release of aldosterone from the adrenal cortex in the kidney to promote sodium retention.", annotationMeshanatomy:["Adrenal Cortex"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:250}, end: {_id:937}, properties:{evidence:"Chloroquine : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:939}, end: {_id:937}, properties:{evidence:"Corticosteroids : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:940}, end: {_id:937}, properties:{evidence:"Emtricitabine : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:941}, end: {_id:937}, properties:{evidence:"Tenofovir : UPR/autophagy modulator", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}},