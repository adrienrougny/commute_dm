UNWIND [{start: {_id:110}, end: {_id:135}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro-inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:157}, end: {_id:113}, properties:{evidence:"Interestingly, an earlier onset and more significant apoptosis induction in IRE1-knockdown IBV-infected cells was observed, which is associated with hyperphosphorylation of pro-apoptotic kinase JNK and hypophosphorylation of pro-survival kinase RAC-alpha serine/threonine-protein kinase (Akt).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:135}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro- inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:157}, end: {_id:113}, properties:{evidence:"Interestingly, an earlier onset and more significant apoptosis induction in IRE1-knockdown IBV-infected cells was observed, which is associated with hyperphosphorylation of pro-apoptotic kinase JNK and hypophosphorylation of pro-survival kinase RAC-alpha serine/threonine- protein kinase (Akt).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}] AS row
