UNWIND [{start: {_id:346}, end: {_id:365}, properties:{evidence:"These polypeptides are processed by virally encoded chymotrypsin‐like protease (3CLpro) or main protease (Mpro) and one or two papain‐like protease into 16 nsps.", pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:318}, end: {_id:378}, properties:{evidence:"nsp12 function: Primer dependent RdRp.", annotationSpecies:["2697049"], pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:358}, end: {_id:379}, properties:{evidence:"nsp13 function: RNA helicase, 5′ triphosphatase.", annotationSpecies:["2697049"], pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:360}, end: {_id:380}, properties:{evidence:"nsp14 function: Exoribonuclease, N7‐MTase.", annotationSpecies:["2697049"], pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:376}, end: {_id:381}, properties:{evidence:"nsp16 function: 2′‐O‐MTase; avoiding MDA5 recognition,negatively regulating innate immunity.", annotationSpecies:["2697049"], pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:524}, end: {_id:525}, properties:{evidence:"FURIN (a serine endoprotease) cleaves off S1/S2, thus,could be a suitable antiviral agent.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:229}, end: {_id:792}, properties:{evidence:"Specifically, four main structural proteins have been recognized which are: spike (S), envelope (E), nucleocapsid (N) and membrane (M) proteins.", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:667}, end: {_id:795}, properties:{evidence:"It was demonstrated that also SARS-CoV2, as well as SARS-CoV, use endosomal cysteine proteases cathepsin B and L (CatB/L) and the transmembrane serine protease TMPRSS2 for S protein priming in cell lines, a step required for viral entry into the cell.", annotationDisease:["Severe acute respiratory syndrome-related coronavirus", "Severe acute respiratory syndrome coronavirus 2"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:789}, end: {_id:795}, properties:{evidence:"It was demonstrated that also SARS-CoV2, as well as SARS-CoV, use endosomal cysteine proteases cathepsin B and L (CatB/L) and the transmembrane serine protease TMPRSS2 for S protein priming in cell lines, a step required for viral entry into the cell.", annotationDisease:["Severe acute respiratory syndrome-related coronavirus", "Severe acute respiratory syndrome coronavirus 2"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:480}, end: {_id:796}, properties:{evidence:"It was demonstrated that also SARS-CoV2, as well as SARS-CoV, use endosomal cysteine proteases cathepsin B and L (CatB/L) and the transmembrane serine protease TMPRSS2 for S protein priming in cell lines, a step required for viral entry into the cell.", annotationDisease:["Severe acute respiratory syndrome-related coronavirus", "Severe acute respiratory syndrome coronavirus 2"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:910}, end: {_id:913}, properties:{evidence:"For example, recent work showed that the MERS-CoV virus induces reduced levels of the Beclin1 (BECN1) protein, which blocks the fusion of autophagosomes and lysosomes and the inhibition of the S-phase kinase-associated protein 2 (SKP2), an E3 ubiquitin ligase which promotes BECN1 degradation, enhances autophagy and reduces the replication of MERS-CoV up to 28,000-fold.", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:346}, end: {_id:795}, properties:{evidence:"It encodes for two large polyproteins that are further processed by virally encoded cysteine proteases, namely, the papain-like protease (PLpro) and the 3-chymotrypsin-like protease (3CLpro, also known as the main protease-Mpro).", citationType:"chemrxiv", citationRef:"https://doi.org/10.26434/chemrxiv.11860011.v2"}}, {start: {_id:342}, end: {_id:795}, properties:{evidence:"It encodes for two large polyproteins that are further processed by virally encoded cysteine proteases, namely, the papain-like protease (PLpro) and the 3-chymotrypsin-like protease (3CLpro, also known as the main protease-Mpro).", citationType:"chemrxiv", citationRef:"https://doi.org/10.26434/chemrxiv.11860011.v2"}}, {start: {_id:342}, end: {_id:1399}, properties:{evidence:" Apart from proteolytic processing, PLpro also has a deubiquitinase and deISGylating activity.", citationType:"chemrxiv", citationRef:"https://doi.org/10.26434/chemrxiv.11860011.v2"}}] AS row
