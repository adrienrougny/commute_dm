MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:449}, end: {_id:118}, properties:{evidence:"IFN-α is a broad-spectrum antiviral that is usually used  to  treat  hepatitis,  though  it  is  reported  to  inhibit  SARS-CoV reproduction in vitro (4).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:477}, end: {_id:225}, properties:{evidence:"Studies  have  also  revealed  some  other  drugs  may  have  potential  efficacy  in  treating  COVID-19.  One  is  darunavir,  which  is  a  second-generation  of  HIV-1  protease  inhibitor.  On  February  4,  2020,  researchers  in  China  announced  that  darunavir  inhibited  SARS-CoV-2  infection in  vitro  (9).  Cell  experiments  indicated  that  darunavir  significantly  inhibited  viral  replication  at  a  concentration of 300 μM in  vitro  and  that  its  inhibition  efficiency  was  280-fold  that  in  the  untreated  group  (9).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:479}, end: {_id:482}, properties:{evidence:"Imatinib  has  anti-coronal activity primarily because it inhibits the fusion of virions with the endosomal membrane (18).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:528}, end: {_id:523}, properties:{evidence:"Inhibitors of endosomal cysteine protease and transmembrane protease serine 2 can partially block viral entry into the cell", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:529}, end: {_id:523}, properties:{evidence:"Inhibitors of endosomal cysteine protease and transmembrane protease serine 2 can partially block viral entry into the cell", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:224}, end: {_id:552}, properties:{evidence:"Remdesivir It terminates transcription of the viral RNA transcription at premature level. Effective against wide range of viruses including SARS-CoV and MERS-CoV, thus could be suitable choice for treatment of SARS-CoV-2infection.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:333}, end: {_id:554}, properties:{evidence:"Ribavirin It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. Effective against wide range of viruses including MERS-CoV and SARS-CoV but high doses are required which may have severe side effects. It may be reevaluated for SARS-CoV-2and recommended if low doses are found effective.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:555}, end: {_id:554}, properties:{evidence:"Bcx4430 It targets RdRp (RNA‑dependent RNA polymerase) enzyme to inhibit synthesis of viral RNA synthesis and capping of mRNA. It isbroad-spectrum and effective against SARS-CoV and MERS-CoV, thus may be effective against SARS-CoV-2 however, evaluation using animals’ models is required.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:561}, end: {_id:523}, properties:{evidence:"Imatinib It inhibits kinase signaling associated pathways to block viral entry. It is effective against SARS/MERS-CoV and possibly be effective against SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:562}, end: {_id:523}, properties:{evidence:"Dasatinib It inhibits kinase signaling associated pathways to block viral entry. It is effective against SARS/MERS-CoV and possibly be effective against SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:592}, end: {_id:225}, properties:{evidence:" Interferons have also been shown to suppress the viral replication of SARS in vitro and been considered for the current outbreak ", annotationSpecies:["694009"], annotationBioassay:["in vitro"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:424}, end: {_id:174}, properties:{evidence:"Moreover, chloroquine has immunomodulatory effects, suppressing the production/release of TNF-α and IL-6. It also works as a novel class of autophagy inhibitor [81], which may interfere with viral infection and replication.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:666}, end: {_id:668}, properties:{evidence:"The other antiviral drugs include nitazoxanide, favipiravir, nafamostat, and so on (See Table 1 for details).", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:669}, end: {_id:48}, properties:{evidence:"The other antiviral drugs include nitazoxanide, favipiravir, nafamostat, and so on (See Table 1 for details).", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:424}, end: {_id:231}, properties:{evidence:"Chloroquine can inhibit a pre-entry step of the viral cycle by interfering with viral particles binding to their cellular cell surface receptor.", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:701}, properties:{evidence:"The mechanism of inhibition likely involved the prevention of endocytosis and/or rapid elevation of the endosomal pH and abrogation of virus–endosome fusion.", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:482}, properties:{evidence:"The mechanism of inhibition likely involved the prevention of endocytosis and/or rapid elevation of the endosomal pH and abrogation of virus–endosome fusion.", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:424}, end: {_id:118}, properties:{evidence:"Chloroquine/hydroxychloroquine, a front-line drug used in the treatment and prophylaxis of malaria also used in autoimmune disease had been shown to inhibit the replication of several DNA and RNA viruses, including most of human coronaviruses [3].", pmid:"32179150", citationType:"PubMed", citationRef:"32179150"}}, {start: {_id:784}, end: {_id:118}, properties:{evidence:"Chloroquine/hydroxychloroquine, a front-line drug used in the treatment and prophylaxis of malaria also used in autoimmune disease had been shown to inhibit the replication of several DNA and RNA viruses, including most of human coronaviruses [3].", pmid:"32179150", citationType:"PubMed", citationRef:"32179150"}}, {start: {_id:786}, end: {_id:787}, properties:{evidence:"According to Zhou and colleagues, in coronaviruses, teicoplanin acts on the early step of the viral life cycle by inhibiting the low pH cleavage of the viral spike protein by cathepsin L in the late endosomes thereby preventing the release of genomic viral RNA and the continuation of virus replication cycle.", annotationMeshanatomy:["Endosomes"], pmid:"32179150", citationType:"PubMed", citationRef:"32179150"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
