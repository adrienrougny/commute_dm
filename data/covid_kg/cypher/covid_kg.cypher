UNWIND [{start: {_id:112}, end: {_id:113}, properties:{evidence:"However, if ER stress persists, GADD153 can induce apoptosis by suppressing the anti-apoptotic protein B-cell lymphoma 2 (Bcl-2) and inducing the pro-apoptotic proteins such as Bcl-2-interacting mediator of cell death (Bim;Puthalakath et al., 2007). GADD153 also activates ER oxidoreductin-1α (ERO1α), which encodes an ER oxidase. The increase protein influx to a hyperoxidizing ER aggravates ER stress and induces apoptosis (Marciniak et al., 2004;Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:130}, end: {_id:113}, properties:{evidence:"The up-regulation of GADD153 promotes apoptosis in IBV-infected cells, possibly via inducing the pro-apoptotic protein tribbles-related protein 3 (TRIB3) and suppressing the pro-survival kinase extracellular signal-related kinase (ERK;Liaoet al., 2013).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:179}, end: {_id:156}, properties:{evidence:"Using a recombinant SARS-CoV that lacks the E protein (rSARS-CoV-delE), it is found that both XBP1 splicing and induction of UPR genes significantly increase in the absence of E protein.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:207}, end: {_id:118}, properties:{evidence:"For WNV,it has been shown that ATF6 activation promotes efficient WNV replication by suppressing signal transducer and activator of transcription 1 (STAT1) phosphorylation and late-phase IFN signaling (Ambrose and Mackenzie, 2013).", annotationMeshdisease:["West Nile Fever"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:342}, end: {_id:368}, properties:{evidence:"nsp3 function: PLP, polypeptides cleaving, blocking host innate immune response, promoting cytokine expression.", annotationSpecies:["2697049"], pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:376}, end: {_id:368}, properties:{evidence:"nsp16 function: 2′‐O‐MTase; avoiding MDA5 recognition,negatively regulating innate immunity.", annotationSpecies:["2697049"], pmid:"31967327", citationType:"PubMed", citationRef:"31967327"}}, {start: {_id:535}, end: {_id:225}, properties:{evidence:"Both interferon-alpha and beta inhibit viral replication", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:518}, end: {_id:225}, properties:{evidence:"Both interferon-alpha and beta inhibit viral replication", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:73}, end: {_id:877}, properties:{evidence:"Indeed, it induces cytokins depletion, antiproliferative effects, anti-fibrosis and antihypertrophy effects, addressing its key action and its role as target for therapies in inflammatory diseases.", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:73}, end: {_id:884}, properties:{evidence:"As an example among the many, the loss of ACE2 function in mouse shows the release of pro-inflammatory chemokines, such as C-X-C motif chemokine 5 (CXCL5), macrophage inflammatory protein-2 (MIP2), C-X-C motif chemokine 1 (KC), and TNF-α from airway epithelia, increased neutrophil infiltration, and exaggerated lung inflammation and injury.", annotationSpecies:["10090"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:910}, end: {_id:225}, properties:{evidence:"For example, recent work showed that the MERS-CoV virus induces reduced levels of the Beclin1 (BECN1) protein, which blocks the fusion of autophagosomes and lysosomes and the inhibition of the S-phase kinase-associated protein 2 (SKP2), an E3 ubiquitin ligase which promotes BECN1 degradation, enhances autophagy and reduces the replication of MERS-CoV up to 28,000-fold.", annotationDisease:["Middle East respiratory syndrome"], citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:1139}, end: {_id:137}, properties:{evidence:"For wild-type Nsp5, we identified one high-confidence interaction, the epigenetic regulator histone deacetylase 2 (HDAC2), and predicted a cleavage site between the HDAC domain and the nuclear localization sequence, suggesting that Nsp5 may inhibit HDAC2 transport into the nucleus (Extended Data Fig. 7), potentially impacting the published functions of HDAC2 in mediating inflammation and interferon response [38,39].", annotationMeshanatomy:["Cell Nucleus"], citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1166}, end: {_id:208}, properties:{evidence:"Orf6 of SARS-CoV has been shown to play a role in antagonizing host interferon signaling [63]; we identified a novel, high-confidence interaction between SARS-CoV-2 Orf6 and NUP98-RAE1, an interferon-inducible mRNA nuclear export complex [64] that is hijacked or degraded by multiple viruses, including VSV, Influenza-A, KSHV, and Polio, and is a restriction factor for Influenza-A infection [58,60,62,65]. These binding features are also present in a conserved motif in the C-terminal region of SARS-CoV-2 Orf6 (Fig. 4b, Extended Data Fig. 8), providing a structural hypothesis for the observed SARS-CoV-2–NUP98-RAE1 interaction.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1550}, end: {_id:1553}, properties:{evidence:"These genes were previously shown to regulate cell invasion, migration, proliferation and innate immunity by inhibiting pro-inflammatory cytokine production.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:1551}, end: {_id:1553}, properties:{evidence:"These genes were previously shown to regulate cell invasion, migration, proliferation and innate immunity by inhibiting pro-inflammatory cytokine production.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:1552}, end: {_id:1553}, properties:{evidence:"These genes were previously shown to regulate cell invasion, migration, proliferation and innate immunity by inhibiting pro-inflammatory cytokine production.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:149}, end: {_id:1553}, properties:{evidence:"These genes were previously shown to regulate cell invasion, migration, proliferation and innate immunity by inhibiting pro-inflammatory cytokine production.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:2663}, end: {_id:84}, properties:{evidence:"Also, treatment of α-glucosidase inhibitors, which inhibit the interactions of calnexin with its substrates, dose dependently inhibits the incorporationof S into pseudovirus and suppresses SARS- CoV replication in cell cultures (Fukushi et al., 2012).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:179}, end: {_id:156}, properties:{evidence:"Using a recombinant SARS-CoV that lacks the E protein (rSARS-CoV- delE), it is found that both XBP1 splicing and induction of UPR genes significantly increase in the absence of E protein.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:179}, end: {_id:2675}, properties:{evidence:"Moreover, E protein also suppresses ER stress induced by RSV and drugs (thapsigargin and tunicamycin; DeDiego et al.,2011).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
