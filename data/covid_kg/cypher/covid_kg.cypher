UNWIND [{start: {_id:582}, end: {_id:568}, properties:{evidence:"Higher lung injury Murray Score was associated with lymphopenia and higher levels of C-reactive protein, neutrophil percentage and LDH.", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:582}, end: {_id:569}, properties:{evidence:"Higher lung injury Murray Score was associated with lymphopenia and higher levels of C-reactive protein, neutrophil percentage and LDH.", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:386}, end: {_id:835}, properties:{evidence:"Remarkably, IL6 and not TGF-beta1 appear to by overproduced in COVID-19 patients", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:386}, end: {_id:569}, properties:{evidence:"Lymphopenia, prolonged prothrombin time, and elevated lactate dehydrogenase levels have also been observed in the patients with COVID-19.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:2653}, end: {_id:19}, properties:{evidence:"After uncoating, the genomic RNA first acts as an mRNA for translation of the replicase polyprotein.", annotationMeshanatomy:["Cytoplasm"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:2653}, end: {_id:12}, properties:{evidence:"The N proteins are translated in the cytoplasm and encapsidate the nascent progeny genomic RNA to form the nucleocapsids.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:50}, end: {_id:51}, properties:{evidence:"Global proteomic and microarray analyses have shown that the expression of several genes related to the ER stress, such as glucose- regulated protein 94 (GRP94) and glucose-regulated protein 78(GRP78, also known as immunoglobulin heavy chain-binding protein, or BiP), is up-regulated in cells infected with SARS-CoV or in cells overexpressing the SARS-CoV S2 subunit (Jiang et al., 2005;Yeung et al., 2008). Using a luciferase reporter system,Chan et al. (2006) found that both GRP94 and GRP78 were induced in SARS-CoV-infected FRhK4 cells.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:50}, end: {_id:52}, properties:{evidence:"Global proteomic and microarray analyses have shown that the expression of several genes related to the ER stress, such as glucose- regulated protein 94 (GRP94) and glucose-regulated protein 78(GRP78, also known as immunoglobulin heavy chain-binding protein, or BiP), is up-regulated in cells infected with SARS-CoV or in cells overexpressing the SARS-CoV S2 subunit (Jiang et al., 2005;Yeung et al., 2008). Using a luciferase reporter system,Chan et al. (2006) found that both GRP94 and GRP78 were induced in SARS-CoV-infected FRhK4 cells.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:386}, end: {_id:51}, properties:{evidence:"Global proteomic and microarray analyses have shown that the expression of several genes related to the ER stress, such as glucose- regulated protein 94 (GRP94) and glucose-regulated protein 78(GRP78, also known as immunoglobulin heavy chain-binding protein, or BiP), is up-regulated in cells infected with SARS-CoV or in cells overexpressing the SARS-CoV S2 subunit (Jiang et al., 2005;Yeung et al., 2008). Using a luciferase reporter system,Chan et al. (2006) found that both GRP94 and GRP78 were induced in SARS-CoV-infected FRhK4 cells.", pmid:"24987391", annotationCellline:["FRhK-4 cell"], citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:386}, end: {_id:52}, properties:{evidence:"Global proteomic and microarray analyses have shown that the expression of several genes related to the ER stress, such as glucose- regulated protein 94 (GRP94) and glucose-regulated protein 78(GRP78, also known as immunoglobulin heavy chain-binding protein, or BiP), is up-regulated in cells infected with SARS-CoV or in cells overexpressing the SARS-CoV S2 subunit (Jiang et al., 2005;Yeung et al., 2008). Using a luciferase reporter system,Chan et al. (2006) found that both GRP94 and GRP78 were induced in SARS-CoV-infected FRhK4 cells.", pmid:"24987391", annotationCellline:["FRhK-4 cell"], citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:386}, end: {_id:188}, properties:{evidence:"Significantly high blood levels of cytokines and chemokines were noted in patients with COVID-19 infection that included IL1-β, IL1RA, IL7, IL8, IL9, IL10, basic FGF2, GCSF, GMCSF, IFNγ, IP10, MCP1, MIP1α, MIP1β, PDGFB, TNFα, and VEGFA. Some of the severe cases that were admitted to the intensive care unit showed high levels of pro- inflammatory cytokines including IL2, IL7, IL10, GCSF, IP10, MCP1, MIP1α, and TNFα that are reasoned to promote disease severity [6].", pmid:"32113704", annotationAnatomy:["blood plasma"], citationType:"PubMed", citationRef:"32113704"}}, {start: {_id:386}, end: {_id:432}, properties:{evidence:"Significantly high blood levels of cytokines and chemokines were noted in patients with COVID-19 infection that included IL1-β, IL1RA, IL7, IL8, IL9, IL10, basic FGF2, GCSF, GMCSF, IFNγ, IP10, MCP1, MIP1α, MIP1β, PDGFB, TNFα, and VEGFA. Some of the severe cases that were admitted to the intensive care unit showed high levels of pro- inflammatory cytokines including IL2, IL7, IL10, GCSF, IP10, MCP1, MIP1α, and TNFα that are reasoned to promote disease severity [6].", pmid:"32113704", annotationAnatomy:["blood plasma"], citationType:"PubMed", citationRef:"32113704"}}, {start: {_id:386}, end: {_id:433}, properties:{evidence:"Significantly high blood levels of cytokines and chemokines were noted in patients with COVID-19 infection that included IL1-β, IL1RA, IL7, IL8, IL9, IL10, basic FGF2, GCSF, GMCSF, IFNγ, IP10, MCP1, MIP1α, MIP1β, PDGFB, TNFα, and VEGFA. Some of the severe cases that were admitted to the intensive care unit showed high levels of pro- inflammatory cytokines including IL2, IL7, IL10, GCSF, IP1