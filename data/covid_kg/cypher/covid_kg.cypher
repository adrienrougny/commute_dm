UNWIND [{start: {_id:425}, end: {_id:407}, properties:{evidence:"A recent study by Wang et al. revealed that remdesivir and chloroquine were highly effective in the control of 2019-nCoV in vitro [37].", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:452}, end: {_id:430}, properties:{evidence:"Ribavirin  is  a  nucleoside  analogue  with  a  broad-spectrum  of  antiviral  effects.  A  study  compared  111  patients  with  severe  acute  respiratory  syndrome  (SARS)  treated  with  ribavirin  monotherapy  and  41  patients  with  SARS  treated  with  lopinavir/ritonavir and ribavirin; patients treated with the combined therapy  had  a  lower  risk  of  acute  respiratory  distress  syndrome  (ARDS)  and  death  (6).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:452}, end: {_id:429}, properties:{evidence:"Ribavirin  is  a  nucleoside  analogue  with  a  broad-spectrum  of  antiviral  effects.  A  study  compared  111  patients  with  severe  acute  respiratory  syndrome  (SARS)  treated  with  ribavirin  monotherapy  and  41  patients  with  SARS  treated  with  lopinavir/ritonavir and ribavirin; patients treated with the combined therapy  had  a  lower  risk  of  acute  respiratory  distress  syndrome  (ARDS)  and  death  (6).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:517}, end: {_id:386}, properties:{evidence:"Treatment with remdesivir alone or in combination with chloroquine or interferon beta was found effective against COVID-19 infection.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:519}, end: {_id:386}, properties:{evidence:"Treatment with remdesivir alone or in combination with chloroquine or interferon beta was found effective against COVID-19 infection.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:536}, end: {_id:386}, properties:{evidence:"The previously tested recombinant interferon against SARS-CoV,such as interferon alfa and beta can be utilized either alone or in combination with other potential antiviral drugs including remdesivir. ", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:519}, end: {_id:386}, properties:{evidence:"The previously tested recombinant interferon against SARS-CoV,such as interferon alfa and beta can be utilized either alone or in combination with other potential antiviral drugs including remdesivir. ", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:538}, end: {_id:386}, properties:{evidence:"The use of interferon inducers in combination effective antiviral agents may be evaluated for their synergistic effects against SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:541}, end: {_id:386}, properties:{evidence:"In addition, calcineurin inhibitors such as cyclosporine could also be evaluated for SARS-CoV-2 in combination with antibiotics and traditional Chinese medicines.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:543}, end: {_id:386}, properties:{evidence:"Combining two or more monoclonal antibodies may be suitable for the quicker recovery of patients.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:550}, end: {_id:386}, properties:{evidence:"Mycophenolic Acid It targets Nucleosides and/or nucleotides to inhibit synthesis of guanine monophosphate. Effective against wide range of viruses, however combinatorial therapy with interferon beta-1b may be useful for SARS-CoV-2.", annotationSpecies:["9606"], pmid:"32161092", citationType:"PubMed", citationRef:"32161092"}}, {start: {_id:587}, end: {_id:227}, properties:{evidence:" Early SARS case series treated with combined ribavirin and corticosteroids showed clinical improvement.", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:587}, end: {_id:386}, properties:{evidence:" Early SARS case series treated with combined ribavirin and corticosteroids showed clinical improvement.", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:590}, end: {_id:227}, properties:{evidence:"Combination of lopinavir/ritonavir and ribavirin showed stronger suppression on viral load and reduced use of steroid", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:590}, end: {_id:386}, properties:{evidence:"Combination of lopinavir/ritonavir and ribavirin showed stronger suppression on viral load and reduced use of steroid", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:591}, end: {_id:227}, properties:{evidence:"Combination of lopinavir/ritonavir and ribavirin showed stronger suppression on viral load and reduced use of steroid", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:591}, end: {_id:386}, properties:{evidence:"Combination of lopinavir/ritonavir and ribavirin showed stronger suppression on viral load and reduced use of steroid", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:1443}, end: {_id:386}, properties:{evidence:"Interferon-γ combination with an interferon-I might induce synergistic effects and maximize the benefits.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:1444}, end: {_id:386}, properties:{evidence:"Interferon-γ combination with an interferon-I might induce synergistic effects and maximize the benefits.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:1444}, end: {_id:227}, properties:{evidence:"Interferon-γ combination with an interferon-I might induce synergistic effects and maximize the benefits.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}] AS row
