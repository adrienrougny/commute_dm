UNWIND [{start: {_id:797}, end: {_id:231}, properties:{evidence:"Indeed, the entry full inhibition also needed TMPRSS2 inhibitors (like camostat mesylate).", annotationDisease:["Severe acute respiratory syndrome-related coronavirus", "Severe acute respiratory syndrome coronavirus 2"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:887}, end: {_id:901}, properties:{evidence:"The long term, overdosage, ACE-inhibitor treatment limited the SARS-CoV2 virulence in the single case patient here reported for two main reasons, which are clearly depicted by the model.", annotationDisease:["Severe acute respiratory syndrome coronavirus 2"], citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:931}, end: {_id:231}, properties:{evidence:"Indeed, based on our findings and the proposed framework, it is reasonable to hypothesize that some inhibitors of autophagy (e.g., chloroquine, currently undergoing clinical trial, cf. Table 1) would prevent the virus from entering the host cell and could thereby be used to prevent SARS-CoV-2 infections while activators of autophagy (e.g., interferon-alpha 2a/2b, also undergoing clinical trial), which would help the host cell clear the viral particles, could be used to treat severe forms of COVID-19.", annotationDisease:["Severe acute respiratory syndrome coronavirus 2"], citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:1030}, end: {_id:174}, properties:{evidence:"Quinacrine inhibitor of autophagy antihelmintic drug; antiprotozoal drug", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:1032}, end: {_id:174}, properties:{evidence:"Bortezomib inhibitor of autophagy anticancer agent", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:1033}, end: {_id:174}, properties:{evidence:"Pantoprazole inhibitor of autophagy gastrointestinal drug", citationType:"preprints", citationRef:"10.20944/preprin