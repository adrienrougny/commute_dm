UNWIND [{start: {_id:699}, end: {_id:715}, properties:{evidence:"Beside affecting the virus maturation process, pH modulation by chloroquine can impair the proper maturation of viral protein [32] and the recognition of viral antigen by dendritic cells, which occurs through a Toll-like receptor-dependent pathway that requires endosomal acidification [69].", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:1203}, end: {_id:1204}, properties:{evidence:"Interestingly, the Spike protein (S) interacts with the GOLGA7-ZDHHC5 acyl-transferase complex, which likely mediates palmitoylation on its cytosolic tail (see also Appendix) [35]. Palmitoylation has been reported to facilitate membrane fusion by SARS-CoV Spike and suggests a potential target for therapeutic inhibition [36].", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:179}, end: {_id:162}, properties:{evidence:"Using a recombinant SARS-CoV that lacks the E protein (rSARS-CoV-delE), it is found that both XBP1 splicing and induction of UPR genes significantly increase in the absence of E protein.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:836}, end: {_id:837}, properties:{evidence:"Interleukin 6 (IL-6) leads a relevant increase in cathepsin L, whereas TGF-beta1 decreases the amount of cathepsin L, at both mRNA and protein levels, proving that the cytokines IL-6 and TGF-beta 1 modulate cathepsin gene expression.", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:407}, end: {_id:416}, properties:{evidence:"Ground-glass opacity (GGO) was the most common finding from chest computed tomography (CT) [8 , 34] , and in a series of 21 patients, 86% had GGO on chest CT and 29% showed consolidation [33] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:407}, end: {_id:742}, properties:{evidence:"Among a pooled analysis of 468 patients with pneumonia (Table 2) based on five studies with detailed description of clinical features of the disease, [11, 12, 13, 14,23] male sex comprised 60.3% of patients and the mean age was 53 years.", pmid:"32173241", citationType:"PubMed", citationRef:"32173241"}}, {start: {_id:407}, end: {_id:781}, properties:{evidence:"In terms of inflammation indicators, patients on  admission showed increase in lactate dehydrogenase (25 [41%] of 61 patients), c reactive protein (42 [67%] of 63 patients), and erythrocyte sedimentation rate (30 [52%] of 58 patients), but not procalcitonin. ", pmid:"32176772", citationType:"PubMed", citationRef:"32176772"}}, {start: {_id:386}, end: {_id:416}, properties:{evidence:"Ground-glass opacity (GGO) was the most common finding from chest computed tomography (CT) [8 , 34] , and in a series of 21 patients, 86% had GGO on chest CT and 29% showed consolidation [33] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:386}, end: {_id:431}, properties:{evidence:"Patients infected with COVID-19 showed higher leukocyte numbers, abnormal respiratory findings, and increased levels of plasma pro- inflammatory cytokines.", pmid:"32113704", annotationAnatomy:["blood plasma"], citationType:"PubMed", citationRef:"32113704"}}, {start: {_id:386}, end: {_id:642}, properties:{evidence:"But in the severe patients, the neutrophil count, D-dimer, blood urea, and creatinine levels were higher significantly, and the lymphocyte counts continued to decrease.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:386}, end: {_id:643}, properties:{evidence:"But in the severe patients, the neutrophil count, D-dimer, blood urea, and creatinine levels were higher significantly, and the lymphocyte counts continued to decrease.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:386}, end: {_id:644}, properties:{evidence:"But in the severe patients, the neutrophil count, D-dimer, blood urea, and creatinine levels were higher significantly, and the lymphocyte counts continued to decrease.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:386}, end: {_id:2690}, properties:{evidence:"Among a pooled analysis of 468 patients with pneumonia (Table 2) based on five studies with detailed description of clinical features of the disease, [11, 12, 13, 14,23] male sex comprised 60.3% of patients and the mean age was 53 years.", pmid:"32173241", citationType:"PubMed", citationRef:"32173241"}}, {start: {_id:386}, end: {_id:781}, properties:{evidence:"In terms of inflammation indicators, patients on admission showed increase in lactate dehydrogenase (25 [41%] of 61 patients), c reactive protein (42 [67%] of 63 patients), and erythrocyte sedimentation rate (30 [52%] of 58 patients), but not procalcitonin.", pmid:"32176772", citationType:"PubMed", citationRef:"32176772"}}] AS row
