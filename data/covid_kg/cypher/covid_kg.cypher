UNWIND [{start: {_id:263}, end: {_id:289}, properties:{evidence:"It should be noted, that ferrocene induced subtle changes in autophagy in LNCaP cells. However, in combination with CQ ferrocene induced accumulation of LC3-II levels comparable to that induced by FQ.", pmid:"29162859", annotationCellline:["LNCAP cell"], citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:898}, end: {_id:73}, properties:{evidence:"lisinopril losartan Combined: ACE2 UP", citationType:"arXiv", citationRef:"arXiv:2003.11614v1"}}, {start: {_id:1559}, end: {_id:1560}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", citationType:"biorxiv", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:2764}, end: {_id:2765}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:140}, end: {_id:136}, properties:{evidence:"Interestingly, induction of TNF-α, IL-6, and IL-8 has been detected in cells overexpressing the spike protein of SARS-CoV via the NF-κB pathway(Wang et al., 2007;Dosch et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:140}, end: {_id:133}, properties:{evidence:"Interestingly, induction of TNF-α, IL-6, and IL-8 has been detected in cells overexpressing the spike protein of SARS-CoV via the NF-κB pathway(Wang et al., 2007;Dosch et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:140}, end: {_id:139}, properties:{evidence:"Interestingly, induction of TNF-α, IL-6, and IL-8 has been detected in cells overexpressing the spike protein of SARS-CoV via the NF-κB pathway(Wang et al., 2007;Dosch et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:706}, end: {_id:707}, properties:{evidence:"A pH-dependant mechanism of entry of coronavirus into target cells was also reported for SARS-CoV-1 after binding of the DC-SIGN receptor [62]. The activation step that occurs in endosomes at acidic pH results in fusion of the viral and endosomal membranes leading to the release of the viral SARS-CoV-1 genome into the cytosol [63].In the absence of antiviral drug, the virus is targeted to the lysosomal compartment where the low pH, along with the action of enzymes, disrupts the viral particle, thus liberating the infectious nucleic acid and, in several cases, enzymes necessary for its replication [64].", annotationMeshdisease:["Coronavirus Infections"], annotationMeshanatomy:["Endosomes"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:729}, end: {_id:136}, properties:{evidence:"Chloroquine-induced inhibition of tumour necrosis factor-alpha (TNFα) production by immune cells was reported to occur either through disruption of cellular iron metabolism [80], blockade of the conversion of pro-TNF into soluble mature TNFα molecules [81] and/or inhibition of TNFα mRNA expression [72,82,83].", pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:1466}, end: {_id:922}, properties:{evidence:"Noteworthy, toll like receptor (TLR)3 activation, could induce these IFNs.", annotationCell:["naive T cell"], annotationDisease:["Severe acute respiratory syndrome-related coronavirus"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:140}, end: {_id:434}, properties:{evidence:"Interestingly, induction of TNF-α, IL-6, and IL-8 has been detected in cells overexpressing the spike protein of SARS-CoV via the NF-κB pathway(Wang et al., 2007;Dosch et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:706}, end: {_id:2689}, properties:{evidence:"A pH-dependant mechanism of entry of coronavirus into target cells was also reported for SARS-CoV-1 after binding of the DC-SIGN receptor [62]. The activation step that occurs in endosomes at acidic pH results in fusion of the viral and endosomal membranes leading to the release of the viral SARS-CoV-1 genome into the cytosol [63].In the absence of antiviral drug, the virus is targeted to the lysosomal compartment where the low pH, along with the action of enzymes, disrupts the viral particle, thus liberating the infectious nucleic acid and, in several cases, enzymes necessary for its replication [64].", annotationMeshdisease:["Coronavirus Infections"], annotationMeshanatomy:["Cytoplasm"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:904}, end: {_id:906}, properties:{evidence:"Among those pathways, the Unfolded Protein Response (UPR) and Autophagy pathways are tightly interconnected and were shown to be essential for viral infection by multiple previous studies.", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:905}, end: {_id:906}, properties:{evidence:"Among those pathways, the Unfolded Protein Response (UPR) and Autophagy pathways are tightly interconnected and were shown to be essential for viral infection by multiple previous studies.", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:921}, end: {_id:85}, properties:{evidence:"Then, our PPI analysis confirmed the putative role of “pattern recognition receptors signaling” and “inflammasome pathway” in coronavirus infections but also allowed us to connect these two immune pathways and UPR/autophagy signaling into a single molecular framework of the host cell viral infection.", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:915}, end: {_id:85}, properties:{evidence:"Then, our PPI analysis confirmed the putative role of “pattern recognition receptors signaling” and “inflammasome pathway” in coronavirus infections but also allowed us to connect these two immune pathways and UPR/autophagy signaling into a single molecular framework of the host cell viral infection.", citationType:"preprints", citationRef:"10.20944/preprints202003.0302.v1"}}, {start: {_id:174}, end: {_id:2687}, properties:{evidence:"Moreover, chloroquine has immunomodulatory effects, suppressing the production/release of TNF-α and IL-6. It also works as a novel class of autophagy inhibitor [81], which may interfere with viral infection and replication.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:174}, end: {_id:711}, properties:{evidence:"Moreover, chloroquine has immunomodulatory effects, suppressing the production/release of TNF-α and IL-6. It also works as a novel class of autophagy inhibitor [81], which may interfere with viral infection and replication.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:2758}, end: {_id:1486}, properties:{evidence:"All patients with severe COVID-19 should be screened for hyperinflammation using laboratory trends (eg, increasing ferritin, decreasing platelet counts, or erythrocyte sedimentation rate) and the HScore [11] (table) to identify the subgroup of patients for whom immunosuppression could improve mortality.", citationType:"DOI", citationRef:"https://doi.org/10.1016/S0140-6736(20)30628-0"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:53}, end: {_id:50}, properties:{evidence:"Global proteomic and microarray analyses have shown that the expression of several genes related to the ER stress, such as glucose-regulated protein 94 (GRP94) and glucose-regulated protein 78(GRP78, also known as immunoglobulin heavy chain-binding protein, or BiP), is up-regulated in cells infected with SARS-CoV or in cells overexpressing the SARS-CoV S2 subunit (Jiang et al., 2005;Yeung et al., 2008). Using a luciferase reporter system,Chan et al. (2006) found that both GRP94 and GRP78 were induced in SARS-CoV-infected FRhK4 cells.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:407}, end: {_id:411}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:407}, end: {_id:412}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:407}, end: {_id:413}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:407}, end: {_id:414}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:407}, end: {_id:415}, properties:{evidence:"Fever was the most common symptom (92.8%; n = 258), followed by cough (69.8%; n = 194), dyspnoea (34.5%; n = 96), myalgia (27.7%; n = 77), headache (7.2%; n = 20) and diarrhoea (6.1%; n = 17).", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:428}, end: {_id:429}, properties:{evidence:"Clinical features revealed by a chest CT scan presented as pneumonia, however, there were abnormal features such as RNAaemia, acute respiratory distress syndrome, acute cardiac injury, and incidence of grand-glass opacities that led to death [6].", pmid:"32113704", citationType:"PubMed", citationRef:"32113704"}}, {start: {_id:430}, end: {_id:429}, properties:{evidence:"Clinical features revealed by a chest CT scan presented as pneumonia, however, there were abnormal features such as RNAaemia, acute respiratory distress syndrome, acute cardiac injury, and incidence of grand-glass opacities that led to death [6].", pmid:"32113704", citationType:"PubMed", citationRef:"32113704"}}, {start: {_id:386}, end: {_id:409}, properties:{evidence:"Factors associated with severe presentation included older, underlying comorbidities(hypertension, diabetes, coronary heart disease, chronic obstructive pulmonary disease) and presented with dyspnoea, anorexia, and rash", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:386}, end: {_id:410}, properties:{evidence:"Factors associated with severe presentation included older, underlying comorbidities(hypertension, diabetes, coronary heart disease, chronic obstructive pulmonary disease) and presented with dyspnoea, anorexia, and rash", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:386}, end: {_id:579}, properties:{evidence:"Factors associated with severe presentation included older, underlying comorbidities(hypertension, diabetes, coronary heart disease, chronic obstructive pulmonary disease) and presented with dyspnoea, anorexia, and rash", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:386}, end: {_id:580}, properties:{evidence:"Factors associated with severe presentation included older, underlying comorbidities(hypertension, diabetes, coronary heart disease, chronic obstructive pulmonary disease) and presented with dyspnoea, anorexia, and rash", annotationSpecies:["9606"], pmid:"32164424", citationType:"PubMed", citationRef:"32164424"}}, {start: {_id:407}, end: {_id:236}, properties:{evidence:"The clinical manifestations of COVID-19 are protean, which include asymptomatic carrier, ARD, and pneumonia of varying degrees of severity. First, asymptomatic cases were diagnosed based on positive viral nucleic acid test results, but without any COVID-19 symptoms, such as fever, gastrointestinal, or respiratory symptoms, and no significant abnormalities on chest radiograph [7,8].", pmid:"32173241", citationType:"PubMed", citationRef:"32173241"}}, {start: {_id:407}, end: {_id:311}, properties:{evidence:"The clinical manifestations of COVID-19 are protean, which include asymptomatic carrier, ARD, and pneumonia of varying degrees of severity. First, asymptomatic cases were diagnosed based on positive viral nucleic acid test results, but without any COVID-19 symptoms, such as fever, gastrointestinal, or respiratory symptoms, and no significant abnormalities on chest radiograph [7,8].", pmid:"32173241", citationType:"PubMed", citationRef:"32173241"}}, {start: {_id:407}, end: {_id:567}, properties:{evidence:"The clinical manifestations of COVID-19 are protean, which include asymptomatic carrier, ARD, and pneumonia of varying degrees of severity. First, asymptomatic cases were diagnosed based on positive viral nucleic acid test results, but without any COVID-19 symptoms, such as fever, gastrointestinal, or respiratory symptoms, and no significant abnormalities on chest radiograph [7,8].", pmid:"32173241", citationType:"PubMed",