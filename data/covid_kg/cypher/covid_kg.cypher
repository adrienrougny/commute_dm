 properties:{evidence:"Name Naphazoline, Current Application Decongestant in over the counter eye drops and nasal preparations.", citationType:"chemrxiv", citationRef:"https://doi.org/10.26434/chemrxiv.11860011.v2"}}, {start: {_id:1432}, end: {_id:1434}, properties:{evidence:"Name Benzylpenicillin, Current Application Narrow-spectrum antibiotic.", citationType:"chemrxiv", citationRef:"https://doi.org/10.26434/chemrxiv.11860011.v2"}}, {start: {_id:250}, end: {_id:251}, properties:{evidence:"Name Chloroquine, Current Application Antimalarial agent.", citationType:"chemrxiv", citationRef:"https://doi.org/10.26434/chemrxiv.11860011.v2"}}, {start: {_id:1436}, end: {_id:1438}, properties:{evidence:"Name Chlorothiazide, Current Application Diuretic.", citationType:"chemrxiv", citationRef:"https://doi.org/10.26434/chemrxiv.11860011.v2"}}, {start: {_id:1441}, end: {_id:534}, properties:{evidence:"Administration of interferon-inducing agents, such as poly (ICLC), could reduce the mortality of SARS at the very early stages of the disease.", citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:1467}, end: {_id:1468}, properties:{evidence:"Poly (I:C) is a synthetic double-stranded RNA immunostimulant, which is used as adjuvant in vaccine production.", annotationCell:["naive T cell"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:363}, end: {_id:364}, properties:{evidence:"Coronaviruses belong to the Coronaviridae family in the Nidovirales order.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:320}, end: {_id:363}, properties:{evidence:"Coronaviruses belong to the Coronaviridae family in the Nidovirales order.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:234}, end: {_id:363}, properties:{evidence:"Coronaviruses belong to the Coronaviridae family in the Nidovirales order.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:363}, properties:{evidence:"Coronaviruses belong to the Coronaviridae family in the Nidovirales order.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:320}, end: {_id:1490}, properties:{evidence:"Coronaviruses are minute in size (65–125 nm in diameter) and contain a single-stranded RNA as a nucleic material, size ranging from 26 to 32kbs in length.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:IS_A]->(end) SET r += row.properties;
UNWIND [{start: {_id:234}, end: {_id:1490}, properties:{evidence:"Coronaviruses are minute in size (65–125 nm in diameter) and contain a single-stranded RNA as a nucleic material, size ranging from 26 to 32kbs in length.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:1490}, properties:{evidence:"Coronaviruses are minute in size (65–125 nm in diameter) and contain a single-stranded RNA as a nucleic material, size ranging from 26 to 32kbs in length.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:234}, end: {_id:217}, properties:{evidence:"In 2003, the Chinese population was infected with a virus causing Severe Acute Respiratory Syndrome (SARS) in Guangdong province. The virus was confirmed as a member of the Betacoronavirus subgroup and was named SARS-CoV.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:217}, properties:{evidence:"MERS-CoV is a member beta-coronavirus subgroup and phylogenetically diverse from other human-CoV.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:310}, end: {_id:217}, properties:{evidence:"MERS-coronavirus also pertains to beta-coronavirus and having camels as a zoonotic source or primary host.", annotationSpecies:["1335626"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1492}, end: {_id:1493}, properties:{evidence:"MERS-coronavirus also pertains to beta-coronavirus and having camels as a zoonotic source or primary host.", annotationSpecies:["1335626"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1494}, end: {_id:1493}, properties:{evidence:"In a recent study, MERS-coronavirus was also detected in Pipistrellus and Perimyotis bats, proffering that bats are the key host and transmitting medium of the virus.", annotationSpecies:["1335626"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1494}, end: {_id:1493}, properties:{evidence:"SARS-CoV Key hosts Bat, palm civets and Raccon dogs.", annotationSpecies:["694009"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1495}, end: {_id:1493}, properties:{evidence:"SARS-CoV Key hosts Bat, palm civets and Raccon dogs.", annotationSpecies:["694009"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1494}, end: {_id:1493}, properties:{evidence:"SARS-CoV-2 Key hosts Bat", annotationSpecies:["2697049"], citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:449}, end: {_id:450}, properties:{evidence:"IFN-α is a broad-spectrum antiviral that is usually used to treat hepatitis, though it is reported to inhibit SARS-CoV reproduction in vitro (4).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:424}, end: {_id:458}, properties:{evidence:"Chloroquine is a widely used antimalarial that was found to be a potential broad-spectrum antiviral in 2006 (7). Chloroquine was found to block SARS-CoV-2 infection at low-micromolar concentration, with a half-maximal effective concentration (EC50) of 1.13 μM and a half- cytotoxic concentration (CC50) greater than 100 μM (8).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:420}, end: {_id:450}, properties:{evidence:"Arbidol is an antiviral that can be used to treat influenza virus. A study has revealed that arbidol can effectively inhibit SARS-CoV-2 infection at a concentration of 10-30 μM in vitro (9).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:224}, end: {_id:450}, properties:{evidence:"Remdesivir is a nucleoside analogue and a broad-spectrum antiviral. Animal experiments (13) indicated that remdesivir can effectively reduce the viral load in lung tissue of mice infected with MERS-CoV, improve lung function, and alleviate pathological damage to lung tissue.", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:477}, end: {_id:478}, properties:{evidence:"Studies have also revealed some other drugs may have potential efficacy in treating COVID-19. One is darunavir, which is a second- generation of HIV-1 protease inhibitor. On February 4, 2020, researchers in China announced that darunavir inhibited SARS-CoV-2 infection in vitro (9). Cell experiments indicated that darunavir significantly inhibited viral replication at a concentration of 300 μM in vitro and that its inhibition efficiency was 280-fold that in the untreated group (9).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:302}, end: {_id:217}, properties:{evidence:"Until today, six different strains of Human coronaviruses (HCoVs) have been reported, in addition to the newly emerged COVID-19 [2,12]. 229E and NL63 strains of HCoVs belong to Alphacoronaviruses while OC43, HKU1, SARS, MERS, and COVID-19 HCoVs belong to Betacoronaviruses [2,11].", citationType:"DOI", citationRef:"https://doi.org/10.1016/j.lfs.2020.117477"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:IS_A]->(end) SET r += row.properties;
UNWIND [{start: {_id:224}, end: {_id:243}, properties:{evidence:"Disease severity and survival did not differ with treatment, but we observed a significant reduction (P < 0.05) in SARS-CoV lung titers of GS-5734–treated animals at 6 dpi.", pmid:"28659436", annotationDisease:["Severe acute respiratory syndrome-related coronavirus"], citationType:"PubMed", citationRef:"28659436"}}, {start: {_id:261}, end: {_id:255}, properties:{evidence:"Of note,ferrocene (or aminoferrocene) alone or in combination with CQ (equimolar concentrations) did not induce PC3M prostate cancer cell death.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:262}, end: {_id:255}, properties:{evidence:"Of note,ferrocene (or aminoferrocene) alone or in combination with CQ (equimolar concentrations) did not induce PC3M prostate cancer cell death.", pmid:"29162859", citationType:"PubMed", citationRef:"29162859"}}, {start: {_id:261}, end: {_id:257}, properties:{evidence:"We also tested the effect of ferrocene and ferrocene + CQ on the viability of PNT1A, C42, LNCaP and PC3 cells, and in all the cases treatments were without significant effect on cell viability.", pmid:"29162859", annotationCellline:["LNCAP cell", "PNT1A cell"], citationType:"PubMed", citationRef:"29162859"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
