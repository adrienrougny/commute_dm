UNWIND [{start: {_id:729}, end: {_id:838}, properties:{evidence:"With the advancement of the disease and the virus overload, the responses would shift toward immnopathogenic over-reactions and probably cytokine storm.", annotationDisease:["Severe acute respiratory syndrome-related coronavirus", "Severe acute respiratory syndrome coronavirus 2"], citationType:"preprints", citationRef:"10.20944/preprints202003.0206.v2"}}, {start: {_id:2652}, end: {_id:2653}, properties:{evidence:"After uncoating, the genomic RNA first acts as an mRNA for translation of the replicase polyprotein.", annotationMeshanatomy:["Cytoplasm"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:698}, end: {_id:2653}, properties:{evidence:"A pH-dependant mechanism of entry of coronavirus into target cells was also reported for SARS-CoV-1 after binding of the DC-SIGN receptor [62]. The activation step that occurs in endosomes at acidic pH results in fusion of the viral and endosomal membranes leading to the release of the viral SARS-CoV-1 genome into the cytosol [63].In the absence of antiviral drug, the virus is targeted to the lysosomal compartment where the low pH, along with the action of enzymes, disrupts the viral particle, thus liberating the infectious nucleic acid and, in several cases, enzymes necessary for its replication [64].", annotationMeshdisease:["Coronavirus Infections"], annotationMeshanatomy:["Cytoplasm"], pmid:"32171740", citationType:"PubMed", citationRef:"32171740"}}, {start: {_id:1561}, end: {_id:386}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", annotationMeshanatomy:["Lysosomes"], citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}, {start: {_id:641}, end: {_id:2653}, properties:{evidence:"The infection of SARS virus is initiated by the attachment of S protein to the receptor ACE2 [19], followed by cleavage with host cell protease TMPRSS2 [20-22]. The viruses are then transported through the early and late endosomes, subsequently endo/lysosomes, during which host protein extracellular proteases including cathepsin L mediates the further cleavage of S protein in endocytic vesicles [23-26]. The activated S protein will then activate the fusion between viral and cell membranes and release the genome of SARS-CoV into cytoplasm.", annotationMeshanatomy:["Cytoplasm"], citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.02.05.935387 "}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:752}, end: {_id:225}, properties:{evidence:"A previous attempt to predict drugs for the Mpro of SARS-CoV has identified two HIV-1 protease inhibitors, namely lopinavir and ritonavir, as potential candidates, both of which bind to the same target site of Mpro (Nukoolkarn et al., 2008). The conserved amino acids Thr24-Asn28 and Asn119 (numbered according to positions in SARS-CoV Mpro because the present sequence of 2019-nCoV Mpro in GenBank is in polypeptide form) formed the binding pockets for lopinavir/ritonavir in the spatial structure of both SARS-CoV Mpro and 2019-nCoV Mpro, whereas the nearby non-conserved amino acids locate far away from the binding pocket, thus would not affect its structural conservation (Fig. 1B). ", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:755}, end: {_id:225}, properties:{evidence:"A previous attempt to predict drugs for the Mpro of SARS-CoV has identified two HIV-1 protease inhibitors, namely lopinavir and ritonavir, as potential candidates, both of which bind to the same target site of Mpro (Nukoolkarn et al., 2008). The conserved amino acids Thr24-Asn28 and Asn119 (numbered according to positions in SARS-CoV Mpro because the present sequence of 2019-nCoV Mpro in GenBank is in polypeptide form) formed the binding pockets for lopinavir/ritonavir in the spatial structure of both SARS-CoV Mpro and 2019-nCoV Mpro, whereas the nearby non-conserved amino acids locate far away from the binding pocket, thus would not affect its structural conservation (Fig. 1B). ", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:756}, end: {_id:225}, properties:{evidence:"A previous attempt to predict drugs for the Mpro of SARS-CoV has identified two HIV-1 protease inhibitors, namely lopinavir and ritonavir, as potential candidates, both of which bind to the same target site of Mpro (Nukoolkarn et al., 2008). The conserved amino acids Thr24-Asn28 and Asn119 (numbered according to positions in SARS-CoV Mpro because the present sequence of 2019-nCoV Mpro in GenBank is in polypeptide form) formed the binding pockets for lopinavir/ritonavir in the spatial structure of both SARS-CoV Mpro and 2019-nCoV Mpro, whereas the nearby non-conserved amino acids locate far away from the binding pocket, thus would not affect its structural conservation (Fig. 1B). ", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:757}, end: {_id:225}, properties:{evidence:"A previous attempt to predict drugs for the Mpro of SARS-CoV has identified two HIV-1 protease inhibitors, namely lopinavir and ritonavir, as potential candidates, both of which bind to the same target site of Mpro (Nukoolkarn et al., 2008). The conserved amino acids Thr24-Asn28 and Asn119 (numbered according to positions in SARS-CoV Mpro because the present sequence of 2019-nCoV Mpro in GenBank is in polypeptide form) formed the binding pockets for lopinavir/ritonavir in the spatial structure of both SARS-CoV Mpro and 2019-nCoV Mpro, whereas the nearby non-conserved amino acids locate far away from the binding pocket, thus would not affect its structural conservation (Fig. 1B). ", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:2693}, end: {_id:225}, properties:{evidence:"A previous attempt to predict drugs for the Mpro of SARS-CoV has identified two HIV-1 protease inhibitors, namely lopinavir and ritonavir, as potential candidates, both of which bind to the same target site of Mpro (Nukoolkarn et al., 2008). The conserved amino acids Thr24-Asn28 and Asn119 (numbered according to positions in SARS- CoV Mpro because the present sequence of 2019-nCoV Mpro in GenBank is in polypeptide form) formed the binding pockets for lopinavir/ritonavir in the spatial structure of both SARS-CoV Mpro and 2019-nCoV Mpro, whereas the nearby non-conserved amino acids locate far away from the binding pocket, thus would not affect its structural conservation (Fig. 1B).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:2695}, end: {_id:225}, properties:{evidence:"A previous attempt to predict drugs for the Mpro of SARS-CoV has identified two HIV-1 protease inhibitors, namely lopinavir and ritonavir, as potential candidates, both of which bind to the same target site of Mpro (Nukoolkarn et al., 2008). The conserved amino acids Thr24-Asn28 and Asn119 (numbered according to positions in SARS- CoV Mpro because the present sequence of 2019-nCoV Mpro in GenBank is in polypeptide form) formed the binding pockets for lopinavir/ritonavir in the spatial structure of both SARS-CoV Mpro and 2019-nCoV Mpro, whereas the nearby non-conserved amino acids locate far away from the binding pocket, thus would not affect its structural conservation (Fig. 1B).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:2696}, end: {_id:225}, properties:{evidence:"A previous attempt to predict drugs for the Mpro of SARS-CoV has identified two HIV-1 protease inhibitors, namely lopinavir and ritonavir, as potential candidates, both of which bind to the same target site of Mpro (Nukoolkarn et al., 2008). The conserved amino acids Thr24-Asn28 and Asn119 (numbered according to positions in SARS- CoV Mpro because the present sequence of 2019-nCoV Mpro in GenBank is in polypeptide form) formed the binding pockets for lopinavir/ritonavir in the spatial structure of both SARS-CoV Mpro and 2019-nCoV Mpro, whereas the nearby non-conserved amino acids locate far away from the binding pocket, thus would not affect its structural conservation (Fig. 1B).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}, {start: {_id:2697}, end: {_id:225}, properties:{evidence:"A previous attempt to predict drugs for the Mpro of SARS-CoV has identified two HIV-1 protease inhibitors, namely lopinavir and ritonavir, as potential candidates, both of which bind to the same target site of Mpro (Nukoolkarn et al., 2008). The conserved amino acids Thr24-Asn28 and Asn119 (numbered according to positions in SARS- CoV Mpro because the present sequence of 2019-nCoV Mpro in GenBank is in polypeptide form) formed the binding pockets for lopinavir/ritonavir in the spatial structure of both SARS-CoV Mpro and 2019-nCoV Mpro, whereas the nearby non-conserved amino acids locate far away from the binding pocket, thus would not affect its structural conservation (Fig. 1B).", pmid:"32173287", citationType:"PubMed", citationRef:"32173287"}}] AS row
