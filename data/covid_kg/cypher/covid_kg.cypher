UNWIND [{start: {_id:404}, end: {_id:386}, properties:{annotationCellstructure:["Endoplasmic Reticulum", "Golgi Apparatus"], evidence:"The DNA fragment, inactivated whole virus or live-vectored strain of SARS-CoV (AY278741), significantly reduced the viral infection in various animal models.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:405}, end: {_id:386}, properties:{annotationCellstructure:["Endoplasmic Reticulum", "Golgi Apparatus"], evidence:"The DNA fragment, inactivated whole virus or live-vectored strain of SARS-CoV (AY278741), significantly reduced the viral infection in various animal models.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1512}, end: {_id:386}, properties:{annotationCellstructure:["Endoplasmic Reticulum", "Golgi Apparatus"], evidence:" For instance, there is a possibility that vaccines for other diseases such as rubella or measles can create cross-resistance for SARS-CoV-2.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1513}, end: {_id:386}, properties:{annotationCellstructure:["Endoplasmic Reticulum", "Golgi Apparatus"], evidence:" For instance, there is a possibility that vaccines for other diseases such as rubella or measles can create cross-resistance for SARS-CoV-2.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:551}, end: {_id:386}, properties:{annotationCellstructure:["Endoplasmic Reticulum", "Golgi Apparatus"], evidence:" Remdesivir, Lopinavir, Ritonavir, and Oseltamivir significantly blocked the COVID-19 infection in infected patients.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:585}, end: {_id:386}, properties:{annotationCellstructure:["Endoplasmic Reticulum", "Golgi Apparatus"], evidence:" Remdesivir, Lopinavir, Ritonavir, and Oseltamivir significantly blocked the COVID-19 infection in infected patients.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:247}, end: {_id:386}, properties:{annotationCellstructure:["Endoplasmic Reticulum", "Golgi Apparatus"], evidence:" Remdesivir, Lopinavir, Ritonavir, and Oseltamivir significantly blocked the COVID-19 infection in infected patients.", citationType:"Elsevier", citationRef:"10.1016/j.jare.2020.03.005"}}, {start: {_id:1516}, end: {_id:407}, properties:{evidence:"These results show that blocking CD147 on the host cells has an inhibitory effect on SARS-CoV-2, suggesting an essential role of CD147 in facilitating SARS-CoV-2 invasion for host cells.", annotationCells:["Vero E6"], citationType:"biorvix", citationRef:"https://doi.org/10.1101/2020.03.14.988345"}}, {start: {_id:417}, end: {_id:386}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:418}, end: {_id:386}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:224}, end: {_id:386}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:420}, end: {_id:386}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:421}, end: {_id:386}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:423}, end: {_id:386}, properties:{evidence:"Several potential drug candidates, including lopinavir/ritonavir (Kaletra R), nucleoside analogues, neuraminidase inhibitors, remdesivir, umifenovir (Arbidol R), DNA synthesis inhibitors (such as tenofovir disoproxil and lamivudine), chloroquine and Chinese traditional medicines (such as ShuFeng JieDu or Lianhua Qing- wen capsules), have been proposed [36 , 37] .", pmid:"32081636", citationType:"PubMed", citationRef:"32081636"}}, {start: {_id:456}, end: {_id:430}, properties:{evidence:"Ribavirin is a nucleoside analogue with a broad-spectrum of antiviral effects. A study compared 111 patients with severe acute respiratory syndrome (SARS) treated with ribavirin monotherapy and 41 patients with SARS treated with lopinavir/ritonavir and ribavirin; patients treated with the combined therapy had a lower risk of acute respiratory distress syndrome (ARDS) and death (6).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:456}, end: {_id:429}, properties:{evidence:"Ribavirin is a nucleoside analogue with a broad-spectrum of antiviral effects. A study compared 111 patients with severe acute respiratory syndrome (SARS) treated with ribavirin monotherapy and 41 patients with SARS treated with lopinavir/ritonavir and ribavirin; patients treated with the combined therapy had a lower risk of acute respiratory distress syndrome (ARDS) and death (6).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:424}, end: {_id:386}, properties:{evidence:"Chloroquine is a widely used antimalarial that was found to be a potential broad-spectrum antiviral in 2006 (7). Chloroquine was found to block SARS-CoV-2 infection at low-micromolar concentration, with a half-maximal effective concentration (EC50) of 1.13 μM and a half- cytotoxic concentration (CC50) greater than 100 μM (8).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:420}, end: {_id:386}, properties:{evidence:"Arbidol is an antiviral that can be used to treat influenza virus. A study has revealed that arbidol can effectively inhibit SARS-CoV-2 infection at a concentration of 10-30 μM in vitro (9).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:224}, end: {_id:473}, properties:{evidence:"Remdesivir is a nucleoside analogue and a broad-spectrum antiviral. Animal experiments (13) indicated that remdesivir can effectively reduce the viral load in lung tissue of mice infected with MERS-CoV, improve lung function, and alleviate pathological damage to lung tissue.", annotationSpecies:["10090"], annotationMeshanatomy:["Lung"], pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:224}, end: {_id:2682}, properties:{evidence:"Remdesivir is a nucleoside analogue and a broad-spectrum antiviral. Animal experiments (13) indicated that remdesivir can effectively reduce the viral load in lung tissue of mice infected with MERS-CoV, improve lung function, and alleviate pathological damage to lung tissue.", annotationSpecies:["10090"], annotationMeshanatomy:["Lung"], pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:224}, end: {_id:386}, properties:{evidence:"Wang et al. found that remdesivir potently blocks SARS-CoV-2 infection at low-micromolar concentrations and has a high selectivity index (half-maximal effective concentration (EC50), 0.77 μM; half-cytotoxic concentration (CC50) > 100 μM; SI > 129.87) (8).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:477}, end: {_id:386}, properties:{evidence:"Studies have also revealed some other drugs may have potential efficacy in treating COVID-19. One is darunavir, which is a second- generation of HIV-1 protease inhibitor. On February 4, 2020, researchers in China announced that darunavir inhibited SARS-CoV-2 infection in vitro (9). Cell experiments indicated that darunavir significantly inhibited viral replication at a concentration of 300 μM in vitro and that its inhibition efficiency was 280-fold that in the untreated group (9).", pmid:"32147628", citationType:"PubMed", citationRef:"32147628"}}, {start: {_id:669}, end: {_id:2687}, properties:{evidence:"The other antiviral drugs include nitazoxanide, favipiravir, nafamostat, and so on (See Table 1 for details).", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:669}, end: {_id:711}, properties:{evidence:"The other antiviral drugs include nitazoxanide, favipiravir, nafamostat, and so on (See Table 1 for details).", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:461}, end: {_id:2687}, properties:{evidence:"The other antiviral drugs include nitazoxanide, favipiravir, nafamostat, and so on (See Table 1 for details).", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:420}, end: {_id:782}, properties:{evidence:"It appears that Arbidol treatment could improve the discharging rate and decrease the mortality rate (Table 5).The efficiency of antifungal agent and corticosteroids were also analyzed in Supplementary Table 1 and Table 2. Antifungal agent did not show influence on the outcome of COVID-19 patients. And use of corticosteroids were associated with a higher risk of death.", pmid:"32176772", citationType:"PubMed", citationRef:"32176772"}}, {start: {_id:424}, end: {_id:386}, properties:{evidence:"Recently, chloroquine was found to inhibit SARS-CoV-2 in vitro and its hydroxylated form has been proposed as a possible therapy to treat patients infected with SARS-CoV-2 [4,5].", pmid:"32179150", citationType:"PubMed", citationRef:"32179150"}}, {start: {_id:786}, end: {_id:386}, properties:{evidence:"Teicoplanin, a glycopeptide antibiotic routinely used to treat bacterial infection was found to be active in vitro against SARS-CoV, has joined the list of molecules that could be used as herapeutic arsenal against COVID-19 [7]", pmid:"32179150", citationType:"PubMed", citationRef:"32179150"}}, {start: {_id:1281}, end: {_id:386}, properties:{evidence:"SGs are induced by protein kinase R (PKR)-mediated phosphorylation of eIF2α upon viral dsRNA recognition [57]. Promoting G3BP aggregation via the eIF4A inhibitor Zotatafin [58,59] or reducing SG disassembly by Silmitasertib inhibition of CK2 [60] warrant investigation for treatment of SARS-CoV-2. The mTOR inhibitor rapamycin disrupts the binding of LARP1 to mTORC1 [61] and has been shown to reduce MERS infection by ∼60% in vitro [62], another drug that could be tested for repurposing.", citationType:"DOI", citationRef:"https://doi.org/10.1101/2020.03.22.002386"}}, {start: {_id:1487}, end: {_id:386}, properties:{evidence:"Therapeutic options include steroids, intravenous immunoglobulin, selective cytokine blockade (eg, anakinra or tocilizumab) and JAK inhibition.", citationType:"DOI", citationRef:"https://doi.org/10.1016/S0140-6736(20)30628-0"}}, {start: {_id:1488}, end: {_id:386}, properties:{evidence:"Therapeutic options include steroids, intravenous immunoglobulin, selective cytokine blockade (eg, anakinra or tocilizumab) and JAK inhibition.", citationType:"DOI", citationRef:"https://doi.org/10.1016/S0140-6736(20)30628-0"}}, {start: {_id:1477}, end: {_id:386}, properties:{evidence:"Therapeutic options include steroids, intravenous immunoglobulin, selective cytokine blockade (eg, anakinra or tocilizumab) and JAK inhibition.", citationType:"DOI", citationRef:"https://doi.org/10.1016/S0140-6736(20)30628-0"}}, {start: {_id:1479}, end: {_id:386}, properties:{evidence:"Therapeutic options include steroids, intravenous immunoglobulin, selective cytokine blockade (eg, anakinra or tocilizumab) and JAK inhibition.", citationType:"DOI", citationRef:"https://doi.org/10.1016/S0140-6736(20)30628-0"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:386}, end: {_id:1531}, properties:{evidence:"We observed that the proportion of the CD1C+_B dendritic cells (clusters 7, 13, and 30), CD8 cytotoxic T cells (cluster 9), and plasmacytoid dendritic cells (cluster 36) increased in patients with COVID-19, while the B cells (cluster 16) and CD4+ T helper cells (cluster 51）decreased in the COVID-19 patients compared to the normal controls, indicating that the number of specific clusters of immune cells adjusts to fight SARS-CoV-2 aggression.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1532}, properties:{evidence:"We observed that the proportion of the CD1C+_B dendritic cells (clusters 7, 13, and 30), CD8 cytotoxic T cells (cluster 9), and plasmacytoid dendritic cells (cluster 36) increased in patients with COVID-19, while the B cells (cluster 16) and CD4+ T helper cells (cluster 51）decreased in the COVID-19 patients compared to the normal controls, indicating that the number of specific clusters of immune cells adjusts to fight SARS-CoV-2 aggression.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1531}, properties:{evidence:"However, some other cell subtypes, including CD8 cytotoxic T cells (cluster 9), CD1C+_B dendritic cells (cluter 7, 13, 19, 30, 39), effector CD8+ memory T (Tem) cells (cluster 14), and CD141+CLEC9A+ dendritic cells (cluster 45), increased, suggesting the limited immune response existed.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1538}, properties:{evidence:"However, some other cell subtypes, including CD8 cytotoxic T cells (cluster 9), CD1C+_B dendritic cells (cluter 7, 13, 19, 30, 39), effector CD8+ memory T (Tem) cells (cluster 14), and CD141+CLEC9A+ dendritic cells (cluster 45), increased, suggesting the limited immune response existed.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1539}, properties:{evidence:"In the severe condition (patient 2), the proportion of 45 of the 56 cell types increased, which may suggest over-activation of immune cells, including CD8+ T cells (cluster 1, 4, 18, 28 etc.), CD8 cytotoxic T cells (cluster 1 and cluster 25), CD4+ cytotoxic T cells (cluster 8 and cluster 21), Naive CD8+ T cell (cluster 2), plasmacytoid dendritic cell (cluster 53), and others.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1540}, properties:{evidence:"In the severe condition (patient 2), the proportion of 45 of the 56 cell types increased, which may suggest over-activation of immune cells, including CD8+ T cells (cluster 1, 4, 18, 28 etc.), CD8 cytotoxic T cells (cluster 1 and cluster 25), CD4+ cytotoxic T cells (cluster 8 and cluster 21), Naive CD8+ T cell (cluster 2), plasmacytoid dendritic cell (cluster 53), and others.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1532}, properties:{evidence:"In the severe condition (patient 2), the proportion of 45 of the 56 cell types increased, which may suggest over-activation of immune cells, including CD8+ T cells (cluster 1, 4, 18, 28 etc.), CD8 cytotoxic T cells (cluster 1 and cluster 25), CD4+ cytotoxic T cells (cluster 8 and cluster 21), Naive CD8+ T cell (cluster 2), plasmacytoid dendritic cell (cluster 53), and others.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1538}, properties:{evidence:"In the cured patients, effector CD8+ memory T (Tem) cells (cluster 14), megakaryocyte progenitor cells (cluster 23), CD1C+_B dendritic cells (cluster 39), and CD141+CLEC9A+ dendritic cells (cluster 45) decreased significantly.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}, {start: {_id:386}, end: {_id:1541}, properties:{evidence:"In the cured patients, effector CD8+ memory T (Tem) cells (cluster 14), megakaryocyte progenitor cells (cluster 23), CD1C+_B dendritic cells (cluster 39), and CD141+CLEC9A+ dendritic cells (cluster 45) decreased significantly.", citationType:"medRxiv", citationRef:"10.1101/2020.03.15.20033472"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:174}, end: {_id:664}, properties:{evidence:"Moreover, chloroquine has immunomodulatory effects, suppressing the production/release of TNF-α and IL-6. It also works as a novel class of autophagy inhibitor [81], which may interfere with viral infection and replication.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:174}, end: {_id:665}, properties:{evidence:"Moreover, chloroquine has immunomodulatory effects, suppressing the production/release of TNF-α and IL-6. It also works as a novel class of autophagy inhibitor [81], which may interfere with viral infection and replication.", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:20}, end: {_id:21}, properties:{evidence:"The replicase gene consists of two open reading frames (ORF1a and ORF1b). Translation of ORF1a produces the polyprotein 1a (pp1a). Meanwhile, a ribosomal frameshifting occurs at the junction of ORF1a and ORF1b,allowing translation to continue onto ORF1b, producing a larger polyprotein 1ab (pp1ab;Brierley et al., 1987).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:22}, end: {_id:23}, properties:{evidence:"The replicase gene consists of two open reading frames (ORF1a and ORF1b). Translation of ORF1a produces the polyprotein 1a (pp1a). Meanwhile, a ribosomal frameshifting occurs at the junction of ORF1a and ORF1b,allowing translation to continue onto ORF1b, producing a larger polyprotein 1ab (pp1ab;Brierley et al., 1987).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:39}, end: {_id:12}, properties:{evidence:"The N proteins are translated in the cytoplasm and encapsidate the nascent progeny genomic RNA to form the nucleocapsids.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:90}, end: {_id:92}, properties:{evidence:"Besides PERK, three other kinases are known to phosphorylate eIF2α, namely the protein kinase RNA-activated (PKR), heme-regulated inhibitor kinase (HRI), and general control non-derepressible-2 (GCN2;Ron and Walter, 2007).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:93}, end: {_id:92}, properties:{evidence:"Besides PERK, three other kinases are known to phosphorylate eIF2α, namely the protein kinase RNA-activated (PKR), heme-regulated inhibitor kinase (HRI), and general control non-derepressible-2 (GCN2;Ron and Walter, 2007).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:94}, end: {_id:92}, properties:{evidence:"Besides PERK, three other kinases are known to phosphorylate eIF2α, namely the protein kinase RNA-activated (PKR), heme-regulated inhibitor kinase (HRI), and general control non-derepressible-2 (GCN2;Ron and Walter, 2007).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:105}, end: {_id:109}, properties:{evidence:"One of ATF4’s target genes is the growth arrest and DNA damage-inducible protein 153 (GADD153, also knownas C/EBP homologous protein, or CHOP). GADD153 induces the growth arrest and DNA damage-inducible protein 34 (GADD34), which recruits protein phosphatase 1 (PP1) to dephosphorylate eIF2α and release the translation block.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:109}, end: {_id:110}, properties:{evidence:"One of ATF4’s target genes is the growth arrest and DNA damage-inducible protein 153 (GADD153, also knownas C/EBP homologous protein, or CHOP). GADD153 induces the growth arrest and DNA damage-inducible protein 34 (GADD34), which recruits protein phosphatase 1 (PP1) to dephosphorylate eIF2α and release the translation block.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:111}, properties:{evidence:"One of ATF4’s target genes is the growth arrest and DNA damage-inducible protein 153 (GADD153, also knownas C/EBP homologous protein, or CHOP). GADD153 induces the growth arrest and DNA damage-inducible protein 34 (GADD34), which recruits protein phosphatase 1 (PP1) to dephosphorylate eIF2α and release the translation block.", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:109}, end: {_id:114}, properties:{evidence:"However, if ER stress persists, GADD153 can induce apoptosis by suppressing the anti-apoptotic protein B-cell lymphoma 2 (Bcl-2) and inducing the pro-apoptotic proteins such as Bcl-2-interacting mediator of cell death (Bim;Puthalakath et al., 2007). GADD153 also activates ER oxidoreductin-1α (ERO1α), which encodes an ER oxidase. The increase protein influx to a hyperoxidizing ER aggravates ER stress and induces apoptosis (Marciniak et al., 2004;Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:109}, end: {_id:115}, properties:{evidence:"However, if ER stress persists, GADD153 can induce apoptosis by suppressing the anti-apoptotic protein B-cell lymphoma 2 (Bcl-2) and inducing the pro-apoptotic proteins such as Bcl-2-interacting mediator of cell death (Bim;Puthalakath et al., 2007). GADD153 also activates ER oxidoreductin-1α (ERO1α), which encodes an ER oxidase. The increase protein influx to a hyperoxidizing ER aggravates ER stress and induces apoptosis (Marciniak et al., 2004;Figure 3).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:90}, end: {_id:109}, properties:{evidence:"The up-regulation of GADD153 was likely mediated by both PKR and PERK, since knock-down of either PKR or PERK by siRNA reduces IBV-induced GADD153 (Liaoet al., 2013).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:93}, end: {_id:109}, properties:{evidence:"The up-regulation of GADD153 was likely mediated by both PKR and PERK, since knock-down of either PKR or PERK by siRNA reduces IBV-induced GADD153 (Liaoet al., 2013).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:109}, end: {_id:129}, properties:{evidence:"The up-regulation of GADD153 promotes apoptosis in IBV-infected cells, possibly via inducing the pro-apoptotic protein tribbles-related protein 3 (TRIB3) and suppressing the pro-survival kinase extracellular signal-related kinase (ERK;Liaoet al., 2013).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:133}, properties:{evidence:"Interestingly, GADD34 expression did not significantly affect protein synthesis in DCs, but was shown to be crucial for the production of interferon β (IFN-β) and pro-inflammatory cytokines interleukin-6 (IL-6;Clavarino et al.,2012).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:110}, end: {_id:136}, properties:{evidence:"In contrast, GADD34 has also been shown to specify PP1 to dephosphorylate the TGF-β-activated kinase 1 (TAK1), thus negatively regulating the toll-like receptor (TLR) signal-ing and pro-inflammatory cytokines [IL-6 and TNF-α (Tumornecrosis factor alpha)] production in macrophages (Gu et al.,2014).", annotationCell:["macrophage"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:151}, end: {_id:149}, properties:{evidence:"Previous studies have shown that the mRNA and protein levels of DUSP1 are modulated by ER stress (Boutros et al., 2008;Li et al., 2011). ER stress-induced DUSP1 up-regulation is likely to be mediated by ATF3 in the PERK pathway, since knock-down of ATF3 significantly reduced DUSP1 induction in cells under ER stress (Gora et al., 2010).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:157}, end: {_id:177}, properties:{evidence:"Interestingly, an earlier onset and more significant apoptosis induction in IRE1-knockdown IBV-infected cells was observed, which is associated with hyperphosphorylation of pro-apoptotic kinase JNK and hypophosphorylation of pro-survival kinase RAC-alpha serine/threonine-protein kinase (Akt).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:197}, end: {_id:199}, properties:{evidence:"Under ER stress, ATF6 is translocated from the ER to the Golgi apparatus and cleaved by protease S1P and S2P (Haze et al., 1999).", annotationMeshanatomy:["Golgi Apparatus"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:200}, end: {_id:199}, properties:{evidence:"Under ER stress, ATF6 is translocated from the ER to the Golgi apparatus and cleaved by protease S1P and S2P (Haze et al., 1999).", annotationMeshanatomy:["Golgi Apparatus"], pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:212}, end: {_id:199}, properties:{evidence:"On the other hand, the accessory protein 8ab of SARS-CoV has been identified to induce ATF6 activation (Sung et al.,2009). ATF6 cleavage and nuclear translocation was observed in cells transfected with SARS-CoV 8ab (Sung et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:212}, end: {_id:214}, properties:{evidence:"On the other hand, the accessory protein 8ab of SARS-CoV has been identified to induce ATF6 activation (Sung et al.,2009). ATF6 cleavage and nuclear translocation was observed in cells transfected with SARS-CoV 8ab (Sung et al., 2009).", pmid:"24987391", citationType:"PubMed", citationRef:"24987391"}}, {start: {_id:646}, end: {_id:653}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain-containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMed", citationRef:"32169119"}}, {start: {_id:646}, end: {_id:654}, properties:{evidence:"These complex signalling recruit adaptors, including TIR-domain-containing adaptor protein including IFN-β (TRIF), mitochondrial antiviral-signalling protein (MAVS) [64] and stimulator of interferon genes protein (STING) [65] to trigger downstream cascades molecules, involving adaptor molecule MyD88 and lead to the activation of the transcription factor nuclear factor-κB (NF-κB) and interferon regulatory factor 3 (IRF3) and the production of type I Interferons (IFN-α /β) and a series of pro-inflammatory cytokines [66].", pmid:"32169119", citationType:"PubMe