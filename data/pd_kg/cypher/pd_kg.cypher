UNWIND [{start: {_id:468}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:470}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Innate immune system subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:529}, end: {_id:533}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consistent with this, blocking the cAMP/PKA pathway resulted in reduced GSK-3 beta, phosphorylation and increased cell death, further suggesting that Ucn 1-induced GSK-3 beta phosphorylation-dependent neuroprotection is mediated by a rise in intracellular levels of cAMP.", citationTitle:"Int J Biochem Cell Biol. 2015 Mar;60C:130-138. doi: 10.1016/j.biocel.2014.12.005. Epub 2014 Dec 23.", annotationSubgraph:["Innate immune system subgraph", "GSK3 subgraph"], pmid:"25541373", citationType:"PubMed", citationRef:"25541373"}}, {start: {_id:325}, end: {_id:137}, properties:{evidence:"The loss of UCHL1's DUB activity results in an accumulation of alpha- synuclein at presynaptic terminals rather than increased clearance.", citationTitle:"Front Mol Neurosci. 2014 Jul 8;7:63. doi: 10.3389/fnmol.2014.00063. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25071440", citationType:"PubMed", citationRef:"25071440"}}, {start: {_id:196}, end: {_id:599}, properties:{evidence:"Notably, postmortem analysis of brains from PD patients carrying the G2019S mutation in the kinase domain of LRRK2 has shown marked increase in phosphorylated PRDX3 compared to normal brains .", citationTitle:"J Parkinsons Dis. 2013;3(4):461-91. doi: 10.3233/JPD-130230.", annotationSubgraph:["LRRK2 subgraph", "Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Serum"], pmid:"24252804", citationType:"PubMed", citationRef:"24252804"}}, {start: {_id:617}, end: {_id:618}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Conversely, DJ-1 knockdown in SH-SY5Y cells and DJ-1 knockout in mice result in significant decrease in Trx1 protein and mRNA expression levels.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Chaperone subgraph"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:617}, end: {_id:618}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additionally, knockdown of Trx1 significantly abrogates DJ-1-dependent, hydrogen peroxide-induced activation of the pro- survival factor AKT. Promoter analysis of the human Trx1 gene identified an antioxidant response element (ARE) that is required for DJ-1-dependent induction of Trx1 expression.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Chaperone subgraph"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:617}, end: {_id:621}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The transcription factor Nuclear factor erythroid-2 related factor 2 (Nrf2), which is a critical inducer of ARE-mediated expression, is regulated by DJ-1.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Chaperone subgraph", "Notch signaling subgraph"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:621}, end: {_id:617}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These findings provide a new mechanism to support the antioxidant function of DJ-1 by increasing Trx1 expression via Nrf2-mediated transcriptional induction.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Chaperone subgraph", "Notch signaling subgraph"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:617}, end: {_id:618}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These findings provide a new mechanism to support the antioxidant function of DJ-1 by increasing Trx1 expression via Nrf2-mediated transcriptional induction.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Chaperone subgraph"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:621}, end: {_id:628}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Nrf2(-/-) microglia failed to activate the expression of two anti- inflammatory genes, heme oxygenase-1 (HO-1) and nicotinamide adenine dinucleotide phosphate quinone oxidorreductase-1 (NQO1)", citationTitle:"Human molecular genetics; Vol. 21; Iss. 14", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"22513881", citationType:"PubMed", citationRef:"22513881"}}, {start: {_id:621}, end: {_id:691}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Nrf2(-/-) microglia failed to activate the expression of two anti- inflammatory genes, heme oxygenase-1 (HO-1) and nicotinamide adenine dinucleotide phosphate quinone oxidorreductase-1 (NQO1)", citationTitle:"Human molecular genetics; Vol. 21; Iss. 14", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"22513881", citationType:"PubMed", citationRef:"22513881"}}, {start: {_id:196}, end: {_id:787}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moesin was efficiently phosphorylated by the G2019S variant of LRRK2 at Thr558, a previously characterized physiologically relevant phosphorylation site, which when phosphorylated enables moesin binding to F-actin (Huang et al. 1999; Jaleel et al. 2007).", citationTitle:"J Neurosci Res. 2009 May 1;87(6):1283-95. doi: 10.1002/jnr.21949.", annotationSubgraph:["Regulation of cytoskeleton subgraph", "LRRK2 subgraph"], pmid:"19025767", citationType:"PubMed", citationRef:"19025767"}}, {start: {_id:806}, end: {_id:807}, properties:{annotationCondition:["Normal Healthy State"], evidence:"MARK2 phosphorylates and activates the PINK1 .", citationTitle:"Oxid Med Cell Longev. 2013;2013:601587. doi: 10.1155/2013/601587. Epub 2013 Feb 27.", annotationSubgraph:["MAPK subgraph", "PINK1 subgraph"], pmid:"23533695", citationType:"PubMed", citationRef:"23533695"}}, {start: {_id:221}, end: {_id:816}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our findings suggest that both insect as well as human PINK1 directly phosphorylate a highly conserved serine residue (Ser65) lying within the N-terminal Ubiquitin-like (Ubl) domain.", citationTitle:"Open Biol. 2012 May;2(5):120080. doi: 10.1098/rsob.120080.", annotationSubgraph:["Regulation of cytoskeleton subgraph", "PINK1 subgraph"], pmid:"22724072", citationType:"PubMed", citationRef:"22724072"}}, {start: {_id:221}, end: {_id:826}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here we report the identification of the PINK1 cleavage site at position A103 to produce the 53 kDa ŒîN-PINK1 protein.", citationTitle:"Hum Mol Genet. 2011 Mar 1;20(5):867-79. doi: 10.1093/hmg/ddq526. Epub 2010 Dec 6.", annotationSubgraph:["PINK1 subgraph"], pmid:"21138942", citationType:"PubMed", citationRef:"21138942"}}, {start: {_id:828}, end: {_id:826}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutation of the F104 residue at the P‚Ä≤-position to either aspartic acid or alanine had a significant effect on the production of ŒîN- PINK1. When residue F104 was converted to an aspartic acid (F104D), we observed an accumulation of both FL- and ŒîN-PINK1 protein in cells compared with PINK1-wt (Fig. 2A, lane 4). In contrast, conversion of this residue to alanine (F104A) resulted in a decrease in FL- PINK1 protein expression combined with an accumulation of ŒîN-PINK1 (Fig. 2A, lane 5).", citationTitle:"Hum Mol Genet. 2011 Mar 1;20(5):867-79. doi: 10.1093/hmg/ddq526. Epub 2010 Dec 6.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21138942", citationType:"PubMed", citationRef:"21138942"}}, {start: {_id:828}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutation of the F104 residue at the P‚Ä≤-position to either aspartic acid or alanine had a significant effect on the production of ŒîN- PINK1. When residue F104 was converted to an aspartic acid (F104D), we observed an accumulation of both FL- and ŒîN-PINK1 protein in cells compared with PINK1-wt (Fig. 2A, lane 4). In contrast, conversion of this residue to alanine (F104A) resulted in a decrease in FL- PINK1 protein expression combined with an accumulation of ŒîN-PINK1 (Fig. 2A, lane 5).", citationTitle:"Hum Mol Genet. 2011 Mar 1;20(5):867-79. doi: 10.1093/hmg/ddq526. Epub 2010 Dec 6.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21138942", citationType:"PubMed", citationRef:"21138942"}}, {start: {_id:830}, end: {_id:826}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutation of the F104 residue at the P‚Ä≤-position to either aspartic acid or alanine had a significant effect on the production of ŒîN- PINK1. When residue F104 was converted to an aspartic acid (F104D), we observed an accumulation of both FL- and ŒîN-PINK1 protein in cells compared with PINK1-wt (Fig. 2A, lane 4). In contrast, conversion of this residue to alanine (F104A) resulted in a decrease in FL- PINK1 protein expression combined with an accumulation of ŒîN-PINK1 (Fig. 2A, lane 5).", citationTitle:"Hum Mol Genet. 2011 Mar 1;20(5):867-79. doi: 10.1093/hmg/ddq526. Epub 2010 Dec 6.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21138942", citationType:"PubMed", citationRef:"21138942"}}, {start: {_id:444}, end: {_id:427}, properties:{evidence:"Further characterization showed that alpha-syn-pS129 was increased upon knockdown of the PP2A catalytic subunit and when PP2A enzyme is methylated.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph", "Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:439}, end: {_id:906}, properties:{evidence:"These findings suggest the hypothesis that PP2A, rather than PP1, is the phosphatase system regulating R1441G LRRK2 at S1292.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["LRRK2 subgraph", "Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:76}, end: {_id:75}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central nervous system (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:73}, end: {_id:61}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central nervous system (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:76}, end: {_id:61}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central nervous system (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:934}, end: {_id:935}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we investigate the role of Hepatocyte growth factor-Regulated tyrosine kinase Substrate (Hrs), a regulator of RTK trafficking, in VEGF and insulin signaling. We report that ectopic expression of Hrs increases VEGF-R2 and IR number and tyrosine phosphorylation, leading to amplification of their downstream signaling. The UIM (Ubiquitin Interacting Motif) domain of Hrs is required for Hrs-induced increases in VEGF-R2, but not in IR. Furthermore, Hrs is tyrosine-phosphorylated in response to VEGF and insulin. We show that the UIM domain is required for Hrs phosphorylation in response to VEGF, but not to insulin. Importantly, Hrs co-localizes with both VEGF-R2 and IR and co-immunoprecipitates with both in a manner independent of the Hrs-UIM domain. Finally, we demonstrate that Hrs inhibits Nedd4-mediated VEGF-R2 degradation and acts additively with Grb10. We conclude that Hrs is a positive regulator of VEGF-R2 and IR signaling and that ectopic expression of Hrs protects both VEGF-R2 and IR from degradation.", citationTitle:"Exp Cell Res. 2007 May 15;313(9):1927-42. Epub 2007 Mar 21.", annotationSubgraph:["Cytokine signaling subgraph", "Vascular endothelial growth factor subgraph"], pmid:"17445799", citationType:"PubMed", citationRef:"17445799"}}, {start: {_id:934}, end: {_id:937}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we investigate the role of Hepatocyte growth factor-Regulated tyrosine kinase Substrate (Hrs), a regulator of RTK trafficking, in VEGF and insulin signaling. We report that ectopic expression of Hrs increases VEGF-R2 and IR number and tyrosine phosphorylation, leading to amplification of their downstream signaling. The UIM (Ubiquitin Interacting Motif) domain of Hrs is required for Hrs-induced increases in VEGF-R2, but not in IR. Furthermore, Hrs is tyrosine-phosphorylated in response to VEGF and insulin. We show that the UIM domain is required for Hrs phosphorylation in response to VEGF, but not to insulin. Importantly, Hrs co-localizes with both VEGF-R2 and IR and co-immunoprecipitates with both in a manner independent of the Hrs-UIM domain. Finally, we demonstrate that Hrs inhibits Nedd4-mediated VEGF-R2 degradation and acts additively with Grb10. We conclude that Hrs is a positive regulator of VEGF-R2 and IR signaling and that ectopic expression of Hrs protects both VEGF-R2 and IR from degradation.", citationTitle:"Exp Cell Res. 2007 May 15;313(9):1927-42. Epub 2007 Mar 21.", annotationSubgraph:["Cytokine signaling subgraph", "Vascular endothelial growth factor subgraph"], pmid:"17445799", citationType:"PubMed", citationRef:"17445799"}}, {start: {_id:934}, end: {_id:66}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we investigate the role of Hepatocyte growth factor-Regulated tyrosine kinase Substrate (Hrs), a regulator of RTK trafficking, in VEGF and insulin signaling. We report that ectopic expression of Hrs increases VEGF-R2 and IR number and tyrosine phosphorylation, leading to amplification of their downstream signaling. The UIM (Ubiquitin Interacting Motif) domain of Hrs is required for Hrs-induced increases in VEGF-R2, but not in IR. Furthermore, Hrs is tyrosine-phosphorylated in response to VEGF and insulin. We show that the UIM domain is required for Hrs phosphorylation in response to VEGF, but not to insulin. Importantly, Hrs co-localizes with both VEGF-R2 and IR and co-immunoprecipitates with both in a manner independent of the Hrs-UIM domain. Finally, we demonstrate that Hrs inhibits Nedd4-mediated VEGF-R2 degradation and acts additively with Grb10. We conclude that Hrs is a positive regulator of VEGF-R2 and IR signaling and that ectopic expression of Hrs protects both VEGF-R2 and IR from degradation.", citationTitle:"Exp Cell Res. 2007 May 15;313(9):1927-42. Epub 2007 Mar 21.", annotationSubgraph:["Cytokine signaling subgraph", "Insulin signal transduction"], pmid:"17445799", citationType:"PubMed", citationRef:"17445799"}}, {start: {_id:942}, end: {_id:109}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we show that Mind bomb (Mib), a ubiquitin ligase that promotes Notch ligand trafficking and activity, is a crucial molecular substrate for PAR-1. The phosphorylation of Mib by PAR-1 results in Mib degradation, repression of Notch signaling, and stimulation of neuronal differentiation.", citationTitle:"Dev Cell. 2009 Aug;17(2):222-33. doi: 10.1016/j.devcel.2009.06.010.", annotationSubgraph:["Notch signaling subgraph"], pmid:"19686683", citationType:"PubMed", citationRef:"19686683"}}, {start: {_id:137}, end: {_id:138}, properties:{evidence:"The mDA neurons from both twins had 50% GBA enzymatic activity, âˆšÂ¢Ã€ÃœÂ¬Âº3-fold elevated âˆšÃ©Â¬Â±-synuclein protein levels, and a reduced capacity to synthesize and release dopamine. Interestingly, the affected twin's neurons showed an even lower dopamine level, increased monoamine oxidase B (MAO-B) expression, and impaired intrinsic network activity.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1173-82. doi: 10.1016/j.celrep.2014.10.023. Epub 2014 Nov 6.", annotationSubgraph:["Mitochondrial subgraph", "Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456120", citationType:"PubMed", citationRef:"25456120"}}, {start: {_id:967}, end: {_id:966}, properties:{annotationBrco:["Cortical Neuron"], evidence:"STAT3 was previously shown to be activated by oncogenic RET, independent of ligand and GFRâˆšÃ©Â¬Â±. In this study, we demonstrated that NRTN induced serine(727) but not tyrosine(705) phosphorylation of STAT3 in primary cortical neuron and neuronal cell lines. Remarkably, STAT3 phosphorylation was found to be mediated specifically by GFRâˆšÃ©Â¬Â±2c and RET9 isoforms.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:416}, end: {_id:969}, properties:{annotationBrco:["Cortical Neuron"], evidence:"STAT3 was previously shown to be activated by oncogenic RET, independent of ligand and GFRâˆšÃ©Â¬Â±. In this study, we demonstrated that NRTN induced serine(727) but not tyrosine(705) phosphorylation of STAT3 in primary cortical neuron and neuronal cell lines. Remarkably, STAT3 phosphorylation was found to be mediated specifically by GFRâˆšÃ©Â¬Â±2c and RET9 isoforms.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:416}, end: {_id:962}, properties:{annotationBrco:["Cortical Neuron"], evidence:"STAT3 was previously shown to be activated by oncogenic RET, independent of ligand and GFRâˆšÃ©Â¬Â±. In this study, we demonstrated that NRTN induced serine(727) but not tyrosine(705) phosphorylation of STAT3 in primary cortical neuron and neuronal cell lines. Remarkably, STAT3 phosphorylation was found to be mediated specifically by GFRâˆšÃ©Â¬Â±2c and RET9 isoforms.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:962}, end: {_id:969}, properties:{annotationBrco:["Cortical Neuron"], evidence:"STAT3 was previously shown to be activated by oncogenic RET, independent of ligand and GFRâˆšÃ©Â¬Â±. In this study, we demonstrated that NRTN induced serine(727) but not tyrosine(705) phosphorylation of STAT3 in primary cortical neuron and neuronal cell lines. Remarkably, STAT3 phosphorylation was found to be mediated specifically by GFRâˆšÃ©Â¬Â±2c and RET9 isoforms.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:416}, end: {_id:966}, properties:{annotationBrco:["Cortical Neuron"], evidence:"STAT3 was previously shown to be activated by oncogenic RET, independent of ligand and GFRâˆšÃ©Â¬Â±. In this study, we demonstrated that NRTN induced serine(727) but not tyrosine(705) phosphorylation of STAT3 in primary cortical neuron and neuronal cell lines. Remarkably, STAT3 phosphorylation was found to be mediated specifically by GFRâˆšÃ©Â¬Â±2c and RET9 isoforms.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:966}, end: {_id:969}, properties:{annotationBrco:["Cortical Neuron"], evidence:"STAT3 was previously shown to be activated by oncogenic RET, independent of ligand and GFRâˆšÃ©Â¬Â±. In this study, we demonstrated that NRTN induced serine(727) but not tyrosine(705) phosphorylation of STAT3 in primary cortical neuron and neuronal cell lines. Remarkably, STAT3 phosphorylation was found to be mediated specifically by GFRâˆšÃ©Â¬Â±2c and RET9 isoforms.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:970}, end: {_id:969}, properties:{annotationBrco:["Cortical Neuron"], evidence:"Similar to NGF, the NRTN induced P-Ser-STAT3 was localized to the mitochondria but not to the nucleus. Mitochondrial STAT3 was further found to be intimately involved in NRTN induced neurite outgrowth. Collectively, these findings demonstrated the hitherto unrecognized and novel role of specific GFRâˆšÃ©Â¬Â±2 and RET isoforms in mediating NRTN activation of STAT3 and the transcription independent mechanism whereby the mitochondria localized P-Ser-STAT3 mediated NRTN induced neurite outgrowth.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:416}, end: {_id:969}, properties:{annotationBrco:["Cortical Neuron"], evidence:"Similar to NGF, the NRTN induced P-Ser-STAT3 was localized to the mitochondria but not to the nucleus. Mitochondrial STAT3 was further found to be intimately involved in NRTN induced neurite outgrowth. Collectively, these findings demonstrated the hitherto unrecognized and novel role of specific GFRâˆšÃ©Â¬Â±2 and RET isoforms in mediating NRTN activation of STAT3 and the transcription independent mechanism whereby the mitochondria localized P-Ser-STAT3 mediated NRTN induced neurite outgrowth.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:1030}, end: {_id:1009}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Brain-derived neurotrophic factor (BDNF) is well known to be capable of inducing the synthesis of activity-regulated cytoskeleton- associated protein (Arc), which plays a fundamental role in modulating synaptic plasticity.", citationTitle:"J Neurosci Res. 2009 Aug 1;87(10):2297-307. doi: 10.1002/jnr.22057.", pmid:"19301428", citationType:"PubMed", citationRef:"19301428"}}, {start: {_id:970}, end: {_id:1039}, properties:{evidence:"Na(v)1.7 sodium channels can amplify weak stimuli in neurons and act as threshold channels for firing action potentials. Neurotrophic factors and pro-nociceptive cytokines that are released during development and under pathological conditions activate mitogen- activated protein kinases (MAPKs). Previous studies have shown that MAPKs can transduce developmental or pathological signals by regulating transcription factors that initiate a gene expression response, a long-term effect, and directly modulate neuronal ion channels including sodium channels, thus acutely regulating dorsal root ganglion (DRG) neuron excitability. For example, neurotrophic growth factor activates (phosphorylates) ERK1/2 MAPK (pERK1/2) in DRG neurons, an effect that has been implicated in injury-induced hyperalgesia. However, the acute effects of pERK1/2 on sodium channels are not known. We have shown previously that activated p38 MAPK (pp38) directly phosphorylates Na(v)1.6 and Na(v)1.8 sodium channels and regulates their current densities without altering their gating properties. We now report that acute inhibition of pERK1/2 regulates resting membrane potential and firing properties of DRG neurons. We also show that pERK1 phosphorylates specific residues within L1 of Na(v)1.7, inhibition of pERK1/2 causes a depolarizing shift of activation and fast inactivation of Na(v)1.7 without altering current density, and mutation of these L1 phosphoacceptor sites abrogates the effect of pERK1/2 on this channel. Together, these data are consistent with direct phosphorylation and modulation of Na(v)1.7 by pERK1/2, which unlike the modulation of Na(v)1.6 and Na(v)1.8 by pp38, regulates gating properties of this channel but not its current density and contributes to the effects of MAPKs on DRG neuron excitability.", citationTitle:"J Neurosci. 2010 Feb 3;30(5):1637-47. doi: 10.1523/JNEUROSCI.4872-09.2010.", annotationMeshdisease:["Hyperglycemia"], pmid:"20130174", citationType:"PubMed", citationRef:"20130174"}}, {start: {_id:1052}, end: {_id:1053}, properties:{annotationCondition:["Normal Healthy State"], evidence:"that D(1) dopamine receptor stimulation increased phosphorylation of GABA(A) receptor beta1/beta3 subunits", citationTitle:"J Neurophysiol. 2000 May;83(5):2996-3004.", annotationSubgraph:["GABA subgraph", "Dopaminergic subgraph"], pmid:"10805695", citationType:"PubMed", citationRef:"10805695"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1054}, end: {_id:1053}, properties:{annotationCondition:["Normal Healthy State"], evidence:"that D(1) dopamine receptor stimulation increased phosphorylation of GABA(A) receptor beta1/beta3 subunits", citationTitle:"J Neurophysiol. 2000 May;83(5):2996-3004.", annotationSubgraph:["GABA subgraph", "Dopaminergic subgraph"], pmid:"10805695", citationType:"PubMed", citationRef:"10805695"}}, {start: {_id:1057}, end: {_id:1055}, properties:{evidence:"Oligophrenin-1 (OPHN1) encodes a Rho-GTPase-activating protein (Rho- GAP) whose loss of function causes X-linked mental retardation.", citationTitle:"Curr Biol. 2009 Jul 14;19(13):1133-9. doi: 10.1016/j.cub.2009.05.022. Epub 2009 May 28.", annotationSubgraph:["Regulation of cytoskeleton subgraph", "RhoA subgraph"], annotationMeshdisease:["Mental Retardation, X-Linked"], pmid:"19481455", citationType:"PubMed", citationRef:"19481455"}}, {start: {_id:1060}, end: {_id:1062}, properties:{evidence:"In the Fyn knockout mice, basal tyrosine phosphorylation of NR2A and NR2B was drastically reduced, whereas serine phosphorylation of these NMDA subunits was unchanged.", citationComment:"Dopamine D1-dependent trafficking of striatal N-methyl-D-aspartate glutamate receptors requires Fyn protein tyrosine kinase but not DARPP-32.", citationTitle:"Molecular pharmacology; Vol. 65; Iss. 1", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "G-protein-mediated signaling"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2004-01-01", pmid:"14722243", citationAuthorList:"Anthone W Dunah|Ana C Sirianni|Allen A Fienberg|Elena Bastia|Michael A Schwarzschild|David G Standaert", citationType:"PubMed", citationRef:"14722243"}}, {start: {_id:1060}, end: {_id:1063}, properties:{evidence:"In the Fyn knockout mice, basal tyrosine phosphorylation of NR2A and NR2B was drastically reduced, whereas serine phosphorylation of these NMDA subunits was unchanged.", citationComment:"Dopamine D1-dependent trafficking of striatal N-methyl-D-aspartate glutamate receptors requires Fyn protein tyrosine kinase but not DARPP-32.", citationTitle:"Molecular pharmacology; Vol. 65; Iss. 1", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "G-protein-mediated signaling"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2004-01-01", pmid:"14722243", citationAuthorList:"Anthone W Dunah|Ana C Sirianni|Allen A Fienberg|Elena Bastia|Michael A Schwarzschild|David G Standaert", citationType:"PubMed", citationRef:"14722243"}}, {start: {_id:1060}, end: {_id:1064}, properties:{evidence:"In the Fyn knockout mice, the dopamine D1 receptor agonist failed to induce subcellular redistribution of NMDA receptors.", citationComment:"Dopamine D1-dependent trafficking of striatal N-methyl-D-aspartate glutamate receptors requires Fyn protein tyrosine kinase but not DARPP-32.", citationTitle:"Molecular pharmacology; Vol. 65; Iss. 1", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2004-01-01", pmid:"14722243", citationAuthorList:"Anthone W Dunah|Ana C Sirianni|Allen A Fienberg|Elena Bastia|Michael A Schwarzschild|David G Standaert", citationType:"PubMed", citationRef:"14722243"}}, {start: {_id:1077}, end: {_id:271}, properties:{evidence:"Treatment of cells with EGF stimulates parkin binding to both Eps15 and the EGFR and promotes parkin-mediated ubiquitination of Eps15.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Ubiquitin subgraph", "Akt/mTOR subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:271}, end: {_id:1081}, properties:{evidence:"Treatment of cells with EGF stimulates parkin binding to both Eps15 and the EGFR and promotes parkin-mediated ubiquitination of Eps15.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Akt/mTOR subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:1081}, end: {_id:271}, properties:{evidence:"We propose that by ubiquitinating Eps15, parkin interferes with the ability of the Eps15 UIMs to bind ubiquitinated EGFR, thereby delaying EGFR internalization and degradation, and promoting PI(3)K-Akt signalling.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:137}, end: {_id:1103}, properties:{evidence:"In addition, PD-related insults including, mitochondrial complex I inhibition, oxidative stress, and increased alpha-synuclein expression specifically increased endogenous FAF1 expression in vitro.", citationComment:"Fas-associated factor 1 and Parkinson's disease.", citationTitle:"Neurobiology of disease; Vol. 31; Iss. 3", annotationSubgraph:["Apoptosis signaling subgraph", "Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2008-09-01", pmid:"18573343", citationAuthorList:"Ranjita Betarbet|Leah R Anderson|Marla Gearing|Tiffany R Hodges|Jason J Fritz|James J Lah|Allan I Levey", citationType:"PubMed", citationRef:"18573343"}}, {start: {_id:1072}, end: {_id:404}, properties:{evidence:"We found that overexpression of Mtmr2 prevents the degradation of the epidermal growth factor receptor (EGFR) and leads to sustained Akt activation whereas Erk activation is not affected.", citationComment:"The CMT4B disease-causing proteins MTMR2 and MTMR13/SBF2 regulate AKT signalling.", citationTitle:"Journal of cellular and molecular medicine; Vol. 15; Iss. 2", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "Akt/mTOR subgraph"], annotationMeshdisease:["Charcot-Marie-Tooth Disease"], citationPubDate:"2011-02-01", pmid:"19912440", citationAuthorList:"Philipp Berger|Kristian Tersar|Kurt Ballmer-Hofer|Ueli Suter", citationType:"PubMed", citationRef:"19912440"}}, {start: {_id:1113}, end: {_id:1114}, properties:{evidence:"To date, three myelin-associated proteins [Nogo or reticulon 4 (RTN4), myelin-associated glycoprotein (MAG) and oligodendrocyte myelin glycoprotein (OMG)] are known to inhibit axonal regeneration via activation of the neuronal glycosylphosphatidylinositol-anchored Nogo receptor [NgR, together with p75 neurotrophin receptor (p75NTR) and Lingo-1].", citationComment:"The novel protein MANI modulates neurogenesis and neurite-cone growth.", citationTit