UNWIND [{start: {_id:615}, end: {_id:365}, properties:{evidence:"Our findings enhance the understanding of the neuro-protective effects of edaravone in cell models and suggest that edaravone offers significant protection in a PD-related in vitro model.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 51; Iss. 2", annotationMeshdisease:["Parkinson Disease"], pmid:"23657982", annotationCellline:["Neuro-2a cell"], citationType:"PubMed", citationRef:"23657982"}}, {start: {_id:44}, end: {_id:719}, properties:{evidence:"This is because dopaminergic neurons in the substantia nigra are chronically exposed to oxidative stress caused by high levels of iron and autooxidation of dopamine.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Reactive oxygen species subgraph", "Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra", "Dopaminergic Neurons"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:856}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We conclude that dietary vitamin E may have a neuroprotective effect attenuating the risk of PD.", citationTitle:"Intake of vitamin E, vitamin C, and carotenoids and the risk of Parkinson's disease: a meta-analysis. 2005 Jun;4(6):362-5.", pmid:"15907740", citationType:"PubMed", citationRef:"15907740"}}, {start: {_id:858}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our findings indicate that higher coffee and caffeine intake is associated with a significantly lower incidence of PD.", citationTitle:"Association of coffee and caffeine intake with the risk of Parkinson disease. 2000 May 24-31;283(20):2674-9.", pmid:"10819950", citationType:"PubMed", citationRef:"10819950"}}, {start: {_id:859}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The results are consistent with the suggestion that high vitamin D status provides protection against Parkinson disease.", citationTitle:"Serum vitamin D and the risk of Parkinson disease. 2010 Jul;67(7):808-11. doi: 10.1001/archneurol.2010.120.", annotationMeshanatomy:["Serum"], pmid:"20625085", citationType:"PubMed", citationRef:"20625085"}}, {start: {_id:873}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Greater adherence to a Mediterranean diet is associated with a significant improvement in health status, as seen by a significant reduction in overall mortality (9%), mortality from cardiovascular diseases (9%), incidence of or mortality from cancer (6%), and incidence of Parkinson's disease and Alzheimer's disease (13%).", citationTitle:"BMJ. 2008 Sep 11;337:a1344. doi: 10.1136/bmj.a1344.", pmid:"18786971", citationType:"PubMed", citationRef:"18786971"}}, {start: {_id:866}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Higher serum and cerebrospinal fluid urate concentrations at baseline were associated with slower rates of clinical decline. The findings strengthen the link between urate concentration and PD and the rationale for considering central nervous system urate concentration elevation as a potential strategy to slow PD progression.", citationTitle:"Urate as a predictor of the rate of clinical decline in Parkinson disease. Arch Neurol. 2009 Dec;66(12):1460-8. doi: 10.1001/archneurol.2009.247.", annotationMeshanatomy:["Central Nervous System"], pmid:"19822770", citationType:"PubMed", citationRef:"19822770"}}, {start: {_id:880}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Higher serum and cerebrospinal fluid urate concentrations at baseline were associated with slower rates of clinical decline. The findings strengthen the link between urate concentration and PD and the rationale for considering central nervous system urate concentration elevation as a potential strategy to slow PD progression.", citationTitle:"Urate as a predictor of the rate of clinical decline in Parkinson disease. Arch Neurol. 2009 Dec;66(12):1460-8. doi: 10.1001/archneurol.2009.247.", annotationMeshanatomy:["Central Nervous System"], pmid:"19822770", citationType:"PubMed", citationRef:"19822770"}}, {start: {_id:884}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Smoking, alcohol and exercise may increase or decrease risk of aging brain disorders, especially dementia and Parkinson's disease, while stress is consistently associated with increased risk and a prudent diet is consistently associated with reduced risk.", citationTitle:"Hum Reprod Update. 2011 Sep-Oct;17(5):706-17. doi: 10.1093/humupd/dmr020. Epub 2011 May 11.", pmid:"21565809", citationType:"PubMed", citationRef:"21565809"}}, {start: {_id:891}, end: {_id:892}, properties:{evidence:"regular intake of probiotics can significantly improve stool consistency and bowel habits in Parkinson's disease patients.", citationTitle:"Minerva Gastroenterol Dietol. 2011 Jun;57(2):117-21.", annotationMeshdisease:["Parkinson Disease"], pmid:"21587143", citationType:"PubMed", citationRef:"21587143"}}, {start: {_id:894}, end: {_id:16}, properties:{evidence:"our results suggest OXY, a dietary phenolic compound, as a potential NTNal candidate for protection against neurodegeneration in PD.", citationTitle:"Free Radic Biol Med. 2008 Oct 1;45(7):1019-26. doi: 10.1016/j.freeradbiomed.2008.07.002. Epub 2008 Jul 16.", annotationSpecies:["10116"], annotationMeshdisease:["Parkinson Disease"], pmid:"18675900", citationType:"PubMed", citationRef:"18675900"}}, {start: {_id:44}, end: {_id:1178}, properties:{evidence:"The patients with SWEDDs have less non-motor problems than newly diagnosed untreated PD patients. Given the difficulty distinguishing between SWEDDs and early PD, identifying some of non-motor symptoms, such as RBD or olfactory impairment, could aid clinicians in their work.", citationTitle:"Parkinsonism Relat Disord. 2014 Dec;20(12):1419-22.", annotationMeshdisease:["Parkinson Disease"], pmid:"22446342", citationType:"PubMed", citationRef:"22446342"}}, {start: {_id:1322}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is apparent that the mechanism of neuroprotection of HDACIs is likely to be multi-targeted. Given the multi-faceted origins of PD pathogenesis, HDACIs(Histone deacetylase inhibitors) seem like an optimistic candidate for therapy. These results highlight a novel mechanism whereby this HDACI induces neuroprotection and underscores the potential use of HDACIs such as TSA(Trichostatin A) in preventing inflammation-related neurodegenerative disorders such as PD", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1746}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Heix/UBIAD1 produces vitamin K2, and in our studies vitamin K2 rescued mitochondrial defects in numerous conditions that affect mitochondrial function.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:2162}, end: {_id:2166}, properties:{evidence:"Feeding 7-oxo-DHEA decreased body weight gain of rats, increased liver mass, catalase activity (/67%), and fatty acyl CoA oxidase (/128%) (Table I) as does DHEA (4).", annotationSpecies:["10116"], annotationConfidence:["Very High"], pmid:"9143361", citationType:"PubMed", citationRef:"9143361"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:13}, end: {_id:126}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The symptoms included gait instability, tremor, and dysarthria, with a progressive relapsing-remitting course over the span of 2 years. The patient was later found to have a large deletion-type mutation in the SOX6 gene. This case is the first report in humans implying a role for SOX6 in basal ganglia function, as well as spinal cord development.", citationTitle:"J Child Neurol. 2014 Nov;29(11):NP164-7. doi: 10.1177/0883073813514134. Epub 2014 Jan 21.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"24453155", citationType:"PubMed", citationRef:"24453155"}}, {start: {_id:223}, end: {_id:270}, properties:{evidence:"Mutations in DJ-1 (PARK7) leading to loss of functional protein cause familial PD and enhance sensitivity to oxidative insults.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 50; Iss. 3", annotationSubgraph:["Chaperone subgraph", "Response to oxidative stress"], annotationMeshdisease:["Parkinson Disease"], pmid:"23536331", citationType:"PubMed", citationRef:"23536331"}}, {start: {_id:1239}, end: {_id:1241}, properties:{evidence:"Gastrointestinal (GI) dysfunctions are one of the most frequent nonmotor symptoms of PD.upregulated b1-ARs were observed in the muscularis externa of the gastric corpus in 6-OHDA rats(Rat model of Parkinson disease).It has also been reported that expression of b1-AR is increased significantly in the colonic mucous of 6-OHDA rats(Rat model of Parkinson disease)", citationTitle:"Transl Res. 2014 Jul;164(1):22-31. doi: 10.1016/j.trsl.2014.01.001. Epub 2014 Jan 7.", annotationSpecies:["10116"], annotationMeshdisease:["Parkinson Disease"], pmid:"24467967", citationType:"PubMed", citationRef:"24467967"}}, {start: {_id:1354}, end: {_id:270}, properties:{evidence:"alpha-Syn overexpression and particularly its PD causing A53T mutant increases the susceptibility of cells to oxidative stress, which is a consistent abnormality in the PD brain", citationTitle:"Proc Natl Acad Sci U S A. 2009 Aug 4;106(31):13052-7. doi: 10.1073/pnas.0906277106. Epub 2009 Jul 23.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"19628698", citationType:"PubMed", citationRef:"19628698"}}, {start: {_id:1388}, end: {_id:1389}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PDE4D binds Rheb in a noncatalytic manner that does not require its cAMP-hydrolyzing activity and thereby inhibits the ability of Rheb to activate mTORC1. However, elevated cAMP levels disrupt the interaction of PDE4D with Rheb and increase the interaction between Rheb and mTOR. This enhanced Rheb-mTOR interaction induces the activation of mTORC1 and cap-dependent translation, a cellular function of mTORC1. Taken together, our results suggest a novel regulatory mechanism for mTORC1 in which the cAMP-determined dynamic interaction between Rheb and PDE4D provides a key, unique regulatory event. We also propose a new role for PDE4 as a molecular transducer for cAMP signaling.", citationTitle:"Mol Cell Biol. 2010 Nov;30(22):5406-20. doi: 10.1128/MCB.00217-10. Epub 2010 Sep 13.", annotationSubgraph:["Cyclic AMP subgraph"], annotationSpecies:["9606"], pmid:"20837708", citationType:"PubMed", citationRef:"20837708"}}, {start: {_id:1708}, end: {_id:1709}, properties:{evidence:"Parkin-null mice and Parkin Drosophila mutants develop apoptotic muscle degeneration with mitochondrial pathology and decreased resistance to oxidative stress", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1708}, end: {_id:270}, properties:{evidence:"Parkin-null mice and Parkin Drosophila mutants develop apoptotic muscle degeneration with mitochondrial pathology and decreased resistance to oxidative stress", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1708}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, in a recent study it was shown that Parkin is involved in autophagy of dysfunctional mitochondria (Narendra et al, 2008), which might provide a mechanistic explanation for the genetic interaction between Parkin and Pink1 in Drosophila (Clark et al, 2006; Poole et al, 2008; Yang et al, 2006).", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Ubiquitin subgraph", "Autophagy signaling subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:24}, end: {_id:1716}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Larval and adult pink1B9 and parkin1/D21 muscles show enlarged, clumped mitochondria, a defect that is modified by mitochondrial remodeling (15).", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:24}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recently, in vitro studies of the PD-related proteins Parkin and PINK1 have found that these factors act in a common pathway to promote the selective autophagic degradation of damaged mitochondria (mitophagy).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:24}, end: {_id:1769}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin overproduction in cells increased mitochondrial HSD17B10 abundance by a mechanism involving ubiquitin chain extension, whereas PARK2 downregulation or deficiency caused mitochondrial HSD17B10 depletion in cells and mice. HSD17B10 levels were also found to be low in the brains of PD patients with PARK2 mutations.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1768}, end: {_id:1804}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is one of the three protein components of human mitochondrial RNAse P, which is required for the processing of mtDNA transcripts.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1768}, end: {_id:1806}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 promoted mitochondrial elongation, sparing these organelles from degradation triggered by the protonophore carbonyl cyanide m-chlorophenylhydrazone (CCCP).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1770}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 accumulated on mitochondria in cells overproducing HSD17B10, indicating that mitochondrial import mechanisms were overwhelmed", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Synuclein subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1770}, end: {_id:1774}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 promotes mitochondrial elongation, protecting against mitochondrial damage following Î”Î¨m collapse.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1770}, end: {_id:1716}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 overproduction was associated with a major change in mitochondrial morphology, with mitochondria appearing as long filaments extending across the cytoplasm", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1304}, end: {_id:1779}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Numerous studies have established that PINK1 and parkin participate in a com- mon mitochondrial-quality control pathway, promoting the selective degradation of dysfunctional mitochondria by mitophagy.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1779}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Numerous studies have established that PINK1 and parkin participate in a com- mon mitochondrial-quality control pathway, promoting the selective degradation of dysfunctional mitochondria by mitophagy.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is now well established that PINK1 and parkin participate in mitochondrial quality control: PINK1 accumulation at the outer mitohondrial membrane of dysfunctional mitochondria recruits parkin, which in turn promotes their selective degradation by mitophagy", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The finding that, after ER stress induction, parkin gene was in- duced and mitochondrial degeneration, which normally occurred in these conditions, was prevented [27], suggested that parkin may also have a cytoprotective role independently to its mitochondria transloca- tion and consequent mitophagy activation.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:24}, end: {_id:131}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our study demonstrated that parkin overexpression specifically in- duced an increase in the mitochondrial Ca2+ transients evoked by cell stimulation and that such increase was not observed by overexpressing a parkin N-terminal truncation mutant lacking the Ubl domain, suggesting that this domain is necessary to this parkin function.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1605}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results suggested that parkin is essential to maintain mitochondrial network integrity possibly by sustaining ERâ€“mitochondria connections and guaranteeing the proper ERâ€“mitochondria Ca2+ transfer.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:131}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results suggested that parkin is essential to maintain mitochondrial network integrity possibly by sustaining ERâ€“mitochondria connections and guaranteeing the proper ERâ€“mitochondria Ca2+ transfer.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:1710}, end: {_id:131}, properties:{evidence:"Interestingly, we have obtained similar evidence also for Î±-synuclein [63] and DJ-1 (unpublished data), suggesting that this action may represent a common mechanism shared by different PD-related proteins.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:1710}, end: {_id:1605}, properties:{evidence:"Interestingly, we have obtained similar evidence also for Î±-synuclein [63] and DJ-1 (unpublished data), suggesting that this action may represent a common mechanism shared by different PD-related proteins.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:7}, end: {_id:1605}, properties:{evidence:"Interestingly, we have obtained similar evidence also for Î±-synuclein [63] and DJ-1 (unpublished data), suggesting that this action may represent a common mechanism shared by different PD-related proteins.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:7}, end: {_id:131}, properties:{evidence:"Interestingly, we have obtained similar evidence also for Î±-synuclein [63] and DJ-1 (unpublished data), suggesting that this action may represent a common mechanism shared by different PD-related proteins.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:223}, end: {_id:1605}, properties:{evidence:"Interestingly, we have obtained similar evidence also for Î±-synuclein [63] and DJ-1 (unpublished data), suggesting that this action may represent a common mechanism shared by different PD-related proteins.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:223}, end: {_id:131}, properties:{evidence:"Interestingly, we have obtained similar evidence also for Î±-synuclein [63] and DJ-1 (unpublished data), suggesting that this action may represent a common mechanism shared by different PD-related proteins.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:303}, properties:{evidence:"Parkin, the product of gene PARK2 whose mutation causes familial PD, has been linked to mitochondrial quality control via its role in regulating mitochondrial dynamics, including mitochondrial degradation via mitophagy.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:24}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Models using mitochondrial stressors in numerous cell types have elucidated a PINK1-dependent pathway whereby Parkin accumulates on damaged mitochondria and targets them for mitophagy.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:24}, end: {_id:1605}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In addition, we found that Parkin accumulates on endoplasmic reticulum (ER) and mitochondrial/ER junctions following excitotoxicity, supporting a role for Parkin in mitochondrialâ€“ER crosstalk in mitochondrial homeostasis.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:24}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Unexpectedly, we found that glutamate-induced accumulation of Parkin on mitochondria was promoted by the antioxidant N-acetyl cysteine (NAC), and that co-treatment with NAC facilitated Parkin-associated mitophagy.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:24}, end: {_id:1807}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Taken together, our work and the work of others may suggest a larg- er role for Parkin in maintaining mitochondrial homeostasis and cellular bioenergetics in neurons.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
