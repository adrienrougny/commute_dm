UNWIND [{start: {_id:307}, end: {_id:739}, properties:{annotationCondition:["Normal Healthy State"], evidence:"A rate-limiting enzyme of the PPP, glucose-6-phosphate dehydrogenase (G6PDH), is transcriptionally regulated by the Keap1/Nrf2 system, which is a master regulator of phase 2 detoxifying enzymes.", citationTitle:"Brain and nerve = Shinkei kenky?? no shinpo; Vol. 65; Iss. 12", annotationSubgraph:["Disaccharide metabolism subgraph", "Ubiquitin subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"24323934", citationType:"PubMed", citationRef:"24323934"}}, {start: {_id:137}, end: {_id:506}, properties:{evidence:"Overexpression of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±-syn Results in Cytoplasmic Retention of Dnmt1. We observed an inverse trend between oligomerization of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±-syn and reduction of nuclear Dnmt1, suggesting that subcellular localization of Dnmt1 might be altered by âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±-syn accumulation and/or aggregation.", citationTitle:"J Biol Chem. 2011 Mar 18;286(11):9031-7. doi: 10.1074/jbc.C110.212589. Epub 2011 Feb 4", annotationSubgraph:["Synuclein subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21296890", citationType:"PubMed", citationRef:"21296890"}}, {start: {_id:1400}, end: {_id:71}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Meteorin and its homologue meteorin-like (metrnl) are two novel proteins regulating glial cell differentiation in central nervous system. Overexpression of meteorin and metrnl further magnified the phosphorylation of Akt upon insulin stimuli in 3T3-L1 cells.", citationTitle:"Biochem Biophys Res Commun. 2013 Jul 13. pii: S0006-291X(13)01148-0. doi: 10.1016/j.bbrc.2013.07.008", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], pmid:"23860268", citationType:"PubMed", citationRef:"23860268"}}, {start: {_id:1399}, end: {_id:71}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Meteorin and its homologue meteorin-like (metrnl) are two novel proteins regulating glial cell differentiation in central nervous system. Overexpression of meteorin and metrnl further magnified the phosphorylation of Akt upon insulin stimuli in 3T3-L1 cells.", citationTitle:"Biochem Biophys Res Commun. 2013 Jul 13. pii: S0006-291X(13)01148-0. doi: 10.1016/j.bbrc.2013.07.008", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], pmid:"23860268", citationType:"PubMed", citationRef:"23860268"}}, {start: {_id:1445}, end: {_id:1449}, properties:{evidence:"muscle-specific Marf or opa1 knockdown or drp1 overexpression results in significant rescue of mitochondrial morphology phenotypes, and suppression of muscle cell death and degeneration in pink1 and/or parkin mutants. Furthermore, in testes, pink1 also genetically interacts with the testes-specific mfn homologue fzo. In this case, however, whereas loss of pink1 function strongly suppresses fzo mutant phenotypes, the pink1 mutant phenotype is not strongly suppressed.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Testis"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:271}, end: {_id:1533}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We focused on two such mitochondrial proteins,TOMM20 and MIRO1(also known as RHOT1), that showed large increases in ubiquitination with USP30 knockdown and parkin overexpression", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Mitochondria fusion subgraph", "Ubiquitin subgraph", "RhoA subgraph", "Mitochondria fission subgraph"], annotationCell:["dopaminergic neuron"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:271}, end: {_id:1534}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We focused on two such mitochondrial proteins,TOMM20 and MIRO1(also known as RHOT1), that showed large increases in ubiquitination with USP30 knockdown and parkin overexpression", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph", "Matrix metalloproteinase subgraph"], annotationCell:["dopaminergic neuron"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1441}, end: {_id:1443}, properties:{annotationCondition:["Normal Healthy State"], evidence:"MUL1 positively regulates Drp1's pro-fission activity through sumoylation-dependent protein stabilization", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSpecies:["7227"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:1541}, end: {_id:271}, properties:{evidence:"loss of MUL1 results in an increase in Mfn levels, as does loss of PINK1 or parkin", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:1541}, end: {_id:221}, properties:{evidence:"loss of MUL1 results in an increase in Mfn levels, as does loss of PINK1 or parkin", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:1519}, end: {_id:221}, properties:{evidence:"ATG5 is activated down- stream of PINK1, but independently of autophagy receptors, and that LC3 mitochondrial localization and lipidation are independent steps of mitophagy.", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["PINK1 subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:1582}, end: {_id:1580}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In this paper we describe the identification of an mtUPR response element in the promoters of both chop and c/ebpÎ² genes. This element is an AP-1 site, suggesting that mitochondrial to nuclear signaling of the accumulation of unfolded proteins in the mitochondrial matrix is through a JNK pathway. We show, using a specific MEK inhibitor, that this signaling is through JNK2 and that an inhibition in the phosphorylation of JNK2 also inhibits mtUPR. We suggest that the cell can discriminate between organelle specific Unfolded protein response subgraphs through different pathways to activate genes that harbor different stress elements within their promoters. Recently, it has been reported that JNK2 is a positive regulator of the cJun transcription factor and can regulate both mitochondrial and lysosomal death pathways in mouse embryonic fibroblasts", citationTitle:"PLoS One. 2007 Sep 12;2(9):e835.", annotationSubgraph:["MAPK subgraph"], pmid:"17848986", citationType:"PubMed", citationRef:"17848986"}}, {start: {_id:421}, end: {_id:1541}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we demonstrate that the retromer complex, a known component of vesicle transport from the endosome to the Golgi apparatus, regulates the transport of MAPL from mitochondria to peroxisomes. An unbiased screen shows that Vps35 and Vps26 are found in complex with MAPL, and confocal imaging reveals Vps35 recruitment to mitochondrial vesicles. Silencing of Vps35 or Vps26A leads to a significant reduction in the delivery of MAPL to peroxisomes, placing the retromer within a novel intracellular trafficking route and providing insight into the formation of MAPL-positive MDVs. Functionally, we have demonstrated that silencing Vps35 or Vps26A inhibits the formation of MAPL MDVs and their subsequent delivery of MAPL to the peroxisome.", citationTitle:"Curr Biol. 2010 Jul 27;20(14):1310-5. doi: 10.1016/j.cub.2010.05.066. Epub 2010 Jul 8.", annotationSubgraph:["Ubiquitin subgraph", "Endoplasmic reticulum-Golgi protein export"], pmid:"20619655", citationType:"PubMed", citationRef:"20619655"}}, {start: {_id:1523}, end: {_id:1541}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we demonstrate that the retromer complex, a known component of vesicle transport from the endosome to the Golgi apparatus, regulates the transport of MAPL from mitochondria to peroxisomes. An unbiased screen shows that Vps35 and Vps26 are found in complex with MAPL, and confocal imaging reveals Vps35 recruitment to mitochondrial vesicles. Silencing of Vps35 or Vps26A leads to a significant reduction in the delivery of MAPL to peroxisomes, placing the retromer within a novel intracellular trafficking route and providing insight into the formation of MAPL-positive MDVs. Functionally, we have demonstrated that silencing Vps35 or Vps26A inhibits the formation of MAPL MDVs and their subsequent delivery of MAPL to the peroxisome.", citationTitle:"Curr Biol. 2010 Jul 27;20(14):1310-5. doi: 10.1016/j.cub.2010.05.066. Epub 2010 Jul 8.", annotationSubgraph:["Ubiquitin subgraph", "Endoplasmic reticulum-Golgi protein export"], pmid:"20619655", citationType:"PubMed", citationRef:"20619655"}}, {start: {_id:1634}, end: {_id:1636}, properties:{evidence:"Viral infection triggers host innate immune responses through activation of the transcription factors NF-kappaB and IRF 3, which coordinately regulate the expression of type-I interferons such as interferon-beta (IFN-beta). Herein, we report the identification of a novel protein termed MAVS (mitochondrial antiviral signaling), which mediates the activation of NF-kappaB and IRF 3 in response to viral infection. Silencing of MAVS expression through RNA interference abolishes the activation of NF-kappaB and IRF 3 by viruses, thereby permitting viral replication. Conversely, overexpression of MAVS induces the expression of IFN-beta through activation of NF-kappaB and IRF 3, thus boosting antiviral immunity. Epistasis experiments show that MAVS is required for the phosphorylation of IRF 3 and IkappaB and functions downstream of RIG-I, an intracellular receptor for viral RNA. MAVS contains an N-terminal CARD-like domain and a C-terminal transmembrane domain, both of which are essential for MAVS signaling. The transmembrane domain targets MAVS to the mitochondria, implicating a new role of mitochondria in innate immunity.", citationTitle:"Cell. 2005 Sep 9;122(5):669-82.", annotationSubgraph:["Interferon signaling subgraph"], annotationMeshdisease:["Virus Diseases"], pmid:"16125763", citationType:"PubMed", citationRef:"16125763"}}, {start: {_id:1664}, end: {_id:271}, properties:{evidence:"Reducing USP8 levels impairs recruitment of parkin to depolarized mitochondria. Moreover, the delay in parkin recruitment onto mitochondria induced by USP8 siRNA was rescued in cells transduced with a FLAGâ€�USP8 expression plasmid (Fig 1F and G). Thus, knockdown of USP8 increases parkin levels and delays its recruitment onto mitochondria.", citationTitle:"EMBO J. 2014 Nov 3;33(21):2473-91. doi: 10.15252/embj.201489729. Epub 2014 Sep 12.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"25216678", citationType:"PubMed", citationRef:"25216678"}}, {start: {_id:271}, end: {_id:1520}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, we found a significant positive correlation between the effects of parkin and Atg7 mutations on the half-lives of the 147 mitochondrial proteins that were in both datasets", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph", "Autophagy signaling subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:221}, end: {_id:1759}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 Is Required for Selective RC Turnover.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1418}, end: {_id:1405}, properties:{annotationCondition:["Normal Healthy State"], evidence:"the mitochondrial targeting of an exogenous HSD17B10 protein was significantly reduced by PARK2 or PINK1 down- regulation, whereas it was enhanced by Parkin overproduction in various cell models", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph", "Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:634}, end: {_id:1405}, properties:{annotationCondition:["Normal Healthy State"], evidence:"the mitochondrial targeting of an exogenous HSD17B10 protein was significantly reduced by PARK2 or PINK1 down- regulation, whereas it was enhanced by Parkin overproduction in various cell models", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph", "Synuclein subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1894}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In contrast, depletion of AIF led to a reduction of CHCHD4 protein expression yet failed to alter the levels of the related Mic19 protein", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1894}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The reduction of CHCHD4 protein in AIF-depleted cells was not accompanied by any change in the levels of CHCHD4 mRNA", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Mitochondrial subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1896}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, the knockdown of AIF or CHCHD4 had similar effects on the abundance of CHCHD4 substrates (Figures S3Câ€“ S3E) NDUFA8 (Szklarczyk et al., 2011), COX17, and DDP1 (Hofmann et al., 2005), which were not detectable in the AIF/ CHCHD4 immunoprecipitate (Figure S3F), presumably because the interaction between CHCHD4 and its substrates is rather transient (Koch and Schmid, 2014; Sideris et al., 2009).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1897}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, the knockdown of AIF or CHCHD4 had similar effects on the abundance of CHCHD4 substrates (Figures S3Câ€“ S3E) NDUFA8 (Szklarczyk et al., 2011), COX17, and DDP1 (Hofmann et al., 2005), which were not detectable in the AIF/ CHCHD4 immunoprecipitate (Figure S3F), presumably because the interaction between CHCHD4 and its substrates is rather transient (Koch and Schmid, 2014; Sideris et al., 2009).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1898}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, the knockdown of AIF or CHCHD4 had similar effects on the abundance of CHCHD4 substrates (Figures S3Câ€“ S3E) NDUFA8 (Szklarczyk et al., 2011), COX17, and DDP1 (Hofmann et al., 2005), which were not detectable in the AIF/ CHCHD4 immunoprecipitate (Figure S3F), presumably because the interaction between CHCHD4 and its substrates is rather transient (Koch and Schmid, 2014; Sideris et al., 2009).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Ubiquitin subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1903}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Depletion or deletion of AIF causes a reduction in the abundance of CHCHD4.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1904}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Depletion or deletion of AIF causes a reduction in the abundance of CHCHD4.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1905}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Depletion or deletion of AIF causes a reduction in the abundance of CHCHD4.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1642}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"An essential role for ATF4 in the regulation of parkin expression was substantiated by the following observations: First, a dominant- negative ATF4 mutant prevented ER stress-induced upregulation of parkin.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "Unfolded protein response subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1747}, end: {_id:1749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We tested the consequence of loss of heix on mitochonrial function (10) and found that, compared with controls, heix mutants showed a less negative Ym and lower ATP levels that could be significantly rescued by rearing heix mutants on MK-4 or by reexpression of Heix", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1768}, end: {_id:1410}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is involved primarily in isoleucine catabolism, in which it dehydrogenates 2-methyl-3-hydroxy- butyryl-CoA (MHB),27 but it has other substrates, including fatty acids and steroids, in several pathways.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1770}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our observations suggest that HSD17B10 overproduction overwhelms mitochondrial protein import mechanisms, lead- ing to PINK1 accumulation at the OMM.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Synuclein subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1886}, end: {_id:1887}, properties:{evidence:"CHCHD4 depletion sufficed to induce a respiratory defect that mimicked that observed in AIF-deficient cells", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:24}, end: {_id:1926}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin overexpression selectively enhanced mitochondrial Ca2+ transients in agonist-stimulated HeLa cells", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"23313576", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1927}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Increased parkin levels were associated with protection from cellular stress and cell cycle regulation [57â€“59] and overexpression of parkin in cultured cells not only rescued mitochondrial dysfunction caused by PINK1 loss of function, but exerted a cytoprotective role against different toxic stressor [19â€“23,26].", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1605}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In summary, we have shown that parkin, by favoring ERâ€“ mitochondria tethering, also favored Ca2 + transfer from the ER to mi- tochondria, sustained organelle morphology and ATP production.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1929}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In summary, we have shown that parkin, by favoring ERâ€“ mitochondria tethering, also favored Ca2 + transfer from the ER to mi- tochondria, sustained organelle morphology and ATP production.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:131}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In summary, we have shown that parkin, by favoring ERâ€“ mitochondria tethering, also favored Ca2 + transfer from the ER to mi- tochondria, sustained organelle morphology and ATP production.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1955}, properties:{evidence:"In the absence of Parkin, dopaminergic neurons in Mutator mice degenerated causing an L-DOPA reversible motor deficit.", citationTitle:"Neuron. 2015 Jul 15;87(2):371-81. doi: 10.1016/j.neuron.2015.06.034.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26182419", citationType:"PubMed", citationRef:"26182419"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:77}, end: {_id:408}, properties:{evidence:"Although low levels of VEGF may have neuroprotective effects on dopaminergic neurons , high doses of VEGF lead to poor circulation, brain edema and disruption of BBB in PD models, which may contribute to dopaminergic degeneration", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Vascular endothelial growth factor subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:872}, end: {_id:1011}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The brain is the most cholesterol-rich organ in the body and contains about 25% of the total amounts (for reviews, see BjâˆšÃ‰Â¬âˆ‚rkhem and Meaney, 2004 and Dietschy and Turley, 2004). The major portion of this cholesterol is present in myelin, a lamellar arrangement of oligodendrocyte plasma membranes which acts as an electric insulator along the length of large axons. During early brain development, most of brain synthesis is associated with myelin production. Cholesterol seems to be of particular importance for the insulatory properties of myelin and there seems be a physiological imperative to maintain constant levels of this steroid in the brain. To achieve this, a highly efficient bloodâˆšÂ¢â€šÃ‡Â¨â€šÃ„Ãºbrain barrier has been evolved that prevents exchange between cerebral and extracerebral pools of cholesterol. A direct consequence of this metabolic isolation has been the evolution of a very efficient cerebral cholesterol homeostasis, with minimal losses and extensive recycling.", citationTitle:"Mol Aspects Med. 2009 Jun;30(3):171-9. doi: 10.1016/j.mam.2009.02.001. Epub 2009 Feb 25.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["10116"], pmid:"19248803", citationType:"PubMed", citationRef:"19248803"}}, {start: {_id:872}, end: {_id:1011}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Apolipoprotein E (APOE) seems to be the most important mediator of this recycling process, but also other lipoproteins have been implicated, e.g. apolipoproteins J and D. The thrifty nature of cholesterol homeostasis in the brain is most probably a consequence of the low rate of de novo cholesterol synthesis in the adult brain, most of which is believed to occur in glial cells. Neurons are believed to have a very low rate of cholesterol synthesis and meet their cholesterol requirements via uptake of cholesterol carried in APOE- containing lipoproteins secreted from glial cells ( Pfrieger, 2003). Accumulating epidemiological and molecular evidence indicates that there is a clear link between cholesterol turnover and neurodegenerative diseases âˆšÂ¢â€šÃ‡Â¨â€šÃ„Ãº hypercholesterolemia per-se is an important risk factor for AlzheimerâˆšÂ¢â€šÃ‡Â¨â€šÃ‘Â¢s disease (AD) and ParkinsonâˆšÂ¢â€šÃ‡Â¨â€šÃ‘Â¢s disease and the presence of an APOE âˆšÃ©Â¬Âµ4 allele is the most well described genetic risk factor for late onset AD (LOAD).", citationTitle:"Mol Aspects Med. 2009 Jun;30(3):171-9. doi: 10.1016/j.mam.2009.02.001. Epub 2009 Feb 25.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["10116"], pmid:"19248803", citationType:"PubMed", citationRef:"19248803"}}, {start: {_id:316}, end: {_id:1617}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondria play a central role in many facets of cellular function including energy production, control of cell death and immune signaling. Breakdown of any of these pathways because of mitochondrial deficits or excessive reactive oxygen species production has detrimental consequences for immune system function and cell viability. Maintaining the functional integrity of mitochondria is therefore a critical challenge for the cell. Surveillance systems that monitor mitochondrial status enable the cell to identify and either repair or eliminate dysfunctional mitochondria. Mitophagy is a selective form of autophagy that eliminates dysfunctional mitochondria from the population to maintain overall mitochondrial health. This review covers the major players involved in mitophagy and explores the role mitophagy plays to support the immune system.", citationTitle:"Immunol Cell Biol. 2015 Jan;93(1):3-10. doi: 10.1038/icb.2014.75. Epub 2014 Sep 30.", pmid:"25267485", citationType:"PubMed", citationRef:"25267485"}}, {start: {_id:1941}, end: {_id:1942}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Glutamate acts at NMDA receptors in cultured rat forebrain neurons to increase the intracellular free calcium concentration.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshanatomy:["Medial Forebrain Bundle"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:267}, end: {_id:1621}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Reactive oxygen species (ROS) are essential components of the innate immune response against intracellular bacteria and it is thought that professional phagocytes generate ROS primarily via the phagosomal NADPH oxidase machinery. However, recent studies have suggested that mitochondrial ROS (mROS) also contribute to mouse macrophage bactericidal activity, although the mechanisms linking innate immune signalling to mitochondria for mROS generation remain unclear.", citationTitle:"Nature. 2011 Apr 28;472(7344):476-80. doi:10.1038/nature09973.", annotationSubgraph:["Reactive oxygen species subgraph", "Innate immune system subgraph"], pmid:"21525932", citationType:"PubMed", citationRef:"21525932"}}, {start: {_id:267}, end: {_id:1988}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Reactive oxygen species (ROS) are essential components of the innate immune response against intracellular bacteria and it is thought that professional phagocytes generate ROS primarily via the phagosomal NADPH oxidase machinery. However, recent studies have suggested that mitochondrial ROS (mROS) also contribute to mouse macrophage bactericidal activity, although the mechanisms linking innate immune signalling to mitochondria for mROS generation remain unclear.", citationTitle:"Nature. 2011 Apr 28;472(7344):476-80. doi:10.1038/nature09973.", annotationSubgraph:["Reactive oxygen species subgraph", "Innate immune system subgraph"], pmid:"21525932", citationType:"PubMed", citationRef:"21525932"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:656}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The low mRNA level in our patients and the production of two abnormal transcripts lacking either a significant part of the PTEN-like domain or the carboxyl-terminal J-domain, suggest that cells homozygous for the c.801-2 A???>G mutation lack the Auxilin protein.", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:998}, end: {_id:995}, properties:{evidence:"Alzheimer's disease (AD) is the most common neurodegenerative disease, and is clinically characterized by cognitive disturbances and the accumulation of the amyloid âˆšÃ©Â¬â‰¤ (AâˆšÃ©Â¬â‰¤) peptides in plaques in the brain. Recent studies have shown the links between AD and the immediate-early gene Arc (activity-regulated cytoskeleton- associated protein), involved in synaptic plasticity and memory consolidation. For example, AD mouse models show a decreased expression of Arc mRNA in the brain.", citationTitle:"J Neural Transm. 2012 Jul;119(7):833-42. doi: 10.1007/s00702-012-0823-x. Epub 2012 May 25.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Alzheimer Disease"], annotationMeshanatomy:["Brain"], pmid:"22622366", citationType:"PubMed", citationRef:"22622366"}}, {start: {_id:1244}, end: {_id:16}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"We found decreased methylation of the cytochrome P450 2E1 gene and increased expression of CYP2E1 messenger RNA in PD patients' brains, suggesting that epigenetic variants of this cytochrome contribute to PD susceptibility.", citationTitle:"Neurogenetics. 2012 Feb;13(1):87-91. doi: 10.1007/s10048-011-0308-3. Epub 2012 Jan 12.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], pmid:"22238121", citationType:"PubMed", citationRef:"22238121"}}, {start: {_id:1262}, end: {_id:16}, properties:{evidence:"A set of three miRNAs, miR-1, miR-22* and miR-29a, showed reduced profiles of relative expression in the PD blood samples.", citationTitle:"J Biotechnol. 2011 Mar 20;152(3):96-101. doi: 10.1016/j.jbiotec.2011.01.023. Epub 2011 Feb 3.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["blood cell"], pmid:"21295623", citationType:"PubMed", citationRef:"21295623"}}, {start: {_id:1267}, end: {_id:16}, properties:{evidence:"It should be noted that TPPP/p25 is a target of miR-1, which, in the present study, showed lower expression levels in de novo PD when compared with healthy subjects.", citationTitle:"J Biotechnol. 2011 Mar 20;152(3):96-101. doi: 10.1016/j.jbiotec.2011.01.023. Epub 2011 Feb 3.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["blood cell"], pmid:"21295623", citationType:"PubMed", citationRef:"21295623"}}, {start: {_id:1277}, end: {_id:16}, properties:{evidence:"BDNF has been identified as a potential target of miR-1. BDNF levels are increased in PD cerebral spinal fluid when compared with normal subjects . The reduced levels of miR-1, detected in non-treated PD subjects, are in agreement with an increase in BDNF mRNAs and the previously described BDNF protein levels.", citationTitle:"J Biotechnol. 2011 Mar 20;152(3):96-101. doi: 10.1016/j.jbiotec.2011.01.023. Epub 2011 Feb 3.", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Neurotrophic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Cerebrospinal Fluid"], pmid:"21295623", citationType:"PubMed", citationRef:"21295623"}}, {start: {_id:379}, end: {_id:16}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"Alpha-synuclein mRNA was significantly diminished in the substantia nigra of patients with PD compared with control subjects but not in the cortex.Our findings suggest that decreased synuclein mRNA may be an early alteration in the SN in PD, and imply that decreased levels of the protein may play a role in the pathogenesis of sporadic cases of the disease.", citationTitle:"Mov Disord. 1999 May;14(3):417-22.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"10348463", citationType:"PubMed", citationRef:"10348463"}}, {start: {_id:1335}, end: {_id:16}, properties:{evidence:"MIR886 is a highlighted candidate among co-varying genes with decrease methylation, for which more than 8 probes mapping to adjacent CpGs showed significant decay in PD.", citationTitle:"Neurosci Lett. 2014 Sep 5;579:70-4. doi: 10.1016/j.neulet.2014.07.013. Epub 2014 Jul 17.", annotationSubgraph:["miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23907097", citationType:"PubMed", citationRef:"23907097"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
:commit
:begin
MATCH (n:`UNIQUE IMPORT LABEL`)  WITH n LIMIT 20000 REMOVE n:`UNIQUE IMPORT LABEL` REMOVE n.`UNIQUE IMPORT ID`;
:commit
:begin
DROP CONSTRAINT UNIQUE_IMPORT_NAME;
:commit
