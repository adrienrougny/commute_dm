UNWIND [{start: {_id:545}, end: {_id:16}, properties:{evidence:"From the numerous putative pathogenic variants in LRRK2 that have been identified, at least seven missense mutations√¢‚Ç¨‚ÄùR1441C, R1441G, R1441H, N1437H, Y1699C, G2019S and I2020T√¢‚Ç¨‚Äùare considered truly pathogenic since they segregate with disease in families with PD.", citationTitle:"Small GTPases. 2013 Jul-Sep;4(3):164-70. doi: 10.4161/sgtp.25130. Epub 2013 Jun 10.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24025585", citationType:"PubMed", citationRef:"24025585"}}, {start: {_id:196}, end: {_id:16}, properties:{evidence:"From the numerous putative pathogenic variants in LRRK2 that have been identified, at least seven missense mutations√¢‚Ç¨‚ÄùR1441C, R1441G, R1441H, N1437H, Y1699C, G2019S and I2020T√¢‚Ç¨‚Äùare considered truly pathogenic since they segregate with disease in families with PD.", citationTitle:"Small GTPases. 2013 Jul-Sep;4(3):164-70. doi: 10.4161/sgtp.25130. Epub 2013 Jun 10.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24025585", citationType:"PubMed", citationRef:"24025585"}}, {start: {_id:547}, end: {_id:16}, properties:{evidence:"From the numerous putative pathogenic variants in LRRK2 that have been identified, at least seven missense mutations√¢‚Ç¨‚ÄùR1441C, R1441G, R1441H, N1437H, Y1699C, G2019S and I2020T√¢‚Ç¨‚Äùare considered truly pathogenic since they segregate with disease in families with PD.", citationTitle:"Small GTPases. 2013 Jul-Sep;4(3):164-70. doi: 10.4161/sgtp.25130. Epub 2013 Jun 10.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24025585", citationType:"PubMed", citationRef:"24025585"}}, {start: {_id:283}, end: {_id:16}, properties:{evidence:"There are two missense mutations in alpha-synuclein, A53T and A30P that lead to early-onset Parkinson's disease", citationTitle:"Neural Regen Res. 2013 Aug 25;8(24):2275-83. doi: 10