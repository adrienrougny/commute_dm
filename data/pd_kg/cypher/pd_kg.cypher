UNWIND [{start: {_id:13}, end: {_id:125}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The symptoms included gait instability, tremor, and dysarthria, with a progressive relapsing-remitting course over the span of 2 years. The patient was later found to have a large deletion-type mutation in the SOX6 gene. This case is the first report in humans implying a role for SOX6 in basal ganglia function, as well as spinal cord development.", citationTitle:"J Child Neurol. 2014 Nov;29(11):NP164-7. doi: 10.1177/0883073813514134. Epub 2014 Jan 21.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"24453155", citationType:"PubMed", citationRef:"24453155"}}, {start: {_id:24}, end: {_id:1778}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin is a cytosolic RING-in-between-RING ubiquitin ligase with HECT- like enzyme activity;2 it has versatile ubiquitylation activities and various putative protein substrates with diverse functions, involved in different cellular processes.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fission subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1770}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 promotes mitochondrial elongation, protecting against mitochondrial damage following Î”Î¨m collapse.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:24}, end: {_id:749}, properties:{evidence:"Parkin loss caused mitochondrial dysfunction and affected the pathogenicity but not the levels of mtDNA somatic mutations.", citationTitle:"Neuron. 2015 Jul 15;87(2):371-81. doi: 10.1016/j.neuron.2015.06.034.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"