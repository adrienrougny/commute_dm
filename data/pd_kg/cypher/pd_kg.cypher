UNWIND [{start: {_id:16}, end: {_id:380}, properties:{evidence:"Despite that there is neuronal loss in the substantia nigra of PD brains, overall the SNCA-mRNA levels were increased in PD brains an average of nearly fourfold over normal control mid-brain, although there was much greater variability in samples from PD patients compared to controls.", citationTitle:"Mov Disord. 2006 Oct;21(10):1703-8", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra", "Brain"], pmid:"16795004", citationType:"PubMed", citationRef:"16795004"}}, {start: {_id:16}, end: {_id:1772}, properties:{evidence:"PD-causing PARK2 mutations impaired interaction with HSD17B10 and the HSD17B10-dependent mitochondrial translocation of Parkin.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph", "Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1967}, end: {_id:1972}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consequently, this leads to the activation of TANK-binding kinase 1 (TBK1) and phosphorylation of interferon regulatory factor 3 (IRF3), both of which constitutively associate with cytosolic chaperone Hsp90. It remains largely unknown how MAVS activates TBK1/IRF3. In this study, we identified translocases of outer membrane 70 (Tom70), a mitochondrial import receptor, to interact with MAVS upon RNA virus infection. Ectopic expression or knockdown of Tom70 could enhance or impair IRF3-mediated gene expression, respectively.", citationTitle:"Cell Res. 2010 Sep;20(9):994-1011. doi: 10.1038/cr.2010.103. Epub 2010 Jul 13.", annotationSubgraph:["Interferon signaling subgraph", "Matrix metalloproteinase subgraph"], pmid:"20628368", citationType:"PubMed", citationRef:"20628368"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:222}, end: {_id:316}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These cells exhibited vulnerability to oxidative stress, mitochondrial dysfunction and fragmentation.", citationTitle:"Neurosci Res. 2013 Dec;77(4):228-33. doi: 10.1016/j.neures.2013.09.006. Epub 2013 Sep 21.", pmid:"24064392", annotationCellline:["DT40 cell"], citationType:"PubMed", citationRef:"24064392"}}, {start: {_id:303}, end: {_id:316}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These cells exhibited vulnerability to oxidative stress, mitochondrial dysfunction and fragmentation.", citationTitle:"Neurosci Res. 2013 Dec;77(4):228-33. doi: 10.1016/j.neures.2013.09.006. Epub 2013 Sep 21.", pmid:"24064392", annotationCellline:["DT40 cell"], citationType:"PubMed", citationRef:"24064392"}}, {start: {_id:317}, end: {_id:316}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These cells exhibited vulnerability to oxidative stress, mitochondrial dysfunction and fragmentation.", citationTitle:"Neurosci Res. 2013 Dec;77(4):228-33. doi: 10.1016/j.neures.2013.09.006. Epub 2013 Sep 21.", pmid:"24064392", annotationCellline:["DT40 cell"], citationType:"PubMed", citationRef:"24064392"}}, {start: {_id:1730}, end: {_id:748}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The release of cytochrome c upon stimulation with the proapoptotic BH3-only member of the Bcl-2 family cBID, was slightly, but significantly increased in purified Pink1âˆ’/âˆ’ mitochondria", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Apoptosis signaling subgraph", "PINK1 subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1960}, end: {_id:1958}, properties:{evidence:"The fraction of mtDNA deletions is significantly higher in cytochrome c oxidase (COX)-deficient neurons than in COX-positive neurons, suggesting that mtDNA deletions may be directly responsible for impaired cellular respiration.", citationTitle:"Nat Genet. 2006 May;38(5):518-20. Epub 2006 Apr 9.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"16604072", citationType:"PubMed", citationRef:"16604072"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:500}, end: {_id:502}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hyperhomocysteine induces oxidative stress via NMDA receptor-mediated neuronal nitric oxide synthase activation and formation of radicals, which leads to mitochondrial dysfunction and the release of Cytochrome c and of apoptosis inducing factor (AIF), ultimately causing cell apoptosis [24].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshanatomy:["Serum"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:270}, end: {_id:719}, properties:{evidence:"This is because dopaminergic neurons in the substantia nigra are chronically exposed to oxidative stress caused by high levels of iron and autooxidation of dopamine.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Reactive oxygen species subgraph", "Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra", "Dopaminergic Neurons"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:886}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Smoking, alcohol and exercise may increase or decrease risk of aging brain disorders, especially dementia and Parkinson's disease, while stress is consistently associated with increased risk and a prudent diet is consistently associated with reduced risk.", citationTitle:"Hum Reprod Update. 2011 Sep-Oct;17(5):706-17. doi: 10.1093/humupd/dmr020. Epub 2011 May 11.", pmid:"21565809", citationType:"PubMed", citationRef:"21565809"}}, {start: {_id:957}, end: {_id:1179}, properties:{evidence:"Reduction of NSC generation could potentially lead to olfactory dysfunction, which is commonly associated with and precedes the motor symptoms by several years in PD.", citationTitle:"J Neurochem. 2010 Nov;115(4):854-63. doi: 10.1111/j.1471-4159.2010.06727.x.", annotationMeshdisease:["Parkinson Disease"], annotationCell:["neuronal stem cell"], pmid:"20374434", citationType:"PubMed", citationRef:"20374434"}}, {start: {_id:1367}, end: {_id:16}, properties:{evidence:"dysfunction of MAPK pathway has been shown to causes neuron loss and neurodegeneration in PD.", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neostriatum"], pmid:"21892731", citationType:"PubMed", citationRef:"21892731"}}, {start: {_id:270}, end: {_id:1362}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"oxidative stress causes dopamine cell degeneration in PD", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSubgraph:["MAPK subgraph", "DNA synthesis"], annotationSpecies:["9606"], annotationMeshanatomy:["Neostriatum"], pmid:"21892731", citationType:"PubMed", citationRef:"21892731"}}, {start: {_id:303}, end: {_id:16}, properties:{evidence:"Mitochondrial dysfunction and failure of selective protein degradation have been implicated in the pathogenesis of Parkinson's disease", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationMeshdisease:["Parkinson Disease"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:270}, end: {_id:16}, properties:{evidence:"We note that the relative expression of HK1 compared with HK2 is higher in the brain. However, the observation that hexokinase activity itself is required for parkin recruitment suggests that HK1 or HK2 should be equally effective in this pathway. Although we show that HK2 can promote parkin recruitment in neurons, it is likely that HK1 would be more important in the brain. Our results also show that Akt- dependent recruitment of HK2 to mitochondria is important. The recruitment of hexokinase to mitochondria supports glycolysis, allowing for energy metabolism in the absence of oxygen. This has implications for both aging (31) and tolerance to oxidative stress (32), both processes implicated in Parkinson's disease. We speculate that diminishment of Akt signaling would be of interest to examine in the context of parkinsonism, and there is some evidence that Akt signaling is altered in sporadic PD", citationTitle:"Hum Mol Genet. 2014 Jan 1;23(1):145-56. doi: 10.1093/hmg/ddt407. Epub 2013 Aug 19.", annotationSubgraph:["Energy metabolic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23962723", citationType:"PubMed", citationRef:"23962723"}}, {start: {_id:881}, end: {_id:16}, properties:{evidence:"CONCLUSIONS:Increased mitochondrial Ca2+ sensitivity and JNK activity are early defects in Pink1-/- mice that precede reduced DA levels and abnormal DA homeostasis and may contribute to neuronal dysfunction in familial PD. Differential gene expression in the nigrostriatal system of Pink1-/- mice supports early dopaminergic dysfunction and shows that Pink1 deletion causes aberrant expression of genes that regulate innate immune responses. While some differentially expressed genes may mitigate neurodegeneration, increased LPS-induced brain cytokine expression and impaired cytokine-induced NF-kB activation may predispose neurons of Pink1-/- mice to inflammation and injury-induced cell death.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:1699}, end: {_id:16}, properties:{evidence:"For instance, several mitochondrial toxins that block Complex I cause Parkinsonism in humans and laboratory animals and are widely used to create PD animal models", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1699}, end: {_id:16}, properties:{evidence:"Combined together, the data indicate that cellular defects in PINK1 mutants arise from dysfunction of Complex I of the ETC and extend the critical role of Complex I as a factor in the progression of PD from sporadic to genetic forms of the disease.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1699}, end: {_id:16}, properties:{evidence:"It is interesting to note that Complex I has also been strongly implicated in the pathogenesis of (some forms of) sporadic PD.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:396}, end: {_id:16}, properties:{evidence:"Our study supports the notion that parkin has a role in the interorganellar crosstalk between the ER and mitochondria to promote cell survival under stress, suggesting that both ER and mitochondrial stress can contribute to the pathogenesis of Parkinsonâ€™s disease.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Endoplasmic Reticulum"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin interferes with ER stress-induced mitochondrial damage.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1427}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Numerous studies have established that PINK1 and parkin participate in a com- mon mitochondrial-quality control pathway, promoting the selective degradation of dysfunctional mitochondria by mitophagy.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:396}, end: {_id:16}, properties:{evidence:"Mitochondrial dysfunction and endoplasmic reticulum (ER) stress contribute to the pathogenesis of Parkinson disease (PD)", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:1427}, end: {_id:16}, properties:{evidence:"Parkin, the product of gene PARK2 whose mutation causes familial PD, has been linked to mitochondrial quality control via its role in regulating mitochondrial dynamics, including mitochondrial degradation via mitophagy.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1930}, end: {_id:16}, properties:{evidence:"First, we provide the first evidence that glutamate excitotoxicity in neurons, proposed to have a contributing role in neurodegeneration and PD pathogenesis, can trigger Parkin translocation to mitochondria, as well as to ER and mitochondriaâ€“ER junctions.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Nerve Degeneration", "Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1385}, end: {_id:1396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"LRRK2 kinase activity is biologically equivalent to autophagy induced by inhibition of mTORC1 by starvation.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2900-10. doi: 10.1016/j.bbamcr.2013.07.020. Epub 2013 Aug 1.", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["9606"], pmid:"23916833", citationType:"PubMed", citationRef:"23916833"}}, {start: {_id:1877}, end: {_id:1879}, properties:{annotationCondition:["Normal Healthy State"], evidence:"these findings explain how AIF contributes to the biogenesis of respiratory chain complexes, and they establish an unexpected link between the vital function of AIF and the propensity of cells to undergo apoptosis.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
