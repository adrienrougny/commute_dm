UNWIND [{start: {_id:47}, end: {_id:70}, properties:{evidence:"The interaction between BPS domain of Grb10 and IGF1R could directly inhibit IGF1R substrate phosphorylation [11], and decreased the levels of Grb10 expression below normal levels resulted in augmented IGF1 activation of Akt and ERK1/2 [9].", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:118}, end: {_id:115}, properties:{evidence:"We found that the E3 ligase Trip12, a HECT domain E3 ubiquitin ligase, recognizes and polyubiquitinates Sox6. Inhibiting Trip12 or the 26S proteasome activity resulted in an increase in Sox6 protein levels in C2C12 myotubes. This control of Sox6 activity in muscle cells via Trip12 ubiquitination has significant phenotypic outcomes.", citationTitle:"Skelet Muscle. 2013 May 10;3(1):11. doi: 10.1186/2044-5040-3-11.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Muscular Atrophy"], pmid:"23663701", citationType:"PubMed", citationRef:"23663701"}}, {start: {_id:221}, end: {_id:232}, properties:{evidence:"PINK1 mutants associated with recessive Parkinson's disease are defective in inhibiting mitochondrial release of cytochrome c.Mutations in PTEN-induced kinase 1 (PINK1) gene cause recessive familial type 6 of Parkinson's disease (PARK6). We investigated molecular mechanisms underlying PINK1 neuroprotective function and PARK6 mutation-induced loss of PINK1 function. Overexpression of wild- type PINK1 blocked mitochondrial release of apoptogenic cytochrome c, caspase-3 activation and apoptotic cell death induced by proteasome inhibitor MG132. N-terminal truncated PINK1 (NDelta35), which lacks mitochondrial localization sequence, did not block MG132-induced cytochrome c release and cytotoxicity. Despite mitochondrial expression, PARK6 mutant (E240K), (H271Q), (G309D), (L347P), (E417G) and C-terminal truncated (CDelta145) PINK1 failed to inhibit MG132-induced cytochrome c release and caspase-3 activation. Overexpression of wild-type PINK1 blocked cytochrome c release and cell death caused by atractyloside, which opens mitochondrial permeability transition pore (mPTP). PARK6 PINK1 mutants failed to inhibit atractyloside-induced cytochrome c release. These results suggest that PINK1 exerts anti-apoptotic effect by inhibiting the opening of mPTP and that PARK6 mutant PINK1 loses its ability to prevent mPTP opening and cytochrome c release.", citationTitle:"Neurobiol Dis. 2007 Nov;28(2):216-26. Epub 2007 Jul 17.", annotationSubgraph:["Caspase subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17707122", citationType:"PubMed", citationRef:"17707122"}}, {start: {_id:300}, end: {_id:302}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss of Drosophila PGAM5 (dPGAM5) can suppress the muscle degeneration, motor defects, and shorter lifespan that result from dPINK1 inactivation and that can be attributed to mitochondrial degeneration.", citationTitle:"PLoS Genet. 2010 Dec 2;6(12):e1001229. doi: 10.1371/journal.pgen.1001229. ", annotationSubgraph:["Tumor necrosis factor subgraph"], pmid:"21151955", citationType:"PubMed", citationRef:"21151955"}}, {start: {_id:431}, end: {_id:436}, properties:{evidence:"Indeed, pY125 appears to protect brains against alpha-syn mediated toxicity, as this modification is reduced in aged human brain tissue and absent in brain tissue affected by Lewy body dementia", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Dementia"], annotationMeshanatomy:["Brain"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:641}, end: {_id:729}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Defective auxilin causing parkinsonism is in line with parkinsonism often being an endosomal disorder commonly related to CCVs and synaptic vesicle recycling.", citationTitle:"Parkinsonism & related disorders; Vol. 19; Iss. 3", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23211418", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"23211418"}}, {start: {_id:766}, end: {_id:768}, properties:{annotationCondition:["Normal Healthy State"], evidence:"A D126A parkin mutation abrogates cleavage induced by caspase-1 and -8, but not by caspase-3.", citationTitle:"J Biol Chem. 2003 Jun 27;278(26):23376-80. Epub 2003 Apr 11.", annotationSubgraph:["Ubiquitin subgraph", "Caspase subgraph"], pmid:"12692130", citationType:"PubMed", citationRef:"12692130"}}, {start: {_id:766}, end: {_id:770}, properties:{annotationCondition:["Normal Healthy State"], evidence:"A D126A parkin mutation abrogates cleavage induced by caspase-1 and -8, but not by caspase-3.", citationTitle:"J Biol Chem. 2003 Jun 27;278(26):23376-80. Epub 2003 Apr 11.", annotationSubgraph:["Ubiquitin subgraph", "Caspase subgraph"], pmid:"12692130", citationType:"PubMed", citationRef:"12692130"}}, {start: {_id:137}, end: {_id:782}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In addition, Œ±-synuclein overexpression has been shown to trigger the reduction of caspase 3 activity, which, in turn, leads to lower levels of p53 immunoreactivity (Alves Da Costa et al., 2002).", citationTitle:"Brain Res. 2009 Feb 23;1256:19-33. doi: 10.1016/j.brainres.2008.12.020. Epub 2008 Dec 24.", annotationSubgraph:["Synuclein subgraph", "Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19135032", citationType:"PubMed", citationRef:"19135032"}}, {start: {_id:790}, end: {_id:204}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Two predicted enzymatic domains exist in the LRRK2 protein: a GTPase domain with sequence similarity to Rab-like proteins and a kinase domain belonging to the tyrosine‚Äìkinase-like protein family (Fig. 1A). To probe the potential reciprocity in activity between the two domains,we created a panel of functional mutations predicted to exert specific defects in conserved residues crucial for enzyme activity (Fig. 1B). We established autophosphorylation assays utilizing immunoprecipitated LRRK2 protein to assess kinase activity in combination with phosphorylation of a generic kinase substrate, myelin basic protein (MBP).In comparison with autophosphorylation assays, MBP assays generally demonstrate half the signal-to-noise ratio, although in all assays performed in this study, MBP substrate phos- phorylation mimics the activity observed with autophosphorylation, but with more experimental variation (data not shown). Consistent with published results (12,17), the K1906M mutation diminishes kinase activity presumably through disruption of the highly conserved ATP-binding pocket.Similarly, the D1994A mutation inhibits kinase activity through mutation of the conserved aspartic acid residue found in all known kinase proteins.", citationTitle:"Hum Mol Genet. 2007 Jan 15;16(2):223-32. Epub 2007 Jan 2.", annotationSubgraph:["LRRK2 subgraph"], pmid:"17200152", citationType:"PubMed", citationRef:"17200152"}}, {start: {_id:792}, end: {_id:204}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Two predicted enzymatic domains exist in the LRRK2 protein: a GTPase domain with sequence similarity to Rab-like proteins and a kinase domain belonging to the tyrosine‚Äìkinase-like protein family (Fig. 1A). To probe the potential reciprocity in activity between the two domains,we created a panel of functional mutations predicted to exert specific defects in conserved residues crucial for enzyme activity (Fig. 1B). We established autophosphorylation assays utilizing immunoprecipitated LRRK2 protein to assess kinase activity in combination with phosphorylation of a generic kinase substrate, myelin basic protein (MBP).In comparison with autophosphorylation assays, MBP assays generally demonstrate half the signal-to-noise ratio, although in all assays performed in this study, MBP substrate phos- phorylation mimics the activity observed with autophosphorylation, but with more experimental variation (data not shown). Consistent with published results (12,17), the K1906M mutation diminishes kinase activity presumably through disruption of the highly conserved ATP-binding pocket.Similarly, the D1994A mutation inhibits kinase activity through mutation of the conserved aspartic acid residue found in all known kinase proteins.", citationTitle:"Hum Mol Genet. 2007 Jan 15;16(2):223-32. Epub 2007 Jan 2.", annotationSubgraph:["LRRK2 subgraph"], pmid:"17200152", citationType:"PubMed", citationRef:"17200152"}}, {start: {_id:931}, end: {_id:70}, properties:{evidence:"The interaction between BPS domain of Grb10 and IGF1R could directly inhibit IGF1R substrate phosphorylation [11], and decreased the levels of Grb10 expression below normal levels resulted in augmented IGF1 activation of Akt and ERK1/2 [9].", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:934}, end: {_id:938}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we investigate the role of Hepatocyte growth factor-Regulated tyrosine kinase Substrate (Hrs), a regulator of RTK trafficking, in VEGF and insulin signaling. We report that ectopic expression of Hrs increases VEGF-R2 and IR number and tyrosine phosphorylation, leading to amplification of their downstream signaling. The UIM (Ubiquitin Interacting Motif) domain of Hrs is required for Hrs-induced increases in VEGF-R2, but not in IR. Furthermore, Hrs is tyrosine-phosphorylated in response to VEGF and insulin. We show that the UIM domain is required for Hrs phosphorylation in response to VEGF, but not to insulin. Importantly, Hrs co-localizes with both VEGF-R2 and IR and co-immunoprecipitates with both in a manner independent of the Hrs-UIM domain. Finally, we demonstrate that Hrs inhibits Nedd4-mediated VEGF-R2 degradation and acts additively with Grb10. We conclude that Hrs is a positive regulator of VEGF-R2 and IR signaling and that ectopic expression of Hrs protects both VEGF-R2 and IR from degradation.", citationTitle:"Exp Cell Res. 2007 May 15;313(9):1927-42. Epub 2007 Mar 21.", annotationSubgraph:["Cytokine signaling subgraph", "GRB10 subgraph", "Ubiquitin subgraph", "Notch signaling subgraph"], pmid:"17445799", citationType:"PubMed", citationRef:"17445799"}}, {start: {_id:969}, end: {_id:965}, properties:{annotationBrco:["Cortical Neuron"], evidence:"Furthermore, serine but not tyrosine dominant negative mutant of STAT3 impaired NRTN induced neurite outgrowth, indicative of the role of STAT3 as a downstream mediator of NRTN function.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:1130}, end: {_id:1133}, properties:{evidence:"The loss of parkin function due to PD-linked mutations was found to disrupt the ubiquitination and degradation of FAF1, resulting in elevated FAF1 expression in SH-SY5Y cells.", citationComment:"Accumulation of the parkin substrate, FAF1, plays a key role in the dopaminergic neurodegeneration.", citationTitle:"Human molecular genetics; Vol. 22; Iss. 8", annotationSubgraph:["Apoptosis signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-04-15", annotationConfidence:["Very High"], pmid:"23307929", citationAuthorList:"Jee-Won Sul|Min-Young Park|Juhee Shin|Young-Ran Kim|Sung-Eun Yoo|Young-Yun Kong|Ki-Sun Kwon|Young Ho Lee|Eunhee Kim", citationType:"PubMed", citationRef:"23307929"}}, {start: {_id:1606}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental induction of ER-mitochondria interactions results in oxidative stress and impaired metabolic homeostasis, whereas downregulation of PACS-2 or IP3R1, proteins important for ER- mitochondria tethering or calcium transport, respectively, improves mitochondrial oxidative capacity and glucose metabolism in obese animals.", citationTitle:"Nat Med. 2014 Dec;20(12):1427-35. doi: 10.1038/nm.3735. Epub 2014 Nov 24.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"25419710", citationType:"PubMed", citationRef:"25419710"}}, {start: {_id:1607}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental induction of ER-mitochondria interactions results in oxidative stress and impaired metabolic homeostasis, whereas downregulation of PACS-2 or IP3R1, proteins important for ER- mitochondria tethering or calcium transport, respectively, improves mitochondrial oxidative capacity and glucose metabolism in obese animals.", citationTitle:"Nat Med. 2014 Dec;20(12):1427-35. doi: 10.1038/nm.3735. Epub 2014 Nov 24.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"25419710", citationType:"PubMed", citationRef:"25419710"}}, {start: {_id:394}, end: {_id:1657}, properties:{evidence:"While ROS are required for glucose metabolism and metastasis in triple-negative breast cancers (9), decreased SirT3 levels concomitant with high ROS levels are frequently observed in all breast cancers (8). Based on these findings, SirT3 is considered a tumor suppressor (5, 8). SirT3 regulates the activity of magnesium superoxide dismutase (MnSOD), which detoxifies superoxide to hydrogen peroxide (5, 7, 10,â€“14). Moreover, SirT3 has been linked to augmented transcription of MnSOD and catalase, both known targets of the transcription factor FOXO3A (15). The SirT3-dependent deacetylation of FOXO3A promotes both its nuclear translocation and its transcriptional activity (16, 17). Therefore, mechanistically, the reduction of SirT3 levels leads to an elevation in ROS levels by compromising the mitochondrial antioxidant machinery.", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Reactive oxygen species subgraph", "Mitochondrial subgraph", "Response to oxidative stress"], annotationMeshdisease:["Breast Neoplasms"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1721}, end: {_id:1731}, properties:{evidence:"Human PINK1 (hPink1res) fully complemented Complex I enzymatic activity in Pink1âˆ’/âˆ’ mouse fibroblasts (Fig 5B and â€‹and6B).6B). In contrast, two PD PINK1 clinical mutations G309D (Gly309 â†’ Asp) and W437X (Trp437 â†’ Xxx) as well as an artificial mutation K219A (Lys219 â†’ Ala) that inactivates the kinase domain (Silvestri et al, 2005) were not effective", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1733}, end: {_id:1731}, properties:{evidence:"Human PINK1 (hPink1res) fully complemented Complex I enzymatic activity in Pink1âˆ’/âˆ’ mouse fibroblasts (Fig 5B and â€‹and6B).6B). In contrast, two PD PINK1 clinical mutations G309D (Gly309 â†’ Asp) and W437X (Trp437 â†’ Xxx) as well as an artificial mutation K219A (Lys219 â†’ Ala) that inactivates the kinase domain (Silvestri et al, 2005) were not effective", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}] AS row
