MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1707}, end: {_id:562}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additionally, Î±-synuclein-null mice demonstrate increased resistance to 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP)", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Synuclein subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1747}, end: {_id:1746}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Human UBIAD1 localizes to mitochondria and converts vitamin K1 to vitamin K2.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1747}, end: {_id:1746}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, similar to UBIAD1 and MenA, Heix produces vitamin K2 in Drosophila.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph", "Vitamin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1753}, end: {_id:1746}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, similar to UBIAD1 and MenA, Heix produces vitamin K2 in Drosophila.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph", "Vitamin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1747}, end: {_id:1746}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Heix/UBIAD1 produces vitamin K2, and in our studies vitamin K2 rescued mitochondrial defects in numerous conditions that affect mitochondrial function.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:24}, end: {_id:1756}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin overexpression enhanced agonist-stimulated ATP production", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}] AS row
