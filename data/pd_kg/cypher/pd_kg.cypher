UNWIND [{start: {_id:1875}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hangen et al. show that the mitochondrial protein AIF regulates the biogenesis of respiratory chain complexes by interacting with, and by controlling the mitochondrial import of the mammalian homolog of yeast MIA40, CHCHD4, which is the central component of a redox- sensitive mitochondrial intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationSpecies:["4932"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:504}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hangen et al. show that the mitochondrial protein AIF regulates the biogenesis of respiratory chain complexes by interacting with, and by controlling the mitochondrial import of the mammalian homolog of yeast MIA40, CHCHD4, which is the central component of a redox- sensitive mitochondrial intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationSpecies:["4932"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1876}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hangen et al. show that the mitochondrial protein AIF regulates the biogenesis of respiratory chain complexes by interacting with, and by controlling the mitochondrial import of the mammalian homolog of yeast MIA40, CHCHD4, which is the central component of a redox- sensitive mitochondrial intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationSpecies:["4932"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1875}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"AIF regulates specific respiratory chain complexes by acting upstream of CHCHD4", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationSpecies:["4932"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:504}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"AIF regulates specific respiratory chain complexes by acting upstream of CHCHD4", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationSpecies:["4932"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1876}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"AIF regulates specific respiratory chain complexes by acting upstream of CHCHD4", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationSpecies:["4932"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1903}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hence, AIF is required for CHCHD4 expression, not vice versa.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1904}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hence, AIF is required for CHCHD4 expression, not vice versa.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1905}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hence, AIF is required for CHCHD4 expression, not vice versa.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1642}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The stress-induced upregulation of parkin is mediated by ATF4, a transcription factor of the Unfolded protein response subgraph (UPR) that binds to a specific CREB/ATF site within the parkin promoter.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "Unfolded protein response subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1642}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Transcriptional upregulation of parkin under ER stress is mediated by ATF4.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "Unfolded protein response subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1642}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Conceptually, c-Jun may terminate the ATF4-mediated upregulation of parkin expression by competing with ATF4 on the parkin promoter.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "Unfolded protein response subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1642}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In line with this scenario, we observed that c-Jun has a dominant effect on ATF4; it can suppress ATF4-mediated upregulation of parkin expression.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "Unfolded protein response subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:1633}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In line with these studies, we observed that phospho-JNK and phospho- c-Jun levels are increased in parkin-deficient patient fibro- blasts under ER stress", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:899}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In line with these studies, we observed that phospho-JNK and phospho- c-Jun levels are increased in parkin-deficient patient fibro- blasts under ER stress", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:509}, end: {_id:1961}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Importantly, NLRX1 synergistically potentiated ROS production induced by tumour necrosis factor a, Shigella infection and double-stranded RNA, resulting in amplified NF-kB-dependent and JUN amino-terminal kinasesdependent signalling. Together, these results identify NLRX1 as a NLR that contributes to the link between ROS generation at the mitochondria and innate immune responses.", citationTitle:"EMBO Rep. 2008 Mar;9(3):293-300. doi: 10.1038/sj.embor.7401161. Epub 2008 Jan 25.", annotationSubgraph:["Mitochondrial subgraph", "Tumor necrosis factor subgraph"], pmid:"18219313", citationType:"PubMed", citationRef:"18219313"}}, {start: {_id:1961}, end: {_id:35}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Strikingly, our results identify NLRX1 as an activator for the generation of ROS, and show that the protein amplifies NF-kB and JNK- dependent signalling.", citationTitle:"EMBO Rep. 2008 Mar;9(3):293-300. doi: 10.1038/sj.embor.7401161. Epub 2008 Jan 25.", annotationSubgraph:["MAPK subgraph", "Mitochondrial subgraph"], pmid:"18219313", citationType:"PubMed", citationRef:"18219313"}}, {start: {_id:1968}, end: {_id:1634}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Intracellular RNA viruses are sensed by receptors retinoic acid- inducible gene 1 (RIG-I)/melanoma differentiation-associated gene 5 (MDA5) that trigger the formation of MAVS signal complex on mitochondria.", citationTitle:"Cell Res. 2010 Sep;20(9):994-1011. doi: 10.1038/cr.2010.103. Epub 2010 Jul 13.", annotationSubgraph:["Interferon signaling subgraph", "Innate immune system subgraph"], pmid:"20628368", citationType:"PubMed", citationRef:"20628368"}}, {start: {_id:1969}, end: {_id:1634}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Intracellular RNA viruses are sensed by receptors retinoic acid- inducible gene 1 (RIG-I)/melanoma differentiation-associated gene 5 (MDA5) that trigger the formation of MAVS signal complex on mitochondria.", citationTitle:"Cell Res. 2010 Sep;20(9):994-1011. doi: 10.1038/cr.2010.103. Epub 2010 Jul 13.", annotationSubgraph:["Interferon signaling subgraph"], pmid:"20628368", citationType:"PubMed", citationRef:"20628368"}}, {start: {_id:1634}, end: {_id:1637}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consequently, this leads to the activation of TANK-binding kinase 1 (TBK1) and phosphorylation of interferon regulatory factor 3 (IRF3), both of which constitutively associate with cytosolic chaperone Hsp90. It remains largely unknown how MAVS activates TBK1/IRF3. In this study, we identified translocases of outer membrane 70 (Tom70), a mitochondrial import receptor, to interact with MAVS upon RNA virus infection. Ectopic expression or knockdown of Tom70 could enhance or impair IRF3-mediated gene expression, respectively.", citationTitle:"Cell Res. 2010 Sep;20(9):994-1011. doi: 10.1038/cr.2010.103. Epub 2010 Jul 13.", annotationSubgraph:["Interferon signaling subgraph"], pmid:"20628368", citationType:"PubMed", citationRef:"20628368"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1518}, end: {_id:1637}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This ultimately leads to the activation of TANK-binding kinase 1 (TBK1), which then phosphorylates interferon regulatory factor 3 (IRF3) on a series of Ser/Thr residues at its C-terminus.", citationTitle:"Cell Res. 2010 Sep;20(9):994-1011. doi: 10.1038/cr.2010.103. Epub 2010 Jul 13.", annotationSubgraph:["Interferon signaling subgraph", "Matrix metalloproteinase subgraph"], pmid:"20628368", citationType:"PubMed", citationRef:"20628368"}}, {start: {_id:1981}, end: {_id:771}, properties:{annotationCondition:["Normal Healthy State"], evidence:"NLRP3 is a key component of the macromolecular signaling complex called the inflammasome that promotes caspase 1-dependent production of IL-1beta. The adaptor ASC is necessary for NLRP3-dependent inflammasome function, but it is not known whether ASC is a sufficient partner and whether inflammasome formation occurs in the cytosol or in association with mitochondria is controversial. Here, we show that the mitochondria-associated adaptor molecule, MAVS, is required for optimal NLRP3 inflammasome activity. MAVS mediates recruitment of NLRP3 to mitochondria, promoting production of IL-1beta and the pathophysiologic activity of the NLRP3 inflammasome in vivo. Our data support a more complex model of NLRP3 inflammasome activation than previously appreciated, with at least two adapters required for maximal function. Because MAVS is a mitochondria-associated molecule previously considered to be uniquely involved in type 1 interferon production, these findings also reveal unexpected polygamous involvement of PYD/CARD-domain-containing adapters in innate immune signaling events.", citationTitle:"Cell. 2013 Apr 11;153(2):348-61. doi: 10.1016/j.cell.2013.02.054.", annotationSubgraph:["Caspase subgraph", "Interleukin signaling subgraph"], pmid:"23582325", citationType:"PubMed", citationRef:"23582325"}}, {start: {_id:1634}, end: {_id:771}, properties:{annotationCondition:["Normal Healthy State"], evidence:"NLRP3 is a key component of the macromolecular signaling complex called the inflammasome that promotes caspase 1-dependent production of IL-1beta. The adaptor ASC is necessary for NLRP3-dependent inflammasome function, but it is not known whether ASC is a sufficient partner and whether inflammasome formation occurs in the cytosol or in association with mitochondria is controversial. Here, we show that the mitochondria-associated adaptor molecule, MAVS, is required for optimal NLRP3 inflammasome activity. MAVS mediates recruitment of NLRP3 to mitochondria, promoting production of IL-1beta and the pathophysiologic activity of the NLRP3 inflammasome in vivo. Our data support a more complex model of NLRP3 inflammasome activation than previously appreciated, with at least two adapters required for maximal function. Because MAVS is a mitochondria-associated molecule previously considered to be uniquely involved in type 1 interferon production, these findings also reveal unexpected polygamous involvement of PYD/CARD-domain-containing adapters in innate immune signaling events.", citationTitle:"Cell. 2013 Apr 11;153(2):348-61. doi: 10.1016/j.cell.2013.02.054.", annotationSubgraph:["Interferon signaling subgraph", "Interleukin signaling subgraph"], pmid:"23582325", citationType:"PubMed", citationRef:"23582325"}}, {start: {_id:2009}, end: {_id:2010}, properties:{evidence:"Finally, the Foxa2-induced survival effect may also be due to induction of Nurr1 and Ptx3, two additional genes that we found to be positively regulated by Foxa2 in the NPCs", citationTitle:"Stem Cells. 2010 Mar 31;28(3):501-12. doi: 10.1002/stem.294.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], pmid:"20049900", citationType:"PubMed", citationRef:"20049900"}}, {start: {_id:2009}, end: {_id:1373}, properties:{evidence:"Finally, the Foxa2-induced survival effect may also be due to induction of Nurr1 and Ptx3, two additional genes that we found to be positively regulated by Foxa2 in the NPCs", citationTitle:"Stem Cells. 2010 Mar 31;28(3):501-12. doi: 10.1002/stem.294.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], pmid:"20049900", citationType:"PubMed", citationRef:"20049900"}}, {start: {_id:2009}, end: {_id:2011}, properties:{evidence:"We found that Foxa2 overexpression upregulated the mRNA levels of Ngn2, Mash1, and NeuroD in cortical NPCs (Fig. 4A). We confirmed the effect of Foxa2 on Ngn2 expression by immunocytochemistry", citationTitle:"Stem Cells. 2010 Mar 31;28(3):501-12. doi: 10.1002/stem.294.", annotationSubgraph:["Transcription subgraph"], pmid:"20049900", citationType:"PubMed", citationRef:"20049900"}}, {start: {_id:2012}, end: {_id:49}, properties:{evidence:"Our studies show that Foxa1 and Foxa2 positively regulate Lmx1a and Lmx1b expression In addition, Foxa1/2 are also required for the expression of Nurr1 in immature mdDA neurons", citationTitle:"Dev Biol. 2009 Sep 15;333(2):386-96. doi: 10.1016/j.ydbio.2009.07.006. Epub 2009 Jul 14.", annotationSubgraph:["Insulin signal transduction", "Transcription subgraph"], pmid:"19607821", citationType:"PubMed", citationRef:"19607821"}}, {start: {_id:2009}, end: {_id:49}, properties:{evidence:"Our studies show that Foxa1 and Foxa2 positively regulate Lmx1a and Lmx1b expression In addition, Foxa1/2 are also required for the expression of Nurr1 in immature mdDA neurons", citationTitle:"Dev Biol. 2009 Sep 15;333(2):386-96. doi: 10.1016/j.ydbio.2009.07.006. Epub 2009 Jul 14.", annotationSubgraph:["Insulin signal transduction", "Transcription subgraph"], pmid:"19607821", citationType:"PubMed", citationRef:"19607821"}}, {start: {_id:2012}, end: {_id:2013}, properties:{evidence:"Our studies show that Foxa1 and Foxa2 positively regulate Lmx1a and Lmx1b expression In addition, Foxa1/2 are also required for the expression of Nurr1 in immature mdDA neurons", citationTitle:"Dev Biol. 2009 Sep 15;333(2):386-96. doi: 10.1016/j.ydbio.2009.07.006. Epub 2009 Jul 14.", annotationSubgraph:["Insulin signal transduction", "Transcription subgraph"], pmid:"19607821", citationType:"PubMed", citationRef:"19607821"}}, {start: {_id:2009}, end: {_id:2013}, properties:{evidence:"Our studies show that Foxa1 and Foxa2 positively regulate Lmx1a and Lmx1b expression In addition, Foxa1/2 are also required for the expression of Nurr1 in immature mdDA neurons", citationTitle:"Dev Biol. 2009 Sep 15;333(2):386-96. doi: 10.1016/j.ydbio.2009.07.006. Epub 2009 Jul 14.", annotationSubgraph:["Insulin signal transduction", "Transcription subgraph"], pmid:"19607821", citationType:"PubMed", citationRef:"19607821"}}, {start: {_id:2012}, end: {_id:1373}, properties:{evidence:"Our studies show that Foxa1 and Foxa2 positively regulate Lmx1a and Lmx1b expression In addition, Foxa1/2 are also required for the expression of Nurr1 in immature mdDA neurons", citationTitle:"Dev Biol. 2009 Sep 15;333(2):386-96. doi: 10.1016/j.ydbio.2009.07.006. Epub 2009 Jul 14.", annotationSubgraph:["Insulin signal transduction", "Transcription subgraph"], pmid:"19607821", citationType:"PubMed", citationRef:"19607821"}}, {start: {_id:2009}, end: {_id:1373}, properties:{evidence:"Our studies show that Foxa1 and Foxa2 positively regulate Lmx1a and Lmx1b expression In addition, Foxa1/2 are also required for the expression of Nurr1 in immature mdDA neurons", citationTitle:"Dev Biol. 2009 Sep 15;333(2):386-96. doi: 10.1016/j.ydbio.2009.07.006. Epub 2009 Jul 14.", annotationSubgraph:["Insulin signal transduction", "Transcription subgraph"], pmid:"19607821", citationType:"PubMed", citationRef:"19607821"}}, {start: {_id:309}, end: {_id:2014}, properties:{evidence:"Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Bcl-2 subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}, {start: {_id:2014}, end: {_id:1416}, properties:{evidence:"Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Mitochondrial subgraph", "Bcl-2 subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}, {start: {_id:415}, end: {_id:2010}, properties:{evidence:"Here we show that a transient expression of glial cell line-derived neurotrophic factor (GDNF) in the murine ventral midbrain (VM) induces transcription of Pitx3", citationTitle:"J Neurosci. 2011 Sep 7;31(36):12802-15. doi: 10.1523/JNEUROSCI.0898-11.2011.", annotationSubgraph:["Neurotrophic subgraph", "Dopaminergic subgraph"], pmid:"21900559", citationType:"PubMed", citationRef:"21900559"}}, {start: {_id:2010}, end: {_id:414}, properties:{evidence:"and that Pitx3 is in turn required for activating the expression of brain-derived neurotrophic factor (BDNF) in a rostrolateral (SNc) mdDA neuron subpopulation during embryogenesis.", citationTitle:"J Neurosci. 2011 Sep 7;31(36):12802-15. doi: 10.1523/JNEUROSCI.0898-11.2011.", annotationSubgraph:["Neurotrophic subgraph", "Dopaminergic subgraph"], pmid:"21900559", citationType:"PubMed", citationRef:"21900559"}}, {start: {_id:309}, end: {_id:2010}, properties:{evidence:"The expression of key genes directly involved in VM/SNpc dopaminergic patterning, differentiation, and maturation (EN1, LMX1B, PITX3, NURR1, VMAT2, GIRK2, and dopamine transporter) is thus enhanced by Bcl-X(L)", citationTitle:"J Biol Chem. 2010 Mar 26;285(13):9881-97. doi: 10.1074/jbc.M109.054312. Epub 2010 Jan 27.", annotationSubgraph:["Bcl-2 subgraph", "Dopaminergic subgraph"], pmid:"20106970", citationType:"PubMed", citationRef:"20106970"}}, {start: {_id:970}, end: {_id:1373}, properties:{evidence:"The treatment with NGF rapidly induced the transcripts of NOR-l and Nurrl as well as NGFI-B in PC12 cells", citationTitle:"Mol Cell Endocrinol. 1995 Dec 29;115(2):227-30.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], pmid:"8824899", citationType:"PubMed", citationRef:"8824899"}}, {start: {_id:415}, end: {_id:1431}, properties:{evidence:"Treatment of mNSCs with GDNF increased mNSCs' sphere diameter, reduced expression of caspase 3, and increased expression of Bcl-2. Glial cell line-derived neurotrophic factor-treated mNSCs enhanced Nurr1 and Pitx3 expression and the fraction of TH-, TH/Pitx3-, and TH/Nurr1-positive cells in culture.", citationTitle:"J Neuropathol Exp Neurol. 2011 Sep;70(9):736-47. doi: 10.1097/NEN.0b013e31822830e5.", annotationSubgraph:["Bcl-2 subgraph", "Neurotrophic subgraph"], pmid:"21865882", citationType:"PubMed", citationRef:"21865882"}}, {start: {_id:415}, end: {_id:1373}, properties:{evidence:"Treatment of mNSCs with GDNF increased mNSCs' sphere diameter, reduced expression of caspase 3, and increased expression of Bcl-2. Glial cell line-derived neurotrophic factor-treated mNSCs enhanced Nurr1 and Pitx3 expression and the fraction of TH-, TH/Pitx3-, and TH/Nurr1-positive cells in culture.", citationTitle:"J Neuropathol Exp Neurol. 2011 Sep;70(9):736-47. doi: 10.1097/NEN.0b013e31822830e5.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], pmid:"21865882", citationType:"PubMed", citationRef:"21865882"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:415}, end: {_id:2010}, properties:{evidence:"Treatment of mNSCs with GDNF increased mNSCs' sphere diameter, reduced expression of caspase 3, and increased expression of Bcl-2. Glial cell line-derived neurotrophic factor-treated mNSCs enhanced Nurr1 and Pitx3 expression and the fraction of TH-, TH/Pitx3-, and TH/Nurr1-positive cells in culture.", citationTitle:"J Neuropathol Exp Neurol. 2011 Sep;70(9):736-47. doi: 10.1097/NEN.0b013e31822830e5.", annotationSubgraph:["Neurotrophic subgraph", "Dopaminergic subgraph"], pmid:"21865882", citationType:"PubMed", citationRef:"21865882"}}, {start: {_id:309}, end: {_id:2014}, properties:{evidence:"At nanomolar concentrations, a-SN protected neurons against serum deprivation, oxidative stress, and excitotoxicity through the PI3/Akt signaling pathway, and its protective effect was increased by Bcl-2 overexpression. Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity. This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release and caspase activation and also by microglia-mediated inflammatory responses via the NFkappaB and mitogen-activated protein kinase pathways.", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Bcl-2 subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}, {start: {_id:2014}, end: {_id:1416}, properties:{evidence:"At nanomolar concentrations, a-SN protected neurons against serum deprivation, oxidative stress, and excitotoxicity through the PI3/Akt signaling pathway, and its protective effect was increased by Bcl-2 overexpression. Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity. This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release and caspase activation and also by microglia-mediated inflammatory responses via the NFkappaB and mitogen-activated protein kinase pathways.", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Mitochondrial subgraph", "Bcl-2 subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}, {start: {_id:1416}, end: {_id:231}, properties:{evidence:"At nanomolar concentrations, a-SN protected neurons against serum deprivation, oxidative stress, and excitotoxicity through the PI3/Akt signaling pathway, and its protective effect was increased by Bcl-2 overexpression. Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity. This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release and caspase activation and also by microglia-mediated inflammatory responses via the NFkappaB and mitogen-activated protein kinase pathways.", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Caspase subgraph", "Bcl-2 subgraph", "Mitochondrial subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}, {start: {_id:196}, end: {_id:219}, properties:{evidence:"Here we show that recombinant human LRRK2 preferentially phosphorylates tubulin-beta purified from bovine brain and that phosphorylation is three-fold enhanced by the LRRK2(G2019S) mutation", citationTitle:"J Neurochem. 2009 Sep;110(5):1514-22. doi: 10.1111/j.1471-4159.2009.06235.x. Epub 2009 Jun 22.", annotationSubgraph:["Regulation of cytoskeleton subgraph", "LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19545277", citationType:"PubMed", citationRef:"19545277"}}, {start: {_id:196}, end: {_id:599}, properties:{evidence:"Importantly, mutations in the LRRK2 kinase domain(in particular the common p.G2019S mutation) significantly increased phosphorylation of PRDX3 compared to wild-type.", citationTitle:"Hum Mutat. 2011 Dec;32(12):1390-7. doi: 10.1002/humu.21582. Epub 2011 Sep 12.", annotationSubgraph:["LRRK2 subgraph", "Cell cycle subgraph"], pmid:"21850687", citationType:"PubMed", citationRef:"21850687"}}, {start: {_id:463}, end: {_id:452}, properties:{evidence:"Furthermore, we show that protein kinase A (PKA), but not LRRK2 kinase itself, can cause the phosphorylation of LRRK2 at S935 in vitro and in cell culture, suggesting that PKA is a potential upstream kinase that regulates LRRK2 function.", citationTitle:"PLoS One. 2011 Mar 1;6(3):e17153. doi: 10.1371/journal.pone.0017153.", annotationSubgraph:["LRRK2 subgraph", "Notch signaling subgraph"], pmid:"21390248", citationType:"PubMed", citationRef:"21390248"}}, {start: {_id:203}, end: {_id:2049}, properties:{evidence:"Our results demonstrate that both wild type (wt) LRRK2 and the G2019S LRRK2 mutant caused a significant increase in whole cell Ca(2+) current density compared to cells expressing only the CaV2.1 channel complex", citationTitle:"Front Mol Neurosci. 2016 May 23;9:35. doi: 10.3389/fnmol.2016.00035. eCollection 2016.", annotationSubgraph:["LRRK2 subgraph", "Calcium-dependent signal transduction"], pmid:"27242426", citationType:"PubMed", citationRef:"27242426"}}, {start: {_id:196}, end: {_id:2049}, properties:{evidence:"Our results demonstrate that both wild type (wt) LRRK2 and the G2019S LRRK2 mutant caused a significant increase in whole cell Ca(2+) current density compared to cells expressing only the CaV2.1 channel complex", citationTitle:"Front Mol Neurosci. 2016 May 23;9:35. doi: 10.3389/fnmol.2016.00035. eCollection 2016.", annotationSubgraph:["LRRK2 subgraph", "Calcium-dependent signal transduction"], pmid:"27242426", citationType:"PubMed", citationRef:"27242426"}}, {start: {_id:2081}, end: {_id:2071}, properties:{evidence:"Protein kinase C is also recruited into the large multiprotein complex forming at the adhesion point where it regulates the associations. Previous studies have underlined the involvement of PKC in HSPG- dependent phagocytosis in HeLa cells", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2111}, end: {_id:2112}, properties:{evidence:"The CRF-like peptide urocortin greatly attenuates loss of extracellular striatal dopamine in rat models of Parkinson's disease by activating CRF(1) receptors.", citationTitle:"Eur J Pharmacol. 2009 Feb 14;604(1-3):45-50. doi: 10.1016/j.ejphar.2008.11.009.", annotationSubgraph:["CRH subgraph", "Innate immune system subgraph"], annotationSpecies:["10116"], pmid:"19026631", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"19026631"}}, {start: {_id:529}, end: {_id:2115}, properties:{evidence:"The protective effect of urocortin involved the activation of CRF receptor type 1, resulting in the increase of cyclic AMP (cAMP) levels. Various cAMP-enhancing reagents mimicked the effect of urocortin, while inhibitors for protein kinase A (PKA) blocked the effect of urocortin, strongly implicating the involvement of cAMP-PKA pathway in the neuroprotective effect of urocortin on MPP(+)-induced cell death. As the downstream of this signal pathway, urocortin promoted phosphorylation of both glycogen synthase kinase 3β and extracellular signal-regulated kinases, which are known to promote cell survival.", citationTitle:"Mol Cells. 2010 Nov;30(5):427-33. doi: 10.1007/s10059-010-0132-x.", annotationSubgraph:["CRH subgraph", "Innate immune system subgraph"], annotationSpecies:["9606"], pmid:"20821057", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"20821057"}}, {start: {_id:2118}, end: {_id:2130}, properties:{evidence:"TREM-2 and DAP12-mediated signaling promotes survival of DCs and upregulation of CCR7, MHC class II, CD86, and CD40.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2131}, properties:{evidence:"TREM-2 and DAP12-mediated signaling promotes survival of DCs and upregulation of CCR7, MHC class II, CD86, and CD40.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2129}, end: {_id:2130}, properties:{evidence:"TREM-2 and DAP12-mediated signaling promotes survival of DCs and upregulation of CCR7, MHC class II, CD86, and CD40.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2129}, end: {_id:2131}, properties:{evidence:"TREM-2 and DAP12-mediated signaling promotes survival of DCs and upregulation of CCR7, MHC class II, CD86, and CD40.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2136}, properties:{evidence:"Because TREM2 and DAP12 signaling induced ERK phosphorylation in immature dendritic cells, we analyzed phosphorylation of ERK after cross linking stimulation of fTREM2 transduced microglia by Western blotting.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2129}, end: {_id:2136}, properties:{evidence:"Because TREM2 and DAP12 signaling induced ERK phosphorylation in immature dendritic cells, we analyzed phosphorylation of ERK after cross linking stimulation of fTREM2 transduced microglia by Western blotting.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"Pu