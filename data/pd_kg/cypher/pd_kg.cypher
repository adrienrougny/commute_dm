properties:{annotationCondition:["Normal Healthy State"], evidence:"Western blot analysis demonstrated that OXY markedly attenuated 6-OHDA-induced phosphorylation of JNK and c-Jun.", citationTitle:"Free Radic Biol Med. 2008 Oct 1;45(7):1019-26. doi: 10.1016/j.freeradbiomed.2008.07.002. Epub 2008 Jul 16.", annotationSpecies:["10116"], annotationMeshdisease:["Parkinson Disease"], pmid:"18675900", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"18675900"}}, {start: {_id:901}, end: {_id:895}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Luteolin has protective effects against 6-OHDA-induced cell apoptosis and might be a potential NTNal supplement which could be used to prevent neurodegenerative diseases such as PD.", citationTitle:"Pharm Biol. 2013 Feb;51(2):190-6. doi: 10.3109/13880209.2012.716852. Epub 2012 Oct 5.", pmid:"23035972", annotationCellline:["PC12"], citationType:"PubMed", citationRef:"23035972"}}, {start: {_id:901}, end: {_id:895}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pretreatment with luteolin (3.13, 6.25, 12.5, 25 or 50 √Ç¬µM) could markedly attenuate 6-OHDA-induced PC12 cell viability loss in a concentration-dependent manner.", citationTitle:"Pharm Biol. 2013 Feb;51(2):190-6. doi: 10.3109/13880209.2012.716852. Epub 2012 Oct 5.", pmid:"23035972", annotationCellline:["PC12"], citationType:"PubMed", citationRef:"23035972"}}, {start: {_id:901}, end: {_id:895}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Cell morphologic analysis and nuclear staining assays showed that luteolin (3.13, 12.5 or 50 √Ç¬µM) protected the cells from 6-OHDA- induced damage.", citationTitle:"Pharm Biol. 2013 Feb;51(2):190-6. doi: 10.3109/13880209.2012.716852. Epub 2012 Oct 5.", pmid:"23035972", annotationCellline:["PC12"], citationType:"PubMed", citationRef:"23035972"}}, {start: {_id:959}, end: {_id:953}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Dexamethasone, a glucocorticoid hormone receptor agonist, upregulated both protein and mRNA levels of TREK-1 leading to decreased NSC proliferation which could be reversed by bupivacaine. Fluoxetine, a serotonin reuptake inhibitor antidepressant that has been previously found to inhibit TREK-1 channels, robustly, could attenuate the upregulation of TREK-1 expression and the inhibition of NSC proliferation induced by dexamethasone.", citationTitle:"Psychopharmacology (Berl). 2011 Apr;214(3):747-59. doi: 10.1007/s00213-010-2077-3. Epub 2010 Nov 11.", annotationSubgraph:["Transport related subgraph"], pmid:"21069514", citationType:"PubMed", citationRef:"21069514"}}, {start: {_id:1047}, end: {_id:1049}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Squalane increased thiobarbituric acid reactive substances, a marker of lipid peroxidation, in the striatum. squalane increases oxidative damage in the striatum and exacerbates the toxicity of 6-OHDA, while squalene prevents it.", citationTitle:"J Oleo Sci. 2013;62(1):21-8.", pmid:"23357814", citationType:"PubMed", citationRef:"23357814"}}, {start: {_id:501}, end: {_id:1148}, properties:{evidence:"It is believed that the increase in the concentration of Hcy in PD can affect genetic polymorphisms of the folate metabolic pathway genes, such as MTHFR (C677T, A1298C and G1793A), MTR (A2756G), and MTHFD1 (G1958A), whose frequencies tend to increase in PD patients, as well as the reduced concentration of B vitamins.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationSubgraph:["Folate metabolic subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:1754}, end: {_id:1755}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Compared with MK-4, Q-10 was more effective at reducing DCPIP (Fig. 4F); however, when we placed 1-day-old adult pink1B9 animals on Q-10 medium,we observed a sys- temic and mitochondrial rescue that did not exceed that obtained when mutants were reared on MK-4 (fig. S10 and Fig. 3).", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1933}, end: {_id:1756}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Glutamate exposure causes mitochondrial depolarization and delayed loss of ATP", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:2162}, end: {_id:2177}, properties:{evidence:"7beta-hydroxy-dehydroepiandrosterone remained increased for 28 days, 7alpha-hydroxy-dehydroepiandrosterone, testosterone, estradiol and sex hormone-binding globulin were decreased as late as day 63 and 91, respectively. On the other hand, epitestosterone", pmid:"15843221", citationType:"PubMed", citationRef:"15843221"}}, {start: {_id:2162}, end: {_id:2180}, properties:{evidence:"7beta-hydroxy-dehydroepiandrosterone remained increased for 28 days, 7alpha-hydroxy-dehydroepiandrosterone, testosterone, estradiol and sex hormone-binding globulin were decreased as late as day 63 and 91, respectively. On the other hand, epitestosterone", pmid:"15843221", citationType:"PubMed", citationRef:"15843221"}}, {start: {_id:2162}, end: {_id:1225}, properties:{evidence:"7beta-hydroxy-dehydroepiandrosterone remained increased for 28 days, 7alpha-hydroxy-dehydroepiandrosterone, testosterone, estradiol and sex hormone-binding globulin were decreased as late as day 63 and 91, respectively. On the other hand, epitestosterone", pmid:"15843221", citationType:"PubMed", citationRef:"15843221"}}, {start: {_id:2162}, end: {_id:2180}, properties:{evidence:"Levels of sex steroids, testosterone and estradiol, decreased significantly. LH levels increased significantly, but the increase of androstenedione, SHBG and FSH was not significant. Decreasing tendency close to statistical significance was observed in co", pmid:"11300231", citationType:"PubMed", citationRef:"11300231"}}, {start: {_id:2162}, end: {_id:1225}, properties:{evidence:"Levels of sex steroids, testosterone and estradiol, decreased significantly. LH levels increased significantly, but the increase of androstenedione, SHBG and FSH was not significant. Decreasing tendency close to statistical significance was observed in co", pmid:"11300231", citationType:"PubMed", citationRef:"11300231"}}, {start: {_id:2162}, end: {_id:2178}, properties:{evidence:"Levels of sex steroids, testosterone and estradiol, decreased significantly. LH levels increased significantly, but the increase of androstenedione, SHBG and FSH was not significant. Decreasing tendency close to statistical significance was observed in co", pmid:"11300231", citationType:"PubMed", citationRef:"11300231"}}, {start: {_id:2162}, end: {_id:872}, properties:{evidence:"We found that many significant changes of lipid parameters occurred following 7-oxo-DHEA treatment. Total cholesterol was reduced, but the decrement was only of the borderline significance.", pmid:"11300231", citationType:"PubMed", citationRef:"11300231"}}] AS row
