UNWIND [{start: {_id:1739}, end: {_id:1738}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Expression of human PINK1, but not its clinical mutant G309D rescues mobilization of RP vesicles", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:2118}, end: {_id:2121}, properties:{evidence:"TREM-2 Does Not Activate IkappaBalpha and NF-kappaB or p38 and SAPK Signaling Pathways.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2122}, properties:{evidence:"TREM-2 Does Not Activate IkappaBalpha and NF-kappaB or p38 and SAPK Signaling Pathways.", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2123}, properties:{evidence:"TREM-2 Does Not Activate IkappaBalpha and NF-kappaB or p38 and SAPK Signaling Pathways.", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2125}, properties:{evidence:"TREM-2 Does Not Activate IkappaBalpha and NF-kappaB or p38 and SAPK Signaling Pathways.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2121}, properties:{evidence:"TREM-2 Does Not Activate IÎºBÎ±/NF-ÎºB or p38/SAPK Signaling Pathways.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2123}, properties:{evidence:"TREM-2 Does Not Activate IÎºBÎ±/NF-ÎºB or p38/SAPK Signaling Pathways.", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2125}, properties:{evidence:"TREM-2 Does Not Activate IÎºBÎ±/NF-ÎºB or p38/SAPK Signaling Pathways.", annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2133}, properties:{evidence:"Furthermore, expression levels of CD86 and CD36 were unaltered after stimulation of TREM2.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2138}, properties:{evidence:"Furthermore, expression levels of CD86 and CD36 were unaltered after stimulation of TREM2.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2148}, properties:{evidence:"However, forced expression of TREM-2 was not sufficient to reverse the inhibitory effects of IL-10 on osteoclastogenesis (XREF_FIG), suggesting that IL-10 inhibits additional aspects of the osteoclastogenesis program, possibly the activation or function o", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19625651", citationType:"PubMed", citationRef:"19625651"}}] AS row
