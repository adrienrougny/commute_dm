otationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"18358303", citationType:"PubMed", citationRef:"18358303"}}, {start: {_id:2258}, end: {_id:138}, properties:{evidence:"However, Smad3 ablation increased the MAO-B content in the VM by 38.9% (P = 0.010, Figure XREF_FIG).", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"21995845", citationType:"PubMed", citationRef:"21995845"}}, {start: {_id:2265}, end: {_id:1380}, properties:{evidence:"MIF has long been known to induce production and secretion of pro- inflammatory cytokines, mainly IL-1beta, TNF-alpha and IFN- gamma, as well as other inflammatory mediators such as nitric oxide", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"21550814", citationType:"PubMed", citationRef:"21550814"}}, {start: {_id:2265}, end: {_id:509}, properties:{evidence:"MIF has long been known to induce production and secretion of pro- inflammatory cytokines, mainly IL-1beta, TNF-alpha and IFN- gamma, as well as other inflammatory mediators such as nitric oxide", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"21550814", citationType:"PubMed", citationRef:"21550814"}}] AS row
