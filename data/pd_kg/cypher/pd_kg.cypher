UNWIND [{start: {_id:1746}, end: {_id:1716}, properties:{evidence:"This mitochondrial morphology defect was partially rescued by placing pink1B9 or park1/D21 on MK-4 (Fig. 3, H and I, and figs. S6 and S5, E to I) (10) and by overexpressing Heix (Fig. 3J and fig. S5J), indicating that this rescue of mitochondrial morphology was be- cause of a heix-dependent vitamin K2 deficit.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:809}, end: {_id:1758}, properties:{evidence:"The accumulation of damaged mitochondria has been linked to normal aging and multiple age-related disorders, in- cluding Alzheimerâ€™s disease, diabetes, and Parkinson disease (PD)", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationMeshdisease:["Alzheimer Disease", "Diabetes Mellitus", "Parkinson Disease"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1917}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondrial membrane dissipation causes ER stress and leads to transcriptional upregulation of parkin.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:626}, end: {_id:1930}, properties:{evidence:"In the absence of antioxidants, glutamate excitotoxicity may trigger the selective degradation of oxidatively damaged mitochondrial components through Parkin-dependent shuttling of MDVs.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
