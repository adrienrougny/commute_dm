UNWIND [{start: {_id:720}, end: {_id:16}, properties:{evidence:"Consistent with the idea that mitochondria are critical in neurodegeneration, complex I deficiency has been observed in postmortem PD brain and in peripheral tissues in PD patients, including platelets, lymphoblasts, muscle, and fibroblasts [5].", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Reactive oxygen species subgraph", "Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Muscles", "Blood Platelets"], annotationCell:["fibroblast"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:1878}, end: {_id:16}, properties:{evidence:"Dysregulation of the homeostatic mechanisms of mitochondrial maintenance (mitochondrial fission, fusion, transport, biogenesis and degradation â€” collectively termed â€˜mitochondrial dynamicsâ€™), has been increasingly linked to neurodegeneration and Parkinson's disease (PD) neuropathology", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1880}, end: {_id:16}, properties:{evidence:"Dysregulation of the homeostatic mechanisms of mitochondrial maintenance (mitochondrial fission, fusion, transport, biogenesis and degradation â€” collectively termed â€˜mitochondrial dynamicsâ€™), has been increasingly linked to neurodegeneration and Parkinson's disease (PD) neuropathology", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1836}, end: {_id:16}, properties:{evidence:"Dysregulation of the homeostatic mechanisms of mitochondrial maintenance (mitochondrial fission, fusion, transport, biogenesis and degradation â€” collectively termed â€˜mitochondrial dynamicsâ€™), has been increasingly linked to neurodegeneration and Parkinson's disease (PD) neuropathology", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
