CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:501}, end: {_id:1147}, properties:{evidence:"It is believed that the increase in the concentration of Hcy in PD can affect genetic polymorphisms of the folate metabolic pathway genes, such as MTHFR (C677T, A1298C and G1793A), MTR (A2756G), and MTHFD1 (G1958A), whose frequencies tend to increase in PD patients, as well as the reduced concentration of B vitamins.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationSubgraph:["Folate metabolic subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:1183}, end: {_id:1182}, properties:{evidence:"The current results point to the role of reduced FMRP in alterations of brain activity and behavior. Premutation carriers also had higher ratings of autism spectrum symptoms than control subjects, which were associated with the reduced amygdala response.", citationTitle:"Biol Psychiatry. 2011 Nov 1;70(9):859-65.", annotationSubgraph:["FMR1 subgraph"], pmid:"21783174", citationType:"PubMed", citationRef:"21783174"}}, {start: {_id:1225}, end: {_id:1228}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Estradiol increased astrocyte density and olfactory epithelium (OE) thickness regardless of the genotype. In addition estradiol treatment increased the number of mature neurons in the OE and glomerular synaptophysin in both genotypes, but the magnitude of increase was greater in the WT than in the KO mice. These data suggest that estrogen and apoE act synergistically to minimize the loss of mature sensory neurons and synapses following ovariectomy.", citationTitle:"Exp Neurol. 2012 Sep;237(1):1-7. doi: 10.1016/j.expneurol.2012.06.001. Epub 2012 Jun 9.", pmid:"22691461", citationType:"PubMed", citationRef:"22691461"}}, {start: {_id:1278}, end: {_id:1279}, properties:{evidence:"Dieldrin Induces Acetylation of Core Histones H3 and H4 in a Time- Dependent Manner in Dopaminergic Neuronal N27 Cells. we demonstrate that dieldrin increases histones acetylation in dopaminergic neuronal cells.", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:1278}, end: {_id:1280}, properties:{evidence:"Dieldrin Induces Acetylation of Core Histones H3 and H4 in a Time- Dependent Manner in Dopaminergic Neuronal N27 Cells. we demonstrate that dieldrin increases histones acetylation in dopaminergic neuronal cells.", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:1278}, end: {_id:1279}, properties:{evidence:"long-term dieldrin exposure in a mouse model also induces histone hyperacetylation in the striatum and substantia nigra", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:1278}, end: {_id:1280}, properties:{evidence:"long-term dieldrin exposure in a mouse model also induces histone hyperacetylation in the striatum and substantia nigra", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:1322}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"results suggest that increase of histone acetylation via treatment with the HDACI, TSA(Trichostatin A), causes induction of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±Syn which in part could be responsible for its neuroprotective effects in cerebral granule cells. The cerebellum as an anatomical brain area is not typically affected in PD.", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Synuclein subgraph"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1325}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Histone hyperacetylation by valproate has hence been seen to increase transcription of endogenous âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±Syn and the neuroprotective agent HSP70, as well as downregulate caspase-3 and hence reduce apoptosis.", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Synuclein subgraph"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1325}, end: {_id:651}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Histone hyperacetylation by valproate has hence been seen to increase transcription of endogenous âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±Syn and the neuroprotective agent HSP70, as well as downregulate caspase-3 and hence reduce apoptosis.", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Ubiquitin subgraph", "Chaperone subgraph"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1326}, end: {_id:220}, properties:{annotationCondition:["Normal Healthy State"], evidence:"phenylbutyrate exerts neuroprotective efficacy in the MPTP mouse model of PD.phenylbutyrate stringently up-regulates the DJ-1 protein and protects dopaminergic neurons from death.phenylbutyrate was able to reduce aggregation of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±Syn and prevent deterioration of motor symptoms and cognitive decline", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Chaperone subgraph"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1355}, end: {_id:603}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that miR-7, which is a brain-enriched miRNA, binds to the 3'-UTR of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±-Syn mRNA in a sequence-dependent manner and significantly inhibits its translation. miR-7 Inhibitor(2'-O-methyl) Up-Regulates alpha-Syn Expression.", citationTitle:"Proc Natl Acad Sci U S A. 2009 Aug 4;106(31):13052-7. doi: 10.1073/pnas.0906277106. Epub 2009 Jul 23.", annotationSpecies:["10090"], pmid:"19628698", annotationTranscriptionallyActiveRegion:["3'UTR"], citationType:"PubMed", citationRef:"19628698"}}, {start: {_id:809}, end: {_id:1416}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondria participate in apoptosis through a range of mechanisms that vary between vertebrates and invertebrates. In vertebrates, they release intermembrane space proteins, such as cytochrome c, to promote caspase activation in the cytosol. This process is the result of the loss of integrity of the outer mitochondrial membrane caused by proapoptotic members of the Bcl-2 family. This event is always accompanied by a fissioning of the organelle. Fission of mitochondria has also been reported to participate in apoptosis in Drosophila and Caenorhabditis elegans.", citationTitle:"Dev Cell. 2011 Jul 19;21(1):92-101. doi: 10.1016/j.devcel.2011.06.017.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"21763611", citationType:"PubMed", citationRef:"21763611"}}, {start: {_id:1522}, end: {_id:221}, properties:{evidence:"antimycin A-induced ROS may cause PINK1 buildup at local or individual import channels. This interplay between local and global PINK1 accumulation may regulate the magnitudes of subsequent parkin recruitment and ubiquitin ligase activity.", citationTitle:"EMBO J. 2014 Feb 18;33(4):282-95. doi: 10.1002/embj.201385902. Epub 2014 Jan 20.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"24446486", citationType:"PubMed", citationRef:"24446486"}}, {start: {_id:1566}, end: {_id:1568}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Certain environmental states, such as cold temperatures or high- calorie diets, are known to increase the activity of the sympathetic nervous system, leading to the release of norepinephrine. This neurotransmitter triggers activation of the Î²-adrenergic receptors, resulting in the elevation of intracellular cAMP and stimulation of adaptive thermogenesis in skeletal muscle and brown fat", citationTitle:"Cell. 1999 Jul 9;98(1):115-24.", annotationSubgraph:["G-protein-mediated signaling"], pmid:"10412986", citationType:"PubMed", citationRef:"10412986"}}, {start: {_id:516}, end: {_id:335}, properties:{annotationCondition:["Normal Healthy State"], evidence:"variable addressed by our study is the role of reactive oxygen species in activating mitochondrial chaperone-encoding genes. Interactions between these two processes are revealed by the observations that both Paraquat, which leads to accumulation of massive amount of reactive oxygen species and ethidium bromide, which primarily affects the integrity of the mitochondrial genome, activate hsp-60::gfp and the oxidative stress inducible reporter sod-3::gfp", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}, {start: {_id:1572}, end: {_id:335}, properties:{annotationCondition:["Normal Healthy State"], evidence:"variable addressed by our study is the role of reactive oxygen species in activating mitochondrial chaperone-encoding genes. Interactions between these two processes are revealed by the observations that both Paraquat, which leads to accumulation of massive amount of reactive oxygen species and ethidium bromide, which primarily affects the integrity of the mitochondrial genome, activate hsp-60::gfp and the oxidative stress inducible reporter sod-3::gfp", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}, {start: {_id:516}, end: {_id:1573}, properties:{annotationCondition:["Normal Healthy State"], evidence:"variable addressed by our study is the role of reactive oxygen species in activating mitochondrial chaperone-encoding genes. Interactions between these two processes are revealed by the observations that both Paraquat, which leads to accumulation of massive amount of reactive oxygen species and ethidium bromide, which primarily affects the integrity of the mitochondrial genome, activate hsp-60::gfp and the oxidative stress inducible reporter sod-3::gfp", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Response to oxidative stress"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}, {start: {_id:1572}, end: {_id:1573}, properties:{annotationCondition:["Normal Healthy State"], evidence:"variable addressed by our study is the role of reactive oxygen species in activating mitochondrial chaperone-encoding genes. Interactions between these two processes are revealed by the observations that both Paraquat, which leads to accumulation of massive amount of reactive oxygen species and ethidium bromide, which primarily affects the integrity of the mitochondrial genome, activate hsp-60::gfp and the oxidative stress inducible reporter sod-3::gfp", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Response to oxidative stress"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}, {start: {_id:1574}, end: {_id:216}, properties:{annotationCondition:["Normal Healthy State"], evidence:"the hsp-4::gfp reporter, like the endogenous gene, was unaltered by ethidium bromide but was markedly induced by either tunicamycin or heat shock and the cytoplasmic hsp-70::GFP reporter was inducible only by heat shock", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Chaperone subgraph"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1572}, end: {_id:1577}, properties:{annotationCondition:["Normal Healthy State"], evidence:"the induction of hsp-6 and hsp-60 was not shared by nuclear genes that encode enzymes active in the mitochondria, as neither the cts-1::gfp, the aco-2::gfp, which reports on the activity of mitochondrial aconitase, were activated by ethidium bromide", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}, {start: {_id:516}, end: {_id:1578}, properties:{evidence:"Mitochondrial toxins such as paraquat, which activated the UPRmt (Fig. 3A), are known to impair mitochondrial import causing the accumulation of MTS containing proteins in the cytosol . To determine if a general impairment of import occurs during UPRmt activation, we generated a transgenic strain expressing GFP with a MTS (GFPmt). Because steady- state detection of unprocessed MTS containing proteins is very difficult , we expressed GFPmt via the inducible hsp-16 promoter (fig. S6). Only in the presence of UPRmt-activating stress was unprocessed GFPmt detected in the post-mitochondrial supernatant consistent with impaired import (Fig. 2C). Similarly, when ATFS-1 was expressed via the hsp-16 promoter, unprocessed ATFS-1 was only detectable in the postmitochondrial supernatant during UPRmt-activating stress (Figs. 2D & S6). Import was not completely blocked during UPRmt activation because the processed forms of ATFS-1 (revealed by lon(RNAi)) and GFPmt were detected in mitochondria", citationTitle:"Science. 2012 Aug 3;337(6094):587-90. doi: 10.1126/science.1223560. Epub 2012 Jun 14.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"22700657", citationType:"PubMed", citationRef:"22700657"}}, {start: {_id:1629}, end: {_id:1631}, properties:{evidence:"Injury causes a systemic inflammatory response syndrome (SIRS) that is clinically much like sepsis. Microbial pathogen-associated molecular patterns (PAMPs) activate innate immunocytes through pattern recognition receptors. Similarly, cellular injury can release endogenous 'damage'-associated molecular patterns (DAMPs) that activate innate immunity. Mitochondria are evolutionary endosymbionts that were derived from bacteria and so might bear bacterial molecular motifs. Here we show that injury releases mitochondrial DAMPs (MTDs) into the circulation with functionally important immune consequences. MTDs include formyl peptides and mitochondrial DNA. These activate human polymorphonuclear neutrophils (PMNs) through formyl peptide receptor-1 and Toll-like receptor (TLR) 9, respectively. MTDs promote PMN Ca(2+) flux and phosphorylation of mitogen-activated protein (MAP) kinases, thus leading to PMN migration and degranulation in vitro and in vivo. Circulating MTDs can elicit neutrophil-mediated organ injury. Cellular disruption by trauma releases mitochondrial DAMPs with evolutionarily conserved similarities to bacterial PAMPs into the circulation. These signal through innate immune pathways identical to those activated in sepsis to create a sepsis-like state. The release of such mitochondrial 'enemies within' by cellular injury is a key link between trauma, inflammation and SIRS.", citationTitle:"Nature. 2010 Mar 4;464(7285):104-7. doi: 10.1038/nature08780.", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Systemic Inflammatory Response Syndrome"], pmid:"20203610", citationType:"PubMed", citationRef:"20203610"}}, {start: {_id:1629}, end: {_id:1632}, properties:{evidence:"Injury causes a systemic inflammatory response syndrome (SIRS) that is clinically much like sepsis. Microbial pathogen-associated molecular patterns (PAMPs) activate innate immunocytes through pattern recognition receptors. Similarly, cellular injury can release endogenous 'damage'-associated molecular patterns (DAMPs) that activate innate immunity. Mitochondria are evolutionary endosymbionts that were derived from bacteria and so might bear bacterial molecular motifs. Here we show that injury releases mitochondrial DAMPs (MTDs) into the circulation with functionally important immune consequences. MTDs include formyl peptides and mitochondrial DNA. These activate human polymorphonuclear neutrophils (PMNs) through formyl peptide receptor-1 and Toll-like receptor (TLR) 9, respectively. MTDs promote PMN Ca(2+) flux and phosphorylation of mitogen-activated protein (MAP) kinases, thus leading to PMN migration and degranulation in vitro and in vivo. Circulating MTDs can elicit neutrophil-mediated organ injury. Cellular disruption by trauma releases mitochondrial DAMPs with evolutionarily conserved similarities to bacterial PAMPs into the circulation. These signal through innate immune pathways identical to those activated in sepsis to create a sepsis-like state. The release of such mitochondrial 'enemies within' by cellular injury is a key link between trauma, inflammation and SIRS.", citationTitle:"Nature. 2010 Mar 4;464(7285):104-7. doi: 10.1038/nature08780.", annotationSubgraph:["Toll like receptor subgraph"], annotationMeshdisease:["Systemic Inflammatory Response Syndrome"], pmid:"20203610", citationType:"PubMed", citationRef:"20203610"}}, {start: {_id:1629}, end: {_id:1633}, properties:{evidence:"Injury causes a systemic inflammatory response syndrome (SIRS) that is clinically much like sepsis. Microbial pathogen-associated molecular patterns (PAMPs) activate innate immunocytes through pattern recognition receptors. Similarly, cellular injury can release endogenous 'damage'-associated molecular patterns (DAMPs) that activate innate immunity. Mitochondria are evolutionary endosymbionts that were derived from bacteria and so might bear bacterial molecular motifs. Here we show that injury releases mitochondrial DAMPs (MTDs) into the circulation with functionally important immune consequences. MTDs include formyl peptides and mitochondrial DNA. These activate human polymorphonuclear neutrophils (PMNs) through formyl peptide receptor-1 and Toll-like receptor (TLR) 9, respectively. MTDs promote PMN Ca(2+) flux and phosphorylation of mitogen-activated protein (MAP) kinases, thus leading to PMN migration and degranulation in vitro and in vivo. Circulating MTDs can elicit neutrophil-mediated organ injury. Cellular disruption by trauma releases mitochondrial DAMPs with evolutionarily conserved similarities to bacterial PAMPs into the circulation. These signal through innate immune pathways identical to those activated in sepsis to create a sepsis-like state. The release of such mitochondrial 'enemies within' by cellular injury is a key link between trauma, inflammation and SIRS.", citationTitle:"Nature. 2010 Mar 4;464(7285):104-7. doi: 10.1038/nature08780.", annotationSubgraph:["MAPK subgraph"], annotationMeshdisease:["Systemic Inflammatory Response Syndrome"], pmid:"20203610", citationType:"PubMed", citationRef:"20203610"}}, {start: {_id:1645}, end: {_id:1641}, properties:{annotationCondition:["Normal Healthy State"], evidence:"CHX decreases Tim17A independent of stress in HEK293T cells (Figure S1I). Neither Tim17B nor Tim23 were significantly affected by CHX. CHX reduces Tim17A in both MEFWT and MEFA/A (Figure 1H), demonstrating that CHX decreases Tim17A independent of eIF2Î± phosphorylation. CHX is known to increase eIF2Î± phosphorylation (Jiang et al., 2003) (shown in the CHX-treated MEFWT cell; Figure 1H), but CHX prevents translation of ISR induced stress-responsive genes.", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Unfolded protein response subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1750}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, time-dependent oxygen consumption of intact mitochondria prepared from pink1B9 mutants was increased when the flies were first placed on MK-4", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["PINK1 subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1933}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we discovered that brief exposure to physiologically relevant concentrations of glutamate leads to significant Parkin accumulation on mitochondria in neurons, via activation of NMDA receptors and calcium influx.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:44}, end: {_id:2010}, properties:{evidence:"Acute morphine produced a marked increase in TH activity and DA turnover in the NAc, concomitantly with increased Nurr1 and Pitx3 expression in the VTA.These effects paralleled decreases in Ago2 expression, which was accompanied by increased Nurr1 and Pitx3, TH activity and normalized TH protein levels in the VTA", citationTitle:"Br J Pharmacol. 2013 Apr;168(8):1889-901. doi: 10.1111/bph.12083.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Ventral Tegmental Area", "Nucleus Accumbens"], annotationConfidence:["High"], pmid:"23215787", citationType:"PubMed", citationRef:"23215787"}}, {start: {_id:44}, end: {_id:2093}, properties:{evidence:"Acute morphine produced a marked increase in TH activity and DA turnover in the NAc, concomitantly with increased Nurr1 and Pitx3 expression in the VTA.These effects paralleled decreases in Ago2 expression, which was accompanied by increased Nurr1 and Pitx3, TH activity and normalized TH protein levels in the VTA", citationTitle:"Br J Pharmacol. 2013 Apr;168(8):1889-901. doi: 10.1111/bph.12083.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Ventral Tegmental Area", "Nucleus Accumbens"], annotationConfidence:["High"], pmid:"23215787", citationType:"PubMed", citationRef:"23215787"}}, {start: {_id:2162}, end: {_id:2165}, properties:{evidence:"Feeding 7-oxo-DHEA decreased body weight gain of rats, increased liver mass, catalase activity (/67%), and fatty acyl CoA oxidase (/128%) (Table I) as does DHEA (4).", annotationSpecies:["10116"], annotationConfidence:["Very High"], pmid:"9143361", citationType:"PubMed", citationRef:"9143361"}}, {start: {_id:2162}, end: {_id:2172}, properties:{evidence:"Cytosolic G-3-P dehydrogenase also increased in response to feeding 7-oxo-DHEA as it does to DHEA (7, 34)", annotationSpecies:["10116"], annotationConfidence:["Very High"], pmid:"9143361", citationType:"PubMed", citationRef:"9143361"}}, {start: {_id:2162}, end: {_id:2185}, properties:{evidence:"HDL-C and Apo A-I significantly increased at the end of the test period. The atherogenic index (AI, calculated as ratio TC/HDL-C) decreased and this change was strongly significant.", pmid:"11300231", citationType:"PubMed", citationRef:"11300231"}}, {start: {_id:2162}, end: {_id:2188}, properties:{evidence:"TG and LDL-C were diminished non-significantly, Apo B and Lp(a) rose slightly, but significantly", pmid:"11300231", citationType:"PubMed", citationRef:"11300231"}}, {start: {_id:2162}, end: {_id:2189}, properties:{evidence:"TG and LDL-C were diminished non-significantly, Apo B and Lp(a) rose slightly, but significantly", pmid:"11300231", citationType:"PubMed", citationRef:"11300231"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1001}, end: {_id:1004}, properties:{annotationCondition:["Normal Healthy State"], evidence:"There is a concentration-driven flux of 24S-hydroxycholesterol (24S-OHC) from the brain into the circulation, which is of major importance for elimination of excess cholesterol from the brain. The opposite flux of 27-hydroxycholesterol (27-OHC) from the circulation into the brain may regulate a number of key enzymes within the brain. In vitro experiments suggest that the balance between the levels of these two molecules may be of importance for the generation of beta- amyloid peptides. In primary cultures of rat hippocampal cells 27-OHC is able to suppress expression of the activity regulated cytoskeleton- associated protein (Arc), a protein important in memory consolidation which is reduced in patients with Alzheimer's disease (AD).", citationTitle:"Mol Aspects Med. 2009 Jun;30(3):171-9. doi: 10.1016/j.mam.2009.02.001. Epub 2009 Feb 25.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"19248803", citationType:"PubMed", citationRef:"19248803"}}, {start: {_id:1005}, end: {_id:1008}, properties:{annotationCondition:["Normal Healthy State"], evidence:"There is a concentration-driven flux of 24S-hydroxycholesterol (24S-OHC) from the brain into the circulation, which is of major importance for elimination of excess cholesterol from the brain. The opposite flux of 27-hydroxycholesterol (27-OHC) from the circulation into the brain may regulate a number of key enzymes within the brain. In vitro experiments suggest that the balance between the levels of these two molecules may be of importance for the generation of beta- amyloid peptides. In primary cultures of rat hippocampal cells 27-OHC is able to suppress expression of the activity regulated cytoskeleton- associated protein (Arc), a protein important in memory consolidation which is reduced in patients with Alzheimer's disease (AD).", citationTitle:"Mol Aspects Med. 2009 Jun;30(3):171-9. doi: 10.1016/j.mam.2009.02.001. Epub 2009 Feb 25.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"19248803", citationType:"PubMed", citationRef:"19248803"}}, {start: {_id:1775}, end: {_id:1932}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Under conditions that preserved ATP (by altering neuronal bioenergetics), we did observe CCCP-triggered Parkinâ€“mitochondrial translocation occurring in neurons. Even with these conditions, however, increased mitophagy was not observed", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1933}, end: {_id:1932}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Brief exposure to glutamate causes Parkin translocation to mitochondria in neurons", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:267}, end: {_id:1932}, properties:{evidence:"A previous study had suggested a possible role for ROS in promoting the Parkin translocation process (Joselin et al., 2012). Glutamate excitotoxicity is known to increase pro- duction of ROS", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1934}, end: {_id:1932}, properties:{evidence:"and therefore, we had expected that NAC would inhibit Parkinâ€“mitochondrial translocation.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1934}, end: {_id:1932}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus the addition of NAC could potentially result in a larger pool of functional Parkin, facilitating Parkinâ€“mitochondria interactions.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1041}, end: {_id:1043}, properties:{evidence:"Na(v)1.7 sodium channels can amplify weak stimuli in neurons and act as threshold channels for firing action potentials. Neurotrophic factors and pro-nociceptive cytokines that are released during development and under pathological conditions activate mitogen- activated protein kinases (MAPKs). Previous studies have shown that MAPKs can transduce developmental or pathological signals by regulating transcription factors that initiate a gene expression response, a long-term effect, and directly modulate neuronal ion channels including sodium channels, thus acutely regulating dorsal root ganglion (DRG) neuron excitability. For example, neurotrophic growth factor activates (phosphorylates) ERK1/2 MAPK (pERK1/2) in DRG neurons, an effect that has been implicated in injury-induced hyperalgesia. However, the acute effects of pERK1/2 on sodium channels are not known. We have shown previously that activated p38 MAPK (pp38) directly phosphorylates Na(v)1.6 and Na(v)1.8 sodium channels and regulates their current densities without altering their gating properties. We now report that acute inhibition of pERK1/2 regulates resting membrane potential and firing properties of DRG neurons. We also show that pERK1 phosphorylates specific residues within L1 of Na(v)1.7, inhibition of pERK1/2 causes a depolarizing shift of activation and fast inactivation of Na(v)1.7 without altering current density, and mutation of these L1 phosphoacceptor sites abrogates the effect of pERK1/2 on this channel. Together, these data are consistent with direct phosphorylation and modulation of Na(v)1.7 by pERK1/2, which unlike the modulation of Na(v)1.6 and Na(v)1.8 by pp38, regulates gating properties of this channel but not its current density and contributes to the effects of MAPKs on DRG neuron excitability.", citationTitle:"J Neurosci. 2010 Feb 3;30(5):1637-47. doi: 10.1523/JNEUROSCI.4872-09.2010.", annotationSubgraph:["Calcium-dependent signal transduction"], annotationMeshdisease:["Hyperglycemia"], pmid:"20130174", citationType:"PubMed", citationRef:"20130174"}}, {start: {_id:1043}, end: {_id:1044}, properties:{evidence:"Na(v)1.7 sodium channels can amplify weak stimuli in neurons and act as threshold channels for firing action potentials. Neurotrophic factors and pro-nociceptive cytokines that are released during development and under pathological conditions activate mitogen- activated protein kinases (MAPKs). Previous studies have shown that MAPKs can transduce developmental or pathological signals by regulating transcription factors that initiate a gene expression response, a long-term effect, and directly modulate neuronal ion channels including sodium channels, thus acutely regulating dorsal root ganglion (DRG) neuron excitability. For example, neurotrophic growth factor activates (phosphorylates) ERK1/2 MAPK (pERK1/2) in DRG neurons, an effect that has been implicated in injury-induced hyperalgesia. However, the acute effects of pERK1/2 on sodium channels are not known. We have shown previously that activated p38 MAPK (pp38) directly phosphorylates Na(v)1.6 and Na(v)1.8 sodium channels and regulates their current densities without altering their gating properties. We now report that acute inhibition of pERK1/2 regulates resting membrane potential and firing properties of DRG neurons. We also show that pERK1 phosphorylates specific residues within L1 of Na(v)1.7, inhibition of pERK1/2 causes a depolarizing shift of activation and fast inactivation of Na(v)1.7 without altering current density, and mutation of these L1 phosphoacceptor sites abrogates the effect of pERK1/2 on this channel. Together, these data are consistent with direct phosphorylation and modulation of Na(v)1.7 by pERK1/2, which unlike the modulation of Na(v)1.6 and Na(v)1.8 by pp38, regulates gating properties of this channel but not its current density and contributes to the effects of MAPKs on DRG neuron excitability.", citationTitle:"J Neurosci. 2010 Feb 3;30(5):1637-47. doi: 10.1523/JNEUROSCI.4872-09.2010.", annotationSubgraph:["Calcium-dependent signal transduction"], annotationMeshdisease:["Hyperglycemia"], pmid:"20130174", citationType:"PubMed", citationRef:"20130174"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1358}, end: {_id:16}, properties:{evidence:"Our own recent data indicate that downregulation of miR-34b/c occurs in several brain areas of PD patients and further suggest that miR-34b/c downregulation underlie early mitochondrial dysfunction in PD", citationTitle:"Hum Mol Genet. 2011 Aug 1;20(15):3067-78. doi: 10.1093/hmg/ddr210. Epub 2011 May 10.", annotationSubgraph:["miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21558425", citationType:"PubMed", citationRef:"21558425"}}, {start: {_id:1358}, end: {_id:16}, properties:{evidence:"miR-34b/c cluster is downregulated at advanced stages of PD", citationTitle:"Hum Mol Genet. 2011 Aug 1;20(15):3067-78. doi: 10.1093/hmg/ddr210. Epub 2011 May 10.", annotationSubgraph:["miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21558425", citationType:"PubMed", citationRef:"21558425"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:223}, end: {_id:220}, properties:{evidence:"When we considered a three-marker sliding window, we found a highly significant association between the disease and the haplotypes including markers rs17523802, Ins/Del, and rs3766606 (p = 0.0007) and markers Ins/Del, rs3766606 and rs7517357 (p = 0.0054). Our results indicate that polymorphisms located in a region spanning 3535 bp from the promoter to the intron 2 of the DJ-1 gene confer risk to sporadic PD in southern Italy.", citationTitle:"Clin Genet. 2010 Feb;77(2):183-8. doi: 10.1111/j.1399-0004.2009.01310.x. Epub 2009 Nov 23.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19968671", citationType:"PubMed", citationRef:"19968671"}}, {start: {_id:469}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:681}, end: {_id:137}, properties:{evidence:"The few available pathology reports from patients with PLA2G6 mutations have consistently shown a high load of alpha-synuclein pathology, both in patients with NBIA and with dystonia-parkinsonism [127] and [128].", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Synuclein subgraph", "Lipid metabolism subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], annotationMeshanatomy:["Muscles"], pmid:"23462481", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:1239}, end: {_id:1238}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Olfactory neurons are known to express beta-adrenergic receptors (ARs), and we found that coexpression with beta(1)-ARs, but not any other AR subtypes, dramatically increased mouse 71 (M71) OR surface expression", citationTitle:"Proc Natl Acad Sci U S A. 2004 Sep 14;101(37):13672-6. Epub 2004 Sep 3.", annotationSubgraph:["G-protein-mediated signaling"], annotationSpecies:["10090"], pmid:"15347813", citationType:"PubMed", citationRef:"15347813"}}, {start: {_id:1346}, end: {_id:1348}, properties:{evidence:"FGF2, another member in the FGF family that acts through FGFR1, has been shown to upregulate the expression of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±-synuclein", citationTitle:"Am J Hum Genet. 2008 Feb;82(2):283-9. doi: 10.1016/j.ajhg.2007.09.021. Epub 2008 Jan 31.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"18252210", annotationTranscriptionallyActiveRegion:["exon 3"], citationType:"PubMed", citationRef:"18252210"}}, {start: {_id:1375}, end: {_id:238}, properties:{evidence:"We have identified two homozygous mutations affecting the PINK1 kinase domain in three consanguineous PARK6 families: a truncating nonsense mutation and a missense mutation at a highly conserved amino acid.The Spanish family carried a G->A transition in exon 4,resulting in amino acid substitution(G309D)at highly conserved position.Both Italian families carried the same G->A transition in exon 7 which results in W437OPA substitution.", citationTitle:"Science. 2004 May 21;304(5674):1158-60. Epub 2004 Apr 15.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"15087508", annotationTranscriptionallyActiveRegion:["exon 4"], citationType:"PubMed", citationRef:"15087508", annotationRace:["Spanish"]}}, {start: {_id:1375}, end: {_id:1377}, properties:{evidence:"We have identified two homozygous mutations affecting the PINK1 kinase domain in three consanguineous PARK6 families: a truncating nonsense mutation and a missense mutation at a highly conserved amino acid.The Spanish family carried a G->A transition in exon 4,resulting in amino acid substitution(G309D)at highly conserved position.Both Italian families carried the same G->A transition in exon 7 which results in W437OPA substitution.", citationTitle:"Science. 2004 May 21;304(5674):1158-60. Epub 2004 Apr 15.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"15087508", annotationTranscriptionallyActiveRegion:["exon 7"], citationType:"PubMed", citationRef:"15087508", annotationRace:["Italian"]}}, {start: {_id:1388}, end: {_id:1382}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PDE4D binds Rheb in a noncatalytic manner that does not require its cAMP-hydrolyzing activity and thereby inhibits the ability of Rheb to activate mTORC1. However, elevated cAMP levels disrupt the interaction of PDE4D with Rheb and increase the interaction between Rheb and mTOR. This enhanced Rheb-mTOR interaction induces the activation of mTORC1 and cap-dependent translation, a cellular function of mTORC1. Taken together, our results suggest a novel regulatory mechanism for mTORC1 in which the cAMP-determined dynamic interaction between Rheb and PDE4D provides a key, unique regulatory event. We also propose a new role for PDE4 as a molecular transducer for cAMP signaling.", citationTitle:"Mol Cell Biol. 2010 Nov;30(22):5406-20. doi: 10.1128/MCB.00217-10. Epub 2010 Sep 13.", annotationSubgraph:["Cyclic AMP subgraph"], annotationSpecies:["9606"], pmid:"20837708", citationType:"PubMed", citationRef:"20837708"}}, {start: {_id:1710}, end: {_id:231}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Subcellular fractionation indicates that approximately 10% of the total LRRK2 protein is localized to the mitochondrial outer membrane (Biskup et al, 2006; West et al, 2005), and LRRK2-mediated cell toxicity might involve cytochrome c release and caspase 3 activation", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Caspase subgraph", "LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1770}, end: {_id:1418}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 recruits Parkin to the mitochondrion in a PINK1-dependent manner, without promoting mitophagy.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1808}, end: {_id:1418}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin is recruited to mitochondria with preserved Î”Î¨m by PINK1, particularly when mitochondrial import is blocked.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph", "Synuclein subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1885}, end: {_id:1881}, properties:{evidence:"Depletion or hypomorphic mutation of AIF caused a downregulation of CHCHD4 protein by diminishing its mitochondrial import.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:414}, end: {_id:16}, properties:{evidence:"Given these properties, exogenous administration of neurotrophic factors to the PD midbrain or striatum could potentially slow down, halt or even reverse the loss of nigrostriatal DA neurons.", citationTitle:"Neural Regen Res. 2014 Oct 1;9(19):1708-11. doi: 10.4103/1673-5374.143410.", annotationSubgraph:["Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Corpus Striatum"], pmid:"25422631", citationType:"PubMed", citationRef:"25422631"}}, {start: {_id:415}, end: {_id:16}, properties:{evidence:"GDNF is the neurotrophic factor that has attracted the most attention in terms of its potential as a neuroprotective/regenerative therapy for PD.", citationTitle:"Neural Regen Res. 2014 Oct 1;9(19):1708-11. doi: 10.4103/1673-5374.143410.", annotationSubgraph:["Neurotrophic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25422631", citationType:"PubMed", citationRef:"25422631"}}, {start: {_id:417}, end: {_id:16}, properties:{evidence:"Another TGF-beta superfamily DA neurotrophic factor, GDF5, is in pre- clinical development as a therapeutic for PD.", citationTitle:"Neural Regen Res. 2014 Oct 1;9(19):1708-11. doi: 10.4103/1673-5374.143410.", annotationSubgraph:["Neurotrophic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25422631", citationType:"PubMed", citationRef:"25422631"}}, {start: {_id:529}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Clearly, a compound which possesses the ability to prevent cellular apoptosis, free radical damage, and inflammation would be a good candidate as a protective agent against the ravages of PD. These three prerequisites have been found for Ucn 1 in other tissues .", citationTitle:"Int J Biochem Cell Biol. 2015 Mar;60C:130-138. doi: 10.1016/j.biocel.2014.12.005. Epub 2014 Dec 23.", annotationSubgraph:["Innate immune system subgraph"], pmid:"25541373", citationType:"PubMed", citationRef:"25541373"}}, {start: {_id:529}, end: {_id:530}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Clearly, a compound which possesses the ability to prevent cellular apoptosis, free radical damage, and inflammation would be a good candidate as a protective agent against the ravages of PD. These three prerequisites have been found for Ucn 1 in other tissues .", citationTitle:"Int J Biochem Cell Biol. 2015 Mar;60C:130-138. doi: 10.1016/j.biocel.2014.12.005. Epub 2014 Dec 23.", annotationSubgraph:["Reactive oxygen species subgraph", "Innate immune system subgraph"], pmid:"25541373", citationType:"PubMed", citationRef:"25541373"}}, {start: {_id:621}, end: {_id:682}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This correlated with increased motor neuron survival, reduced oxidative stress, and attenuated gliosis in the spinal cord, as well as a dramatic decrease in total hSYN(A53T) and phosphorylated (Ser129) hSYN(A53T) in Triton-insoluble aggregates. Furthermore, Nrf2 in astrocytes delayed chaperone-mediated autophagy and macroautophagy dysfunction observed in the hSYN(A53T) mice", citationTitle:"The Journal of neuroscience : the official journal of the Society for Neuroscience; Vol. 32; Iss. 49", annotationSubgraph:["Notch signaling subgraph"], pmid:"23223297", citationType:"PubMed", citationRef:"23223297"}}, {start: {_id:1055}, end: {_id:1056}, properties:{evidence:"Oligophrenin-1 (OPHN1) encodes a Rho-GTPase-activating protein (Rho- GAP) whose loss of function causes X-linked mental retardation.", citationTitle:"Curr Biol. 2009 Jul 14;19(13):1133-9. doi: 10.1016/j.cub.2009.05.022. Epub 2009 May 28.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationMeshdisease:["Mental Retardation, X-Linked"], pmid:"19481455", citationType:"PubMed", citationRef:"19481455"}}, {start: {_id:1399}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"the present inventors have contemplated the use of METRNL in the treatment of disorders of the central nervous system, in particular in the treatment of hearing loss, deafness, tinnitus, otitis, labyrintitis, hereditary and cochleovestibular atrophies, Meniere's Disease, treatment of stroke, injury or trauma of the CNS, treatment of Parkinson's Disease", citationTitle:"Therapeutic use of a growth factor, METRNL: Patent Number: US8334264 B2", annotationSubgraph:["Neurotrophic subgraph"], citationType:"Other", citationRef:"US8334264"}}, {start: {_id:1587}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that the key point of regulation is the mitochondrial import efficiency of ATFS-1. In addition to a nuclear localization sequence, ATFS-1 has an N-terminal mitochondrial targeting sequence that is essential for UPR(mt) repression. Normally, ATFS-1 is imported into mitochondria and degraded. However, during mitochondrial stress, we found that import efficiency was reduced, allowing a percentage of ATFS-1 to accumulate in the cytosol and traffic to the nucleus. Our results show that cells monitor mitochondrial import efficiency via ATFS-1 to coordinate the level of mitochondrial dysfunction with the protective transcriptional response.", citationTitle:"Science. 2012 Aug 3;337(6094):587-90. doi: 10.1126/science.1223560. Epub 2012 Jun 14.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22700657", citationType:"PubMed", citationRef:"22700657"}}, {start: {_id:1587}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Included in the ATFS-1 program were many genes with roles in protecting against mitochondrial dysfunction (Fig. 4C) including the mitochondrial chaperones dnj-10 (14) (Fig. 4D) and hsp-60 (Fig. S13B). Numerous components involved in reactive oxygen species detoxification required ATFS-1 for induction during stress including the transcription factor skn-1 (15) (Fig. 4E). Several glycolysis genes including gpd-2 (glyceraldehyde-3-phosphate dehydrogenase) were also induced (Fig. 4F) suggesting the UPRmt may contribute to a shift in ATP production from respiration to glycolysis. ATFS-1 was also required for the induction of tim-23 and tim-17 (Figs. 4G & S13C); core components of the TIM23 complex (1).", citationTitle:"Science. 2012 Aug 3;337(6094):587-90. doi: 10.1126/science.1223560. Epub 2012 Jun 14.", annotationMeshanatomy:["Mitochondria"], pmid:"22700657", citationType:"PubMed", citationRef:"22700657"}}, {start: {_id:1590}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Included in the ATFS-1 program were many genes with roles in protecting against mitochondrial dysfunction (Fig. 4C) including the mitochondrial chaperones dnj-10 (14) (Fig. 4D) and hsp-60 (Fig. S13B). Numerous components involved in reactive oxygen species detoxification required ATFS-1 for induction during stress including the transcription factor skn-1 (15) (Fig. 4E). Several glycolysis genes including gpd-2 (glyceraldehyde-3-phosphate dehydrogenase) were also induced (Fig. 4F) suggesting the UPRmt may contribute to a shift in ATP production from respiration to glycolysis. ATFS-1 was also required for the induction of tim-23 and tim-17 (Figs. 4G & S13C); core components of the TIM23 complex (1).", citationTitle:"Science. 2012 Aug 3;337(6094):587-90. doi: 10.1126/science.1223560. Epub 2012 Jun 14.", annotationMeshanatomy:["Mitochondria"], pmid:"22700657", citationType:"PubMed", citationRef:"22700657"}}, {start: {_id:335}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Included in the ATFS-1 program were many genes with roles in protecting against mitochondrial dysfunction (Fig. 4C) including the mitochondrial chaperones dnj-10 (14) (Fig. 4D) and hsp-60 (Fig. S13B). Numerous components involved in reactive oxygen species detoxification required ATFS-1 for induction during stress including the transcription factor skn-1 (15) (Fig. 4E). Several glycolysis genes including gpd-2 (glyceraldehyde-3-phosphate dehydrogenase) were also induced (Fig. 4F) suggesting the UPRmt may contribute to a shift in ATP production from respiration to glycolysis. ATFS-1 was also required for the induction of tim-23 and tim-17 (Figs. 4G & S13C); core components of the TIM23 complex (1).", citationTitle:"Science. 2012 Aug 3;337(6094):587-90. doi: 10.1126/science.1223560. Epub 2012 Jun 14.", annotationSubgraph:["Pre-translational events"], annotationMeshanatomy:["Mitochondria"], pmid:"22700657", citationType:"PubMed", citationRef:"22700657"}}, {start: {_id:1404}, end: {_id:16}, properties:{evidence:"Parkin maintains mitochondrial levels of the protective Parkinson's disease-related enzyme 17-Î² hydroxysteroid dehydrogenase type 10", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:386}, end: {_id:548}, properties:{evidence:"Knockdown of SP1 by siRNA enhanced LRRK2 neuronal toxicity.", citationTitle:"Hum Mol Genet. 2016 Feb 15;25(4):672-80. doi: 10.1093/hmg/ddv504. Epub 2016 Jan 6.", annotationSubgraph:["Synuclein subgraph"], pmid:"26744328", citationType:"PubMed", citationRef:"26744328"}}, {start: {_id:529}, end: {_id:16}, properties:{evidence:"The protective effect of urocortin involved the activation of CRF receptor type 1, resulting in the increase of cyclic AMP (cAMP) levels. Various cAMP-enhancing reagents mimicked the effect of urocortin, while inhibitors for protein kinase A (PKA) blocked the effect of urocortin, strongly implicating the involvement of cAMP-PKA pathway in the neuroprotective effect of urocortin on MPP(+)-induced cell death. As the downstream of this signal pathway, urocortin promoted phosphorylation of both glycogen synthase kinase 3β and extracellular signal-regulated kinases, which are known to promote cell survival.", citationTitle:"Mol Cells. 2010 Nov;30(5):427-33. doi: 10.1007/s10059-010-0132-x.", annotationSubgraph:["Innate immune system subgraph"], annotationSpecies:["9606"], pmid:"20821057", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"20821057"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:370}, end: {_id:890}, properties:{evidence:"a subset of achalasia and Parkinson's disease patients with dysphagia may have similar mechanisms of neuronal degeneration responsible for esophageal dysfunction.", citationTitle:"Gastroenterology. 1984 Oct;87(4):848-56.", annotationMeshdisease:["Parkinson Disease"], pmid:"6088351", citationType:"PubMed", citationRef:"6088351"}}] AS row
