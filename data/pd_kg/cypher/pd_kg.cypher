MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:271}, end: {_id:1926}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These data support a novel role for parkin in the regulation of mitochondrial homeostasis, Ca2+ signaling and energy metabolism under physiological conditions.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:271}, end: {_id:1605}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These data support a novel role for parkin in the regulation of mitochondrial homeostasis, Ca2+ signaling and energy metabolism under physiological conditions.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:2010}, end: {_id:1140}, properties:{evidence:"Overexpression of each factors, Nurr1, Pitx3, and Lmx1a robustly promoted the dopaminergic differentiation of ESC-NP cells exposed to sonic hedgehog (SHH) and fibroblast growth factor 8 (FGF8). In addition, each of these factors directly interacts with potential binding sites within the tyrosine hydroxylase (TH) gene and activated its promoter activity. Interestingly, however, overexpression of Nurr1, but not of Pitx3 or Lmx1a, generated a significant number of nonneuronal TH-positive cells. In line with this, Pitx3 and Lmx1a, but not Nurr1, induced expression of the Ngn2 gene, which is critical for neurogenesis", citationTitle:"Stem Cells Dev. 2014 Mar 1;23(5):477-87. doi: 10.1089/scd.2013.0406. Epub 2013 Dec 4.", annotationSubgraph:["Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"24172139", citationType:"PubMed", citationRef:"24172139"}}, {start: {_id:2092}, end: {_id:1140}, properties:{evidence:"Overexpression of each factors, Nurr1, Pitx3, and Lmx1a robustly promoted the dopaminergic differentiation of ESC-NP cells exposed to sonic hedgehog (SHH) and fibroblast growth factor 8 (FGF8). In addition, each of these factors directly interacts with potential binding sites within the tyrosine hydroxylase (TH) gene and activated its promoter activity. Interestingly, however, overexpression of Nurr1, but not of Pitx3 or Lmx1a, generated a significant number of nonneuronal TH-positive cells. In line with this, Pitx3 and Lmx1a, but not Nurr1, induced expression of the Ngn2 gene, which is critical for neurogenesis", citationTitle:"Stem Cells Dev. 2014 Mar 1;23(5):477-87. doi: 10.1089/scd.2013.0406. Epub 2013 Dec 4.", annotationSubgraph:["Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"24172139", citationType:"PubMed", citationRef:"24172139"}}, {start: {_id:2093}, end: {_id:1140}, properties:{evidence:"Overexpression of each factors, Nurr1, Pitx3, and Lmx1a robustly promoted the dopaminergic differentiation of ESC-NP cells exposed to sonic hedgehog (SHH) and fibroblast growth factor 8 (FGF8). In addition, each of these factors directly interacts with potential binding sites within the tyrosine hydroxylase (TH) gene and activated its promoter activity. Interestingly, however, overexpression of Nurr1, but not of Pitx3 or Lmx1a, generated a significant number of nonneuronal TH-positive cells. In line with this, Pitx3 and Lmx1a, but not Nurr1, induced expression of the Ngn2 gene, which is critical for neurogenesis", citationTitle:"Stem Cells Dev. 2014 Mar 1;23(5):477-87. doi: 10.1089/scd.2013.0406. Epub 2013 Dec 4.", annotationSubgraph:["Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"24172139", citationType:"PubMed", citationRef:"24172139"}}, {start: {_id:2265}, end: {_id:112}, properties:{evidence:"MIF has long been known to induce production and secretion of pro- inflammatory cytokines, mainly IL-1beta, TNF-alpha and IFN- gamma, as well as other inflammatory mediators such as nitric oxide", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"21550814", citationType:"PubMed", citationRef:"21550814"}}] AS row
