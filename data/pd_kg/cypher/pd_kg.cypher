UNWIND [{start: {_id:0}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD", citationTitle:"PD SNPs list from Karolinska", citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:2}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD", citationTitle:"PD SNPs list from Karolinska", citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:4}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD", citationTitle:"PD SNPs list from Karolinska", citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:6}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD", citationTitle:"PD SNPs list from Karolinska", citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:8}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD", citationTitle:"PD SNPs list from Karolinska", citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:10}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD", citationTitle:"PD SNPs list from Karolinska", citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:12}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD", citationTitle:"PD SNPs list from Karolinska", citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:14}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD", citationTitle:"PD SNPs list from Karolinska", citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:26}, end: {_id:928}, properties:{evidence:"Sequence analysis identified eight genes (IGF2R, SLC22A1, SLC22A2, SLC22A3, PLG, LPA, MAP3K4, and PARK2) as mapping within the large FRA6E region. PARK2, the gene associated with autosomal recessive juvenile parkinsonism (ARJP), accounts for more than half of the CFS. Homozygous deletions and large heterozygous deletions have been observed in PARK2 in ARJP patients.", citationTitle:"Genes Chromosomes Cancer. 2003 Sep;38(1):40-52.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"12874785", citationType:"PubMed", citationRef:"12874785"}}, {start: {_id:972}, end: {_id:16}, properties:{annotationBrco:["Spinal motor neuron"], evidence:"Haplotype results indicate that the minor allele of the rs4739217 is a risk factor for TD (permuted allelic p = 0.074). Age was also a risk factor for TD in our sample (p = 0.0001). Taken together, our findings suggest that GFRA2 genetic variants and age may play a role in TD susceptibility, but further work is required to confirm these findings", citationTitle:"Psychopharmacology (Berl). 2010 Jun;210(3):347-54. doi: 10.1007/s00213-010-1829-4. Epub 2010 Apr 6.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20369355", citationType:"PubMed", citationRef:"20369355"}}, {start: {_id:1294}, end: {_id:16}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"To identify susceptible genes for sporadic PD, we performed case- control association studies of 268 single nucleotide polymorphisms (SNPs) in 121 candidate genes.In two independent case-control populations, we found that a SNP in alpha-synuclein (SNCA), rs7684318, showed the strongest association with PD (P=5.0 x 10(-10)).", citationTitle:"Hum Mol Genet. 2006 Apr 1;15(7):1151-8. Epub 2006 Feb 24.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"16500997", citationType:"PubMed", citationRef:"16500997"}}, {start: {_id:1336}, end: {_id:16}, properties:{evidence:"We included MRI1 and TMEM9 as candidates with increased methylation and GSST1, TUBA3E and KCNH1 as genes with decreased methylation in the qPCR analysis in PD brain sample", citationTitle:"Neurosci Lett. 2014 Sep 5;579:70-4. doi: 10.1016/j.neulet.2014.07.013. Epub 2014 Jul 17.", annotationSubgraph:["miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23907097", citationType:"PubMed", citationRef:"23907097"}}, {start: {_id:1337}, end: {_id:16}, properties:{evidence:"We included MRI1 and TMEM9 as candidates with increased methylation and GSST1, TUBA3E and KCNH1 as genes with decreased methylation in the qPCR analysis in PD brain sample", citationTitle:"Neurosci Lett. 2014 Sep 5;579:70-4. doi: 10.1016/j.neulet.2014.07.013. Epub 2014 Jul 17.", annotationSubgraph:["miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23907097", citationType:"PubMed", citationRef:"23907097"}}, {start: {_id:1338}, end: {_id:16}, properties:{evidence:"We included MRI1 and TMEM9 as candidates with increased methylation and GSST1, TUBA3E and KCNH1 as genes with decreased methylation in the qPCR analysis in PD brain sample", citationTitle:"Neurosci Lett. 2014 Sep 5;579:70-4. doi: 10.1016/j.neulet.2014.07.013. Epub 2014 Jul 17.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23907097", citationType:"PubMed", citationRef:"23907097"}}, {start: {_id:1339}, end: {_id:16}, properties:{evidence:"We included MRI1 and TMEM9 as candidates with increased methylation and GSST1, TUBA3E and KCNH1 as genes with decreased methylation in the qPCR analysis in PD brain sample", citationTitle:"Neurosci Lett. 2014 Sep 5;579:70-4. doi: 10.1016/j.neulet.2014.07.013. Epub 2014 Jul 17.", annotationSubgraph:["Transport related subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23907097", citationType:"PubMed", citationRef:"23907097"}}, {start: {_id:1340}, end: {_id:16}, properties:{evidence:"We included MRI1 and TMEM9 as candidates with increased methylation and GSST1, TUBA3E and KCNH1 as genes with decreased methylation in the qPCR analysis in PD brain sample", citationTitle:"Neurosci Lett. 2014 Sep 5;579:70-4. doi: 10.1016/j.neulet.2014.07.013. Epub 2014 Jul 17.", annotationSubgraph:["Energy metabolic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23907097", citationType:"PubMed", citationRef:"23907097"}}] AS row
