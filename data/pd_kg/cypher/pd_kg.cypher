UNWIND [{start: {_id:78}, end: {_id:70}, properties:{evidence:"Grb10-Interacting GYF Protein 2 (GIGYF2) was initially identified through its interaction with Grb10, an adapter protein that binds activated IGF-I and insulin receptors. The GIGYF2 gene maps to human chromosome 2q37 within a region linked to familial Parkinson's disease (PARK11 locus), and association of GIGYF2 mutations with Parkinson's disease has been described in some but not other recent publications.", citationTitle:"Hum Mol Genet. 2009 Dec 1;18(23):4629-39. doi: 10.1093/hmg/ddp430. Epub 2009 Sep 10.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"19744960", citationType:"PubMed", citationRef:"19744960"}}, {start: {_id:78}, end: {_id:80}, properties:{evidence:"Grb10-Interacting GYF Protein 2 (GIGYF2) was initially identified through its interaction with Grb10, an adapter protein that binds activated IGF-I and insulin receptors. The GIGYF2 gene maps to human chromosome 2q37 within a region linked to familial Parkinson's disease (PARK11 locus), and association of GIGYF2 mutations with Parkinson's disease has been described in some but not other recent publications.", citationTitle:"Hum Mol Genet. 2009 Dec 1;18(23):4629-39. doi: 10.1093/hmg/ddp430. Epub 2009 Sep 10.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"19744960", citationType:"PubMed", citationRef:"19744960"}}, {start: {_id:984}, end: {_id:981}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:987}, end: {_id:981}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:990}, end: {_id:981}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:993}, end: {_id:981}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:1073}, end: {_id:1075}, properties:{evidence:"This association dramatically increases the enzymatic activity of the complexed Mtmr2 towards phosphatidylinositol 3-phosphate and phosphatidylinositol 3,5-bisphosphate.", citationComment:"Multi-level regulation of myotubularin-related protein-2 phosphatase activity by myotubularin-related protein-13/set-binding factor-2.", citationTitle:"Human molecular genetics; Vol. 15; Iss. 4", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], annotationMeshdisease:["Charcot-Marie-Tooth Disease"], citationPubDate:"2006-02-15", pmid:"16399794", citationAuthorList:"Philipp Berger|Imre Berger|Christiane Schaffitzel|Kristian Tersar|Benjamin Volkmer|Ueli Suter", citationType:"PubMed", citationRef:"16399794"}}, {start: {_id:1843}, end: {_id:1844}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 Functionally Interacts with Pum and the TOM/TIM Complex to Regulate the Localization and Translation of nRCC mRNAs", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:2157}, end: {_id:2144}, properties:{evidence:"For example, TREM-2 associates with plexin A receptors and TREM-2-DAP12 signaling is activated by the plexin A1 ligand Semaphorin 6D.", annotationConfidence:["Medium"], pmid:"19295630", citationType:"PubMed", citationRef:"19295630"}}, {start: {_id:2231}, end: {_id:2232}, properties:{evidence:"We postulate that during regulated insulin secretion, released insulin binds the beta-cell insulin receptor and activates IRS-1, thus further increasing cytosolic Ca2+ by reducing Ca2+ uptake.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"10364259", citationType:"PubMed", citationRef:"10364259"}}] AS row
