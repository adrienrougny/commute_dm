UNWIND [{start: {_id:16}, end: {_id:407}, properties:{evidence:"Alteration of the cerebral microvascular endothelium, breakdown of the blood-brain barrier (BBB) and increased leukocyte transmigration have been involved in the pathogenesis of PD and other neurodegenerative diseases .", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationMeshdisease:["Parkinson Disease"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:719}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, a prevalent view regarding the pathogenesis of some types of PD (Figure 1) is that PINK1 acts upstream of Parkin in a common pathway that appears to regulate mitochondrial quality and morphology and that dysregulation of the PINK1/Parkin pathway may result in a failure to remove damaged mitochondria, leading to enhanced oxidative stress conditions.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["fibroblast"], annotationMeshanatomy:["Neurons"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:16}, end: {_id:270}, properties:{evidence:"Parkinson disease (PD; Parkinson's) is the second most common neurodegenerative disease, characterized by the progressive loss of dopamine neurons and the accumulation of Lewy bodies. Increasing evidence suggests that deficits in mitochondrial function, oxidative and nitrosative stress, the accumulation of aberrant or misfolded proteins, and ubiquitin-proteasome system (UPS) dysfunction may represent the principal molecular pathways that commonly underlie the pathogenesis.", citationTitle:"Hum Mutat. 2007 Jul;28(7):641-53.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17385668", citationType:"PubMed", citationRef:"17385668"}}, {start: {_id:16}, end: {_id:750}, properties:{evidence:"Parkinson disease (PD; Parkinson's) is the second most common neurodegenerative disease, characterized by the progressive loss of dopamine neurons and the accumulation of Lewy bodies. Increasing evidence suggests that deficits in mitochondrial function, oxidative and nitrosative stress, the accumulation of aberrant or misfolded proteins, and ubiquitin-proteasome system (UPS) dysfunction may represent the principal molecular pathways that commonly underlie the pathogenesis.", citationTitle:"Hum Mutat. 2007 Jul;28(7):641-53.", annotationSubgraph:["Nitric oxide subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17385668", citationType:"PubMed", citationRef:"17385668"}}, {start: {_id:16}, end: {_id:772}, properties:{evidence:"Several studies have indicated that stress and/or cortisol, glucocorticoid in humans, are associated with PD.", citationTitle:"BMB Rep. 2013 Sep;46(9):454-9.", annotationMeshdisease:["Parkinson Disease"], pmid:"24064060", citationType:"PubMed", citationRef:"24064060"}}, {start: {_id:16}, end: {_id:489}, properties:{evidence:"PD is a common progressive neurodegenerative movement disorder characterized by postural instability, rigidity, tremor and bradykinesia", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:719}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We also present evidence that mitochondrial damage can induce ER stress, leading to the activation of the UPR, and thereby to an upregulation of parkin expression.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}] AS row
