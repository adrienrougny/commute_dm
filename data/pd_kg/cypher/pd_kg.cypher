UNWIND [{start: {_id:137}, end: {_id:16}, properties:{evidence:"This work, although controversial (Burke et al. 2008), suggests that deposition of Å’Â±-synuclein in the form of Lewy bodies and Lewy neurites develops in the PD brain in six sequential stages. Å’Â±-Synuclein pathology begins in the dorsal motor nucleus of the vagus and glossopharyngeal nerves and the anterior olfactory nucleus in stage 1", citationTitle:"Environ Health Perspect. 2013 Nov-Dec;121(11-12):1245-52. doi: 10.1289/ehp.1306967. Epub 2013 Aug 7.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Olfactory Bulb", "Glossopharyngeal Nerve", "Vagus Nerve"], pmid:"23933572", citationType:"PubMed", citationRef:"23933572"}}, {start: {_id:137}, end: {_id:1179}, properties:{evidence:"Olfactory dysfunction is related to deposition of pathological proteins, Å’Â±-synuclein, hyperphosphorylated tau protein, and neurofilament protein in these areas, featured by neurofibrillary tangles, Lewy bodies and neurites inducing a complex cascade of molecular processes including oxidative damage, neuroinflammation, and cytosolic disruption of cellular processes leading to cell death. Damage to cholinergic, serotonergic, and noradrenergic systems is likely involved, since such damage is most marked in those diseases with severe anosmia. Recent studies of olfactory dysfunction have focused its potential as an early biomarker for the diagnosis of neurodegenerative disorders and their disease progression.", citationTitle:"Acta Neuropathol. 2014 Apr;127(4):459-75. doi: 10.1007/s00401-014-1261-7. Epub 2014 Feb 20.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24554308", citationType:"PubMed", citationRef:"24554308"}}, {start: {_id:424}, end: {_id:1179}, properties:{evidence:"Olfactory dysfunction is related to deposition of pathological proteins, Å’Â±-synuclein, hyperphosphorylated tau protein, and neurofilament protein in these areas, featured by neurofibrillary tangles, Lewy bodies and neurites inducing a complex cascade of molecular processes including oxidative damage, neuroinflammation, and cytosolic disruption of cellular processes leading to cell death. Damage to cholinergic, serotonergic, and noradrenergic systems is likely involved, since such damage is most marked in those diseases with severe anosmia. Recent studies of olfactory dysfunction have focused its potential as an early biomarker for the diagnosis of neurodegenerative disorders and their disease progression.", citationTitle:"Acta Neuropathol. 2014 Apr;127(4):459-75. doi: 10.1007/s00401-014-1261-7. Epub 2014 Feb 20.", annotationSubgraph:["Tau protein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24554308", citationType:"PubMed", citationRef:"24554308"}}, {start: {_id:196}, end: {_id:1179}, properties:{evidence:"Olfaction is impaired in LRRK2 G2019S-mutation related PD, although less overall than other PD. Further, olfaction is impaired in a subset of LRRK2 NMC, suggesting that olfaction may be a marker for development of PD in this group, and that longitudinal studies are warranted.", citationTitle:"Neurology. 2011 Jul 26;77(4):319-24. doi: 10.1212/WNL.0b013e318227041c. Epub 2011 Jul 13.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21753159", citationType:"PubMed", citationRef:"21753159"}}, {start: {_id:781}, end: {_id:16}, properties:{evidence:"inhibition of P53 is unlikely to be the direct cause of miR-34b/c downregulation in PD, since P53 is found upregulated in autopsied PD brains", citationTitle:"Hum Mol Genet. 2011 Aug 1;20(15):3067-78. doi: 10.1093/hmg/ddr210. Epub 2011 May 10.", annotationSubgraph:["miRNA subgraph", "Cell cycle subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21558425", citationType:"PubMed", citationRef:"21558425"}}, {start: {_id:1360}, end: {_id:16}, properties:{evidence:"It has been observed that in the brains of transgenic mice affected with PD, the levels of MEF2D are raised", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"21892731", citationType:"PubMed", citationRef:"21892731"}}, {start: {_id:781}, end: {_id:16}, properties:{evidence:"The p53 protein level in the caudate nucleus was significantly higher in parkinsonian patients than in controls (P < 0.05), whereas this protein in the substantia nigra, putamen, and cerebral cortex showed no significant difference between parkinsonian and control subjects.", citationTitle:"Neurosci Lett. 2007 Feb 27;414(1):94-7. Epub 2006 Dec 29.", annotationSubgraph:["Cell cycle subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Caudate Nucleus"], pmid:"17196747", citationType:"PubMed", citationRef:"17196747"}}, {start: {_id:1380}, end: {_id:16}, properties:{evidence:"The interferon-Å’â‰¥ level was significantly higher in the nigrostriatal dopaminergic regions (substantia nigra, caudate nucleus, and putamen) in parkinsonian patients than in the controls (P < 0.05), but was not significantly different in the cerebellum or frontal cortex between the two groups.", citationTitle:"Neurosci Lett. 2007 Feb 27;414(1):94-7. Epub 2006 Dec 29.", annotationSubgraph:["Interferon signaling subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Putamen", "Substantia Nigra", "Caudate Nucleus"], pmid:"17196747", citationType:"PubMed", citationRef:"17196747"}}, {start: {_id:1142}, end: {_id:16}, properties:{evidence:"In accordance with previous immunohistochemical analysis, the NF-Å’âˆ«B level in the nigrostriatal dopaminergic regions was significantly higher in parkinsonian patients than in the controls (P < 0.05). These data suggest that the significant increase in the levels of p53 protein, interferon-Å’â‰¥, and NF-Å’âˆ«B reflect apoptosis and the inflammatory state in the parkinsonian brain and that their elevation is involved in the degeneration of the nigrostriatal dopaminergic neurons.", citationTitle:"Neurosci Lett. 2007 Feb 27;414(1):94-7. Epub 2006 Dec 29.", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Putamen", "Substantia Nigra", "Caudate Nucleus"], pmid:"17196747", citationType:"PubMed", citationRef:"17196747"}}, {start: {_id:271}, end: {_id:734}, properties:{annotationCondition:["Normal Healthy State"], evidence:"There is considerable interest in the possible direct role of some of these proteins in Parkin-dependent mitochondrial degradation, particularly for Mitofusin 1/2,13,20 VDACs,9,17 hexokinases 1/216,19 and subunits of the translo- case of the OMM (TOM).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:2251}, end: {_id:16}, properties:{evidence:"It has been suggested that polymorphisms in monoamine oxidase B (MAOB) and catechol-O-methyltransferase (COMT) might increase the risk of PD.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["Very High"], pmid:"15753616", citationType:"PubMed", citationRef:"15753616"}}, {start: {_id:2252}, end: {_id:16}, properties:{evidence:"It has been suggested that polymorphisms in monoamine oxidase B (MAOB) and catechol-O-methyltransferase (COMT) might increase the risk of PD.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["Very High"], pmid:"15753616", citationType:"PubMed", citationRef:"15753616"}}, {start: {_id:2265}, end: {_id:16}, properties:{evidence:"Parkinson’s disease is associated with increased serum levels of macrophage migration inhibitory factor.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Serum"], annotationConfidence:["Very High"], pmid:"21550814", citationType:"PubMed", citationRef:"21550814"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
