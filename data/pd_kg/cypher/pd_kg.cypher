UNWIND [{start: {_id:1141}, end: {_id:591}, properties:{evidence:"Our results show decreased release of ROS and increased level of glutathione in astrocytes obtained from GMF-KO mice when compared to astrocytes derived from Wt mice following MPP(+) treatment.", citationComment:"Glia maturation factor deficiency suppresses 1-methyl-4-phenylpyridinium-induced oxidative stress in astrocytes. [Copy from Id 381 at Mon Apr 20 15:44:56 CEST 2015]", citationTitle:"Journal of molecular neuroscience : MN; Vol. 53; Iss. 4", annotationSubgraph:["Lipid metabolism subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Astrocytes"], citationPubDate:"2014-08-01", pmid:"24430624", citationAuthorList:"Mohammad Moshahid Khan|Duraisamy Kempuraj|Smita Zaheer|Asgar Zaheer", citationType:"PubMed", citationRef:"24430624"}}, {start: {_id:1405}, end: {_id:562}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We also show that transgenic mice with increased expression of human HADH II/ABAD are significantly more resistant to MPTP than their wild- type littermates. This effect appears to be mediated by overexpression of HADH II/ABAD mitigating MPTP-induced impairment of oxidative phosphorylation and ATP production.", citationTitle:"Ann Neurol. 2004 Jul;56(1):51-60.", pmid:"15236401", citationType:"PubMed", citationRef:"15236401"}}, {start: {_id:271}, end: {_id:1412}, properties:{evidence:"we overproduced this protein in PC12 cells in an inducible manner. In this cell line, neuronally differentiated by nerve growth factor, Parkin overproduction protected against cell death mediated by ceramide", citationTitle:"Hum Mol Genet. 2003 Mar 1;12(5):517-26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"12588799", annotationCellline:["PC-12 cell"], citationType:"PubMed", citationRef:"12588799"}}, {start: {_id:271}, end: {_id:748}, properties:{annotationCondition:["Normal Healthy State"], evidence:"when a mitochondrion loses membrane potential, PINK1 import is blocked and it accumulates on the outer membrane, where it recruits PARK2 specifically to the damaged mitochondrion and activates PARK2 E3 enzyme activity to ubiquitinate mitochondrial substrates and initiate mitophagic clearance.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1750-7. doi: 10.4161/auto.26122. Epub 2013 Sep 5.", annotationSubgraph:["PINK1 subgraph"], pmid:"24149988", citationType:"PubMed", citationRef:"24149988"}}, {start: {_id:1603}, end: {_id:1381}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The mammalian brain is one of the organs with the highest energy demands, and mitochondria are key determinants of its functions. Here we show that the type-1 cannabinoid receptor (CB(1)) is present at the membranes of mouse neuronal mitochondria (mtCB(1)), where it directly controls cellular respiration and energy production. Through activation of mtCB(1) receptors, exogenous cannabinoids and in situ endocannabinoids decreased cyclic AMP concentration, protein kinase A activity, complex I enzymatic activity and respiration in neuronal mitochondria. In addition, intracellular CB(1) receptors and mitochondrial mechanisms contributed to endocannabinoid-dependent depolarization-induced suppression of inhibition in the hippocampus. Thus, mtCB(1) receptors directly modulate neuronal energy metabolism, revealing a new mechanism of action of G protein-coupled receptor signaling in the brain.", citationTitle:"Nat Neurosci. 2012 Mar 4;15(4):558-64. doi: 10.1038/nn.3053.", annotationSubgraph:["Notch signaling subgraph"], pmid:"22388959", citationType:"PubMed", citationRef:"22388959"}}, {start: {_id:634}, end: {_id:44}, properties:{evidence:"METHODS AND FINDINGS:Purified brain mitochondria of Pink1-/- mice showed impaired Ca2+ storage capacity, resulting in increased Ca2+ induced mitochondrial permeability transition (mPT) that was rescued by cyclosporine A. A subpopulation of neurons in the substantia nigra of Pink1-/- mice accumulated phospho-c-Jun, showing that Jun N-terminal kinase (JNK) activity is increased. Pink1-/- mice 6 months and older displayed reduced DA levels associated with increased DA turnover. Moreover, Pink1-/-mice had increased levels of IL-1beta, IL-12 and IL-10 in the striatum after peripheral challenge with lipopolysaccharide (LPS), and Pink1-/- embryonic fibroblasts showed decreased basal and inflammatory cytokine-induced nuclear factor kappa/beta (NF-kB) activity. Quantitative transcriptional profiling in the striatum revealed that Pink1-/- mice differentially express genes that (i) are upregulated in animals with experimentally induced dopaminergic lesions, (ii) regulate innate immune responses and/or apoptosis and (iii) promote axonal regeneration and sprouting.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:634}, end: {_id:44}, properties:{evidence:"CONCLUSIONS:Increased mitochondrial Ca2+ sensitivity and JNK activity are early defects in Pink1-/- mice that precede reduced DA levels and abnormal DA homeostasis and may contribute to neuronal dysfunction in familial PD. Differential gene expression in the nigrostriatal system of Pink1-/- mice supports early dopaminergic dysfunction and shows that Pink1 deletion causes aberrant expression of genes that regulate innate immune responses. While some differentially expressed genes may mitigate neurodegeneration, increased LPS-induced brain cytokine expression and impaired cytokine-induced NF-kB activation may predispose neurons of Pink1-/- mice to inflammation and injury-induced cell death.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:1679}, end: {_id:748}, properties:{evidence:"In yeast, similar mutations in the orthologous AAC2 (also known as PET9) gene cause protein misfolding, followed by severe mitochondrial damage and ageing-dependent degenerative cell death", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationSubgraph:["Mitochondrial subgraph"], annotationSpecies:["4932"], annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1404}, end: {_id:1775}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 overproduction promoted mitochondrial elongation and mitigated CCCP-induced mitochondrial degradation independently of enzymatic activity.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1828}, end: {_id:748}, properties:{annotationCondition:["Normal Healthy State"], evidence:"By contrast, the D86G variant (residual activity of 30%) behaved like the normal protein", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:633}, end: {_id:562}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We demonstrate that knockout mice lacking Drd2 showed remarkable inflammatory response in multiple central nervous system regions and increased the vulnerability of nigral dopaminergic neurons to neurotoxin 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP)-induced neurotoxicity.", citationTitle:"Nature. 2013 Feb 7;494(7435):90-4. doi: 10.1038/nature11748. Epub 2012 Dec 16.", pmid:"23242137", citationType:"PubMed", citationRef:"23242137"}}, {start: {_id:203}, end: {_id:2053}, properties:{evidence:"Moreover, LRRK2 inhibition promotes lysosomal perinuclear clustering, through Rab7 that further hinders autophagosomes degradation.", citationTitle:"Mol Neurobiol. 2015 Dec;52(3):1804-20. doi: 10.1007/s12035-014-8980-6. Epub 2014 Nov 15.", annotationSubgraph:["LRRK2 subgraph"], pmid:"25394383", citationType:"PubMed", citationRef:"25394383"}}, {start: {_id:138}, end: {_id:44}, properties:{evidence:"The MAO-A subtype which selectively degrades 5-HT and MAO-B which degrades dopamine have been localized to 5-HT neurons.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"20554102", citationType:"PubMed", citationRef:"20554102"}}, {start: {_id:138}, end: {_id:44}, properties:{evidence:"This property of selegiline, together with observation that the basal ganglia of human brain possessed predominantly MAO-B that could metabolize dopamine led us to initiate a pilot study with selegiline in Parkinson 's disease.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["Very High"], pmid:"23585716", citationType:"PubMed", citationRef:"23585716"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1435}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in PTEN-induced putative kinase 1 (PINK1) or parkin cause autosomal recessive forms of Parkinson's disease.Recent work suggests that loss of mitochondrial membrane potential stabilizes PINK1 and that accumulated PINK1 recruits parkin from the cytoplasm to mitochondria for elimination of depolarized mitochondria, which is known as mitophagy.In this study, we find that PINK1 forms a complex with sterile ÃŽÂ± and TIR motif containing 1 (SARM1) and tumor necrosis factor receptor-associated factor 6 (TRAF6), which is important for import of PINK1 in the outer membrane and stabilization of PINK1 on depolarized mitochondria. SARM1, which is known to be an adaptor protein for Toll-like receptor, binds to PINK1 and promotes TRAF6-mediated lysine 63 chain ubiquitination of PINK1 at lysine 433. Down-regulation of SARM1 and TRAF6 abrogates accumulation of PINK1, followed by recruitment of parkin to damaged mitochondria. Some pathogenic mutations of PINK1 reduce the complex formation and ubiquitination.These results indicate that association of PINK1 with SARM1 and TRAF6 is an important step for mitophagy.", citationTitle:"Mol Biol Cell. 2013 Sep;24(18):2772-84. doi: 10.1091/mbc.E13-01-0016. Epub 2013 Jul 24.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23885119", citationType:"PubMed", citationRef:"23885119"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:995}, end: {_id:1149}, properties:{evidence:"The AD SNP rs10838725 (pAD â€šÃ„Ã¢=â€šÃ„Ã¢1.1â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-08)) at the locus CELF1 is also genome-wide significant for obesity (pBMI â€šÃ„Ã¢=â€šÃ„Ã¢7.35â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-09) ). (2) Four additional AD risk SNPs were nominally associated with obesity (rs17125944 at FERMT2, pBMI â€šÃ„Ã¢=â€šÃ„Ã¢4.03â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-05), pBMIâ€šÃ„Ã¢corr â€šÃ„Ã¢=â€šÃ„Ã¢2.50â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-03) ; rs3851179 at PICALM; pBMI â€šÃ„Ã¢=â€šÃ„Ã¢0.002, rs2075650 at TOMM40/APOE, pBMI â€šÃ„Ã¢=â€šÃ„Ã¢0.024, rs3865444 at CD33, pBMI â€šÃ„Ã¢=â€šÃ„Ã¢0.024). (3) SNPs at two of the obesity risk loci (rs4836133 downstream of ZNF608; pAD â€šÃ„Ã¢=â€šÃ„Ã¢0.002 and at rs713586 downstream of RBJ/DNAJC27; pAD â€šÃ„Ã¢=â€šÃ„Ã¢0.018) were nominally associated with AD risk. Additionally, among the SNPs used for confirmation in both studies the AD risk allele of rs1858973, with an AD association just below genome-wide significance (pAD â€šÃ„Ã¢=â€šÃ„Ã¢7.20â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-07)), was also associated with obesity (SNP at IQCK/GPRC5B; pBMI â€šÃ„Ã¢=â€šÃ„Ã¢5.21â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-06) ; pcorr â€šÃ„Ã¢=â€šÃ„Ã¢3.24â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-04)).", citationTitle:"Am J Med Genet B Neuropsychiatr Genet. 2014 Jun;165B(4):283-93. doi: 10.1002/ajmg.b.32234. Epub 2014 May 1.", annotationSubgraph:["Pre-translational events"], annotationMeshdisease:["Parkinson Disease"], pmid:"24788522", citationType:"PubMed", citationRef:"24788522"}}, {start: {_id:1151}, end: {_id:1149}, properties:{evidence:"The AD SNP rs10838725 (pAD â€šÃ„Ã¢=â€šÃ„Ã¢1.1â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-08)) at the locus CELF1 is also genome-wide significant for obesity (pBMI â€šÃ„Ã¢=â€šÃ„Ã¢7.35â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-09) ). (2) Four additional AD risk SNPs were nominally associated with obesity (rs17125944 at FERMT2, pBMI â€šÃ„Ã¢=â€šÃ„Ã¢4.03â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-05), pBMIâ€šÃ„Ã¢corr â€šÃ„Ã¢=â€šÃ„Ã¢2.50â€šÃ„Ã¢âˆšÃ³â€šÃ„Ã¢10(-03) ; rs3851179 at PICALM; pBMI â€šÃ„Ã¢=â€šÃ„Ã¢0.002, rs20756