UNWIND [{start: {_id:16}, end: {_id:573}, properties:{evidence:"Proteasome dysfunction is reported in the substantia nigra in PD, and proteasome dysfunction itself can cause the formation of protein inclusions and eventual degeneration of neurons in the substantia nigra in rats, although with some inconsistency.", citationTitle:"Front Mol Neurosci. 2014 Jul 8;7:63. doi: 10.3389/fnmol.2014.00063. eCollection 2014.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"25071440", citationType:"PubMed", citationRef:"25071440"}}, {start: {_id:16}, end: {_id:753}, properties:{evidence:"In Parkinson's disease local dysregulation of iron metabolism in the substantia nigra (SN) seems to be related to neurodegeneration with an increase in SN iron concentration, accompanied by decreased SN Cu and ceruloplasmin concentrations and increased free Cu concentrations and decreased ferroxidase activity in the cerebrospinal fluid.", citationTitle:"J Trace Elem Med Biol. 2014 Jun 2. pii: S0946-672X(14)00073-X. doi: 10.1016/j.jtemb.2014.05.007.", annotationSubgraph:["Transport related subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"24954801", citationType:"PubMed", citationRef:"24954801"}}] AS row
