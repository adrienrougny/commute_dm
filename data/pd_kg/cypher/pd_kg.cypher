UNWIND [{start: {_id:357}, end: {_id:398}, properties:{annotationCondition:["Normal Healthy State"], evidence:"ROCK inhibition protects against dopaminergic cell death induced by dopaminergic neurotoxins.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["RhoA subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:269}, end: {_id:1676}, properties:{evidence:"Here we identify a new pathway of mitochondria-mediated cell death in yeast. This pathway was named mitochondrial precursor over- accumulation stress (mPOS), and is characterized by aberrant accumulation of mitochondrial precursors in the cytosol. mPOS can be triggered by clinically relevant mitochondrial damage that is not limited to the core machineries of protein import. In response to mPOS, several ribosome-associated proteins were upregulated, including Gis2 and Nog2, which promote cap-independent translation and inhibit the nuclear export of the 60S ribosomal subunit, respectively6, 7. Gis2 and Nog2 upregulation promotes cell survival, which may be part of a feedback loop that attenuates mPOS. Our data indicate that mitochondrial dysfunction contributes directly to cytosolic proteostatic stress, and provide an explanation for the association between these two hallmarks of degenerative diseases and ageing.", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1426}, end: {_id:1686}, properties:{evidence:"Only knockdown of HUWE1 rescued the mitochondrial fragmentation (Fig. 3f and Extended Data Fig. 4aâ€“c) and MFN2 hyper-ubiquitination (Fig. 3e, lane 3 versus 4) caused by C18:0 removal, as well as lethality of Elovl6 mutant flies (CG8184 in Drosophila; Extended Data Fig. 4d), identifying HUWE1 as the C18:0-responsive ubiquitin ligase. As expected19, increased MFN2 ubiquitination caused MFN2 protein destabilization (Extended Data Fig. 3h).C18:0 removal did not dramatically drop MFN2 steady-state levels, partly due to compensatory increases in MFN2 expression (Extended Data Fig. 3i), suggesting that ubiquitination additionally blocks MFN2 function in a degradation- independent manner, as for other HUWE1 targets20.", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Mitochondria fusion subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:1426}, end: {_id:1686}, properties:{evidence:"We identify C18:0 as a regulator of mitochondrial function. Upon loss of C18:0, TFR1 de-stearoylation activates JNK, leading to HUWE1-dependent MFN2 ubiquitination, impaired MFN2 activity19, and mitochondrial fragmentation.", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:842}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin then ubiquitinates proteins in the outer mitochondrial membrane (13â€“17), leading to autophagic degradation of the dysfunctional mitochondrion.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:551}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Because Atg5/Atg7-dependent autophagy acts downstream from Parkin (10, 28) and also mediates nonselective forms of mitochondrial degradation (29), we hypoth- esized that Atg7 null mutants would have a deficit in mitochondrial protein turnover similar to, but more severe than, the deficit in parkin null mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Autophagy signaling subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1760}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, the parkinâ€“Atg7 correlation did not simply reflect general mito- chondrial dysfunction; the effect of mutation in another mito- chondrial quality control gene, superoxide dismutase 2 (SOD2), did not correlate with the effect of mutation in either parkin or Atg7", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph", "Autophagy signaling subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1810}, end: {_id:749}, properties:{evidence:"CCCP-induced mitochondrial aggregation is dependent on active transport along the microtubule network toward the perinuclear region, facilitating mitochondrial degradation by autophagy.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationMeshdisease:["Parkinson Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:400}, end: {_id:1982}, properties:{evidence:"Previous studies suggested that NLRP3 inflammasome activity is negatively regulated by autophagy and positively regulated by reactive oxygen species (ROS) derived from an uncharacterized organelle. Here we show that mitophagy/autophagy blockade leads to the accumulation of damaged, ROS-generating mitochondria, and this in turn activates the NLRP3 inflammasome.", citationTitle:"Nature. 2011 Jan 13;469(7329):221-5. doi:10.1038/nature09663. Epub 2010 Dec 1. Erratum in: Nature. 2011 Jul 7;475(7354):122.", annotationSubgraph:["Caspase subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21124315", citationType:"PubMed", citationRef:"21124315"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:17}, end: {_id:18}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Characterization of FRA6E(6q26), the third most frequently observed common fragile site (CFS) in the human population, determined that aphidicolin-induced instability at FRA6E extends over a very large region (3.6 Mb)", citationTitle:"Genes Chromosomes Cancer. 2003 Sep;38(1):40-52.", pmid:"12874785", citationType:"PubMed", citationRef:"12874785"}}, {start: {_id:1233}, end: {_id:1234}, properties:{evidence:"By contrast, Dias and Resslers work with acetophenone takes advantage of specific biology: the chemical binds to a particular receptor in the nose that is encoded by a single gene, dubbed Olfr151. Somehow, the information about the frightening smell gets into a mouse's testes and results in lower methylation of the Olfr151 gene in sperm DNA.", citationTitle:"nature:News feature", annotationSubgraph:["G-protein-mediated signaling"], annotationSpecies:["10116"], annotationMeshdisease:["Parkinson Disease"], citationType:"Online Resource", citationRef:"7490"}}, {start: {_id:44}, end: {_id:1232}, properties:{evidence:"Dopamine alters SNCA CpG island methylation and enhances alpha- synuclein expression", citationTitle:"PLoS One. 2010 Nov 24;5(11):e15522. doi: 10.1371/journal.pone.0015522.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], pmid:"21124796", citationType:"PubMed", citationRef:"21124796"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1249}, end: {_id:528}, properties:{evidence:"miR-30a may also target fibroblast growth factor (FGF20), which is targeted by miR-16-2*. In this study, both miR-30a and miR-16-2* showed the highest expression in PD subjects after levodopa treatment.", citationTitle:"J Biotechnol. 2011 Mar 20;152(3):96-101. doi: 10.1016/j.jbiotec.2011.01.023. Epub 2011 Feb 3.", annotationSubgraph:["Neurotrophic subgraph", "miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["blood cell"], pmid:"21295623", citationType:"PubMed", citationRef:"21295623"}}, {start: {_id:1249}, end: {_id:526}, properties:{evidence:"miR-30a may also target fibroblast growth factor (FGF20), which is targeted by miR-16-2*. In this study, both miR-30a and miR-16-2* showed the highest expression in PD subjects after levodopa treatment.", citationTitle:"J Biotechnol. 2011 Mar 20;152(3):96-101. doi: 10.1016/j.jbiotec.2011.01.023. Epub 2011 Feb 3.", annotationSubgraph:["Neurotrophic subgraph", "miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["blood cell"], pmid:"21295623", citationType:"PubMed", citationRef:"21295623"}}, {start: {_id:1249}, end: {_id:1271}, properties:{evidence:"Like miR-16-2*, our data demonstrated that PD subjects after levodopa treatment have higher miR-26a2* expression . miR-26a2* has a tyrosinase precursor gene as one of its potential targets. Another potential target of miR-26a2* is the glutamate receptor 1 precursor (GRIA1),as with miR-30a.", citationTitle:"J Biotechnol. 2011 Mar 20;152(3):96-101. doi: 10.1016/j.jbiotec.2011.01.023. Epub 2011 Feb 3.", annotationSubgraph:["Neurotrophic subgraph", "miRNA subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["blood cell"], pmid:"21295623", citationType:"PubMed", citationRef:"21295623"}}] AS row
