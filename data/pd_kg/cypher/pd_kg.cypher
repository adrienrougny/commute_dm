:begin
UNWIND [{start: {_id:494}, end: {_id:379}, properties:{evidence:"We found that methylation of human SNCA intron 1 decreased gene expression, while inhibition of DNA methylation activated SNCA expression.", citationTitle:"J Neurosci. 2010 May 5;30(18):6355-9. doi: 10.1523/JNEUROSCI.6119-09.2010", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"20445061", annotationTranscriptionallyActiveRegion:["intron 1"], citationType:"PubMed", citationRef:"20445061"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:2162}, end: {_id:2179}, properties:{evidence:"No changes were observed in dehydroepiandrosterone and its sulfate", pmid:"15857167", citationType:"PubMed", citationRef:"15857167"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:1895}, end: {_id:1894}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The reduction of CHCHD4 protein in AIF-depleted cells was not accompanied by any change in the levels of CHCHD4 mRNA", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:16}, end: {_id:400}, properties:{evidence:"Third, apoptotic processes play a major role in dopaminergic cell death . Finally, disruption of autophagy in dopaminergic neurons is also associated with progression of the pathology of PD, and ROCK activation is involved in the autophagic process .", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Apoptosis signaling subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:16}, end: {_id:405}, properties:{evidence:"Alteration of the cerebral microvascular endothelium, breakdown of the blood-brain barrier (BBB) and increased leukocyte transmigration have been involved in the pathogenesis of PD and other neurodegenerative diseases .", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationMeshdisease:["Parkinson Disease"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:16}, end: {_id:406}, properties:{evidence:"Alteration of the cerebral microvascular endothelium, breakdown of the blood-brain barrier (BBB) and increased leukocyte transmigration have been involved in the pathogenesis of PD and other neurodegenerative diseases .", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationMeshdisease:["Parkinson Disease"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:16}, end: {_id:522}, properties:{evidence:"miRNA dysregulation is emerging as a critical factor contributing to neurodegeneration in PD [53].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["PINK1 subgraph", "Pre-translational events"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["neuron"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25553963", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:16}, end: {_id:406}, properties:{evidence:"More recently, clinical studies have presented evidence of BBB disruption in PD patients .", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationMeshdisease:["Parkinson Disease"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:16}, end: {_id:1625}, properties:{evidence:"Here, we report that PINK1 regulates the E3 ubiquitin-protein ligase function of parkin through direct phosphorylation. We find that phosphorylation of parkin by PINK1 activates parkin E3 ligase function for catalyzing K63-linked polyubiquitination and enhances parkin- mediated ubiquitin signaling through the IkappaB kinase/nuclear factor kappaB (NF-kappaB) pathway. Furthermore, the ability of PINK1 to promote parkin phosphorylation and activate parkin-mediated ubiquitin signaling is impaired by PD-linked pathogenic PINK1 mutations. Our findings support a direct link between PINK1-mediated phosphorylation and parkin-mediated ubiquitin signaling and implicate the deregulation of the PINK1/parkin/NF-kappaB neuroprotective signaling pathway in the pathogenesis of PD.", citationTitle:"Hum Mol Genet. 2010 Jan 15;19(2):352-63. doi: 10.1093/hmg/ddp501. Epub 2009 Oct 30.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19880420", citationType:"PubMed", citationRef:"19880420"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:54}, end: {_id:55}, properties:{evidence:"Several lines of evidence have demonstrated the important role of insulin-like growth factor-1 receptor (IGF1R) signaling pathway in the neuropathogenic process of cognitive impairment, while decreased Grb10-Interacting GYF Protein 2 (GIGYF2) expression can alter IGF1R trafficking and its downstream signaling pathways.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:112}, end: {_id:328}, properties:{evidence:"First, neuroinflammation plays a major role in the progression of dopaminergic cell death; a marked microglial reaction has been observed in the nigra and striatum of brains from PD patients and PD animal models", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Apoptosis signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra", "Dopaminergic Neurons", "Corpus Striatum"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:62}, end: {_id:328}, properties:{evidence:"Third, apoptotic processes play a major role in dopaminergic cell death . Finally, disruption of autophagy in dopaminergic neurons is also associated with progression of the pathology of PD, and ROCK activation is involved in the autophagic process .", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Apoptosis signaling subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:408}, end: {_id:409}, properties:{evidence:"Although low levels of VEGF may have neuroprotective effects on dopaminergic neurons , high doses of VEGF lead to poor circulation, brain edema and disruption of BBB in PD models, which may contribute to dopaminergic degeneration", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Vascular endothelial growth factor subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:494}, end: {_id:495}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, DNA methylation could recruit methyl CpG-binding domain (MBD) proteins which then recruit epigenetic-related factors, resulting in chromosome conformational changes and gene silencing, whereas unmethylated promoters are mostly linked to gene activation [17].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Pre-translational events"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:551}, end: {_id:552}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, proper autophagy regulation is essential for neuronal survival and its malfunction has been entailed in neurodegenerative diseases.", citationTitle:"Neural Regen Res. 2013 Aug 25;8(24):2275-83. doi: 10.3969/j.issn.1673-5374.2013.24.007.", annotationSubgraph:["Autophagy signaling subgraph"], annotationCell:["neuron"], pmid:"25206537", citationType:"PubMed", citationRef:"25206537"}}, {start: {_id:400}, end: {_id:553}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Observations of autophagy process in dying cells indicate that this is a form of autophagic cell death.", citationTitle:"Neural Regen Res. 2013 Aug 25;8(24):2275-83. doi: 10.3969/j.issn.1673-5374.2013.24.007.", annotationSubgraph:["Autophagy signaling subgraph"], annotationCell:["neuron"], pmid:"25206537", citationType:"PubMed", citationRef:"25206537"}}, {start: {_id:1048}, end: {_id:222}, properties:{annotationCondition:["Normal Healthy State"], evidence:"a new member of the F-box family, Pof14, which forms a canonical, F-box dependent SCF (Skp1, Cullin, F-box protein) ubiquitin ligase complex. The Pof14 protein has intrinsic instability that is abolished by inactivation of its Skp1 interaction motif (the F-box), Skp1 or the proteasome, indicating that Pof14 stability is controlled by an autocatalytic mechanism. Pof14 interacts with the squalene synthase Erg9, a key enzyme in ergosterol metabolism, in a membrane-bound complex that does not contain the core SCF components. pof14 transcription is induced by hydrogen peroxide and requires the Pap1 transcription factor and the Sty1 MAP kinase. Pof14 binds to and decreases Erg9 activity in vitro and a pof14 deletion strain quickly loses viability in the presence of hydrogen peroxide due to its inability to repress ergosterol synthesis. A pof14 mutant lacking the F-box and an skp1-3 ts mutant behave as wild type in the presence of oxidant showing that Pof14 function is independent of SCF. This indicates that modulation of ergosterol level plays a key role in adaptation to oxidative stress.", citationTitle:"EMBO J. 2006 Oct 4;25(19):4547-56. Epub 2006 Sep 14.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"17016471", citationType:"PubMed", citationRef:"17016471"}}, {start: {_id:1403}, end: {_id:400}, properties:{evidence:"Upstream of mTOR the survival PI3K/AKT pathway modulates mTOR activity that is also altered in neurodegenerative diseases of Alzheimer and Parkinson. Nevertheless, the interplay between the PI3K/AKT/mTOR pathway and the autophagic process is complex and a more detailed examination of tissue from patients suffering neurodegenerative diseases and of animal and cellular models is needed. In the present work we review the recent findings on the role of the PI3K/AKT/mTOR pathway in the modulation of the autophagic process in neuronal protection.", citationTitle:"Cell Signal. 2014 Dec;26(12):2694-701. doi: 10.1016/j.cellsig.2014.08.019. Epub 2014 Aug 28.", annotationSubgraph:["Akt/mTOR subgraph", "Autophagy signaling subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"25173700", citationType:"PubMed", citationRef:"25173700"}}, {start: {_id:311}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondria participate in apoptosis through a range of mechanisms that vary between vertebrates and invertebrates. In vertebrates, they release intermembrane space proteins, such as cytochrome c, to promote caspase activation in the cytosol. This process is the result of the loss of integrity of the outer mitochondrial membrane caused by proapoptotic members of the Bcl-2 family. This event is always accompanied by a fissioning of the organelle. Fission of mitochondria has also been reported to participate in apoptosis in Drosophila and Caenorhabditis elegans.", citationTitle:"Dev Cell. 2011 Jul 19;21(1):92-101. doi: 10.1016/j.devcel.2011.06.017.", annotationSubgraph:["Caspase subgraph"], pmid:"21763611", citationType:"PubMed", citationRef:"21763611"}}, {start: {_id:1605}, end: {_id:270}, properties:{evidence:"Experimental induction of ER-mitochondria interactions results in oxidative stress and impaired metabolic homeostasis, whereas downregulation of PACS-2 or IP3R1, proteins important for ER- mitochondria tethering or calcium transport, respectively, improves mitochondrial oxidative capacity and glucose metabolism in obese animals.", citationTitle:"Nat Med. 2014 Dec;20(12):1427-35. doi: 10.1038/nm.3735. Epub 2014 Nov 24.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25419710", citationType:"PubMed", citationRef:"25419710"}}, {start: {_id:1716}, end: {_id:1717}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondrial morphology is regulated by fusion and fission processes mediated by conserved dynamin-related GTPases:45 optic atrophy 1 (Opa1) and mitofusins (Mfn1/2), involved in fusion of the inner and outer MMs; and dynamin- related protein 1 (Drp1), which promotes mitochondrial fission.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fission subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1716}, end: {_id:323}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondrial morphology is regulated by fusion and fission processes mediated by conserved dynamin-related GTPases:45 optic atrophy 1 (Opa1) and mitofusins (Mfn1/2), involved in fusion of the inner and outer MMs; and dynamin- related protein 1 (Drp1), which promotes mitochondrial fission.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fusion subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:396}, end: {_id:1915}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Conceptually, upregulation of parkin in response to ER stress might help to preserve cellular function and survival within the adaptive phase of the UPR.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1999}, end: {_id:313}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recently, accumulating evidence has suggested that mitochondrial dynamics are an important constituent of cellular quality control and function. However, the role of mitochondrial dynamics in microglial activation is still largely unknown.", citationTitle:"J Neurochem. 2013 Oct;127(2):221-32. doi: 10.1111/jnc.12361. Epub 2013 Jul 29.", pmid:"23815397", citationType:"PubMed", citationRef:"23815397"}}, {start: {_id:1999}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recently, accumulating evidence has suggested that mitochondrial dynamics are an important constituent of cellular quality control and function. However, the role of mitochondrial dynamics in microglial activation is still largely unknown.", citationTitle:"J Neurochem. 2013 Oct;127(2):221-32. doi: 10.1111/jnc.12361. Epub 2013 Jul 29.", pmid:"23815397", citationType:"PubMed", citationRef:"23815397"}}, {start: {_id:1621}, end: {_id:1758}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Chronic neuroinflammation is a common feature of the ageing brain and some neurodegenerative disorders. However, the molecular and cellular mechanisms underlying the regulation of innate immunity in the central nervous system remain elusive. Here we show that the astrocytic dopamine D2 receptor (DRD2) modulates innate immunity through alphaB- crystallin (CRYAB), which is known to suppress neuroinflammation.", citationTitle:"Nature. 2013 Feb 7;494(7435):90-4. doi: 10.1038/nature11748. Epub 2012 Dec 16.", annotationSubgraph:["Chaperone subgraph", "Innate immune system subgraph"], pmid:"23242137", citationType:"PubMed", citationRef:"23242137"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:16}, end: {_id:271}, properties:{evidence:"Several familial forms of PD have been described and mutation in the genes SNCA, PRKN, PARK7, PINK1, LRRK2 and GBA have been associated with genetic forms of PD .", citationTitle:"Mov Disord. 2009 Apr 15;24(5):662-6. doi: 10.1002/mds.22365.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19205068", citationType:"PubMed", citationRef:"19205068"}}, {start: {_id:16}, end: {_id:662}, properties:{evidence:"Several familial forms of PD have been described and mutation in the genes SNCA, PRKN, PARK7, PINK1, LRRK2 and GBA have been associated with genetic forms of PD .", citationTitle:"Mov Disord. 2009 Apr 15;24(5):662-6. doi: 10.1002/mds.22365.", annotationSubgraph:["Disaccharide metabolism subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19205068", citationType:"PubMed", citationRef:"19205068"}}] AS row
