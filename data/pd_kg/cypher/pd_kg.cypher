UNWIND [{start: {_id:1457}, end: {_id:1458}, properties:{evidence:"The soluble Parkin mutations K211N, T240R and G430D interfere with the proper activation/translocation event of Parkin. Furthermore, these mutants fail to ubiquitylate VDAC1 and to recruit p62 to sequestered mitochondria.", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationConfidence:["High"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
