UNWIND [{start: {_id:822}, end: {_id:805}, properties:{evidence:"Our findings support the previously identified role for PARL in PINK1 cleavage, and implicate three more proteases, MPP, m-AAA and ClpXP, in the cleavage of this PD-linked protein", citationTitle:"EMBO Rep. 2012 Apr;13(4):378-85. doi: 10.1038/embor.2012.14.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22354088", citationType:"PubMed", citationRef:"22354088"}}, {start: {_id:824}, end: {_id:805}, properties:{evidence:"Our findings support the previously identified role for PARL in PINK1 cleavage, and implicate three more proteases, MPP, m-AAA and ClpXP, in the cleavage of this PD-linked protein", citationTitle:"EMBO Rep. 2012 Apr;13(4):378-85. doi: 10.1038/embor.2012.14.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22354088", citationType:"PubMed", citationRef:"22354088"}}, {start: {_id:938}, end: {_id:936}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we investigate the role of Hepatocyte growth factor-Regulated tyrosine kinase Substrate (Hrs), a regulator of RTK trafficking, in VEGF and insulin signaling. We report that ectopic expression of Hrs increases VEGF-R2 and IR number and tyrosine phosphorylation, leading to amplification of their downstream signaling. The UIM (Ubiquitin Interacting Motif) domain of Hrs is required for Hrs-induced increases in VEGF-R2, but not in IR. Furthermore, Hrs is tyrosine-phosphorylated in response to VEGF and insulin. We show that the UIM domain is required for Hrs phosphorylation in response to VEGF, but not to insulin. Importantly, Hrs co-localizes with both VEGF-R2 and IR and co-immunoprecipitates with both in a manner independent of the Hrs-UIM domain. Finally, we demonstrate that Hrs inhibits Nedd4-mediated VEGF-R2 degradation and acts additively with Grb10. We conclude that Hrs is a positive regulator of VEGF-R2 and IR signaling and that ectopic expression of Hrs protects both VEGF-R2 and IR from degradation.", citationTitle:"Exp Cell Res. 2007 May 15;313(9):1927-42. Epub 2007 Mar 21.", annotationSubgraph:["Cytokine signaling subgraph", "GRB10 subgraph", "Ubiquitin subgraph", "Notch signaling subgraph"], pmid:"17445799", citationType:"PubMed", citationRef:"17445799"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:24}, end: {_id:928}, properties:{evidence:"Sequence analysis identified eight genes (IGF2R, SLC22A1, SLC22A2, SLC22A3, PLG, LPA, MAP3K4, and PARK2) as mapping within the large FRA6E region. PARK2, the gene associated with autosomal recessive juvenile parkinsonism (ARJP), accounts for more than half of the CFS. Homozygous deletions and large heterozygous deletions have been observed in PARK2 in ARJP patients.", citationTitle:"Genes Chromosomes Cancer. 2003 Sep;38(1):40-52.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"12874785", citationType:"PubMed", citationRef:"12874785"}}, {start: {_id:171}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD versus SWEDD", citationTitle:"PD SNP list from Karolinska", annotationSubgraph:["Transcription subgraph"], annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:173}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD versus SWEDD", citationTitle:"PD SNP list from Karolinska", annotationSubgraph:["Transcription subgraph"], annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:175}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD versus SWEDD", citationTitle:"PD SNP list from Karolinska", annotationSubgraph:["Transcription subgraph"], annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:177}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD versus SWEDD", citationTitle:"PD SNP list from Karolinska", annotationSubgraph:["Transcription subgraph"], annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:179}, end: {_id:16}, properties:{evidence:"The SNP list given from Karolinska for PD versus SWEDD", citationTitle:"PD SNP list from Karolinska", anno