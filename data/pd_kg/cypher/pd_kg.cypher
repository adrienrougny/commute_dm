UNWIND [{start: {_id:2118}, end: {_id:2123}, properties:{evidence:"To study whether TREM-2 activates the IkappaBalpha and NF-kappaB pathway, we stimulated DCs through TREM-2 and analyzed the phosphorylation of IkappaBalpha by Western blot analysis.", annotationSubgraph:["Inflammatory response subgraph", "Nuclear factor Kappa beta subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2148}, properties:{evidence:"Thus, IL-10 produced by the TREM2 transduced myeloid precursor cells during engulfment of myelin debris might favor recovery from EAE.", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"17425404", citationType:"PubMed", citationRef:"17425404"}}, {start: {_id:2149}, end: {_id:2144}, properties:{evidence:"In mouse macrophages, TREM-2 is induced by IL-4 and is down-regulated by IFN-gamma or LPS XREF_BIBR.", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationSpecies:["10090"], annotationConfidence:["Very High"], pmid:"18446208", citationType:"PubMed", citationRef:"18446208"}}, {start: {_id:2118}, end: {_id:2145}, properties:{evidence:"[XREF_BIBR] The ITAM proteins Dap12 and FcRgamma are stimulated by immunoreceptors TREM-2 and OSCAR, respectively, hence proving themselves crucial in osteoclastogenesis.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"18757139", citationType:"PubMed", citationRef:"18757139"}}, {start: {_id:2118}, end: {_id:2151}, properties:{evidence:"[XREF_BIBR] The ITAM proteins Dap12 and FcRgamma are stimulated by immunoreceptors TREM-2 and OSCAR, respectively, hence proving themselves crucial in osteoclastogenesis.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"18757139", citationType:"PubMed", citationRef:"18757139"}}, {start: {_id:2118}, end: {_id:2127}, properties:{evidence:"In addition, ligation of the Ig superfamily member TREM-2 promoted partial DC maturation, specifically the upregulation of the chemokine receptor CCR7 [XREF_BIBR].", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19027044", citationType:"PubMed", citationRef:"19027044"}}, {start: {_id:2118}, end: {_id:2152}, properties:{evidence:"Ligation of TREM-2 by LOS induced interleukin-6 production in HeLa cervical carcinoma cells.", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19079182", citationType:"PubMed", citationRef:"19079182"}}, {start: {_id:470}, end: {_id:2144}, properties:{evidence:"Our results nonetheless indicate that Syk positively regulates TREM-2 function in phagocytosis by CHO cells.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19171755", citationType:"PubMed", citationRef:"19171755"}}, {start: {_id:2149}, end: {_id:2144}, properties:{evidence:"Although DAP12 mutation affects multiple receptors, siRNA knockdown demonstrated that TREM-2, which is induced on macrophages by IL-4 [XREF_BIBR], was the key receptor required for MGC development [XREF_BIBR].", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19230638", citationType:"PubMed", citationRef:"19230638"}}, {start: {_id:2118}, end: {_id:2154}, properties:{evidence:"Moreover, altered TREM-2 signaling in NTAL and LAB -/- macrophages results in cells skewed toward the type II phenotype 7 with reduced TLR induced expression of IL-12p40 and enhanced production of IL-10 (Whittaker et al., unpublished).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19230638", citationType:"PubMed", citationRef:"19230638"}}, {start: {_id:2118}, end: {_id:2159}, properties:{evidence:"Consistent with the role of TREM-2 in osteoclastogenesis (XREF_FIG) and with the dependence of NFATc1 expression on ERKs (XREF_FIG), suppression of TREM-2 expression inhibited RANKL mediated induction of NFATc1 (XREF_FIG).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19625651", citationType:"PubMed", citationRef:"19625651"}}, {start: {_id:2118}, end: {_id:2161}, properties:{evidence:"Consistent with the role of TREM-2 in osteoclastogenesis (XREF_FIG) and with the dependence of NFATc1 expression on ERKs (XREF_FIG), suppression of TREM-2 expression inhibited RANKL mediated induction of NFATc1 (XREF_FIG).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19625651", citationType:"PubMed", citationRef:"19625651"}}, {start: {_id:509}, end: {_id:70}, properties:{evidence:"These experiments indicate that TNF-alpha promotes IGF-1 receptor resistance in neurons and inhibits the ability of the IGF-I receptor to tyrosine phosphorylate the IRS-2 docking molecule and to subsequently activate the critical downstream enzyme phospha", annotationSubgraph:["Tumor necrosis factor subgraph", "Insulin signal transduction"], annotationConfidence:["High"], pmid:"10449788", citationType:"PubMed", citationRef:"10449788"}}, {start: {_id:56}, end: {_id:2204}, properties:{evidence:"Taken together, these data illustrate that IGF-1R stimulates uPA production.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"10642432", citationType:"PubMed", citationRef:"10642432"}}, {start: {_id:58}, end: {_id:89}, properties:{evidence:"Activation of the IGF1R by IGFs results in its oligomerization, autophosphorylation, and activation of the intrinsic tyrosine kinase [ xref , xref , xref , xref ].", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"11250706", citationTyp