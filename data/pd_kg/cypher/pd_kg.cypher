UNWIND [{start: {_id:396}, end: {_id:24}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The finding that, after ER stress induction, parkin gene was in- duced and mitochondrial degeneration, which normally occurred in these conditions, was prevented [27], suggested that parkin may also have a cytoprotective role independently to its mitochondria transloca- tion and consequent mitophagy activation.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:1930}, end: {_id:24}, properties:{evidence:"Glutamate excitotoxicity in neurons triggers mitochondrial and endoplasmic reticulum accumulation of Parkin, and, in the presence of N-acetyl cysteine, mitophagy", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Nerve Degeneration"], annotationMeshanatomy:["Mitochondria"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1427}, end: {_id:24}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Secondly, we have demonstrated an unexpected regulation of Parkin- associated mitochondrial quality control in neurons, discovering that mitophagy is promoted after glutamate exposure only when N- acetyl cysteine (NAC) is present.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:43}, end: {_id:46}, properties:{evidence:"Dopa decarboxylase (DDC) catalyses the synthesis of both dopamine and serotonin as well as trace amines suggested to possess neuromodulating capabilities. We have previously reported evidence suggesting an association between DDC and bipolar affective disorder (BPAD) [B√∏rglum et al., 1999].", citationTitle:"Am J Med Genet B Neuropsychiatr Genet. 2003 Feb;117B(1):18-22.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"12555230", citationType:"PubMed", citationRef:"12555230"}}, {start: {_id:43}, end: {_id:48}, properties:{evidence:"DDC is located next to the imprinted gene GRB10, which is expressed specifically from the paternal allele in fetal brains. Increased transmission of paternal DDC alleles has also been suggested in attention deficit hyperactivity disorder. We suggest that DDC might confer susceptibility to BPAD predominantly when paternally transmitted.", citationTitle:"Am J Med Genet B Neuropsychiatr Genet. 2003 Feb;117B(1):18-22.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"12555230", citationType:"PubMed", citationRef:"12555230"}}, {start: {_id:76}, end: {_id:16}, properties:{evidence:"Grb10-Interacting GYF Protein 2 (GIGYF2) was initially identified through its interaction with Grb10, an adapter protein that binds activated IGF-I and insulin receptors. The GIGYF2 gene maps to human chromosome 2q37 within a region linked to familial Parkinson's disease (PARK11 locus), and association of GIGYF2 mutations with Parkinson's disease has been described in some but not other recent publications.", citationTitle:"Hum Mol Genet. 2009 Dec 1;18(23):4629-39. doi: 10.1093/hmg/ddp430. Epub 2009 Sep 10.", annotationSubgraph:["GRB10 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19744960", citationType:"PubMed", citationRef:"19744960"}}, {start: {_id:220}, end: {_id:16}, properties:{evidence:"The deposition of alpha-synuclein (aS), a product of pathogenic gene for dominantly inherited familial Parkinson's disease (PD; park1), as fibrillary aggregates like Lewy bodies (LB), is a hallmark lesion of a set of neurodegenerative disorders termed synucleinopathies, including sporadic PD and dementia with Lewy bodies (DLB). We found that aS is the major component of LBs and further identified a specific phosphorylation of Ser129 of insoluble aS by mass spectrometric analysis. The roles of DJ-1 and PINK-1, products of pathogenic genes for autosomal recessive forms of early-onset parkinsonism, have subsequently been examined. Overexpression of DJ-1 conferred cultured cells resistance to oxidative stress, suggesting an antioxidant function of DJ-1. We also confirmed the anti-PTEN function of DJ-1 that may promote cell survival, showing decreased phosphorylation of Akt through upregulation of PTEN activity upon siRNA knockdown for DJ-1. PINK-1, that had been identified as a gene upregulated by PTEN overexpression, turned out to be a protein kinase localized in mitochondria. Collectively, information derived from studies on pathogenic genes for familial PD will open up the way toward the clarification of the pathogenesis of PD, underscoring the roles of protein aggregation, proteolysis, oxidative stress and protein phosphorylation in PD.", citationTitle:"Rinsho Shinkeigaku. 2005 Nov;45(11):899-901.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21532868", citationType:"PubMed", citationRef:"21532868"}}, {start: {_id:221}, end: {_id:16}, properties:{evidence:"The deposition of alpha-synuclein (aS), a product of pathogenic gene for dominantly inherited familial Parkinson's disease (PD; park1), as fibrillary aggregates like Lewy bodies (LB), is a hallmark lesion of a set of neurodegenerative disorders termed synucleinopathies, including sporadic PD and dementia with Lewy bodies (DLB). We found that aS is the major component of LBs and further identified a specific phosphorylation of Ser129 of insoluble aS by mass spectrometric analysis. The roles of DJ-1 and PINK-1, products of pathogenic genes for autosomal recessive forms of early-onset parkinsonism, have subsequently been examined. Overexpression of DJ-1 conferred cultured cells resistance to oxidative stress, suggesting an antioxidant function of DJ-1. We also confirmed the anti-PTEN function of DJ-1 that may promote cell survival, showing decreased phosphorylation of Akt through upregulation of PTEN activity upon siRNA knockdown for DJ-1. PINK-1, that had been identified as a gene upregulated by PTEN overexpression, turned out to be a protein kinase localized in mitochondria. Collectively, information derived from studies on pathogenic genes for familial PD will open up the way toward the clarification of the pathogenesis of PD, underscoring the roles of protein aggregation, proteolysis, oxidative stress and protein phosphorylation in PD.", citationTitle:"Rinsho Shinkeigaku. 2005 Nov;45(11):899-901.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21532868", citationType:"PubMed", citationRef:"21532868"}}, {start: {_id:221}, end: {_id:16}, properties:{evidence:"PINK1 mutants associated with recessive Parkinson's disease are defective in inhibiting mitochondrial release of cytochrome c.Mutations in PTEN-induced kinase 1 (PINK1) gene cause recessive familial type 6 of Parkinson's disease (PARK6). We investigated molecular mechanisms underlying PINK1 neuroprotective function and PARK6 mutation-induced loss of PINK1 function. Overexpression of wild- type PINK1 blocked mitochondrial release of apoptogenic cytochrome c, caspase-3 activation and apoptotic cell death induced by proteasome inhibitor MG132. N-terminal truncated PINK1 (NDelta35), which lacks mitochondrial localization sequence, did not block MG132-induced cytochrome c release and cytotoxicity. Despite mitochondrial expression, PARK6 mutant (E240K), (H271Q), (G309D), (L347P), (E417G) and C-terminal truncated (CDelta145) PINK1 failed to inhibit MG132-induced cytochrome c release and caspase-3 activation. Overexpression of wild-type PINK1 blocked cytochrome c release and cell death caused by atractyloside, which opens mitochondrial permeability transition pore (mPTP). PARK6 PINK1 mutants failed to inhibit atractyloside-induced cytochrome c release. These results suggest that PINK1 exerts anti-apoptotic effect by inhibiting the opening of mPTP and that PARK6 mutant PINK1 loses its ability to prevent mPTP opening and cytochrome c release.", citationTitle:"Neurobiol Dis. 2007 Nov;28(2):216-26. Epub 2007 Jul 17.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17707122", citationType:"PubMed", citationRef:"17707122"}}, {start: {_id:265}, end: {_id:266}, properties:{evidence:"Our results yielded significant evidence for disease association between PINK1 A340T and PD with later onset (OR 1.55, 95% CI 1.04-2.32, p=0.0393), thus suggesting that PINK1 A340T variant may contribute to the risk for late-onset PD in Chinese.Recent studies have demonstrated that mutations in PINK1 (PARK6 locus) gene, encoding PTEN-induced kinase 1, are associated with both familial recessive and sporadic early onset parkinsonism.", citationTitle:"Neurosci Lett. 2006 Dec 20;410(2):121-5. Epub 2006 Nov 7.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17084972", citationType:"PubMed", citationRef:"17084972"}}, {start: {_id:271}, end: {_id:16}, properties:{evidence:"We identified genetic variants in PARKIN, PINK1, LRRK2, and SNCA as a cause or genetic risk factors for PD in 25 percent of Korean EOPD, and mutation of PARKIN was the most common genetic cause.", citationTitle:"Neurogenetics. 2008 Oct;9(4):263-9. doi: 10.1007/s10048-008-0138-0. Epub 2008 Aug 15.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18704525", citationType:"PubMed", citationRef:"18704525"}}, {start: {_id:221}, end: {_id:16}, properties:{evidence:"We identified genetic variants in PARKIN, PINK1, LRRK2, and SNCA as a cause or genetic risk factors for PD in 25 percent of Korean EOPD, and mutation of PARKIN was the most common genetic cause.", citationTitle:"Neurogenetics. 2008 Oct;9(4):263-9. doi: 10.1007/s10048-008-0138-0. Epub 2008 Aug 15.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18704525", citationType:"PubMed", citationRef:"18704525"}}, {start: {_id:203}, end: {_id:16}, properties:{evidence:"We identified genetic variants in PARKIN, PINK1, LRRK2, and SNCA as a cause or genetic risk factors for PD in 25 percent of Korean EOPD, and mutation of PARKIN was the most common genetic cause.", citationTitle:"Neurogenetics. 2008 Oct;9(4):263-9. doi: 10.1007/s10048-008-0138-0. Epub 2008 Aug 15.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18704525", citationType:"PubMed", citationRef:"18704525"}}, {start: {_id:137}, end: {_id:16}, properties:{evidence:"We identified genetic variants in PARKIN, PINK1, LRRK2, and SNCA as a cause or genetic risk factors for PD in 25 percent of Korean EOPD, and mutation of PARKIN was the most common genetic cause.", citationTitle:"Neurogenetics. 2008 Oct;9(4):263-9. doi: 10.1007/s10048-008-0138-0. Epub 2008 Aug 15.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18704525", citationType:"PubMed", citationRef:"18704525"}}, {start: {_id:283}, end: {_id:16}, properties:{evidence:"A missense mutation of SNCA (A53T) was found in a familial PD with autosomal dominant inheritance.", citationTitle:"Neurogenetics. 2008 Oct;9(4):263-9. doi: 10.1007/s10048-008-0138-0. Epub 2008 Aug 15.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18704525", citationType:"PubMed", citationRef:"18704525"}}, {start: {_id:374}, end: {_id:16}, properties:{evidence:"Furthermore, ubiquitin carboxy terminal hydrolase L1 gene is responsible for an autosomal dominant form of typical PD, although only a single family has so far been identified with a mutation of this gene, and tau has been identified as a causative gene for frontotemporal dementia and parkinsonism.", citationTitle:"IJ Neural Transm Suppl. 2000;(60):101-16.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"11205133", citationType:"PubMed", citationRef:"11205133"}}, {start: {_id:325}, end: {_id:16}, properties:{evidence:"Three genes, alpha-synuclein, parkin, and ubiquitin C-terminal hydrolase L1 (UCH-L1), have been associated with inherited forms of Parkinson's disease (PD), although their in vivo functions have remained largely unknown.", citationTitle:"Biochem Biophys Res Commun. 2003 Dec 19;312(3):601-7.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"14680807", citationType:"PubMed", citationRef:"14680807"}}, {start: {_id:271}, end: {_id:363}, properties:{evidence:"We identified a novel gene and confirmed that mutations of this novel gene were found only in the patients with autosomal recessive Parkinson's disease. The novel gene was named parkin.", citationTitle:"Rinsho Shinkeigaku. 2004 Apr-May;44(4-5):241-62.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15287506", citationType:"PubMed", citationRef:"15287506"}}, {start: {_id:401}, end: {_id:16}, properties:{evidence:"A number of previous studies have suggested the association between GSK-3alpha and PD (Duka and others 2007; Hernandez-Baltazar and others 2013; Yu and others 2014), and GSK-3alpha inhibitors have been suggested as potential therapeutic agents for the treatment of PD.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Wnt signaling subgraph", "GSK3 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:419}, end: {_id:16}, properties:{evidence:"Another gene, microtubule associated protein tau (MAPT), has been genetically linked to a dominant form of frontotemporal dementia and parkinsonism linked to chromosome 17 (FTDP-17) and genome-wide association studies report a strong association between MAPT and sporadic PD.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Tau protein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:420}, end: {_id:16}, properties:{evidence:"ATP13A2 contribute to early onset autosomal recessive forms of Parkinsonism.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["ATP13A2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:421}, end: {_id:16}, properties:{evidence:"Other genes are linked to Parkinsonism in an autosomal dominant fashion and are responsible for early onset forms of PD (alpha- synuclein duplications or triplications, some families with mutated alpha-synuclein) as well as the more common late onset forms of Parkinsonism .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Endoplasmic reticulum-Golgi protein export"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:422}, end: {_id:16}, properties:{evidence:"Other genes are linked to Parkinsonism in an autosomal dominant fashion and are responsible for early onset forms of PD (alpha- synuclein duplications or triplications, some families with mutated alpha-synuclein) as well as the more common late onset forms of Parkinsonism .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Pre-translational events"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:419}, end: {_id:425}, properties:{annotationCondition:["Normal Healthy State"], evidence:"MAPT gene mutations cause frontotemporal dementia (FTD) with Parkinsonism.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:427}, end: {_id:16}, properties:{evidence:"Early work showed that hyperphosphorylation of tau is correlated to pathology of tauopathies and phosphorylation of alpha-syn at serine129 is correlated to synucleinopathies ; therefore much work has focused on identifying and characterizing kinases of these proteins.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:429}, end: {_id:16}, properties:{evidence:"Studies investigating the phosphorylation of alpha-syn in diseased and aged brains have shown that alpha-syn can be phosphorylated at serines (S87, S129) as well as at several tyrosines including Y125, Y133, and Y136 .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:431}, end: {_id:16}, properties:{evidence:"Studies investigating the phosphorylation of alpha-syn in diseased and aged brains have shown that alpha-syn can be phosphorylated at serines (S87, S129) as well as at several tyrosines including Y125, Y133, and Y136 .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:433}, end: {_id:16}, properties:{evidence:"Studies investigating the phosphorylation of alpha-syn in diseased and aged brains have shown that alpha-syn can be phosphorylated at serines (S87, S129) as well as at several tyrosines including Y125, Y133, and Y136 .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:435}, end: {_id:16}, properties:{evidence:"Studies investigating the phosphorylation of alpha-syn in diseased and aged brains have shown that alpha-syn can be phosphorylated at serines (S87, S129) as well as at several tyrosines including Y125, Y133, and Y136 .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:450}, end: {_id:16}, properties:{evidence:"For instance, phosphosites of the ANK-LRR interdomain region, including the S910/S935/S955/S973 sites, are sites phosphorylated by upstream kinases. These sites are detectable in basal conditions in multiple cellular and tissular systems, including for endogenous LRRK2 in Swiss 3T3 or NIH3T3 cells ) mouse primary neurons , mouse embryonic fibroblasts , mouse bone marrow derived macrophages and human peripheral blood mononuclear cells .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:452}, end: {_id:16}, properties:{evidence:"For instance, phosphosites of the ANK-LRR interdomain region, including the S910/S935/S955/S973 sites, are sites phosphorylated by upstream kinases. These sites are detectable in basal conditions in multiple cellular and tissular systems, including for endogenous LRRK2 in Swiss 3T3 or NIH3T3 cells ) mouse primary neurons , mouse embryonic fibroblasts , mouse bone marrow derived macrophages and human peripheral blood mononuclear cells .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:454}, end: {_id:16}, properties:{evidence:"For instance, phosphosites of the ANK-LRR interdomain region, including the S910/S935/S955/S973 sites, are sites phosphorylated by upstream kinases. These sites are detectable in basal conditions in multiple cellular and tissular systems, including for endogenous LRRK2 in Swiss 3T3 or NIH3T3 cells ) mouse primary neurons , mouse embryonic fibroblasts , mouse bone marrow derived macrophages and human peripheral blood mononuclear cells .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:456}, end: {_id:16}, properties:{evidence:"For instance, phosphosites of the ANK-LRR interdomain region, including the S910/S935/S955/S973 sites, are sites phosphorylated by upstream kinases. These sites are detectable in basal conditions in multiple cellular and tissular systems, including for endogenous LRRK2 in Swiss 3T3 or NIH3T3 cells ) mouse primary neurons , mouse embryonic fibroblasts , mouse bone marrow derived macrophages and human peripheral blood mononuclear cells .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:473}, end: {_id:16}, properties:{evidence:"This work revealed notable differences in phosphorylation patterns between PD and other tauopathies. For instance, S202, T205, S262, S409 are hyperphosphorylated in AD and DLB, but are unchanged in PD, while others such as T181, S184, S195, S198, S237, S400 are hyperphosphorylated in all three, AD, DLB, and PD.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Tau protein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:475}, end: {_id:16}, properties:{evidence:"This work revealed notable differences in phosphorylation patterns between PD and other tauopathies. For instance, S202, T205, S262, S409 are hyperphosphorylated in AD and DLB, but are unchanged in PD, while others such as T181, S184, S195, S198, S237, S400 are hyperphosphorylated in all three, AD, DLB, and PD.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Tau protein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:477}, end: {_id:16}, properties:{evidence:"This work revealed notable differences in phosphorylation patterns between PD and other tauopathies. For instance, S202, T205, S262, S409 are hyperphosphorylated in AD and DLB, but are unchanged in PD, while others such as T181, S184, S195, S198, S237, S400 are hyperphosphorylated in all three, AD, DLB, and PD.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Tau protein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:479}, end: {_id:16}, properties:{evidence:"This work revealed notable differences in phosphorylation patterns between PD and other tauopathies. For instance, S202, T205, S262, S409 are hyperphosphorylated in AD and DLB, but are unchanged in PD, while others such as T181, S184, S195, S198, S237, S400 are hyperphosphorylated in all three, AD, DLB, and PD.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Tau protein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:481}, end: {_id:16}, properties:{evidence:"This work revealed notable differences in phosphorylation patterns between PD and other tauopathies. For instance, S202, T205, S262, S409 are hyperphosphorylated in AD and DLB, but are unchanged in PD, while others such as T181, S184, S195, S198, S237, S400 are hyperphosphorylated in all three, AD, DLB, and PD.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Tau protein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:509}, end: {_id:16}, properties:{evidence:"Tumor necrosis factor alpha (TNF-alpha), an important inflammatory factor, has been also implicated in the pathogenesis of PD.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Tumor necrosis factor subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:537}, end: {_id:16}, properties:{evidence:"From the numerous putative pathogenic variants in LRRK2 that have been identified, at least seven missense mutations√¢‚Ç¨‚ÄùR1441C, R1441G, R1441H, N1437H, Y1699C, G2019S and I2020T√¢‚Ç¨‚Äùare considered truly pathogenic since they segregate with disease in families with PD.", citationTitle:"Small GTPases. 2013 Jul-Sep;4(3):164-70. doi: 10.4161/sgtp.25130. Epub 2013 Jun 10.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24025585", citationType:"PubMed", citationRef:"24025585"}}, {start: {_id:539}, end: {_id:16}, properties:{evidence:"From the numerous putative pathogenic variants in LRRK2 that have been identified, at least seven missense mutations√¢‚Ç¨‚ÄùR1441C, R1441G, R1441H, N1437H, Y1699C, G2019S and I2020T√¢‚Ç¨‚Äùare considered truly pathogenic since they segregate with disease in families with PD.", citationTitle:"Small GTPases. 2013 Jul-Sep;4(3):164-70. doi: 10.4161/sgtp.25130. Epub 2013 Jun 10.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24025585", citationType:"PubMed", citationRef:"24025585"}}, {start: {_id:541}, end: {_id:16}, properties:{evidence:"From the numerous putative pathogenic variants in LRRK2 that have been identified, at least seven missense mutations√¢‚Ç¨‚ÄùR1441C, R1441G, R1441H, N1437H, Y1699C, G2019S and I2020T√¢‚Ç¨‚Äùare considered truly pathogenic since they segregate with disease in families with PD.", citationTitle:"Small GTPases. 2013 Jul-Sep;4(3):164-70. doi: 10.4161/sgtp.25130. Epub 2013 Jun 10.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24025585", citationType:"PubMed", citationRef:"24025585"}}, {start: {_id:543}, end: {_id:16}, properties:{evidence:"From the numerous putative pathogenic variants in LRRK2 that have been identified, at least seven missense mutations√¢‚Ç¨‚ÄùR1441C, R1441G, R1441H, N1437H, Y1699C, G2019S and I2020T√¢‚Ç¨‚Äùare considered truly pathogenic since they segregate with disease in families with PD.", citationTitle:"Small GTPases. 2013 Jul-Sep;4(3):164-70. doi: 10.4161/sgtp.25130. Epub 2013 Jun 10.", annotationSubgraph:["LRRK2 subgraph"], annotation