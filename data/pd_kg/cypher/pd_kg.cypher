UNWIND [{start: {_id:408}, end: {_id:410}, properties:{evidence:"Although low levels of VEGF may have neuroprotective effects on dopaminergic neurons , high doses of VEGF lead to poor circulation, brain edema and disruption of BBB in PD models, which may contribute to dopaminergic degeneration", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Vascular endothelial growth factor subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:408}, end: {_id:370}, properties:{evidence:"Although low levels of VEGF may have neuroprotective effects on dopaminergic neurons , high doses of VEGF lead to poor circulation, brain edema and disruption of BBB in PD models, which may contribute to dopaminergic degeneration", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Vascular endothelial growth factor subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:489}, end: {_id:16}, properties:{evidence:"Parkinson's disease (PD) is the second most common age-related neurodegenerative disease, affecting approximately 1 percent of the population over 60 [1]. It is clinically characterized by bradykinesia, rest tremor, rigidity, gait and postural abnormalities, and a variety of other motor and non-motor symptoms [2].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:490}, end: {_id:16}, properties:{evidence:"Parkinson's disease (PD) is the second most common age-related neurodegenerative disease, affecting approximately 1 percent of the population over 60 [1]. It is clinically characterized by bradykinesia, rest tremor, rigidity, gait and postural abnormalities, and a variety of other motor and non-motor symptoms [2].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:491}, end: {_id:16}, properties:{evidence:"Parkinson's disease (PD) is the second most common age-related neurodegenerative disease, affecting approximately 1 percent of the population over 60 [1]. It is clinically characterized by bradykinesia, rest tremor, rigidity, gait and postural abnormalities, and a variety of other motor and non-motor symptoms [2].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:493}, end: {_id:16}, properties:{evidence:"Parkinson's disease (PD) is the second most common age-related neurodegenerative disease, affecting approximately 1 percent of the population over 60 [1]. It is clinically characterized by bradykinesia, rest tremor, rigidity, gait and postural abnormalities, and a variety of other motor and non-motor symptoms [2].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:400}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"There is evidence of the relationship between autophagy and LRRK2, and the deregulation could be involved, at least in part, in the aetiology of PD. I", citationTitle:"Biochem Soc Trans. 2012 Oct;40(5):1129-33.", annotationSubgraph:["LRRK2 subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22988877", citationType:"PubMed", citationRef:"22988877"}}, {start: {_id:862}, end: {_id:16}, properties:{evidence:"motor symptoms of Parkinson's disease (PD) are primarily due to the degeneration of the dopaminergic neurons in the nigrostriatal pathway", citationTitle:"Prog Brain Res. 2010;183:183-208. doi: 10.1016/S0079-6123(10)83010-9.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"20696321", citationType:"PubMed", citationRef:"20696321"}}, {start: {_id:857}, end: {_id:16}, properties:{evidence:"Our results indicate that a medium level of physical activity lowers Parkinson's disease risk.", citationTitle:"2015 Feb;138(Pt 2):269-75. doi: 10.1093/brain/awu323. Epub 2014 Nov 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"25410713", citationType:"PubMed", citationRef:"25410713"}}, {start: {_id:878}, end: {_id:16}, properties:{evidence:"Statistically significant differences in albumin ratio were found between patients with advanced disease, and both early-stage and unaffected groups. Conversely, early-phase patients did not differ from healthy subjects. Additionally, dopaminergic treatment seems to exert a possible effect on AR values.", citationTitle:"J Neuroinflammation. 2012 Aug 8;9:188. doi: 10.1186/1742-2094-9-188.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Central Nervous System"], pmid:"22870899", citationType:"PubMed", citationRef:"22870899"}}, {start: {_id:857}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Smoking, alcohol and exercise may increase or decrease risk of aging brain disorders, especially dementia and Parkinson's disease, while stress is consistently associated with increased risk and a prudent diet is consistently associated with reduced risk.", citationTitle:"Hum Reprod Update. 2011 Sep-Oct;17(5):706-17. doi: 10.1093/humupd/dmr020. Epub 2011 May 11.", pmid:"21565809", citationType:"PubMed", citationRef:"21565809"}}, {start: {_id:577}, end: {_id:1070}, properties:{evidence:"Mutations in myotubularin-related protein-2 (MTMR2) or MTMR13/set- binding factor-2 (SBF2) genes are responsible for the severe autosomal recessive hereditary neuropathies, Charcot-Marie-Tooth disease (CMT) types 4B1 and 4B2, both characterized by reduced nerve conduction velocities, focally folded myelin sheaths and demyelination.", citationComment:"Multi-level regulation of myotubularin-related protein-2 phosphatase activity by myotubularin-related protein-13/set-binding factor-2.", citationTitle:"Human molecular genetics; Vol. 15; Iss. 4", annotationMeshdisease:["Charcot-Marie-Tooth Disease"], citationPubDate:"2006-02-15", pmid:"16399794", citationAuthorList:"Philipp Berger|Imre Berger|Christiane Schaffitzel|Kristian Tersar|Benjamin Volkmer|Ueli Suter", citationType:"PubMed", citationRef:"16399794"}}, {start: {_id:1213}, end: {_id:16}, properties:{evidence:"Although few empirical data exist regarding the role of the microbiome in PD, the microbiome influences the immune system, gastrointestinal mobility, and the metabolism of nutrients and other exogenous chemicals (Grenham et al. 2011), all of which may potentially contribute to the development of PD.", citationTitle:"Environ Health Perspect. 2013 Nov-Dec;121(11-12):1245-52. doi: 10.1289/ehp.1306967. Epub 2013 Aug 7.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23933572", citationType:"PubMed", citationRef:"23933572"}}, {start: {_id:1214}, end: {_id:16}, properties:{evidence:"Although few empirical data exist regarding the role of the microbiome in PD, the microbiome influences the immune system, gastrointestinal mobility, and the metabolism of nutrients and other exogenous chemicals (Grenham et al. 2011), all of which may potentially contribute to the development of PD.", citationTitle:"Environ Health Perspect. 2013 Nov-Dec;121(11-12):1245-52. doi: 10.1289/ehp.1306967. Epub 2013 Aug 7.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23933572", citationType:"PubMed", citationRef:"23933572"}}, {start: {_id:1215}, end: {_id:16}, properties:{evidence:"Although few empirical data exist regarding the role of the microbiome in PD, the microbiome influences the immune system, gastrointestinal mobility, and the metabolism of nutrients and other exogenous chemicals (Grenham et al. 2011), all of which may potentially contribute to the development of PD.", citationTitle:"Environ Health Perspect. 2013 Nov-Dec;121(11-12):1245-52. doi: 10.1289/ehp.1306967. Epub 2013 Aug 7.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23933572", citationType:"PubMed", citationRef:"23933572"}}, {start: {_id:270}, end: {_id:16}, properties:{evidence:"miR-34b and miR-34c reduction compromises neuronal viability by mitochondrial dysfunction and reactive oxygen species production. Mitochondrial dysfunction linked to oxidative stress is a relevant feature in neurodegenerative processes, including PD.", citationTitle:"Hum Mol Genet. 2011 Aug 1;20(15):3067-78. doi: 10.1093/hmg/ddr210. Epub 2011 May 10.", annotationSubgraph:["miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21558425", citationType:"PubMed", citationRef:"21558425"}}, {start: {_id:1403}, end: {_id:16}, properties:{evidence:"Upstream of mTOR the survival PI3K/AKT pathway modulates mTOR activity that is also altered in neurodegenerative diseases of Alzheimer and Parkinson. Nevertheless, the interplay between the PI3K/AKT/mTOR pathway and the autophagic process is complex and a more detailed examination of tissue from patients suffering neurodegenerative diseases and of animal and cellular models is needed. In the present work we review the recent findings on the role of the PI3K/AKT/mTOR pathway in the modulation of the autophagic process in neuronal protection.", citationTitle:"Cell Signal. 2014 Dec;26(12):2694-701. doi: 10.1016/j.cellsig.2014.08.019. Epub 2014 Aug 28.", annotationSubgraph:["Akt/mTOR subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"25173700", citationType:"PubMed", citationRef:"25173700"}}, {start: {_id:62}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"As VDAC1 is a component of the mPTP (mitochondrial permeability transition pore), which is involved in apoptosis", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:310}, end: {_id:16}, properties:{evidence:"The PARKIN ubiquitin ligase (also known as PARK2) and its regulatory kinase PINK1 (also known as PARK6), often mutated in familial early- onset Parkinson's disease, have central roles in mitochondrial homeostasis and mitophagy.", citationTitle:"Nature. 2013 Apr 18;496(7445):372-6. doi: 10.1038/nature12043. Epub 2013 Mar 17.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23503661", citationType:"PubMed", citationRef:"23503661"}}, {start: {_id:1427}, end: {_id:16}, properties:{evidence:"defective mitophagy is linked to Parkinson's disease.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationMeshdisease:["Parkinson Disease"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1532}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"results show that suppression of USP30 can benefit dopaminergic neurons and motor behaviour in the face of mitochondrial toxicity associated with Parkinsonâ€™s diseas", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSpecies:["10116"], annotationCell:["dopaminergic neuron"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:222}, end: {_id:365}, properties:{evidence:"Loss-of-function mutations of the parkin gene, which encodes a ubiquitin-protein ligase, are a common cause of autosomal recessive juvenile parkinsonism (ARJP). Previous work has led to the identification of a number of Parkin substrates that implicate specific pathways in ARJP pathogenesis, including endoplasmic reticulum (ER) stress and cell cycle activation. To test the involvement of previously implicated pathways, as well as to identify novel pathways in ARJP pathogenesis, we are using genetic and genomic approaches to study Parkin function in the fruit fly Drosophila melanogaster. In previous work, we demonstrated that Drosophila parkin null mutants exhibit mitochondrial pathology and flight muscle degeneration. To further explore the mechanisms responsible for pathology in parkin mutants, we analyzed the transcriptional alterations that occur during muscle degeneration and performed a genetic screen for parkin modifiers. Results of these studies indicate that oxidative stress response components are induced in parkin mutants and that loss-of-function mutations in oxidative stress components enhance the parkin mutant phenotypes. Genes involved in the innate immune response are also induced in parkin mutants. In contrast, our studies did not reveal evidence for cell cycle or ER stress pathway induction in parkin mutants. These results suggest that oxidative stress and/or inflammation may play a fundamental role in the etiology of ARJP.", citationTitle:"Hum Mol Genet. 2005 Mar 15;14(6):799-811. Epub 2005 Feb 2.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15689351", citationType:"PubMed", citationRef:"15689351"}}, {start: {_id:112}, end: {_id:365}, properties:{evidence:"Loss-of-function mutations of the parkin gene, which encodes a ubiquitin-protein ligase, are a common cause of autosomal recessive juvenile parkinsonism (ARJP). Previous work has led to the identification of a number of Parkin substrates that implicate specific pathways in ARJP pathogenesis, including endoplasmic reticulum (ER) stress and cell cycle activation. To test the involvement of previously implicated pathways, as well as to identify novel pathways in ARJP pathogenesis, we are using genetic and genomic approaches to study Parkin function in the fruit fly Drosophila melanogaster. In previous work, we demonstrated that Drosophila parkin null mutants exhibit mitochondrial pathology and flight muscle degeneration. To further explore the mechanisms responsible for pathology in parkin mutants, we analyzed the transcriptional alterations that occur during muscle degeneration and performed a genetic screen for parkin modifiers. Results of these studies indicate that oxidative stress response components are induced in parkin mutants and that loss-of-function mutations in oxidative stress components enhance the parkin mutant phenotypes. Genes involved in the innate immune response are also induced in parkin mutants. In contrast, our studies did not reveal evidence for cell cycle or ER stress pathway induction in parkin mutants. These results suggest that oxidative stress and/or inflammation may play a fundamental role in the etiology of ARJP.", citationTitle:"Hum Mol Genet. 2005 Mar 15;14(6):799-811. Epub 2005 Feb 2.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15689351", citationType:"PubMed", citationRef:"15689351"}}, {start: {_id:1706}, end: {_id:16}, properties:{evidence:"The involvement of mitochondria in PD is also deduced from studies demonstrating how other nuclear genes associated with the familial forms of PD can directly or indirectly affect mitochondrial function.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1760}, end: {_id:1912}, properties:{evidence:"We discuss how this compartment may constitute a hub for the spatiotemporal organization of the activities of the PINK1â€“Parkin pathway.", citationTitle:"Biochem Soc Trans. 2015 Apr;43(2):297-301. doi: 10.1042/BST20150008.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Neurodegenerative Diseases"], pmid:"25849933", citationType:"PubMed", citationRef:"25849933"}}, {start: {_id:1717}, end: {_id:16}, properties:{evidence:"Disruption of the dynamic properties of mitochondria (fission, fusion, transport, degradation, and biogenesis) has been implicated in the pathogenesis of n eurodegenerative disorders, including Parkinson's disease (PD).", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:323}, end: {_id:16}, properties:{evidence:"Disruption of the dynamic properties of mitochondria (fission, fusion, transport, degradation, and biogenesis) has been implicated in the pathogenesis of n eurodegenerative disorders, including Parkinson's disease (PD).", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1703}, end: {_id:16}, properties:{evidence:"Disruption of the dynamic properties of mitochondria (fission, fusion, transport, degradation, and biogenesis) has been implicated in the pathogenesis of n eurodegenerative disorders, including Parkinson's disease (PD).", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:303}, end: {_id:16}, properties:{evidence:"Disruption of the dynamic properties of mitochondria (fission, fusion, transport, degradation, and biogenesis) has been implicated in the pathogenesis of n eurodegenerative disorders, including Parkinson's disease (PD).", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1879}, end: {_id:16}, properties:{evidence:"Disruption of the dynamic properties of mitochondria (fission, fusion, transport, degradation, and biogenesis) has been implicated in the pathogenesis of n eurodegenerative disorders, including Parkinson's disease (PD).", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1877}, end: {_id:358}, properties:{annotationCondition:["Normal Healthy State"], evidence:"AIF depletion by several non-overlapping siRNAs failed to affect the mitochondrial transmembrane potential (Joza et al., 2001; Figure S4C), yet caused a reduction of CHCHD4 protein expression with a delay of several days (Figures 5A, 5B, and S4D). Re-introduction of AIF expression by means of non- interferable plasmid constructs suppressed the effects of an AIF-specific siRNA on CHCHD4 expression (Figures S4A and S4B).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Mitochondrial subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:364}, end: {_id:365}, properties:{evidence:"The clinical phenotype includes early-onset (28 years) parkinsonism, foot dystonia at onset, good levodopa response, slow progression, early levodopa-induced dyskinesias, and sleep benefit, thereby resembling closely parkin-related disease.", citationTitle:"Ann Neurol. 2004 Sep;56(3):427-31.", annotationSubgraph:["Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15349871", citationType:"PubMed", citationRef:"15349871"}}, {start: {_id:370}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pathological changes in this form revealed selective degeneration of the pigmented neurons in the substantia nigra and locus coeruleus, but no Lewy bodies were found.", citationTitle:"Rinsho Shinkeigaku. 1999 Dec;39(12):1259-61.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Locus Coeruleus", "Substantia Nigra"], pmid:"10791092", citationType:"PubMed", citationRef:"10791092"}}, {start: {_id:371}, end: {_id:16}, properties:{evidence:"The contribution of genetic factors to the pathogenesis of PD is supported by the demonstration of the high concordance in twins, increased risk among relatives of PD patients in case control and family studies, and the existence of familial PD and parkinsonism based on single gene defects.", citationTitle:"IJ Neural Transm Suppl. 2000;(60):101-16.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"11205133", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"11205133"}}, {start: {_id:16}, end: {_id:373}, properties:{evidence:"In addition, five other chromosome loci have been identified to be linked to familial PD or dystonia-parkinsonism.", citationTitle:"IJ Neural Transm Suppl. 2000;(60):101-16.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"11205133", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"11205133"}}, {start: {_id:377}, end: {_id:376}, properties:{evidence:"Genomic triplication of the alpha-synuclein gene (SNCA) has been reported to cause hereditary early-onset parkinsonism with dementia.", citationTitle:"Lancet. 2004 Sep 25-Oct 1;364(9440):1167-9.", annotationMeshdisease:["Parkinson Disease"], pmid:"15451224", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"15451224"}}, {start: {_id:1026}, end: {_id:550}, properties:{evidence:"From the known regulatory mechanisms of Arc expression, HFD reduced N-methyl-D-aspartate receptor (NMDAR) activity, as seen by decreases in tyrosine phosphorylation of NMDAR2A and levels of NMDAR1. Additionally, we demonstrated that 27-hydroxycholesterol, a cholesterol metabolite that enters the brain from the blood, decreases Arc levels as well as NMDAR and Src kinase activities in rat primary hippocampal neurons. Finally, we showed that Arc levels are decreased in the cortex of AD brains. We propose that one of the mechanisms, by which hypercholesterolemia contributes to neurodegenerative diseases, could be through Arc down-regulation caused by 27-hydroxycholesterol.", citationTitle:"Brain Pathol. 2009 Jan;19(1):69-80. doi: 10.1111/j.1750-3639.2008.00174.x. Epub 2008 May 23.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["10116"], annotationMeshdisease:["Alzheimer Disease"], annotationMeshanatomy:["Hippocampus"], pmid:"18503570", citationType:"PubMed", citationRef:"18503570"}}, {start: {_id:16}, end: {_id:719}, properties:{evidence:"The etiology of PD remains unknown, although clinical and experimental evidence implicates the involvement of abnormal protein aggregation, oxidative stress and mitochondrial dysfunction", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:719}, end: {_id:16}, properties:{evidence:"The accumulation of damaged mitochondria has been proposed as a key factor in aging and the pathogenesis of many common agerelated diseases, including Parkinson disease (PD).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:719}, end: {_id:16}, properties:{evidence:"Mitochondrial dysfunction is heavily implicated in Parkinson dis- ease (PD) as exemplified by the finding of an increased frequency of respiratory chain-deficient dopamine (DA) neurons in affected patients.", citationTitle:"Proc Natl Acad Sci U S A. 2011 Aug 2;108(31):12937-42. doi: 10.1073/pnas.1103295108. Epub 2011 Jul 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"21768369", citationType:"PubMed", citationRef:"21768369"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:788}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recently, wild-type and mutant forms of LRRK2 overexpressed in cultured cells were found to interact with parkin, but not with other PD-related proteins such as Œ±-synuclein, DJ-1, or tau (Smith et al. 2005).", citationTitle:"J Neurosci Res. 2009 May 1;87(6):1283-95. doi: 10.1002/jnr.21949.", annotationSubgraph:["Ubiquitin subgraph", "LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19025767", citationType:"PubMed", citationRef:"19025767"}}, {start: {_id:847}, end: {_id:16}, properties:{evidence:"TTRAP has been linked to PD for its ability to specifically interact with L166P DJ-1.", citationTitle:"PLoS One. 2012;7(4):e35051. doi: 10.1371/journal.pone.0035051. Epub 2012 Apr 20.", annotationSubgraph:["Chaperone subgraph", "Pre-translational events"], annotationMeshdisease:["Parkinson Disease"], pmid:"22532838", citationType:"PubMed", citationRef:"22532838"}}, {start: {_id:855}, end: {_id:16}, properties:{evidence:"In the present study, based on the previous findings that Œ±Syn and UCH-L1 proteins interact physically in a cell model of PD (Zhou et al. 2004) and normal mammalian brain (Liu et al. 2002), and are deposited in Lewy bodies in sporadic cases of PD (Lowe et al. 1990; Spillantini et al. 1997; Baba et al. 1998), we performed a fluorescent double- immunolabeling analysis for the two proteins using a midbrain section of a patient with sporadic PD.", citationTitle:"J Neurochem. 2009 Feb;108(4):932-44. doi: 10.1111/j.1471-4159.2008.05827.x. Epub 2009 Jan 7.", annotationSubgraph:["Ubiquitin subgraph", "Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19141079", citationType:"PubMed", citationRef:"19141079"}}, {start: {_id:1702}, end: {_id:16}, properties:{evidence:"Interestingly, Complex I deficiency and oxidative damage are frequently observed in affected neurons of PD patients", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:514}, end: {_id:515}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The neurotoxicity of SNCA might be mediated through interaction with histone altering its acetylation. This is supported by the finding that AGK2, a potent SIRT2 inhibitor, alleviates alpha-syn mediated toxicity and prevents dopaminergic neuronal death both in vitro and in a Drosophila model of PD.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Synuclein subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:571}, end: {_id:570}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is likely that the maintenance of the BBB and the NVU will decrease the accumulation of Lewy bodies, alpha-synuclein fibrils and ROS that worsen the effects of PD", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:615}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results indicated that edaravone was able to significantly attenuate oxidative stress and improve mitochondrial function. Furthermore, edaravone was found to reduce apoptosis in Neuro2a cells through modulation of mitochondria-dependent apoptosis pathways. Interestingly, our result also demonstrated that edaravone was able to up-regulate VMAT2 expression in N2a cells in a dose-dependent manner.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 51; Iss. 2", annotationSubgraph:["Transport related subgraph"], pmid:"23657982", annotationCellline:["Neuro-2a cell"], citationType:"PubMed", citationRef:"23657982"}}, {start: {_id:615}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results indicated that edaravone was able to significantly attenuate oxidative stress and improve mitochondrial function. Furthermore, edaravone was found to reduce apoptosis in Neuro2a cells through modulation of mitochondria-dependent apoptosis pathways. Interestingly, our result also demonstrated that edaravone was able to up-regulate VMAT2 expression in N2a cells in a dose-dependent manner.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 51; Iss. 2", annotationSubgraph:["Transport related subgraph"], pmid:"23657982", annotationCellline:["Neuro-2a cell"], citationType:"PubMed", citationRef:"23657982"}}, {start: {_id:619}, end: {_id:625}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Further, Nrf2 knockdown abolishes DJ-1-mediated Trx1 induction and cytoprotection against hydrogen peroxide, indicating the critical role of Nrf2 in carrying out the protective functions of DJ-1 against oxidative stress.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Notch signaling subgraph", "Response to oxidative stress"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:883}, end: {_id:515}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results indicated that saffron pre-treatment of mice saved many dopaminergic cells of the SNc and retina from parkinsonian (MPTP) insult.", citationTitle:"J Parkinsons Dis. 2013;3(1):77-83. doi: 10.3233/JPD-130173.", annotationSpecies:["10090"], annotationMeshanatomy:["Substantia Nigra"], pmid:"23938314", citationType:"PubMed", citationRef:"23938314"}}, {start: {_id:895}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pretreatment with luteolin (3.13, 6.25, 12.5, 25 or 50 √Ç¬µM) could markedly attenuate 6-OHDA-induced PC12 cell viability loss in a concentration-dependent manner.", citationTitle:"Pharm Biol. 2013 Feb;51(2):190-6. doi: 10.3109/13880209.2012.716852. Epub 2012 Oct 5.", pmid:"23035972", annotationCellline:["PC12"], citationType:"PubMed", citationRef:"23035972"}}, {start: {_id:1325}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Histone hyperacetylation by valproate has hence been seen to increase transcription of endogenous âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±Syn and the neuroprotective agent HSP70, as well as downregulate caspase-3 and hence reduce apoptosis.", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Caspase subgraph"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:562}, end: {_id:245}, properties:{evidence:"The neurotoxin 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP) impairs mitochondrial respiration and damages dopaminergic neurons as seen in Parkinson's disease (PD). Here, we report that L-3-hydroxyacyl-CoA dehydrogenase type II/amyloid binding alcohol dehydrogenase (HADH II/ABAD), a mitochondrial oxidoreductase enzyme involved in neuronal survival, is downregulated in PD patients and in MPTP-intoxicated mice.", citationTitle:"Ann Neurol. 2004 Jul;56(1):51-60.", annotationMeshdisease:["Parkinson Disease"], pmid:"15236401", citationType:"PubMed", citationRef:"15236401"}}, {start: {_id:562}, end: {_id:1407}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We also show that transgenic mice with increased expression of human HADH II/ABAD are significantly more resistant to MPTP than their wild- type littermates. This effect appears to be mediated by overexpression of HADH II/ABAD mitigating MPTP-induced impairment of oxidative phosphorylation and ATP production.", citationTitle:"Ann Neurol. 2004 Jul;56(1):51-60.", annotationMeshdisease:["Parkinson Disease"], pmid:"15236401", citationType:"PubMed", citationRef:"15236401"}}, {start: {_id:1690}, end: {_id:1691}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Statins are cholesterol-lowering drugs that inhibit the mevalonate pathway (Extended Data Fig. 8a)16. Treating C. elegans with statins also abrogates their ability to sense mitochondrial damage and activate protective programs (Extended Data Figs 7g and 8b). A common side effect of statin therapy is muscle toxicity. By inhibiting the mevalonate pathway, statins inhibit ubiquinone synthesis, a key component of the electron transport chain (Extended Data Fig. 8a).", citationTitle:"Nature. 2014 Apr 17;508(7496):406-10. doi: 10.1038/nature13204. Epub 2014 Apr 2.", pmid:"24695221", citationType:"PubMed", citationRef:"24695221"}}, {start: {_id:1690}, end: {_id:1692}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Statins are cholesterol-lowering drugs that inhibit the mevalonate pathway (Extended Data Fig. 8a)16. Treating C. elegans with statins also abrogates their ability to sense mitochondrial damage and activate protective programs (Extended Data Figs 7g and 8b). A common side effect of statin therapy is muscle toxicity. By inhibiting the mevalonate pathway, statins inhibit ubiquinone synthesis, a key component of the electron transport chain (Extended Data Fig. 8a).", citationTitle:"Nature. 2014 Apr 17;508(7496):406-10. doi: 10.1038/nature13204. Epub 2014 Apr 2.", pmid:"24695221", citationType:"PubMed", citationRef:"24695221"}}, {start: {_id:1690}, end: {_id:1694}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Treating human embryonic kidney HEK293T cells with statin impaired the mitochondrial network and morphology (Extended Data Figs 7h and 9). Statin treatment also decreased ATP production in mouse C2C12 myotubes (Extended Data Fig. 7i).", citationTitle:"Nature. 2014 Apr 17;508(7496):406-10. doi: 10.1038/nature13204. Epub 2014 Apr 2.", pmid:"24695221", citationType:"PubMed", citationRef:"24695221"}}, {start: {_id:1690}, end: {_id:1407}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Treating human embryonic kidney HEK293T cells with statin impaired the mitochondrial network and morphology (Extended Data Figs 7h and 9). Statin treatment also decreased ATP production in mouse C2C12 myotubes (Extended Data Fig. 7i).", citationTitle:"Nature. 2014 Apr 17;508(7496):406-10. doi: 10.1038/nature13204. Epub 2014 Apr 2.", pmid:"24695221", citationType:"PubMed", citationRef:"24695221"}}, {start: {_id:44}, end: {_id:1699}, properties:{evidence:"Consistent with this hypothesis, ATP levels in pink1B9 mutant flies are reduced compared to controls (Clark et al, 2006), providing an explanation for the neuronal defects we observe in pink1 mutants.Thus, one could postulate that compensation mechanisms allow systems to cope for many years with the defect, and additional stress, caused by ageing and/or oxidative dopamine metabolism, probably leads to effective impairment of the system", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1934}, end: {_id:1930}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This suggests that the effects of NAC function downstream of the initial excitotoxic insult.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1934}, end: {_id:270}, properties:{evidence:"In contrast, when oxidative damage is prevented by NAC, the resulting mitochondrial depolarization and calcium influx may result in more wholesale degradation of mitochondrial organelles.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1957}, end: {_id:1440}, properties:{evidence:"These mtDNA mutations are somatic, with different clonally expanded deletions in individual cells, and high levels of these mutations are associated with respiratory chain deficiency.", citationTitle:"Nat Genet. 2006 May;38(5):515-7. Epub 2006 Apr 9.", annotationMeshdisease:["Parkinson Disease"], pmid:"16604074", citationType:"PubMed", citationRef:"16604074"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
