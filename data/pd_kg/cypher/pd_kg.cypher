UNWIND [{start: {_id:621}, end: {_id:683}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This correlated with increased motor neuron survival, reduced oxidative stress, and attenuated gliosis in the spinal cord, as well as a dramatic decrease in total hSYN(A53T) and phosphorylated (Ser129) hSYN(A53T) in Triton-insoluble aggregates. Furthermore, Nrf2 in astrocytes delayed chaperone-mediated autophagy and macroautophagy dysfunction observed in the hSYN(A53T) mice", citationTitle:"The Journal of neuroscience : the official journal of the Society for Neuroscience; Vol. 32; Iss. 49", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Motor Neurons"], pmid:"23223297", citationType:"PubMed", citationRef:"23223297"}}, {start: {_id:621}, end: {_id:684}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This correlated with increased motor neuron survival, reduced oxidative stress, and attenuated gliosis in the spinal cord, as well as a dramatic decrease in total hSYN(A53T) and phosphorylated (Ser129) hSYN(A53T) in Triton-insoluble aggregates. Furthermore, Nrf2 in astrocytes delayed chaperone-mediated autophagy and macroautophagy dysfunction observed in the hSYN(A53T) mice", citationTitle:"The Journal of neuroscience : the official journal of the Society for Neuroscience; Vol. 32; Iss. 49", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Motor Neurons"], pmid:"23223297", citationType:"PubMed", citationRef:"23223297"}}, {start: {_id:621}, end: {_id:692}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This impaired Nrf2 response correlated with a shift in the microglial activation profile, towards increased production of proinflammatory markers, IL-6, IL-1?? and iNOS and reduced phagocytic capacity of fluorescent beads, and lower messenger RNA levels for TAM receptors Axl and Mer.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 14", annotationSubgraph:["Interleukin signaling subgraph", "Notch signaling subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"22513881", citationType:"PubMed", citationRef:"22513881"}}, {start: {_id:621}, end: {_id:695}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This impaired Nrf2 response correlated with a shift in the microglial activation profile, towards increased production of proinflammatory markers, IL-6, IL-1?? and iNOS and reduced phagocytic capacity of fluorescent beads, and lower messenger RNA levels for TAM receptors Axl and Mer.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 14", annotationSubgraph:["Interleukin signaling subgraph", "Notch signaling subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"22513881", citationType:"PubMed", citationRef:"22513881"}}, {start: {_id:326}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Beta-synucleins can inhibit alpha-synuclein aggregation and fibril formation.", citationTitle:"Biochemical and biophysical research communications; Vol. 441; Iss. 2", annotationSubgraph:["Synuclein subgraph"], pmid:"24140056", citationType:"PubMed", citationRef:"24140056"}}, {start: {_id:137}, end: {_id:231}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In addition, Œ±-synuclein overexpression has been shown to trigger the reduction of caspase 3 activity, which, in turn, leads to lower levels of p53 immunoreactivity (Alves Da Costa et al., 2002).", citationTitle:"Brain Res. 2009 Feb 23;1256:19-33. doi: 10.1016/j.brainres.2008.12.020. Epub 2008 Dec 24.", annotationSubgraph:["Caspase subgraph", "Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19135032", citationType:"PubMed", citationRef:"19135032"}}, {start: {_id:220}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"DJ-1 can function as a redox-sensitive molecular chaperone that is capable of preventing the aggregation of Œ±-synuclein.", citationTitle:"J Neuropathol Exp Neurol. 2009 Sep;68(9):953-63. doi: 10.1097/NEN.0b013e3181b2048c.", annotationSubgraph:["Chaperone subgraph", "Synuclein subgraph"], pmid:"19680148", citationType:"PubMed", citationRef:"19680148"}}, {start: {_id:830}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutation of the F104 residue at the P‚Ä≤-position to either aspartic acid or alanine had a significant effect on the production of ŒîN- PINK1. When residue F104 was converted to an aspartic acid (F104D), we observed an accumulation of both FL- and ŒîN-PINK1 protein in cells compared with PINK1-wt (Fig. 2A, lane 4). In contrast, conversion of this residue to alanine (F104A) resulted in a decrease in FL- PINK1 protein expression combined with an accumulation of ŒîN-PINK1 (Fig. 2A, lane 5).", citationTitle:"Hum Mol Genet. 2011 Mar 1;20(5):867-79. doi: 10.1093/hmg/ddq526. Epub 2010 Dec 6.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21138942", citationType:"PubMed", citationRef:"21138942"}}, {start: {_id:220}, end: {_id:781}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These results indicate that DJ-1 inhibits the expression of p53 target genes and depend on p53 DNA-binding affinity and oxidation of DJ-1 C106.", citationTitle:"Mol Cell Biol. 2013 Jan;33(2):340-59. doi: 10.1128/MCB.01350-12. Epub 2012 Nov 12.", annotationSubgraph:["Chaperone subgraph", "Cell cycle subgraph"], pmid:"23149933", citationType:"PubMed", citationRef:"23149933"}}, {start: {_id:220}, end: {_id:839}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These results suggest that DJ-1 decreases apoptosis in cells under conditions of intermittent oxidative stress through downregulation of DUSP1 expression.", citationTitle:"Mol Cell Biol. 2013 Jan;33(2):340-59. doi: 10.1128/MCB.01350-12. Epub 2012 Nov 12.", annotationSubgraph:["MAPK subgraph", "Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23149933", citationType:"PubMed", citationRef:"23149933"}}, {start: {_id:614}, end: {_id:843}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Within the time scale of the monomer simulations (‚àº25 ns), a significant amount of Œ±-helical content is lost throughout the L166P DJ-1 structure.", citationTitle:"Biochemistry. 2008 Sep 9;47(36):9380-93. doi: 10.1021/bi800677k. Epub 2008 Aug 16.", annotationSubgraph:["Chaperone subgraph"], pmid:"18707128", citationType:"PubMed", citationRef:"18707128"}}, {start: {_id:220}, end: {_id:848}, properties:{evidence:"Consequently, a deficiency or a malfunction of DJ-1, may inherently lead to increased ROS accumulation and consequently to the early demise of dopaminergic neurons.", citationTitle:"J Gerontol A Biol Sci Med Sci. 2013 Mar;68(3):215-25. doi: 10.1093/gerona/gls147. Epub 2012 Aug 10.", annotationSubgraph:["Reactive oxygen species subgraph", "Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"22887838", citationType:"PubMed", citationRef:"22887838"}}, {start: {_id:482}, end: {_id:922}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These studies reveal a predominant role for PP2A, which is the most efficient phosphatase to dephosphorylate tau in vitro at S202, S262, and S356, but not S396 .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Unfolded protein response subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:482}, end: {_id:924}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These studies reveal a predominant role for PP2A, which is the most efficient phosphatase to dephosphorylate tau in vitro at S202, S262, and S356, but not S396 .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Unfolded protein response subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:482}, end: {_id:926}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These studies reveal a predominant role for PP2A, which is the most efficient phosphatase to dephosphorylate tau in vitro at S202, S262, and S356, but not S396 .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Unfolded protein response subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:482}, end: {_id:427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"For alpha-syn , targeting PP2A holo-enzymes is a preferred strategy , more specifically through the activation of PP2A to reduce alpha- syn-129 phosphorylation level.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Unfolded protein response subgraph", "Synuclein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:1045}, end: {_id:1046}, properties:{annotationCondition:["Normal Healthy State"], evidence:"a new member of the F-box family, Pof14, which forms a canonical, F-box dependent SCF (Skp1, Cullin, F-box protein) ubiquitin ligase complex. The Pof14 protein has intrinsic instability that is abolished by inactivation of its Skp1 interaction motif (the F-box), Skp1 or the proteasome, indicating that Pof14 stability is controlled by an autocatalytic mechanism. Pof14 interacts with the squalene synthase Erg9, a key enzyme in ergosterol metabolism, in a membrane-bound complex that does not contain the core SCF components. pof14 transcription is induced by hydrogen peroxide and requires the Pap1 transcription factor and the Sty1 MAP kinase. Pof14 binds to and decreases Erg9 activity in vitro and a pof14 deletion strain quickly loses viability in the presence of hydrogen peroxide due to its inability to repress ergosterol synthesis. A pof14 mutant lacking the F-box and an skp1-3 ts mutant behave as wild type in the presence of oxidant showing that Pof14 function is independent of SCF. This indicates that modulation of ergosterol level plays a key role in adaptation to oxidative stress.", citationTitle:"EMBO J. 2006 Oct 4;25(19):4547-56. Epub 2006 Sep 14.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"17016471", citationType:"PubMed", citationRef:"17016471"}}, {start: {_id:271}, end: {_id:574}, properties:{evidence:"Furthermore, EGFR endocytosis and degradation are accelerated in parkin-deficient cells, and EGFR signalling via the phosphoinositide 3-kinase (PI(3)K)-Akt pathway is reduced in parkin knockout mouse brain.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Ubiquitin subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:1098}, end: {_id:1099}, properties:{evidence:"This neuroprotection was accompanied by increased Akt phosphorylation (p-Akt).", citationTitle:"Proceedings of the National Academy of Sciences of the United States of America; Vol. 104; Iss. 36", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Parkinson Disease"], pmid:"17726113", citationType:"PubMed", citationRef:"17726113"}}, {start: {_id:1104}, end: {_id:1103}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In addition, PD-related insults including, mitochondrial complex I inhibition, oxidative stress, and increased alpha-synuclein expression specifically increased endogenous FAF1 expression in vitro.", citationComment:"Fas-associated factor 1 and Parkinson's disease.", citationTitle:"Neurobiology of disease; Vol. 31; Iss. 3", annotationSubgraph:["Apoptosis signaling subgraph", "Synuclein subgraph"], citationPubDate:"2008-09-01", pmid:"18573343", citationAuthorList:"Ranjita Betarbet|Leah R Anderson|Marla Gearing|Tiffany R Hodges|Jason J Fritz|James J Lah|Allan I Levey", citationType:"PubMed", citationRef:"18573343"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1103}, end: {_id:1104}, properties:{evidence:"Increased FAF1 levels induced cell death and significantly potentiated toxic effects of PD-related stressors including, oxidative stress, mitochondrial complex I inhibition and proteasome dysfunction.", citationComment:"Fas-associated factor 1 and Parkinson's disease.", citationTitle:"Neurobiology of disease; Vol. 31; Iss. 3", annotationSubgraph:["Apoptosis signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2008-09-01", pmid:"18573343", citationAuthorList:"Ranjita Betarbet|Leah R Anderson|Marla Gearing|Tiffany R Hodges|Jason J Fritz|James J Lah|Allan I Levey", citationType:"PubMed", citationRef:"18573343"}}, {start: {_id:1393}, end: {_id:1411}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Knockdown of PDE4D, but not PDE4B, amplifies isoprenaline-stimulated phosphorylation of the beta2-adrenergic receptor (beta2-AR)", citationTitle:"J Biol Chem. 2005 Sep 30;280(39):33178-89. Epub 2005 Jul 19.", annotationSubgraph:["Cyclic AMP subgraph"], annotationSpecies:["10090"], pmid:"16030021", citationType:"PubMed", citationRef:"16030021"}}, {start: {_id:271}, end: {_id:1416}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interestingly, Parkin acted by delaying mitochondrial swelling and subsequent cytochrome c release and caspase-3 activation observed in ceramide-mediated cell death", citationTitle:"Hum Mol Genet. 2003 Mar 1;12(5):517-26.", annotationSubgraph:["Ubiquitin subgraph", "Mitochondrial subgraph"], pmid:"12588799", citationType:"PubMed", citationRef:"12588799"}}, {start: {_id:271}, end: {_id:231}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interestingly, Parkin acted by delaying mitochondrial swelling and subsequent cytochrome c release and caspase-3 activation observed in ceramide-mediated cell death", citationTitle:"Hum Mol Genet. 2003 Mar 1;12(5):517-26.", annotationSubgraph:["Ubiquitin subgraph", "Caspase subgraph"], pmid:"12588799", citationType:"PubMed", citationRef:"12588799"}}, {start: {_id:1490}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The screens revealed that SIAH3, found to localize to mitochondria, inhibits PINK1 accumulation after mitochondrial insult, reducing parkin translocation.", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"22280891", citationType:"PubMed", citationRef:"22280891"}}, {start: {_id:1498}, end: {_id:1499}, properties:{evidence:"We explored the role of these regions in MOM recruitment, MFN2 ubiquitylation, substrate binding, and proteasome association using 5 mutants (Figure S6a): 1) Î”UBL, lacking the UBL domain (residues 1â€“80), 2) K27/48R, which blocks ubiquitylation of two regulated diGLY sites in the UBL (Figure 2), 3) S65A and S65E, which block PINK1-dependent phosphorylation of the UBL domain implicated in PARKIN activation in vitro,18 and 4) C431S, removing the active site Cys in RING2. The PD patient mutation PARKINC431F fails to localize to mitochondria in response to depolarization.15,20 Consistent with this, PARKINC431S failed to localize to mitochondria, efficiently poly- ubiquitylate MFN2, or interact robustly with MOM substrates in response to depolarization. In contrast, K27/K48R, S65A, and S65E mutants displayed near wild-type activity for localization, MFN2 ubiquitylation", citationTitle:"Nature. 2013 Apr 18;496(7445):372-6. doi: 10.1038/nature12043. Epub 2013 Mar 17.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"23503661", citationType:"PubMed", citationRef:"23503661"}}, {start: {_id:1501}, end: {_id:1499}, properties:{evidence:"We explored the role of these regions in MOM recruitment, MFN2 ubiquitylation, substrate binding, and proteasome association using 5 mutants (Figure S6a): 1) Î”UBL, lacking the UBL domain (residues 1â€“80), 2) K27/48R, which blocks ubiquitylation of two regulated diGLY sites in the UBL (Figure 2), 3) S65A and S65E, which block PINK1-dependent phosphorylation of the UBL domain implicated in PARKIN activation in vitro,18 and 4) C431S, removing the active site Cys in RING2. The PD patient mutation PARKINC431F fails to localize to mitochondria in response to depolarization.15,20 Consistent with this, PARKINC431S failed to localize to mitochondria, efficiently poly- ubiquitylate MFN2, or interact robustly with MOM substrates in response to depolarization. In contrast, K27/K48R, S65A, and S65E mutants displayed near wild-type activity for localization, MFN2 ubiquitylation", citationTitle:"Nature. 2013 Apr 18;496(7445):372-6. doi: 10.1038/nature12043. Epub 2013 Mar 17.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"23503661", citationType:"PubMed", citationRef:"23503661"}}, {start: {_id:1517}, end: {_id:1518}, properties:{evidence:"the presence of fluorescently labeled PARK2 or its K161N variant, but not the K211N and R256C variants, significantly decreased the mean lifetime of TOMM70A fluorescence; normal PARK2 had a stronger effect than the K161N variant.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Ubiquitin subgraph", "Matrix metalloproteinase subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}, {start: {_id:271}, end: {_id:404}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hexose kinase activity was required for parkin relocalization, suggesting the effects are shared among hexokinases including the brain-expressed hexokinase 1 (HK1). Knockdown of both HK1 and HK2 led to a stronger block in parkin relocalization than either isoform alone, and expression of HK2 in primary neurons promoted YFP-parkin recruitment to depolarized mitochondria. Mitochondrial parkin recruitment was attenuated with AKT inhibition, which is known to modulate HK2 activity and mitochondrial localization. We, therefore, propose that Akt-dependent recruitment of hexokinases is a required step in the recruitment of parkin prior to mitophagy.", citationTitle:"Hum Mol Genet. 2014 Jan 1;23(1):145-56. doi: 10.1093/hmg/ddt407. Epub 2013 Aug 19.", annotationSubgraph:["Ubiquitin subgraph", "Akt/mTOR subgraph"], pmid:"23962723", citationType:"PubMed", citationRef:"23962723"}}, {start: {_id:1539}, end: {_id:1446}, properties:{evidence:"In this study, we show that MUL1 suppresses PINK1 or parkin phenotypes in Drosophila. The suppression is achieved through the ubiquitin- dependent degradation of Mitofusin, which itself causes PINK1/parkin mutant-like toxicity when overexpressed. We further show that removing MUL1 in PINK1 or parkin loss-of-function mutant aggravates phenotypes caused by loss of either gene alone, leading to lethality in flies and degeneration in mouse cortical neurons. Together, these observations show that MUL1 acts in parallel to the PINK1/parkin pathway on a shared target mitofusin to maintain mitochondrial integrity. The MUL1 pathway compensates for loss of PINK1/parkin in both Drosophila and mammals and is a promising therapeutic target for PD", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:1539}, end: {_id:1445}, properties:{evidence:"In this study, we show that MUL1 suppresses PINK1 or parkin phenotypes in Drosophila. The suppression is achieved through the ubiquitin- dependent degradation of Mitofusin, which itself causes PINK1/parkin mutant-like toxicity when overexpressed. We further show that removing MUL1 in PINK1 or parkin loss-of-function mutant aggravates phenotypes caused by loss of either gene alone, leading to lethality in flies and degeneration in mouse cortical neurons. Together, these observations show that MUL1 acts in parallel to the PINK1/parkin pathway on a shared target mitofusin to maintain mitochondrial integrity. The MUL1 pathway compensates for loss of PINK1/parkin in both Drosophila and mammals and is a promising therapeutic target for PD", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:1587}, end: {_id:1578}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that the key point of regulation is the mitochondrial import efficiency of ATFS-1. In addition to a nuclear localization sequence, ATFS-1 has an N-terminal mitochondrial targeting sequence that is essential for UPR(mt) repression. Normally, ATFS-1 is imported into mitochondria and degraded. However, during mitochondrial stress, we found that import efficiency was reduced, allowing a percentage of ATFS-1 to accumulate in the cytosol and traffic to the nucleus. Our results show that cells monitor mitochondrial import efficiency via ATFS-1 to coordinate the level of mitochondrial dysfunction with the protective transcriptional response.", citationTitle:"Science. 2012 Aug 3;337(6094):587-90. doi: 10.1126/science.1223560. Epub 2012 Jun 14.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22700657", citationType:"PubMed", citationRef:"22700657"}}, {start: {_id:634}, end: {_id:1620}, properties:{evidence:"METHODS AND FINDINGS:Purified brain mitochondria of Pink1-/- mice showed impaired Ca2+ storage capacity, resulting in increased Ca2+ induced mitochondrial permeability transition (mPT) that was rescued by cyclosporine A. A subpopulation of neurons in the substantia nigra of Pink1-/- mice accumulated phospho-c-Jun, showing that Jun N-terminal kinase (JNK) activity is increased. Pink1-/- mice 6 months and older displayed reduced DA levels associated with increased DA turnover. Moreover, Pink1-/-mice had increased levels of IL-1beta, IL-12 and IL-10 in the striatum after peripheral challenge with lipopolysaccharide (LPS), and Pink1-/- embryonic fibroblasts showed decreased basal and inflammatory cytokine-induced nuclear factor kappa/beta (NF-kB) activity. Quantitative transcriptional profiling in the striatum revealed that Pink1-/- mice differentially express genes that (i) are upregulated in animals with experimentally induced dopaminergic lesions, (ii) regulate innate immune responses and/or apoptosis and (iii) promote axonal regeneration and sprouting.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:1640}, end: {_id:1593}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Tim17A is a stress-sensitive subunit of the TIM23 protein import complex. Tim17A protein decreases in response to stress-regulated translation attenuation. Tim17A degradation requires the activity of the mitochondrial protease YME1L. Decreased Tim17A/Tim-17 is protective against oxidative stress", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Mitochondrial subgraph", "Transport related subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1660}, end: {_id:271}, properties:{evidence:"Here, we show that ubiquitin-specific protease 15 (USP15), a deubiquitinating enzyme (DUB) widely expressed in brain and other organs, opposes Parkin-mediated mitophagy, while a panel of other DUBs and a catalytically inactive version of USP15 do not. Moreover, knockdown of USP15 rescues the mitophagy defect of PD patient fibroblasts with PARK2 mutations and decreased Parkin levels. USP15 does not affect the ubiquitination status of Parkin or Parkin translocation to mitochondria, but counteracts Parkin-mediated mitochondrial ubiquitination. Knockdown of the DUB CG8334, the closest homolog of USP15 in Drosophila, largely rescues the mitochondrial and behavioral defects of parkin RNAi flies. These data identify USP15 as an antagonist of Parkin and suggest that USP15 inhibition could be a therapeutic strategy for PD cases caused by reduced Parkin levels.", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:1660}, end: {_id:271}, properties:{evidence:"USP15 inhibits Parkin-mediated mitophagy through its DUB activity", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:1660}, end: {_id:271}, properties:{evidence:"Knockdown of USP15 enhances mitophagy. Knockdown of USP15 enhances mitophagy in HeLa cells, SH-SY5Y cells and primary human fibroblasts.", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["fibroblast"], pmid:"24852371", annotationCellline:["SH-SY5Y", "HeLa"], citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:271}, end: {_id:1759}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that parkin null mutants showed a significant overall slowing of mitochondrial protein turnover, similar to but less severe than the slowing seen in autophagy- deficient Atg7 mutants, consistent with the model that Parkin acts upstream of Atg7 to promote mitophagy.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:810}, end: {_id:1404}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These effects were abolished by overproduction of the fission- promiting dynamin-related protein 1 (Drp1).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fission subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1845}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pum RNAi rescued the abnormal mito morphology caused by PINK1 inactivation", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events", "PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1846}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pum RNAi rescued the abnormal mito morphology caused by PINK1 inactivation", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events", "PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin was previously shown to act downstream of PINK1", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1845}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, unlike PINK1-OE, Parkin OE was able to rescue Pum OE effects on nRCC mRNA translation and tissue integrity (Figures 7H and S7C), suggesting that Parkin may function downstream of Pum.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1839}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"First, Glo RNAi effectively rescued PINK1 mutant (Figures 6Eâ€“6J), whereas Glo OE had opposite effect", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1640}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Indeed, if the siRNA-mediated knockdown of AIF was accompanied by the simultaneous siRNA-mediated knockdown of YME1L, the depletion of CHCHD4 substrates such as COX17 (the copper chap- erone for complex CIV) and NDUFA8 (Szklarczyk et al., 2011)", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1640}, end: {_id:1897}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Indeed, if the siRNA-mediated knockdown of AIF was accompanied by the simultaneous siRNA-mediated knockdown of YME1L, the depletion of CHCHD4 substrates such as COX17 (the copper chap- erone for complex CIV) and NDUFA8 (Szklarczyk et al., 2011)", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1640}, end: {_id:1898}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Indeed, if the siRNA-mediated knockdown of AIF was accompanied by the simultaneous siRNA-mediated knockdown of YME1L, the depletion of CHCHD4 substrates such as COX17 (the copper chap- erone for complex CIV) and NDUFA8 (Szklarczyk et al., 2011)", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Ubiquitin subgraph", "Mitochondrial subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1580}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Intriguingly, c-Jun can bind to the same site within the parkin promoter as ATF4 to induce downregulation of parkin expression.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1580}, end: {_id:1642}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In line with this scenario, we observed that c-Jun has a dominant effect on ATF4; it can suppress ATF4-mediated upregulation of parkin expression.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Unfolded protein response subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1922}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin transcription was also repressed by JNK3, a kinase upstream of c-Jun, which has been implicated in neuronal cell death pathways in dopaminergic neurons", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1922}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Depending on the cellular context and the severity of stress conditions, parkin can shift the balance towards cell survival by attenuating JNK3 signaling, whereas JNK3 gaining the upper hand, suppresses prosurvival path ways, either directly or indirectly, for example by inhibiting the expression of parkin.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1518}, end: {_id:1635}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consequently, this leads to the activation of TANK-binding kinase 1 (TBK1) and phosphorylation of interferon regulatory factor 3 (IRF3), both of which constitutively associate with cytosolic chaperone Hsp90. It remains largely unknown how MAVS activates TBK1/IRF3. In this study, we identified translocases of outer membrane 70 (Tom70), a mitochondrial import receptor, to interact with MAVS upon RNA virus infection. Ectopic expression or knockdown of Tom70 could enhance or impair IRF3-mediated gene expression, respectively.", citationTitle:"Cell Res. 2010 Sep;20(9):994-1011. doi: 10.1038/cr.2010.103. Epub 2010 Jul 13.", annotationSubgraph:["Interferon signaling subgraph", "Matrix metalloproteinase subgraph"], pmid:"20628368", citationType:"PubMed", citationRef:"20628368"}}, {start: {_id:1052}, end: {_id:2006}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our study indicates that astrocytic DRD2 activation normally suppresses neuroinflammation in the central nervous system through a CRYAB-dependent mechanism, and provides a new strategy for targeting the astrocyte-mediated innate immune response in the central nervous system during ageing and disease.", citationTitle:"Nature. 2013 Feb 7;494(7435):90-4. doi: 10.1038/nature11748. Epub 2012 Dec 16.", annotationSubgraph:["Chaperone subgraph", "Dopaminergic subgraph"], annotationCell:["astrocyte"], pmid:"23242137", citationType:"PubMed", citationRef:"23242137"}}, {start: {_id:1557}, end: {_id:375}, properties:{evidence:"While this was initially surprising, the likely reason for this observation (downregulation of Th expression by Pgc-1α)", citationTitle:"PLoS One. 2012;7(11):e48925. doi: 10.1371/journal.pone.0048925. Epub 2012 Nov 7.", annotationSubgraph:["Energy metabolic subgraph", "Dopaminergic subgraph"], pmid:"23145024", citationType:"PubMed", citationRef:"23145024"}}, {start: {_id:375}, end: {_id:2010}, properties:{evidence:"The overexpression of mir-133b negatively regulated the expression of pitx3, an important transcription factor, and led to a series of deficits of DA-ACs such as TH and D2 receptor expression and DA producing", citationTitle:"Mol Neurobiol. 2013 Feb;47(1):241-60. doi: 10.1007/s12035-012-8366-6. Epub 2012 Nov 10.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"23143922", citationType:"PubMed", citationRef:"23143922"}}, {start: {_id:203}, end: {_id:375}, properties:{evidence:"Moreover, the lactacystin-treated Tg or Wt mice at 12 months of age lose much more nigral tyrosine hydroxylase (TH)-positive neurons than the mice at 5 months of age, indicating an age-associated DAergic neurotoxicity. Additionally, stereotactic injection of lactacystin induced a dramatic increase of activated microglia in substantia nigra of mice at 12 months of age, compared with mice at 5 months of age. In summary, our study suggests that expression of the G2019S mutation in the mouse LRRK2 gene confers an age-associated high susceptibility to proteasome inhibition-induced nigrostriatal DAergic degeneration.", citationTitle:"J Neural Transm (Vienna). 2015 Dec;122(12):1645-57. doi: 10.1007/s00702-015-1438-9. Epub 2015 Aug 8.", annotationSubgraph:["LRRK2 subgraph", "Dopaminergic subgraph"], pmid:"26253900", citationType:"PubMed", citationRef:"26253900"}}, {start: {_id:137}, end: {_id:309}, properties:{evidence:"At nanomolar concentrations, a-SN protected neurons against serum deprivation, oxidative stress, and excitotoxicity through the PI3/Akt signaling pathway, and its protective effect was increased by Bcl-2 overexpression. Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity. This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release and caspase activation and also by microglia-mediated inflammatory responses via the NFkappaB and mitogen-activated protein kinase pathways.", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Bcl-2 subgraph", "Synuclein subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}, {start: {_id:638}, end: {_id:452}, properties:{evidence:"Finally, our study indicates that the common PD-related mutations of LRRK2, R1441G, Y1699C and G2019S, decrease homeostatic phosphorylation levels of S935 and impair 14-3-3 binding of LRRK2.", citationTitle:"PLoS One. 2011 Mar 1;6(3):e17153. doi: 10.1371/journal.pone.0017153.", annotationSubgraph:["LRRK2 subgraph", "Notch signaling subgraph"], pmid:"21390248", citationType:"PubMed", citationRef:"21390248"}}, {start: {_id:2026}, end: {_id:452}, properties:{evidence:"Finally, our study indicates that the common PD-related mutations of LRRK2, R1441G, Y1699C and G2019S, decrease homeostatic phosphorylation levels of S935 and impair 14-3-3 binding of LRRK2.", citationTitle:"PLoS One. 2011 Mar 1;6(3):e17153. doi: 10.1371/journal.pone.0017153.", annotationSubgraph:["LRRK2 subgraph", "Notch signaling subgraph"], pmid:"21390248", citationType:"PubMed", citationRef:"21390248"}}, {start: {_id:196}, end: {_id:452}, properties:{evidence:"Finally, our study indicates that the common PD-related mutations of LRRK2, R1441G, Y1699C and G2019S, decrease homeostatic phosphorylation levels of S935 and impair 14-3-3 binding of LRRK2.", citationTitle:"PLoS One. 2011 Mar 1;6(3):e17153. doi: 10.1371/journal.pone.0017153.", annotationSubgraph:["LRRK2 subgraph", "Notch signaling subgraph"], pmid:"21390248", citationType:"PubMed", citationRef:"21390248"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:2029}, end: {_id:196}, properties:{evidence:"In summary, our data support the interest of the CB2 receptor as a potential pharmacological target in LRRK2 transgenic mice, although the neuronal substrates underlying these benefits might be not completely related to the basal ganglia and to the presumed parkinsonian features of these mice.", citationTitle:"Pharmacol Res. 2016 Aug;110:181-92. doi: 10.1016/j.phrs.2016.04.004. Epub 2016 Apr 6.", annotationSubgraph:["LRRK2 subgraph"], pmid:"27063942", citationType:"PubMed", citationRef:"27063942"}}, {start: {_id:386}, end: {_id:196}, properties:{evidence:"Our findings demonstrate that SP1 attenuates mutant LRRK2-induced PD- like phenotypes and plays a neural protective role.", citationTitle:"Hum Mol Genet. 2016 Feb 15;25(4):672-80. doi: 10.1093/hmg/ddv504. Epub 2016 Jan 6.", annotationSubgraph:["LRRK2 subgraph", "Synuclein subgraph"], pmid:"26744328", citationType:"PubMed", citationRef:"26744328"}}, {start: {_id:2118}, end: {_id:771}, properties:{evidence:"Overexpression of TREM2 in microglia resulted in increased phagocytosis of apoptotic neurons and decreased gene transcription of TNF-alpha, IL-1beta, and NOS2.", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:595}, properties:{evidence:"Overexpression of TREM2 in microglia resulted in increased phagocytosis of apoptotic neurons and decreased gene transcription of TNF-alpha, IL-1beta, and NOS2.", annotationSubgraph:["Nitric oxide subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:509}, properties:{evidence:"Overexpression of TREM2 in microglia resulted in increased phagocytosis of apoptotic neurons and decreased gene transcription of TNF-alpha, IL-1beta, and NOS2.", annotationSubgraph:["Inflammatory response subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:771}, end: {_id:2118}, properties:{evidence:"IL-1beta and TNFalpha upregulated TREM-1 and TREM-3 expression and suppressed TREM-2 expression in macrophages and endothelial cells.", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"18222421", citationType:"PubMed", citationRef:"18222421"}}, {start: {_id:509}, end: {_id:2118}, properties:{evidence:"IL-1beta and TNFalpha upregulated TREM-1 and TREM-3 expression and suppressed TREM-2 expression in macrophages and endothelial cells.", annotationSubgraph:["Inflammatory response subgraph", "Tumor necrosis factor subgraph"], annotationConfidence:["Very High"], pmid:"18222421", citationType:"PubMed", citationRef:"18222421"}}, {start: {_id:2118}, end: {_id:595}, properties:{evidence:"Furthermore, TREM2 expression in microglia impairs TNFalpha and NOS2 transcript expression even as it increases phagocytosis in response to apoptotic neurons.", annotationSubgraph:["Nitric oxide subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19302484", citationType:"PubMed", citationRef:"19302484"}}, {start: {_id:2147}, end: {_id:2118}, properties:{evidence:"Collectively, these results show that TREM-2 mediates rapid calcium signaling, ERK activation and NFATc1 expression downstream of RANK, and that IL-10 inhibits this signaling pathway by downregulating TREM-2 expression.", annotationConfidence:["Very High"], pmid:"19625651", citationType:"PubMed", citationRef:"19625651"}}, {start: {_id:2147}, end: {_id:2118}, properties:{evidence:"IL-10 Suppresses Calcium mediated Costimulation of RANK Signaling During Human Osteoclast Differentiation by Inhibiting TREM-2 Expression.", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19625651", citationType:"PubMed", citationRef:"19625651"}}, {start: {_id:2147}, end: {_id:2118}, properties:{evidence:"IL-10 and other homeostatic cytokines inhibited an early step in human osteoclastogenesis, the generation of RANK + TREM-2 + osteoclast precursors, by inhibiting TREM-2 transcription.", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19625651", citationType:"PubMed", citationRef:"19625651"}}, {start: {_id:2147}, end: {_id:2118}, properties:{evidence:"IL-10 effectively suppressed the increase in TREM-2 primary transcripts (XREF_FIG), indicating that IL-10 inhibited TREM-2 gene transcription.", annotationSubgraph:["Interleukin signaling subgraph", "Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"19625651", citationType:"PubMed", citationRef:"19625651"}}, {start: {_id:2194}, end: {_id:61}, properties:{evidence:"IGFBP-3 also modifies the DU-145 cell cycle, decreases p34 (cdc2) levels, and IGF-1R autophosphorylation.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"10066747", citationType:"PubMed", citationRef:"10066747"}}, {start: {_id:2194}, end: {_id:2195}, properties:{evidence:"IGFBP-3 also modifies the DU-145 cell cycle, decreases p34 (cdc2) levels, and IGF-1R autophosphorylation.", annotationSubgraph:["Insulin signal transduction", "Cell cycle subgraph"], annotationConfidence:["High"], pmid:"10066747", citationType:"PubMed", citationRef:"10066747"}}, {start: {_id:56}, end: {_id:2196}, properties:{evidence:"IGF-1R may down-regulate the Fas expression rendering transformed ovarian mesothelial cells resistant to apoptosis.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"10397275", citationType:"PubMed", citationRef:"10397275"}}, {start: {_id:2202}, end: {_id:56}, properties:{evidence:"We have previously shown that the product of the WT1 Wilms ' tumor suppressor gene represses IGF-I receptor gene expression both in vitro and in vivo, and that decreased WT1 levels are correlated with up- regulation of IGF-I receptor gene expression in Wil", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["High"], pmid:"10499530", citationType:"PubMed", citationRef:"10499530"}}, {start: {_id:56}, end: {_id:2209}, properties:{evidence:"Recently, IGF1R activation was shown to induce rapid and transient tyrosine dephosphorylation of FAK, p130 Crk associated substrate, and paxillin in MCF-7 breast cancer epithelial cells [XREF_BIBR].", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"11250706", citationType:"PubMed", citationRef:"11250706"}}, {start: {_id:2202}, end: {_id:56}, properties:{evidence:"We have previously reported that the WT1 protein represses the expression of the IGF-I receptor gene, whereas the EWS (1-7)-WT1 (8-10) fusion protein activates IGF-I receptor gene expression.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"11896622", citationType:"PubMed", citationRef:"11896622"}}, {start: {_id:2243}, end: {_id:2240}, properties:{evidence:"Inclusion of GRB2 in a reaction mixture of IRS-1 and active PTP1B also increased the overall rate of IRS-1 tyrosine dephosphorylation by 2.7-3.9-fold (p < 0.01).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"10660596", citationType:"PubMed", citationRef:"10660596"}}, {start: {_id:271}, end: {_id:138}, properties:{evidence:"Overexpression of parkin, but not its PD linked T240R mutant or GFP, significantly lowered the mRNA levels of MAO-A and MAO-B in P001 and P002 neurons (p < 0.05, n = 4, student 's t-test, unpaired, two tailed) (XREF_FIG), as well as the activities of MAO-", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"22314364", citationType:"PubMed", citationRef:"22314364"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:271}, end: {_id:2260}, properties:{evidence:"Overexpression of parkin, but not its PD linked T240R mutant or GFP, significantly lowered the mRNA levels of MAO-A and MAO-B in P001 and P002 neurons (p < 0.05, n = 4, student 's t-test, unpaired, two tailed) (XREF_FIG), as well as the activities of MAO-", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"22314364", citationType:"PubMed", citationRef:"22314364"}}, {start: {_id:138}, end: {_id:1550}, properties:{evidence:"Our experiments demonstrated a decrease in LC3 following induction of human MAO-B expression, suggesting decreased efficiency of autophagic degradation (XREF_FIG).", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"22329629", citationType:"PubMed", citationRef:"22329629"}}, {start: {_id:75}, end: {_id:138}, properties:{evidence:"Biochemical assays revealed that administration of insulin attenuated STZ treated diabetes induced neurochemical alterations as indicated by elevated serotonin levels and decreased MAO-A and MAO-B activities in the brain.", annotationSubgraph:["Insulin signal transduction", "Dopaminergic subgraph"], annotationConfidence:["Very High"], pmid:"24582678", citationType:"PubMed", citationRef:"24582678"}}, {start: {_id:75}, end: {_id:2260}, properties:{evidence:"Biochemical assays revealed that administration of insulin attenuated STZ treated diabetes induced neurochemical alterations as indicated by elevated serotonin levels and decreased MAO-A and MAO-B activities in the brain.", annotationSubgraph:["Insulin signal transduction", "Dopaminergic subgraph"], annotationConfidence:["Very High"], pmid:"24582678", citationType:"PubMed", citationRef:"24582678"}}] AS row
