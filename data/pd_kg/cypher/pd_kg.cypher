UNWIND [{start: {_id:870}, end: {_id:869}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Using mass spectroscopy, we found that Cox7c, a nuclear-encoded subunit of the mitochondrial enzyme cytochrome oxidase, is up- regulated in the striatum of male but not female mice after receiving a single dose of caffeine. The expression of two other Cox subunits, Cox1 and Cox4, was also stimulated by caffeine in a male-specific fashion. Overall, these findings indicate that cytochrome oxidase is a metabolic target of caffeine and that stimulation of Cox activity by caffeine via blockade of A2AR signaling may be an important mechanism underlying the therapeutic benefits of caffeine in PD.", citationTitle:"Mol Pharmacol. 2008 Sep;74(3):673-84. doi: 10.1124/mol.108.046888. Epub 2008 Jun 26.", annotationMeshanatomy:["Corpus Striatum"], pmid:"18583456", citationType:"PubMed", citationRef:"18583456"}}, {start: {_id:1418}, end: {_id:1770}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin increases the mitochondrial abundance of HSD17B10 in a ubiquitin-dependent manner.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1418}, end: {_id:1770}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin recruitment and ubiquitylation may, in turn, facilitate HSD17B10 import", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:857}, end: {_id:1204}, properties:{evidence:"Other suspected risk factors for constipation include inadequate fluid or dietary fiber intake, less physical activity, concurrent use of certain medications, levels of thyroid hormone and progesterone, and a wide range of medical conditions including neurodegenerative diseases (Leung 2007; Leung et al. 2011).", citationTitle:"Environ Health Perspect. 2013 Nov-Dec;121(11-12):1245-52. doi: 10.1289/ehp.1306967. Epub 2013 Aug 7.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Constipation"], pmid:"23933572", citationType:"PubMed", citationRef:"23933572"}}, {start: {_id:1216}, end: {_id:16}, properties:{evidence:"The study included 27 patients and 24 control subjects. The nasal cycle was present in significantly fewer patients than controls. Nasal pH and mucociliary clearance time were significantly higher in patients than in controls.", citationTitle:"J Int Med Res. 2013 Apr;41(2):334-9. doi: 10.1177/0300060513476433. Epub 2013 Feb 6.", annotationMeshdisease:["Parkinson Disease"], pmid:"23569018", citationType:"PubMed", citationRef:"23569018"}}, {start: {_id:1217}, end: {_id:16}, properties:{evidence:"The study included 27 patients and 24 control subjects. The nasal cycle was present in significantly fewer patients than controls. Nasal pH and mucociliary clearance time were significantly higher in patients than in controls.", citationTitle:"J Int Med Res. 2013 Apr;41(2):334-9. doi: 10.1177/0300060513476433. Epub 2013 Feb 6.", annotationMeshdisease:["Parkinson Disease"], pmid:"23569018", citationType:"PubMed", citationRef:"23569018"}}, {start: {_id:1440}, end: {_id:16}, properties:{evidence:"mitochondrial respiratory dysfunction also occurs in sporadic PD", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1740}, end: {_id:16}, properties:{evidence:"Available evidence suggests impairment of the mitochondrial respiratory chain in sporadic and toxin-induced PD.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1440}, end: {_id:16}, properties:{evidence:"Failure to degrade damaged RC proteins could account for the RC deficits seen in many PD patients and may play an important role in PD pathogenesis", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:396}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Vice versa, ER stress results in mitochondrial damage, which can be prevented by parkin", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1717}, end: {_id:16}, properties:{evidence:"Dysregulation of the homeostatic mechanisms of mitochondrial maintenance (mitochondrial fission, fusion, transport, biogenesis and degradation â€” collectively termed â€˜mitochondrial dynamicsâ€™), has been increasingly linked to neurodegeneration and Parkinson's disease (PD) neuropathology", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:323}, end: {_id:16}, properties:{evidence:"Dysregulation of the homeo