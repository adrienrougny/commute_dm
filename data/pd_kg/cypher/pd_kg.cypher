UNWIND [{start: {_id:1644}, end: {_id:1593}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Using quantitative immunoblotting, we found that the environmental toxin arsenite (As(III)) induces a rapid decrease of Tim17A in HEK293T cells, demonstrating a half-time (t50) of ~2 h (Figure 1A,B Neither Tim17B nor Tim23 were affected over the timecourse of this experiment.", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Transport related subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1645}, end: {_id:1593}, properties:{annotationCondition:["Normal Healthy State"], evidence:"CHX decreases Tim17A independent of stress in HEK293T cells (Figure S1I). Neither Tim17B nor Tim23 were significantly affected by CHX. CHX reduces Tim17A in both MEFWT and MEFA/A (Figure 1H), demonstrating that CHX decreases Tim17A independent of eIF2Î± phosphorylation. CHX is known to increase eIF2Î± phosphorylation (Jiang et al., 2003) (shown in the CHX-treated MEFWT cell; Figure 1H), but CHX prevents translation of ISR induced stress-responsive genes.", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Transport related subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1775}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Previously, we showed that the unique bioenergetics of post-mitotic neurons, which are dependent on mitochondrial respiration, appear to downregulate Parkin translocation following global mitochondrial depolarization by the protonophore carbonyl cyanide m-chlorophenyl hydrazone (CCCP)", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:2086}, end: {_id:2081}, properties:{evidence:"In the present study, we examined the possibility that the cellular receptors of PEI/DNA complexes might also be subjected to PKC regulation. To test if PKC might have a role in internalization of PEI/DNA complexes, we treated HeLa cells with staurosporine and tested the effects of this PKC inhibitor on transfection efï¬�ciency using a luciferase assay. As shown in Figure 1, staurosporine inhibited transfection in a concentration-dependent manner. The effects were observed at concentrations similar to those used to interfere with bacterial invasion [17] and uptake of HSPG-ligating beads [15] into HeLa cells.", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2162}, end: {_id:2181}, properties:{evidence:"7beta-hydroxy-dehydroepiandrosterone remained increased for 28 days, 7alpha-hydroxy-dehydroepiandrosterone, testosterone, estradiol and sex hormone-binding globulin were decreased as late as day 63 and 91, respectively. On the other hand, epitestosterone", pmid:"15843221", citationType:"PubMed", citationRef:"15843221"}}] AS row
