UNWIND [{start: {_id:1279}, end: {_id:77}, properties:{evidence:"Hyperacetylation of Histones Promotes Dieldrin-Induced Caspase-3 Activation and PKCâˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â¥ Proteolytic Activation in Dopaminergic Cells. Inhibition of Hyperacetylation Protects Dopaminergic Cells from Dieldrin-Induced Apoptosis and Neurotoxicity.", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:1280}, end: {_id:77}, properties:{evidence:"Hyperacetylation of Histones Promotes Dieldrin-Induced Caspase-3 Activation and PKCâˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â¥ Proteolytic Activation in Dopaminergic Cells. Inhibition of Hyperacetylation Protects Dopaminergic Cells from Dieldrin-Induced Apoptosis and Neurotoxicity.", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:1655}, end: {_id:267}, properties:{evidence:"While ROS are required for glucose metabolism and metastasis in triple-negative breast cancers (9), decreased SirT3 levels concomitant with high ROS levels are frequently observed in all breast cancers (8). Based on these findings, SirT3 is considered a tumor suppressor (5, 8). SirT3 regulates the activity of magnesium superoxide dismutase (MnSOD), which detoxifies superoxide to hydrogen peroxide (5, 7, 10,â€“14). Moreover, SirT3 has been linked to augmented transcription of MnSOD and catalase, both known targets of the transcription factor FOXO3A (15). The SirT3-dependent deacetylation of FOXO3A promotes both its nuclear translocation and its transcriptional activity (16, 17). Therefore, mechanistically, the reduction of SirT3 levels leads to an elevation in ROS levels by compromising the mitochondrial antioxidant machinery.", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Unfolded protein response subgraph", "Reactive oxygen species subgraph"], annotationMeshdisease:["Breast Neoplasms"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1655}, end: {_id:267}, properties:{evidence:"However, in the context of the tumor phenotype, an elevation in the SirT3 level is vital to reduce proteotoxic stress and keep ROS levels below a critical threshold.", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshdisease:["Breast Neoplasms"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1418}, end: {_id:748}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consistent with the lack of recruitment of autophagy markers (Supplementary Figure S3), no mitochondrial clearance was observed in cells overproducing Parkin and HSD17B10 in the absence of CCCP.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1084}, end: {_id:1085}, properties:{evidence:"We propose that by ubiquitinating Eps15, parkin interferes with the ability of the Eps15 UIMs to bind ubiquitinated EGFR, thereby delaying EGFR internalization and degradation, and promoting PI(3)K-Akt signalling.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:221}, end: {_id:230}, properties:{evidence:"PINK1 mutants associated with recessive Parkinson's disease are defective in inhibiting mitochondrial release of cytochrome c.Mutations in PTEN-induced kinase 1 (PINK1) gene cause recessive familial type 6 of Parkinson's disease (PARK6). We investigated molecular mechanisms underlying PINK1 neuroprotective function and PARK6 mutation-induced loss of PINK1 function. Overexpression of wild- type PINK1 blocked mitochondrial release of apoptogenic cytochrome c, caspase-3 activation and apoptotic cell death induced by proteasome inhibitor MG132. N-terminal truncated PINK1 (NDelta35), which lacks mitochondrial localization sequence, did not block MG132-induced cytochrome c release and cytotoxicity. Despite mitochondrial expression, PARK6 mutant (E240K), (H271Q), (G309D), (L347P), (E417G) and C-terminal truncated (CDelta145) PINK1 failed to inhibit MG132-induced cytochrome c release and caspase-3 activation. Overexpression of wild-type PINK1 blocked cytochrome c release and cell death caused by atractyloside, which opens mitochondrial permeability transition pore (mPTP). PARK6 PINK1 mutants failed to inhibit atractyloside-induced cytochrome c release. These results suggest that PINK1 exerts anti-apoptotic effect by inhibiting the opening of mPTP and that PARK6 mutant PINK1 loses its ability to prevent mPTP opening and cytochrome c release.", citationTitle:"Neurobiol Dis. 2007 Nov;28(2):216-26. Epub 2007 Jul 17.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17707122", citationType:"PubMed", citationRef:"17707122"}}, {start: {_id:221}, end: {_id:230}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 protects against oxidative stress by phosphorylating mitochondrial chaperone TRAP1. Mutations in the PTEN induced putative kinase 1 (PINK1) gene cause an autosomal recessive form of Parkinson disease (PD). So far, no substrates of PINK1 have been reported, and the mechanism by which PINK1 mutations lead to neurodegeneration is unknown. Here we report the identification of TNF receptor-associated protein 1 (TRAP1), a mitochondrial molecular chaperone also known as heat shock protein 75 (Hsp75), as a cellular substrate for PINK1 kinase. PINK1 binds and colocalizes with TRAP1 in the mitochondria and phosphorylates TRAP1 both in vitro and in vivo. We show that PINK1 protects against oxidative-stress-induced cell death by suppressing cytochrome c release from mitochondria, and this protective action of PINK1 depends on its kinase activity to phosphorylate TRAP1. Moreover, we find that the ability of PINK1 to promote TRAP1 phosphorylation and cell survival is impaired by PD-linked PINK1 G309D, L347P, and W437X mutations. Our findings suggest a novel pathway by which PINK1 phosphorylates downstream effector TRAP1 to prevent oxidative-stress- induced apoptosis and implicate the dysregulation of this Mitochondrial subgraph in PD pathogenesis.", citationTitle:"PLoS Biol. 2007 Jul;5(7):e172. Epub 2007 Jun 19.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], pmid:"17579517", citationType:"PubMed", citationRef:"17579517"}}, {start: {_id:1418}, end: {_id:1423}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The direct ubiquitination of purified Bax was also observed in vitro following incubation with recombinant parkin. We found that parkin prevented basal and apoptotic stress-induced translocation of Bax to the mitochondria.", citationTitle:"Proc Natl Acad Sci U S A. 2012 Apr 17;109(16):6283-8. doi: 10.1073/pnas.1113248109. Epub 2012 Mar 29.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["10090"], pmid:"22460798", citationType:"PubMed", citationRef:"22460798"}}, {start: {_id:1429}, end: {_id:1435}, properties:{evidence:"Here, we show that Parkin-dependent mitophagy is antagonized by prosurvival members of the Bcl-2 family (e.g., Bcl-xL and Mcl-1) in a Beclin-1-independent manner. Bcl-2 proteins suppressed mitophagy through inhibition of Parkin translocation to depolarized mitochondria.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Bcl-2 subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}, {start: {_id:309}, end: {_id:1435}, properties:{evidence:"Here, we show that Parkin-dependent mitophagy is antagonized by prosurvival members of the Bcl-2 family (e.g., Bcl-xL and Mcl-1) in a Beclin-1-independent manner. Bcl-2 proteins suppressed mitophagy through inhibition of Parkin translocation to depolarized mitochondria.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Bcl-2 subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}, {start: {_id:1452}, end: {_id:1450}, properties:{evidence:"The soluble Parkin mutations K211N, T240R and G430D interfere with the proper activation/translocation event of Parkin. Furthermore, these mutants fail to ubiquitylate VDAC1 and to recruit p62 to sequestered mitochondria.", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationConfidence:["High"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:1454}, end: {_id:1450}, properties:{evidence:"The soluble Parkin mutations K211N, T240R and G430D interfere with the proper activation/translocation event of Parkin. Furthermore, these mutants fail to ubiquitylate VDAC1 and to recruit p62 to sequestered mitochondria.", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationConfidence:["High"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:1456}, end: {_id:1450}, properties:{evidence:"The soluble Parkin mutations K211N, T240R and G430D interfere with the proper activation/translocation event of Parkin. Furthermore, these mutants fail to ubiquitylate VDAC1 and to recruit p62 to sequestered mitochondria.", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationConfidence:["High"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:1490}, end: {_id:1491}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The screens revealed that SIAH3, found to localize to mitochondria, inhibits PINK1 accumulation after mitochondrial insult, reducing parkin translocation.", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"22280891", citationType:"PubMed", citationRef:"22280891"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:47}, end: {_id:54}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Growth factor receptor-bound protein 10 (Grb10), a suppressor of IGF1R pathway, has been shown to play a critical role in regulating diabetes-associated cognitive impairment.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:109}, end: {_id:103}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we show that Mind bomb (Mib), a ubiquitin ligase that promotes Notch ligand trafficking and activity, is a crucial molecular substrate for PAR-1. The phosphorylation of Mib by PAR-1 results in Mib degradation, repression of Notch signaling, and stimulation of neuronal differentiation.", citationTitle:"Dev Cell. 2009 Aug;17(2):222-33. doi: 10.1016/j.devcel.2009.06.010.", annotationSubgraph:["G-protein-mediated signaling", "Notch signaling subgraph"], pmid:"19686683", citationType:"PubMed", citationRef:"19686683"}}, {start: {_id:113}, end: {_id:55}, properties:{evidence:"Furthermore, being a CLSTN2 TT carrier was associated with poorer semantic memory.", citationTitle:"Psychol Aging. 2013 Mar;28(1):262-74. doi: 10.1037/a0030829. Epub 2012 Dec 31.", annotationSubgraph:["Calsyntenin subgraph"], annotationMeshdisease:["Nervous System Diseases"], pmid:"23276211", citationType:"PubMed", citationRef:"23276211"}}, {start: {_id:202}, end: {_id:205}, properties:{evidence:"The PD-associated mutation, R1441C, located within the Roc domain, leads to an increase in LRRK2 kinase activity and a decrease in the rate of GTP hydrolysis, compared to the wild-type protein, in an in vitro assay. This finding suggests that the R1441C mutation may help stabilize an activated state of LRRK2. Additionally, LRRK2-mediated phosphorylation is stimulated upon binding of non-hydrolyzable GTP analogs, suggesting that LRRK2 is an MAPKKK-activated intramolecularly by its own GTPase. Since GTPases and MAPKKKs are upstream regulators of multiple signal transduction cascades, LRRK2 may play a central role in integrating pathways involved in neuronal cell signaling and the pathogenesis of PD.", citationTitle:"Exp Cell Res. 2007 Oct 1;313(16):3658-70. Epub 2007 Jul 19.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17706965", citationType:"PubMed", citationRef:"17706965"}}, {start: {_id:220}, end: {_id:222}, properties:{evidence:"The deposition of alpha-synuclein (aS), a product of pathogenic gene for dominantly inherited familial Parkinson's disease (PD; park1), as fibrillary aggregates like Lewy bodies (LB), is a hallmark lesion of a set of neurodegenerative disorders termed synucleinopathies, including sporadic PD and dementia with Lewy bodies (DLB). We found that aS is the major component of LBs and further identified a specific phosphorylation of Ser129 of insoluble aS by mass spectrometric analysis. The roles of DJ-1 and PINK-1, products of pathogenic genes for autosomal recessive forms of early-onset parkinsonism, have subsequently been examined. Overexpression of DJ-1 conferred cultured cells resistance to oxidative stress, suggesting an antioxidant function of DJ-1. We also confirmed the anti-PTEN function of DJ-1 that may promote cell survival, showing decreased phosphorylation of Akt through upregulation of PTEN activity upon siRNA knockdown for DJ-1. PINK-1, that had been identified as a gene upregulated by PTEN overexpression, turned out to be a protein kinase localized in mitochondria. Collectively, information derived from studies on pathogenic genes for familial PD will open up the way toward the clarification of the pathogenesis of PD, underscoring the roles of protein aggregation, proteolysis, oxidative stress and protein phosphorylation in PD.", citationTitle:"Rinsho Shinkeigaku. 2005 Nov;45(11):899-901.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21532868", citationType:"PubMed", citationRef:"21532868"}}, {start: {_id:221}, end: {_id:222}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 protects against oxidative stress by phosphorylating mitochondrial chaperone TRAP1. Mutations in the PTEN induced putative kinase 1 (PINK1) gene cause an autosomal recessive form of Parkinson disease (PD). So far, no substrates of PINK1 have been reported, and the mechanism by which PINK1 mutations lead to neurodegeneration is unknown. Here we report the identification of TNF receptor-associated protein 1 (TRAP1), a mitochondrial molecular chaperone also known as heat shock protein 75 (Hsp75), as a cellular substrate for PINK1 kinase. PINK1 binds and colocalizes with TRAP1 in the mitochondria and phosphorylates TRAP1 both in vitro and in vivo. We show that PINK1 protects against oxidative-stress-induced cell death by suppressing cytochrome c release from mitochondria, and this protective action of PINK1 depends on its kinase activity to phosphorylate TRAP1. Moreover, we find that the ability of PINK1 to promote TRAP1 phosphorylation and cell survival is impaired by PD-linked PINK1 G309D, L347P, and W437X mutations. Our findings suggest a novel pathway by which PINK1 phosphorylates downstream effector TRAP1 to prevent oxidative-stress- induced apoptosis and implicate the dysregulation of this Mitochondrial subgraph in PD pathogenesis.", citationTitle:"PLoS Biol. 2007 Jul;5(7):e172. Epub 2007 Jun 19.", annotationSubgraph:["PINK1 subgraph", "Response to oxidative stress"], pmid:"17579517", citationType:"PubMed", citationRef:"17579517"}}, {start: {_id:250}, end: {_id:222}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 protects against oxidative stress by phosphorylating mitochondrial chaperone TRAP1. Mutations in the PTEN induced putative kinase 1 (PINK1) gene cause an autosomal recessive form of Parkinson disease (PD). So far, no substrates of PINK1 have been reported, and the mechanism by which PINK1 mutations lead to neurodegeneration is unknown. Here we report the identification of TNF receptor-associated protein 1 (TRAP1), a mitochondrial molecular chaperone also known as heat shock protein 75 (Hsp75), as a cellular substrate for PINK1 kinase. PINK1 binds and colocalizes with TRAP1 in the mitochondria and phosphorylates TRAP1 both in vitro and in vivo. We show that PINK1 protects against oxidative-stress-induced cell death by suppressing cytochrome c release from mitochondria, and this protective action of PINK1 depends on its kinase activity to phosphorylate TRAP1. Moreover, we find that the ability of PINK1 to promote TRAP1 phosphorylation and cell survival is impaired by PD-linked PINK1 G309D, L347P, and W437X mutations. Our findings suggest a novel pathway by which PINK1 phosphorylates downstream effector TRAP1 to prevent oxidative-stress- induced apoptosis and implicate the dysregulation of this Mitochondrial subgraph in PD pathogenesis.", citationTitle:"PLoS Biol. 2007 Jul;5(7):e172. Epub 2007 Jun 19.", annotationSubgraph:["Chaperone subgraph", "Response to oxidative stress"], pmid:"17579517", citationType:"PubMed", citationRef:"17579517"}}, {start: {_id:220}, end: {_id:222}, properties:{annotationCondition:["Normal Healthy State"], evidence:"DJ-1 may function as a redox-sensitive chaperone as well as a sensor of oxidative stress and apparently protects neurons against oxidative stress and cell death.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Chaperone subgraph"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:220}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"DJ-1 may function as a redox-sensitive chaperone as well as a sensor of oxidative stress and apparently protects neurons against oxidative stress and cell death.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Chaperone subgraph"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:137}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Compared with untransfected SH-SY5Y cells, wild type alpha-Syn attenuated rotenone and maneb-induced cell death along with an attenuation of toxin-induced mitochondrial membrane potential changes and Reactive Oxygen Species level, whereas the mutant alpha-Syn constructs exacerbated environmental toxins-induced cytotoxicity.", citationTitle:"Neurotoxicology. 2011 Dec;32(6):857-63. doi: 10.1016/j.neuro.2011.05.012. Epub 2011 May 30.", annotationSubgraph:["Apoptosis signaling subgraph", "Synuclein subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"21658409", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"21658409"}}, {start: {_id:137}, end: {_id:357}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Compared with untransfected SH-SY5Y cells, wild type alpha-Syn attenuated rotenone and maneb-induced cell death along with an attenuation of toxin-induced mitochondrial membrane potential changes and Reactive Oxygen Species level, whereas the mutant alpha-Syn constructs exacerbated environmental toxins-induced cytotoxicity.", citationTitle:"Neurotoxicology. 2011 Dec;32(6):857-63. doi: 10.1016/j.neuro.2011.05.012. Epub 2011 May 30.", annotationSubgraph:["Synuclein subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"21658409", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"21658409"}}, {start: {_id:137}, end: {_id:358}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Compared with untransfected SH-SY5Y cells, wild type alpha-Syn attenuated rotenone and maneb-induced cell death along with an attenuation of toxin-induced mitochondrial membrane potential changes and Reactive Oxygen Species level, whereas the mutant alpha-Syn constructs exacerbated environmental toxins-induced cytotoxicity.", citationTitle:"Neurotoxicology. 2011 Dec;32(6):857-63. doi: 10.1016/j.neuro.2011.05.012. Epub 2011 May 30.", annotationSubgraph:["Synuclein subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"21658409", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"21658409"}}, {start: {_id:529}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Clearly, a compound which possesses the ability to prevent cellular apoptosis, free radical damage, and inflammation would be a good candidate as a protective agent against the ravages of PD. These three prerequisites have been found for Ucn 1 in other tissues .", citationTitle:"Int J Biochem Cell Biol. 2015 Mar;60C:130-138. doi: 10.1016/j.biocel.2014.12.005. Epub 2014 Dec 23.", annotationSubgraph:["Innate immune system subgraph"], pmid:"25541373", citationType:"PubMed", citationRef:"25541373"}}, {start: {_id:529}, end: {_id:112}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Clearly, a compound which possesses the ability to prevent cellular apoptosis, free radical damage, and inflammation would be a good candidate as a protective agent against the ravages of PD. These three prerequisites have been found for Ucn 1 in other tissues .", citationTitle:"Int J Biochem Cell Biol. 2015 Mar;60C:130-138. doi: 10.1016/j.biocel.2014.12.005. Epub 2014 Dec 23.", annotationSubgraph:["Innate immune system subgraph"], pmid:"25541373", citationType:"PubMed", citationRef:"25541373"}}, {start: {_id:529}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, Ucn 1 may regulate cellular communication between dopaminergic neurons and microglia, thereby preventing cell damage by reducing the massive astrogliosis, which arises in the SN as a result of LPS- induced toxicity.", citationTitle:"Int J Biochem Cell Biol. 2015 Mar;60C:130-138. doi: 10.1016/j.biocel.2014.12.005. Epub 2014 Dec 23.", annotationSubgraph:["Innate immune system subgraph"], annotationMeshanatomy:["Microglia", "Dopaminergic Neurons"], pmid:"25541373", citationType:"PubMed", citationRef:"25541373"}}, {start: {_id:529}, end: {_id:535}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, Ucn 1 may regulate cellular communication between dopaminergic neurons and microglia, thereby preventing cell damage by reducing the massive astrogliosis, which arises in the SN as a result of LPS- induced toxicity.", citationTitle:"Int J Biochem Cell Biol. 2015 Mar;60C:130-138. doi: 10.1016/j.biocel.2014.12.005. Epub 2014 Dec 23.", annotationSubgraph:["Innate immune system subgraph"], annotationMeshanatomy:["Microglia", "Dopaminergic Neurons"], pmid:"25541373", citationType:"PubMed", citationRef:"25541373"}}, {start: {_id:560}, end: {_id:411}, properties:{evidence:"The tight junction proteins occludin and ZO-1 in a MPTP murine model of PD. Similarly, the exposure of murine EC to ROS increased the activity of metalloproteinase-9 (MMP-9), which caused degradation of the basal lamina and BBB disruption.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["RhoA subgraph", "Matrix metalloproteinase subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:621}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Further, Nrf2 knockdown abolishes DJ-1-mediated Trx1 induction and cytoprotection against hydrogen peroxide, indicating the critical role of Nrf2 in carrying out the protective functions of DJ-1 against oxidative stress.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Notch signaling subgraph", "Response to oxidative stress"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:672}, end: {_id:673}, properties:{evidence:"Monogenic disorders with various manifestations that may include parkinsonism Mutations in mitochondrial DNA polymerase gamma (POLG, POLG1) have been reported from patients with parkinsonism, with loss of dopaminergic cells evidenced in DATscans and at least partial response to dopaminergic medication [85] and [86].", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:621}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This correlated with increased motor neuron survival, reduced oxidative stress, and attenuated gliosis in the spinal cord, as well as a dramatic decrease in total hSYN(A53T) and phosphorylated (Ser129) hSYN(A53T) in Triton-insoluble aggregates. Furthermore, Nrf2 in astrocytes delayed chaperone-mediated autophagy and macroautophagy dysfunction observed in the hSYN(A53T) mice", citationTitle:"The Journal of neuroscience : the official journal of the Society for Neuroscience; Vol. 32; Iss. 49", annotationSubgraph:["Notch signaling subgraph"], pmid:"23223297", citationType:"PubMed", citationRef:"23223297"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:621}, end: {_id:685}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This correlated with increased motor neuron survival, reduced oxidative stress, and attenuated gliosis in the spinal cord, as well as a dramatic decrease in total hSYN(A53T) and phosphorylated (Ser129) hSYN(A53T) in Triton-insoluble aggregates. Furthermore, Nrf2 in astrocytes delayed chaperone-mediated autophagy and macroautophagy dysfunction observed in the hSYN(A53T) mice", citationTitle:"The Journal of neuroscience : the official journal of the Society for Neuroscience; Vol. 32; Iss. 49", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Motor Neurons"], pmid:"23223297", citationType:"PubMed", citationRef:"23223297"}}, {start: {_id:326}, end: {_id:712}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It has also been shown that beta-synucleins can protect against oxidative stress via the inactivation of the c-Jun N-terminal kinase signalling pathway [9] and [10].", citationTitle:"Biochemical and biophysical research communications; Vol. 441; Iss. 2", annotationSubgraph:["Synuclein subgraph"], pmid:"24140056", citationType:"PubMed", citationRef:"24140056"}}, {start: {_id:271}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"DJ-1 may function as a redox-sensitive chaperone as well as a sensor of oxidative stress and apparently protects neurons against oxidative stress and cell death [9].", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["fibroblast"], annotationMeshanatomy:["Neurons"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:271}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"DJ-1 may function as a redox-sensitive chaperone as well as a sensor of oxidative stress and apparently protects neurons against oxidative stress and cell death [9].", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["fibroblast"], annotationMeshanatomy:["Neurons"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:137}, end: {_id:783}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Alpha-synuclein selectively blocks endoplamic reticulum-to-Golgi transport, thus causing ER stress.", citationTitle:"J Cell Mol Med. 2006 Oct-Dec;10(4):837-46.", annotationSubgraph:["Synuclein subgraph", "Endoplasmic reticulum-Golgi protein export"], pmid:"17125588", citationType:"PubMed", citationRef:"17125588"}}, {start: {_id:814}, end: {_id:313}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Most pathogenic Mfn2 mutations cause loss of mitochondrial fusion activity, which could be complemented by wild-type Mfn1 but not Mfn2 (56)", citationTitle:"J Neuropathol Exp Neurol. 2009 Sep;68(9):953-63. doi: 10.1097/NEN.0b013e3181b2048c.", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondrial subgraph"], pmid:"19680148", citationType:"PubMed", citationRef:"19680148"}}, {start: {_id:220}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:". DJ-1 is shown to protect cells from oxidative stress both in transfected cells and in Drosophila (12,22,38,39).", citationTitle:"Hum Mol Genet. 2006 Jun 1;15(11):1816-25. Epub 2006 Apr 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"16632486", citationType:"PubMed", citationRef:"16632486"}}, {start: {_id:220}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These results suggest that DJ-1 decreases apoptosis in cells under conditions of intermittent oxidative stress through downregulation of DUSP1 expression.", citationTitle:"Mol Cell Biol. 2013 Jan;33(2):340-59. doi: 10.1128/MCB.01350-12. Epub 2012 Nov 12.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23149933", citationType:"PubMed", citationRef:"23149933"}}, {start: {_id:614}, end: {_id:589}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These results are in general agreement with experimental observations that L166P DJ-1 loses Œ±-helical content in L166P DJ-1, fails to form a dimer and cannot function as a chaperone.", citationTitle:"Biochemistry. 2008 Sep 9;47(36):9380-93. doi: 10.1021/bi800677k. Epub 2008 Aug 16.", annotationSubgraph:["Chaperone subgraph"], pmid:"18707128", citationType:"PubMed", citationRef:"18707128"}}, {start: {_id:955}, end: {_id:957}, properties:{evidence:"Dexamethasone, a glucocorticoid hormone receptor agonist, upregulated both protein and mRNA levels of TREK-1 leading to decreased NSC proliferation which could be reversed by bupivacaine. Fluoxetine, a serotonin reuptake inhibitor antidepressant that has been previously found to inhibit TREK-1 channels, robustly, could attenuate the upregulation of TREK-1 expression and the inhibition of NSC proliferation induced by dexamethasone.", citationTitle:"Psychopharmacology (Berl). 2011 Apr;214(3):747-59. doi: 10.1007/s00213-010-2077-3. Epub 2010 Nov 11.", annotationSubgraph:["Transport related subgraph"], annotationMeshdisease:["Nervous System Diseases"], annotationMeshanatomy:["Neurons"], pmid:"21069514", citationType:"PubMed", citationRef:"21069514"}}, {start: {_id:1031}, end: {_id:1032}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Preliminary studies with rTMS in patients with taste and smell dysfunction improved sensory function and increased salivary carbonic anhydrase (CA) VI and erythrocyte CA I, II. Because patients with several neurologic disorders exhibit taste and smell dysfunction, including Parkinson disease, Alzheimer disease,", citationTitle:"Am J Med Sci. 2010 Mar;339(3):249-57. doi: 10.1097/MAJ.0b013e3181cda0e3.", pmid:"20090508", citationType:"PubMed", citationRef:"20090508"}}, {start: {_id:1031}, end: {_id:1033}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Preliminary studies with rTMS in patients with taste and smell dysfunction improved sensory function and increased salivary carbonic anhydrase (CA) VI and erythrocyte CA I, II. Because patients with several neurologic disorders exhibit taste and smell dysfunction, including Parkinson disease, Alzheimer disease,", citationTitle:"Am J Med Sci. 2010 Mar;339(3):249-57. doi: 10.1097/MAJ.0b013e3181cda0e3.", pmid:"20090508", citationType:"PubMed", citationRef:"20090508"}}, {start: {_id:1114}, end: {_id:1115}, properties:{evidence:"To date, three myelin-associated proteins [Nogo or reticulon 4 (RTN4), myelin-associated glycoprotein (MAG) and oligodendrocyte myelin glycoprotein (OMG)] are known to inhibit axonal regeneration via activation of the neuronal glycosylphosphatidylinositol-anchored Nogo receptor [NgR, together with p75 neurotrophin receptor (p75NTR) and Lingo-1].", citationComment:"The novel protein MANI modulates neurogenesis and neurite-cone growth.", citationTitle:"Journal of cellular and molecular medicine; Vol. 15; Iss. 8", annotationSubgraph:["Neurotrophic subgraph"], annotationMeshdisease:["Nervous System Diseases"], citationPubDate:"2011-08-01", pmid:"20716133", citationAuthorList:"Manisha Mishra|Hiroyasu Akatsu|Klaus Heese", citationType:"PubMed", citationRef:"20716133"}}, {start: {_id:1118}, end: {_id:1115}, properties:{evidence:"To date, three myelin-associated proteins [Nogo or reticulon 4 (RTN4), myelin-associated glycoprotein (MAG) and oligodendrocyte myelin glycoprotein (OMG)] are known to inhibit axonal regeneration via activation of the neuronal glycosylphosphatidylinositol-anchored Nogo receptor [NgR, together with p75 neurotrophin receptor (p75NTR) and Lingo-1].", citationComment:"The novel protein MANI modulates neurogenesis and neurite-cone growth.", citationTitle:"Journal of cellular and molecular medicine; Vol. 15; Iss. 8", annotationSubgraph:["Neurotrophic subgraph"], annotationMeshdisease:["Nervous System Diseases"], citationPubDate:"2011-08-01", pmid:"20716133", citationAuthorList:"Manisha Mishra|Hiroyasu Akatsu|Klaus Heese", citationType:"PubMed", citationRef:"20716133"}}, {start: {_id:1119}, end: {_id:1115}, properties:{evidence:"To date, three myelin-associated proteins [Nogo or reticulon 4 (RTN4), myelin-associated glycoprotein (MAG) and oligodendrocyte myelin glycoprotein (OMG)] are known to inhibit axonal regeneration via activation of the neuronal glycosylphosphatidylinositol-anchored Nogo receptor [NgR, together with p75 neurotrophin receptor (p75NTR) and Lingo-1].", citationComment:"The novel protein MANI modulates neurogenesis and neurite-cone growth.", citationTitle:"Journal of cellular and molecular medicine; Vol. 15; Iss. 8", annotationSubgraph:["Neurotrophic subgraph"], annotationMeshdisease:["Nervous System Diseases"], citationPubDate:"2011-08-01", annotationConfidence:["Very High"], pmid:"20716133", citationAuthorList:"Manisha Mishra|Hiroyasu Akatsu|Klaus Heese", citationType:"PubMed", citationRef:"20716133"}}, {start: {_id:1120}, end: {_id:723}, properties:{evidence:"We show that knockdown of Cdc27, a component of the anaphase-promoting complex (APC), leads to enhanced neurite outgrowth.", citationComment:"The novel protein MANI modulates neurogenesis and neurite-cone growth.", citationTitle:"Journal of cellular and molecular medicine; Vol. 15; Iss. 8", annotationSubgraph:["Neurotrophic subgraph"], annotationMeshdisease:["Nervous System Diseases"], citationPubDate:"2011-08-01", pmid:"20716133", citationAuthorList:"Manisha Mishra|Hiroyasu Akatsu|Klaus Heese", citationType:"PubMed", citationRef:"20716133"}}, {start: {_id:137}, end: {_id:957}, properties:{evidence:"These results indicate that -syn affects the generation of NSC and suggest that this protein could serve as a tool for the design of potentially useful therapy for PD patients.", citationTitle:"J Neurochem. 2010 Nov;115(4):854-63. doi: 10.1111/j.1471-4159.2010.06727.x.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["neuronal stem cell"], pmid:"20374434", citationType:"PubMed", citationRef:"20374434"}}, {start: {_id:271}, end: {_id:328}, properties:{evidence:"we overproduced this protein in PC12 cells in an inducible manner. In this cell line, neuronally differentiated by nerve growth factor, Parkin overproduction protected against cell death mediated by ceramide", citationTitle:"Hum Mol Genet. 2003 Mar 1;12(5):517-26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"12588799", annotationCellline:["PC-12 cell"], citationType:"PubMed", citationRef:"12588799"}}, {start: {_id:271}, end: {_id:1415}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interestingly, Parkin acted by delaying mitochondrial swelling and subsequent cytochrome c release and caspase-3 activation observed in ceramide-mediated cell death", citationTitle:"Hum Mol Genet. 2003 Mar 1;12(5):517-26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"12588799", citationType:"PubMed", citationRef:"12588799"}}, {start: {_id:1429}, end: {_id:1434}, properties:{evidence:"Here, we show that Parkin-dependent mitophagy is antagonized by prosurvival members of the Bcl-2 family (e.g., Bcl-xL and Mcl-1) in a Beclin-1-independent manner. Bcl-2 proteins suppressed mitophagy through inhibition of Parkin translocation to depolarized mitochondria.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Bcl-2 subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:309}, end: {_id:1434}, properties:{evidence:"Here, we show that Parkin-dependent mitophagy is antagonized by prosurvival members of the Bcl-2 family (e.g., Bcl-xL and Mcl-1) in a Beclin-1-independent manner. Bcl-2 proteins suppressed mitophagy through inhibition of Parkin translocation to depolarized mitochondria.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Bcl-2 subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}, {start: {_id:1429}, end: {_id:1427}, properties:{evidence:"Here, we show that Parkin-dependent mitophagy is antagonized by prosurvival members of the Bcl-2 family (e.g., Bcl-xL and Mcl-1) in a Beclin-1-independent manner. Bcl-2 proteins suppressed mitophagy through inhibition of Parkin translocation to depolarized mitochondria.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Bcl-2 subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}, {start: {_id:309}, end: {_id:1427}, properties:{evidence:"Here, we show that Parkin-dependent mitophagy is antagonized by prosurvival members of the Bcl-2 family (e.g., Bcl-xL and Mcl-1) in a Beclin-1-independent manner. Bcl-2 proteins suppressed mitophagy through inhibition of Parkin translocation to depolarized mitochondria.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Bcl-2 subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}, {start: {_id:810}, end: {_id:1437}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Inhibition of Drp1 by overexpression of a dominant-negative mutant counteracts the conversion to a punctiform mitochondrial phenotype, prevents the loss of the mitochondrial membrane potential and the release of cytochrome c, and reveals a reproducible swelling of the organelles. Remarkably, inhibition of Drp1 blocks cell death, implicating mitochondrial fission as an important step in apoptosis.", citationTitle:"Dev Cell. 2001 Oct;1(4):515-25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"11703942", citationType:"PubMed", citationRef:"11703942"}}, {start: {_id:1445}, end: {_id:313}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interactions of pink1 and parkin with genes regulating mitochondrial fusion and fission. Mitochondrial fusion requires Mfn and Opa1, and mitochondrial fission requires Drp1 and Fis1. Pink1 and Parkin promote fission and/or inhibit fusion, either directly or indirectly (dashed lines). In addition, Pink1 and Parkin are unlikely to be components of the canonical pathways regulating mitochondrial dynamics. Rather, Pink1 and Parkin may regulate other mitochondrial functions that also impact mitochondrial integrity.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1446}, end: {_id:313}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interactions of pink1 and parkin with genes regulating mitochondrial fusion and fission. Mitochondrial fusion requires Mfn and Opa1, and mitochondrial fission requires Drp1 and Fis1. Pink1 and Parkin promote fission and/or inhibit fusion, either directly or indirectly (dashed lines). In addition, Pink1 and Parkin are unlikely to be components of the canonical pathways regulating mitochondrial dynamics. Rather, Pink1 and Parkin may regulate other mitochondrial functions that also impact mitochondrial integrity.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1443}, end: {_id:1447}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of Mfn or opa1 or overexpression of drp1, rescues the phenotypes of muscle degeneration, cell death, and mitochondrial abnormalities in pink1 or parkin mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1443}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of Mfn or opa1 or overexpression of drp1, rescues the phenotypes of muscle degeneration, cell death, and mitochondrial abnormalities in pink1 or parkin mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1443}, end: {_id:1448}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of Mfn or opa1 or overexpression of drp1, rescues the phenotypes of muscle degeneration, cell death, and mitochondrial abnormalities in pink1 or parkin mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1469}, end: {_id:1427}, properties:{evidence:"the R275W mutation in RING1 of Parkin causes only a minor disturbance of Parkin recruitment to depolarized mitochondria but severely disrupts mitophagy, suggesting that recruitment and mitophagy can be experimentally disassociated.", citationTitle:"PLoS Biol. 2010 Jan 26;8(1):e1000298. doi: 10.1371/journal.pbio.1000298.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20126261", citationType:"PubMed", citationRef:"20126261"}}, {start: {_id:1472}, end: {_id:313}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Opa1 degradation by Oma1 may prevent fusion of damaged mitochondria with healthy mitochondria and be coupled to Pink1-mediated recruitment of Parkin to facilitate mitophagy.", citationTitle:"J Cell Biol. 2010 Nov 29;191(5):933-42. doi: 10.1083/jcb.201008084.", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondrial subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"21115803", citationType:"PubMed", citationRef:"21115803"}}, {start: {_id:1514}, end: {_id:303}, properties:{evidence:"the overproduction of TOMM22 or TOMM40 reversed mitochondrial clearance promoted by PINK1 and PARK2 after Î”Î¨ (A loss of mitochondrial transmembrane potential) loss.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Matrix metalloproteinase subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}, {start: {_id:1515}, end: {_id:303}, properties:{evidence:"the overproduction of TOMM22 or TOMM40 reversed mitochondrial clearance promoted by PINK1 and PARK2 after Î”Î¨ (A loss of mitochondrial transmembrane potential) loss.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Matrix metalloproteinase subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}, {start: {_id:1528}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"it is interesting that phosphorylation of T473 of HK2 by Akt has been recently shown to diminish the effects of oxidative stress. we propose that Akt-mediated recruitment of hexokinase to mitochondria is a general cell biological pathway that is of benefit to protect against oxidative stress, which is also a function ascribed to PINK1 both in neurons", citationTitle:"Hum Mol Genet. 2014 Jan 1;23(1):145-56. doi: 10.1093/hmg/ddt407. Epub 2013 Aug 19.", annotationSubgraph:["Energy metabolic subgraph"], pmid:"23962723", citationType:"PubMed", citationRef:"23962723"}}, {start: {_id:1531}, end: {_id:1427}, properties:{evidence:"we report that USP30, a deubiquitinase localized to mitochondria, antagonizes mitophagy driven by the ubiquitin ligase parkin (also known as PARK2) and protein kinase PINK1, which are encoded by two genes associated with Parkinson's disease.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1538}, end: {_id:303}, properties:{evidence:"Re-introduction of RNAi-resistant wild-type ratUSP30cDNA,but not the inactive rat USP30(C77S)mutant,prevented the rescue of mitochondrial degradation", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["10116"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1606}, end: {_id:1608}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental induction of ER-mitochondria interactions results in oxidative stress and impaired metabolic homeostasis, whereas downregulation of PACS-2 or IP3R1, proteins important for ER- mitochondria tethering or calcium transport, respectively, improves mitochondrial oxidative capacity and glucose metabolism in obese animals.", citationTitle:"Nat Med. 2014 Dec;20(12):1427-35. doi: 10.1038/nm.3735. Epub 2014 Nov 24.", annotationSubgraph:["Energy metabolic subgraph"], pmid:"25419710", citationType:"PubMed", citationRef:"25419710"}}, {start: {_id:1607}, end: {_id:1608}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental induction of ER-mitochondria interactions results in oxidative stress and impaired metabolic homeostasis, whereas downregulation of PACS-2 or IP3R1, proteins important for ER- mitochondria tethering or calcium transport, respectively, improves mitochondrial oxidative capacity and glucose metabolism in obese animals.", citationTitle:"Nat Med. 2014 Dec;20(12):1427-35. doi: 10.1038/nm.3735. Epub 2014 Nov 24.", annotationSubgraph:["Energy metabolic subgraph"], pmid:"25419710", citationType:"PubMed", citationRef:"25419710"}}, {start: {_id:1446}, end: {_id:1621}, properties:{evidence:"Loss-of-function mutations of the parkin gene, which encodes a ubiquitin-protein ligase, are a common cause of autosomal recessive juvenile parkinsonism (ARJP). Previous work has led to the identification of a number of Parkin substrates that implicate specific pathways in ARJP pathogenesis, including endoplasmic reticulum (ER) stress and cell cycle activation. To test the involvement of previously implicated pathways, as well as to identify novel pathways in ARJP pathogenesis, we are using genetic and genomic approaches to study Parkin function in the fruit fly Drosophila melanogaster. In previous work, we demonstrated that Drosophila parkin null mutants exhibit mitochondrial pathology and flight muscle degeneration. To further explore the mechanisms responsible for pathology in parkin mutants, we analyzed the transcriptional alterations that occur during muscle degeneration and performed a genetic screen for parkin modifiers. Results of these studies indicate that oxidative stress response components are induced in parkin mutants and that loss-of-function mutations in oxidative stress components enhance the parkin mutant phenotypes. Genes involved in the innate immune response are also induced in parkin mutants. In contrast, our studies did not reveal evidence for cell cycle or ER stress pathway induction in parkin mutants. These results suggest that oxidative stress and/or inflammation may play a fundamental role in the etiology of ARJP.", citationTitle:"Hum Mol Genet. 2005 Mar 15;14(6):799-811. Epub 2005 Feb 2.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15689351", citationType:"PubMed", citationRef:"15689351"}}, {start: {_id:1593}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, our results indicate that reductions in Tim17A afforded by stress-regulated translational attenuation provides a mechanism to adapt mitochondrial protein import and increase cellular stress resistance during pathologic insults.", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Transport related subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1660}, end: {_id:1426}, properties:{evidence:"The deubiquitinase USP15 antagonizes Parkin-mediated mitochondrial ubiquitination and mitophagy", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:1660}, end: {_id:1427}, properties:{evidence:"The deubiquitinase USP15 antagonizes Parkin-mediated mitochondrial ubiquitination and mitophagy", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:1660}, end: {_id:303}, properties:{evidence:"The deubiquitinase USP15 antagonizes Parkin-mediated mitochondrial ubiquitination and mitophagy", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:1660}, end: {_id:1427}, properties:{evidence:"Here, we show that ubiquitin-specific protease 15 (USP15), a deubiquitinating enzyme (DUB) widely expressed in brain and other organs, opposes Parkin-mediated mitophagy, while a panel of other DUBs and a catalytically inactive version of USP15 do not. Moreover, knockdown of USP15 rescues the mitophagy defect of PD patient fibroblasts with PARK2 mutations and decreased Parkin levels. USP15 does not affect the ubiquitination status of Parkin or Parkin translocation to mitochondria, but counteracts Parkin-mediated mitochondrial ubiquitination. Knockdown of the DUB CG8334, the closest homolog of USP15 in Drosophila, largely rescues the mitochondrial and behavioral defects of parkin RNAi flies. These data identify USP15 as an antagonist of Parkin and suggest that USP15 inhibition could be a therapeutic strategy for PD cases caused by reduced Parkin levels.", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:1660}, end: {_id:1427}, properties:{evidence:"USP15 inhibits Parkin-mediated mitophagy through its DUB activity", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:1668}, end: {_id:1672}, properties:{evidence:"These findings suggest that SKN-1 may control mitophagy through regulation of dct-1 transcription. Indeed, skn-1 knockdown impairs mitochondrial network morphology, causes mitochondrial membrane depolarization and increases cytoplasmic Ca2+ concentration (Fig. 4dâ€“f and Extended Data Fig. 10g), similarly to DCT-1 deficiency.", citationTitle:"Nature. 2015 May 28;521(7553):525-8. doi: 10.1038/nature14300. Epub 2015 Apr 20.", annotationSubgraph:["Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"25896323", citationType:"PubMed", citationRef:"25896323"}}, {start: {_id:1679}, end: {_id:1683}, properties:{evidence:"In yeast, similar mutations in the orthologous AAC2 (also known as PET9) gene cause protein misfolding, followed by severe mitochondrial damage and ageing-dependent degenerative cell death", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationSubgraph:["Mitochondrial subgraph"], annotationSpecies:["4932"], annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:634}, end: {_id:1709}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pink1 deficient mice reveal impaired dopamine release (Kitada et al, 2007), deficient mitochondrial respiration and increased sensitivity to oxidative stress (Gautier et al, 2008), while overexpression and loss of function studies suggest an anti-apoptotic activity for PINK1 (Deng et al, 2005; Lin & Kang, 2008; Petit et al, 2005).", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1721}, end: {_id:578}, properties:{evidence:"We used previously characterized pink1 mutant flies (Park et al, 2006), which display motor disturbances and structural changes of mitochondria.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1724}, end: {_id:1725}, properties:{evidence:"However, when pink1 mutants were stimulated at a higher and more intense frequency of 10 Hz, a small but significant progressive decline in synaptic transmission (Fig 1I) was observed. This might be caused by reduced endocytosis and inefficient replenishment of the cycling vesicle pool (ECP) or, alternatively, by defects in the utilization of the reserve pool (RP) that becomes mobilized only during high frequency stimulation", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Synaptic Vesicles"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:221}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recently, in vitro studies of the PD-related proteins Parkin and PINK1 have found that these factors act in a common pathway to promote the selective autophagic degradation of damaged mitochondria (mitophagy).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:221}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recent research points to two PD-associated proteins as essential mediators of selective autophagic mitochondrial degradation: phosphatase and tensin homolog-induced putative kinase 1 (PINK1), a mitochondrially targeted serine/threonine kinase, and Parkin, a cytosolic E3 ubiquitin ligase.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph", "Autophagy signaling subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:271}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recent research points to two PD-associated proteins as essential mediators of selective autophagic mitochondrial degradation: phosphatase and tensin homolog-induced putative kinase 1 (PINK1), a mitochondrially targeted serine/threonine kinase, and Parkin, a cytosolic E3 ubiquitin ligase.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph", "Autophagy signaling subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1520}, end: {_id:1762}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Because Atg5/Atg7-dependent autophagy acts downstream from Parkin (10, 28) and also mediates nonselective forms of mitochondrial degradation (29), we hypoth- esized that Atg7 null mutants would have a deficit in mitochondrial protein turnover similar to, but more severe than, the deficit in parkin null mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Autophagy signaling subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:271}, end: {_id:1762}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Because Atg5/Atg7-dependent autophagy acts downstream from Parkin (10, 28) and also mediates nonselective forms of mitochondrial degradation (29), we hypoth- esized that Atg7 null mutants would have a deficit in mitochondrial protein turnover similar to, but more severe than, the deficit in parkin null mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:810}, end: {_id:1774}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These effects were abolished by overproduction of the fission- promiting dynamin-related protein 1 (Drp1).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fission subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1418}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, LC3-positive autophagic vesicles and immunoreactivity to the autophagic adaptor SQSTM1/p62 were rarely associated with mitochondrial clusters in cells coproducing HSD17B10 and Parkin, indicating an absence of mitophagy in these cells", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitophagy subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:221}, end: {_id:1837}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Inhibiting the translation repressors rescued nRCC mRNA translation and neuromuscular-degeneration phenotypes of PINK1 mutant, whereas inhibiting eIF4G had opposite effects.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1881}, end: {_id:1809}, properties:{evidence:"Depletion or hypomorphic mutation of AIF caused a downregulation of CHCHD4 protein by diminishing its mitochondrial import.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1879}, properties:{annotationCondition:["Normal Healthy State"], evidence:"As shown here, there are several lines of evidence that place CHCHD4 in the pathway linking AIF deficiency to the defi- cient biogenesis of respiratory chain complexes.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:271}, end: {_id:772}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we show that parkin is not only a stress-protective, but also a stress-inducible protein.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Vice versa, ER stress results in mitochondrial damage, which can be prevented by parkin", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1580}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"c-Jun suppresses the upregulation of parkin after ER stress.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin protects cells from ER stressinduced cell death.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Conceptually, upregulation of parkin in response to ER stress might help to preserve cellular function and survival within the adaptive phase of the UPR.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The experiments described above established a protective role of parkin in response to ER stress.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin interferes with ER stress-induced mitochondrial damage.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Obviously, parkin does not reduce ER stress per se, but it can protect cells from ER stress-induced cell death.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1642}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"An essential role for ATF4 in the regulation of parkin expression was substantiated by the following observations: First, a dominant- negative ATF4 mutant prevented ER stress-induced upregulation of parkin.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "Unfolded protein response subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We observed that proteasome dysfunction does not impair the ability of parkin to prevent ER stress-induced cell death.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:396}, properties:{evidence:"at this interplay, parkin seems to enter the stage, preventing the pathophysiological consequences of ER stress on mitochondrial integrity", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Upregulation of parkin mRNA and protein levels has been proposed as protective mechanism against mitochondrial and endoplasmic reticulum (ER) stress.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:2006}, end: {_id:112}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our study indicates that astrocytic DRD2 activation normally suppresses neuroinflammation in the central nervous system through a CRYAB-dependent mechanism, and provides a new strategy for targeting the astrocyte-mediated innate immune response in the central nervous system during ageing and disease.", citationTitle:"Nature. 2013 Feb 7;494(7435):90-4. doi: 10.1038/nature11748. Epub 2012 Dec 16.", annotationSubgraph:["Chaperone subgraph", "Innate immune system subgraph"], annotationCell:["astrocyte"], pmid:"23242137", citationType:"PubMed", citationRef:"23242137"}}, {start: {_id:196}, end: {_id:2024}, properties:{evidence:"We showed that LRRK2 mutations increase the inhibition of an endogenous peroxidase by phosphorylation promoting dysregulation of mitochondrial function and oxidative damage.", citationTitle:"Hum Mutat. 2011 Dec;32(12):1390-7. doi: 10.1002/humu.21582. Epub 2011 Sep 12.", annotationSubgraph:["LRRK2 subgraph"], pmid:"21850687", citationType:"PubMed", citationRef:"21850687"}}, {start: {_id:1135}, end: {_id:1223}, properties:{evidence:"Promoting adult hippocampal neurogenesis is expected to induce neuroplastic changes that improve mood and alleviate anxiety. Here we show that mice lacking Jnk1, or c-Jun N-terminal kinase (JNK) inhibitor-treated mice, display increased neurogenesis in adult hippocampus characterized by enhanced cell proliferation and survival, and increased maturation in the ventral region. Correspondingly, anxiety behaviour is reduced in a battery of tests, except when neurogenesis is prevented by AraC treatment.", citationTitle:"Mol Psychiatry. 2016 Nov 15. doi: 10.1038/mp.2016.203", annotationSubgraph:["MAPK subgraph"], pmid:"27843149", citationType:"PubMed", citationRef:"27843149"}}, {start: {_id:2118}, end: {_id:2146}, properties:{evidence:"Recently, it has been shown that TREM2 is expressed on macrophages infiltrating CNS tissue from the circulation, and that TREM2 acts to inhibit cytokine production by macrophages in response to several toll like receptor ligands [XREF_BIBR].", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"17425404", citationType:"PubMed", citationRef:"17425404"}}, {start: {_id:2118}, end: {_id:2146}, properties:{evidence:"One of these genes is the microglia associated triggering receptor expressed on myeloid cells (TREM2) which enhances phagocytosis, but abrogates cytokine production as well as TLR and Fc receptor mediated induction of TNF secretion.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"18551625", citationType:"PubMed", citationRef:"18551625"}}, {start: {_id:56}, end: {_id:2221}, properties:{evidence:"These findings suggest that a reduction in the levels of IGF-1R induces a defective glandular homeostasis in the submandibular gland epithelial cells and triggers EAS.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"11693172", citationType:"PubMed", citationRef:"11693172"}}] AS row
