UNWIND [{start: {_id:442}, end: {_id:439}, properties:{annotationCondition:["Normal Healthy State"], evidence:"For instance, PP2A enzyme but not PP1 is shown to dephosphorylate alpha-syn-pS129 in vitro , and treatment of cells with the PP2A inhibitor okadaic acid (OA) but not the PP1 inhibitor tautomycin leads to an increased level of alpha-syn-pS129.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Cell cycle subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:445}, end: {_id:446}, properties:{annotationCondition:["Normal Healthy State"], evidence:". Accordingly, treatment of mice with the PME inhibitor eicosanoyl-5-hydroxytryptamide (EHT) increases PP2A methylation as well as decreased alpha-syn-pS129 levels in brain and a concurrent reduction in synuclein pathology", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph", "Cell cycle subgraph"], annotationMeshanatomy:["Brain"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:445}, end: {_id:441}, properties:{annotationCondition:["Normal Healthy State"], evidence:". Accordingly, treatment of mice with the PME inhibitor eicosanoyl-5-hydroxytryptamide (EHT) increases PP2A methylation as well as decreased alpha-syn-pS129 levels in brain and a concurrent reduction in synuclein pathology", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph", "Cell cycle subgraph"], annotationMeshanatomy:["Brain"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:447}, end: {_id:441}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Related to this, the diabetes drug metformin was shown to reduce alpha-syn phosphorylation at S129 through activation of PP2A and inhibition of mammalian target of rapamycin .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph", "Cell cycle subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:447}, end: {_id:448}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Related to this, the diabetes drug metformin was shown to reduce alpha-syn phosphorylation at S129 through activation of PP2A and inhibition of mammalian target of rapamycin .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph", "Cell cycle subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:571}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is likely that the maintenance of the BBB and the NVU will decrease the accumulation of Lewy bodies, alpha-synuclein fibrils and ROS that worsen the effects of PD", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:867}, end: {_id:870}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Using mass spectroscopy, we found that Cox7c, a nuclear-encoded subunit of the mitochondrial enzyme cytochrome oxidase, is up- regulated in the striatum of male but not female mice after receiving a single dose of caffeine. The expression of two other Cox subunits, Cox1 and Cox4, was also stimulated by caffeine in a male-specific fashion. Overall, these findings indicate that cytochrome oxidase is a metabolic target of caffeine and that stimulation of Cox activity by caffeine via blockade of A2AR signaling may be an important mechanism underlying the therapeutic benefits of caffeine in PD.", citationTitle:"Mol Pharmacol. 2008 Sep;74(3):673-84. doi: 10.1124/mol.108.046888. Epub 2008 Jun 26.", annotationMeshanatomy:["Corpus Striatum"], pmid:"18583456", citationType:"PubMed", citationRef:"18583456"}}, {start: {_id:882}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that curcumin protected against A53T √é¬±-synuclein-induced cell death in a dose-dependent manner, suggesting that curcumin may be a candidate neuroprotective agent for A53T √Ö‚Äô√Ç¬±-synuclein-linked Parkinsonism, and possibly for other genetic or sporadic forms of PD.", citationTitle:"Pharmacol Res. 2011 May;63(5):439-44. doi: 10.1016/j.phrs.2011.01.004. Epub 2011 Jan 12.", annotationSubgraph:["Synuclein subgraph"], pmid:"21237271", citationType:"PubMed", citationRef:"21237271"}}, {start: {_id:445}, end: {_id:427}, properties:{annotationCondition:["Normal Healthy State"], evidence:". Accordingly, treatment of mice with the PME inhibitor eicosanoyl-5-hydroxytryptamide (EHT) increases PP2A methylation as well as decreased alpha-syn-pS129 levels in brain and a concurrent reduction in synuclein pathology", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Brain"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:447}, end: {_id:427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Related to this, the diabetes drug metformin was shown to reduce alpha-syn phosphorylation at S129 through activation of PP2A and inhibition of mammalian target of rapamycin .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:959}, end: {_id:955}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Dexamethasone, a glucocorticoid hormone receptor agonist, upregulated both protein and mRNA levels of TREK-1 leading to decreased NSC proliferation which could be reversed by bupivacaine. Fluoxetine, a serotonin reuptake inhibitor antidepressant that has been previously found to inhibit TREK-1 channels, robustly, could attenuate the upregulation of TREK-1 expression and the inhibition of NSC proliferation induced by dexamethasone.", citationTitle:"Psychopharmacology (Berl). 2011 Apr;214(3):747-59. doi: 10.1007/s00213-010-2077-3. Epub 2010 Nov 11.", annotationSubgraph:["Transport related subgraph"], pmid:"21069514", citationType:"PubMed", citationRef:"21069514"}}, {start: {_id:1005}, end: {_id:1009}, properties:{evidence:"From the known regulatory mechanisms of Arc expression, HFD reduced N-methyl-D-aspartate receptor (NMDAR) activity, as seen by decreases in tyrosine phosphorylation of NMDAR2A and levels of NMDAR1. Additionally, we demonstrated that 27-hydroxycholesterol, a cholesterol metabolite that enters the brain from the blood, decreases Arc levels as well as NMDAR and Src kinase activities in rat primary hippocampal neurons. Finally, we showed that Arc levels are decreased in the cortex of AD brains. We propose that one of the mechanisms, by which hypercholesterolemia contributes to neurodegenerative diseases, could be through Arc down-regulation caused by 27-hydroxycholesterol.", citationTitle:"Brain Pathol. 2009 Jan;19(1):69-80. doi: 10.1111/j.1750-3639.2008.00174.x. Epub 2008 May 23.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["10116"], annotationMeshdisease:["Alzheimer Disease"], annotationMeshanatomy:["Hippocampus"], pmid:"18503570", citationType:"PubMed", citationRef:"18503570"}}, {start: {_id:1324}, end: {_id:231}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Vorinostat (suberoylanilide hydroxamic acid (SAHA)), another notable hydroxamate based compound is the most clinically advanced HDACI. Moreover it was also shown that vorinostat completely inhibited the caspase-3 activation induced by MPP+ in MES23.5 cells indicating the inhibition of apoptosis in these dopaminergic cells.", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Caspase subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1325}, end: {_id:231}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Histone hyperacetylation by valproate has hence been seen to increase transcription of endogenous âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±Syn and the neuroprotective agent HSP70, as well as downregulate caspase-3 and hence reduce apoptosis.", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Caspase subgraph"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1326}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"phenylbutyrate exerts neuroprotective efficacy in the MPTP mouse model of PD.phenylbutyrate stringently up-regulates the DJ-1 protein and protects dopaminergic neurons from death.phenylbutyrate was able to reduce aggregation of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±Syn and prevent deterioration of motor symptoms and cognitive decline", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Synuclein subgraph"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1249}, end: {_id:1363}, properties:{evidence:"In two different models of MPTP-induced PD, dopamine depletion was associated with a reduction in H3K4me3 in striatal histones, whereas chronic levodopa therapy leads to deacetylation of histones H4K5, K8, K12, and K16.", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. 