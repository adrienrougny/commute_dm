UNWIND [{start: {_id:422}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Translationally repressed nRCC mRNAs are localized in a PINK1/Tom20- dependent manner to mitochondrial outer membrane, where they are derepressed and activated by PINK1/Parkin through displacement of translation repressors, including Pumilio and Glorund/ hnRNP-F, a Parkin substrate, and enhanced binding of activators such as eIF4G.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1840}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Translationally repressed nRCC mRNAs are localized in a PINK1/Tom20- dependent manner to mitochondrial outer membrane, where they are derepressed and activated by PINK1/Parkin through displacement of translation repressors, including Pumilio and Glorund/ hnRNP-F, a Parkin substrate, and enhanced binding of activators such as eIF4G.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1841}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Translationally repressed nRCC mRNAs are localized in a PINK1/Tom20- dependent manner to mitochondrial outer membrane, where they are derepressed and activated by PINK1/Parkin through displacement of translation repressors, including Pumilio and Glorund/ hnRNP-F, a Parkin substrate, and enhanced binding of activators such as eIF4G.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1839}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Translationally repressed nRCC mRNAs are localized in a PINK1/Tom20- dependent manner to mitochondrial outer membrane, where they are derepressed and activated by PINK1/Parkin through displacement of translation repressors, including Pumilio and Glorund/ hnRNP-F, a Parkin substrate, and enhanced binding of activators such as eIF4G.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:422}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Translationally repressed nRCC mRNAs are localized in a PINK1/Tom20- dependent manner to mitochondrial outer membrane, where they are derepressed and activated by PINK1/Parkin through displacement of translation repressors, including Pumilio and Glorund/ hnRNP-F, a Parkin substrate, and enhanced binding of activators such as eIF4G.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1840}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Translationally repressed nRCC mRNAs are localized in a PINK1/Tom20- dependent manner to mitochondrial outer membrane, where they are derepressed and activated by PINK1/Parkin through displacement of translation repressors, including Pumilio and Glorund/ hnRNP-F, a Parkin substrate, and enhanced binding of activators such as eIF4G.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1841}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Translationally repressed nRCC mRNAs are localized in a PINK1/Tom20- dependent manner to mitochondrial outer membrane, where they are derepressed and activated by PINK1/Parkin through displacement of translation repressors, including Pumilio and Glorund/ hnRNP-F, a Parkin substrate, and enhanced binding of activators such as eIF4G.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1850}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin Cooperates with PINK1 to Promote hnRNP-F/Glo Ubiquitination and nRCC mRNA Translation", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This association raised the possibility that Parkin may mediate the effect of PINK1 in recruiting Pum to mito. Contrary to this expectation, mito-bound Pum was increased in parkin mutant (Figure S7A), suggesting that not only is Parkin not required for the MOM local- ization of Pum, it may act at a later step to displace Pum from MOM-localized nRCC mRNAs to relieve translational repression.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1845}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This association raised the possibility that Parkin may mediate the effect of PINK1 in recruiting Pum to mito. Contrary to this expectation, mito-bound Pum was increased in parkin mutant (Figure S7A), suggesting that not only is Parkin not required for the MOM local- ization of Pum, it may act at a later step to displace Pum from MOM-localized nRCC mRNAs to relieve translational repression.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events", "PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1839}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"First, Glo RNAi effectively rescued PINK1 mutant (Figures 6Eâ€“6J), whereas Glo OE had opposite effect", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1850}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interestingly, in PINK1 mutant expressing a phospho-mimetic, but not a nonphosphorylatable form of Parkin with the PINK1 phosphorylation site mutated (Shiba-Fukushima et al., 2014),Glo ubiquitination was restored (Figure S7G), indicating that PINK1 acts through Parkin to regulate Glo ubiqui- tination.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1850}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Ubiquitination of hnRNP-F by PINK1/Parkin was also observed in mammalian cells, in which the WT (Parkin-WT) or phosphomimetic (Parkin-S65E), but not E3-dead (Parkin- C431S) or nonphosphorylatable (Parkin-S65A) forms of Parkin, induced hnRNP-F monoubiquitination", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1850}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Ubiquitination of hnRNP-F by PINK1/Parkin was also observed in mammalian cells, in which the WT (Parkin-WT) or phosphomimetic (Parkin-S65E), but not E3-dead (Parkin- C431S) or nonphosphorylatable (Parkin-S65A) forms of Parkin, induced hnRNP-F monoubiquitination", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1852}, end: {_id:1850}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Ubiquitination of hnRNP-F by PINK1/Parkin was also observed in mammalian cells, in which the WT (Parkin-WT) or phosphomimetic (Parkin-S65E), but not E3-dead (Parkin- C431S) or nonphosphorylatable (Parkin-S65A) forms of Parkin, induced hnRNP-F monoubiquitination", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1854}, end: {_id:1850}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Ubiquitination of hnRNP-F by PINK1/Parkin was also observed in mammalian cells, in which the WT (Parkin-WT) or phosphomimetic (Parkin-S65E), but not E3-dead (Parkin- C431S) or nonphosphorylatable (Parkin-S65A) forms of Parkin, induced hnRNP-F monoubiquitination", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1856}, end: {_id:1850}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Ubiquitination of hnRNP-F by PINK1/Parkin was also observed in mammalian cells, in which the WT (Parkin-WT) or phosphomimetic (Parkin-S65E), but not E3-dead (Parkin- C431S) or nonphosphorylatable (Parkin-S65A) forms of Parkin, induced hnRNP-F monoubiquitination", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1839}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These data support that Glo/hnRNP-F is a direct substrate mediating the effect of PINK1/Parkin on nRCC mRNA translation.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1850}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Fourth, PINK1 and Parkin promote monoubiquitination of hnRNP-F/Glo to displace hnRNP- F/Glo and other repressors from nRCC mRNAs. hnRNPs function in distinct RNP complexes to control broad aspects of RNA physiology", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1850}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Fourth, PINK1 and Parkin promote monoubiquitination of hnRNP-F/Glo to displace hnRNP- F/Glo and other repressors from nRCC mRNAs. hnRNPs function in distinct RNP complexes to control broad aspects of RNA physiology", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events", "PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}] AS row
