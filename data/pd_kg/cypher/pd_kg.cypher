UNWIND [{start: {_id:641}, end: {_id:16}, properties:{evidence:"The mutation was associated with abnormal transcripts and marked reduced DNAJC6 mRNA level.", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:1055}, end: {_id:1059}, properties:{evidence:"By enhancing their GTPase activity, GAP proteins inactivate small Rho and Ras proteins, so inactivation of rhoGAP proteins might cause constitutive activation of their GTPase targets.", citationTitle:"Nature. 1998 Apr 30;392(6679):923-6.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationMeshdisease:["Mental Retardation, X-Linked"], pmid:"9582072", citationType:"PubMed", citationRef:"9582072"}}, {start: {_id:1105}, end: {_id:16}, properties:{evidence:"In the SN, we found downregulation of 5alpha-reductase type 1 (5alpha-R1), sulfotransferase 2B1 (SULT2B1) and some GABA-A receptor subunits (alpha4, beta1) while in the CN, upregulation of 3alpha- hydroxysteroid dehydrogenase type 3 (3alpha-HSD3) and alpha4 GABA-A receptor subunit (22-fold) was observed.", citationComment:"Neurosteroid biosynthetic pathway changes in substantia nigra and caudate nucleus in Parkinson's disease.", citationTitle:"Brain pathology (Zurich, Switzerland); Vol. 20; Iss. 5", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], citationPubDate:"2010-09-01", pmid:"20406233", citationAuthorList:"Sabina Luchetti|Koen Bossers|Giovanni Vanni Frajese|Dick F Swaab", citationType:"PubMed", citationRef:"20406233"}}, {start: {_id:1106}, end: {_id:16}, properties:{evidence:"In the SN, we found downregulation of 5alpha-reductase type 1 (5alpha-R1), sulfotransferase 2B1 (SULT2B1) and some GABA-A receptor subunits (alpha4, beta1) while in the CN, upregulation of 3alpha- hydroxysteroid dehydrogenase type 3 (3alpha-HSD3) and alpha4 GABA-A receptor subunit (22-fold) was observed.", citationComment:"Neurosteroid biosynthetic pathway changes in substantia nigra and caudate nucleus in Parkinson's disease.", citationTitle:"Brain pathology (Zurich, Switzerland); Vol. 20; Iss. 5", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], citationPubDate:"2010-09-01", pmid:"20406233", citationAuthorList:"Sabina Luchetti|Koen Bossers|Giovanni Vanni Frajese|Dick F Swaab", citationType:"PubMed", citationRef:"20406233"}}, {start: {_id:1107}, end: {_id:16}, properties:{evidence:"In the SN, we found downregulation of 5alpha-reductase type 1 (5alpha-R1), sulfotransferase 2B1 (SULT2B1) and some GABA-A receptor subunits (alpha4, beta1) while in the CN, upregulation of 3alpha- hydroxysteroid dehydrogenase type 3 (3alpha-HSD3) and alpha4 GABA-A receptor subunit (22-fold) was observed.", citationComment:"Neurosteroid biosynthetic pathway changes in substantia nigra and caudate nucleus in Parkinson's disease.", citationTitle:"Brain pathology (Zurich, Switzerland); Vol. 20; Iss. 5", annotationSubgraph:["GABA subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], citationPubDate:"2010-09-01", pmid:"20406233", citationAuthorList:"Sabina Luchetti|Koen Bossers|Giovanni Vanni Frajese|Dick F Swaab", citationType:"PubMed", citationRef:"20406233"}}, {start: {_id:1108}, end: {_id:16}, properties:{evidence:"In the SN, we found downregulation of 5alpha-reductase type 1 (5alpha-R1), sulfotransferase 2B1 (SULT2B1) and some GABA-A receptor subunits (alpha4, beta1) while in the CN, upregulation of 3alpha- hydroxysteroid dehydrogenase type 3 (3alpha-HSD3) and alpha4 GABA-A receptor subunit (22-fold) was observed.", citationComment:"Neurosteroid biosynthetic pathway changes in substantia nigra and caudate nucleus in Parkinson's disease.", citationTitle:"Brain pathology (Zurich, Switzerland); Vol. 20; Iss. 5", annotationSubgraph:["GABA subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], citationPubDate:"2010-09-01", pmid:"20406233", citationAuthorList:"Sabina Luchetti|Koen Bossers|Giovanni Vanni Frajese|Dick F Swaab", citationType:"PubMed", citationRef:"20406233"}}, {start: {_id:1112}, end: {_id:16}, properties:{evidence:"Genotyping assays were used to screen for polymorphisms in the GRIN1 (rs2301364 T>C, rs28489906 T>C, and rs4880213 T>C) and GRIN2B (C366G, C2664T, and rs1805476 T>G) genes, and logistic regression analysis was then used to assess the association between these single nucleotide polymorphisms (SNPs) and PD susceptibility.", citationComment:"Association analysis of GRIN1 and GRIN2B polymorphisms and Parkinson's disease in a hospital-based case-control study.", citationTitle:"Neuroscience letters; Vol. 478; Iss. 2", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2010-07-05", pmid:"20438806", citationAuthorList:"Shey-Lin Wu|Wen-Fu Wang|Hann-Yeh Shyu|Ying-Jui Ho|Jia-Ching Shieh|Yi-Ping Fu|Shwu-Tzy Wu|Chun-Wen Cheng", citationType:"PubMed", citationRef:"20438806"}}, {start: {_id:1292}, end: {_id:16}, properties:{evidence:"In the slower progression of neurodegeneration, we identified several important features in common with the pathogenesis of Parkinson's disease, such as phosphorylation of alpha-synuclein at Ser129 and activation of caspase-9.", citationTitle:"J Neurochem. 2004 Oct;91(2):451-61.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"15447678", citationType:"PubMed", citationRef:"15447678"}}, {start: {_id:1293}, end: {_id:16}, properties:{evidence:"In the slower progression of neurodegeneration, we identified several important features in common with the pathogenesis of Parkinson's disease, such as phosphorylation of alpha-synuclein at Ser129 and activation of caspase-9.", citationTitle:"J Neurochem. 2004 Oct;91(2):451-61.", annotationSubgraph:["Caspase subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"15447678", citationType:"PubMed", citationRef:"15447678"}}, {start: {_id:506}, end: {_id:16}, properties:{evidence:"We present evidence of reduction of nuclear Dnmt1 levels in human postmortem brain samples from PD", citationTitle:"J Biol Chem. 2011 Mar 18;286(11):9031-7. doi: 10.1074/jbc.C110.212589. Epub 2011 Feb 4", annotationSubgraph:["Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21296890", citationType:"PubMed", citationRef:"21296890"}}, {start: {_id:271}, end: {_id:16}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"Parkin is an ubiquitin E3 ligase that plays an important role in the pathogenesis of PD. Not only does parkin play a role in AR-PD, it seems to play important roles in the pathogenesis of sporadic PD as it is inactivated in sporadic PD due to nitrosative, oxidative and dopaminergic stress. Parkin is multi-functional E3 ligase that is capable of different ubiquitin modifications including monoubiquitination and polyubiquitination via lysine-48 or lysine-63 chains. Inactivation of Parkin, an E3 ubiquitin ligase, through nitrosative and oxidative stress may play a pathogenic role in sporadic PD", citationTitle:"Mov Disord. 2010;25 Suppl 1:S32-9. doi: 10.1002/mds.22798.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"20187240", citationType:"PubMed", citationRef:"20187240"}}, {start: {_id:1373}, end: {_id:16}, properties:{evidence:"It has been shown that expression of Nurr1 is significantly reduced in patients affected with PD", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSubgraph:["Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neostriatum"], pmid:"21892731", citationType:"PubMed", citationRef:"21892731"}}, {start: {_id:1374}, end: {_id:16}, properties:{evidence:"cocaine consumption decreases Nurr1 expression in dopamine neurons. In addition, in the dopamine neurons of Nurr1- deficient cocaine abusers, the expression of the dopamine transporter (DAT) is significantly decreased. DATs, which are located in the membrane of dopaminergic neurons in the SNpc, are strikingly reduced in PD likely due to degeneration of these cells", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSubgraph:["Transport related subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"21892731", citationType:"PubMed", citationRef:"21892731"}}, {start: {_id:1404}, end: {_id:16}, properties:{evidence:"The neurotoxin 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP) impairs mitochondrial respiration and damages dopaminergic neurons as seen in Parkinson's disease (PD). Here, we report that L-3-hydroxyacyl-CoA dehydrogenase type II/amyloid binding alcohol dehydrogenase (HADH II/ABAD), a mitochondrial oxidoreductase enzyme involved in neuronal survival, is downregulated in PD patients and in MPTP-intoxicated mice.", citationTitle:"Ann Neurol. 2004 Jul;56(1):51-60.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15236401", citationType:"PubMed", citationRef:"15236401"}}, {start: {_id:1404}, end: {_id:16}, properties:{evidence:"In recent years, it has emerged as an important stress and pathological marker in neurons and glial cells (expression down- regulation in Parkinson's disease, up-regulation and association with beta-amyloid peptide in Alzheimer's disease).", citationTitle:"J Am Chem Soc. 2007 Nov 21;129(46):14518-22. Epub 2007 Oct 25.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Microglia", "Neurons"], pmid:"17958419", citationType:"PubMed", citationRef:"17958419"}}, {start: {_id:1531}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Knockdown of USP30 in dopaminergic neurons protects flies against paraquat toxicity in vivo, ameliorating defects in dopamine levels, motor function and organismal survival. Thus USP30 inhibition is potentially beneficial for Parkinson's disease by promoting mitochondrial clearance and quality control.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1679}, end: {_id:1680}, properties:{evidence:"ANT1 (also known as SLC25A4) encodes adenine nucleotide translocase involved in ATP/ADP exchange across the mitochondrial inner membrane. Mutations in the human ANT1 gene cause autosomal dominant progressive external ophthalmoplegia, cardiomyopathy and myopathy.", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Cardiomyopathies", "Ophthalmoplegia"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1679}, end: {_id:1681}, properties:{evidence:"ANT1 (also known as SLC25A4) encodes adenine nucleotide translocase involved in ATP/ADP exchange across the mitochondrial inner membrane. Mutations in the human ANT1 gene cause autosomal dominant progressive external ophthalmoplegia, cardiomyopathy and myopathy.", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Cardiomyopathies", "Ophthalmoplegia"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1679}, end: {_id:1682}, properties:{evidence:"ANT1 (also known as SLC25A4) encodes adenine nucleotide translocase involved in ATP/ADP exchange across the mitochondrial inner membrane. Mutations in the human ANT1 gene cause autosomal dominant progressive external ophthalmoplegia, cardiomyopathy and myopathy.", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Cardiomyopathies", "Ophthalmoplegia"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:221}, end: {_id:16}, properties:{evidence:"However, a more suggestive link to mitochondrial dysfunction comes from studying genetic forms of PD, which taught that pathogenic mutations in the mitochondrial protein PINK1 are sufficient to cause the disease", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
