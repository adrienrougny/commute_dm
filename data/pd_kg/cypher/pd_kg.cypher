009.05.027. Epub 2009 Jun 3.", annotationSubgraph:["PINK1 subgraph"], pmid:"19500570", citationType:"PubMed", citationRef:"19500570"}}, {start: {_id:238}, end: {_id:245}, properties:{annotationCondition:["Normal Healthy State"], evidence:"mutations of PINK1 cause abnormal mitochondrial morphology, bioenergetic function and oxidative metabolism in human tissues but suggest that the biochemical consequences may vary between mutations.", citationTitle:"Exp Neurol. 2009 Sep;219(1):266-73. doi: 10.1016/j.expneurol.2009.05.027. Epub 2009 Jun 3.", annotationSubgraph:["PINK1 subgraph"], pmid:"19500570", citationType:"PubMed", citationRef:"19500570"}}, {start: {_id:240}, end: {_id:243}, properties:{annotationCondition:["Normal Healthy State"], evidence:"mutations of PINK1 cause abnormal mitochondrial morphology, bioenergetic function and oxidative metabolism in human tissues but suggest that the biochemical consequences may vary between mutations.", citationTitle:"Exp Neurol. 2009 Sep;219(1):266-73. doi: 10.1016/j.expneurol.2009.05.027. Epub 2009 Jun 3.", annotationSubgraph:["PINK1 subgraph"], pmid:"19500570", citationType:"PubMed", citationRef:"19500570"}}, {start: {_id:240}, end: {_id:244}, properties:{annotationCondition:["Normal Healthy State"], evidence:"mutations of PINK1 cause abnormal mitochondrial morphology, bioenergetic function and oxidative metabolism in human tissues but suggest that the biochemical consequences may vary between mutations.", citationTitle:"Exp Neurol. 2009 Sep;219(1):266-73. doi: 10.1016/j.expneurol.2009.05.027. Epub 2009 Jun 3.", annotationSubgraph:["PINK1 subgraph"], pmid:"19500570", citationType:"PubMed", citationRef:"19500570"}}, {start: {_id:240}, end: {_id:245}, properties:{annotationCondition:["Normal Healthy State"], evidence:"mutations of PINK1 cause abnormal mitochondrial morphology, bioenergetic function and oxidative metabolism in human tissues but suggest that the biochemical consequences may vary between mutations.", citationTitle:"Exp Neurol. 2009 Sep;219(1):266-73. doi: 10.1016/j.expneurol.2009.05.027. Epub 2009 Jun 3.", annotationSubgraph:["PINK1 subgraph"], pmid:"19500570", citationType:"PubMed", citationRef:"19500570"}}, {start: {_id:242}, end: {_id:243}, properties:{annotationCondition:["Normal Healthy State"], evidence:"mutations of PINK1 cause abnormal mitochondrial morphology, bioenergetic function and oxidative metabolism in human tissues but suggest that the biochemical consequences may vary between mutations.", citationTitle:"Exp Neurol. 2009 Sep;219(1):266-73. doi: 10.1016/j.expneurol.2009.05.027. Epub 2009 Jun 3.", annotationSubgraph:["PINK1 subgraph"], pmid:"19500570", citationType:"PubMed", citationRef:"19500570"}}, {start: {_id:242}, end: {_id:244}, properties:{annotationCondition:["Normal Healthy State"], evidence:"mutations of PINK1 cause abnormal mitochondrial morphology, bioenergetic function and oxidative metabolism in human tissues but suggest that the biochemical consequences may vary between mutations.", citationTitle:"Exp Neurol. 2009 Sep;219(1):266-73. doi: 10.1016/j.expneurol.2009.05.027. Epub 2009 Jun 3.", annotationSubgraph:["PINK1 subgraph"], pmid:"19500570", citationType:"PubMed", citationRef:"19500570"}}, {start: {_id:242}, end: {_id:245}, properties:{annotationCondition:["Normal Healthy State"], evidence:"mutations of PINK1 cause abnormal mitochondrial morphology, bioenergetic function and oxidative metabolism in human tissues but suggest that the biochemical consequences may vary between mutations.", citationTitle:"Exp Neurol. 2009 Sep;219(1):266-73. doi: 10.1016/j.expneurol.2009.05.027. Epub 2009 Jun 3.", annotationSubgraph:["PINK1 subgraph"], pmid:"19500570", citationType:"PubMed", citationRef:"19500570"}}, {start: {_id:238}, end: {_id:582}, properties:{evidence:"Fibroblasts and immortalized lymphoblasts from PD patients with G309D and W437X PINK1 mutations displayed lower respiratory activity, increased glycolysis and elevated levels of lipid peroxidation.", citationTitle:"Exp Neurol. 2009 Aug;218(2):235-46. doi: 10.1016/j.expneurol.2009.03.006. Epub 2009 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19303005", citationType:"PubMed", citationRef:"19303005"}}, {start: {_id:249}, end: {_id:582}, properties:{evidence:"Fibroblasts and immortalized lymphoblasts from PD patients with G309D and W437X PINK1 mutations displayed lower respiratory activity, increased glycolysis and elevated levels of lipid peroxidation.", citationTitle:"Exp Neurol. 2009 Aug;218(2):235-46. doi: 10.1016/j.expneurol.2009.03.006. Epub 2009 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19303005", citationType:"PubMed", citationRef:"19303005"}}, {start: {_id:271}, end: {_id:270}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"Parkin is an ubiquitin E3 ligase that plays an important role in the pathogenesis of PD. Not only does parkin play a role in AR-PD, it seems to play important roles in the pathogenesis of sporadic PD as it is inactivated in sporadic PD due to nitrosative, oxidative and dopaminergic stress. Parkin is multi-functional E3 ligase that is capable of different ubiquitin modifications including monoubiquitination and polyubiquitination via lysine-48 or lysine-63 chains. Inactivation of Parkin, an E3 ubiquitin ligase, through nitrosative and oxidative stress may play a pathogenic role in sporadic PD", citationTitle:"Mov Disord. 2010;25 Suppl 1:S32-9. doi: 10.1002/mds.22798.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"20187240", citationType:"PubMed", citationRef:"20187240"}}, {start: {_id:271}, end: {_id:1359}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"Parkin is an ubiquitin E3 ligase that plays an important role in the pathogenesis of PD. Not only does parkin play a role in AR-PD, it seems to play important roles in the pathogenesis of sporadic PD as it is inactivated in sporadic PD due to nitrosative, oxidative and dopaminergic stress. Parkin is multi-functional E3 ligase that is capable of different ubiquitin modifications including monoubiquitination and polyubiquitination via lysine-48 or lysine-63 chains. Inactivation of Parkin, an E3 ubiquitin ligase, through nitrosative and oxidative stress may play a pathogenic role in sporadic PD", citationTitle:"Mov Disord. 2010;25 Suppl 1:S32-9. doi: 10.1002/mds.22798.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"20187240", citationType:"PubMed", citationRef:"20187240"}}, {start: {_id:1515}, end: {_id:1427}, properties:{evidence:"Downregulation of TOMM40 triggers PARK2-dependent mitophagy", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Matrix metalloproteinase subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1531}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin ubiquitinates and tags damaged mitochondria for clearance. Overexpression of USP30 removes ubiquitin attached by parkin onto damaged mitochondria and blocks parkin's ability to drive mitophagy, whereas reducing USP30 activity enhances mitochondrial degradation in neurons. Global ubiquitination site profiling identified multiple mitochondrial substrates oppositely regulated by parkin and USP30.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1593}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Tim17A is a stress-sensitive subunit of the TIM23 protein import complex. Tim17A protein decreases in response to stress-regulated translation attenuation. Tim17A degradation requires the activity of the mitochondrial protease YME1L. Decreased Tim17A/Tim-17 is protective against oxidative stress", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Mitochondrial subgraph", "Transport related subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:634}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pink1 deficient mice reveal impaired dopamine release (Kitada et al, 2007), deficient mitochondrial respiration and increased sensitivity to oxidative stress (Gautier et al, 2008), while overexpression and loss of function studies suggest an anti-apoptotic activity for PINK1 (Deng et al, 2005; Lin & Kang, 2008; Petit et al, 2005).", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:634}, end: {_id:1716}, properties:{evidence:"Additionally, studies in Drosophila and in HeLa cells indicate that Pink1 deficiency leads to altered mitochondrial morphology", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:634}, end: {_id:1716}, properties:{evidence:"Absence of Pink1 and also deficiencies in Drp1, have been associated with alterations in mitochondrial morphology.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1718}, end: {_id:1716}, properties:{evidence:"Absence of Pink1 and also deficiencies in Drp1, have been associated with alterations in mitochondrial morphology.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:634}, end: {_id:1699}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 deficit results in reduced Complex I activity", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Apoptosis signaling subgraph", "PINK1 subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:221}, end: {_id:1716}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pum RNAi rescued the abnormal mito morphology caused by PINK1 inactivation", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:599}, end: {_id:2024}, properties:{evidence:"The increase in PRDX3 phosphorylation was associated with decreased peroxidase activity and increased death in LRRK2-expressing but not in LRRK2-depleted or vector-transfected neuronal cells.", citationTitle:"Hum Mutat. 2011 Dec;32(12):1390-7. doi: 10.1002/humu.21582. Epub 2011 Sep 12.", annotationSubgraph:["Cell cycle subgraph"], pmid:"21850687", citationType:"PubMed", citationRef:"21850687"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:16}, end: {_id:390}, properties:{evidence:"We have been working on the etiology and pathogenesis of PD for many years and we found selective loss of mitochondrial complex I and the alpha-ketoglutarate dehydrogenase complex in the nigral neurons of patients with PD", citationTitle:"Rinsho Shinkeigaku. 2004 Apr-May;44(4-5):241-62.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"15287506", citationType:"PubMed", citationRef:"15287506"}}, {start: {_id:16}, end: {_id:391}, properties:{evidence:"We have been working on the etiology and pathogenesis of PD for many years and we found selective loss of mitochondrial complex I and the alpha-ketoglutarate dehydrogenase complex in the nigral neurons of patients with PD", citationTitle:"Rinsho Shinkeigaku. 2004 Apr-May;44(4-5):241-62.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"15287506", citationType:"PubMed", citationRef:"15287506"}}, {start: {_id:16}, end: {_id:71}, properties:{evidence:"Previous studies have also shown that Akt activation induces trophic effects in murine models of PD and that phosphorylated Akt is depleted in brains of PD patients . Furthermore, activation of the PI3K/Akt pathway led to inactivation of GSK-3.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Akt/mTOR subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:437}, end: {_id:431}, properties:{evidence:"Indeed, pY125 appears to protect brains against alpha-syn mediated toxicity, as this modification is reduced in aged human brain tissue and absent in brain tissue affected by Lewy body dementia", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Dementia"], annotationMeshanatomy:["Brain"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:16}, end: {_id:574}, properties:{evidence:"EGF-Akt signaling occurs through EGFRs which are decreased in disease- related brain regions of patients with PD.", citationTitle:"Front Mol Neurosci. 2014 Jul 8;7:63. doi: 10.3389/fnmol.2014.00063. eCollection 2014.", annotationSubgraph:["Akt/mTOR subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25071440", citationType:"PubMed", citationRef:"25071440"}}, {start: {_id:16}, end: {_id:751}, properties:{evidence:"In Parkinson's disease local dysregulation of iron metabolism in the substantia nigra (SN) seems to be related to neurodegeneration with an increase in SN iron concentration, accompanied by decreased SN Cu and ceruloplasmin concentrations and increased free Cu concentrations and decreased ferroxidase activity in the cerebrospinal fluid.", citationTitle:"J Trace Elem Med Biol. 2014 Jun 2. pii: S0946-672X(14)00073-X. doi: 10.1016/j.jtemb.2014.05.007.", annotationSubgraph:["Transport related subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"24954801", citationType:"PubMed", citationRef:"24954801"}}, {start: {_id:580}, end: {_id:1182}, properties:{evidence:"These results suggest that parkinsonism associated with smaller FMR1 expansions may be related to mechanisms other than pre-synaptic dopaminergic changes and may represent a potential explanation for at least some parkinsonian cases with scans without evidence of dopaminergic deficits (SWEDD).", citationTitle:"Parkinsonism Relat Disord. 2010 Nov;16(9):608-11.", annotationSubgraph:["FMR1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20702130", citationType:"PubMed", citationRef:"20702130"}}, {start: {_id:16}, end: {_id:221}, properties:{evidence:"Here, we report that PINK1 regulates the E3 ubiquitin-protein ligase function of parkin through direct phosphorylation. We find that phosphorylation of parkin by PINK1 activates parkin E3 ligase function for catalyzing K63-linked polyubiquitination and enhances parkin- mediated ubiquitin signaling through the IkappaB kinase/nuclear factor kappaB (NF-kappaB) pathway. Furthermore, the ability of PINK1 to promote parkin phosphorylation and activate parkin-mediated ubiquitin signaling is impaired by PD-linked pathogenic PINK1 mutations. Our findings support a direct link between PINK1-mediated phosphorylation and parkin-mediated ubiquitin signaling and implicate the deregulation of the PINK1/parkin/NF-kappaB neuroprotective signaling pathway in the pathogenesis of PD.", citationTitle:"Hum Mol Genet. 2010 Jan 15;19(2):352-63. doi: 10.1093/hmg/ddp501. Epub 2009 Oct 30.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19880420", citationType:"PubMed", citationRef:"19880420"}}, {start: {_id:16}, end: {_id:271}, properties:{evidence:"Here, we report that PINK1 regulates the E3 ubiquitin-protein ligase function of parkin through direct phosphorylation. We find that phosphorylation of parkin by PINK1 activates parkin E3 ligase function for catalyzing K63-linked polyubiquitination and enhances parkin- mediated ubiquitin signaling through the IkappaB kinase/nuclear factor kappaB (NF-kappaB) pathway. Furthermore, the ability of PINK1 to promote parkin phosphorylation and activate parkin-mediated ubiquitin signaling is impaired by PD-linked pathogenic PINK1 mutations. Our findings support a direct link between PINK1-mediated phosphorylation and parkin-mediated ubiquitin signaling and implicate the deregulation of the PINK1/parkin/NF-kappaB neuroprotective signaling pathway in the pathogenesis of PD.", citationTitle:"Hum Mol Genet. 2010 Jan 15;19(2):352-63. doi: 10.1093/hmg/ddp501. Epub 2009 Oct 30.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19880420", citationType:"PubMed", citationRef:"19880420"}}, {start: {_id:16}, end: {_id:2116}, properties:{evidence:"Hypersecretion of CRF in the brain may contribute to the symptomatology seen in neuropsychiatric disorders, such as depression, anxiety-related disorders and anorexia nervosa. Furthermore, overproduction of CRF at peripheral inflammatory sites, such as synovial joints may contribute to autoimmune diseases such as rheumatoid arthritis. In contrast, deficits in brain CRF are apparent in neurodegenerative disorders, such as Alzheimer's disease, Parkinson's disease and Huntington's disease, as they relate to dysfunction of CRF neurons in the brain areas affected in the particular disorder. Strategies directed at developing CRF-related agents may hold promise for novel therapies for the treatment of these various disorders.", citationTitle:"Psychoneuroendocrinology. 1995;20(8):789-819.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["9606"], pmid:"8834089", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"8834089"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:411}, end: {_id:569}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is likely that the maintenance of the BBB and the NVU will decrease the accumulation of Lewy bodies, alpha-synuclein fibrils and ROS that worsen the effects of PD", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:515}, end: {_id:591}, properties:{evidence:"Considerable experimental evidence suggests that a significant contributor to dopaminergic neuronal loss in the PD brain is ROS, which result from dopamine metabolism, low glutathione (GSH), and high levels of iron and calcium in the SNpc.", citationTitle:"J Parkinsons Dis. 2013;3(4):461-91. doi: 10.3233/JPD-130230.", annotationSubgraph:["Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"24252804", citationType:"PubMed", citationRef:"24252804"}}, {start: {_id:737}, end: {_id:267}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The co-activation of the pentose-phosphate pathway (PPP), a shunt pathway of glycolysis, in astroglia plays a pivotal role in protecting neurons against ROS with glutathione peroxidase and the reduced form of glutathione (GSH).", citationTitle:"Brain and nerve = Shinkei kenky?? no shinpo; Vol. 65; Iss. 12", annotationSubgraph:["Energy metabolic subgraph", "Reactive oxygen species subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"24323934", citationType:"PubMed", citationRef:"24323934"}}, {start: {_id:737}, end: {_id:591}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The co-activation of the pentose-phosphate pathway (PPP), a shunt pathway of glycolysis, in astroglia plays a pivotal role in protecting neurons against ROS with glutathione peroxidase and the reduced form of glutathione (GSH).", citationTitle:"Brain and nerve = Shinkei kenky?? no shinpo; Vol. 65; Iss. 12", annotationSubgraph:["Energy metabolic subgraph", "Reactive oxygen species subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"24323934", citationType:"PubMed", citationRef:"24323934"}}, {start: {_id:1699}, end: {_id:1743}, properties:{evidence:"Loss of Complex I would result in the reduction of the mitochondrial electrochemical gradient, observed in our study, and therefore promote the opening of the voltage-dependent PTP, which can in turn cause increased cytochrome c release and cell death", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1930}, end: {_id:689}, properties:{evidence:"Glutamate excitotoxicity has been proposed to contribute to neuronal vulnerability in PD and other neurodegenerative disorders (Blandini, 2010; Mehta et al., 2013)", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1930}, end: {_id:267}, properties:{evidence:"Studies have shown NAC can prevent the effects of mitochondrially- produced ROS (Kulisz et al., 2002; Moreira et al., 2007; Seaton et al., 1997), and we show that NAC clearly reduced cellular ROS levels follow- ing glutamate.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:400}, end: {_id:267}, properties:{evidence:"Previous studies suggested that NLRP3 inflammasome activity is negatively regulated by autophagy and positively regulated by reactive oxygen species (ROS) derived from an uncharacterized organelle. Here we show that mitophagy/autophagy blockade leads to the accumulation of damaged, ROS-generating mitochondria, and this in turn activates the NLRP3 inflammasome.", citationTitle:"Nature. 2011 Jan 13;469(7329):221-5. doi:10.1038/nature09663. Epub 2010 Dec 1. Erratum in: Nature. 2011 Jul 7;475(7354):122.", annotationSubgraph:["Reactive oxygen species subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21124315", citationType:"PubMed", citationRef:"21124315"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1655}, end: {_id:1656}, properties:{evidence:"While ROS are required for glucose metabolism and metastasis in triple-negative breast cancers (9), decreased SirT3 levels concomitant with high ROS levels are frequently observed in all breast cancers (8). Based on these findings, SirT3 is considered a tumor suppressor (5, 8). SirT3 regulates the activity of magnesium superoxide dismutase (MnSOD), which detoxifies superoxide to hydrogen peroxide (5, 7, 10,â€“14). Moreover, SirT3 has been linked to augmented transcription of MnSOD and catalase, both known targets of the transcription factor FOXO3A (15). The SirT3-dependent deacetylation of FOXO3A promotes both its nuclear translocation and its transcriptional activity (16, 17). Therefore, mechanistically, the reduction of SirT3 levels leads to an elevation in ROS levels by compromising the mitochondrial antioxidant machinery.", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshdisease:["Breast Neoplasms"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:IS_A]->(end) SET r += row.properties;
