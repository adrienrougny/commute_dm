UNWIND [{start: {_id:1886}, end: {_id:1892}, properties:{annotationUserannotationcell:["osteosarcoma U2OS cells"], annotationCondition:["Normal Healthy State"], evidence:"In accord with this observation, we found that knockdown of CHCHD4 using two distinct small interfering RNAs (siRNAs) led to a similar respiratory chain defect in human osteosarcoma U2OS cells (Figure 4A). Thus, CHCHD4 depletion resulted in reduced protein expression of several respiratory chain subunits, such as CI-20 and CIV-II, paralleling functional defects in complexes I and IV, but not in complex V (Figures 4Aâ€“4E).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1886}, end: {_id:1878}, properties:{annotationUserannotationcell:["osteosarcoma U2OS cells"], annotationCondition:["Normal Healthy State"], evidence:"In accord with this observation, we found that knockdown of CHCHD4 using two distinct small interfering RNAs (siRNAs) led to a similar respiratory chain defect in human osteosarcoma U2OS cells (Figure 4A). Thus, CHCHD4 depletion resulted in reduced protein expression of several respiratory chain subunits, such as CI-20 and CIV-II, paralleling functional defects in complexes I and IV, but not in complex V (Figures 4Aâ€“4E).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1886}, end: {_id:1836}, properties:{annotationUserannotationcell:["osteosarcoma U2OS cells"], annotationCondition:["Normal Healthy State"], evidence:"In accord with this observation, we found that knockdown of CHCHD4 using two distinct small interfering RNAs (siRNAs) led to a similar respiratory chain defect in human osteosarcoma U2OS cells (Figure 4A). Thus, CHCHD4 depletion resulted in reduced protein expression of several respiratory chain subunits, such as CI-20 and CIV-II, paralleling functional defects in complexes I and IV, but not in complex V (Figures 4Aâ€“4E).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
