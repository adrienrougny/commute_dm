UNWIND [{start: {_id:221}, end: {_id:329}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recent studies have revealed that PINK1 and Parkin may also play important roles in maintenance of mitochondrial integrity.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:271}, end: {_id:329}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recent studies have revealed that PINK1 and Parkin may also play important roles in maintenance of mitochondrial integrity.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:271}, end: {_id:369}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Taken together, the Parkin protein may play a role in vesicular transport system in association with the Golgi complex.", citationTitle:"Rinsho Shinkeigaku. 1999 Dec;39(12):1259-61.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Golgi Apparatus", "Cytosol"], pmid:"10791092", citationType:"PubMed", citationRef:"10791092"}}, {start: {_id:393}, end: {_id:62}, properties:{evidence:"Mitochondrial respiratory failure induces oxidative damage in neurons, and we found increase in hydroxynonenal and 8-oxo-deoxyguanine, indices of oxidative damage, in the nigral neurons of PD.These abnormalities can trigger apoptotic cell death.", citationTitle:"Rinsho Shinkeigaku. 2004 Apr-May;44(4-5):241-62.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15287506", citationType:"PubMed", citationRef:"15287506"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found evidence to indicate accumulation of PAEL receptor and the presence of endoplasmic reticulum stress in a patient with AR-JP (Park2).", citationTitle:"Rinsho Shinkeigaku. 2004 Apr-May;44(4-5):241-62.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"15287506", citationType:"PubMed", citationRef:"15287506"}}, {start: {_id:417}, end: {_id:418}, properties:{evidence:"In addition, GDF5 has been shown to promote neurite growth of rat VM DA neurons in vitro . Furthermore, several in vivo studies have shown that GDF5 can protect and, more importantly, regenerate adult rat nigrostriatal DA neurons in animal models of PD.", citationTitle:"Neural Regen Res. 2014 Oct 1;9(19):1708-11. doi: 10.4103/1673-5374.143410.", annotationSubgraph:["Neurotrophic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurites", "Dopaminergic Neurons"], pmid:"25422631", citationType:"PubMed", citationRef:"25422631"}}, {start: {_id:457}, end: {_id:458}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This is further supported by the work of Dzamko et al. (2012) who show that inhibitor of kappa B kinases (IKKs) phosphorylate LRRK2 in bone marrow-derived macrophages upon activation of toll-like receptor signaling which is specific to immune cells.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Cytokine signaling subgraph", "LRRK2 subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:271}, end: {_id:551}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Further data reveal mutations in PINK 1 (PTEN-induced putative kinase 1) gene, which promotes basal autophagy and normally controls mitochondrial balance acting on Parkin protein. The latter promotes autophagy, but if PINK 1 gene carries a mutation, altered Parkin activity leads to autophagy dysregulation and mitochondrial imbalance", citationTitle:"Neural Regen Res. 2013 Aug 25;8(24):2275-83. doi: 10.3969/j.issn.1673-5374.2013.24.007.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Neurons"], pmid:"25206537", citationType:"PubMed", citationRef:"25206537"}}, {start: {_id:560}, end: {_id:561}, properties:{evidence:"The tight junction proteins occludin and ZO-1 in a MPTP murine model of PD. Similarly, the exposure of murine EC to ROS increased the activity of metalloproteinase-9 (MMP-9), which caused degradation of the basal lamina and BBB disruption.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["RhoA subgraph", "Matrix metalloproteinase subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:137}, end: {_id:535}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental evidence using cellular and animal models have shown that environmental and biological toxins, like Œ±-synuclein, LPS (lipopolysaccharides), herbicides and pesticides like rotenone or MPTP (1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine), can induce both astrogliosis and microgliosis, which is accompanied by altered striatal neuronal morphology, neuronal death,mitochondrial dysfunction and nuclear fragmentation.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:565}, end: {_id:535}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental evidence using cellular and animal models have shown that environmental and biological toxins, like Œ±-synuclein, LPS (lipopolysaccharides), herbicides and pesticides like rotenone or MPTP (1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine), can induce both astrogliosis and microgliosis, which is accompanied by altered striatal neuronal morphology, neuronal death,mitochondrial dysfunction and nuclear fragmentation.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Interferon signaling subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:137}, end: {_id:566}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental evidence using cellular and animal models have shown that environmental and biological toxins, like Œ±-synuclein, LPS (lipopolysaccharides), herbicides and pesticides like rotenone or MPTP (1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine), can induce both astrogliosis and microgliosis, which is accompanied by altered striatal neuronal morphology, neuronal death,mitochondrial dysfunction and nuclear fragmentation.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:565}, end: {_id:566}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental evidence using cellular and animal models have shown that environmental and biological toxins, like Œ±-synuclein, LPS (lipopolysaccharides), herbicides and pesticides like rotenone or MPTP (1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine), can induce both astrogliosis and microgliosis, which is accompanied by altered striatal neuronal morphology, neuronal death,mitochondrial dysfunction and nuclear fragmentation.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Interferon signaling subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:568}, end: {_id:411}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additionally, bFGF preserves BBB endothelial adherens junctions in a mouse model of intracerebral hemorrhage through the inhibition of RhoA protein, suggesting that bFGF maintains BBB integrity.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Neurotrophic subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:220}, end: {_id:589}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Taken together, these studies suggest that DJ-1 may function as a redox-regulated chaperone to prevent misfolding and aggregation of dproteins under conditions of oxidative stress", citationTitle:"Exp Neurol. 2009 Aug;218(2):235-46. doi: 10.1016/j.expneurol.2009.03.006. Epub 2009 Mar 18.", annotationSubgraph:["Chaperone subgraph"], pmid:"19303005", citationType:"PubMed", citationRef:"19303005"}}, {start: {_id:621}, end: {_id:625}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Further, Nrf2 knockdown abolishes DJ-1-mediated Trx1 induction and cytoprotection against hydrogen peroxide, indicating the critical role of Nrf2 in carrying out the protective functions of DJ-1 against oxidative stress.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Notch signaling subgraph", "Response to oxidative stress"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:617}, end: {_id:627}, properties:{evidence:"Here we show that lack of DJ-1 attenuates astrocytes' ability to support neuronal cells, thereby leading to accelerated neuronal damage.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 50; Iss. 3", annotationSubgraph:["Chaperone subgraph", "Response to oxidative stress"], annotationMeshdisease:["Parkinson Disease"], pmid:"23536331", citationType:"PubMed", citationRef:"23536331"}}, {start: {_id:617}, end: {_id:269}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Astrocytes isolated from DJ-1 knockout mice showed an inferior ability to protect human neuroblastoma cells against 6-OHDA insult both by co- culture and through their conditioned media, as compared to wild-type astrocytes.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 50; Iss. 3", annotationSubgraph:["Chaperone subgraph", "Response to oxidative stress"], annotationMeshanatomy:["Astrocytes"], pmid:"23536331", annotationDisease:["neuroblastoma"], citationType:"PubMed", citationRef:"23536331"}}, {start: {_id:621}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"DJ-1 knockout astrocytes showed blunted ability to increase the expression of cellular protective mechanisms against oxidative stress mediated via Nrf-2 and HO-1 in response to exposure to 6-OHDA.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 50; Iss. 3", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"23536331", annotationDisease:["neuroblastoma"], citationType:"PubMed", citationRef:"23536331"}}, {start: {_id:628}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"DJ-1 knockout astrocytes showed blunted ability to increase the expression of cellular protective mechanisms against oxidative stress mediated via Nrf-2 and HO-1 in response to exposure to 6-OHDA.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 50; Iss. 3", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"23536331", annotationDisease:["neuroblastoma"], citationType:"PubMed", citationRef:"23536331"}}] AS row
