UNWIND [{start: {_id:1976}, end: {_id:1977}, properties:{evidence:"Autophagy, a cellular process for organelle and protein turnover, regulates innate immune responses. Here we demonstrate that depletion of the autophagic proteins LC3B and beclin 1 enhanced the activation of caspase-1 and secretion of interleukin 1Beta (IL-1Beta) and IL-18.", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Interleukin signaling subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}, {start: {_id:1976}, end: {_id:1979}, properties:{evidence:"Autophagy, a cellular process for organelle and protein turnover, regulates innate immune responses. Here we demonstrate that depletion of the autophagic proteins LC3B and beclin 1 enhanced the activation of caspase-1 and secretion of interleukin 1Beta (IL-1Beta) and IL-18.", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Interleukin signaling subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}, {start: {_id:556}, end: {_id:1977}, properties:{evidence:"Autophagy, a cellular process for organelle and protein turnover, regulates innate immune responses. Here we demonstrate that depletion of the autophagic proteins LC3B and beclin 1 enhanced the activation of caspase-1 and secretion of interleukin 1Beta (IL-1Beta) and IL-18.", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Interleukin signaling subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}, {start: {_id:556}, end: {_id:1979}, properties:{evidence:"Autophagy, a cellular process for organelle and protein turnover, regulates innate immune responses. Here we demonstrate that depletion of the autophagic proteins LC3B and beclin 1 enhanced the activation of caspase-1 and secretion of interleukin 1Beta (IL-1Beta) and IL-18.", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Interleukin signaling subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:420}, end: {_id:77}, properties:{evidence:"Loss of ATP13A2 function results in impaired lysosomal function and, consequently, accumulation of SNCA/??-synuclein and neurotoxicity(21),One patient (Patient A with c.216C>A/c.1904G>A)", citationTitle:"Acta Neurol Taiwan. 2012 Sep;21(3):99-107.", annotationSubgraph:["Synuclein subgraph", "ATP13A2 subgraph"], pmid:"23196729", citationType:"PubMed", citationRef:"23196729"}}, {start: {_id:137}, end: {_id:77}, properties:{evidence:"our results suggest, increased levels of nuclear alpha synuclein in Parkinson's disease lead to decreased histone H3 acetylation and neurotoxicity", citationTitle:"Hum Mol Genet. 2006 Oct 15;15(20):3012-23. Epub 2006 Sep 7.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16959795", citationType:"PubMed", citationRef:"16959795"}}, {start: {_id:1441}, end: {_id:748}, properties:{evidence:"loss of function of key regulators of the mitochondrial dynamics machinery (Marf, opa1, drp1) causes lethality", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Testis"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1442}, end: {_id:748}, properties:{evidence:"loss of function of key regulators of the mitochondrial dynamics machinery (Marf, opa1, drp1) causes lethality", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Testis"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1443}, end: {_id:748}, properties:{evidence:"loss of function of key regulators of the mitochondrial dynamics machinery (Marf, opa1, drp1) causes lethality", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Testis"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:634}, end: {_id:1715}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pink1 deficient mice reveal impaired dopamine release (Kitada et al, 2007), deficient mitochondrial respiration and increased sensitivity to oxidative stress (Gautier et al, 2008), while overexpression and loss of function studies suggest an anti-apoptotic activity for PINK1 (Deng et al, 2005; Lin & Kang, 2008; Petit et al, 2005).", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1721}, end: {_id:1722}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It should be noted however that genetic interactions between pink1 and drp1 (dynamin related protein) or fis1 (fission 1), genes implicated in mitochondrial fission (Yoon et al, 2003), do not imply necessarily that pink1 is in the same molecular pathway as these proteins. Indeed studies performed on fibroblasts from patients carrying the homozygous W437X (Trp437 â†’ Xxx) nonsense PINK1 mutation revealed a normal mitochondrial tubular network", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph", "Mitochondria fission subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1729}, end: {_id:748}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The release of cytochrome c upon stimulation with the proapoptotic BH3-only member of the Bcl-2 family cBID, was slightly, but significantly increased in purified Pink1âˆ’/âˆ’ mitochondria", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Apoptosis signaling subgraph", "PINK1 subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1718}, end: {_id:748}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss of Drp1 leads to depletion of synaptic mitochondria and decreased local mitochondrial ATP production that is used by the myosin ATPase to mediate RP mobilization", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:271}, end: {_id:1756}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results indicate that parkin overexpression in model cells physically and func- tionally enhanced ERâ€“mitochondria coupling, favored Ca2+ transfer from the ER to the m itochondria following cells stimulation with an 1,4,5 inositol trisphosphate (InsP3) generating agonist and increased the agonist-induced ATP production.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:2010}, end: {_id:44}, properties:{evidence:"The homeobox transcription factor, Pitx3, plays a critical role in the development, function, and maintenance of midbrain DA neurons. We found that in young adult Pitx3-null mice, Pitx3(-/-), there was decreased tyrosine hydroxylase staining, indicating a loss of DA neurons particularly in the substantia nigra. In addition, fast-scan cyclic voltammetry and microdialysis assays of DA release indicated that the lack of Pitx3 caused a significant reduction of striatal DA release.Furthermore, behavioral tests revealed that Pitx3(-/-) mice displayed abnormal motor activities, including impaired motor coordination and decreased locomotion.", citationTitle:"Neurobiol Aging. 2015 Dec;36(12):3314-20. doi: 10.1016/j.neurobiolaging.2015.08.012. Epub 2015 Aug 20.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"26363812", citationType:"PubMed", citationRef:"26363812"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:400}, end: {_id:203}, properties:{annotationCondition:["Normal Healthy State"], evidence:"There is evidence of the relationship between autophagy and LRRK2, and the deregulation could be involved, at least in part, in the aetiology of PD. I", citationTitle:"Biochem Soc Trans. 2012 Oct;40(5):1129-33.", annotationSubgraph:["LRRK2 subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22988877", citationType:"PubMed", citationRef:"22988877"}}, {start: {_id:313}, end: {_id:1441}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interactions of pink1 and parkin with genes regulating mitochondrial fusion and fission. Mitochondrial fusion requires Mfn and Opa1, and mitochondrial fission requires Drp1 and Fis1. Pink1 and Parkin promote fission and/or inhibit fusion, either directly or indirectly (dashed lines). In addition, Pink1 and Parkin are unlikely to be components of the canonical pathways regulating mitochondrial dynamics. Rather, Pink1 and Parkin may regulate other mitochondrial functions that also impact mitochondrial integrity.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:313}, end: {_id:1442}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interactions of pink1 and parkin with genes regulating mitochondrial fusion and fission. Mitochondrial fusion requires Mfn and Opa1, and mitochondrial fission requires Drp1 and Fis1. Pink1 and Parkin promote fission and/or inhibit fusion, either directly or indirectly (dashed lines). In addition, Pink1 and Parkin are unlikely to be components of the canonical pathways regulating mitochondrial dynamics. Rather, Pink1 and Parkin may regulate other mitochondrial functions that also impact mitochondrial integrity.", citationTitle:"Proc Natl Acad Sci U S