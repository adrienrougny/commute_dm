UNWIND [{start: {_id:77}, end: {_id:398}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, it has been shown that microglial cells play a crucial role in neuroprotection by ROCK inhibition and that activation of microglial ROCK mediates major components of the microglial inflammatory response.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["RhoA subgraph"], annotationMeshanatomy:["Microglia"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:77}, end: {_id:398}, properties:{evidence:"Finally, it is important to note that the above-mentioned in vitro experiments in PD models (i.e., primary cultures of dopaminergic neurons) show that ROCK inhibition is able to induce important neuroprotective effects against dopaminergic neuron degeneration in the absence of any effect on the microvascular endothelial permeability, BBB function, or transendothelial migration of peripheral immune cells.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["RhoA subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:514}, end: {_id:436}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The neurotoxicity of SNCA might be mediated through interaction with histone altering its acetylation. This is supported by the finding that AGK2, a potent SIRT2 inhibitor, alleviates alpha-syn mediated toxicity and prevents dopaminergic neuronal death both in vitro and in a Drosophila model of PD.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Synuclein subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:442}, end: {_id:905}, properties:{evidence:"For instance, PP2A enzyme but not PP1 is shown to dephosphorylate alpha-syn-pS129 in vitro , and treatment of cells with the PP2A inhibitor okadaic acid (OA) but not the PP1 inhibitor tautomycin leads to an increased level of alpha-syn-pS129.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:1005}, end: {_id:1010}, properties:{evidence:"There is a concentration-driven flux of 24S-hydroxycholesterol (24S-OHC) from the brain into the circulation, which is of major importance for elimination of excess cholesterol from the brain. The opposite flux of 27-hydroxycholesterol (27-OHC) from the circulation into the brain may regulate a number of key enzymes within the brain. In vitro experiments suggest that the balance between the levels of these two molecules may be of importance for the generation of beta- amyloid peptides. In primary cultures of rat hippocampal cells 27-OHC is able to suppress expression of the activity regulated cytoskeleton- associated protein (Arc), a protein important in memory consolidation which is reduced in patients with Alzheimer's disease (AD).", citationTitle:"Mol Aspects Med. 2009 Jun;30(3):171-9. doi: 10.1016/j.mam.2009.02.001. Epub 2009 Feb 25.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["10116"], annotationMeshdisease:["Alzheimer Disease"], pmid:"19248803", citationType:"PubMed", citationRef:"19248803"}}, {start: {_id:1746}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, morphological defects that arise because of functional defects in mitochondria can be rescued by vitamin K2.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:2086}, end: {_id:2087}, properties:{evidence:"In the present study, we examined the possibility that the cellular receptors of PEI/DNA complexes might also be subjected to PKC regulation. To test if PKC might have a role in internalization of PEI/DNA complexes, we treated HeLa cells with staurosporine and tested the effects of this PKC inhibitor on transfection efï¬�ciency using a luciferase assay. As shown in Figure 1, staurosporine inhibited transfection in a concentration-dependent manner. The effects were observed at concentrations similar to those used to interfere with bacterial invasion [17] and uptake of HSPG-ligating beads [15] into HeLa cells.", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2262}, end: {_id:2257}, properties:{evidence:"As mentioned in the introduction, CSC is not only A 2A receptor antagonist, but also effectively inhibits MAO-B activity.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"22407500", citationType:"PubMed", citationRef:"22407500"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:804}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of PARL did not affect PINK1 expression in uncoupled mitochondria", citationTitle:"J Cell Biol. 2010 Nov 29;191(5):933-42. doi: 10.1083/jcb.201008084.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"21115803", citationType:"PubMed", citationRef:"21115803"}}, {start: {_id:1513}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"downregulation of CLPP did not inhibit PINK1 accumulation induced by overexpression of unfolded protein or affect the level of Î”OTC itself, indicating that CLPP is not triggering PINK1 accumulation through peptide generation or Î”OTC degradation. However, the knockdown of another mitochondrial protease, LONP1, robustly increased Î”OTC and PINK1 accumulation, suggesting that Î”OTC is degraded to some extent by LONP1 and that the level of accumulated unfolded protein is important for PINK1 accumulation rather than peptide fragments generated by the protease.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1750-7. doi: 10.4161/auto.26122. Epub 2013 Sep 5.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], pmid:"24149988", citationType:"PubMed", citationRef:"24149988"}}, {start: {_id:271}, end: {_id:1845}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, unlike in PINK1, parkin mutant pheno- types were not rescued by Pum RNAi", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1881}, end: {_id:335}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Neither AIF nor CHCHD4 affected the abundance of other mitochondrial proteins such as VDAC, PINK, and HSP60 (Figures S3C and S3D). The mitochondrial IMS-operating metalloprotease YME1L (Baker et al., 2012; Jensen and Jasper, 2014) is (one of) the protease(s) that participates in the degradation of CHCHD4 substrates after depletion of AIF.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph", "Pre-translational events"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Neither AIF nor CHCHD4 affected the abundance of other mitochondrial proteins such as VDAC, PINK, and HSP60 (Figures S3C and S3D). The mitochondrial IMS-operating metalloprotease YME1L (Baker et al., 2012; Jensen and Jasper, 2014) is (one of) the protease(s) that participates in the degradation of CHCHD4 substrates after depletion of AIF.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph", "PINK1 subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1462}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Neither AIF nor CHCHD4 affected the abundance of other mitochondrial proteins such as VDAC, PINK, and HSP60 (Figures S3C and S3D). The mitochondrial IMS-operating metalloprotease YME1L (Baker et al., 2012; Jensen and Jasper, 2014) is (one of) the protease(s) that participates in the degradation of CHCHD4 substrates after depletion of AIF.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph", "Matrix metalloproteinase subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:2118}, end: {_id:2119}, properties:{evidence:"In contrast to LPS, TREM-2 did not induce p38 and SAPK tyrosine phosphorylation (XREF_FIG C).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2120}, properties:{evidence:"In contrast to LPS, TREM-2 did not induce p38 and SAPK tyrosine phosphorylation (XREF_FIG C).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2134}, properties:{evidence:"TREM2 and DAP12 engagement in DCs leads to upregulation of CCR7, CD40, CD86, and DC survival but not IL-12 nor TNF-alpha production.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"11828015", citationType:"PubMed", citationRef:"11828015"}}, {start: {_id:2118}, end: {_id:1661}, properties:{evidence:"Gene transcript levels of TGF-beta were not modulated by knockdown or overexpression of TREM2.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}] AS row
