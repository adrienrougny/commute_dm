UNWIND [{start: {_id:436}, end: {_id:77}, properties:{evidence:"Parkinson's disease is a movement disorder characterized by degeneration of dopaminergic neurons in the substantia nigra pars compacta. Dopaminergic neuronal loss also occurs in Drosophila melanogaster upon directed expression of alpha-synuclein, a protein implicated in the pathogenesis of Parkinson's disease and a major component of proteinaceous Lewy bodies. We report that directed expression of the molecular chaperone Hsp70 prevented dopaminergic neuronal loss associated with alpha-synuclein in Drosophila and that interference with endogenous chaperone activity accelerated alpha- synuclein toxicity. Furthermore, Lewy bodies in human postmortem tissue immunostained for molecular chaperones, also suggesting that chaperones may play a role in Parkinson's disease progression.", citationTitle:"Science. 2002 Feb 1;295(5556):865-8. Epub 2001 Dec 20.", annotationSubgraph:["Chaperone subgraph", "Synuclein subgraph"], pmid:"11823645", citationType:"PubMed", citationRef:"11823645"}}, {start: {_id:436}, end: {_id:77}, properties:{evidence:"Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Mitochondrial subgraph", "Bcl-2 subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}, {start: {_id:436}, end: {_id:77}, properties:{evidence:"These findings demonstrate the existence of a novel mechanism of rotenone toxicity mediated by hsc70 and indicate that dysfunction of both CMA and macroautophagy can synergistically exacerbate alpha- synuclein toxicity, suggesting that hsc70 up-regulation may represent a valuable therapeutic strategy for PD.", citationTitle:"Neurotoxicology. 2016 May;54:161-9. doi: 10.1016/j.neuro.2016.04.018. Epub 2016 Apr 28.", annotationSubgraph:["Synuclein subgraph"], pmid:"27133439", citationType:"PubMed", citationRef:"27133439"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:408}, end: {_id:411}, properties:{evidence:"Although low levels of VEGF may have neuroprotective effects on dopaminergic neurons , high doses of VEGF lead to poor circulation, brain edema and disruption of BBB in PD models, which may contribute to dopaminergic degeneration", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Vascular endothelial growth factor subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:328}, end: {_id:517}, properties:{evidence:"Thus, dysregulation of acetylation of H3 or H4 is regarded as an important mechanism underlying pesticide-induced neuron loss in PD.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], annotationCell:["neuron"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:328}, end: {_id:518}, properties:{evidence:"Thus, dysregulation of acetylation of H3 or H4 is regarded as an important mechanism underlying pesticide-induced neuron loss in PD.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], annotationCell:["neuron"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:411}, end: {_id:570}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is likely that the maintenance of the BBB and the NVU will decrease the accumulation of Lewy bodies, alpha-synuclein fibrils and ROS that worsen the effects of PD", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:577}, end: {_id:578}, properties:{evidence:"The mice showed motor symptoms and severe degeneration in the nigrostriatal pathway caused by myelin disruption and demyelination in oligodendrocytes that had accumulated alpha-syn fibrils in their cytoplasm (Stefanova et al., 2012).", citationTitle:"Front Mol Neurosci. 2014 Aug 8;7:73. doi: 10.3389/fnmol.2014.00073. eCollection 2014.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Cytoplasm"], pmid:"25152710", citationType:"PubMed", citationRef:"25152710"}}, {start: {_id:1414}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Protection was abrogated by the proteasome inhibitor epoxomicin and disease-causing variants, indicating that it was mediated by the E3 ubiquitin ligase activity of Parkin.", citationTitle:"Hum Mol Genet. 2003 Mar 1;12(5):517-26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"12588799", citationType:"PubMed", citationRef:"12588799"}}, {start: {_id:1699}, end: {_id:1744}, properties:{evidence:"Loss of Complex I in synaptic mitochondria also results in impaired ATP production, which apparently underlies the RP mobilization defects that occur during intense stimulation of the synapse as mentioned here.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1760}, end: {_id:1440}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our findings show that the PINK1â€“Parkin pathway promotes mitophagy in vivo and, unexpectedly, also promotes selective turnover of mitochondrial RC subunits.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:842}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin then ubiquitinates proteins in the outer mitochondrial membrane (13â€“17), leading to autophagic degradation of the dysfunctional mitochondrion.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:131}, end: {_id:1923}, properties:{evidence:"Although concurrent inhibition of mitochondrial calcium uptake substantially enhanced this cytoplasmic calcium increase, it significantly reduced glutamate- stimulated neuronal cell death.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:1621}, end: {_id:112}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Chronic neuroinflammation is a common feature of the ageing brain and some neurodegenerative disorders. However, the molecular and cellular mechanisms underlying the regulation of innate immunity in the central nervous system remain elusive. Here we show that the astrocytic dopamine D2 receptor (DRD2) modulates innate immunity through alphaB- crystallin (CRYAB), which is known to suppress neuroinflammation.", citationTitle:"Nature. 2013 Feb 7;494(7435):90-4. doi: 10.1038/nature11748. Epub 2012 Dec 16.", annotationSubgraph:["Chaperone subgraph", "Innate immune system subgraph"], pmid:"23242137", citationType:"PubMed", citationRef:"23242137"}}] AS row
