UNWIND [{start: {_id:1368}, end: {_id:1373}, properties:{evidence:"cocaine consumption decreases Nurr1 expression in dopamine neurons. In addition, in the dopamine neurons of Nurr1- deficient cocaine abusers, the expression of the dopamine transporter (DAT) is significantly decreased. DATs, which are located in the membrane of dopaminergic neurons in the SNpc, are strikingly reduced in PD likely due to degeneration of these cells", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSubgraph:["Transport related subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"21892731", citationType:"PubMed", citationRef:"21892731"}}] AS row
