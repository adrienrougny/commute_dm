UNWIND [{start: {_id:28}, end: {_id:29}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The E3 ubiquitin ligase Rad18 chaperones DNA polymerase Œ∑ (PolŒ∑) to sites of UV-induced DNA damage and monoubiquitinates proliferating cell nuclear antigen (PCNA), facilitating engagement of PolŒ∑ with stalled replication forks and promoting translesion synthesis (TLS)", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph", "Cell cycle subgraph"], pmid:"22456510", citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:28}, end: {_id:31}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The E3 ubiquitin ligase Rad18 chaperones DNA polymerase Œ∑ (PolŒ∑) to sites of UV-induced DNA damage and monoubiquitinates proliferating cell nuclear antigen (PCNA), facilitating engagement of PolŒ∑ with stalled replication forks and promoting translesion synthesis (TLS)", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph", "Cell cycle subgraph"], pmid:"22456510", citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:208}, end: {_id:209}, properties:{evidence:"The disease-associated I2020T mutant shows a significant increase in autophosphorylation of approximately 40% in comparison to wild-type protein in vitro. This suggests that the pathology of PD caused by the I2020T mutation is associated with an increase rather than a loss in LRRK2 kinase activity.", citationTitle:"Hum Mol Genet. 2006 Jan 15;15(2):223-32. Epub 2005 Dec 1.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16321986", citationType:"PubMed", citationRef:"16321986"}}, {start: {_id:208}, end: {_id:210}, properties:{evidence:"Therefore, we addressed the question if LRRK2 exhibits MAPKKK activity by systematically testing MAPKKs as candidate substrates, in vitro. We demonstrate that LRRK2 variants phosphorylate mitogen-activated protein kinase kinases (MAPKK), including MKK3 -4, -6 and -7. MKKs act upstream of the MAPK p38 and JNK mediating oxidative cell stress, neurotoxicity and apoptosis. The disease-associated LRRK2 G2019S and I2020T mutations show an increased phosphotransferase activity towards MKKs correlating with the activity shown for its autophosphorylation. Our findings present evidence of a new class of molecular targets for mutant LRRK2 that link to neurotoxicity, cellular stress, cytoskeletal dynamics and vesicular transport.", citationTitle:"J Neurochem. 2009 May;109(4):959-68. doi: 10.1111/j.1471-4159.2009.06024.x. Epub 2009 Mar 3.", annotationSubgraph:["MAPK subgraph", "LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19302196", citationType:"PubMed", citationRef:"19302196"}}, {start: {_id:208}, end: {_id:211}, properties:{evidence:"Therefore, we addressed the question if LRRK2 exhibits MAPKKK activity by systematically testing MAPKKs as candidate substrates, in vitro. We demonstrate that LRRK2 variants phosphorylate mitogen-activated protein kinase kinases (MAPKK), including MKK3 -4, -6 and -7. MKKs act upstream of the MAPK p38 and JNK mediating oxidative cell stress, neurotoxicity and apoptosis. The disease-associated LRRK2 G2019S and I2020T mutations show an increased phosphotransferase activity towards MKKs correlating with the activity shown for its autophosphorylation. Our findings present evidence of a new class of molecular targets for mutant LRRK2 that link to neurotoxicity, cellular stress, cytoskeletal dynamics and vesicular transport.", citationTitle:"J Neurochem. 2009 May;109(4):959-68. doi: 10.1111/j.1471-4159.2009.06024.x. Epub 2009 Mar 3.", annotationSubgraph:["MAPK subgraph", "LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19302196", citationType:"PubMed", citationRef:"19302196"}}, {start: {_id:208}, end: {_id:212}, properties:{evidence:"Therefore, we addressed the question if LRRK2 exhibits MAPKKK activity by systematically testing MAPKKs as candidate substrates, in vitro. We demonstrate that LRRK2 variants phosphorylate mitogen-activated protein kinase kinases (MAPKK), including MKK3 -4, -6 and -7. MKKs act upstream of the MAPK p38 and JNK mediating oxidative cell stress, neurotoxicity and apoptosis. The disease-associated LRRK2 G2019S and I2020T mutations show an increased phosphotransferase activity towards MKKs correlating with the activity shown for its autophosphorylation. Our findings present evidence of a new class of molecular targets for mutant LRRK2 that link to neurotoxicity, cellular stress, cytoskeletal dynamics and vesicular transport.", citationTitle:"J Neurochem. 2009 May;109(4):959-68. doi: 10.1111/j.1471-4159.2009.06024.x. Epub 2009 Mar 3.", annotationSubgraph:["MAPK subgraph", "LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19302196", citationType:"PubMed", citationRef:"19302196"}}, {start: {_id:208}, end: {_id:213}, properties:{evidence:"Therefore, we addressed the question if LRRK2 exhibits MAPKKK activity by systematically testing MAPKKs as candidate substrates, in vitro. We demonstrate that LRRK2 variants phosphorylate mitogen-activated protein kinase kinases (MAPKK), including MKK3 -4, -6 and -7. MKKs act upstream of the MAPK p38 and JNK mediating oxidative cell stress, neurotoxicity and apoptosis. The disease-associated LRRK2 G2019S and I2020T mutations show an increased phosphotransferase activity towards MKKs correlating with the activity shown for its autophosphorylation. Our findings present evidence of a new class of molecular targets for mutant LRRK2 that link to neurotoxicity, cellular stress, cytoskeletal dynamics and vesicular transport.", citationTitle:"J Neurochem. 2009 May;109(4):959-68. doi: 10.1111/j.1471-4159.2009.06024.x. Epub 2009 Mar 3.", annotationSubgraph:["MAPK subgraph", "LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19302196", citationType:"PubMed", citationRef:"19302196"}}, {start: {_id:208}, end: {_id:209}, properties:{evidence:"Pathogenic mutations in the leucine-rich repeat kinase-2 (LRRK2) gene cause autosomal-dominant and certain cases of sporadic Parkinson's disease (PD). The G2019S substitution in LRRK2 is the most common genetic determinant of PD identified so far, and maps to a specific region of the kinase domain called the activation segment. The prominent pathogenic G2019S mutation in LRRK2 results in altered autophosphorylation, and increased autophosphorylation and substrate phosphorylation, through a process that seems to involve reorganization of the activation segment. Our results suggest a molecular mechanistic explanation for how the G2019S mutation enhances the catalytic activity of LRRK2, thereby leading to pathogenicity. These findings have important implications for therapeutic strategies in PD.", citationTitle:"Hum Mol Genet. 2007 Sep 1;16(17):2031-9. Epub 2007 Jun 20.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17584768", citationType:"PubMed", citationRef:"17584768"}}, {start: {_id:251}, end: {_id:250}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 protects against oxidative stress by phosphorylating mitochondrial chaperone TRAP1. Mutations in the PTEN induced putative kinase 1 (PINK1) gene cause an autosomal recessive form of Parkinson disease (PD). So far, no substrates of PINK1 have been reported, and the mechanism by which PINK1 mutations lead to neurodegeneration is unknown. Here we report the identification of TNF receptor-associated protein 1 (TRAP1), a mitochondrial molecular chaperone also known as heat shock protein 75 (Hsp75), as a cellular substrate for PINK1 kinase. PINK1 binds and colocalizes with TRAP1 in the mitochondria and phosphorylates TRAP1 both in vitro and in vivo. We show that PINK1 protects against oxidative-stress-induced cell death by suppressing cytochrome c release from mitochondria, and this protective action of PINK1 depends on its kinase activity to phosphorylate TRAP1. Moreover, we find that the ability of PINK1 to promote TRAP1 phosphorylation and cell survival is impaired by PD-linked PINK1 G309D, L347P, and W437X mutations. Our findings suggest a novel pathway by which PINK1 phosphorylates downstream effector TRAP1 to prevent oxidative-stress- induced apoptosis and implicate the dysregulation of this Mitochondrial subgraph in PD pathogenesis.", citationTitle:"PLoS Biol. 2007 Jul;5(7):e172. Epub 2007 Jun 19.", annotationSubgraph:["Chaperone subgraph", "PINK1 subgraph"], pmid:"17579517", citationType:"PubMed", citationRef:"17579517"}}, {start: {_id:399}, end: {_id:560}, properties:{evidence:"The tight junction proteins occludin and ZO-1 in a MPTP murine model of PD. Similarly, the exposure of murine EC to ROS increased the activity of metalloproteinase-9 (MMP-9), which caused degradation of the basal lamina and BBB disruption.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["RhoA subgraph", "Matrix metalloproteinase subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:768}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We, therefore, hypothesize that caspase-1- and caspase-8-dependent parkin cleavage in sporadic Parkinson's disease may play an important role in the degenerative process by initiating a vicious circle that leads to the accumulation of toxic parkin substrates, e.g. Œ±-synuclein.", citationTitle:"J Biol Chem. 2003 Jun 27;278(26):23376-80. Epub 2003 Apr 11.", annotationSubgraph:["Caspase subgraph", "Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"12692130", citationType:"PubMed", citationRef:"12692130"}}, {start: {_id:770}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We, therefore, hypothesize that caspase-1- and caspase-8-dependent parkin cleavage in sporadic Parkinson's disease may play an important role in the degenerative process by initiating a vicious circle that leads to the accumulation of toxic parkin substrates, e.g. Œ±-synuclein.", citationTitle:"J Biol Chem. 2003 Jun 27;278(26):23376-80. Epub 2003 Apr 11.", annotationSubgraph:["Caspase subgraph", "Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"12692130", citationType:"PubMed", citationRef:"12692130"}}, {start: {_id:28}, end: {_id:29}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The E3 ubiquitin ligase Rad18 chaperones DNA polymerase âˆšÃ©Â¬âˆ‘ (PolâˆšÃ©Â¬âˆ‘) to sites of UV-induced DNA damage and monoubiquitinates proliferating cell nuclear antigen (PCNA), facilitating engagement of PolâˆšÃ©Â¬âˆ‘ with stalled replication forks and promoting translesion synthesis (TLS)", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph", "DNA synthesis"], pmid:"22456510", annotationCellline:["NCI-H1299", "HCT116"], citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:28}, end: {_id:31}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The E3 ubiquitin ligase Rad18 chaperones DNA polymerase âˆšÃ©Â¬âˆ‘ (PolâˆšÃ©Â¬âˆ‘) to sites of UV-induced DNA damage and monoubiquitinates proliferating cell nuclear antigen (PCNA), facilitating engagement of PolâˆšÃ©Â¬âˆ‘ with stalled replication forks and promoting translesion synthesis (TLS)", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph", "DNA synthesis"], pmid:"22456510", annotationCellline:["NCI-H1299", "HCT116"], citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:965}, end: {_id:962}, properties:{evidence:"NRTN signals through its cognate receptor GFR and co-receptor RET to induce neurite outgrowth", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:965}, end: {_id:966}, properties:{evidence:"NRTN signals through its cognate receptor GFR and co-receptor RET to induce neurite outgrowth", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:1624}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we report that PINK1 regulates the E3 ubiquitin-protein ligase function of parkin through direct phosphorylation. We find that phosphorylation of parkin by PINK1 activates parkin E3 ligase function for catalyzing K63-linked polyubiquitination and enhances parkin- mediated ubiquitin signaling through the IkappaB kinase/nuclear factor kappaB (NF-kappaB) pathway. Furthermore, the ability of PINK1 to promote parkin phosphorylation and activate parkin-mediated ubiquitin signaling is impaired by PD-linked pathogenic PINK1 mutations. Our findings support a direct link between PINK1-mediated phosphorylation and parkin-mediated ubiquitin signaling and implicate the deregulation of the PINK1/parkin/NF-kappaB neuroprotective signaling pathway in the pathogenesis of PD.", citationTitle:"Hum Mol Genet. 2010 Jan 15;19(2):352-63. doi: 10.1093/hmg/ddp501. Epub 2009 Oct 30.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"19880420", citationType:"PubMed", citationRef:"19880420"}}, {start: {_id:1676}, end: {_id:1677}, properties:{evidence:"Here we identify a new pathway of mitochondria-mediated cell death in yeast. This pathway was named mitochondrial precursor over- accumulation stress (mPOS), and is characterized by aberrant accumulation of mitochondrial precursors in the cytosol. mPOS can be triggered by clinically relevant mitochondrial damage that is not limited to the core machineries of protein import. In response to mPOS, several ribosome-associated proteins were upregulated, including Gis2 and Nog2, which promote cap-independent translation and inhibit the nuclear export of the 60S ribosomal subunit, respectively6, 7. Gis2 and Nog2 upregulation promotes cell survival, which may be part of a feedback loop that attenuates mPOS. Our data indicate that mitochondrial dysfunction contributes directly to cytosolic proteostatic stress, and provide an explanation for the association between these two hallmarks of degenerative diseases and ageing.", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1676}, end: {_id:1678}, properties:{evidence:"Here we identify a new pathway of mitochondria-mediated cell death in yeast. This pathway was named mitochondrial precursor over- accumulation stress (mPOS), and is characterized by aberrant accumulation of mitochondrial precursors in the cytosol. mPOS can be triggered by clinically relevant mitochondrial damage that is not limited to the core machineries of protein import. In response to mPOS, several ribosome-associated proteins were upregulated, including Gis2 and Nog2, which promote cap-independent translation and inhibit the nuclear export of the 60S ribosomal subunit, respectively6, 7. Gis2 and Nog2 upregulation promotes cell survival, which may be part of a feedback loop that attenuates mPOS. Our data indicate that mitochondrial dysfunction contributes directly to cytosolic proteostatic stress, and provide an explanation for the association between these two hallmarks of degenerative diseases and ageing.", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1916}, end: {_id:271}, properties:{evidence:"Interestingly, c-Jun can bind to the same site, but acts as a transcriptional repressor of parkin gene expression.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
