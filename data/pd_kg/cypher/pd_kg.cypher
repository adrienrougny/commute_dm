UNWIND [{start: {_id:379}, end: {_id:16}, properties:{evidence:"These results suggest that elevated expression levels of SNCA-mRNA are found in the affected regions of PD brain and support the hypothesis that increases in alpha-synuclein expression is associated, among other factors, with the development of sporadic PD.", citationTitle:"Mov Disord. 2006 Oct;21(10):1703-8", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], pmid:"16795004", citationType:"PubMed", citationRef:"16795004"}}, {start: {_id:747}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"On the other hand, manganese, one possible substrate of ATP13A2, is a well-known cause of toxic parkinsonism in humans.", citationTitle:"Parkinsonism Relat Disord. 2012 Jan;18 Suppl 1:S4-6. doi: 10.1016/S1353-8020(11)70004-9.", annotationSubgraph:["ATP13A2 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"22166450", citationType:"PubMed", citationRef:"22166450"}}, {start: {_id:1096}, end: {_id:16}, properties:{evidence:"Our studies indicate that LINGO-1 expression is elevated in the substantia nigra of Parkinson's disease (PD) patients compared with age-matched controls and in animal models of PD after neurotoxic lesions.", citationTitle:"Proceedings of the National Academy of Sciences of the United States of America; Vol. 104; Iss. 36", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"17726113", citationType:"PubMed", citationRef:"17726113"}}, {start: {_id:379}, end: {_id:1179}, properties:{evidence:"These results suggest that in the presence of increased oxidative stress, increased alpha-synuclein expression within dopaminergic OB neurons results in neurodegeneration in the glomerular layer (GL) and increased alpha-synuclein levels in the granular cell layer which coincide with olfactory dysfunction.", citationTitle:"Neuroscience. 2011 Jan 13;172:379-86. doi: 10.1016/j.neuroscience.2010.10.072. Epub 2010 Nov 3.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Olfactory Bulb"], annotationCell:["dopaminergic neuron"], pmid:"21055449", citationType:"PubMed", citationRef:"21055449"}}, {start: {_id:379}, end: {_id:16}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"SNCA expression levels tended to be positively correlated with the number of the associated allele in autopsied frontal cortices. These findings establish SNCA as a definite susceptibility gene for sporadic PD.", citationTitle:"Hum Mol Genet. 2006 Apr 1;15(7):1151-8. Epub 2006 Feb 24.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Prefrontal Cortex"], pmid:"16500997", citationType:"PubMed", citationRef:"16500997"}}, {start: {_id:379}, end: {_id:16}, properties:{evidence:"Moreover, among the 14 CpG sites of CpG-2, the 2nd, 4th and 9th CpG sites were significantly hypomethylated in PD patients. In subgroups of PD, the methylation level decreased in the early-onset PD patients (P=0.001). RT-PCR examination showed that SNCA mRNA was increased in PD patients compared with normal control.", citationTitle:"Parkinsonism Relat Disord. 2014 Mar;20(3):308-13. doi: 10.1016/j.parkreldis.2013.12.002. Epub 2013 Dec 16.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"24398085", citationType:"PubMed", citationRef:"24398085"}}] AS row
