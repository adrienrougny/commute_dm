UNWIND [{start: {_id:984}, end: {_id:971}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Although the GDNF family members signal mainly via Ret receptor tyrosine kinase, there is recent evidence that they can also mediate their signals via GFR alpha receptors independently of Ret. The GDNF family of growth factors, unlike neurotrophins, has a well-defined function outside the nervous system.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:987}, end: {_id:971}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Although the GDNF family members signal mainly via Ret receptor tyrosine kinase, there is recent evidence that they can also mediate their signals via GFR alpha receptors independently of Ret. The GDNF family of growth factors, unlike neurotrophins, has a well-defined function outside the nervous system.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:990}, end: {_id:971}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Although the GDNF family members signal mainly via Ret receptor tyrosine kinase, there is recent evidence that they can also mediate their signals via GFR alpha receptors independently of Ret. The GDNF family of growth factors, unlike neurotrophins, has a well-defined function outside the nervous system.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:993}, end: {_id:971}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Although the GDNF family members signal mainly via Ret receptor tyrosine kinase, there is recent evidence that they can also mediate their signals via GFR alpha receptors independently of Ret. The GDNF family of growth factors, unlike neurotrophins, has a well-defined function outside the nervous system.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:1831}, end: {_id:1830}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here we show that Parkinsonâ€™s disease (PD)-associated genes PINK1 and Parkin direct localized translation of certain nuclear-encoded RCC (nRCC) mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1833}, end: {_id:1830}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here we show that Parkinsonâ€™s disease (PD)-associated genes PINK1 and Parkin direct localized translation of certain nuclear-encoded RCC (nRCC) mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1835}, end: {_id:1830}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here we show that Parkinsonâ€™s disease (PD)-associated genes PINK1 and Parkin direct localized translation of certain nuclear-encoded RCC (nRCC) mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1836}, end: {_id:1830}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here we show that Parkinsonâ€™s disease (PD)-associated genes PINK1 and Parkin direct localized translation of certain nuclear-encoded RCC (nRCC) mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1872}, end: {_id:1760}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Given that Dcp1 and GW182 are components of the P- body (Franks and Lykke-Andersen, 2008), our results suggest that P-bodies and possibly stress granules, related cytoplasmic structures in the turnover or storage of translationally stalled mRNAs (Balagopal and Parker, 2009), may be intimately linked to PINK1/Parkin pathogenesis.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1874}, end: {_id:1760}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Given that Dcp1 and GW182 are components of the P- body (Franks and Lykke-Andersen, 2008), our results suggest that P-bodies and possibly stress granules, related cytoplasmic structures in the turnover or storage of translationally stalled mRNAs (Balagopal and Parker, 2009), may be intimately linked to PINK1/Parkin pathogenesis.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1877}, end: {_id:1879}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hangen et al. show that the mitochondrial protein AIF regulates the biogenesis of respiratory chain complexes by interacting with, and by controlling the mitochondrial import of the mammalian homolog of yeast MIA40, CHCHD4, which is the central component of a redox- sensitive mitochondrial intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1877}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Restoring CHCHD4 reverses the metabolic and cell death phenotypes of Aif/y ESCs", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationCell:["embryonic stem cell"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1877}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"AIF Controls the Mitochondrial Import of CHCHD4", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1877}, end: {_id:1882}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Altogether, this assay corroborates the hypothesis that AIF controls the translation- coupled mitochondrial import of CHCHD4.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1906}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"CHCHD4 depletion is indispensable for the phenotypic manifestation of an AIF-related defect in oxidative phosphorylation.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1888}, end: {_id:1879}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Altogether, we conclude that the effect of AIF on the biogenesis of the mitochondrial respiratory chain complexes is medi- ated by its physical and functional interaction with CHCHD4, an essential mitochondrial intermembrane protein.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Mitochondrial subgraph", "Chaperone subgraph"], annotationCell:["embryonic stem cell"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:420}, end: {_id:137}, properties:{evidence:"Loss of ATP13A2 function results in impaired lysosomal function and, consequently, accumulation of SNCA/??-synuclein and neurotoxicity(21),One patient (Patient A with c.216C>A/c.1904G>A)", citationTitle:"Acta Neurol Taiwan. 2012 Sep;21(3):99-107.", annotationSubgraph:["Synuclein subgraph", "ATP13A2 subgraph"], pmid:"23196729", citationType:"PubMed", citationRef:"23196729"}}, {start: {_id:137}, end: {_id:1329}, properties:{evidence:"our results suggest, increased levels of nuclear alpha synuclein in Parkinson's disease lead to decreased histone H3 acetylation and neurotoxicity", citationTitle:"Hum Mol Genet. 2006 Oct 15;15(20):3012-23. Epub 2006 Sep 7.", annotationSubgraph:["Synuclein subgraph", "Transcription subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16959795", citationType:"PubMed", citationRef:"16959795"}}, {start: {_id:137}, end: {_id:1329}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"nuclear alpha-synuclein through direct interaction with histones, decreases histone H3 acetylation", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSubgraph:["Synuclein subgraph", "DNA synthesis"], annotationSpecies:["9606"], annotationMeshanatomy:["Neostriatum"], pmid:"21892731", citationType:"PubMed", citationRef:"21892731"}}, {start: {_id:1373}, end: {_id:1374}, properties:{evidence:"cocaine consumption decreases Nurr1 expression in dopamine neurons. In addition, in the dopamine neurons of Nurr1- deficient cocaine abusers, the expression of the dopamine transporter (DAT) is significantly decreased. DATs, which are located in the membrane of dopaminergic neurons in the SNpc, are strikingly reduced in PD likely due to degeneration of these cells", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSubgraph:["Transport related subgraph", "Tra