UNWIND [{start: {_id:270}, end: {_id:16}, properties:{evidence:"Damage to neurons was apparent 12-48 h of post-exposure and there were increases in caspase-3 activity in neurons after 6 h. These changes were paralleled by large increases in pyrimidine and purine base oxidation products, such as 8-OH-guanine suggesting that 5-S-cysteinyl conjugates of catecholamines are capable of diffusing into cells and stimulating the formation of reactive oxygen species (ROS), which may then lead to a mechanism of cell damage involving caspase-3. Indeed, intracellular ROS were observed to rise sharply on exposure to the conjugates. These results suggest one mechanism by which oxidative stress may occur in the substantia nigra in Parkinson's disease.", citationTitle:"J Neurochem. 2002 Apr;81(1):122-9.", annotationSubgraph:["Caspase subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"12067224", citationType:"PubMed", citationRef:"12067224"}}, {start: {_id:1218}, end: {_id:16}, properties:{evidence:"The study included 27 patients and 24 control subjects. The nasal cycle was present in significantly fewer patients than controls. Nasal pH and mucociliary clearance time were significantly higher in patients than in controls.", citationTitle:"J Int Med Res. 2013 Apr;41(2):334-9. doi: 10.1177/0300060513476433. Epub 2013 Feb 6.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mucus", "Nose"], pmid:"23569018", citationType:"PubMed", citationRef:"23569018"}}, {start: {_id:1241}, end: {_id:16}, properties:{evidence:"Gastrointestinal (GI) dysfunctions are one of the most frequent nonmotor symptoms of PD.upregulated b1-ARs were observed in the muscularis externa of the gastric corpus in 6-OHDA rats(Rat model of Parkinson disease).It has also been reported that expression of b1-AR is increased significantly in the colonic mucous of 6-OHDA rats(Rat model of Parkinson disease)", citationTitle:"Transl Res. 2014 Jul;164(1):22-31. doi: 10.1016/j.trsl.2014.01.001. Epub 2014 Jan 7.", annotationSpecies:["10116"], annotationMeshdisease:["Parkinson Disease"], pmid:"24467967", citationType:"PubMed", citationRef:"24467967"}}, {start: {_id:1398}, end: {_id:1397}, properties:{evidence:"The increase in mTORC1 signaling persisted during chronic administration of L-DOPA and showed a high correlation with the severity of dyskinesia", citationTitle:"Cell Cycle. 2010 Jul 15;9(14):2713-8. Epub 2010 Jul 27.", annotationSpecies:["9606"], annotationMeshdisease:["Dyskinesia, Drug-Induced"], pmid:"20581466", citationType:"PubMed", citationRef:"20581466"}}, {start: {_id:270}, end: {_id:16}, properties:{evidence:"Interestingly, Complex I deficiency and oxidative damage are frequently observed in affected neurons of PD patients", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1699}, end: {_id:16}, properties:{evidence:"Loss of PINK1 and/or Parkin activity has previously been reported to cause RC deficits, particularly in complex I (34â€“36), and complex I dysfunction has repeatedly been implicated in the pathogenesis of PD (37).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:893}, end: {_id:894}, properties:{evidence:"our results suggest OXY, a dietary phenolic compound, as a potential NTNal candidate for protection against neurodegeneration in PD.", citationTitle:"Free Radic Biol Med. 2008 Oct 1;45(7):1019-26. doi: 10.1016/j.freeradbiomed.2008.07.002. Epub 2008 Jul 16.", annotationSpecies:["10116"], annotationMeshdisease:["Parkinson Disease"], pmid:"18675900", citationType:"PubMed", citationRef:"18675900"}}, {start: {_id:953}, end: {_id:954}, properties:{evidence:"Dexamethasone, a glucocorticoid hormone receptor agonist, upregulated both protein and mRNA levels of TREK-1 leading to decreased NSC proliferation which could be reversed by bupivacaine. Fluoxetine, a serotonin reuptake inhibitor antidepressant that has been previously found to inhibit TREK-1 channels, robustly, could attenuate the upregulation of TREK-1 expression and the inhibition of NSC proliferation induced by dexamethasone.", citationTitle:"Psychopharmacology (Berl). 2011 Apr;214(3):747-59. doi: 10.1007/s00213-010-2077-3. Epub 2010 Nov 11.", annotationSubgraph:["Transport related subgraph"], annotationMeshdisease:["Nervous System Diseases"], pmid:"21069514", citationType:"PubMed", citationRef:"21069514"}}, {start: {_id:1225}, end: {_id:1227}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Estradiol increased astrocyte density and olfactory epithelium (OE) thickness regardless of the genotype. In addition estradiol treatment increased the number of mature neurons in the OE and glomerular synaptophysin in both genotypes, but the magnitude of increase was greater in the WT than in the KO mice. These data suggest that estrogen and apoE act synergistically to minimize the loss of mature sensory neurons and synapses following ovariectomy.", citationTitle:"Exp Neurol. 2012 Sep;237(1):1-7. doi: 10.1016/j.expneurol.2012.06.001. Epub 2012 Jun 9.", pmid:"22691461", citationType:"PubMed", citationRef:"22691461"}}, {start: {_id:1322}, end: {_id:1323}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is apparent that the mechanism of neuroprotection of HDACIs is likely to be multi-targeted. Given the multi-faceted origins of PD pathogenesis, HDACIs(Histone deacetylase inhibitors) seem like an optimistic candidate for therapy. These results highlight a novel mechanism whereby this HDACI induces neuroprotection and underscores the potential use of HDACIs such as TSA(Trichostatin A) in preventing inflammation-related neurodegenerative disorders such as PD", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1324}, end: {_id:1323}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Vorinostat (suberoylanilide hydroxamic acid (SAHA)), another notable hydroxamate based compound is the most clinically advanced HDACI. Moreover it was also shown that vorinostat completely inhibited the caspase-3 activation induced by MPP+ in MES23.5 cells indicating the inhibition of apoptosis in these dopaminergic cells.", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Caspase subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1325}, end: {_id:1323}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Histone hyperacetylation by valproate has hence been seen to increase transcription of endogenous âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±Syn and the neuroprotective agent HSP70, as well as downregulate caspase-3 and hence reduce apoptosis.", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Synuclein subgraph"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}, {start: {_id:1326}, end: {_id:1323}, properties:{annotationCondition:["Normal Healthy State"], evidence:"phenylbutyrate exerts neuroprotective efficacy in the MPTP mouse model of PD.phenylbutyrate stringently up-regulates the DJ-1 protein and protects dopaminergic neurons from death.phenylbutyrate was able to reduce aggregation of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±Syn and prevent deterioration of motor symptoms and cognitive decline", citationTitle:"Pharmacol Ther. 2013 Oct;140(1):34-52. doi: 10.1016/j.pharmthera.2013.05.010. Epub 2013 May 24.", annotationSubgraph:["Caspase subgraph"], pmid:"23711791", citationType:"PubMed", citationRef:"23711791"}}] AS row
