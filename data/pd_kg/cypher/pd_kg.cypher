UNWIND [{start: {_id:746}, end: {_id:365}, properties:{annotationCondition:["Normal Healthy State"], evidence:"On the other hand, manganese, one possible substrate of ATP13A2, is a well-known cause of toxic parkinsonism in humans.", citationTitle:"Parkinsonism Relat Disord. 2012 Jan;18 Suppl 1:S4-6. doi: 10.1016/S1353-8020(11)70004-9.", annotationSubgraph:["ATP13A2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22166450", citationType:"PubMed", citationRef:"22166450"}}, {start: {_id:800}, end: {_id:548}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In summary, LRRK2 kinase activity tracks with neuronal toxicity, where GTP-binding relates to toxicity presumably through intrinsic alteration of kinase activity.", citationTitle:"Hum Mol Genet. 2007 Jan 15;16(2):223-32. Epub 2007 Jan 2.", annotationSubgraph:["LRRK2 subgraph"], pmid:"17200152", citationType:"PubMed", citationRef:"17200152"}}, {start: {_id:2004}, end: {_id:1124}, properties:{annotationCondition:["Normal Healthy State"], evidence:"NLRP3 forms an inflammasome with its adaptor ASC, and its excessive activation can cause inflammatory diseases. However, little is known about the mechanisms that control assembly of the inflammasome complex. Here we show that microtubules mediated assembly of the NLRP3 inflammasome.", citationTitle:"Nat Immunol. 2013 May;14(5):454-60. doi: 10.1038/ni.2550. Epub 2013 Mar 17.", annotationSubgraph:["Caspase subgraph", "Innate immune system subgraph"], pmid:"23502856", citationType:"PubMed", citationRef:"23502856"}}] AS row
