UNWIND [{start: {_id:531}, end: {_id:532}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consistent with this, blocking the cAMP/PKA pathway resulted in reduced GSK-3 beta, phosphorylation and increased cell death, further suggesting that Ucn 1-induced GSK-3 beta phosphorylation-dependent neuroprotection is mediated by a rise in intracellular levels of cAMP.", citationTitle:"Int J Biochem Cell Biol. 2015 Mar;60C:130-138. doi: 10.1016/j.biocel.2014.12.005. Epub 2014 Dec 23.", annotationSubgraph:["Innate immune system subgraph", "GSK3 subgraph"], pmid:"25541373", citationType:"PubMed", citationRef:"25541373"}}, {start: {_id:311}, end: {_id:1699}, properties:{evidence:"Furthermore, notwithstanding the many attempts to place Pink1 in the core machinery regulating mitochondrial fusion, a direct link between levels of Pink1 and rate of mitochondrial fusion has not been demonstrated. Since mitochondrial dysfunction, irrespective of the underlying mechanism, is accompanied by fragmentation of the organelle (Dimmer et al, 2008; Rojo et al, 2002), it is likely that the excess mitochondrial fission caused by ablation of Pink1 under certain experimental conditions is an epiphenomenon of the primary mitochondrial dysfunction sustained by reduced Complex I activity (Fig 7).", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph", "Mitochondria fission subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1760}, end: {_id:1440}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We have provided evidence that the PINK1â€“Parkin pathway promotes mitophagy in vivo and described an additional role for this pathway in the selective nonmitophagic turnover of RC proteins.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Mitophagy subgraph", "PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1440}, end: {_id:1440}, properties:{annotationPdstage:["Familial_autosomal_dominant_PD"], evidence:"Our findings suggest that selective impairment of RC protein turnover may explain the RC deficits seen in both familial and sporadic PD patients.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:131}, end: {_id:1940}, properties:{evidence:"Although concurrent inhibition of mitochondrial calcium uptake substantially enhanced this cytoplasmic calcium increase, it significantly reduced glutamate- stimulated neuronal cell death.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshanatomy:["Mitochondria"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1237}, end: {_id:1238}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Olfactory neurons are known to express beta-adrenergic receptors (ARs), and we found that coexpression with beta(1)-ARs, but not any other AR subtypes, dramatically increased mouse 71 (M71) OR surface expression", citationTitle:"Proc Natl Acad Sci U S A. 2004 Sep 14;101(37):13672-6. Epub 2004 Sep 3.", annotationSubgraph:["G-protein-mediated signaling"], annotationSpecies:["10090"], pmid:"15347813", citationType:"PubMed", citationRef:"15347813"}}, {start: {_id:1259}, end: {_id:506}, properties:{evidence:"Dnmt1 deficiency in mice is associated with aberrant DNA methylation and expansion of CAG repeats in the germline at the spinocerebellar ataxia type 1 (SCA1) locus", citationTitle:"Mol Aspects Med. 2013 Jul-Aug;34(4):875-82. doi: 10.1016/j.mam.2012.06.011. Epub 2012 Jul 7.", annotationSubgraph:["Transcription subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"22782013", citationType:"PubMed", citationRef:"22782013"}}, {start: {_id:1382}, end: {_id:1393}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Knockdown of PDE4D, but not PDE4B, amplifies isoprenaline-stimulated phosphorylation of the beta2-adrenergic receptor (beta2-AR)", citationTitle:"J Biol Chem. 2005 Sep 30;280(39):33178-89. Epub 2005 Jul 19.", annotationSubgraph:["Cyclic AMP subgraph"], annotationSpecies:["10090"], pmid:"16030021", citationType:"PubMed", citationRef:"16030021"}}] AS row
