MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:43}, end: {_id:44}, properties:{evidence:"Dopa decarboxylase (DDC) catalyses the synthesis of both dopamine and serotonin as well as trace amines suggested to possess neuromodulating capabilities. We have previously reported evidence suggesting an association between DDC and bipolar affective disorder (BPAD) [B√∏rglum et al., 1999].", citationTitle:"Am J Med Genet B Neuropsychiatr Genet. 2003 Feb;117B(1):18-22.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"12555230", citationType:"PubMed", citationRef:"12555230"}}, {start: {_id:43}, end: {_id:45}, properties:{evidence:"Dopa decarboxylase (DDC) catalyses the synthesis of both dopamine and serotonin as well as trace amines suggested to possess neuromodulating capabilities. We have previously reported evidence suggesting an association between DDC and bipolar affective disorder (BPAD) [B√∏rglum et al., 1999].", citationTitle:"Am J Med Genet B Neuropsychiatr Genet. 2003 Feb;117B(1):18-22.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"12555230", citationType:"PubMed", citationRef:"12555230"}}, {start: {_id:76}, end: {_id:77}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central NervousSystem (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:114}, end: {_id:44}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interest in how mDA neurons develop has been stimulated by the potential use of stem cells in therapy or disease modeling. However, very little is known about how specific dopaminergic subtypes are generated. Here, we show that the expression profiles of the transcription factors Sox6, Otx2, and Nolz1 define subpopulations of mDA neurons already at the neural progenitor cell stage. After cell- cycle exit, Sox6 selectively localizes to SNc neurons, while Otx2 and Nolz1 are expressed in a subset of VTA neurons. Importantly, Sox6 ablation leads to decreased expression of SNc markers and a corresponding increase in VTA markers, while Otx2 ablation has the opposite effect. Moreover, deletion of Sox6 affects striatal innervation and dopamine levels. We also find reduced Sox6 levels in Parkinson's disease patients. These findings identify Sox6 as a determinant of SNc neuron development and should facilitate the engineering of relevant mDA neurons for cell therapy and disease modeling.", citationTitle:"Cell Rep. 2014 Aug 21;8(4):1018-25. doi: 10.1016/j.celrep.2014.07.016. Epub 2014 Aug 7.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25127144", citationType:"PubMed", citationRef:"25127144"}}, {start: {_id:416}, end: {_id:77}, properties:{evidence:"Indeed, delivery of AAV2-neurturin to both VM and striatum enhances neuroprotection in PD models .", citationTitle:"Neural Regen Res. 2014 Oct 1;9(19):1708-11. doi: 10.4103/1673-5374.143410.", annotationSubgraph:["Neurotrophic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Ventral Tegmental Area", "Corpus Striatum"], pmid:"25422631", citationType:"PubMed", citationRef:"25422631"}}, {start: {_id:618}, end: {_id:619}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additionally, knockdown of Trx1 significantly abrogates DJ-1-dependent, hydrogen peroxide-induced activation of the pro- survival factor AKT. Promoter analysis of the human Trx1 gene identified an antioxidant response element (ARE) that is required for DJ-1-dependent induction of Trx1 expression.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Chaperone subgraph"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:617}, end: {_id:77}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These experiments demonstrated that lack of DJ-1 impairs astrocyte- mediated neuroprotection.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 50; Iss. 3", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"23536331", annotationDisease:["neuroblastoma"], citationType:"PubMed", citationRef:"23536331"}}, {start: {_id:196}, end: {_id:382}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In most autopsies, brains with the LRRK2 G2019S mutation have Lewy body pathologies, as opposed to LRRK2 non-G2019S carriers, but there is marked variability in pathological findings, even among carriers with identical mutations, indicating that additional mechanisms may be critical [22].", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["fibroblast"], annotationMeshanatomy:["Mitochondria"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:43}, end: {_id:44}, properties:{evidence:"Dopa decarboxylase (DDC) catalyses the synthesis of both dopamine and serotonin as well as trace amines suggested to possess neuromodulating capabilities. We have previously reported evidence suggesting an association between DDC and bipolar affective disorder (BPAD) [BâˆšÃ‰Â¬âˆ�rglum et al., 1999].", citationTitle:"Am J Med Genet B Neuropsychiatr Genet. 2003 Feb;117B(1):18-22.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"12555230", citationType:"PubMed", citationRef:"12555230"}}, {start: {_id:43}, end: {_id:45}, properties:{evidence:"Dopa decarboxylase (DDC) catalyses the synthesis of both dopamine and serotonin as well as trace amines suggested to possess neuromodulating capabilities. We have previously reported evidence suggesting an association between DDC and bipolar affective disorder (BPAD) [BâˆšÃ‰Â¬âˆ�rglum et al., 1999].", citationTitle:"Am J Med Genet B Neuropsychiatr Genet. 2003 Feb;117B(1):18-22.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"12555230", citationType:"PubMed", citationRef:"12555230"}}, {start: {_id:76}, end: {_id:77}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central nervous system (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:962}, end: {_id:964}, properties:{evidence:"NRTN signals through its cognate receptor GFR and co-receptor RET to induce neurite outgrowth", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:966}, end: {_id:964}, properties:{evidence:"NRTN signals through its cognate receptor GFR and co-receptor RET to induce neurite outgrowth", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:416}, end: {_id:964}, properties:{annotationBrco:["Cortical Neuron"], evidence:"Similar to NGF, the NRTN induced P-Ser-STAT3 was localized to the mitochondria but not to the nucleus. Mitochondrial STAT3 was further found to be intimately involved in NRTN induced neurite outgrowth. Collectively, these findings demonstrated the hitherto unrecognized and novel role of specific GFRâˆšÃ©Â¬Â±2 and RET isoforms in mediating NRTN activation of STAT3 and the transcription independent mechanism whereby the mitochondria localized P-Ser-STAT3 mediated NRTN induced neurite outgrowth.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2789-802. doi: 10.1016/j.bbamcr.2013.07.004. Epub 2013 Jul 18.", annotationSubgraph:["Neurotrophic subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"23872421", citationType:"PubMed", citationRef:"23872421"}}, {start: {_id:961}, end: {_id:77}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:1046}, end: {_id:1047}, properties:{annotationCondition:["Normal Healthy State"], evidence:"a new member of the F-box family, Pof14, which forms a canonical, F-box dependent SCF (Skp1, Cullin, F-box protein) ubiquitin ligase complex. The Pof14 protein has intrinsic instability that is abolished by inactivation of its Skp1 interaction motif (the F-box), Skp1 or the proteasome, indicating that Pof14 stability is controlled by an autocatalytic mechanism. Pof14 interacts with the squalene synthase Erg9, a key enzyme in ergosterol metabolism, in a membrane-bound complex that does not contain the core SCF components. pof14 transcription is induced by hydrogen peroxide and requires the Pap1 transcription factor and the Sty1 MAP kinase. Pof14 binds to and decreases Erg9 activity in vitro and a pof14 deletion strain quickly loses viability in the presence of hydrogen peroxide due to its inability to repress ergosterol synthesis. A pof14 mutant lacking the F-box and an skp1-3 ts mutant behave as wild type in the presence of oxidant showing that Pof14 function is independent of SCF. This indicates that modulation of ergosterol level plays a key role in adaptation to oxidative stress.", citationTitle:"EMBO J. 2006 Oct 4;25(19):4547-56. Epub 2006 Sep 14.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"17016471", citationType:"PubMed", citationRef:"17016471"}}, {start: {_id:1134}, end: {_id:267}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, we found that FAF1 deficiency blocked PD-linked biochemical events, including caspase activation, ROS generation, JNK activation and cell death.", citationComment:"Accumulation of the parkin substrate, FAF1, plays a key role in the dopaminergic neurodegeneration.", citationTitle:"Human molecular genetics; Vol. 22; Iss. 8", annotationSubgraph:["Apoptosis signaling subgraph", "Reactive oxygen species subgraph"], citationPubDate:"2013-04-15", pmid:"23307929", citationAuthorList:"Jee-Won Sul|Min-Young Park|Juhee Shin|Young-Ran Kim|Sung-Eun Yoo|Young-Yun Kong|Ki-Sun Kwon|Young Ho Lee|Eunhee Kim", citationType:"PubMed", citationRef:"23307929"}}, {start: {_id:1141}, end: {_id:267}, properties:{evidence:"In the present investigation, we demonstrate that GMF-deficiency in astrocytes upregulates the antioxidant status and limit the extent of lipid peroxidation and production of reactive oxygen species (ROS) along with diminished nuclear factor-Å’âˆ«B-mediated inflammatory responses in 1-methyl-4-phenylpyridinium (MPP(+))-induced toxicity.", citationComment:"Glia maturation factor deficiency suppresses 1-methyl-4-phenylpyridinium-induced oxidative stress in astrocytes. [Copy from Id 381 at Mon Apr 20 15:44:56 CEST 2015]", citationTitle:"Journal of molecular neuroscience : MN; Vol. 53; Iss. 4", annotationSubgraph:["Lipid metabolism subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Astrocytes"], citationPubDate:"2014-08-01", pmid:"24430624", citationAuthorList:"Mohammad Moshahid Khan|Duraisamy Kempuraj|Smita Zaheer|Asgar Zaheer", citationType:"PubMed", citationRef:"24430624"}}, {start: {_id:1166}, end: {_id:1167}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The over-expression of OBCAM increased the cell size of type-1 astrocytes. Moreover, intense expression of OBCAM was observed on reactive astrocytes in the injured cerebrum in vivo. These results suggest that OBCAM is responsible for controlling the cell proliferation and growth in cortical astrocytes.", citationTitle:"J Neurochem. 2010 Feb;112(3):818-28. doi: 10.1111/j.1471-4159.2009.06513.x. Epub 2009 Nov 27.; Iss. 1", annotationSubgraph:["Cell cycle subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"19943852", citationType:"PubMed", citationRef:"19943852"}}, {start: {_id:1012}, end: {_id:1229}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Estradiol increased astrocyte density and olfactory epithelium (OE) thickness regardless of the genotype. In addition estradiol treatment increased the number of mature neurons in the OE and glomerular synaptophysin in both genotypes, but the magnitude of increase was greater in the WT than in the KO mice. These data suggest that estrogen and apoE act synergistically to minimize the loss of mature sensory neurons and synapses following ovariectomy.", citationTitle:"Exp Neurol. 2012 Sep;237(1):1-7. doi: 10.1016/j.expneurol.2012.06.001. Epub 2012 Jun 9.", annotationSubgraph:["APOE subgraph"], pmid:"22691461", citationType:"PubMed", citationRef:"22691461"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:810}, end: {_id:1775}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These effects were abolished by overproduction of the fission- promiting dynamin-related protein 1 (Drp1).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fission subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:221}, end: {_id:748}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In mammalian cells, PINK1 and Parkin cooperate in the clearance of dysfunctional mitochondria.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["PINK1 subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:271}, end: {_id:748}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In mammalian cells, PINK1 and Parkin cooperate in the clearance of dysfunctional mitochondria.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1961}, end: {_id:267}, properties:{annotationCondition:["Normal Healthy State"], evidence:"NOD-like receptors (NLRs) are a family of intracellular sensors of microbial- or danger-associated molecular patterns. Here, we report the identification of NLRX1, which is a new member of the NLR family that localizes to the mitochondria. NLRX1 alone failed to trigger most of the common signalling pathways, including nuclear factor-jB (NF)-jB- and type I interferondependent cascades, but could potently trigger the generation of reactive oxygen species (ROS).", citationTitle:"EMBO Rep. 2008 Mar;9(3):293-300. doi: 10.1038/sj.embor.7401161. Epub 2008 Jan 25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"18219313", citationType:"PubMed", citationRef:"18219313"}}, {start: {_id:1462}, end: {_id:267}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In cells with knocked-down VDAC1, caspase-1 activation and IL-1b secretion were considerably impaired for all inflammasome activators examined. As a consequence of VDAC1 knockdown, mitochondrial ROS was highly diminished . In contrast to the NLRP3 inflammasome, VDAC1 was not essential for the activation of the IPAF or the AIM2 inflammasome. A significant reduction of IL-1b secretion was also seen in cells where VDAC2 was knocked down .", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Reactive oxygen species subgraph"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}, {start: {_id:1998}, end: {_id:267}, properties:{evidence:"Interaction with TRAF6 leads to ECSIT ubiquitination and enrichment at the mitochondrial periphery, resulting in increased mitochondrial and cellular ROS generation. ECSIT- and TRAF6-depleted macrophages have decreased levels of TLR-induced ROS and are significantly impaired in their ability to kill intracellular bacteria.", citationTitle:"Nature. 2011 Apr 28;472(7344):476-80. doi:10.1038/nature09973.", annotationSubgraph:["Unfolded protein response subgraph", "Reactive oxygen species subgraph", "MAPK subgraph"], annotationCell:["macrophage"], pmid:"21525932", citationType:"PubMed", citationRef:"21525932"}}, {start: {_id:375}, end: {_id:2020}, properties:{evidence:"The lymphocytes overexpressing TH also expressed higher mRNA and protein levels of TH, and synthesized more CAs, including norepinephrine (NE), epinephrine (E) and dopamine (DA) than the mock- transfected control cells", citationTitle:"Int J Mol Med. 2016 Aug;38(2):635-42. doi: 10.3892/ijmm.2016.2639. Epub 2016 Jun 14.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"27315039", citationType:"PubMed", citationRef:"27315039"}}, {start: {_id:375}, end: {_id:2021}, properties:{evidence:"The lymphocytes overexpressing TH also expressed higher mRNA and protein levels of TH, and synthesized more CAs, including norepinephrine (NE), epinephrine (E) and dopamine (DA) than the mock- transfected control cells", citationTitle:"Int J Mol Med. 2016 Aug;38(2):635-42. doi: 10.3892/ijmm.2016.2639. Epub 2016 Jun 14.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"27315039", citationType:"PubMed", citationRef:"27315039"}}, {start: {_id:375}, end: {_id:44}, properties:{evidence:"The lymphocytes overexpressing TH also expressed higher mRNA and protein levels of TH, and synthesized more CAs, including norepinephrine (NE), epinephrine (E) and dopamine (DA) than the mock- transfected control cells", citationTitle:"Int J Mol Med. 2016 Aug;38(2):635-42. doi: 10.3892/ijmm.2016.2639. Epub 2016 Jun 14.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"27315039", citationType:"PubMed", citationRef:"27315039"}}, {start: {_id:196}, end: {_id:267}, properties:{evidence:"LRRK2 mutants stimulated mitochondrial factors involved in apoptosis and induced production of reactive oxygen species (ROS) and oxidative modification of macromolecules.", citationTitle:"Hum Mutat. 2011 Dec;32(12):1390-7. doi: 10.1002/humu.21582. Epub 2011 Sep 12.", annotationSubgraph:["LRRK2 subgraph"], pmid:"21850687", citationType:"PubMed", citationRef:"21850687"}}, {start: {_id:386}, end: {_id:77}, properties:{evidence:"Our findings demonstrate that SP1 attenuates mutant LRRK2-induced PD- like phenotypes and plays a neural protective role.", citationTitle:"Hum Mol Genet. 2016 Feb 15;25(4):672-80. doi: 10.1093/hmg/ddv504. Epub 2016 Jan 6.", annotationSubgraph:["LRRK2 subgraph", "Synuclein subgraph"], pmid:"26744328", citationType:"PubMed", citationRef:"26744328"}}, {start: {_id:2112}, end: {_id:44}, properties:{evidence:"The CRF-like peptide urocortin greatly attenuates loss of extracellular striatal dopamine in rat models of Parkinson's disease by activating CRF(1) receptors.", citationTitle:"Eur J Pharmacol. 2009 Feb 14;604(1-3):45-50. doi: 10.1016/j.ejphar.2008.11.009.", annotationSubgraph:["CRH subgraph", "Innate immune system subgraph"], annotationSpecies:["10116"], pmid:"19026631", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"19026631"}}, {start: {_id:2174}, end: {_id:2162}, properties:{evidence:"Dehydroepiandrosterone (DHEA) is 7_-hydroxylated by the cytochome P450 7B1 (CYP7B1) in the human brain and liver.", pmid:"17467270", citationType:"PubMed", citationRef:"17467270"}}, {start: {_id:138}, end: {_id:267}, properties:{evidence:"L-DOPA has been hypothesized to enhance neurodegeneration [XREF_BIBR] since DA metabolism by MAO-B generates ROS [XREF_BIBR].", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"21722346", citationType:"PubMed", citationRef:"21722346"}}, {start: {_id:138}, end: {_id:267}, properties:{evidence:"MAO-B catalysed ROS production has also been suggested to contribute to age related increases in mitochondrial damage, particularly in the substantia nigra (SN), a brain region, which displays preferential neurodegeneration in PD [XREF_BIBR].", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"22329629", citationType:"PubMed", citationRef:"22329629"}}, {start: {_id:138}, end: {_id:2261}, properties:{evidence:"xREF_BIBR, XREF_BIBR In the brain, metabolism of escitalopram propionate may be mediated by MAO-A, MAO-B, and aldehyde oxidase.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"22329629", citationType:"PubMed", citationRef:"22329629"}}, {start: {_id:2265}, end: {_id:1943}, properties:{evidence:"MIF has long been known to induce production and secretion of pro- inflammatory cytokines, mainly IL-1beta, TNF-alpha and IFN- gamma, as well as other inflammatory mediators such as nitric oxide", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"21550814", citationType:"PubMed", citationRef:"21550814"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
