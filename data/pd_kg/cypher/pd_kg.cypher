UNWIND [{start: {_id:31}, end: {_id:33}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The E3 ubiquitin ligase Rad18 chaperones DNA polymerase Œ∑ (PolŒ∑) to sites of UV-induced DNA damage and monoubiquitinates proliferating cell nuclear antigen (PCNA), facilitating engagement of PolŒ∑ with stalled replication forks and promoting translesion synthesis (TLS)", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph", "Cell cycle subgraph"], pmid:"22456510", citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:56}, end: {_id:59}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Accumulating evidence indicates that insulin-like growth factor-1 (IGF1) acts as a homeostatic modulator for normal brain functionality and synaptic plasticity, and the loss of IGF1 activity caused by diabetes may contribute to cognitive impairment [6]. Most biological functions of IGF1, including its anti-apoptotic function, are mediated by the insulin-like growth factor-1 receptor (IGF1R).", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:61}, end: {_id:59}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Accumulating evidence indicates that insulin-like growth factor-1 (IGF1) acts as a homeostatic modulator for normal brain functionality and synaptic plasticity, and the loss of IGF1 activity caused by diabetes may contribute to cognitive impairment [6]. Most biological functions of IGF1, including its anti-apoptotic function, are mediated by the insulin-like growth factor-1 receptor (IGF1R).", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:64}, end: {_id:59}, properties:{evidence:"Studies have shown that growth factor receptor-bound protein 10 (Grb10) can interact with tyrosine-phosphorylated growth factor receptors such as IGF1R and insulin receptor (IR) and serve as an endogenous negative regulator of IGF1R signaling.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:47}, end: {_id:65}, properties:{evidence:"Studies have shown that growth factor receptor-bound protein 10 (Grb10) can interact with tyrosine-phosphorylated growth factor receptors such as IGF1R and insulin receptor (IR) and serve as an endogenous negative regulator of IGF1R signaling.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:47}, end: {_id:67}, properties:{evidence:"Studies have shown that growth factor receptor-bound protein 10 (Grb10) can interact with tyrosine-phosphorylated growth factor receptors such as IGF1R and insulin receptor (IR) and serve as an endogenous negative regulator of IGF1R signaling.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:47}, end: {_id:68}, properties:{evidence:"The interaction between BPS domain of Grb10 and IGF1R could directly inhibit IGF1R substrate phosphorylation [11], and decreased the levels of Grb10 expression below normal levels resulted in augmented IGF1 activation of Akt and ERK1/2 [9].", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:73}, end: {_id:74}, properties:{evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central NervousSystem (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:76}, end: {_id:82}, properties:{evidence:"Primary cultured embryo fibroblasts from Gigyf2 null mice exhibit decreased IGF-I-stimulated IGF-I receptor tyrosine phosphorylation and augmented ERK1/2 phosphorylation. These data provide further evidence for an important role of GIGYF2 in age-related neurodegeneration and IGF pathway signaling.", citationTitle:"Hum Mol Genet. 2009 Dec 1;18(23):4629-39. doi: 10.1093/hmg/ddp430. Epub 2009 Sep 10.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"19744960", citationType:"PubMed", citationRef:"19744960"}}, {start: {_id:841}, end: {_id:845}, properties:{annotationCondition:["Normal Healthy State"], evidence:"On the other hand, no change in the BiFC signal was observed for E64D/WT DJ-1 heterodimers (Fig. 4b), further underscoring that E64D DJ-1 does not exhibit impaired dimerization under normal conditions.", citationTitle:"J Mol Med (Berl). 2013 May;91(5):599-611. doi: 10.1007/s00109-012-0976-y. Epub 2012 Nov 27.", annotationSubgraph:["Chaperone subgraph"], pmid:"23183826", citationType:"PubMed", citationRef:"23183826"}}, {start: {_id:31}, end: {_id:33}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The E3 ubiquitin ligase Rad18 chaperones DNA polymerase âˆšÃ©Â¬âˆ‘ (PolâˆšÃ©Â¬âˆ‘) to sites of UV-induced DNA damage and monoubiquitinates proliferating cell nuclear antigen (PCNA), facilitating engagement of PolâˆšÃ©Â¬âˆ‘ with stalled replication forks and promoting translesion synthesis (TLS)", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["DNA synthesis"], pmid:"22456510", annotationCellline:["NCI-H1299", "HCT116"], citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:58}, end: {_id:59}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Accumulating evidence indicates that insulin-like growth factor-1 (IGF1) acts as a homeostatic modulator for normal brain functionality and synaptic plasticity, and the loss of IGF1 activity caused by diabetes may contribute to cognitive impairment [6]. Most biological functions of IGF1, including its anti-apoptotic function, are mediated by the insulin-like growth factor-1 receptor (IGF1R).", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:931}, end: {_id:932}, properties:{evidence:"The interaction between BPS domain of Grb10 and IGF1R could directly inhibit IGF1R substrate phosphorylation [11], and decreased the levels of Grb10 expression below normal levels resulted in augmented IGF1 activation of Akt and ERK1/2 [9].", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:73}, end: {_id:74}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central nervous system (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:1077}, end: {_id:1078}, properties:{evidence:"Treatment of cells with EGF stimulates parkin binding to both Eps15 and the EGFR and promotes parkin-mediated ubiquitination of Eps15.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Akt/mTOR subgraph", "Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:1077}, end: {_id:1080}, properties:{evidence:"Treatment of cells with EGF stimulates parkin binding to both Eps15 and the EGFR and promotes parkin-mediated ubiquitination of Eps15.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Akt/mTOR subgraph", "Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:1383}, end: {_id:1385}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PDE4D binds Rheb in a noncatalytic manner that does not require its cAMP-hydrolyzing activity and thereby inhibits the ability of Rheb to activate mTORC1. However, elevated cAMP levels disrupt the interaction of PDE4D with Rheb and increase the interaction between Rheb and mTOR. This enhanced Rheb-mTOR interaction induces the activation of mTORC1 and cap-dependent translation, a cellular function of mTORC1. Taken together, our results suggest a novel regulatory mechanism for mTORC1 in which the cAMP-determined dynamic interaction between Rheb and PDE4D provides a key, unique regulatory event. We also propose a new role for PDE4 as a molecular transducer for cAMP signaling.", citationTitle:"Mol Cell Biol. 2010 Nov;30(22):5406-20. doi: 10.1128/MCB.00217-10. Epub 2010 Sep 13.", annotationSubgraph:["Cell cycle subgraph"], annotationSpecies:["9606"], pmid:"20837708", citationType:"PubMed", citationRef:"20837708"}}, {start: {_id:1459}, end: {_id:1530}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 plays a dual role by phosphorylating PARKIN on its UB-like domain and poly-UB chains on mitochondria. PARKIN activation by PINK1 produces canonical and non-canonical UB chains on mitochondria, and PARKIN-dependent chain assembly is required for accumulation of poly- phospho-UB (poly-p-UB) on mitochondria. In vitro, PINK1 directly activates PARKINâ€™s ability to assemble canonical and non-canonical UB chains, and promotes association of PARKIN with both p-UB and poly- p-UB. Our data reveal a feed-forward mechanism that explains how PINK1 phosphorylation of both PARKIN and poly-UB chains synthesized by PARKIN drives a program of PARKIN recruitment and mitochondrial ubiquitylation in response to mitochondrial damage.", citationTitle:"Mol Cell. 2014 Nov 6;56(3):360-75. doi: 10.1016/j.molcel.2014.09.007. Epub 2014 Oct 2.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25284222", citationType:"PubMed", citationRef:"25284222"}}, {start: {_id:221}, end: {_id:1613}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in PTEN-induced putative kinase 1 (PINK1) or parkin cause autosomal recessive forms of Parkinson's disease.Recent work suggests that loss of mitochondrial membrane potential stabilizes PINK1 and that accumulated PINK1 recruits parkin from the cytoplasm to mitochondria for elimination of depolarized mitochondria, which is known as mitophagy.In this study, we find that PINK1 forms a complex with sterile ÃŽÂ± and TIR motif containing 1 (SARM1) and tumor necrosis factor receptor-associated factor 6 (TRAF6), which is important for import of PINK1 in the outer membrane and stabilization of PINK1 on depolarized mitochondria. SARM1, which is known to be an adaptor protein for Toll-like receptor, binds to PINK1 and promotes TRAF6-mediated lysine 63 chain ubiquitination of PINK1 at lysine 433. Down-regulation of SARM1 and TRAF6 abrogates accumulation of PINK1, followed by recruitment of parkin to damaged mitochondria. Some pathogenic mutations of PINK1 reduce the complex formation and ubiquitination.These results indicate that association of PINK1 with SARM1 and TRAF6 is an important step for mitophagy.", citationTitle:"Mol Biol Cell. 2013 Sep;24(18):2772-84. doi: 10.1091/mbc.E13-01-0016. Epub 2013 Jul 24.", annotationSubgraph:["Ubiquitin subgraph", "Innate immune system subgraph", "PINK1 subgraph"], pmid:"23885119", citationType:"PubMed", citationRef:"23885119"}}, {start: {_id:1405}, end: {_id:1829}, properties:{annotationCondition:["Normal Healthy State"], evidence:"interaction with the TOM complex was detected under conditions associated with PINK1 accumulation on the OMM (HSD17B10 overproduction or CCCP treatment), consistent with unmasking due to the mitochondrial import mechanism being overwhelmed.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:221}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Translationally repressed nRCC mRNAs are localized in a PINK1/Tom20- dependent manner to mitochondrial outer membrane, where they are derepressed and activated by PINK1/Parkin through displacement of translation repressors, including Pumilio and Glorund/ hnRNP-F, a Parkin substrate, and enhanced binding of activators such as eIF4G.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Translationally repressed nRCC mRNAs are localized in a PINK1/Tom20- dependent manner to mitochondrial outer membrane, where they are derepressed and activated by PINK1/Parkin through displacement of translation repressors, including Pumilio and Glorund/ hnRNP-F, a Parkin substrate, and enhanced binding of activators such as eIF4G.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1845}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 Functionally Interacts with Pum and the TOM/TIM Complex to Regulate the Localization and Translation of nRCC mRNAs", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1846}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 Functionally Interacts with Pum and the TOM/TIM Complex to Regulate the Localization and Translation of nRCC mRNAs", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events", "PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin Cooperates with PINK1 to Promote hnRNP-F/Glo Ubiquitination and nRCC mRNA Translation", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1845}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, unlike PINK1-OE, Parkin OE was able to rescue Pum OE effects on nRCC mRNA translation and tissue integrity (Figures 7H and S7C), suggesting that Parkin may function downstream of Pum.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Second, in PINK1 and parkin mutants, more nRCC mRNAs bound to Glo in the mito fraction", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Second, in PINK1 and parkin mutants, more nRCC mRNAs bound to Glo in the mito fraction", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These data support that Glo/hnRNP-F is a direct substrate mediating the effect of PINK1/Parkin on nRCC mRNA translation.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results implicate PINK1 in the localization of nRCC mRNAs to MOM. PINK1 may act in this process through its binding to nRCC mRNAs and through its interaction with Tom20.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results support direct roles of PINK1/Parkin in translational control of nRCC mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results support direct roles of PINK1/Parkin in translational control of nRCC mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1/Parkin may help repair mildly damaged mito, e.g., via localized translation of nRCC mRNAs to boost OXPHOS.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1/Parkin may help repair mildly damaged mito, e.g., via localized translation of nRCC mRNAs to boost OXPHOS.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1881}, end: {_id:1838}, properties:{annotationUserannotationcell:["osteosarcoma U2OS cells"], annotationCondition:["Normal Healthy State"], evidence:"In accord with this observation, we found that knockdown of CHCHD4 using two distinct small interfering RNAs (siRNAs) led to a similar respiratory chain defect in human osteosarcoma U2OS cells (Figure 4A). Thus, CHCHD4 depletion resulted in reduced protein expression of several respiratory chain subunits, such as CI-20 and CIV-II, paralleling functional defects in complexes I and IV, but not in complex V (Figures 4Aâ€“4E).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1961}, end: {_id:1964}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Strikingly, our results identify NLRX1 as an activator for the generation of ROS, and show that the protein amplifies NF-kB and JNK- dependent signalling.", citationTitle:"EMBO Rep. 2008 Mar;9(3):293-300. doi: 10.1038/sj.embor.7401161. Epub 2008 Jan 25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"18219313", citationType:"PubMed", citationRef:"18219313"}}, {start: {_id:2081}, end: {_id:2085}, properties:{evidence:"In the present study, we examined the possibility that the cellular receptors of PEI/DNA complexes might also be subjected to PKC regulation. To test if PKC might have a role in internalization of PEI/DNA complexes, we treated HeLa cells with staurosporine and tested the effects of this PKC inhibitor on transfection efï¬�ciency using a luciferase assay. As shown in Figure 1, staurosporine inhibited transfection in a concentration-dependent manner. The effects were observed at concentrations similar to those used to interfere with bacterial invasion [17] and uptake of HSPG-ligating beads [15] into HeLa cells.", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2246}, end: {_id:2247}, properties:{evidence:"Our data demonstrate that IFNalpha induces the interaction of p85 with IRS-1 or IRS-2, but not Stat-3, in various hematopoietic cell lines in which IRS-1 and/or IRS-2 and Stat-3 are activated by IFNalpha.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"10733921", citationType:"PubMed", citationRef:"10733921"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1752}, end: {_id:1747}, properties:{annotationCondition:["Normal Healthy State"], evidence:"eeding heix mutants during development with MK-4 but not with menadione, a synthetic precursor that is prenylated to form vitamin K2, significantly improved their survival rate (Fig. 2, A and B) and other cellular defects (below), whereas ubiquinone (Q-10) feeding did not (Fig. 2A), indicating specificity (10).", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:809}, end: {_id:24}, properties:{evidence:"Surprisingly, the dysfunctional mitochondria do not recruit Parkin in vivo, and neither the clearance of defective mitochondria nor the neurodegeneration phenotype is affected by the absence of Parkin.", citationTitle:"Proc Natl Acad Sci U S A. 2011 Aug 2;108(31):12937-42. doi: 10.1073/pnas.1103295108. Epub 2011 Jul 18.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21768369", citationType:"PubMed", citationRef:"21768369"}}] AS row
