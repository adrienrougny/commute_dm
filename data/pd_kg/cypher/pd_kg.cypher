UNWIND [{start: {_id:403}, end: {_id:404}, properties:{evidence:"Previous studies have also shown that Akt activation induces trophic effects in murine models of PD and that phosphorylated Akt is depleted in brains of PD patients . Furthermore, activation of the PI3K/Akt pathway led to inactivation of GSK-3.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["Akt/mTOR subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:399}, end: {_id:132}, properties:{evidence:"Furthermore, it has shown that, in PD models, ROCK interacts with several factors that play a major role in dopaminergic neuron degeneration/neuroprotection such as NADPH-oxidase, angiotensin, and estrogen.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["RhoA subgraph", "Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:1029}, end: {_id:1030}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recent evidence suggests that synaptic consolidation at excitatory medial perforant path-granule cell synapses requires brain-derived neurotrophic factor (BDNF) signaling and induction of the immediate early gene activity-regulated cytoskeleton-associated protein (Arc). Arc mRNA is strongly induced and transported to dendritic processes following high-frequency stimulation (HFS) that induces LTP in the rat dentate gyrus in vivo. Sustained synthesis of Arc during a surprisingly protracted time-window is required for hyperphosphorylation of actin depolymerizing factor/cofilin and local expansion of the actin cytoskeleton in vivo. Furthermore, this process of Arc-dependent synaptic consolidation is activated in response to brief infusion of BDNF. Microarray expression profiling has revealed a panel of BDNF-regulated genes that may cooperate with Arc during synaptic consolidation. In addition to regulating gene expression, BDNF signaling modulates the fine localization and biochemical activation of the translation machinery. By modulating the spatial and temporal translation of newly induced (Arc) and constitutively- expressed mRNA in dendrites, BDNF may effectively control the window of synaptic consolidation. Dysregulation of BDNF synthesis and Arc function, specifically within the dentate gyrus, is linked to behavioral symptoms and cognitive deficits in animal models of depression and Alzheimer's disease.", citationTitle:"Prog Brain Res. 2007;163:453-71.", pmid:"17765733", citationType:"PubMed", citationRef:"17765733"}}, {start: {_id:1029}, end: {_id:1009}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recent evidence suggests that synaptic consolidation at excitatory medial perforant path-granule cell synapses requires brain-derived neurotrophic factor (BDNF) signaling and induction of the immediate early gene activity-regulated cytoskeleton-associated protein (Arc). Arc mRNA is strongly induced and transported to dendritic processes following high-frequency stimulation (HFS) that induces LTP in the rat dentate gyrus in vivo. Sustained synthesis of Arc during a surprisingly protracted time-window is required for hyperphosphorylation of actin depolymerizing factor/cofilin and local expansion of the actin cytoskeleton in vivo. Furthermore, this process of Arc-dependent synaptic consolidation is activated in response to brief infusion of BDNF. Microarray expression profiling has revealed a panel of BDNF-regulated genes that may cooperate with Arc during synaptic consolidation. In addition to regulating gene expression, BDNF signaling modulates the fine localization and biochemical activation of the translation machinery. By modulating the spatial and temporal translation of newly induced (Arc) and constitutively- expressed mRNA in dendrites, BDNF may effectively control the window of synaptic consolidation. Dysregulation of BDNF synthesis and Arc function, specifically within the dentate gyrus, is linked to behavioral symptoms and cognitive deficits in animal models of depression and Alzheimer's disease.", citationTitle:"Prog Brain Res. 2007;163:453-71.", pmid:"17765733", citationType:"PubMed", citationRef:"17765733"}}, {start: {_id:1600}, end: {_id:1601}, properties:{evidence:"Mitochondrial uncoupling mediated by uncoupling protein 1 (UCP1) is classically associated with non-shivering thermogenesis by brown fat. Recent evidence indicates that UCP family proteins are also present in selected neurons. Unlike UCP1, these proteins (UCP2, UCP4 and BMCP1/UCP5) are not constitutive uncouplers and are not crucial for non-shivering thermogenesis.", citationTitle:"Nat Rev Neurosci. 2005 Nov;6(11):829-40.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"16224498", citationType:"PubMed", citationRef:"16224498"}}, {start: {_id:1610}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in PTEN-induced putative kinase 1 (PINK1) or parkin cause autosomal recessive forms of Parkinson's disease.Recent work suggests that loss of mitochondrial membrane potential stabilizes PINK1 and that accumulated PINK1 recruits parkin from the cytoplasm to mitochondria for elimination of depolarized mitochondria, which is known as mitophagy.In this study, we find that PINK1 forms a complex with sterile ÃŽÂ± and TIR motif containing 1 (SARM1) and tumor necrosis factor receptor-associated factor 6 (TRAF6), which is important for import of PINK1 in the outer membrane and stabilization of PINK1 on depolarized mitochondria. SARM1, which is known to be an adaptor protein for Toll-like receptor, binds to PINK1 and promotes TRAF6-mediated lysine 63 chain ubiquitination of PINK1 at lysine 433. Down-regulation of SARM1 and TRAF6 abrogates accumulation of PINK1, followed by recruitment of parkin to damaged mitochondria. Some pathogenic mutations of PINK1 reduce the complex formation and ubiquitination.These results indicate that association of PINK1 with SARM1 and TRAF6 is an important step for mitophagy.", citationTitle:"Mol Biol Cell. 2013 Sep;24(18):2772-84. doi: 10.1091/mbc.E13-01-0016. Epub 2013 Jul 24.", annotationSubgraph:["PINK1 subgraph"], pmid:"23885119", citationType:"PubMed", citationRef:"23885119"}}, {start: {_id:2145}, end: {_id:2118}, properties:{evidence:"However, RT-PCR demonstrated gene transcripts of the TREM2 associated signaling molecule DAP12 (XREF_FIG).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"17425404", citationType:"PubMed", citationRef:"17425404"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:379}, end: {_id:16}, properties:{annotationPdstage:["Sporadic_PD"], annotationCondition:["Normal Healthy State"], evidence:"There was no difference in the alpha-synuclein gene dosage between PD patients with high and low mRNA expression. Our study suggests that there was no significant alteration of alpha-synuclein mRNA expression in our sporadic PD patients compared to controls.", citationTitle:"Mov Disord. 2005 May;20(5):620-3.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationCell:["blood cell"], pmid:"15719423", citationType:"PubMed", citationRef:"15719423"}}, {start: {_id:379}, end: {_id:16}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"Alpha-synuclein mRNA was significantly diminished in the substantia nigra of patients with PD compared with control subjects but not in the cortex.Our findings suggest that decreased synuclein mRNA may be an early alteration in the SN in PD, and imply that decreased levels of the protein may play a role in the pathogenesis of sporadic cases of the disease.", citationTitle:"Mov Disord. 1999 May;14(3):417-22.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Cerebral Cortex"], pmid:"10348463", citationType:"PubMed", citationRef:"10348463"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:40}, end: {_id:41}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In UV-treated cells, Rad18 S409 phosphorylation was inhibited by a pharmacological JNK inhibitor. Conversely, ectopic expression of JNK and its upstream kinase mitogen-activated protein kinase kinase 4 led to DNA damage-independent Rad18 S409 phosphorylation. These results identify Rad18 as a novel JNK substrate.", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["MAPK subgraph"], pmid:"22456510", citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:38}, end: {_id:28}, properties:{annotationCondition:["Normal Healthy State"], evidence:"A Rad18 mutant harboring a Ser ‚Üí Ala substitution at S409 was compromised for PolŒ∑ association and did not redistribute PolŒ∑ to nuclear foci or promote PolŒ∑-PCNA interaction efficiently relative to wild-type Rad18. Rad18 S409A also failed to fully complement the UV sensitivity of Rad18-depleted cells. Taken together, these results show that Rad18 phosphorylation by JNK represents a novel mechanism for promoting TLS and DNA damage tolerance.", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"22456510", citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:120}, end: {_id:122}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We show that Wwp2-associated Gsc is a transcriptional activator of the key cartilage regulatory protein Sox6. Wwp2 interacts with Gsc to facilitate its mono-ubiquitylation, a post-translational modification required for optimal transcriptional activation of Gsc.", citationTitle:"Nat Cell Biol. 2011 Jan;13(1):59-65. doi: 10.1038/ncb2134. Epub 2010 Dec 19.", annotationSubgraph:["Transcription subgraph"], pmid:"21170031", citationType:"PubMed", citationRef:"21170031"}}, {start: {_id:130}, end: {_id:133}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Calcium channel voltage-dependent beta-2 subunit (CACNB2) (904) allows calcium influx, participating on the activation of NADPH oxidase, adhesion, degranulation and synthesis of IL-8", citationTitle:"Protein Pept Lett. 2012 Jun 1;19(6):663-72.", annotationSubgraph:["Reactive oxygen species subgraph", "Calcium-dependent signal transduction"], pmid:"22519539", citationType:"PubMed", citationRef:"22519539"}}, {start: {_id:202}, end: {_id:204}, properties:{evidence:"The PD-associated mutation, R1441C, located within the Roc domain, leads to an increase in LRRK2 kinase activity and a decrease in the rate of GTP hydrolysis, compared to the wild-type protein, in an in vitro assay. This finding suggests that the R1441C mutation may help stabilize an activated state of LRRK2. Additionally, LRRK2-mediated phosphorylation is stimulated upon binding of non-hydrolyzable GTP analogs, suggesting that LRRK2 is an MAPKKK-activated intramolecularly by its own GTPase. Since GTPases and MAPKKKs are upstream regulators of multiple signal transduction cascades, LRRK2 may play a central role in integrating pathways involved in neuronal cell signaling and the pathogenesis of PD.", citationTitle:"Exp Cell Res. 2007 Oct 1;313(16):3658-70. Epub 2007 Jul 19.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17706965", citationType:"PubMed", citationRef:"17706965"}}, {start: {_id:207}, end: {_id:208}, properties:{evidence:"The disease-associated I2020T mutant shows a significant increase in autophosphorylation of approximately 40% in comparison to wild-type protein in vitro. This suggests that the pathology of PD caused by the I2020T mutation is associated with an increase rather than a loss in LRRK2 kinase activity.", citationTitle:"Hum Mol Genet. 2006 Jan 15;15(2):223-32. Epub 2005 Dec 1.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16321986", citationType:"PubMed", citationRef:"16321986"}}, {start: {_id:196}, end: {_id:204}, properties:{evidence:"Therefore, we addressed the question if LRRK2 exhibits MAPKKK activity by systematically testing MAPKKs as candidate substrates, in vitro. We demonstrate that LRRK2 variants phosphorylate mitogen-activated protein kinase kinases (MAPKK), including MKK3 -4, -6 and -7. MKKs act upstream of the MAPK p38 and JNK mediating oxidative cell stress, neurotoxicity and apoptosis. The disease-associated LRRK2 G2019S and I2020T mutations show an increased phosphotransferase activity towards MKKs correlating with the activity shown for its autophosphorylation. Our findings present evidence of a new class of molecular targets for mutant LRRK2 that link to neurotoxicity, cellular stress, cytoskeletal dynamics and vesicular transport.", citationTitle:"J Neurochem. 2009 May;109(4):959-68. doi: 10.1111/j.1471-4159.2009.06024.x. Epub 2009 Mar 3.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19302196", citationType:"PubMed", citationRef:"19302196"}}, {start: {_id:207}, end: {_id:204}, properties:{evidence:"Therefore, we addressed the question if LRRK2 exhibits MAPKKK activity by systematically testing MAPKKs as candidate substrates, in vitro. We demonstrate that LRRK2 variants phosphorylate mitogen-activated protein kinase kinases (MAPKK), including MKK3 -4, -6 and -7. MKKs act upstream of the MAPK p38 and JNK mediating oxidative cell stress, neurotoxicity and apoptosis. The disease-associated LRRK2 G2019S and I2020T mutations show an increased phosphotransferase activity towards MKKs correlating with the activity shown for its autophosphorylation. Our findings present evidence of a new class of molecular targets for mutant LRRK2 that link to neurotoxicity, cellular stress, cytoskeletal dynamics and vesicular transport.", citationTitle:"J Neurochem. 2009 May;109(4):959-68. doi: 10.1111/j.1471-4159.2009.06024.x. Epub 2009 Mar 3.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19302196", citationType:"PubMed", citationRef:"19302196"}}, {start: {_id:196}, end: {_id:204}, properties:{evidence:"Pathogenic mutations in the leucine-rich repeat kinase-2 (LRRK2) gene cause autosomal-dominant and certain cases of sporadic Parkinson's disease (PD). The G2019S substitution in LRRK2 is the most common genetic determinant of PD identified so far, and maps to a specific region of the kinase domain called the activation segment. The prominent pathogenic G2019S mutation in LRRK2 results in altered autophosphorylation, and increased autophosphorylation and substrate phosphorylation, through a process that seems to involve reorganization of the activation segment. Our results suggest a molecular mechanistic explanation for how the G2019S mutation enhances the catalytic activity of LRRK2, thereby leading to pathogenicity. These findings have important implications for therapeutic strategies in PD.", citationTitle:"Hum Mol Genet. 2007 Sep 1;16(17):2031-9. Epub 2007 Jun 20.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17584768", citationType:"PubMed", citationRef:"17584768"}}, {start: {_id:234}, end: {_id:232}, properties:{evidence:"PINK1 mutants associated with recessive Parkinson's disease are defective in inhibiting mitochondrial release of cytochrome c.Mutations in PTEN-induced kinase 1 (PINK1) gene cause recessive familial type 6 of Parkinson's disease (PARK6). We investigated molecular mechanisms underlying PINK1 neuroprotective function and PARK6 mutation-induced loss of PINK1 function. Overexpression of wild- type PINK1 blocked mitochondrial release of apoptogenic cytochrome c, caspase-3 activation and apoptotic cell death induced by proteasome inhibitor MG132. N-terminal truncated PINK1 (NDelta35), which lacks mitochondrial localization sequence, did not block MG132-induced cytochrome c release and cytotoxicity. Despite mitochondrial expression, PARK6 mutant (E240K), (H271Q), (G309D), (L347P), (E417G) and C-terminal truncated (CDelta145) PINK1 failed to inhibit MG132-induced cytochrome c release and caspase-3 activation. Overexpression of wild-type PINK1 blocked cytochrome c release and cell death caused by atractyloside, which opens mitochondrial permeability transition pore (mPTP). PARK6 PINK1 mutants failed to inhibit atractyloside-induced cytochrome c release. These results suggest that PINK1 exerts anti-apoptotic effect by inhibiting the opening of mPTP and that PARK6 mutant PINK1 loses its ability to prevent mPTP opening and cytochrome c release.", citationTitle:"Neurobiol Dis. 2007 Nov;28(2):216-26. Epub 2007 Jul 17.", annotationSubgraph:["Caspase subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17707122", citationType:"PubMed", citationRef:"17707122"}}, {start: {_id:236}, end: {_id:232}, properties:{evidence:"PINK1 mutants associated with recessive Parkinson's disease are defective in inhibiting mitochondrial release of cytochrome c.Mutations in PTEN-induced kinase 1 (PINK1) gene cause recessive familial type 6 of Parkinson's disease (PARK6). We investigated molecular mechanisms underlying PINK1 neuroprotective function and PARK6 mutation-induced loss of PINK1 function. Overexpression of wild- type PINK1 blocked mitochondrial release of apoptogenic cytochrome c, caspase-3 activation and apoptotic cell death induced by proteasome inhibitor MG132. N-terminal truncated PINK1 (NDelta35), which lacks mitochondrial localization sequence, did not block MG132-induced cytochrome c release and cytotoxicity. Despite mitochondrial expression, PARK6 mutant (E240K), (H271Q), (G309D), (L347P), (E417G) and C-terminal truncated (CDelta145) PINK1 failed to inhibit MG132-induced cytochrome c release and caspase-3 activation. Overexpression of wild-type PINK1 blocked cytochrome c release and cell death caused by atractyloside, which opens mitochondrial permeability transition pore (mPTP). PARK6 PINK1 mutants failed to inhibit atractyloside-induced cytochrome c release. These results suggest that PINK1 exerts anti-apoptotic effect by inhibiting the opening of mPTP and that PARK6 mutant PINK1 loses its ability to prevent mPTP opening and cytochrome c release.", citationTitle:"Neurobiol Dis. 2007 Nov;28(2):216-26. Epub 2007 Jul 17.", annotationSubgraph:["Caspase subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17707122", citationType:"PubMed", citationRef:"17707122"}}, {start: {_id:238}, end: {_id:232}, properties:{evidence:"PINK1 mutants associated with recessive Parkinson's disease are defective in inhibiting mitochondrial release of cytochrome c.Mutations in PTEN-induced kinase 1 (PINK1) gene cause recessive familial type 6 of Parkinson's disease (PARK6). We investigated molecular mechanisms underlying PINK1 neuroprotective function and PARK6 mutation-induced loss of PINK1 function. Overexpression of wild- type PINK1 blocked mitochondrial release of apoptogenic cytochrome c, caspase-3 activation and apoptotic cell death induced by proteasome inhibitor MG132. N-terminal truncated PINK1 (NDelta35), which lacks mitochondrial localization sequence, did not block MG132-induced cytochrome c release and cytotoxicity. Despite mitochondrial expression, PARK6 mutant (E240K), (H271Q), (G309D), (L347P), (E417G) and C-terminal truncated (CDelta145) PINK1 failed to inhibit MG132-induced cytochrome c release and caspase-3 activation. Overexpression of wild-type PINK1 blocked cytochrome c release and cell death caused by atractyloside, which opens mitochondrial permeability transition pore (mPTP). PARK6 PINK1 mutants failed to inhibit atractyloside-induced cytochrome c release. These results suggest that PINK1 exerts anti-apoptotic effect by inhibiting the opening of mPTP and that PARK6 mutant PINK1 loses its ability to prevent mPTP opening and cytochrome c release.", citationTitle:"Neurobiol Dis. 2007 Nov;28(2):216-26. Epub 2007 Jul 17.", annotationSubgraph:["Caspase subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17707122", citationType:"PubMed", citationRef:"17707122"}}, {start: {_id:240}, end: {_id:232}, properties:{evidence:"PINK1 mutants associated with recessive Parkinson's disease are defective in inhibiting mitochondrial release of cytochrome c.Mutations in PTEN-induced kinase 1 (PINK1) gene cause recessive familial type 6 of Parkinson's disease (PARK6). We investigated molecular mechanisms underlying PINK1 neuroprotective function and PARK6 mutation-induced loss of PINK1 function. Overexpression of wild- type PINK1 blocked mitochondrial release of apoptogenic cytochrome c, caspase-3 activation and apoptotic cell death induced by proteasome inhibitor MG132. N-terminal truncated PINK1 (NDelta35), which lacks mitochondrial localization sequence, did not block MG132-induced cytochrome c release and cytotoxicity. Despite mitochondrial expression, PARK6 mutant (E240K), (H271Q), (G309D), (L347P), (E417G) and C-terminal truncated (CDelta145) PINK1 failed to inhibit MG132-induced cytochrome c release and caspase-3 activation. Overexpression of wild-type PINK1 blocked cytochrome c release and cell death caused by atractyloside, which opens mitochondrial permeability transition pore (mPTP). PARK6 PINK1 mutants failed to inhibit atractyloside-induced cytochrome c release. These results suggest that PINK1 exerts anti-apoptotic effect by inhibiting the opening of mPTP and that PARK6 mutant PINK1 loses its ability to prevent mPTP opening and cytochrome c release.", citationTitle:"Neurobiol Dis. 2007 Nov;28(2):216-26. Epub 2007 Jul 17.", annotationSubgraph:["Caspase subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17707122", citationType:"PubMed", citationRef:"17707122"}}, {start: {_id:242}, end: {_id:232}, properties:{evidence:"PINK1 mutants associated with recessive Parkinson's disease are defective in inhibiting mitochondrial release of cytochrome c.Mutations in PTEN-induced kinase 1 (PINK1) gene cause recessive familial type 6 of Parkinson's disease (PARK6). We investigated molecular mechanisms underlying PINK1 neuroprotective function and PARK6 mutation-induced loss of PINK1 function. Overexpression of wild- type PINK1 blocked mitochondrial release of apoptogenic cytochrome c, caspase-3 activation and apoptotic cell death induced by proteasome inhibitor MG132. N-terminal truncated PINK1 (NDelta35), which lacks mitochondrial localization sequence, did not block MG132-induced cytochrome c release and cytotoxicity. Despite mitochondrial expression, PARK6 mutant (E240K), (H271Q), (G309D), (L347P), (E417G) and C-terminal truncated (CDelta145) PINK1 failed to inhibit MG132-induced cytochrome c release and caspase-3 activation. Overexpression of wild-type PINK1 blocked cytochrome c release and cell death caused by atractyloside, which opens mitochondrial permeability transition pore (mPTP). PARK6 PINK1 mutants failed to inhibit atractyloside-induced cytochrome c release. These results suggest that PINK1 exerts anti-apoptotic effect by inhibiting the opening of mPTP and that PARK6 mutant PINK1 loses its ability to prevent mPTP opening and cytochrome c release.", citationTitle:"Neurobiol Dis. 2007 Nov;28(2):216-26. Epub 2007 Jul 17.", annotationSubgraph:["Caspase subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17707122", citationType:"PubMed", citationRef:"17707122"}}, {start: {_id:740}, end: {_id:743}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thereafter, Nrf2 translocates into the nucleus where it induces the transcription of G6PDH.", citationTitle:"Brain and nerve = Shinkei kenky?? no shinpo; Vol. 65; Iss. 12", annotationSubgraph:["Disaccharide metabolism subgraph", "Notch signaling subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"24323934", citationType:"PubMed", citationRef:"24323934"}}, {start: {_id:602}, end: {_id:604}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, the ATP13A2 protein has been recently identified as a potent modifier of the toxicity induced by alpha-synuclein in animal models of PD.", citationTitle:"Parkinsonism Relat Disord. 2012 Jan;18 Suppl 1:S4-6. doi: 10.1016/S1353-8020(11)70004-9.", annotationSubgraph:["Synuclein subgraph", "ATP13A2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22166450", citationType:"PubMed", citationRef:"22166450"}}, {start: {_id:775}, end: {_id:204}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Studies have indicated that a loss of GTP-binding capacity (mutation K1347A) produces an increase in kinase activity [25].", citationTitle:"Biochem Soc Trans. 2012 Oct;40(5):1129-33.", annotationSubgraph:["LRRK2 subgraph"], pmid:"22988877", citationType:"PubMed", citationRef:"22988877"}}, {start: {_id:638}, end: {_id:204}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additional alterations near the GTPase domain, including R1441G and R1514Q, resulted in increases in kinase activity. A nominal increase in kinase activity is observed with the I1371V mutation, although the increase is not significant when averaged over three experiments.", citationTitle:"Hum Mol Genet. 2007 Jan 15;16(2):223-32. Epub 2007 Jan 2.", annotationSubgraph:["LRRK2 subgraph"], pmid:"17200152", citationType:"PubMed", citationRef:"17200152"}}, {start: {_id:794}, end: {_id:204}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additional alterations near the GTPase domain, including R1441G and R1514Q, resulted in increases in kinase activity. A nominal increase in kinase activity is observed with the I1371V mutation, although the increase is not significant when averaged over three experiments.", citationTitle:"Hum Mol Genet. 2007 Jan 15;16(2):223-32. Epub 2007 Jan 2.", annotationSubgraph:["LRRK2 subgraph"], pmid:"17200152", citationType:"PubMed", citationRef:"17200152"}}, {start: {_id:786}, end: {_id:204}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additional alterations near the GTPase domain, including R1441G and R1514Q, resulted in increases in kinase activity. A nominal increase in kinase activity is observed with the I1371V mutation, although the increase is not significant when averaged over three experiments.", citationTitle:"Hum Mol Genet. 2007 Jan 15;16(2):223-32. Epub 2007 Jan 2.", annotationSubgraph:["LRRK2 subgraph"], pmid:"17200152", citationType:"PubMed", citationRef:"17200152"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:38}, end: {_id:28}, properties:{annotationCondition:["Normal Healthy State"], evidence:"A Rad18 mutant harboring a Ser âˆšÂ¢â€šÃ„â€ â€šÃ„Ã´ Ala substitution at S409 was compromised for PolâˆšÃ©Â¬âˆ‘ association and did not redistribute PolâˆšÃ©Â¬âˆ‘ to nuclear foci or promote PolâˆšÃ©Â¬âˆ‘-PCNA interaction efficiently relative to wild-type Rad18. Rad18 S409A also failed to fully complement the UV sensitivity of Rad18-depleted cells. Taken together, these results show that Rad18 phosphorylation by JNK represents a novel mechanism for promoting TLS and DNA damage tolerance.", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"22456510", annotationCellline:["NCI-H1299", "HCT116"], citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:973}, end: {_id:981}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:985}, end: {_id:981}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:988}, end: {_id:981}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:991}, end: {_id:981}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:1018}, end: {_id:1020}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In a recent study we investigated the effect of a diet containing high cholesterol on gene expression in the brain of mice (Mateos et al., 2009). The altered genes included a number of molecules linked to AD pathology and others of potential interest for neurodegeneration. Notably, the expression of the gene coding for Activity-regulated cytoskeleton-associated protein (Arc) was found to be significantly suppressed (Mateos et al., 2009). This is of interest in view of the fact that Arc is believed to be important for consolidation memory formation and is reduced in the brain of patients who have died of AD (Ginsberg et al., 2000 and Guzowski et al., 2000). In addition Arc protein levels were reduced in hippocampal and cortical areas of the treated mice. Arc expression has been shown to be positively regulated by the N-methyl-d-aspartate receptor (Nmdar), the levels of which were also reduced in the brain of the treated mice. Addition of low concentrations of 27-OHC to cultured hippocampal neurons essentially recapitulated the in vivo effects on the expression of Arc and Nmdar. The results are consistent with the possibility that 27-OHC âˆšÂ¢â€šÃ‡Â¨Ã€ÃºtranslatesâˆšÂ¢â€šÃ‡Â¨â€šÃ‘Â¢ the effects of peripheral high cholesterol to central changes, e.g. on Arc and Nmdar. This could be one of the mechanisms by which hypercholesterolemia contributes to neurodegenerative diseases.", citationTitle:"Mol Aspects Med. 2009 Jun;30(3):171-9. doi: 10.1016/j.mam.2009.02.001. Epub 2009 Feb 25.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Hippocampus"], pmid:"19248803", citationType:"PubMed", citationRef:"19248803"}}, {start: {_id:1039}, end: {_id:1041}, properties:{evidence:"Na(v)1.7 sodium channels can amplify weak stimuli in neurons and act as threshold channels for firing action potentials. Neurotrophic factors and pro-nociceptive cytokines that are released during development and under pathological conditions activate mitogen- activated protein kinases (MAPKs). Previous studies have shown that MAPKs can transduce developmental or pathological signals by regulating transcription factors that initiate a gene expression response, a long-term effect, and directly modulate neuronal ion channels including sodium channels, thus acutely regulating dorsal root ganglion (DRG) neuron excitability. For example, neurotrophic growth factor activates (phosphorylates) ERK1/2 MAPK (pERK1/2) in DRG neurons, an effect that has been implicated in injury-induced hyperalgesia. However, the acute effects of pERK1/2 on sodium channels are not known. We have shown previously that activated p38 MAPK (pp38) directly phosphorylates Na(v)1.6 and Na(v)1.8 sodium channels and regulates their current densities without altering their gating properties. We now report that acute inhibition of pERK1/2 regulates resting membrane potential and firing properties of DRG neurons. We also show that pERK1 phosphorylates specific residues within L1 of Na(v)1.7, inhibition of pERK1/2 causes a depolarizing shift of activation and fast inactivation of Na(v)1.7 without altering current density, and mutation of these L1 phosphoacceptor sites abrogates the effect of pERK1/2 on this channel. Together, these data are consistent with direct phosphorylation and modulation of Na(v)1.7 by pERK1/2, which unlike the modulation of Na(v)1.6 and Na(v)1.8 by pp38, regulates gating properties of this channel but not its current density and contributes to the effects of MAPKs on DRG neuron excitability.", citationTitle:"J Neurosci. 2010 Feb 3;30(5):1637-47. doi: 10.1523/JNEUROSCI.4872-09.2010.", annotationMeshdisease:["Hyperglycemia"], pmid:"20130174", citationType:"PubMed", citationRef:"20130174"}}, {start: {_id:1134}, end: {_id:768}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, we found that FAF1 deficiency blocked PD-linked biochemical events, including caspase activation, ROS generation, JNK activation and cell death.", citationComment:"Accumulation of the parkin substrate, FAF1, plays a key role in the dopaminergic neurodegeneration.", citationTitle:"Human molecular genetics; Vol. 22; Iss. 8", annotationSubgraph:["Apoptosis signaling subgraph", "Caspase subgraph"], citationPubDate:"2013-04-15", pmid:"23307929", citationAuthorList:"Jee-Won Sul|Min-Young Park|Juhee Shin|Young-Ran Kim|Sung-Eun Yoo|Young-Yun Kong|Ki-Sun Kwon|Young Ho Lee|Eunhee Kim", citationType:"PubMed", citationRef:"23307929"}}, {start: {_id:1134}, end: {_id:1136}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, we found that FAF1 deficiency blocked PD-linked biochemical events, including caspase activation, ROS generation, JNK activation and cell death.", citationComment:"Accumulation of the parkin substrate, FAF1, plays a key role in the dopaminergic neurodegeneration.", citationTitle:"Human molecular genetics; Vol. 22; Iss. 8", annotationSubgraph:["Apoptosis signaling subgraph", "MAPK subgraph"], citationPubDate:"2013-04-15", pmid:"23307929", citationAuthorList:"Jee-Won Sul|Min-Young Park|Juhee Shin|Young-Ran Kim|Sung-Eun Yoo|Young-Yun Kong|Ki-Sun Kwon|Young Ho Lee|Eunhee Kim", citationType:"PubMed", citationRef:"23307929"}}, {start: {_id:1416}, end: {_id:232}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondria participate in apoptosis through a range of mechanisms that vary between vertebrates and invertebrates. In vertebrates, they release intermembrane space proteins, such as cytochrome c, to promote caspase activation in the cytosol. This process is the result of the loss of integrity of the outer mitochondrial membrane caused by proapoptotic members of the Bcl-2 family. This event is always accompanied by a fissioning of the organelle. Fission of mitochondria has also been reported to participate in apoptosis in Drosophila and Caenorhabditis elegans.", citationTitle:"Dev Cell. 2011 Jul 19;21(1):92-101. doi: 10.1016/j.devcel.2011.06.017.", annotationSubgraph:["Caspase subgraph", "Mitochondrial subgraph"], annotationMeshanatomy:["Cytosol"], pmid:"21763611", citationType:"PubMed", citationRef:"21763611"}}, {start: {_id:1459}, end: {_id:1461}, properties:{annotationCondition:["Normal Healthy State"], evidence:"phosphorylation of Parkin results in the activation of its E3 ligase activity", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:1445}, end: {_id:1488}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 localization to peroxisomes or lysosomes was sufficient to recruit Parkin and stimulate its E3 ligase activity, as evidenced by organelle ubiquitination.", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSpecies:["7227"], annotationMeshanatomy:["Mitochondria", "Peroxisomes", "Lysosomes"], pmid:"22280891", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"22280891"}}, {start: {_id:221}, end: {_id:1461}, properties:{evidence:"antimycin A-induced ROS may cause PINK1 buildup at local or individual import channels. This interplay between local and global PINK1 accumulation may regulate the magnitudes of subsequent parkin recruitment and ubiquitin ligase activity.", citationTitle:"EMBO J. 2014 Feb 18;33(4):282-95. doi: 10.1002/embj.201385902. Epub 2014 Jan 20.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"24446486", citationType:"PubMed", citationRef:"24446486"}}, {start: {_id:271}, end: {_id:1624}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in the parkin gene are a major cause of autosomal recessive Parkinson's disease. Here we show that the E3 ubiquitin ligase parkin activates signaling through the IkappaB kinase (IKK)/nuclear factor kappaB (NF-kappaB) pathway.Our analysis revealed that activation of this signaling cascade is causally linked to the neuroprotective potential of parkin. Inhibition of NF-kappaB activation by an IkappaB super-repressor or a kinase-inactive IKKbeta interferes with the neuroprotective activity of parkin.Furthermore, pathogenic parkin mutants with an impaired neuroprotective capacity show a reduced ability to stimulate NF-kappaB-dependent transcription. Finally, we present evidence that parkin interacts with and promotes degradation- independent ubiquitylation of IKKgamma/NEMO (NF-kappaB essential modifier) and TRAF2 [TNF (tumor necrosis factor) receptor-associated factor 2], two critical components of the NF-kappaB pathway. Thus, our results support a direct link between the neuroprotective activity of parkin and ubiquitin signaling in the IKK/NF-kappaB pathway.", citationTitle:"J Neurosci. 2007 Feb 21;27(8):1868-78.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"17314283", citationType:"PubMed", citationRef:"17314283"}}, {start: {_id:1655}, end: {_id:1659}, properties:{evidence:"While ROS are required for glucose metabolism and metastasis in triple-negative breast cancers (9), decreased SirT3 levels concomitant with high ROS levels are frequently observed in all breast cancers (8). Based on these findings, SirT3 is considered a tumor suppressor (5, 8). SirT3 regulates the activity of magnesium superoxide dismutase (MnSOD), which detoxifies superoxide to hydrogen peroxide (5, 7, 10,â€“14). Moreover, SirT3 has been linked to augmented transcription of MnSOD and catalase, both known targets of the transcription factor FOXO3A (15). The SirT3-dependent deacetylation of FOXO3A promotes both its nuclear translocation and its transcriptional activity (16, 17). Therefore, mechanistically, the reduction of SirT3 levels leads to an elevation in ROS levels by compromising the mitochondrial antioxidant machinery.", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Unfolded protein response subgraph", "Apoptosis signaling subgraph"], annotationMeshdisease:["Breast Neoplasms"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1660}, end: {_id:1662}, properties:{evidence:"USP15 has previously been shown to activate the TGF-Î² pathway through deubiquitination of the type I TGF-Î² receptor and receptor-activated SMAD proteins (26,27).", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:221}, end: {_id:1738}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Expression of human PINK1, but not its clinical mutant G309D rescues mobilization of RP vesicles", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:601}, end: {_id:749}, properties:{evidence:"HSD17B10 is also thought to have a role in adult- onset neurodegenerative disorders, such as Alzheimerâ€™s disease, in which it may mediate amyloid Î²-driven mitochondrial toxicity,25,29,30 and PD, in which it is downregulated in the ventral midbrain.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Amyloidogenic subgraph", "Mitochondrial subgraph"], annotationMeshdisease:["Alzheimer Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1405}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The mitochondrion-protecting function of HSD17B10 requires mitochondrial elongation and not the enzymatic activity of the protein.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1818}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We explored the mechanisms by which HSD17B10 preserves mitochondrial function, by investigating the effects of three amino-acid substitutions in HSD17B10 with different impacts on catalytic activity (D86G, Q165H, R130C).26 The three protein variants were, as expected, located in the mitochondria, as indicated by the correspond- ing Manderâ€™s coefficients (Figures 8a and c); like the normal protein, they were found in the mitochondrial matrix, some- times associated with the inner MM", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1820}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We explored the mechanisms by which HSD17B10 preserves mitochondrial function, by investigating the effects of three amino-acid substitutions in HSD17B10 with different impacts on catalytic activity (D86G, Q165H, R130C).26 The three protein variants were, as expected, located in the mitochondria, as indicated by the correspond- ing Manderâ€™s coefficients (Figures 8a and c); like the normal protein, they were found in the mitochondrial matrix, some- times associated with the inner MM", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1822}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We explored the mechanisms by which HSD17B10 preserves mitochondrial function, by investigating the effects of three amino-acid substitutions in HSD17B10 with different impacts on catalytic activity (D86G, Q165H, R130C).26 The three protein variants were, as expected, located in the mitochondria, as indicated by the correspond- ing Manderâ€™s coefficients (Figures 8a and c); like the normal protein, they were found in the mitochondrial matrix, some- times associated with the inner MM", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1634}, end: {_id:1971}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consequently, this leads to the activation of TANK-binding kinase 1 (TBK1) and phosphorylation of interferon regulatory factor 3 (IRF3), both of which constitutively associate with cytosolic chaperone Hsp90. It remains largely unknown how MAVS activates TBK1/IRF3. In this study, we identified translocases of outer membrane 70 (Tom70), a mitochondrial import receptor, to interact with MAVS upon RNA virus infection. Ectopic expression or knockdown of Tom70 could enhance or impair IRF3-mediated gene expression, respectively.", citationTitle:"Cell Res. 2010 Sep;20(9):994-1011. doi: 10.1038/cr.2010.103. Epub 2010 Jul 13.", annotationSubgraph:["Interferon signaling subgraph", "Nuclear factor Kappa beta subgraph"], pmid:"20628368", citationType:"PubMed", citationRef:"20628368"}}, {start: {_id:1462}, end: {_id:768}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In cells with knocked-down VDAC1, caspase-1 activation and IL-1b secretion were considerably impaired for all inflammasome activators examined. As a consequence of VDAC1 knockdown, mitochondrial ROS was highly diminished . In contrast to the NLRP3 inflammasome, VDAC1 was not essential for the activation of the IPAF or the AIM2 inflammasome. A significant reduction of IL-1b secretion was also seen in cells where VDAC2 was knocked down .", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Caspase subgraph"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}, {start: {_id:1416}, end: {_id:436}, properties:{evidence:"Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Mitochondrial subgraph", "Bcl-2 subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}, {start: {_id:231}, end: {_id:436}, properties:{evidence:"At nanomolar concentrations, a-SN protected neurons against serum deprivation, oxidative stress, and excitotoxicity through the PI3/Akt signaling pathway, and its protective effect was increased by Bcl-2 overexpression. Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity. This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release and caspase activation and also by microglia-mediated inflammatory responses via the NFkappaB and mitogen-activated protein kinase pathways.", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Caspase subgraph", "Bcl-2 subgraph", "Mitochondrial subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}, {start: {_id:196}, end: {_id:204}, properties:{evidence:"The most prevalent LRRK2(G2019S) mutation has repeatedly been shown to enhance kinase activity and neurotoxicity", citationTitle:"J Neurochem. 2009 Sep;110(5):1514-22. doi: 10.1111/j.1471-4159.2009.06235.x. Epub 2009 Jun 22.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19545277", citationType:"PubMed", citationRef:"19545277"}}, {start: {_id:2035}, end: {_id:2038}, properties:{evidence:"Recently, EFhd2 was shown to promote cell motility by modulating the activity of Rac1, Cdc42, and RhoA.", citationTitle:"Front Neurosci. 2016 Mar 31;10:150. doi: 10.3389/fnins.2016.00150. eCollection 2016.", annotationSubgraph:["RhoA subgraph", "Apoptosis signaling subgraph"], pmid:"27064956", citationType:"PubMed", citationRef:"27064956"}}, {start: {_id:2035}, end: {_id:2040}, properties:{evidence:"Recently, EFhd2 was shown to promote cell motility by modulating the activity of Rac1, Cdc42, and RhoA.", citationTitle:"Front Neurosci. 2016 Mar 31;10:150. doi: 10.3389/fnins.2016.00150. eCollection 2016.", annotationSubgraph:["RhoA subgraph", "Apoptosis signaling subgraph"], pmid:"27064956", citationType:"PubMed", citationRef:"27064956"}}, {start: {_id:2035}, end: {_id:2042}, properties:{evidence:"Recently, EFhd2 was shown to promote cell motility by modulating the activity of Rac1, Cdc42, and RhoA.", citationTitle:"Front Neurosci. 2016 Mar 31;10:150. doi: 10.3389/fnins.2016.00150. eCollection 2016.", annotationSubgraph:["RhoA subgraph", "Apoptosis signaling subgraph"], pmid:"27064956", citationType:"PubMed", citationRef:"27064956"}}, {start: {_id:2118}, end: {_id:2127}, properties:{evidence:"TREM-2 and DAP12 promotes upregulation of CC chemokine receptor 7, partial DC maturation, and DC survival through activation of protein tyrosine kinases and extracellular signal regulated kinase.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2129}, end: {_id:2127}, properties:{evidence:"TREM-2 and DAP12 promotes upregulation of CC chemokine receptor 7, partial DC maturation, and DC survival through activation of protein tyrosine kinases and extracellular signal regulated kinase.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2127}, properties:{evidence:"TREM-2 and DAP12-mediated signaling promotes survival of DCs and upregulation of CCR7, MHC class II, CD86, and CD40.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2127}, properties:{evidence:"TREM-2 induced upregulation of CCR7, CD86, class II, and CD40, while cell surface expression of ICAM-1 and CD83 was not increased (XREF_FIG, red bars).", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2132}, properties:{evidence:"TREM-2 induced upregulation of CCR7, CD86, class II, and CD40, while cell surface expression of ICAM-1 and CD83 was not increased (XREF_FIG, red bars).", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2133}, properties:{evidence:"TREM-2 induced upregulation of CCR7, CD86, class II, and CD40, while cell surface expression of ICAM-1 and CD83 was not increased (XREF_FIG, red bars).", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2127}, properties:{evidence:"TREM-2 induces upregulation of CCR7, which plays a pivotal role in directing DCs from the periphery to the T cell rich areas of draining lymph nodes 1011121314.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2121}, properties:{evidence:"To see whether TREM-2 activates p38 and SAPK, we crosslinked TREM-2 on DCs with F (ab ') 2 29E3 and analyzed tyrosine phosphorylation of p38 and SAPK by Western blot analysis.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2125}, properties:{evidence:"To see whether TREM-2 activates p38 and SAPK, we crosslinked TREM-2 on DCs with F (ab ') 2 29E3 and analyzed tyrosine phosphorylation of p38 and SAPK by Western blot analysis.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2122}, properties:{evidence:"To study whether TREM-2 activates the IkappaBalpha and NF-kappaB pathway, we stimulated DCs through TREM-2 and analyzed the phosphorylation of IkappaBalpha by Western blot analysis.", annotationSubgraph:["Inflammatory response subgraph", "Nuclear factor Kappa beta subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}] AS row
