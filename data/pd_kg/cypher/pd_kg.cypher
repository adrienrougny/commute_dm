UNWIND [{start: {_id:1689}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Animals defective in ceramide biosynthesis are deficient in mitochondrial surveillance, and addition of particular ceramides can rescue the surveillance defects. Ceramide can also rescue the mitochondrial surveillance defects of other gene inactivations, mapping these gene activities upstream of ceramide.", citationTitle:"Nature. 2014 Apr 17;508(7496):406-10. doi: 10.1038/nature13204. Epub 2014 Apr 2.", annotationSubgraph:["Mitochondria fusion subgraph"], pmid:"24695221", citationType:"PubMed", citationRef:"24695221"}}, {start: {_id:1986}, end: {_id:1982}, properties:{evidence:"Notably, both ROS generation and inflammasome activation are suppressed when mitochondrial activity is dysregulated by inhibition of the voltage-dependent anion channel.", citationTitle:"Nature. 2011 Jan 13;469(7329):221-5. doi:10.1038/nature09663. Epub 2010 Dec 1. Erratum in: Nature. 2011 Jul 7;475(7354):122.", annotationSubgraph:["Caspase subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21124315", citationType:"PubMed", citationRef:"21124315"}}] AS row
