UNWIND [{start: {_id:1286}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Sensitivity analysis revealed that the overall association between the MTHFR A1298C polymorphism and PD was unchanged after an exclusion of the individual study. It suggested that the results were robust.", citationTitle:"J Neurol Sci. 2013 Dec 15;335(1-2):14-21. doi: 10.1016/j.jns.2013.09.006. Epub 2013 Sep 12.", annotationSubgraph:["Folate metabolic subgraph", "Vitamin subgraph"], annotationSpecies:["10090"], pmid:"24064257", citationType:"PubMed", citationRef:"24064257"}}, {start: {_id:1330}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In conclusion, we showed that GAK SNP rs1564282 does not contribute to the risk of PD among Han Chinese in Taiwan and Singapore. However, further studies of this and other SNPs within the GAK gene in other ethnic Chinese populations may be useful to validate our findings.", citationTitle:"PLoS One. 2013 Jun 24;8(6):e67506. doi: 10.1371/journal.pone.0067506. Print 2013.", annotationSubgraph:["Cell cycle subgraph"], annotationSpecies:["9606"], pmid:"23826309", citationType:"PubMed", annotationRace:["Han Chinese in Singapore"], citationRef:"23826309"}}] AS row
