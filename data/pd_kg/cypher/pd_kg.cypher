UNWIND [{start: {_id:1829}, end: {_id:634}, properties:{annotationCondition:["Normal Healthy State"], evidence:"interaction with the TOM complex was detected under conditions associated with PINK1 accumulation on the OMM (HSD17B10 overproduction or CCCP treatment), consistent with unmasking due to the mitochondrial import mechanism being overwhelmed.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1877}, end: {_id:1896}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, the knockdown of AIF or CHCHD4 had similar effects on the abundance of CHCHD4 substrates (Figures S3Câ€“ S3E) NDUFA8 (Szklarczyk et al., 2011), COX17, and DDP1 (Hofmann et al., 2005), which were not detectable in the AIF/ CHCHD4 immunoprecipitate (Figure S3F), presumably because the interaction between CHCHD4 and its substrates is rather transient (Koch and Schmid, 2014; Sideris et al., 2009).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Mitochondrial subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1877}, end: {_id:1897}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, the knockdown of AIF or CHCHD4 had similar effects on the abundance of CHCHD4 substrates (Figures S3Câ€“ S3E) NDUFA8 (Szklarczyk et al., 2011), COX17, and DDP1 (Hofmann et al., 2005), which were not detectable in the AIF/ CHCHD4 immunoprecipitate (Figure S3F), presumably because the interaction between CHCHD4 and its substrates is rather transient (Koch and Schmid, 2014; Sideris et al., 2009).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Mitochondrial subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1877}, end: {_id:1898}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, the knockdown of AIF or CHCHD4 had similar effects on the abundance of CHCHD4 substrates (Figures S3Câ€“ S3E) NDUFA8 (Szklarczyk et al., 2011), COX17, and DDP1 (Hofmann et al., 2005), which were not detectable in the AIF/ CHCHD4 immunoprecipitate (Figure S3F), presumably because the interaction between CHCHD4 and its substrates is rather transient (Koch and Schmid, 2014; Sideris et al., 2009).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Ubiquitin subgraph", "Apoptosis signaling subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1877}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"AIF depletion had no effect on the half-life of CHCHD4 after translation blockade with CHX, excluding that the absence of AIF enhances the degradation of CHCHD4", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Mitochondrial subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1906}, end: {_id:1589}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Second, we developed a protein co-translation assay in which unstable (non-mitochondrial) GFP was placed down- stream of CHCHD4-b on the same mRNA, in the same open reading frame, finding that AIF deficiency reduced the abundance of GFP in conditions in which it affected CHCHD4-b expression.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:621}, end: {_id:690}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Two months after surgery, Nrf2(-/-) mice exhibited exacerbated degeneration of nigral dopaminergic neurons and increased dystrophic dendrites, reminiscent of Lewy neurites, which correlated with impaired proteasome gene expression and activity.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 14", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"22513881", citationType:"PubMed", citationRef:"22513881"}}, {start: {_id:804}, end: {_id:805}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PARL is a mitochondrial resident rhomboid serine protease, and it has been reported to mediate the cleavage of the PINK1.", citationTitle:"Oxid Med Cell Longev. 2013;2013:601587. doi: 10.1155/2013/601587. Epub 2013 Feb 27.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], pmid:"23533695", citationType:"PubMed", citationRef:"23533695"}}, {start: {_id:934}, end: {_id:936}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we investigate the role of Hepatocyte growth factor-Regulated tyrosine kinase Substrate (Hrs), a regulator of RTK trafficking, in VEGF and insulin signaling. We report that ectopic expression of Hrs increases VEGF-R2 and IR number and tyrosine phosphorylation, leading to amplification of their downstream signaling. The UIM (Ubiquitin Interacting Motif) domain of Hrs is required for Hrs-induced increases in VEGF-R2, but not in IR. Furthermore, Hrs is tyrosine-phosphorylated in response to VEGF and insulin. We show that the UIM domain is required for Hrs phosphorylation in response to VEGF, but not to insulin. Importantly, Hrs co-localizes with both VEGF-R2 and IR and co-immunoprecipitates with both in a manner independent of the Hrs-UIM domain. Finally, we demonstrate that Hrs inhibits Nedd4-mediated VEGF-R2 degradation and acts additively with Grb10. We conclude that Hrs is a positive regulator of VEGF-R2 and IR signaling and that ectopic expression of Hrs protects both VEGF-R2 and IR from degradation.", citationTitle:"Exp Cell Res. 2007 May 15;313(9):1927-42. Epub 2007 Mar 21.", annotationSubgraph:["Cytokine signaling subgraph", "Vascular endothelial growth factor subgraph"], pmid:"17445799", citationType:"PubMed", citationRef:"17445799"}}, {start: {_id:1072}, end: {_id:1085}, properties:{evidence:"We found that overexpression of Mtmr2 prevents the degradation of the epidermal growth factor receptor (EGFR) and leads to sustained Akt activation whereas Erk activation is not affected.", citationComment:"The CMT4B disease-causing proteins MTMR2 and MTMR13/SBF2 regulate AKT signalling.", citationTitle:"Journal of cellular and molecular medicine; Vol. 15; Iss. 2", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Phosphatidylinositol 3 subgraph"], annotationMeshdisease:["Charcot-Marie-Tooth Disease"], citationPubDate:"2011-02-01", pmid:"19912440", citationAuthorList:"Philipp Berger|Kristian Tersar|Kurt Ballmer-Hofer|Ueli Suter", citationType:"PubMed", citationRef:"19912440"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:222}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 protects against oxidative stress by phosphorylating mitochondrial chaperone TRAP1. Mutations in the PTEN induced putative kinase 1 (PINK1) gene cause an autosomal recessive form of Parkinson disease (PD). So far, no substrates of PINK1 have been reported, and the mechanism by which PINK1 mutations lead to neurodegeneration is unknown. Here we report the identification of TNF receptor-associated protein 1 (TRAP1), a mitochondrial molecular chaperone also known as heat shock protein 75 (Hsp75), as a cellular substrate for PINK1 kinase. PINK1 binds and colocalizes with TRAP1 in the mitochondria and phosphorylates TRAP1 both in vitro and in vivo. We show that PINK1 protects against oxidative-stress-induced cell death by suppressing cytochrome c release from mitochondria, and this protective action of PINK1 depends on its kinase activity to phosphorylate TRAP1. Moreover, we find that the ability of PINK1 to promote TRAP1 phosphorylation and cell survival is impaired by PD-linked PINK1 G309D, L347P, and W437X mutations. Our findings suggest a novel pathway by which PINK1 phosphorylates downstream effector TRAP1 to prevent oxidative-stress- induced apoptosis and implicate the dysregulation of this Mitochondrial subgraph in PD pathogenesis.", citationTitle:"PLoS Biol. 2007 Jul;5(7):e172. Epub 2007 Jun 19.", annotationSubgraph:["PINK1 subgraph", "Response to oxidative stress"], pmid:"17579517", citationType:"PubMed", citationRef:"17579517"}}, {start: {_id:500}, end: {_id:503}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hyperhomocysteine induces oxidative stress via NMDA receptor-mediated neuronal nitric oxide synthase activation and formation of radicals, which leads to mitochondrial dysfunction and the release of Cytochrome c and of apoptosis inducing factor (AIF), ultimately causing cell apoptosis [24].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshanatomy:["Serum"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:500}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hyperhomocysteine induces oxidative stress via NMDA receptor-mediated neuronal nitric oxide synthase activation and formation of radicals, which leads to mitochondrial dysfunction and the release of Cytochrome c and of apoptosis inducing factor (AIF), ultimately causing cell apoptosis [24].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationMeshanatomy:["Serum"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:590}, end: {_id:515}, properties:{evidence:"Considerable experimental evidence suggests that a significant contributor to dopaminergic neuronal loss in the PD brain is ROS, which result from dopamine metabolism, low glutathione (GSH), and high levels of iron and calcium in the SNpc.", citationTitle:"J Parkinsons Dis. 2013;3(4):461-91. doi: 10.3233/JPD-130230.", annotationSubgraph:["Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"24252804", citationType:"PubMed", citationRef:"24252804"}}, {start: {_id:712}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It has also been shown that beta-synucleins can protect against oxidative stress via the inactivation of the c-Jun N-terminal kinase signalling pathway [9] and [10].", citationTitle:"Biochemical and biophysical research communications; Vol. 441; Iss. 2", annotationSubgraph:["Synuclein subgraph"], pmid:"24140056", citationType:"PubMed", citationRef:"24140056"}}, {start: {_id:270}, end: {_id:881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"oxidative damage critically contributes to neuronal loss in PD.", citationTitle:"Pharmacol Res. 2011 May;63(5):439-44. doi: 10.1016/j.phrs.2011.01.004. Epub 2011 Jan 12.", pmid:"21237271", citationType:"PubMed", citationRef:"21237271"}}, {start: {_id:270}, end: {_id:328}, properties:{evidence:"Elevated Hcy levels can lead to prooxidative activity, most probably through direct interaction with N-methyl-D-aspartate (NMDA) receptors and sensitization of dopaminergic neurons to age-related dysfunction and death.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:1426}, end: {_id:1427}, properties:{evidence:"Mitochondrial depolarization promotes Parkin- and PTEN-induced kinase 1 (PINK1)-dependent polyubiquitination of multiple proteins on mitochondrial outer membranes, resulting in the removal of defective mitochondria via mitophagy.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1538-53. doi: 10.1016/j.celrep.2014.10.046. Epub 2014 Nov 13.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456142", citationType:"PubMed", citationRef:"25456142"}}, {start: {_id:1426}, end: {_id:1427}, properties:{evidence:"Mutations in the Park2 gene, encoding the E3 ubiquitinâ€�ligase parkin, are responsible for a familial form of Parkinson's disease (PD). Parkinâ€�mediated ubiquitination is critical for the efficient elimination of depolarized dysfunctional mitochondria by autophagy (mitophagy).", citationTitle:"EMBO J. 2014 Nov 3;33(21):2473-91. doi: 10.15252/embj.201489729. Epub 2014 Sep 12.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"25216678", citationType:"PubMed", citationRef:"25216678"}}, {start: {_id:396}, end: {_id:1687}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We asked how C18:0 affects JNK or HUWE1 activity. Endoplasmic reticulum stress can activate JNK.", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Mitochondria fusion subgraph"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:1687}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"JNK inhibition blocked the ability of gambogic acid to induce mitochondrial fragmentation (Fig. 3j and Extended Data Fig. 9e). In sum, these data suggest that TFR1 induces mitochondrial fragmentation via JNK, and that this is inhibited by TFR1 stearoylation (Fig. 3k).", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Wnt signaling subgraph"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:1745}, end: {_id:1699}, properties:{evidence:"Consistent with this hypothesis, ATP levels in pink1B9 mutant flies are reduced compared to controls (Clark et al, 2006), providing an explanation for the neuronal defects we observe in pink1 mutants.Thus, one could postulate that compensation mechanisms allow systems to cope for many years with the defect, and additional stress, caused by ageing and/or oxidative dopamine metabolism, probably leads to effective impairment of the system", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1749}, end: {_id:1757}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, vitamin K2 is sufficient for electron transport downstream of a eukaryotic ETC complex, resulting in improved mitochondrial oxygen Fig. 4. Vitamin K2 acts as a mitochondrial electron carrier. Immunolabeling of S2 Drosophila cells (A) and Western blot of fractionations (B) transfected with Heix-His and labeled with anti-His and antiâ€“ATP synthase b (A). (C) ATP levels of heix1/Df and heix/Df;da>heix (n = 8). (D) Time-dependent ATP production in mitochondria isolated from heix1/Df mutant larvae (n = 8). (E) Measurements of complex II activity [normalized to citrate synthase activity (CS)] using a dose-response of MK-4 as electron carrier (n = 4). (F) Measurements of complex II activity using ubiquinone (0.13 mM; Q-10, light gray) or MK-4 (0.35 mM, gray) as electron carrier (n = 4). (G) Time- dependent ATP production in mitochondria isolated from pink1B9 mutant flies. Reactions are either not supplemented with MK-4 (black) or supplemented with 0.15 mM (dark gray) or 0.35 mM MK-4 (light gray) (n = 8). (H) Adenosine diphosphateâ€“stimulated complex Iâ€“driven respiration rate (oxygen consumption) in mitochondria isolated from pink1RV controls and pink1B9 mutants placed for 72 hours on MK-4 medium or on control medium. Mitochondria from vitamin K2-fed mutant flies consume oxygen faster. Data are mean normalized to controls in (C) and (H) or mean in (D) to (G). Error bars, SEM. ANOVA/Dunnett: *P < 0.05, **P < 0.01, ***P < 0.001.consumption and energy production, particular- ly in pink1B9 mutants.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["PINK1 subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1760}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our findings show that the PINK1â€“Parkin pathway promotes mitophagy in vivo and, unexpectedly, also promotes selective turnover of mitochondrial RC subunits.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Mitophagy subgraph", "PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1760}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Genetic studies in Drosophila determined that PINK1 acts upstream of Parkin in a common pathway to regulate mitochondrial morphology and integrity (3â€“8), and led to the hypothesis that this pathway promotes the selective degradation of damaged mitochondria (6, 9).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], annotationSpecies:["7227"], annotationMeshanatomy:["Mitochondria"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1760}, end: {_id:551}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Together, our findings indicate that the PINK1â€“Parkin pathway promotes mitochondrial autophagy in vivo and also mediates selective turnover of mitochondrial RC proteins.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1760}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We have provided evidence that the PINK1â€“Parkin pathway promotes mitophagy in vivo and described an additional role for this pathway in the selective nonmitophagic turnover of RC proteins.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Mitophagy subgraph", "PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1426}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin recruitment and ubiquitylation may, in turn, facilitate HSD17B10 import", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1816}, end: {_id:1774}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondrial elongation is an adaptive prosurvival mechanism associated with a better bioenergetic response to stress.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1774}, end: {_id:772}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondrial elongation is an adaptive prosurvival mechanism associated with a better bioenergetic response to stress.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1901}, end: {_id:1902}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutation of all functional cysteines contained in CHCHD4 abrogated the capacity of the MC construct to restore the mitochondrial defects of AIF-deficient cells (Figure S6C), underscoring the relevance of the cysteine-dependent oxidoreductase activity of CHCHD4.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1605}, end: {_id:269}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our study supports the notion that parkin has a role in the interorganellar crosstalk between the ER and mitochondria to promote cell survival under stress, suggesting that both ER and mitochondrial stress can contribute to the pathogenesis of Parkinsonâ€™s disease.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin protects cells from ER stressinduced cell death.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1915}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Conceptually, upregulation of parkin in response to ER stress might help to preserve cellular function and survival within the adaptive phase of the UPR.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The experiments described above established a protective role of parkin in response to ER stress.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Obviously, parkin does not reduce ER stress per se, but it can protect cells from ER stress-induced cell death.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:1915}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In this study, we show that parkin is transcriptionally upregulated by mitochondrial and ER stress via the UPR to promote viability under cellular stress.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We observed that proteasome dysfunction does not impair the ability of parkin to prevent ER stress-induced cell death.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:270}, properties:{evidence:"ER stress can induce mitochondrial stress, resulting in a bioenergetic deficit and mitochondrial fragmentation.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:270}, end: {_id:317}, properties:{evidence:"ER stress can induce mitochondrial stress, resulting in a bioenergetic deficit and mitochondrial fragmentation.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1605}, end: {_id:1923}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We searched for this role by investigating the ERâ€“mitochondria relationship in terms of Ca2 + signal- ing, since Ca2+ dyshomeostasis and ERâ€“mitochondria coupling play a prominent role in neuronal cell death.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:303}, end: {_id:1427}, properties:{evidence:"Parkin, the product of gene PARK2 whose mutation causes familial PD, has been linked to mitochondrial quality control via its role in regulating mitochondrial dynamics, including mitochondrial degradation via mitophagy.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1930}, end: {_id:270}, properties:{evidence:"In the absence of antioxidants, glutamate excitotoxicity may trigger the selective degradation of oxidatively damaged mitochondrial components through Parkin-dependent shuttling of MDVs.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:131}, end: {_id:1940}, properties:{evidence:"Glutamate-induced neuron death requires mitochondrial calcium uptake", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:1940}, end: {_id:1923}, properties:{evidence:"Glutamate-induced neuron death requires mitochondrial calcium uptake", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:1940}, end: {_id:1923}, properties:{evidence:"Although concurrent inhibition of mitochondrial calcium uptake substantially enhanced this cytoplasmic calcium increase, it significantly reduced glutamate- stimulated neuronal cell death.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshanatomy:["Mitochondria"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:1953}, end: {_id:1930}, properties:{evidence:"These results provide an addi- tional example of a cytosolic signalling pathway postulated to participate in glutamate toxicity that is unimpaired by exposure of neurons to FCCP.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Cytoplasmic Structures"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:131}, end: {_id:881}, properties:{evidence:"potential-driven uptake of cal- cium into the mitochondria is essential to trigger excitotoxic neuronal death.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:1956}, end: {_id:1760}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Phosphorylated ubiquitin was increased in the brains of Mutator mice, indicating PINK1-Parkin activation.", citationTitle:"Neuron. 2015 Jul 15;87(2):371-81. doi: 10.1016/j.neuron.2015.06.034.", annotationSubgraph:["PINK1 subgraph"], pmid:"26182419", citationType:"PubMed", citationRef:"26182419"}}, {start: {_id:400}, end: {_id:1621}, properties:{evidence:"Autophagy, a cellular process for organelle and protein turnover, regulates innate immune responses. Here we demonstrate that depletion of the autophagic proteins LC3B and beclin 1 enhanced the activation of caspase-1 and secretion of interleukin 1Beta (IL-1Beta) and IL-18.", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Innate immune system subgraph", "Autophagy signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}] AS row
