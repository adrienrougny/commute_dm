UNWIND [{start: {_id:1572}, end: {_id:216}, properties:{annotationCondition:["Normal Healthy State"], evidence:"the hsp-4::gfp reporter, like the endogenous gene, was unaltered by ethidium bromide but was markedly induced by either tunicamycin or heat shock and the cytoplasmic hsp-70::GFP reporter was inducible only by heat shock", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Chaperone subgraph"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}] AS row
