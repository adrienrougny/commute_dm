UNWIND [{start: {_id:105}, end: {_id:107}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Examination of a panel of individual or clustered lysine mutants demonstrated that lysine 613 (K613) in the cytoplasmic tail of Dll1 is a key residue necessary for transcellular activation of Notch signaling. Multi-ubiquitination of the Dll1 mutant Dll1-K613R was altered compared to wild type Dll1, and the K613R mutation blocked the ability of Dll1 to interact with Notch1", citationTitle:"Biochim Biophys Acta. 2011 Dec;1813(12):2036-43. doi: 10.1016/j.bbamcr.2011.08.019. Epub 2011 Oct 2.", annotationSubgraph:["Notch signaling subgraph"], pmid:"21985982", citationType:"PubMed", citationRef:"21985982"}}, {start: {_id:614}, end: {_id:845}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Supporting and extending previous biochemical analyses, we found that L166P strongly reduced BiFC signal, clearly indicating that this mutation prevents DJ-1 dimerization in living cells.", citationTitle:"J Mol Med (Berl). 2013 May;91(5):599-611. doi: 10.1007/s00109-012-0976-y. Epub 2012 Nov 27.", annotationSubgraph:["Chaperone subgraph"], pmid:"23183826", citationType:"PubMed", citationRef:"23183826"}}, {start: {_id:271}, end: {_id:1084}, properties:{evidence:"We propose that by ubiquitinating Eps15, parkin interferes with the ability of the Eps15 UIMs to bind ubiquitinated EGFR, thereby delaying EGFR internalization and degradation, and promoting PI(3)K-Akt signalling.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:1531}, end: {_id:1530}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin ubiquitinates and tags damaged mitochondria for clearance. Overexpression of USP30 removes ubiquitin attached by parkin onto damaged mitochondria and blocks parkin's ability to drive mitophagy, whereas reducing USP30 activity enhances mitochondrial degradation in neurons. Global ubiquitination site profiling identified multiple mitochondrial substrates oppositely regulated by parkin and USP30.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:271}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Third, our results indicate that PINK1/Parkin actively participate in the derepression of nRCC mRNAs by displacing the translational repressor hnRNP-F/Glo from nRCC mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Third, our results indicate that PINK1/Parkin actively participate in the derepression of nRCC mRNAs by displacing the translational repressor hnRNP-F/Glo from nRCC mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1883}, end: {_id:1877}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Restoring CHCHD4 reverses the metabolic and cell death phenotypes of Aif/y ESCs", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationCell:["embryonic stem cell"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1877}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Altogether, these results indicate that restoring CHCHD4 levels can reverse the phenotype of Aif/y ESCs with respect to their metabolic and cell death phenotypes.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationCell:["embryonic stem cell"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1877}, properties:{annotationCondition:["Normal Healthy State"], evidence:"As shown here, there are several lines of evidence that place CHCHD4 in the pathway linking AIF deficiency to the defi- cient biogenesis of respiratory chain complexes.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1878}, properties:{annotationCondition:["Normal Healthy State"], evidence:"As shown here, there are several lines of evidence that place CHCHD4 in the pathway linking AIF deficiency to the defi- cient biogenesis of respiratory chain complexes.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1880}, properties:{annotationCondition:["Normal Healthy State"], evidence:"As shown here, there are several lines of evidence that place CHCHD4 in the pathway linking AIF deficiency to the defi- cient biogenesis of respiratory chain complexes.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1836}, properties:{annotationCondition:["Normal Healthy State"], evidence:"As shown here, there are several lines of evidence that place CHCHD4 in the pathway linking AIF deficiency to the defi- cient biogenesis of respiratory chain complexes.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1878}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Third, the depletion of either AIF or CHCHD4 causes similar defects in a specific set of mitochondrial proteins, including components of the respiratory chain complexes I and IV and DDP1.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1836}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Third, the depletion of either AIF or CHCHD4 causes similar defects in a specific set of mitochondrial proteins, including components of the respiratory chain complexes I and IV and DDP1.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:196}, end: {_id:2028}, properties:{evidence:"Finally, our study indicates that the common PD-related mutations of LRRK2, R1441G, Y1699C and G2019S, decrease homeostatic phosphorylation levels of S935 and impair 14-3-3 binding of LRRK2.", citationTitle:"PLoS One. 2011 Mar 1;6(3):e17153. doi: 10.1371/journal.pone.0017153.", annotationSubgraph:["LRRK2 subgraph", "Notch signaling subgraph"], pmid:"21390248", citationType:"PubMed", citationRef:"21390248"}}] AS row
