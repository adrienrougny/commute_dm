UNWIND [{start: {_id:1034}, end: {_id:1035}, properties:{evidence:"Estrogen receptors (ERÅ’Â± and ERÅ’â‰¤) mediate the neuroprotection of estrogens against MPTP-induced striatal dopamine (DA) depletion. Pain is an important and distressing symptom in Parkinson's disease (PD). Voltage-gated sodium channels in sensory neurons are involved in the development of neuropathic pain.The MPTP-induced up-regulation of Nav1.1 and Nav1.9, down-regulation of Nav1.6 in DRG neurons may be through ERÅ’â‰¤, up-regulation of Nav1.7 and down-regulation of Nav1.8 are dependent on both ERÅ’Â± and ERÅ’â‰¤.", citationTitle:"Endocrine. 2012 Aug;42(1):118-24. doi: 10.1007/s12020-012-9637-8. Epub 2012 Feb 28.", annotationSubgraph:["Estrogen subgraph", "Calcium-dependent signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"22371119", citationType:"PubMed", citationRef:"22371119"}}, {start: {_id:1036}, end: {_id:1035}, properties:{evidence:"Estrogen receptors (ERÅ’Â± and ERÅ’â‰¤) mediate the neuroprotection of estrogens against MPTP-induced striatal dopamine (DA) depletion. Pain is an important and distressing symptom in Parkinson's disease (PD). Voltage-gated sodium channels in sensory neurons are involved in the development of neuropathic pain.The MPTP-induced up-regulation of Nav1.1 and Nav1.9, down-regulation of Nav1.6 in DRG neurons may be through ERÅ’â‰¤, up-regulation of Nav1.7 and down-regulation of Nav1.8 are dependent on both ERÅ’Â± and ERÅ’â‰¤.", citationTitle:"Endocrine. 2012 Aug;42(1):118-24. doi: 10.1007/s12020-012-9637-8. Epub 2012 Feb 28.", annotationSubgraph:["Estrogen subgraph", "Calcium-dependent signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"22371119", citationType:"PubMed", citationRef:"22371119"}}] AS row
