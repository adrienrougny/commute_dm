UNWIND [{start: {_id:419}, end: {_id:471}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Tau phosphorylation is important for tau function/dysfunction as hyperphosphorylation of tau is generally correlated with the formation of tau protein aggregates which are major components of neurofibrillary tangles, one of the main neuropathological hallmarks of AD which is also observed in other tauopathies including PD.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:297}, end: {_id:778}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Overexpression of the Ala53Thr a-synuclein induced apoptosis and enhanced toxicity of the dopamine uptake-dependent neurotoxin 6-hydroxydopamine (6-OHDA); whereas WT a-synuclein was not intrinsically neurotoxic, but increased sensitivity to 6-OHDA.", citationTitle:"Pharmacol Ther. 2005 Mar;105(3):311-31. Epub 2004 Dec 8.", annotationSubgraph:["Synuclein subgraph"], pmid:"15737408", citationType:"PubMed", citationRef:"15737408"}}, {start: {_id:973}, end: {_id:974}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Glial cell line-derived neurotrophic factor (GDNF) was first discovered as a potent survival factor for midbrain dopaminergic neurons and was then shown to rescue these neurons in animal models of Parkinson's disease. GDNF is a more potent survival factor for dopaminergic neurons and the noradrenergic neurons of the locus coeruleus than other neurotrophic factors, and an almost 100 times more efficient survival factor for spinal motor neurons than the neurotrophins.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:973}, end: {_id:975}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Glial cell line-derived neurotrophic factor (GDNF) was first discovered as a potent survival factor for midbrain dopaminergic neurons and was then shown to rescue these neurons in animal models of Parkinson's disease. GDNF is a more potent survival factor for dopaminergic neurons and the noradrenergic neurons of the locus coeruleus than other neurotrophic factors, and an almost 100 times more efficient survival factor for spinal motor neurons than the neurotrophins.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:973}, end: {_id:976}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Glial cell line-derived neurotrophic factor (GDNF) was first discovered as a potent survival factor for midbrain dopaminergic neurons and was then shown to rescue these neurons in animal models of Parkinson's disease. GDNF is a more potent survival factor for dopaminergic neurons and the noradrenergic neurons of the locus coeruleus than other neurotrophic factors, and an almost 100 times more efficient survival factor for spinal motor neurons than the neurotrophins.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:271}, end: {_id:267}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondrial ROS generate mitochondrial vesicles in a parkin- dependent manner.whereas both parkin and mitochondrial ROS are required to induce this population of double-membraned mitochondrial vesicles, it appears that the association of parkin with these structures is transient and occurs initially at sites of MDV budding.", citationTitle:"EMBO J. 2014 Feb 18;33(4):282-95. doi: 10.1002/embj.201385902. Epub 2014 Jan 20.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"24446486", citationType:"PubMed", citationRef:"24446486"}}, {start: {_id:137}, end: {_id:1697}, properties:{evidence:"Î±-Synuclein, the major component of Lewy bodies, appears to contain an amino-terminal mitochondrial targeting sequence (Devi et al, 2008) and acidification of the cytosol or overexpression of Î±-synuclein itself can cause localization of the protein to mitochondria", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1721}, end: {_id:809}, properties:{evidence:"We used previously characterized pink1 mutant flies (Park et al, 2006), which display motor disturbances and structural changes of mitochondria.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:2010}, end: {_id:2110}, properties:{evidence:"The level of Pitx3 mRNA, determined by semiquantitative RT-PCR, is approximately 6x higher in VTA than in SN single neurons. In the VTA but not in SN the level of Pitx3 is associated with the presence of calbidin (CB): in CB-positive neurons the expression of Pitx3 mRNA is 3.6x higher than in CB-negative cells.", citationTitle:"Eur J Neurosci. 2005 Sep;22(6):1287-93.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Ventral Tegmental Area", "Substantia Nigra"], annotationConfidence:["High"], pmid:"16190884", citationType:"PubMed", citationRef:"16190884"}}, {start: {_id:2176}, end: {_id:2162}, properties:{evidence:"This produces 7_-hydroxy-DHEA that is a substrate for 11_-hydroxysteroid dehydrogenase type 1 (11_-HSD1) which exists in the same tissues and carries out the inter-conversion of 7_- and 7_-hydroxy-DHEA through a 7-oxo-intermediary.", pmid:"17467270", citationType:"PubMed", citationRef:"17467270"}}] AS row
