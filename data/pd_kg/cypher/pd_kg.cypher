UNWIND [{start: {_id:85}, end: {_id:87}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In addition to inhibiting insulin receptor and IGF1R kinase activity by directly binding to the receptors, GRB10 can also negatively regulate insulin and IGF1 signaling by mediating insulin receptor and IGF1R degradation through ubiquitination.", citationTitle:"J Biol Chem. 2010 Dec 31;285(53):42130-9. doi: 10.1074/jbc.M110.143412. Epub 2010 Oct 26.", annotationSubgraph:["Insulin signal transduction"], pmid:"20980250", citationType:"PubMed", citationRef:"20980250"}}, {start: {_id:86}, end: {_id:88}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In addition to inhibiting insulin receptor and IGF1R kinase activity by directly binding to the receptors, GRB10 can also negatively regulate insulin and IGF1 signaling by mediating insulin receptor and IGF1R degradation through ubiquitination.", citationTitle:"J Biol Chem. 2010 Dec 31;285(53):42130-9. doi: 10.1074/jbc.M110.143412. Epub 2010 Oct 26.", annotationSubgraph:["Insulin signal transduction"], pmid:"20980250", citationType:"PubMed", citationRef:"20980250"}}, {start: {_id:672}, end: {_id:674}, properties:{evidence:"Monogenic disorders with various manifestations that may include parkinsonism Mutations in mitochondrial DNA polymerase gamma (POLG, POLG1) have been reported from patients with parkinsonism, with loss of dopaminergic cells evidenced in DATscans and at least partial response to dopaminergic medication [85] and [86].", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:804}, end: {_id:805}, properties:{evidence:"Our findings support the previously identified role for PARL in PINK1 cleavage, and implicate three more proteases, MPP, m-AAA and ClpXP, in the cleavage of this PD-linked protein", citationTitle:"EMBO Rep. 2012 Apr;13(4):378-85. doi: 10.1038/embor.2012.14.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22354088", citationType:"PubMed", citationRef:"22354088"}}, {start: {_id:1071}, end: {_id:1085}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mtmr13/Sbf2 counteracts the blockage of EGFR degradation without affecting prolonged Akt activation.", citationComment:"The CMT4B disease-causing proteins MTMR2 and MTMR13/SBF2 regulate AKT signalling.", citationTitle:"Journal of cellular and molecular medicine; Vol. 15; Iss. 2", annotationSubgraph:["Akt/mTOR subgraph"], citationPubDate:"2011-02-01", pmid:"19912440", citationAuthorList:"Philipp Berger|Kristian Tersar|Kurt Ballmer-Hofer|Ueli Suter", citationType:"PubMed", citationRef:"19912440"}}, {start: {_id:1428}, end: {_id:1430}, properties:{evidence:"Upon mitochondrial depolarization, the Bcl-2 family member Mcl-1 underwent rapid Parkin- and PINK1-dependent polyubiquitination and degradation, which sensitized toward apoptosis via opening of the Bax/Bak channel.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1538-53. doi: 10.1016/j.celrep.2014.10.046. Epub 2014 Nov 13.", annotationSubgraph:["Bcl-2 subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456142", citationType:"PubMed", citationRef:"25456142"}}, {start: {_id:1472}, end: {_id:1474}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Opa1 degradation by Oma1 may prevent fusion of damaged mitochondria with healthy mitochondria and be coupled to Pink1-mediated recruitment of Parkin to facilitate mitophagy.", citationTitle:"J Cell Biol. 2010 Nov 29;191(5):933-42. doi: 10.1083/jcb.201008084.", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondrial subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"21115803", citationType:"PubMed", citationRef:"21115803"}}, {start: {_id:1478}, end: {_id:1477}, properties:{annotationCondition:["Normal Healthy State"], evidence:"External Proteinase K treatment led to the degradation of the PINK1 complex, and proteolytic processing of the exposed cytosolic facing domains of the TOM complex", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSubgraph:["PINK1 subgraph"], pmid:"22280891", citationType:"PubMed", citationRef:"22280891"}}, {start: {_id:1539}, end: {_id:1540}, properties:{evidence:"In this study, we show that MUL1 suppresses PINK1 or parkin phenotypes in Drosophila. The suppression is achieved through the ubiquitin- dependent degradation of Mitofusin, which itself causes PINK1/parkin mutant-like toxicity when overexpressed. We further show that removing MUL1 in PINK1 or parkin loss-of-function mutant aggravates phenotypes caused by loss of either gene alone, leading to lethality in flies and degeneration in mouse cortical neurons. Together, these observations show that MUL1 acts in parallel to the PINK1/parkin pathway on a shared target mitofusin to maintain mitochondrial integrity. The MUL1 pathway compensates for loss of PINK1/parkin in both Drosophila and mammals and is a promising therapeutic target for PD", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:1539}, end: {_id:1540}, properties:{evidence:"MUL1 is a mitochondrial protein that regulates another protein called mitofusin; the role of mitofusin is to promote the fusion of mitochondria. Conversely, removing MUL1 from PINK1 or parkin mutant worsens the symptoms because MUL1 is no longer present to compensate for the defects.", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:271}, end: {_id:1542}, properties:{annotationCondition:["Normal Healthy State"], evidence:"both Parkin and MUL1 promote Mfn degradation, suggest two possible scenarios of how MUL1 and PINK1/parkin interact", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSubgraph:["Mitochondria fusion subgraph", "Ubiquitin subgraph"], annotationSpecies:["9606"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:1541}, end: {_id:1542}, properties:{annotationCondition:["Normal Healthy State"], evidence:"both Parkin and MUL1 promote Mfn degradation, suggest two possible scenarios of how MUL1 and PINK1/parkin interact", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSubgraph:["Mitochondria fusion subgraph", "Ubiquitin subgraph"], annotationSpecies:["9606"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:1961}, end: {_id:1966}, properties:{evidence:"NLRX1 overexpression resulted in increased and prolonged degradation of IkBa in response to Shigella infection (Fig 4E) and TNFa (Fig 4F).", citationTitle:"EMBO Rep. 2008 Mar;9(3):293-300. doi: 10.1038/sj.embor.7401161. Epub 2008 Jan 25.", annotationSubgraph:["Mitochondrial subgraph", "Nuclear factor Kappa beta subgraph"], pmid:"18219313", citationType:"PubMed", citationRef:"18219313"}}, {start: {_id:75}, end: {_id:2233}, properties:{evidence:"We report that chronic insulin treatment induces the degradation of IRS-1, but not IRS-2, protein in cultured cells.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"10389839", citationType:"PubMed", citationRef:"10389839"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
