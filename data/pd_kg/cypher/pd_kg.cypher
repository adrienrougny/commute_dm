UNWIND [{start: {_id:382}, end: {_id:271}, properties:{evidence:"Very recently, although the presence of Lewy bodies have been reported in one case, the lack of Lewy bodies in parkin-mutated brains suggests us a fundamental pathology for Lewy bodies.", citationTitle:"Rinsho Shinkeigaku. 2002 Nov;42(11):1077-81.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"12784670", citationType:"PubMed", citationRef:"12784670"}}, {start: {_id:1381}, end: {_id:448}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Cyclic AMP (cAMP) is considered to be an important second messenger that controls mTOR;Here, we identify cAMP phosphodiesterase 4D (PDE4D) as a binding partner of Rheb that acts as a cAMP-specific negative regulator of mTORC1", citationTitle:"Mol Cell Biol. 2010 Nov;30(22):5406-20. doi: 10.1128/MCB.00217-10. Epub 2010 Sep 13.", annotationSubgraph:["Cyclic AMP subgraph", "Cell cycle subgraph"], annotationSpecies:["9606"], pmid:"20837708", citationType:"PubMed", citationRef:"20837708"}}, {start: {_id:1756}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, vitamin K2 is sufficient for electron transport downstream of a eukaryotic ETC complex, resulting in improved mitochondrial oxygen Fig. 4. Vitamin K2 acts as a mitochondrial electron carrier. Immunolabeling of S2 Drosophila cells (A) and Western blot of fractionations (B) transfected with Heix-His and labeled with anti-His and antiâ€“ATP synthase b (A). (C) ATP levels of heix1/Df and heix/Df;da>heix (n = 8). (D) Time-dependent ATP production in mitochondria isolated from heix1/Df mutant larvae (n = 8). (E) Measurements of complex II activity [normalized to citrate synthase activity (CS)] using a dose-response of MK-4 as electron carrier (n = 4). (F) Measurements of complex II activity using ubiquinone (0.13 mM; Q-10, light gray) or MK-4 (0.35 mM, gray) as electron carrier (n = 4). (G) Time- dependent ATP production in mitochondria isolated from pink1B9 mutant flies. Reactions are either not supplemented with MK-4 (black) or supplemented with 0.15 mM (dark gray) or 0.35 mM MK-4 (light gray) (n = 8). (H) Adenosine diphosphateâ€“stimulated complex Iâ€“driven respiration rate (oxygen consumption) in mitochondria isolated from pink1RV controls and pink1B9 mutants placed for 72 hours on MK-4 medium or on control medium. Mitochondria from vitamin K2-fed mutant flies consume oxygen faster. Data are mean normalized to controls in (C) and (H) or mean in (D) to (G). Error bars, SEM. ANOVA/Dunnett: *P < 0.05, **P < 0.01, ***P < 0.001.consumption and energy production, particular- ly in pink1B9 mutants.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["PINK1 subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:748}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Genetic studies in Drosophila determined that PINK1 acts upstream of Parkin in a common pathway to regulate mitochondrial morphology and integrity (3â€“8), and led to the hypothesis that this pathway promotes the selective degradation of damaged mitochondria (6, 9).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], annotationSpecies:["7227"], annotationMeshanatomy:["Mitochondria"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1980}, end: {_id:1978}, properties:{evidence:"Depletion of autophagic proteins promoted the accumulation of dysfunctional mitochondria and cytosolic translocation of mitochondrial DNA (mtDNA) in response to lipopolysaccharide (LPS) and ATP in macrophages. Release of mtDNA into the cytosol depended on the NALP3 inflammasome and mitochondrial reactive oxygen species (ROS). Cytosolic mtDNA contributed to the secretion of IL-1Beta and IL-18 in response to LPS and ATP.", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Interleukin signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}, {start: {_id:1980}, end: {_id:771}, properties:{evidence:"Depletion of autophagic proteins promoted the accumulation of dysfunctional mitochondria and cytosolic translocation of mitochondrial DNA (mtDNA) in response to lipopolysaccharide (LPS) and ATP in macrophages. Release of mtDNA into the cytosol depended on the NALP3 inflammasome and mitochondrial reactive oxygen species (ROS). Cytosolic mtDNA contributed to the secretion of IL-1Beta and IL-18 in response to LPS and ATP.", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Interleukin signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:492}, end: {_id:16}, properties:{evidence:"Parkinson's disease (PD) is the second most common age-related neurodegenerative disease, affecting approximately 1 percent of the population over 60 [1]. It is clinically characterized by bradykinesia, rest tremor, rigidity, gait and postural abnormalities, and a variety of other motor and non-motor symptoms [2].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:784}, end: {_id:16}, properties:{evidence:"Hyposmia is a common finding in majority of PD patients.", citationTitle:"FEBS J. 2009 Nov;276(22):6455-63. doi: 10.1111/j.1742-4658.2009.07344.x. Epub 2009 Oct 5.", annotationMeshdisease:["Parkinson Disease"], pmid:"19804413", citationType:"PubMed", citationRef:"19804413"}}, {start: {_id:1173}, end: {_id:1172}, properties:{evidence:"A subset of essential tremor and tremor in SWEDDs (Scans Without Evidence of Dopaminergic Deficits) reportedly have similar pathophysiology to dystonia", citationTitle:"Rinsho Shinkeigaku. 2012;52(11):1068-70.", annotationMeshdisease:["Dystonia", "Parkinson Disease"], pmid:"23196518", citationType:"PubMed", citationRef:"23196518"}}, {start: {_id:1178}, end: {_id:16}, properties:{evidence:"The patients with SWEDDs have less non-motor problems than newly diagnosed untreated PD patients. Given the difficulty distinguishing between SWEDDs and early PD, identifying some of non-motor symptoms, such as RBD or olfactory impairment, could aid clinicians in their work.", citationTitle:"Parkinsonism Relat Disord. 2014 Dec;20(12):1419-22.", annotationMeshdisease:["Parkinson Disease"], pmid:"22446342", citationType:"PubMed", citationRef:"22446342"}}, {start: {_id:1219}, end: {_id:1179}, properties:{evidence:"In PD patients, but not in controls, cortical atrophy in olfactory- related brain regions correlated specifically with olfactory dysfunction. Positive correlations between olfactory performance and gray matter volume were observed in the right piriform cortex in early PD patients and in the right amygdala in moderately advanced patients. The results provided first evidence that olfactory dysfunction in PD is related to atrophy in olfactory-eloquent regions of the limbic and paralimbic cortex. In addition, olfactory-correlated atrophy in these brain regions is consistent with the assumption that olfactory impairment as an early symptom of PD is likely to be associated with extranigral pathology.", citationTitle:"J Neurosci. 2009 Dec 9;29(49):15410-3. doi: 10.1523/JNEUROSCI.1909-09.2009.", annotationMeshdisease:["Atrophy"], annotationMeshanatomy:["Limbic Lobe"], pmid:"20007465", citationType:"PubMed", citationRef:"20007465"}}, {start: {_id:16}, end: {_id:719}, properties:{evidence:"Mitochondrial dysfunction has long been associated with Parkinson's disease (PD)", citationTitle:"EMBO J. 2014 Feb 18;33(4):282-95. doi: 10.1002/embj.201385902. Epub 2014 Jan 20.", annotationMeshdisease:["Parkinson Disease"], pmid:"24446486", citationType:"PubMed", citationRef:"24446486"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:16}, end: {_id:1698}, properties:{evidence:"The etiology of PD remains unknown, although clinical and experimental evidence implicates the involvement of abnormal protein aggregation, oxidative stress and mitochondrial dysfunction", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:16}, end: {_id:270}, properties:{evidence:"The etiology of PD remains unknown, although clinical and experimental evidence implicates the involvement of abnormal protein aggregation, oxidative stress and mitochondrial dysfunction", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1232}, end: {_id:16}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"Methylation of SNCA intron 1 was reduced in DNA from sporadic PD patients substantia nigra,putamen, and cortex, pointing toward a yet unappreciated epigenetic regulation of SNCA expression in PD.", citationTitle:"J Neurosci. 2010 May 5;30(18):6355-9. doi: 10.1523/JNEUROSCI.6119-09.2010", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Cerebral Cortex"], pmid:"20445061", annotationTranscriptionallyActiveRegion:["intron 1"], citationType:"PubMed", citationRef:"20445061"}}, {start: {_id:1242}, end: {_id:16}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"We found decreased methylation of the cytochrome P450 2E1 gene and increased expression of CYP2E1 messenger RNA in PD patients' brains, suggesting that epigenetic variants of this cytochrome contribute to PD susceptibility.", citationTitle:"Neurogenetics. 2012 Feb;13(1):87-91. doi: 10.1007/s10048-011-0308-3. Epub 2012 Jan 12.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], pmid:"22238121", citationType:"PubMed", citationRef:"22238121"}}, {start: {_id:81}, end: {_id:16}, properties:{annotationPdstage:["Familial_autosomal_recessive_PD"], evidence:"parkin mutations are associated with significant loss of dopaminergic neurons in the substantia nigra and moderate decrease of neurons in the locus coeruleus. Cell loss in the substantia nigra of patients with parkin-associated PD appeared to be caused by a loss of function of the protein.", citationTitle:"Physiol Rev. 2011 Oct;91(4):1161-218. doi: 10.1152/physrev.00022.2010.", annotationSubgraph:["GRB10 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"22013209", citationType:"PubMed", citationRef:"22013209"}}, {start: {_id:1319}, end: {_id:16}, properties:{evidence:"Additionally, we investigated the methylation of SEPW1 and PRKAR2A regulatory regions because both genes were found to be up-regulated in PD brains in a comprehensive microarray study and are expected to be hypomethylated. We found significant decreases in methylation for SEPW1 only in the DLB group, whereas PRKAR2A promoter was hypomethylated only in PD samples, indicating that specific genes might be dysregulated in each disorder. Taken together, this evidence suggests that mislocalization of Dnmt1 and reduction of DNA methylation might directly affect gene expression.", citationTitle:"J Biol Chem. 2011 Mar 18;286(11):9031-7. doi: 10.1074/jbc.C110.212589. Epub 2011 Feb 4", annotationSubgraph:["Synuclein subgraph", "Transport related subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21296890", citationType:"PubMed", citationRef:"21296890"}}, {start: {_id:1320}, end: {_id:16}, properties:{evidence:"Additionally, we investigated the methylation of SEPW1 and PRKAR2A regulatory regions because both genes were found to be up-regulated in PD brains in a comprehensive microarray study and are expected to be hypomethylated. We found significant decreases in methylation for SEPW1 only in the DLB group, whereas PRKAR2A promoter was hypomethylated only in PD samples, indicating that specific genes might be dysregulated in each disorder. Taken together, this evidence suggests that mislocalization of Dnmt1 and reduction of DNA methylation might directly affect gene expression.", citationTitle:"J Biol Chem. 2011 Mar 18;286(11):9031-7. doi: 10.1074/jbc.C110.212589. Epub 2011 Feb 4", annotationSubgraph:["Synuclein subgraph", "Transport related subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21296890", citationType:"PubMed", citationRef:"21296890"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:56}, end: {_id:232}, properties:{evidence:"Collectively, these results suggest that IGF-IR or Bcl-2 overexpression in neuroblastoma cells promotes cell survival by preventing mitochondrial membrane depolarization and caspase-3 activation, ultimately leading to increased tumor growth.", annotationSubgraph:["Apoptosis signaling subgraph", "Insulin signal transduction"], annotationConfidence:["High"], pmid:"10889510", citationType:"PubMed", citationRef:"10889510"}}, {start: {_id:1431}, end: {_id:232}, properties:{evidence:"Collectively, these results suggest that IGF-IR or Bcl-2 overexpression in neuroblastoma cells promotes cell survival by preventing mitochondrial membrane depolarization and caspase-3 activation, ultimately leading to increased tumor growth.", annotationSubgraph:["Apoptosis signaling subgraph", "Insulin signal transduction"], annotationConfidence:["High"], pmid:"10889510", citationType:"PubMed", citationRef:"10889510"}}] AS row
