UNWIND [{start: {_id:442}, end: {_id:441}, properties:{annotationCondition:["Normal Healthy State"], evidence:"For instance, PP2A enzyme but not PP1 is shown to dephosphorylate alpha-syn-pS129 in vitro , and treatment of cells with the PP2A inhibitor okadaic acid (OA) but not the PP1 inhibitor tautomycin leads to an increased level of alpha-syn-pS129.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Cell cycle subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:445}, end: {_id:444}, properties:{annotationCondition:["Normal Healthy State"], evidence:". Accordingly, treatment of mice with the PME inhibitor eicosanoyl-5-hydroxytryptamide (EHT) increases PP2A methylation as well as decreased alpha-syn-pS129 levels in brain and a concurrent reduction in synuclein pathology", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph", "Cell cycle subgraph"], annotationMeshanatomy:["Brain"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:447}, end: {_id:439}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Related to this, the diabetes drug metformin was shown to reduce alpha-syn phosphorylation at S129 through activation of PP2A and inhibition of mammalian target of rapamycin .", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph", "Cell cycle subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:562}, end: {_id:560}, properties:{evidence:"Furthermore, increased expression of MMP9 and GFAP in astrocytes was observed in a parkinsonian mouse model with MPTP .These results suggest the importance of ECM breakdown in glial activation during neurodegeneration and PD.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationMeshdisease:["Parkinson Disease"], annotationCell:["embryonic stem cell"], annotationMeshanatomy:["Astrocytes"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:562}, end: {_id:563}, properties:{evidence:"Furthermore, increased expression of MMP9 and GFAP in astrocytes was observed in a parkinsonian mouse model with MPTP .These results suggest the importance of ECM breakdown in glial activation during neurodegeneration and PD.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationMeshdisease:["Parkinson Disease"], annotationCell:["embryonic stem cell"], annotationMeshanatomy:["Astrocytes"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:600}, end: {_id:601}, properties:{evidence:"Loss of ATP13A2 function results in impaired lysosomal function and, consequently, accumulation of SNCA/??-synuclein and neurotoxicity(21),One patient (Patient A with c.216C>A/c.1904G>A)", citationTitle:"Acta Neurol Taiwan. 2012 Sep;21(3):99-107.", annotationSubgraph:["Amyloidogenic subgraph"], pmid:"23196729", citationType:"PubMed", citationRef:"23196729"}}, {start: {_id:615}, end: {_id:616}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results indicated that edaravone was able to significantly attenuate oxidative stress and improve mitochondrial function. Furthermore, edaravone was found to reduce apoptosis in Neuro2a cells through modulation of mitochondria-dependent apoptosis pathways. Interestingly, our result also demonstrated that edaravone was able to up-regulate VMAT2 expression in N2a cells in a dose-dependent manner.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 51; Iss. 2", annotationSubgraph:["Transport related subgraph"], pmid:"23657982", annotationCellline:["Neuro-2a cell"], citationType:"PubMed", citationRef:"23657982"}}, {start: {_id:619}, end: {_id:620}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additionally, knockdown of Trx1 significantly abrogates DJ-1-dependent, hydrogen peroxide-induced activation of the pro- survival factor AKT. Promoter analysis of the human Trx1 gene identified an antioxidant response element (ARE) that is required for DJ-1-dependent induction of Trx1 expression.", citationTitle:"Human molecular genetics; Vol. 21; Iss. 13", annotationSubgraph:["Akt/mTOR subgraph"], annotationSpecies:["10090"], pmid:"22492997", annotationCellline:["SH-SY5Y cell"], citationType:"PubMed", citationRef:"22492997"}}, {start: {_id:773}, end: {_id:203}, properties:{evidence:"In summary, dexamethasone, a potent synthetic glucocorticoid that acts through GR, induces the expression of both LRRK2 and Œ±-synuclein, which when mutated, are known to cause PD in an autosomal-dominant manner..", citationTitle:"BMB Rep. 2013 Sep;46(9):454-9.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24064060", citationType:"PubMed", citationRef:"24064060"}}, {start: {_id:773}, end: {_id:137}, properties:{evidence:"In summary, dexamethasone, a potent synthetic glucocorticoid that acts through GR, induces the expression of both LRRK2 and Œ±-synuclein, which when mutated, are known to cause PD in an autosomal-dominant manner..", citationTitle:"BMB Rep. 2013 Sep;46(9):454-9.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24064060", citationType:"PubMed", citationRef:"24064060"}}, {start: {_id:836}, end: {_id:837}, properties:{annotationCondition:["Normal Healthy State"], evidence:"On the other hand, the other stressors, such as UV exposure and doxorubicin treatment, did not alter the DUSP1 gene expression level, while the expression levels of NOXA and p21 were increased at 0.5 to 6 h after UV exposure and doxorubicin treatment (Fig. 5A to ‚ÄãtoD),D), suggesting that the DUSP1 gene is a primary target of p53 against oxidative stress", citationTitle:"Mol Cell Biol. 2013 Jan;33(2):340-59. doi: 10.1128/MCB.01350-12. Epub 2012 Nov 12.", annotationSubgraph:["Apoptosis signaling subgraph", "Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23149933", citationType:"PubMed", citationRef:"23149933"}}, {start: {_id:836}, end: {_id:838}, properties:{annotationCondition:["Normal Healthy State"], evidence:"On the other hand, the other stressors, such as UV exposure and doxorubicin treatment, did not alter the DUSP1 gene expression level, while the expression levels of NOXA and p21 were increased at 0.5 to 6 h after UV exposure and doxorubicin treatment (Fig. 5A to ‚ÄãtoD),D), suggesting that the DUSP1 gene is a primary target of p53 against oxidative stress", citationTitle:"Mol Cell Biol. 2013 Jan;33(2):340-59. doi: 10.1128/MCB.01350-12. Epub 2012 Nov 12.", annotationSubgraph:["Apoptosis signaling subgraph", "Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23149933", citationType:"PubMed", citationRef:"23149933"}}, {start: {_id:893}, end: {_id:900}, properties:{annotationCondition:["Normal Healthy State"], evidence:"OXY increased the basal levels of SIRT1", citationTitle:"Free Radic Biol Med. 2008 Oct 1;45(7):1019-26. doi: 10.1016/j.freeradbiomed.2008.07.002. Epub 2008 Jul 16.", annotationSubgraph:["Cell cycle subgraph"], annotationSpecies:["10116"], annotationMeshdisease:["Parkinson Disease"], annotationCellline:["SH-SY5Y"], pmid:"18675900", citationType:"PubMed", citationRef:"18675900"}}, {start: {_id:442}, end: {_id:427}, properties:{evidence:"For instance, PP2A enzyme but not PP1 is shown to dephosphorylate alpha-syn-pS129 in vitro , and treatment of cells with the PP2A inhibitor okadaic acid (OA) but not the PP1 inhibitor tautomycin leads to an increased level of alpha-syn-pS129.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:953}, end: {_id:955}, properties:{evidence:"Dexamethasone, a glucocorticoid hormone receptor agonist, upregulated both protein and mRNA levels of TREK-1 leading to decreased NSC proliferation which could be reversed by bupivacaine. Fluoxetine, a serotonin reuptake inhibitor antidepressant that has been previously found to inhibit TREK-1 channels, robustly, could attenuate the upregulation of TREK-1 expression and the inhibition of NSC proliferation induced by dexamethasone.", citationTitle:"Psychopharmacology (Berl). 2011 Apr;214(3):747-59. doi: 10.1007/s00213-010-2077-3. Epub 2010 Nov 11.", annotationSubgraph:["Transport related subgraph"], annotationMeshdisease:["Nervous System Diseases"], pmid:"21069514", citationType:"PubMed", citationRef:"21069514"}}, {start: {_id:562}, end: {_id:1134}, properties:{evidence:"Using the 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP)-treated mouse model of PD, we found that FAF1 accumulated in the substantia nigra pars compacta (SNc) of MPTP-treated PD mice, and that MPTP- induced dopaminergic cell loss in the SNc was significantly attenuated in Faf1(gt/gt) mice versus Faf1(+/+) mice.", citationComment:"Accumulation of the parkin substrate, FAF1, plays a key role in the dopaminergic neurodegeneration.", citationTitle:"Human molecular genetics; Vol. 22; Iss. 8", annotationSubgraph:["Apoptosis signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], citationPubDate:"2013-04-15", pmid:"23307929", citationAuthorList:"Jee-Won Sul|Min-Young Park|Juhee Shin|Young-Ran Kim|Sung-Eun Yoo|Young-Yun Kong|Ki-Sun Kwon|Young Ho Lee|Eunhee Kim", citationType:"PubMed", citationRef:"23307929"}}, {start: {_id:501}, end: {_id:1087}, properties:{evidence:"It is believed that the increase in the concentration of Hcy in PD can affect genetic polymorphisms of the folate metabolic pathway genes, such as MTHFR (C677T, A1298C and G1793A), MTR (A2756G), and MTHFD1 (G1958A), whose frequencies tend to increase in PD patients, as well as the reduced concentration of B vitamins.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationSubgraph:["Folate metabolic subgraph", "Vitamin subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:501}, end: {_id:1093}, properties:{evidence:"It is believed that the increase in the concentration of Hcy in PD can affect genetic polymorphisms of the folate metabolic pathway genes, such as MTHFR (C677T, A1298C and G1793A), MTR (A2756G), and MTHFD1 (G1958A), whose frequencies tend to increase in PD patients, as well as the reduced concentration of B vitamins.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationSubgraph:["Folate metabolic subgraph", "Vitamin subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:501}, end: {_id:1089}, properties:{evidence:"It is believed that the increase in the concentration of Hcy in PD can affect genetic polymorphisms of the folate metabolic pathway genes, such as MTHFR (C677T, A1298C and G1793A), MTR (A2756G), and MTHFD1 (G1958A), whose frequencies tend to increase in PD patients, as well as the reduced concentration of B vitamins.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationSubgraph:["Folate metabolic subgraph", "Vitamin subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:501}, end: {_id:1091}, properties:{evidence:"It is believed that the increase in the concentration of Hcy in PD can affect genetic polymorphisms of the folate metabolic pathway genes, such as MTHFR (C677T, A1298C and G1793A), MTR (A2756G), and MTHFD1 (G1958A), whose frequencies tend to increase in PD patients, as well as the reduced concentration of B vitamins.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationSubgraph:["Lipid metabolism subgraph", "Folate metabolic subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}] AS row
