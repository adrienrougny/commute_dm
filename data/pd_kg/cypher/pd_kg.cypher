ven from Karolinska for SWEDD", citationTitle:"PD SNP list from Karolinska", annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:157}, end: {_id:709}, properties:{evidence:"The SNP list given from Karolinska for SWEDD", citationTitle:"PD SNP list from Karolinska", annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:159}, end: {_id:709}, properties:{evidence:"The SNP list given from Karolinska for SWEDD", citationTitle:"PD SNP list from Karolinska", annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:161}, end: {_id:709}, properties:{evidence:"The SNP list given from Karolinska for SWEDD", citationTitle:"PD SNP list from Karolinska", annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:163}, end: {_id:709}, properties:{evidence:"The SNP list given from Karolinska for SWEDD", citationTitle:"PD SNP list from Karolinska", annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:165}, end: {_id:709}, properties:{evidence:"The SNP list given from Karolinska for SWEDD", citationTitle:"PD SNP list from Karolinska", annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:167}, end: {_id:709}, properties:{evidence:"The SNP list given from Karolinska for SWEDD", citationTitle:"PD SNP list from Karolinska", annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:169}, end: {_id:709}, properties:{evidence:"The SNP list given from Karolinska for SWEDD", citationTitle:"PD SNP list from Karolinska", annotationMeshdisease:["Parkinson Disease"], citationType:"Other", citationRef:"123456"}}, {start: {_id:1747}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Human UBIAD1 mutations may also affect mitochondrial function.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}] AS row
