UNWIND [{start: {_id:303}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss of Drosophila PGAM5 (dPGAM5) can suppress the muscle degeneration, motor defects, and shorter lifespan that result from dPINK1 inactivation and that can be attributed to mitochondrial degeneration.", citationTitle:"PLoS Genet. 2010 Dec 2;6(12):e1001229. doi: 10.1371/journal.pgen.1001229. ", annotationSubgraph:["PINK1 subgraph"], pmid:"21151955", citationType:"PubMed", citationRef:"21151955"}}, {start: {_id:411}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is likely that the maintenance of the BBB and the NVU will decrease the accumulation of Lewy bodies, alpha-synuclein fibrils and ROS that worsen the effects of PD", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:358}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In contrast to CCCP and FCCP, valinomycin depolarizes the Œîœàm but does not affect the pH gradient suggesting that PINK1 is specifically activated by loss of the Œîœàm.", citationTitle:"Open Biol. 2012 May;2(5):120080. doi: 10.1098/rsob.120080.", annotationSubgraph:["PINK1 subgraph"], pmid:"22724072", citationType:"PubMed", citationRef:"22724072"}}, {start: {_id:1027}, end: {_id:1121}, properties:{evidence:"We found that hippocampal long-term potentiation is altered in both a neurotoxic and transgenic model of Parkinson's disease and this plastic alteration is associated with an impaired dopaminergic transmission and a decrease of NR2A/NR2B subunit ratio in synaptic N-methyl-d-aspartic acid receptors.", citationComment:"Mechanisms underlying the impairment of hippocampal long-term potentiation and memory in experimental Parkinson's disease.", citationTitle:"Brain : a journal of neurology; Vol. 135; Iss. Pt 6", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Hippocampus"], citationPubDate:"2012-06-01", pmid:"22561640", citationAuthorList:"Cinzia Costa|Carmelo Sgobio|Sabrina Siliquini|Alessandro Tozzi|Michela Tantucci|Veronica Ghiglieri|Massimiliano Di Filippo|Valentina Pendolino|Antonio de Iure|Matteo Marti|Michele Morari|Maria Grazia Spillantini|Emanuele Claudio Latagliata|Tiziana Pascucci|Stefano Puglisi-Allegra|Fabrizio Gardoni|Monica Di Luca|Barbara Picconi|Paolo Calabresi", citationType:"PubMed", citationRef:"22561640"}}, {start: {_id:1027}, end: {_id:1110}, properties:{evidence:"We found that hippocampal long-term potentiation is altered in both a neurotoxic and transgenic model of Parkinson's disease and this plastic alteration is associated with an impaired dopaminergic transmission and a decrease of NR2A/NR2B subunit ratio in synaptic N-methyl-d-aspartic acid receptors.", citationComment:"Mechanisms underlying the impairment of hippocampal long-term potentiation and memory in experimental Parkinson's disease.", citationTitle:"Brain : a journal of neurology; Vol. 135; Iss. Pt 6", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Hippocampus"], citationPubDate:"2012-06-01", pmid:"22561640", citationAuthorList:"Cinzia Costa|Carmelo Sgobio|Sabrina Siliquini|Alessandro Tozzi|Michela Tantucci|Veronica Ghiglieri|Massimiliano Di Filippo|Valentina Pendolino|Antonio de Iure|Matteo Marti|Michele Morari|Maria Grazia Spillantini|Emanuele Claudio Latagliata|Tiziana Pascucci|Stefano Puglisi-Allegra|Fabrizio Gardoni|Monica Di Luca|Barbara Picconi|Paolo Calabresi", citationType:"PubMed", citationRef:"22561640"}}, {start: {_id:1639}, end: {_id:1593}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Tim17A is a stress-sensitive subunit of the TIM23 protein import complex. Tim17A protein decreases in response to stress-regulated translation attenuation. Tim17A degradation requires the activity of the mitochondrial protease YME1L. Decreased Tim17A/Tim-17 is protective against oxidative stress", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Transport related subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1639}, end: {_id:1593}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We show that the core TIM23 subunit Tim17A is selectively decreased in response to cellular insults that induce translational attenuation through ISR-dependent eIF2Î± phosphorylation.", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Unfolded protein response subgraph", "Transport related subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1639}, end: {_id:1593}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, our results indicate that reductions in Tim17A afforded by stress-regulated translational attenuation provides a mechanism to adapt mitochondrial protein import and increase cellular stress resistance during pathologic insults.", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Transport related subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1699}, end: {_id:221}, properties:{evidence:"Combined together, the data indicate that cellular defects in PINK1 mutants arise from dysfunction of Complex I of the ETC and extend the critical role of Complex I as a factor in the progression of PD from sporadic to genetic forms of the disease.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1921}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In support of this view, CHOP, a proapoptotic transcription factor activated upon severe or prolonged ER stress, suppressed parkin expression (Supplementary Figure 6).", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:592}, end: {_id:500}, properties:{evidence:"Analysis of neuromelanin in the SN of PD patients has shown an early accumulation and overload of iron, which can potentially result in increased oxidative stress.", citationTitle:"J Parkinsons Dis. 2013;3(4):461-91. doi: 10.3233/JPD-130230.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"24252804", citationType:"PubMed", citationRef:"24252804"}}, {start: {_id:809}, end: {_id:1723}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss of mitochondria at synapses has been implicated in specific defects in neurotransmission at Drosophila neuromuscular junction (NMJ)", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshanatomy:["Neuromuscular Junction", "Synapses"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1746}, end: {_id:1748}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Vitamin K2 is best known as a cofactor in blood coagulation, but in bacteria it is a membrane-bound electron carrier.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"22582012", citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1746}, end: {_id:1749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These results thus support a role for vitamin K2 in the transport of electrons in eukaryotic mitochondria to produce ATP, similar to its role in prokaryotic membranes (16), sug- gesting that vitamin K2 serves a conserved func- tion in prokaryotes and mitochondria.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], annotationCell:["eukaryotic cell"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1941}, end: {_id:881}, properties:{evidence:"Despite being the predominant excitatory neurotransmitter in mammalian brain, glutamate can be toxic to neurons.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Cytoplasmic Structures"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
