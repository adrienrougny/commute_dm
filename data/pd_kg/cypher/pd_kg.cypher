UNWIND [{start: {_id:1746}, end: {_id:1169}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Because mitochondria are involved in aging (21), we reared aged flies on MK-4 or overexpressed Heix but did not observe a significant rescue in mobility", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1934}, end: {_id:1930}, properties:{evidence:"Studies have shown NAC can prevent the effects of mitochondrially- produced ROS (Kulisz et al., 2002; Moreira et al., 2007; Seaton et al., 1997), and we show that NAC clearly reduced cellular ROS levels follow- ing glutamate.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
