MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:224}, end: {_id:16}, properties:{evidence:"When we considered a three-marker sliding window, we found a highly significant association between the disease and the haplotypes including markers rs17523802, Ins/Del, and rs3766606 (p = 0.0007) and markers Ins/Del, rs3766606 and rs7517357 (p = 0.0054). Our results indicate that polymorphisms located in a region spanning 3535 bp from the promoter to the intron 2 of the DJ-1 gene confer risk to sporadic PD in southern Italy.", citationTitle:"Clin Genet. 2010 Feb;77(2):183-8. doi: 10.1111/j.1399-0004.2009.01310.x. Epub 2009 Nov 23.", annotationMeshdisease:["Parkinson Disease"], pmid:"19968671", citationType:"PubMed", citationRef:"19968671"}}, {start: {_id:225}, end: {_id:16}, properties:{evidence:"When we considered a three-marker sliding window, we found a highly significant association between the disease and the haplotypes including markers rs17523802, Ins/Del, and rs3766606 (p = 0.0007) and markers Ins/Del, rs3766606 and rs7517357 (p = 0.0054). Our results indicate that polymorphisms located in a region spanning 3535 bp from the promoter to the intron 2 of the DJ-1 gene confer risk to sporadic PD in southern Italy.", citationTitle:"Clin Genet. 2010 Feb;77(2):183-8. doi: 10.1111/j.1399-0004.2009.01310.x. Epub 2009 Nov 23.", annotationMeshdisease:["Parkinson Disease"], pmid:"19968671", citationType:"PubMed", citationRef:"19968671"}}, {start: {_id:226}, end: {_id:16}, properties:{evidence:"When we considered a three-marker sliding window, we found a highly significant association between the disease and the haplotypes including markers rs17523802, Ins/Del, and rs3766606 (p = 0.0007) and markers Ins/Del, rs3766606 and rs7517357 (p = 0.0054). Our results indicate that polymorphisms located in a region spanning 3535 bp from the promoter to the intron 2 of the DJ-1 gene confer risk to sporadic PD in southern Italy.", citationTitle:"Clin Genet. 2010 Feb;77(2):183-8. doi: 10.1111/j.1399-0004.2009.01310.x. Epub 2009 Nov 23.", annotationMeshdisease:["Parkinson Disease"], pmid:"19968671", citationType:"PubMed", citationRef:"19968671"}}, {start: {_id:1193}, end: {_id:1176}, properties:{evidence:"Twenty-two patients were positive for the GAG deletion in the DYT1 gene. Fifteen of them presented with the typical DYT1 phenotype (early, limb-onset generalized dystonia without spread to craniocervical muscles), four had limb-onset dystonia with spread to craniocervical muscles, two patients had arm-onset segmental dystonia and one had focal right-arm dystonia.", citationTitle:"Brain. 1998 Dec;121 ( Pt 12):2335-9. ", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Dystonia"], pmid:"9874484", citationType:"PubMed", citationRef:"9874484"}}, {start: {_id:1194}, end: {_id:1195}, properties:{evidence:"We identified disease gene carriers and, with adjustments for age at onset, obtained a direct estimate of penetrance of .46. This is consistent with estimates of 30%-40% in the AJ population.The DYT1 gene on 9q34 is responsible for most cases of early limb-onset idiopathic torsion dystonia in non-Jews.", citationTitle:"Am J Hum Genet. 1994 Sep;55(3):468-75", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Dystonia"], pmid:"8079990", citationType:"PubMed", citationRef:"8079990"}}, {start: {_id:1201}, end: {_id:1172}, properties:{evidence:"We found one patient with a novel heterozygous frameshift mutation in the DYT11 gene (c.1058-1062 delCACCA/p.Gln352fsX376). Our findings provide further support to the hypothesis that adult-onset monogenic dystonia may underlie a PD look-alike clinical phenotype. I", citationTitle:"Neurology. 2014 Sep 23;83(13):1155-62.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Dystonia"], pmid:"25150291", citationType:"PubMed", citationRef:"25150291"}}, {start: {_id:7}, end: {_id:16}, properties:{annotationPdstage:["Familial_autosomal_dominant_PD"], evidence:"increasing gene dosgae of SNCA induce familiar PD", citationTitle:"Science. 2003 Oct 31;302(5646):841.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"14593171", citationType:"PubMed", citationRef:"14593171"}}, {start: {_id:1285}, end: {_id:16}, properties:{evidence:"Homozygosity for Mthfr 677TT is also associated in selected populations with age-related neurodegenerative diseases such as Alzheimer's disease and Parkinson's disease.", citationTitle:"Front Aging Neurosci. 2014 Aug 22;6:214. doi: 10.3389/fnagi.2014.00214. eCollection 2014.", annotationSubgraph:["Folate metabolic subgraph", "Vitamin subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Alzheimer Disease", "Parkinson Disease"], pmid:"25202269", citationType:"PubMed", citationRef:"25202269"}}, {start: {_id:1285}, end: {_id:995}, properties:{evidence:"Homozygosity for Mthfr 677TT is also associated in selected populations with age-related neurodegenerative diseases such as Alzheimer's disease and Parkinson's disease.", citationTitle:"Front Aging Neurosci. 2014 Aug 22;6:214. doi: 10.3389/fnagi.2014.00214. eCollection 2014.", annotationSubgraph:["Folate metabolic subgraph", "Vitamin subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Alzheimer Disease", "Parkinson Disease"], pmid:"25202269", citationType:"PubMed", citationRef:"25202269"}}, {start: {_id:1285}, end: {_id:16}, properties:{evidence:"In conclusion, our meta-analysis supported the notion that MTHFR C677T polymorphism was a risk factor for PD.", citationTitle:"J Neurol Sci. 2013 Dec 15;335(1-2):14-21. doi: 10.1016/j.jns.2013.09.006. Epub 2013 Sep 12.", annotationSubgraph:["Folate metabolic subgraph", "Vitamin subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"24064257", citationType:"PubMed", citationRef:"24064257"}}, {start: {_id:1290}, end: {_id:16}, properties:{evidence:"Genotyping for MTHFR polymorphisms was carried out by DG-DGGE.The TT+AA genotype was significantly more frequent in PD patients than in controls", citationTitle:"Neuromolecular Med. 2007;9(3):249-54.", annotationSubgraph:["Folate metabolic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"17914182", citationType:"PubMed", citationRef:"17914182"}}, {start: {_id:1285}, end: {_id:16}, properties:{evidence:"we observed that the TT variant of the methylenetetrahydrofolate reductase C677T polymorphism is associated with an increased risk for Parkinson's disease in smokers.", citationTitle:"Ann Neurol. 2005 Jun;57(6):927-30.", annotationSubgraph:["Folate metabolic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"15929053", citationType:"PubMed", citationRef:"15929053"}}, {start: {_id:1303}, end: {_id:16}, properties:{annotationPdstage:["Familial_autosomal_recessive_PD"], evidence:"The authors performed PINK1 mutation analysis of 51 families with autosomal recessive Parkinson disease (ARPD). They found two novel PINK1 mutations: one was a homozygous deletion (13516-18118del) and the other a homozygous missense mutation (C388R). Clinically, the patients with the deletion had dementia. Thus, early-onset PD with dementia may be considered PINK1-linked parkinsonism.", citationTitle:"Neurology. 2005 Jun 14;64(11):1955-7.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Dementia", "Parkinson Disease"], pmid:"15955953", citationType:"PubMed", citationRef:"15955953"}}, {start: {_id:1308}, end: {_id:16}, properties:{evidence:"Our findings indicate that loss of DJ-1 function leads to neurodegeneration.we show that DJ-1 mutations are associated with PARK7, a monogenic form of human parkinsonism. We identified a homozygous point mutation (T->C transition at position 497 from the ORF start in cDNA), resulting in the substitution of a highly conserved leucine at position 166 (Leu166) of the DJ-1 protein by a proline", citationTitle:"Science. 2003 Jan 10;299(5604):256-9. Epub 2002 Nov 21.", annotationSubgraph:["Chaperone subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"12446870", citationType:"PubMed", citationRef:"12446870"}}, {start: {_id:1310}, end: {_id:16}, properties:{evidence:"We identified two mutations in NR4A2 associated with Parkinson disease (-291Tdel and -245T-->G), ,which map to the first exon of NR4A2 and affect one allele in 10 of 107 individuals with familial Parkinson disease but not in any individuals with sporadic Parkinson disease (n = 94) or in unaffected controls (n = 221). The age at onset of disease and clinical features of these ten individuals were not different from those of individuals with typical Parkinson disease.", citationTitle:"Nat Genet. 2003 Jan;33(1):85-9. Epub 2002 Dec 23.", annotationSubgraph:["Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"12496759", citationType:"PubMed", citationRef:"12496759"}}, {start: {_id:1312}, end: {_id:16}, properties:{evidence:"We identified two mutations in NR4A2 associated with Parkinson disease (-291Tdel and -245T-->G), ,which map to the first exon of NR4A2 and affect one allele in 10 of 107 individuals with familial Parkinson disease but not in any individuals with sporadic Parkinson disease (n = 94) or in unaffected controls (n = 221). The age at onset of disease and clinical features of these ten individuals were not different from those of individuals with typical Parkinson disease.", citationTitle:"Nat Genet. 2003 Jan;33(1):85-9. Epub 2002 Dec 23.", annotationSubgraph:["Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"12496759", citationType:"PubMed", citationRef:"12496759"}}, {start: {_id:1252}, end: {_id:16}, properties:{evidence:"we identified methylation and expression changes associated with PD risk variants in PARK16/1q32, GPNMB/7p15, and STX1B/16p11 loci, hence suggesting potential molecular mechanisms and candidate genes at these risk loci.", citationTitle:"PLoS Genet. 2011 Jun;7(6):e1002142. doi: 10.1371/journal.pgen.1002142. Epub 2011 Jun 30.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21738488", citationType:"PubMed", citationRef:"21738488"}}, {start: {_id:1327}, end: {_id:16}, properties:{evidence:"we identified methylation and expression changes associated with PD risk variants in PARK16/1q32, GPNMB/7p15, and STX1B/16p11 loci, hence suggesting potential molecular mechanisms and candidate genes at these risk loci.", citationTitle:"PLoS Genet. 2011 Jun;7(6):e1002142. doi: 10.1371/journal.pgen.1002142. Epub 2011 Jun 30.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21738488", citationType:"PubMed", citationRef:"21738488"}}, {start: {_id:1328}, end: {_id:16}, properties:{evidence:"we identified methylation and expression changes associated with PD risk variants in PARK16/1q32, GPNMB/7p15, and STX1B/16p11 loci, hence suggesting potential molecular mechanisms and candidate genes at these risk loci.", citationTitle:"PLoS Genet. 2011 Jun;7(6):e1002142. doi: 10.1371/journal.pgen.1002142. Epub 2011 Jun 30.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21738488", citationType:"PubMed", citationRef:"21738488"}}, {start: {_id:1330}, end: {_id:16}, properties:{evidence:"Cyclin G-associated kinase (GAK) modifies alpha-synuclein expression levels and affects the susceptibility of Parkinson's disease (PD). The single-nucleotide polymorphism (SNP) rs1564282 of GAK gene has a significant association to the risk of PD among Caucasian populations.", citationTitle:"PLoS One. 2013 Jun 24;8(6):e67506. doi: 10.1371/journal.pone.0067506. Print 2013.", annotationSubgraph:["Cell cycle subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23826309", citationType:"PubMed", annotationRace:["Caucasian"], citationRef:"23826309"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1354}, end: {_id:16}, properties:{evidence:"alpha-Syn overexpression and particularly its PD causing A53T mutant increases the susceptibility of cells to oxidative stress, which is a consistent abnormality in the PD brain", citationTitle:"Proc Natl Acad Sci U S A. 2009 Aug 4;106(31):13052-7. doi: 10.1073/pnas.0906277106. Epub 2009 Jul 23.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"19628698", citationType:"PubMed", citationRef:"19628698"}}, {start: {_id:24}, end: {_id:16}, properties:{evidence:"Parkin, an E3 ubiquitin ligase, is another gene implicated in autosomal recessive PD", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1710}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Finally, mutations in the leucine-rich repeat serine/threonine protein kinase 2 (LRRK2) are the most common known cause of familial and, interestingly, also sporadic PD", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1304}, end: {_id:16}, properties:{evidence:"Mutations of the PARK2 and PINK1 genes, encoding the cytosolic E3 ubiquitin-protein ligase Parkin and the mitochondrial serine/ threonine kinase PINK1, respectively, cause autosomal recessive early- onset Parkinsonâ€™s disease (PD).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:24}, end: {_id:734}, properties:{evidence:"The loss of this protective mechanism may contribute to mitochondrial dysfunction and neuronal degeneration in autosomal recessive PD.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fission subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1768}, end: {_id:550}, properties:{evidence:"HSD17B10 is also thought to have a role in adult- onset neurodegenerative disorders, such as Alzheimerâ€™s disease, in which it may mediate amyloid Î²-driven mitochondrial toxicity,25,29,30 and PD, in which it is downregulated in the ventral midbrain.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Alzheimer Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1304}, end: {_id:16}, properties:{evidence:"Mutations in the PARK2 and PARK6 genes, coding for the cytosolic E3 ubiquitin protein ligase Parkin and the mitochondrial serine/threonine kinase PINK1 [phosphatase and tensin homologue (PTEN)-induced putative kinase 1], lead to clinically similar early-onset Parkinsonian syndromes.", citationTitle:"Biochem Soc Trans. 2015 Apr;43(2):297-301. doi: 10.1042/BST20150008.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25849933", citationType:"PubMed", citationRef:"25849933"}}, {start: {_id:24}, end: {_id:16}, properties:{evidence:"Although PD is mostly idiopathic, our understanding of the molecular mechanisms that lead to this pathology has dramatically improved after the discovery of rare familial forms of PD, mainly associated to mutations in leucine-rich repeat kinase 2 (LRRK2), Î±-synuclein, DJ-1, PINK1 and parkin genes, being mutations in parkin gene respon- sible for the 50% of autosomal recessive PD cases.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:1304}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Increased parkin levels were associated with protection from cellular stress and cell cycle regulation [57â€“59] and overexpression of parkin in cultured cells not only rescued mitochondrial dysfunction caused by PINK1 loss of function, but exerted a cytoprotective role against different toxic stressor [19â€“23,26].", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["PINK1 subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:2016}, end: {_id:16}, properties:{evidence:"Our study suggests that SLC2A9 genetic variants influence age of onset of Parkinson's disease", citationTitle:"J Mol Neurosci. 2011 Mar;43(3):246-50. doi: 10.1007/s12031-010-9409-y. Epub 2010 Jun 30.", pmid:"20589538", citationType:"PubMed", citationRef:"20589538"}}, {start: {_id:2017}, end: {_id:16}, properties:{evidence:"Our study suggests that SLC2A9 genetic variants influence age of onset of Parkinson's disease", citationTitle:"J Mol Neurosci. 2011 Mar;43(3):246-50. doi: 10.1007/s12031-010-9409-y. Epub 2010 Jun 30.", pmid:"20589538", citationType:"PubMed", citationRef:"20589538"}}, {start: {_id:2018}, end: {_id:16}, properties:{evidence:"Our study suggests that SLC2A9 genetic variants influence age of onset of Parkinson's disease", citationTitle:"J Mol Neurosci. 2011 Mar;43(3):246-50. doi: 10.1007/s12031-010-9409-y. Epub 2010 Jun 30.", pmid:"20589538", citationType:"PubMed", citationRef:"20589538"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:531}, end: {_id:461}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consistent with this, blocking the cAMP/PKA pathway resulted in reduced GSK-3 beta, phosphorylation and increased cell death, further suggesting that Ucn 1-induced GSK-3 beta phosphorylation-dependent neuroprotection is mediated by a rise in intracellular levels of cAMP.", citationTitle:"Int J Biochem Cell Biol. 2015 Mar;60C:130-138. doi: 10.1016/j.biocel.2014.12.005. Epub 2014 Dec 23.", annotationSubgraph:["Innate immune system subgraph", "GSK3 subgraph"], pmid:"25541373", citationType:"PubMed", citationRef:"25541373"}}, {start: {_id:1223}, end: {_id:1224}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three days after transplantation, subventricular neurogenesis was significantly increased in MSC-transplanted versus non-transplanted animals. Most MSC were found in the region of the substantia nigra and the surrounding arachnoid mater, expressing S100Å’â‰¤ and brain- derived neurotrophic factor, whereas some MSC showed an endothelial phenotype and localized around blood vessels.", citationTitle:"Cytotherapy. 2015 Feb;17(2):199-214. doi: 10.1016/j.jcyt.2014.09.005. Epub 2014 Oct 24.", annotationSubgraph:["Tumor necrosis factor subgraph", "Calcium-dependent signal transduction"], annotationSpecies:["10116"], annotationMeshanatomy:["Substantia Nigra"], pmid:"25457280", citationType:"PubMed", citationRef:"25457280"}}, {start: {_id:358}, end: {_id:634}, properties:{evidence:"Mitochondrial membrane potential is decreased in the absence of Pink1", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1699}, end: {_id:221}, properties:{evidence:"Regardless, our work provides additional support to the hypothesis that the dysfunction of Complex I is an important and early event in the pathogenesis of Pink1-associated PD", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1440}, end: {_id:271}, properties:{evidence:"By contrast, the turnover of many mitochondrial respiratory chain (RC) subunits showed greater impairment in parkin than Atg7 mutants, and RC turnover was also selectively impaired in PINK1 mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1440}, end: {_id:221}, properties:{evidence:"By contrast, the turnover of many mitochondrial respiratory chain (RC) subunits showed greater impairment in parkin than Atg7 mutants, and RC turnover was also selectively impaired in PINK1 mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1699}, end: {_id:271}, properties:{evidence:"Whether other conditions of relevance for neurodegeneration in PD would also unmask this quality control function of Parkin â€“ e.g. mitochondrial complex I inhibition, which has also been shown to trigger Parkin recruitment to mitochondria,52 â€“ remains to be investigated.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1908}, end: {_id:1883}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Kinetic experiments led to the conclusion that the import of CHCHD4 into mitochondria was translation-dependent (because it only occurred in the absence of CHX) and that it was affected by the abundance of AIF.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1745}, end: {_id:138}, properties:{evidence:"Age related increases in MAO-B expression is associated with increases in free radical damage and reactive oxygen species (ROS) XREF_BIBR - XREF_BIBR.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"23326597", citationType:"PubMed", citationRef:"23326597"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:28}, end: {_id:42}, properties:{annotationCondition:["Normal Healthy State"], evidence:"A Rad18 mutant harboring a Ser ‚Üí Ala substitution at S409 was compromised for PolŒ∑ association and did not redistribute PolŒ∑ to nuclear foci or promote PolŒ∑-PCNA interaction efficiently relative to wild-type Rad18. Rad18 S409A also failed to fully complement the UV sensitivity of Rad18-depleted cells. Taken together, these results show that Rad18 phosphorylation by JNK represents a novel mechanism for promoting TLS and DNA damage tolerance.", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"22456510", citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:399}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"ROCK inhibition protects against dopaminergic cell death induced by dopaminergic neurotoxins.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["RhoA subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:777}, end: {_id:357}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, the observations that (i) mutant LRRK2 is toxic to neuronal cells only if kinase activity is present [44,45], and (ii) small inhibitors against LRRK2 are effective at rescuing LRRK2-mediated neurotoxicity [46] have prompted large efforts towards the discovery of specific inhibitors.", citationTitle:"Biochem Soc Trans. 2012 Oct;40(5):1058-62.", annotationCell:["neuron"], pmid:"22988865", citationType:"PubMed", citationRef:"22988865"}}, {start: {_id:28}, end: {_id:42}, properties:{annotationCondition:["Normal Healthy State"], evidence:"A Rad18 mutant harboring a Ser âˆšÂ¢â€šÃ„â€ â€šÃ„Ã´ Ala substitution at S409 was compromised for PolâˆšÃ©Â¬âˆ‘ association and did not redistribute PolâˆšÃ©Â¬âˆ‘ to nuclear foci or promote PolâˆšÃ©Â¬âˆ‘-PCNA interaction efficiently relative to wild-type Rad18. Rad18 S409A also failed to fully complement the UV sensitivity of Rad18-depleted cells. Taken together, these results show that Rad18 phosphorylation by JNK represents a novel mechanism for promoting TLS and DNA damage tolerance.", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"22456510", annotationCellline:["NCI-H1299", "HCT116"], citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:749}, end: {_id:1716}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We believe that this effect of vitamin K2 is the result of improved mitochondrial function and not because of an important role for vitamin K2 in mitochondrial remodeling, because feeding MK-4 to drp11/2 or pink1B9;drp1/+ mutants that are defective in mitochondrial fission did not res- cue their mitochondrial morphological defects", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1457}, end: {_id:1440}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss of PINK1 and/or Parkin activity has previously been reported to cause RC deficits, particularly in complex I (34â€“36), and complex I dysfunction has repeatedly been implicated in the pathogenesis of PD (37).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:251}, end: {_id:1440}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss of PINK1 and/or Parkin activity has previously been reported to cause RC deficits, particularly in complex I (34â€“36), and complex I dysfunction has repeatedly been implicated in the pathogenesis of PD (37).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:2007}, end: {_id:112}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Chronic neuroinflammation is a common feature of the ageing brain and some neurodegenerative disorders. However, the molecular and cellular mechanisms underlying the regulation of innate immunity in the central nervous system remain elusive. Here we show that the astrocytic dopamine D2 receptor (DRD2) modulates innate immunity through alphaB- crystallin (CRYAB), which is known to suppress neuroinflammation.", citationTitle:"Nature. 2013 Feb 7;494(7435):90-4. doi: 10.1038/nature11748. Epub 2012 Dec 16.", annotationSubgraph:["Chaperone subgraph", "Innate immune system subgraph"], pmid:"23242137", citationType:"PubMed", citationRef:"23242137"}}, {start: {_id:2008}, end: {_id:112}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We demonstrate that knockout mice lacking Drd2 showed remarkable inflammatory response in multiple central nervous system regions and increased the vulnerability of nigral dopaminergic neurons to neurotoxin 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP)-induced neurotoxicity.", citationTitle:"Nature. 2013 Feb 7;494(7435):90-4. doi: 10.1038/nature11748. Epub 2012 Dec 16.", pmid:"23242137", citationType:"PubMed", citationRef:"23242137"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
