UNWIND [{start: {_id:857}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results indicate that a medium level of physical activity lowers Parkinson's disease risk.", citationTitle:"Physical activity and risk of Parkinson's disease in the Swedish National March Cohort. 2015 Feb;138(Pt 2):269-75. doi: 10.1093/brain/awu323. Epub 2014 Nov 18.", pmid:"25410713", citationType:"PubMed", citationRef:"25410713"}}, {start: {_id:1223}, end: {_id:2102}, properties:{evidence:"Promoting adult hippocampal neurogenesis is expected to induce neuroplastic changes that improve mood and alleviate anxiety. Here we show that mice lacking Jnk1, or c-Jun N-terminal kinase (JNK) inhibitor-treated mice, display increased neurogenesis in adult hippocampus characterized by enhanced cell proliferation and survival, and increased maturation in the ventral region. Correspondingly, anxiety behaviour is reduced in a battery of tests, except when neurogenesis is prevented by AraC treatment.", citationTitle:"Mol Psychiatry. 2016 Nov 15. doi: 10.1038/mp.2016.203", annotationSubgraph:["MAPK subgraph"], pmid:"27843149", citationType:"PubMed", citationRef:"27843149"}}, {start: {_id:1140}, end: {_id:2102}, properties:{evidence:"Activation of dopamine neurons is critical for aversive conditioning and prevention of generalized anxiety. Here we describe a mouse model in which activation of dopamine neurons in response to an aversive stimulus is attenuated by conditional genetic inactivation of functional NMDA receptors on dopamine neurons. These data are consistent with a role for dopamine in facilitating contingency awareness that is critical for the prevention of generalized anxiety.", citationTitle:"Nat Neurosci. 2011 May;14(5):620-6", annotationSubgraph:["Dopaminergic subgraph"], pmid:"21499253", citationType:"PubMed", citationRef:"21499253"}}, {start: {_id:1389}, end: {_id:16}, properties:{evidence:"The protective effect of urocortin involved the activation of CRF receptor type 1, resulting in the increase of cyclic AMP (cAMP) levels. Various cAMP-enhancing reagents mimicked the effect of urocortin, while inhibitors for protein kinase A (PKA) blocked the effect of urocortin, strongly implicating the involvement of cAMP-PKA pathway in the neuroprotective effect of urocortin on MPP(+)-induced cell death. As the downstream of this signal pathway, urocortin promoted phosphorylation of both glycogen synthase kinase 3β and extracellular signal-regulated kinases, which are known to promote cell survival.", citationTitle:"Mol Cells. 2010 Nov;30(5):427-33. doi: 10.1007/s10059-010-0132-x.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["9606"], pmid:"20821057", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"20821057"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:511}, end: {_id:513}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The neurotoxicity of SNCA might be mediated through interaction with histone altering its acetylation. This is supported by the finding that AGK2, a potent SIRT2 inhibitor, alleviates alpha-syn mediated toxicity and prevents dopaminergic neuronal death both in vitro and in a Drosophila model of PD.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Synuclein subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:1483}, end: {_id:1484}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The presence of additional factors in the PINK1/TOM complex, such as PGAM5 , Miro and Milton is also possible.", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSpecies:["7227"], pmid:"22280891", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"22280891"}}, {start: {_id:1483}, end: {_id:1485}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The presence of additional factors in the PINK1/TOM complex, such as PGAM5 , Miro and Milton is also possible.", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSpecies:["7227"], pmid:"22280891", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"22280891"}}, {start: {_id:1483}, end: {_id:1486}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The presence of additional factors in the PINK1/TOM complex, such as PGAM5 , Miro and Milton is also possible.", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSpecies:["7227"], pmid:"22280891", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"22280891"}}, {start: {_id:1838}, end: {_id:1839}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Second, in PINK1 and parkin mutants, more nRCC mRNAs bound to Glo in the mito fraction", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1864}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The association of other repressors, such as Pum, Dcp1, GW182, and POP2, with nRCC mRNA was also affected in PINK1 or parkin mutants, although the detailed molecular mechanism remains to be elucidated.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1865}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The association of other repressors, such as Pum, Dcp1, GW182, and POP2, with nRCC mRNA was also affected in PINK1 or parkin mutants, although the detailed molecular mechanism remains to be elucidated.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1867}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The association of other repressors, such as Pum, Dcp1, GW182, and POP2, with nRCC mRNA was also affected in PINK1 or parkin mutants, although the detailed molecular mechanism remains to be elucidated.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1869}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The association of other repressors, such as Pum, Dcp1, GW182, and POP2, with nRCC mRNA was also affected in PINK1 or parkin mutants, although the detailed molecular mechanism remains to be elucidated.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1871}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The association of other repressors, such as Pum, Dcp1, GW182, and POP2, with nRCC mRNA was also affected in PINK1 or parkin mutants, although the detailed molecular mechanism remains to be elucidated.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1877}, end: {_id:1881}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Altogether, this assay corroborates the hypothesis that AIF controls the translation- coupled mitochondrial import of CHCHD4.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1906}, end: {_id:1883}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Second, there is functional evidence in favor of a mechanistic hierarchy between AIF and CHCHD4.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1906}, end: {_id:1883}, properties:{annotationCondition:["Normal Healthy State"], evidence:"How does AIF affect the expression levels of CHCHD4?", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1906}, end: {_id:1883}, properties:{annotationCondition:["Normal Healthy State"], evidence:"it appears plausible that AIF affects the import of CHCHD4 through a specific effect.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1909}, end: {_id:1889}, properties:{annotationCondition:["Normal Healthy State"], evidence:"mutations could provoke similar phenotypes as those described for its interactors, AIF and Erv1 (Di Fonzo et al., 2009).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
