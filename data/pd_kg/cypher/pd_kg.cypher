UNWIND [{start: {_id:1704}, end: {_id:1705}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Complex I transfers electrons from NADH to ubiquinone while pumping protons across the inner mitochondrial membrane contributing to the electrochemical proton gradient used by F1F0 ATP synthase (Complex V) to produce ATP from ADP and inorganic phosphate.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1304}, end: {_id:1829}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is now well established that PINK1 and parkin participate in mitochondrial quality control: PINK1 accumulation at the outer mitohondrial membrane of dysfunctional mitochondria recruits parkin, which in turn promotes their selective degradation by mitophagy", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["PINK1 subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}] AS row
