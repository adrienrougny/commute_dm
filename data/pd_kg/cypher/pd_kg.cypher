UNWIND [{start: {_id:266}, end: {_id:16}, properties:{evidence:"Our results yielded significant evidence for disease association between PINK1 A340T and PD with later onset (OR 1.55, 95% CI 1.04-2.32, p=0.0393), thus suggesting that PINK1 A340T variant may contribute to the risk for late-onset PD in Chinese.Recent studies have demonstrated that mutations in PINK1 (PARK6 locus) gene, encoding PTEN-induced kinase 1, are associated with both familial recessive and sporadic early onset parkinsonism.", citationTitle:"Neurosci Lett. 2006 Dec 20;410(2):121-5. Epub 2006 Nov 7.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17084972", citationType:"PubMed", citationRef:"17084972"}}, {start: {_id:928}, end: {_id:16}, properties:{evidence:"Sequence analysis identified eight genes (IGF2R, SLC22A1, SLC22A2, SLC22A3, PLG, LPA, MAP3K4, and PARK2) as mapping within the large FRA6E region. PARK2, the gene associated with autosomal recessive juvenile parkinsonism (ARJP), accounts for more than half of the CFS. Homozygous deletions and large heterozygous deletions have been observed in PARK2 in ARJP patients.", citationTitle:"Genes Chromosomes Cancer. 2003 Sep;38(1):40-52.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"12874785", citationType:"PubMed", citationRef:"12874785"}}, {start: {_id:1178}, end: {_id:1179}, properties:{evidence:"The patients with SWEDDs have less non-motor problems than newly diagnosed untreated PD patients. Given the difficulty distinguishing between SWEDDs and early PD, identifying some of non-motor symptoms, such as RBD or olfactory impairment, could aid clinicians in their work.", citationTitle:"Parkinsonism Relat Disord. 2014 Dec;20(12):1419-22.", annotationMeshdisease:["Parkinson Disease"], pmid:"22446342", citationType:"PubMed", citationRef:"22446342"}}, {start: {_id:1178}, end: {_id:1180}, properties:{evidence:"The patients with SWEDDs have less non-motor problems than newly diagnosed untreated PD patients. Given the difficulty distinguishing between SWEDDs and early PD, identifying some of non-motor symptoms, such as RBD or olfactory impairment, could aid clinicians in their work.", citationTitle:"Parkinsonism Relat Disord. 2014 Dec;20(12):1419-22.", annotationMeshdisease:["Parkinson Disease"], pmid:"22446342", citationType:"PubMed", citationRef:"22446342"}}, {start: {_id:16}, end: {_id:550}, properties:{evidence:"PD is a common progressive neurodegenerative movement disorder characterized by postural instability, rigidity, tremor and bradykinesia", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:16}, end: {_id:550}, properties:{evidence:"Parkinson's disease (PD) is the most common neurodegenerative movement disorder. It is caused by progressive loss of the dopaminergic neurons of the substantia nigra pars compacta.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationMeshdisease:["Parkinson Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:IS_A]->(end) SET r += row.properties;
