UNWIND [{start: {_id:1989}, end: {_id:267}, properties:{evidence:"Here we demonstrate that engagement of a subset of Toll-like receptors (TLR1, TLR2 and TLR4) results in the recruitment of mitochondria to macrophage phagosomes and augments mROS production. This response involves translocation of a TLR signalling adaptor, tumour necrosis factor receptor-associated factor 6 (TRAF6), to mitochondria, where it engages the protein ECSIT (evolutionarily conserved signalling intermediate in Toll pathways), which is implicated in mitochondrial respiratory chain assembly.", citationTitle:"Nature. 2011 Apr 28;472(7344):476-80. doi:10.1038/nature09973.", annotationSubgraph:["Toll like receptor subgraph"], annotationCell:["macrophage"], pmid:"21525932", citationType:"PubMed", citationRef:"21525932"}}, {start: {_id:1991}, end: {_id:267}, properties:{evidence:"Here we demonstrate that engagement of a subset of Toll-like receptors (TLR1, TLR2 and TLR4) results in the recruitment of mitochondria to macrophage phagosomes and augments mROS production. This response involves translocation of a TLR signalling adaptor, tumour necrosis factor receptor-associated factor 6 (TRAF6), to mitochondria, where it engages the protein ECSIT (evolutionarily conserved signalling intermediate in Toll pathways), which is implicated in mitochondrial respiratory chain assembly.", citationTitle:"Nature. 2011 Apr 28;472(7344):476-80. doi:10.1038/nature09973.", annotationSubgraph:["Toll like receptor subgraph"], annotationCell:["macrophage"], pmid:"21525932", citationType:"PubMed", citationRef:"21525932"}}, {start: {_id:1993}, end: {_id:267}, properties:{evidence:"Here we demonstrate that engagement of a subset of Toll-like receptors (TLR1, TLR2 and TLR4) results in the recruitment of mitochondria to macrophage phagosomes and augments mROS production. This response involves translocation of a TLR signalling adaptor, tumour necrosis factor receptor-associated factor 6 (TRAF6), to mitochondria, where it engages the protein ECSIT (evolutionarily conserved signalling intermediate in Toll pathways), which is implicated in mitochondrial respiratory chain assembly.", citationTitle:"Nature. 2011 Apr 28;472(7344):476-80. doi:10.1038/nature09973.", annotationSubgraph:["Toll like receptor subgraph"], annotationCell:["macrophage"], pmid:"21525932", citationType:"PubMed", citationRef:"21525932"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
