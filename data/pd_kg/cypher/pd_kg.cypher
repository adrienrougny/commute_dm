UNWIND [{start: {_id:1021}, end: {_id:1009}, properties:{evidence:"From the known regulatory mechanisms of Arc expression, HFD reduced N-methyl-D-aspartate receptor (NMDAR) activity, as seen by decreases in tyrosine phosphorylation of NMDAR2A and levels of NMDAR1. Additionally, we demonstrated that 27-hydroxycholesterol, a cholesterol metabolite that enters the brain from the blood, decreases Arc levels as well as NMDAR and Src kinase activities in rat primary hippocampal neurons. Finally, we showed that Arc levels are decreased in the cortex of AD brains. We propose that one of the mechanisms, by which hypercholesterolemia contributes to neurodegenerative diseases, could be through Arc down-regulation caused by 27-hydroxycholesterol.", citationTitle:"Brain Pathol. 2009 Jan;19(1):69-80. doi: 10.1111/j.1750-3639.2008.00174.x. Epub 2008 May 23.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["10116"], annotationMeshdisease:["Alzheimer Disease"], annotationMeshanatomy:["Hippocampus"], pmid:"18503570", citationType:"PubMed", citationRef:"18503570"}}, {start: {_id:2001}, end: {_id:2002}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Excessive mitochondrial fission was observed in lentivirus-transfected BV-2 cells stably expressing DsRed2-mito following LPS stimulation. Furthermore, mitochondrial localization of dynamin-related protein 1 (Drp1) (a key regulator of mitochondrial fission) was increased and accompanied by de-phosphorylation of Ser637 in Drp1.", citationTitle:"J Neurochem. 2013 Oct;127(2):221-32. doi: 10.1111/jnc.12361. Epub 2013 Jul 29.", annotationSubgraph:["Mitophagy subgraph"], pmid:"23815397", citationType:"PubMed", citationRef:"23815397"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
