CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:238}, end: {_id:16}, properties:{evidence:"we assessed the complex assembly of PINK1 PD patient mutants A168P, H271Q and G309D using the in vitro import assay", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22280891", citationType:"PubMed", citationRef:"22280891"}}, {start: {_id:271}, end: {_id:16}, properties:{evidence:"We also found that in the neuronal cell line SH-SY5Y, that expresses endogenous Parkin and may be more relevant for PD", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22280891", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"22280891"}}, {start: {_id:1496}, end: {_id:16}, properties:{evidence:"Mutation of the PARKIN active site residue C431S, which has been found mutated in Parkinson's disease patients, largely disrupts these associations.", citationTitle:"Nature. 2013 Apr 18;496(7445):372-6. doi: 10.1038/nature12043. Epub 2013 Mar 17.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"23503661", citationType:"PubMed", citationRef:"23503661"}}, {start: {_id:1503}, end: {_id:16}, properties:{evidence:"We explored the role of these regions in MOM recruitment, MFN2 ubiquitylation, substrate binding, and proteasome association using 5 mutants (Figure S6a): 1) Î”UBL, lacking the UBL domain (residues 1â€“80), 2) K27/48R, which blocks ubiquitylation of two regulated diGLY sites in the UBL (Figure 2), 3) S65A and S65E, which block PINK1-dependent phosphorylation of the UBL domain implicated in PARKIN activation in vitro,18 and 4) C431S, removing the active site Cys in RING2. The PD patient mutation PARKINC431F fails to localize to mitochondria in response to depolarization.15,20 Consistent with this, PARKINC431S failed to localize to mitochondria, efficiently poly- ubiquitylate MFN2, or interact robustly with MOM substrates in response to depolarization. In contrast, K27/K48R, S65A, and S65E mutants displayed near wild-type activity for localization, MFN2 ubiquitylation", citationTitle:"Nature. 2013 Apr 18;496(7445):372-6. doi: 10.1038/nature12043. Epub 2013 Mar 17.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"23503661", citationType:"PubMed", citationRef:"23503661"}}, {start: {_id:1469}, end: {_id:16}, properties:{evidence:"Our model is consistent with all but one of the patient and structure- based PARKIN mutants analyzed here, the exception being PARKINR275W, which translocates efficiently to mitochondria but fails to build UB chains.", citationTitle:"Mol Cell. 2014 Nov 6;56(3):360-75. doi: 10.1016/j.molcel.2014.09.007. Epub 2014 Oct 2.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25284222", citationType:"PubMed", citationRef:"25284222"}}, {start: {_id:271}, end: {_id:16}, properties:{evidence:"we report that USP30, a deubiquitinase localized to mitochondria, antagonizes mitophagy driven by the ubiquitin ligase parkin (also known as PARK2) and protein kinase PINK1, which are encoded by two genes associated with Parkinson's disease.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:221}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we report that USP30, a deubiquitinase localized to mitochondria, antagonizes mitophagy driven by the ubiquitin ligase parkin (also known as PARK2) and protein kinase PINK1, which are encoded by two genes associated with Parkinson's disease.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1539}, end: {_id:16}, properties:{evidence:"In this study, we show that MUL1 suppresses PINK1 or parkin phenotypes in Drosophila. The suppression is achieved through the ubiquitin- dependent degradation of Mitofusin, which itself causes PINK1/parkin mutant-like toxicity when overexpressed. We further show that removing MUL1 in PINK1 or parkin loss-of-function mutant aggravates phenotypes caused by loss of either gene alone, leading to lethality in flies and degeneration in mouse cortical neurons. Together, these observations show that MUL1 acts in parallel to the PINK1/parkin pathway on a shared target mitofusin to maintain mitochondrial integrity. The MUL1 pathway compensates for loss of PINK1/parkin in both Drosophila and mammals and is a promising therapeutic target for PD", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:221}, end: {_id:16}, properties:{evidence:"the mitochondrial kinase PTEN-induced putative kinase 1 (PINK1) and the mainly cytosolic Parkin, an E3 ubiquitin ligase, have been linked to familial cases of Parkinsonâ€™s disease. PINK1 and Parkin function as part of a mitochondrial quality control pathway that is likely impaired in Parkinsonâ€™s disease", citationTitle:"Cell Metab. 2014 Mar 4;19(3):357-72. doi: 10.1016/j.cmet.2014.01.010. Epub 2014 Feb 20.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"24561263", citationType:"PubMed", citationRef:"24561263"}}, {start: {_id:271}, end: {_id:16}, properties:{evidence:"the mitochondrial kinase PTEN-induced putative kinase 1 (PINK1) and the mainly cytosolic Parkin, an E3 ubiquitin ligase, have been linked to familial cases of Parkinsonâ€™s disease. PINK1 and Parkin function as part of a mitochondrial quality control pathway that is likely impaired in Parkinsonâ€™s disease", citationTitle:"Cell Metab. 2014 Mar 4;19(3):357-72. doi: 10.1016/j.cmet.2014.01.010. Epub 2014 Feb 20.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"24561263", citationType:"PubMed", citationRef:"24561263"}}, {start: {_id:271}, end: {_id:16}, properties:{evidence:"Loss-of-function mutations in PARK2, the gene encoding the E3 ubiquitin ligase Parkin, are the most frequent cause of recessive Parkinson's disease (PD).", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:271}, end: {_id:16}, properties:{evidence:"Mutations in the Park2 gene, encoding the E3 ubiquitinâ€�ligase parkin, are responsible for a familial form of Parkinson's disease (PD). Parkinâ€�mediated ubiquitination is critical for the efficient elimination of depolarized dysfunctional mitochondria by autophagy (mitophagy).", citationTitle:"EMBO J. 2014 Nov 3;33(21):2473-91. doi: 10.15252/embj.201489729. Epub 2014 Sep 12.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"25216678", citationType:"PubMed", citationRef:"25216678"}}, {start: {_id:221}, end: {_id:16}, properties:{evidence:"Parkinson's disease mutations in PINK1 result in decreased Complex I activity and deficient synaptic function", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:221}, end: {_id:16}, properties:{evidence:"Regardless, our work provides additional support to the hypothesis that the dysfunction of Complex I is an important and early event in the pathogenesis of Pink1-associated PD", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1642}, end: {_id:1914}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We identified the transcription factor ATF4 as a key factor in the stress-induced regulation of parkin expression, which binds to a CREB/ATF site within the parkin promoter.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Unfolded protein response subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:16}, properties:{evidence:"Ubiquitin-mediated targeting of intracellular bacteria to the autophagy pathway is a key innate defence mechanism against invading microbes, including the important human pathogen Mycobacterium tuberculosis. However, the ubiquitin ligases responsible for catalysing ubiquitin chains that surround intracellular bacteria are poorly understood. The parkin protein is a ubiquitin ligase with a well-established role in mitophagy, and mutations in the parkin gene (PARK2) lead to increased susceptibility to Parkinson's disease. Surprisingly, genetic polymorphisms in the PARK2 regulatory region are also associated with increased susceptibility to intracellular bacterial pathogens in humans, including Mycobacterium leprae and Salmonella enterica serovar Typhi, but the function of parkin in immunity has remained unexplored. Here we show that parkin has a role in ubiquitin-mediated autophagy of M. tuberculosis. Both parkin- deficient mice and flies are sensitive to various intracellular bacterial infections, indicating parkin has a conserved role in metazoan innate defence. Moreover, our work reveals an unexpected functional link between mitophagy and infectious disease.", citationTitle:"Nature. 2013 Sep 26;501(7468):512-6. doi:10.1038/nature12566. Epub 2013 Sep 4.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24005326", citationType:"PubMed", citationRef:"24005326"}}, {start: {_id:203}, end: {_id:16}, properties:{evidence:"Recent genome wide association studies on inflammatory bowel disease, which is linked to altered host-gut microbe interactions, have identified susceptibility SNPs within LRRK2 and Park7, two genes canonically associated with Parkinsonï¿½s disease", citationTitle:"Nature. 2013 Sep 26;501(7468):512-6. doi:10.1038/nature12566. Epub 2013 Sep 4.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24005326", citationType:"PubMed", citationRef:"24005326"}}, {start: {_id:220}, end: {_id:16}, properties:{evidence:"Recent genome wide association studies on inflammatory bowel disease, which is linked to altered host-gut microbe interactions, have identified susceptibility SNPs within LRRK2 and Park7, two genes canonically associated with Parkinsonï¿½s disease", citationTitle:"Nature. 2013 Sep 26;501(7468):512-6. doi:10.1038/nature12566. Epub 2013 Sep 4.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24005326", citationType:"PubMed", citationRef:"24005326"}}, {start: {_id:203}, end: {_id:16}, properties:{evidence:"Autosomal dominant mutations in leucine-rich repeat kinase 2 (LRRK2) are the most common genetic cause of late-onset Parkinson's disease.", citationTitle:"J Neurochem. 2009 Sep;110(5):1514-22. doi: 10.1111/j.1471-4159.2009.06235.x. Epub 2009 Jun 22.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19545277", citationType:"PubMed", citationRef:"19545277"}}, {start: {_id:137}, end: {_id:16}, properties:{evidence:"Here, using co-immunoprecipitation, we found that LRRK2 interacted with synphilin-1 (SP1), a cytoplasmic protein that interacts with α-synuclein and has implications in PD pathogenesis.", citationTitle:"Hum Mol Genet. 2016 Feb 15;25(4):672-80. doi: 10.1093/hmg/ddv504. Epub 2016 Jan 6.", annotationSubgraph:["Ubiquitin subgraph", "LRRK2 subgraph", "Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26744328", citationType:"PubMed", citationRef:"26744328"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:2035}, end: {_id:995}, properties:{evidence:"Altered expression of EFhd2 has been documented in AD, Parkinson's disease, Huntington's disease, Amyotrophic Lateral Sclerosis, and schizophrenia, indicating that Efhd2 gene expression is regulated in response to neuropathological processes.", citationTitle:"Front Neurosci. 2016 Mar 31;10:150. doi: 10.3389/fnins.2016.00150. eCollection 2016.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"27064956", citationType:"PubMed", citationRef:"27064956"}}, {start: {_id:2035}, end: {_id:16}, properties:{evidence:"Altered expression of EFhd2 has been documented in AD, Parkinson's disease, Huntington's disease, Amyotrophic Lateral Sclerosis, and schizophrenia, indicating that Efhd2 gene expression is regulated in response to neuropathological processes.", citationTitle:"Front Neurosci. 2016 Mar 31;10:150. doi: 10.3389/fnins.2016.00150. eCollection 2016.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"27064956", citationType:"PubMed", citationRef:"27064956"}}, {start: {_id:2035}, end: {_id:2043}, properties:{evidence:"Altered expression of EFhd2 has been documented in AD, Parkinson's disease, Huntington's disease, Amyotrophic Lateral Sclerosis, and schizophrenia, indicating that Efhd2 gene expression is regulated in response to neuropathological processes.", citationTitle:"Front Neurosci. 2016 Mar 31;10:150. doi: 10.3389/fnins.2016.00150. eCollection 2016.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"27064956", citationType:"PubMed", citationRef:"27064956"}}, {start: {_id:2035}, end: {_id:2044}, properties:{evidence:"Altered expression of EFhd2 has been documented in AD, Parkinson's disease, Huntington's disease, Amyotrophic Lateral Sclerosis, and schizophrenia, indicating that Efhd2 gene expression is regulated in response to neuropathological processes.", citationTitle:"Front Neurosci. 2016 Mar 31;10:150. doi: 10.3389/fnins.2016.00150. eCollection 2016.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"27064956", citationType:"PubMed", citationRef:"27064956"}}, {start: {_id:419}, end: {_id:16}, properties:{evidence:"Single-nucleotide polymorphisms in MAPT (rs1800547; P = 3.1 × 10(-4) ) and SNCA (rs356219; P = 5.5 × 10(-4) ) were significantly associated with Parkinson's disease.", citationTitle:"Mov Disord. 2011 Apr;26(5):819-23. doi: 10.1002/mds.23642.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["9606"], pmid:"21425343", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"21425343"}}, {start: {_id:137}, end: {_id:16}, properties:{evidence:"Single-nucleotide polymorphisms in MAPT (rs1800547; P = 3.1 × 10(-4) ) and SNCA (rs356219; P = 5.5 × 10(-4) ) were significantly associated with Parkinson's disease.", citationTitle:"Mov Disord. 2011 Apr;26(5):819-23. doi: 10.1002/mds.23642.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["9606"], pmid:"21425343", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"21425343"}}, {start: {_id:2256}, end: {_id:16}, properties:{evidence:"Rasagiline is a second-generation MAO-B inhibitor that selectively and irreversibly inhibits brain MAO-B, specifically designed for the treatment of PD.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"21935322", citationType:"PubMed", citationRef:"21935322"}}, {start: {_id:2264}, end: {_id:16}, properties:{evidence:"This property of selegiline, together with observation that the basal ganglia of human brain possessed predominantly MAO-B that could metabolize dopamine led us to initiate a pilot study with selegiline in Parkinson 's disease.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["Very High"], pmid:"23585716", citationType:"PubMed", citationRef:"23585716"}}, {start: {_id:2265}, end: {_id:16}, properties:{evidence:"Abnormal expression of MIF has been implicated in many neurological diseases, including Parkinson's disease, epilepsy, Alzheimer's Disease, stroke, and neuropathic pain.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"25118614", citationType:"PubMed", citationRef:"25118614"}}, {start: {_id:2265}, end: {_id:995}, properties:{evidence:"Abnormal expression of MIF has been implicated in many neurological diseases, including Parkinson's disease, epilepsy, Alzheimer's Disease, stroke, and neuropathic pain.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"25118614", citationType:"PubMed", citationRef:"25118614"}}, {start: {_id:2265}, end: {_id:2266}, properties:{evidence:"Abnormal expression of MIF has been implicated in many neurological diseases, including Parkinson's disease, epilepsy, Alzheimer's Disease, stroke, and neuropathic pain.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"25118614", citationType:"PubMed", citationRef:"25118614"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:500}, end: {_id:501}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hyperhomocysteine induces oxidative stress via NMDA receptor-mediated neuronal nitric oxide synthase activation and formation of radicals, which leads to mitochondrial dysfunction and the release of Cytochrome c and of apoptosis inducing factor (AIF), ultimately causing cell apoptosis [24].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationMeshanatomy:["Serum"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:328}, end: {_id:501}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In addition, high level of homocysteine (HCY) can induce dopaminergic neuronal apoptosis via impairment of mitochondrial function and apoptosis-related gene activation, leading to caspase activation and neuronal apoptosis.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:627}, end: {_id:77}, properties:{evidence:"Here we show that lack of DJ-1 attenuates astrocytes' ability to support neuronal cells, thereby leading to accelerated neuronal damage.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 50; Iss. 3", annotationSubgraph:["Chaperone subgraph", "Response to oxidative stress"], annotationMeshdisease:["Parkinson Disease"], pmid:"23536331", citationType:"PubMed", citationRef:"23536331"}}, {start: {_id:733}, end: {_id:267}, properties:{annotationCondition:["Normal Healthy State"], evidence:"ATP production in neuronal cells is dependent on mitochondrial glucose oxidation, and reactive oxygen species (ROS) production associated with neuronal activation might be a major cause of mitochondrial damage in dopamine neurons.", citationTitle:"Brain and nerve = Shinkei kenky?? no shinpo; Vol. 65; Iss. 12", annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"24323934", citationType:"PubMed", citationRef:"24323934"}}, {start: {_id:733}, end: {_id:736}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Astroglia provide neurons with lactate produced from glucose via glycolysis in response to neuronal activation.", citationTitle:"Brain and nerve = Shinkei kenky?? no shinpo; Vol. 65; Iss. 12", annotationMeshanatomy:["Neurons", "Astrocytes"], pmid:"24323934", citationType:"PubMed", citationRef:"24323934"}}, {start: {_id:1255}, end: {_id:1256}, properties:{annotationCondition:["Normal Healthy State"], evidence:"DNA methylation describes the covalent modification of cytosine residues in DNA, which leads to the formation 5-methycytosine (5mC)", citationTitle:"Mol Aspects Med. 2013 Jul-Aug;34(4):875-82. doi: 10.1016/j.mam.2012.06.011. Epub 2012 Jul 7.", annotationSubgraph:["Transport related subgraph"], annotationSpecies:["9606"], pmid:"22782013", citationType:"PubMed", citationRef:"22782013"}}, {start: {_id:1565}, end: {_id:1566}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Certain environmental states, such as cold temperatures or high- calorie diets, are known to increase the activity of the sympathetic nervous system, leading to the release of norepinephrine. This neurotransmitter triggers activation of the Î²-adrenergic receptors, resulting in the elevation of intracellular cAMP and stimulation of adaptive thermogenesis in skeletal muscle and brown fat", citationTitle:"Cell. 1999 Jul 9;98(1):115-24.", annotationSubgraph:["G-protein-mediated signaling"], pmid:"10412986", citationType:"PubMed", citationRef:"10412986"}}, {start: {_id:1699}, end: {_id:267}, properties:{evidence:"Reduced Complex I activity can lead to increased levels of ROS production as found in several studies", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1751}, end: {_id:1746}, properties:{annotationCondition:["Normal Healthy State"], evidence:"eeding heix mutants during development with MK-4 but not with menadione, a synthetic precursor that is prenylated to form vitamin K2, significantly improved their survival rate (Fig. 2, A and B) and other cellular defects (below), whereas ubiquinone (Q-10) feeding did not (Fig. 2A), indicating specificity (10).", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1930}, end: {_id:267}, properties:{evidence:"It is possible that ROS produced by glutamate excitotoxicity could oxidatively modify some of the cytosolic Parkin pool, reducing the translocation to mitochondria", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1942}, end: {_id:593}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Glutamate acts at NMDA receptors in cultured rat forebrain neurons to increase the intracellular free calcium concentration.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshanatomy:["Medial Forebrain Bundle"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:131}, end: {_id:1944}, properties:{evidence:"These results indicate that very high levels of cytoplasmic calcium are not necessarily toxic to forebrain neurons, and that potential- driven uptake of calcium into mitochondria is required to trigger NMDA-receptor-stimulated neuronal death.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshanatomy:["Cytoplasmic Structures"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:1986}, end: {_id:267}, properties:{evidence:"Notably, both ROS generation and inflammasome activation are suppressed when mitochondrial activity is dysregulated by inhibition of the voltage-dependent anion channel.", citationTitle:"Nature. 2011 Jan 13;469(7329):221-5. doi:10.1038/nature09663. Epub 2010 Dec 1. Erratum in: Nature. 2011 Jul 7;475(7354):122.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21124315", citationType:"PubMed", citationRef:"21124315"}}, {start: {_id:1999}, end: {_id:1943}, properties:{evidence:"Over-activation of microglia cells in the brain contributes to neurodegenerative processes promoted by the production of various neurotoxic factors including pro-inflammatory cytokines and nitric oxide.", citationTitle:"J Neurochem. 2013 Oct;127(2):221-32. doi: 10.1111/jnc.12361. Epub 2013 Jul 29.", annotationMeshdisease:["Parkinson Disease"], pmid:"23815397", citationType:"PubMed", citationRef:"23815397"}}, {start: {_id:311}, end: {_id:267}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interestingly, inhibition of LPS-induced mitochondrial fission and reactive oxygen species (ROS) generation by Mdivi-1 and Drp1 knock- down attenuated the production of pro-inflammatory mediators via reduced nuclear factor kappa-light-chain-enhancer of activated B cells (NF-kB) and mitogen-activated protein kinase (MAPK) signaling. Our results demonstrated for the first time that mitochondrial fission regulates mitochondrial ROS production in activated microglial cells and influences the expression of pro-inflammatory mediators through the activation of NF-kB and MAPK. We therefore suggest that mitochondrial dynamics may be essential for understanding pro- inflammatory mediator expression in activated microglial cells. This could represent a new therapeutic approach for preventing neurodegenerative diseases.", citationTitle:"J Neurochem. 2013 Oct;127(2):221-32. doi: 10.1111/jnc.12361. Epub 2013 Jul 29.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"23815397", citationType:"PubMed", citationRef:"23815397"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:876}, end: {_id:877}, properties:{evidence:"dysphagia, especially unrecognized dysphagia, plays a role in weight loss in Parkinson's disease.", citationTitle:"Rinsho Shinkeigaku. 1999 Oct;39(10):1010-4.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"10655760", citationType:"PubMed", citationRef:"10655760"}}] AS row
