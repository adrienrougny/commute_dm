UNWIND [{start: {_id:392}, end: {_id:62}, properties:{evidence:"Mitochondrial respiratory failure induces oxidative damage in neurons, and we found increase in hydroxynonenal and 8-oxo-deoxyguanine, indices of oxidative damage, in the nigral neurons of PD.These abnormalities can trigger apoptotic cell death.", citationTitle:"Rinsho Shinkeigaku. 2004 Apr-May;44(4-5):241-62.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15287506", citationType:"PubMed", citationRef:"15287506"}}, {start: {_id:356}, end: {_id:535}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental evidence using cellular and animal models have shown that environmental and biological toxins, like Œ±-synuclein, LPS (lipopolysaccharides), herbicides and pesticides like rotenone or MPTP (1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine), can induce both astrogliosis and microgliosis, which is accompanied by altered striatal neuronal morphology, neuronal death,mitochondrial dysfunction and nuclear fragmentation.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:562}, end: {_id:566}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Experimental evidence using cellular and animal models have shown that environmental and biological toxins, like Œ±-synuclein, LPS (lipopolysaccharides), herbicides and pesticides like rotenone or MPTP (1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine), can induce both astrogliosis and microgliosis, which is accompanied by altered striatal neuronal morphology, neuronal death,mitochondrial dysfunction and nuclear fragmentation.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:592}, end: {_id:515}, properties:{evidence:"Considerable experimental evidence suggests that a significant contributor to dopaminergic neuronal loss in the PD brain is ROS, which result from dopamine metabolism, low glutathione (GSH), and high levels of iron and calcium in the SNpc.", citationTitle:"J Parkinsons Dis. 2013;3(4):461-91. doi: 10.3233/JPD-130230.", annotationSubgraph:["Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"24252804", citationType:"PubMed", citationRef:"24252804"}}, {start: {_id:593}, end: {_id:515}, properties:{evidence:"Considerable experimental evidence suggests that a significant contributor to dopaminergic neuronal loss in the PD brain is ROS, which result from dopamine metabolism, low glutathione (GSH), and high levels of iron and calcium in the SNpc.", citationTitle:"J Parkinsons Dis. 2013;3(4):461-91. doi: 10.3233/JPD-130230.", annotationSubgraph:["Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"24252804", citationType:"PubMed", citationRef:"24252804"}}, {start: {_id:592}, end: {_id:270}, properties:{evidence:"This is because dopaminergic neurons in the substantia nigra are chronically exposed to oxidative stress caused by high levels of iron and autooxidation of dopamine.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Reactive oxygen species subgraph", "Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra", "Dopaminergic Neurons"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:778}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In neuronal cells, 6-OHDA and H2O2 are known to cause oxidative stress and apoptosis (Anantharam et al., 2007 and Hanrott et al., 2006).", citationTitle:"Brain Res. 2009 Feb 23;1256:19-33. doi: 10.1016/j.brainres.2008.12.020. Epub 2008 Dec 24.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["neuron"], pmid:"19135032", citationType:"PubMed", citationRef:"19135032"}}, {start: {_id:780}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In neuronal cells, 6-OHDA and H2O2 are known to cause oxidative stress and apoptosis (Anantharam et al., 2007 and Hanrott et al., 2006).", citationTitle:"Brain Res. 2009 Feb 23;1256:19-33. doi: 10.1016/j.brainres.2008.12.020. Epub 2008 Dec 24.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["neuron"], pmid:"19135032", citationType:"PubMed", citationRef:"19135032"}}, {start: {_id:778}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In neuronal cells, 6-OHDA and H2O2 are known to cause oxidative stress and apoptosis (Anantharam et al., 2007 and Hanrott et al., 2006).", citationTitle:"Brain Res. 2009 Feb 23;1256:19-33. doi: 10.1016/j.brainres.2008.12.020. Epub 2008 Dec 24.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["neuron"], pmid:"19135032", citationType:"PubMed", citationRef:"19135032"}}, {start: {_id:780}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In neuronal cells, 6-OHDA and H2O2 are known to cause oxidative stress and apoptosis (Anantharam et al., 2007 and Hanrott et al., 2006).", citationTitle:"Brain Res. 2009 Feb 23;1256:19-33. doi: 10.1016/j.brainres.2008.12.020. Epub 2008 Dec 24.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["neuron"], pmid:"19135032", citationType:"PubMed", citationRef:"19135032"}}, {start: {_id:888}, end: {_id:299}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Omega-3 deficiency can reduce the nigrostriatal system's ability to maintain homeostasis under oxidative conditions, which may enhance the risk of Parkinson's disease.", citationTitle:"Biochim Biophys Acta. 2014 Jun;1840(6):1902-12. doi: 10.1016/j.bbagen.2013.12.023. Epub 2013 Dec 20.", annotationSpecies:["10116"], annotationMeshanatomy:["Substantia Nigra"], pmid:"24361617", citationType:"PubMed", citationRef:"24361617"}}, {start: {_id:958}, end: {_id:957}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Dexamethasone, a glucocorticoid hormone receptor agonist, upregulated both protein and mRNA levels of TREK-1 leading to decreased NSC proliferation which could be reversed by bupivacaine. Fluoxetine, a serotonin reuptake inhibitor antidepressant that has been previously found to inhibit TREK-1 channels, robustly, could attenuate the upregulation of TREK-1 expression and the inhibition of NSC proliferation induced by dexamethasone.", citationTitle:"Psychopharmacology (Berl). 2011 Apr;214(3):747-59. doi: 10.1007/s00213-010-2077-3. Epub 2010 Nov 11.", annotationSubgraph:["Transport related subgraph"], pmid:"21069514", citationType:"PubMed", citationRef:"21069514"}}, {start: {_id:501}, end: {_id:270}, properties:{evidence:"Hcy exerts a neurotoxic action and may participate in the mechanisms of neurodegeneration, such as excitotoxicity, oxidative stress, calcium accumulation, and apoptosis.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:501}, end: {_id:62}, properties:{evidence:"Hcy exerts a neurotoxic action and may participate in the mechanisms of neurodegeneration, such as excitotoxicity, oxidative stress, calcium accumulation, and apoptosis.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-01", annotationConfidence:["Very High"], pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:44}, end: {_id:1223}, properties:{evidence:"In Parkinson's disease (PD), neurogenesis in the subventricular zone (SVZ)-olfactory bulb (OB) axis is affected as the result of the lack of dopaminergic innervations reaching the SVZ.", citationTitle:"Cytotherapy. 2015 Feb;17(2):199-214. doi: 10.1016/j.jcyt.2014.09.005. Epub 2014 Oct 24.", annotationSubgraph:["Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Olfactory Bulb"], pmid:"25457280", annotationAnatomy:["subparaventricular zone"], citationType:"PubMed", citationRef:"25457280"}}, {start: {_id:316}, end: {_id:1223}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three days after transplantation, subventricular neurogenesis was significantly increased in MSC-transplanted versus non-transplanted animals. Most MSC were found in the region of the substantia nigra and the surrounding arachnoid mater, expressing S100Å’â‰¤ and brain- derived neurotrophic factor, whereas some MSC showed an endothelial phenotype and localized around blood vessels.", citationTitle:"Cytotherapy. 2015 Feb;17(2):199-214. doi: 10.1016/j.jcyt.2014.09.005. Epub 2014 Oct 24.", annotationSubgraph:["Calcium-dependent signal transduction"], annotationSpecies:["10116"], annotationCell:["mesenchymal cell"], pmid:"25457280", citationType:"PubMed", citationRef:"25457280"}}, {start: {_id:1227}, end: {_id:1230}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Estradiol increased astrocyte density and olfactory epithelium (OE) thickness regardless of the genotype. In addition estradiol treatment increased the number of mature neurons in the OE and glomerular synaptophysin in both genotypes, but the magnitude of increase was greater in the WT than in the KO mice. These data suggest that estrogen and apoE act synergistically to minimize the loss of mature sensory neurons and synapses following ovariectomy.", citationTitle:"Exp Neurol. 2012 Sep;237(1):1-7. doi: 10.1016/j.expneurol.2012.06.001. Epub 2012 Jun 9.", pmid:"22691461", citationType:"PubMed", citationRef:"22691461"}}, {start: {_id:1278}, end: {_id:62}, properties:{evidence:"Hyperacetylation of Histones Promotes Dieldrin-Induced Caspase-3 Activation and PKCâˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â¥ Proteolytic Activation in Dopaminergic Cells. Inhibition of Hyperacetylation Protects Dopaminergic Cells from Dieldrin-Induced Apoptosis and Neurotoxicity.", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:501}, end: {_id:328}, properties:{evidence:"Increased plasma levels of homocysteine through direct neurotoxic effects might accelerate the selective dopaminergic cell death underlying Parkinson's disease. Our findings support the hypothesis that homocysteine plays a role in the pathogenesis of Parkinson's disease.", citationTitle:"Ann Neurol. 2005 Jun;57(6):927-30.", annotationSubgraph:["Folate metabolic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"15929053", citationType:"PubMed", citationRef:"15929053"}}, {start: {_id:1368}, end: {_id:1369}, properties:{evidence:"it has also been demonstrated that cocaine induces the MAPK pathway and through MSK1 phosphorylates histone H3 at Ser10", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSubgraph:["MAPK subgraph", "DNA synthesis"], annotationSpecies:["9606"], annotationMeshanatomy:["Neostriatum"], pmid:"21892731", citationType:"PubMed", citationRef:"21892731"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1249}, end: {_id:1398}, properties:{evidence:"The increase in mTORC1 signaling persisted during chronic administration of L-DOPA and showed a high correlation with the severity of dyskinesia", citationTitle:"Cell Cycle. 2010 Jul 15;9(14):2713-8. Epub 2010 Jul 27.", annotationSpecies:["9606"], annotationMeshdisease:["Dyskinesia, Drug-Induced"], pmid:"20581466", citationType:"PubMed", citationRef:"20581466"}}, {start: {_id:562}, end: {_id:515}, properties:{evidence:"The neurotoxin 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP) impairs mitochondrial respiration and damages dopaminergic neurons as seen in Parkinson's disease (PD). Here, we report that L-3-hydroxyacyl-CoA dehydrogenase type II/amyloid binding alcohol dehydrogenase (HADH II/ABAD), a mitochondrial oxidoreductase enzyme involved in neuronal survival, is downregulated in PD patients and in MPTP-intoxicated mice.", citationTitle:"Ann Neurol. 2004 Jul;56(1):51-60.", annotationMeshdisease:["Parkinson Disease"], pmid:"15236401", citationType:"PubMed", citationRef:"15236401"}}, {start: {_id:562}, end: {_id:1406}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We also show that transgenic mice with increased expression of human HADH II/ABAD are significantly more resistant to MPTP than their wild- type littermates. This effect appears to be mediated by overexpression of HADH II/ABAD mitigating MPTP-induced impairment of oxidative phosphorylation and ATP production.", citationTitle:"Ann Neurol. 2004 Jul;56(1):51-60.", annotationMeshdisease:["Parkinson Disease"], pmid:"15236401", citationType:"PubMed", citationRef:"15236401"}}, {start: {_id:1412}, end: {_id:328}, properties:{evidence:"we overproduced this protein in PC12 cells in an inducible manner. In this cell line, neuronally differentiated by nerve growth factor, Parkin overproduction protected against cell death mediated by ceramide", citationTitle:"Hum Mol Genet. 2003 Mar 1;12(5):517-26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"12588799", annotationCellline:["PC-12 cell"], citationType:"PubMed", citationRef:"12588799"}}, {start: {_id:1548}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Re-expressing PINK1 in PINK1-knockout cells rescued oligomycin/antimycin-A-induced mitophagy", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:1522}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Re-expressing PINK1 in PINK1-knockout cells rescued oligomycin/antimycin-A-induced mitophagy", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:1629}, end: {_id:1630}, properties:{evidence:"Injury causes a systemic inflammatory response syndrome (SIRS) that is clinically much like sepsis. Microbial pathogen-associated molecular patterns (PAMPs) activate innate immunocytes through pattern recognition receptors. Similarly, cellular injury can release endogenous 'damage'-associated molecular patterns (DAMPs) that activate innate immunity. Mitochondria are evolutionary endosymbionts that were derived from bacteria and so might bear bacterial molecular motifs. Here we show that injury releases mitochondrial DAMPs (MTDs) into the circulation with functionally important immune consequences. MTDs include formyl peptides and mitochondrial DNA. These activate human polymorphonuclear neutrophils (PMNs) through formyl peptide receptor-1 and Toll-like receptor (TLR) 9, respectively. MTDs promote PMN Ca(2+) flux and phosphorylation of mitogen-activated protein (MAP) kinases, thus leading to PMN migration and degranulation in vitro and in vivo. Circulating MTDs can elicit neutrophil-mediated organ injury. Cellular disruption by trauma releases mitochondrial DAMPs with evolutionarily conserved similarities to bacterial PAMPs into the circulation. These signal through innate immune pathways identical to those activated in sepsis to create a sepsis-like state. The release of such mitochondrial 'enemies within' by cellular injury is a key link between trauma, inflammation and SIRS.", citationTitle:"Nature. 2010 Mar 4;464(7285):104-7. doi: 10.1038/nature08780.", annotationMeshdisease:["Systemic Inflammatory Response Syndrome"], pmid:"20203610", citationType:"PubMed", citationRef:"20203610"}}, {start: {_id:748}, end: {_id:1684}, properties:{evidence:"Mitochondrial damage is known to abrogate the heat-shock response. Consistent with this, we found that mPOS did not upregulate the major heat-shock-inducible Hsp70-type chaperones (for example, Ssa1, Ssa2, Sse1 and Sse2; Extended Data Fig. 7).", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1746}, end: {_id:1741}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Vitamin K2 is best known as a cofactor in blood coagulation, but in bacteria it is a membrane-bound electron carrier.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"22582012", citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1746}, end: {_id:1741}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that vitamin K2 was necessary and sufficient to transfer electrons in Drosophila mitochondria.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["7227"], annotationMeshanatomy:["Mitochondria"], annotationDisease:["Parkinson's disease"], pmid:"22582012", citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1746}, end: {_id:1749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Heix mutants showed severe mitochondrial defects that were rescued by vitamin K2, and, similar to ubiquinone, vitamin K2 transferred electrons in Drosophila mitochondria, resulting in more efficient adenosine triphosphate (ATP) production.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph", "Vitamin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1746}, end: {_id:1749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, mitochondrial dysfunction was rescued by vitamin K2 that serves as a mitochondrial electron carrier, helping to maintain normal ATP production.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1750}, end: {_id:1751}, properties:{annotationCondition:["Normal Healthy State"], evidence:"eeding heix mutants during development with MK-4 but not with menadione, a synthetic precursor that is prenylated to form vitamin K2, significantly improved their survival rate (Fig. 2, A and B) and other cellular defects (below), whereas ubiquinone (Q-10) feeding did not (Fig. 2A), indicating specificity (10).", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1750}, end: {_id:1757}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, time-dependent oxygen consumption of intact mitochondria prepared from pink1B9 mutants was increased when the flies were first placed on MK-4", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["PINK1 subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1746}, end: {_id:1749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, vitamin K2 is sufficient for electron transport downstream of a eukaryotic ETC complex, resulting in improved mitochondrial oxygen Fig. 4. Vitamin K2 acts as a mitochondrial electron carrier. Immunolabeling of S2 Drosophila cells (A) and Western blot of fractionations (B) transfected with Heix-His and labeled with anti-His and antiâ€“ATP synthase b (A). (C) ATP levels of heix1/Df and heix/Df;da>heix (n = 8). (D) Time-dependent ATP production in mitochondria isolated from heix1/Df mutant larvae (n = 8). (E) Measurements of complex II activity [normalized to citrate synthase activity (CS)] using a dose-response of MK-4 as electron carrier (n = 4). (F) Measurements of complex II activity using ubiquinone (0.13 mM; Q-10, light gray) or MK-4 (0.35 mM, gray) as electron carrier (n = 4). (G) Time- dependent ATP production in mitochondria isolated from pink1B9 mutant flies. Reactions are either not supplemented with MK-4 (black) or supplemented with 0.15 mM (dark gray) or 0.35 mM MK-4 (light gray) (n = 8). (H) Adenosine diphosphateâ€“stimulated complex Iâ€“driven respiration rate (oxygen consumption) in mitochondria isolated from pink1RV controls and pink1B9 mutants placed for 72 hours on MK-4 medium or on control medium. Mitochondria from vitamin K2-fed mutant flies consume oxygen faster. Data are mean normalized to controls in (C) and (H) or mean in (D) to (G). Error bars, SEM. ANOVA/Dunnett: *P < 0.05, **P < 0.01, ***P < 0.001.consumption and energy production, particular- ly in pink1B9 mutants.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["PINK1 subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1746}, end: {_id:1741}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Vitamin K2 did not affect mitochondrial remodeling directly, but, by increasing ETC efficiency, it contributed to the proton motif force that facilitates ATP production, similar to ubiquinone", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1775}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 overproduction promoted mitochondrial elongation and mitigated CCCP-induced mitochondrial degradation independently of enzymatic activity.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1775}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These effects were abolished by overproduction of the fission- promiting dynamin-related protein 1 (Drp1).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fission subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1775}, end: {_id:1810}, properties:{annotationCondition:["Normal Healthy State"], evidence:"CCCP-induced mitochondrial aggregation is dependent on active transport along the microtubule network toward the perinuclear region, facilitating mitochondrial degradation by autophagy.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:748}, end: {_id:1811}, properties:{annotationCondition:["Normal Healthy State"], evidence:"CCCP-induced mitochondrial aggregation is dependent on active transport along the microtubule network toward the perinuclear region, facilitating mitochondrial degradation by autophagy.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitophagy subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1775}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 interacts with Parkin and PINK1 at the TOM machinery and mitigates the Parkin-dependent mitophagy triggered by CCCP.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1934}, end: {_id:1930}, properties:{evidence:"However, to our initial surprise, we observed that glutamate- induced Parkin translocation to mitochondria was instead enhanced by the addition of NAC.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1944}, end: {_id:1923}, properties:{evidence:"These results indicate that very high levels of cytoplasmic calcium are not necessarily toxic to forebrain neurons, and that potential- driven uptake of calcium into mitochondria is required to trigger NMDA-receptor-stimulated neuronal death.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshanatomy:["Cytoplasmic Structures"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:1945}, end: {_id:1425}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We previously measured mitochondrial membrane potential in our cultured neurons using the fluorescent dye JC-1 and showed that FCCP caused a rapid, robust and reversible mitochondrial membrane depolarization.", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshanatomy:["Cytoplasmic Structures"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:1958}, end: {_id:1959}, properties:{evidence:"Our studies suggest that somatic mtDNA deletions are important in the selective neuronal loss observed in brain aging and in Parkinson disease.", citationTitle:"Nat Genet. 2006 May;38(5):515-7. Epub 2006 Apr 9.", annotationMeshdisease:["Parkinson Disease"], pmid:"16604074", citationType:"PubMed", citationRef:"16604074"}}, {start: {_id:1958}, end: {_id:245}, properties:{evidence:"The fraction of mtDNA deletions is significantly higher in cytochrome c oxidase (COX)-deficient neurons than in COX-positive neurons, suggesting that mtDNA deletions may be directly responsible for impaired cellular respiration.", citationTitle:"Nat Genet. 2006 May;38(5):518-20. Epub 2006 Apr 9.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"16604072", citationType:"PubMed", citationRef:"16604072"}}, {start: {_id:267}, end: {_id:1369}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interestingly, inhibition of LPS-induced mitochondrial fission and reactive oxygen species (ROS) generation by Mdivi-1 and Drp1 knock- down attenuated the production of pro-inflammatory mediators via reduced nuclear factor kappa-light-chain-enhancer of activated B cells (NF-kB) and mitogen-activated protein kinase (MAPK) signaling. Our results demonstrated for the first time that mitochondrial fission regulates mitochondrial ROS production in activated microglial cells and influences the expression of pro-inflammatory mediators through the activation of NF-kB and MAPK. We therefore suggest that mitochondrial dynamics may be essential for understanding pro- inflammatory mediator expression in activated microglial cells. This could represent a new therapeutic approach for preventing neurodegenerative diseases.", citationTitle:"J Neurochem. 2013 Oct;127(2):221-32. doi: 10.1111/jnc.12361. Epub 2013 Jul 29.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"23815397", citationType:"PubMed", citationRef:"23815397"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:947}, end: {_id:949}, properties:{evidence:"Loss of dystrophin profoundly affects muscle function and cognition. Changes in the dystrophin-glycoprotein complex (DGC) including disruption of nitric oxide synthase (NOS-1) may result from loss of dystrophin or secondarily after muscle damage.", citationTitle:"Dev Dyn. 2013 Dec;242(12):1369-81. doi: 10.1002/dvdy.24031. Epub 2013 Oct 7.", annotationSubgraph:["Nitric oxide subgraph", "Notch signaling subgraph"], annotationMeshdisease:["Muscular Dystrophies"], pmid:"23940011", citationType:"PubMed", citationRef:"23940011"}}, {start: {_id:1131}, end: {_id:1130}, properties:{evidence:"The loss of parkin function due to PD-linked mutations was found to disrupt the ubiquitination and degradation of FAF1, resulting in elevated FAF1 expression in SH-SY5Y cells.", citationComment:"Accumulation of the parkin substrate, FAF1, plays a key role in the dopaminergic neurodegeneration.", citationTitle:"Human molecular genetics; Vol. 22; Iss. 8", annotationSubgraph:["Ubiquitin subgraph", "Apoptosis signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-04-15", pmid:"23307929", annotationCellline:["SH-SY5Y"], citationAuthorList:"Jee-Won Sul|Min-Young Park|Juhee Shin|Young-Ran Kim|Sung-Eun Yoo|Young-Yun Kong|Ki-Sun Kwon|Young Ho Lee|Eunhee Kim", citationType:"PubMed", citationRef:"23307929"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1710}, end: {_id:1711}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Subcellular fractionation indicates that approximately 10% of the total LRRK2 protein is localized to the mitochondrial outer membrane (Biskup et al, 2006; West et al, 2005), and LRRK2-mediated cell toxicity might involve cytochrome c release and caspase 3 activation", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Mitochondrial subgraph", "LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1768}, end: {_id:24}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Confocal and FoÌˆrster resonance energy transfer (FRET) microscopy revealed that HSD17B10 recruited Parkin to the translocase of the outer membrane (TOM), close to PINK1, both in functional mitochondria and after the collapse of mitochondrial membrane potential (Î”Î¨m).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph", "Mitochondrial subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1808}, end: {_id:1770}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 accumulated on mitochondria in cells overproducing HSD17B10, indicating that mitochondrial import mechanisms were overwhelmed", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Synuclein subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1770}, end: {_id:1808}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our observations suggest that HSD17B10 overproduction overwhelms mitochondrial protein import mechanisms, lead- ing to PINK1 accumulation at the OMM.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Synuclein subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1770}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 recruits Parkin to the mitochondrion in a PINK1-dependent manner, without promoting mitophagy.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:24}, end: {_id:131}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondrial Ca2+ uptake machinery was not modified by parkin overexpression", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:875}, end: {_id:16}, properties:{evidence:"Our findings indicate that the placebo effect in PD is powerful and is mediated through activation of the damaged nigrostriatal dopamine system.", citationTitle:"2001 Aug 10;293(5532):1164-6.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Prefrontal Cortex"], pmid:"11498597", citationType:"PubMed", citationRef:"11498597"}}, {start: {_id:902}, end: {_id:16}, properties:{evidence:"Parkinson disease is also associated with higher zinc concentrations in the brain than normal.", citationTitle:"Rev Med Chir Soc Med Nat Iasi. 2007 Oct-Dec;111(4):981-5.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Central Nervous System"], pmid:"18389791", citationType:"PubMed", citationRef:"18389791"}}, {start: {_id:1049}, end: {_id:16}, properties:{evidence:"Active oxygen has been implicated in the pathogenesis of Parkinson's disease (PD); therefore, antioxidants have attracted attention as a potential way to prevent this disease. Squalene, a natural triterpene and an intermediate in the biosynthesis of cholesterol, is known to have active oxygen scavenging activities. Squalane, synthesized by complete hydrogenation of squalene, does not have active oxygen scavenging activities.", citationTitle:"J Oleo Sci. 2013;62(1):21-8.", annotationMeshdisease:["Parkinson Disease"], pmid:"23357814", citationType:"PubMed", citationRef:"23357814"}}, {start: {_id:471}, end: {_id:1179}, properties:{evidence:"Olfactory dysfunction is related to deposition of pathological proteins, Å’Â±-synuclein, hyperphosphorylated tau protein, and neurofilament protein in these areas, featured by neurofibrillary tangles, Lewy bodies and neurites inducing a complex cascade of molecular processes including oxidative damage, neuroinflammation, and cytosolic disruption of cellular processes leading to cell death. Damage to cholinergic, serotonergic, and noradrenergic systems is likely involved, since such damage is most marked in those diseases with severe anosmia. Recent studies of olfactory dysfunction have focused its potential as an early biomarker for the diagnosis of neurodegenerative disorders and their disease progression.", citationTitle:"Acta Neuropathol. 2014 Apr;127(4):459-75. doi: 10.1007/s00401-014-1261-7. Epub 2014 Feb 20.", annotationSubgraph:["Tau protein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24554308", citationType:"PubMed", citationRef:"24554308"}}, {start: {_id:382}, end: {_id:1179}, properties:{evidence:"Olfactory dysfunction is related to deposition of pathological proteins, Å’Â±-synuclein, hyperphosphorylated tau protein, and neurofilament protein in these areas, featured by neurofibrillary tangles, Lewy bodies and neurites inducing a complex cascade of molecular processes including oxidative damage, neuroinflammation, and cytosolic disruption of cellular processes leading to cell death. Damage to cholinergic, serotonergic, and noradrenergic systems is likely involved, since such damage is most marked in those diseases with severe anosmia. Recent studies of olfactory dysfunction have focused its potential as an early biomarker for the diagnosis of neurodegenerative disorders and their disease progression.", citationTitle:"Acta Neuropathol. 2014 Apr;127(4):459-75. doi: 10.1007/s00401-014-1261-7. Epub 2014 Feb 20.", annotationMeshdisease:["Parkinson Disease"], pmid:"24554308", citationType:"PubMed", citationRef:"24554308"}}, {start: {_id:688}, end: {_id:1179}, properties:{evidence:"Olfactory dysfunction is related to deposition of pathological proteins, Å’Â±-synuclein, hyperphosphorylated tau protein, and neurofilament protein in these areas, featured by neurofibrillary tangles, Lewy bodies and neurites inducing a complex cascade of molecular processes including oxidative damage, neuroinflammation, and cytosolic disruption of cellular processes leading to cell death. Damage to cholinergic, serotonergic, and noradrenergic systems is likely involved, since such damage is most marked in those diseases with severe anosmia. Recent studies of olfactory dysfunction have focused its potential as an early biomarker for the diagnosis of neurodegenerative disorders and their disease progression.", citationTitle:"Acta Neuropathol. 2014 Apr;127(4):459-75. doi: 10.1007/s00401-014-1261-7. Epub 2014 Feb 20.", annotationMeshdisease:["Parkinson Disease"], pmid:"24554308", citationType:"PubMed", citationRef:"24554308"}}, {start: {_id:501}, end: {_id:16}, properties:{evidence:"C677T mutation in the MTHFR enzyme was associated with elevated plasma Hcy level, and elevated plasma Hcy level has been consistently reported in PD patients.Plasma levels of Hcy were increased in PD patients", citationTitle:"Mov Disord. 2009 Jul 30;24(10):1437-44. doi: 10.1002/mds.22522.", annotationSubgraph:["Folate metabolic subgraph", "Vitamin subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"19452554", citationType:"PubMed", citationRef:"19452554"}}, {start: {_id:501}, end: {_id:16}, properties:{evidence:"The levels of sulfate and cysteine in the plasma of controls and patients with Parkinson's disease were not statistically different but the level of homocysteine was higher in patients.", citationTitle:"Neurotoxicology. 1995 Fall;16(3):527-9.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"8584284", citationType:"PubMed", citationRef:"8584284"}}, {start: {_id:501}, end: {_id:16}, properties:{evidence:"Homocysteine levels were significantly higher in patients than in controls", citationTitle:"Neuromolecular Med. 2007;9(3):249-54.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"17914182", citationType:"PubMed", citationRef:"17914182"}}, {start: {_id:501}, end: {_id:16}, properties:{evidence:"High plasma homocysteine levels have been observed in Parkinson's disease (PD) patients treated with levodopa", citationTitle:"Neuromolecular Med. 2007;9(3):249-54.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"17914182", citationType:"PubMed", citationRef:"17914182"}}, {start: {_id:1361}, end: {_id:1362}, properties:{evidence:"In two different models of MPTP-induced PD, dopamine depletion was associated with a reduction in H3K4me3 in striatal histones, whereas chronic levodopa therapy leads to deacetylation of histones H4K5, K8, K12, and K16.", citationTitle:"Funct Integr Genomics. 2011 Dec;11(4):523-37. doi: 10.1007/s10142-011-0246-z. Epub 2011 Sep 4.", annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neostriatum"], pmid:"21892731", citationType:"PubMed", citationRef:"21892731"}}, {start: {_id:1697}, end: {_id:16}, properties:{evidence:"The pathological hallmark of PD is loss of dopaminergic neurons in the substantia nigra and the presence of eosinophilic cytoplasmic inclusions of misfolded proteins termed Lewy bodies in affected brain areas.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:562}, end: {_id:719}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additionally, Î±-synuclein-null mice demonstrate increased resistance to 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP)", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Synuclein subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
