UNWIND [{start: {_id:189}, end: {_id:190}, properties:{evidence:"The SNP list given from Karolinska for PD versus SWEDD", citationTitle:"PD-SNP list from Karolinska", annotationSubgraph:["Neurotrophic subgraph"], citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:191}, end: {_id:192}, properties:{evidence:"The SNP list given from Karolinska for PD versus SWEDD", citationTitle:"PD-SNP list from Karolinska", annotationSubgraph:["Regulation of cytoskeleton subgraph"], citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:193}, end: {_id:194}, properties:{evidence:"The SNP list given from Karolinska for PD versus SWEDD", citationTitle:"PD-SNP list from Karolinska", annotationSubgraph:["Transcription subgraph"], citationType:"Online Resource", citationRef:"123456"}}, {start: {_id:223}, end: {_id:224}, properties:{evidence:"When we considered a three-marker sliding window, we found a highly significant association between the disease and the haplotypes including markers rs17523802, Ins/Del, and rs3766606 (p = 0.0007) and markers Ins/Del, rs3766606 and rs7517357 (p = 0.0054). Our results indicate that polymorphisms located in a region spanning 3535 bp from the promoter to the intron 2 of the DJ-1 gene confer risk to sporadic PD in southern Italy.", citationTitle:"Clin Genet. 2010 Feb;77(2):183-8. doi: 10.1111/j.1399-0004.2009.01310.x. Epub 2009 Nov 23.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19968671", citationType:"PubMed", citationRef:"19968671"}}, {start: {_id:223}, end: {_id:225}, properties:{evidence:"When we considered a three-marker sliding window, we found a highly significant association between the disease and the haplotypes including markers rs17523802, Ins/Del, and rs3766606 (p = 0.0007) and markers Ins/Del, rs3766606 and rs7517357 (p = 0.0054). Our results indicate that polymorphisms located in a region spanning 3535 bp from the promoter to the intron 2 of the DJ-1 gene co