UNWIND [{start: {_id:16}, end: {_id:392}, properties:{evidence:"Mitochondrial respiratory failure induces oxidative damage in neurons, and we found increase in hydroxynonenal and 8-oxo-deoxyguanine, indices of oxidative damage, in the nigral neurons of PD.These abnormalities can trigger apoptotic cell death.", citationTitle:"Rinsho Shinkeigaku. 2004 Apr-May;44(4-5):241-62.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15287506", citationType:"PubMed", citationRef:"15287506"}}, {start: {_id:16}, end: {_id:497}, properties:{evidence:"Dietary folate deficiency and elevated homocysteine have been found to be harmful to dopaminergic neurons in a mouse model of PD [20].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:16}, end: {_id:498}, properties:{evidence:"Moreover, serum folic acid and vitamin B12 have been reported to be decreased in some PD patients.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Serum"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:16}, end: {_id:499}, properties:{evidence:"Moreover, serum folic acid and vitamin B12 have been reported to be decreased in some PD patients.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Serum"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:16}, end: {_id:591}, properties:{evidence:"Analysis of postmortem brain tissue from PD patients shows decreased amount of glutathione (GSH) relative to glutathione disulfide (GSSG) (GSH:GSSG ratio) in the SN compared to controls.", citationTitle:"J Parkinsons Dis. 2013;3(4):461-91. doi: 10.3233/JPD-130230.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"24252804", citationType:"PubMed", citationRef:"24252804"}}, {start: {_id:16}, end: {_id:713}, properties:{evidence:"In Parkinson's disease local dysregulation of iron metabolism in the substantia nigra (SN) seems to be related to neurodegeneration with an increase in SN iron concentration, accompanied by decreased SN Cu and ceruloplasmin concentrations and increased free Cu concentrations and decreased ferroxidase activity in the cerebrospinal fluid.", citationTitle:"J Trace Elem Med Biol. 2014 Jun 2. pii: S0946-672X(14)00073-X. doi: 10.1016/j.jtemb.2014.05.007.", annotationSubgraph:["Transport related subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"24954801", citationType:"PubMed", citationRef:"24954801"}}, {start: {_id:16}, end: {_id:754}, properties:{evidence:"Also, toxic effects of Mn have been extensively studied [38] and [39] and excessive Mn intake leads to a specific condition with motor, cognitive and psychiatric symptoms known as manganism, with many similarities to PD", citationTitle:"J Trace Elem Med Biol. 2014 Jun 2. pii: S0946-672X(14)00073-X. doi: 10.1016/j.jtemb.2014.05.007.", annotationSubgraph:["Transport related subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24954801", citationType:"PubMed", citationRef:"24954801"}}, {start: {_id:16}, end: {_id:773}, properties:{evidence:"Several studies have indicated that stress and/or cortisol, glucocorticoid in humans, are associated with PD.", citationTitle:"BMB Rep. 2013 Sep;46(9):454-9.", annotationMeshdisease:["Parkinson Disease"], pmid:"24064060", citationType:"PubMed", citationRef:"24064060"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1184}, end: {_id:1187}, properties:{evidence:"A premutation (PM) expansion (55-200 CGG) in the fragile X mental retardation gene 1 causes elevated messenger RNA and reduced fragile X mental retardation gene 1 protein.", citationTitle:"Neurobiol Aging. 2014 May;35(5):1189-97.", annotationSubgraph:["FMR1 subgraph"], annotationMeshdisease:["Tremor"], pmid:"24332449", citationType:"PubMed", citationRef:"24332449"}}, {start: {_id:1184}, end: {_id:1187}, properties:{evidence:"Fragile X syndrome is a neurodevelopmental disorder that is caused by large methylated expansions of a CGG repeat (>200) region upstream of the FMR1 gene that results in the lack of expression of the fragile X mental retardation protein (FMRP). Affected individuals display a neurobehavioral phenotype that includes a significant impairment in social cognition alongside deficits in attentional control, inhibition and working memory. In contrast, relatively little is known about the trajectory and specificity of any cognitive impairment associated with the fragile X premutation (carrier-status) (approximately 55-200 repeats). Here, we focus on one aspect of cognition that has been well documented in the fragile X full mutation, namely social cognition. The results suggest that premutation males display a pattern of deficit similar in profile, albeit milder in presentation, to that of the full mutation. However, little evidence emerged for a correlation between CGG repeat length and severity of phenotypic outcomes. The findings are discussed in the context of functional neuroimaging and brain-behaviour-molecular correlates. We speculate that the deficiencies in social cognition are attributable to impairment of neural pathways modulated by the cerebellum.", citationTitle:"Brain Cogn. 2005 Feb;57(1):53-60.", annotationSubgraph:["FMR1 subgraph"], annotationMeshdisease:["Brain Diseases"], pmid:"15629215", citationType:"PubMed", citationRef:"15629215"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:50}, end: {_id:53}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Taken together, microarray analysis of an LMX1A-overexpression cell system resulted in the identification of novel direct or indirect downstream targets of Lmx1a in mdDA neurons: Grb10, Rgs4 and Vmat2. Lmx1a is an activator of Rgs4 and Grb10 and is responsible for the correct specification of rostral and medial mdDA neurons", citationTitle:"Eur J Neurosci. 2013 Jan;37(1):23-32. doi: 10.1111/ejn.12022. Epub 2012 Oct 29.", annotationSubgraph:["Insulin signal transduction", "Dopaminergic subgraph"], pmid:"23106268", citationType:"PubMed", citationRef:"23106268"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:59}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Accumulating evidence indicates that insulin-like growth factor-1 (IGF1) acts as a homeostatic modulator for normal brain functionality and synaptic plasticity, and the loss of IGF1 activity caused by diabetes may contribute to cognitive impairment [6]. Most biological functions of IGF1, including its anti-apoptotic function, are mediated by the insulin-like growth factor-1 receptor (IGF1R).", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:65}, end: {_id:54}, properties:{evidence:"Studies have shown that growth factor receptor-bound protein 10 (Grb10) can interact with tyrosine-phosphorylated growth factor receptors such as IGF1R and insulin receptor (IR) and serve as an endogenous negative regulator of IGF1R signaling.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:67}, end: {_id:54}, properties:{evidence:"Studies have shown that growth factor receptor-bound protein 10 (Grb10) can interact with tyrosine-phosphorylated growth factor receptors such as IGF1R and insulin receptor (IR) and serve as an endogenous negative regulator of IGF1R signaling.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:217}, end: {_id:218}, properties:{evidence:"The substitution of serine for glycine at position 2019 (G2019S) in the kinase domain of LRRK2 represents the most prevalent genetic mutation in both familial and apparently sporadic cases of PD. Because mutations in LRRK2 are likely associated with a toxic gain of function, destabilization of LRRK2 may be a novel way to limit its detrimental effects. Here we show that LRRK2 forms a complex with heat shock protein 90 (Hsp90) in vivo and that inhibition of Hsp90 disrupts the association of Hsp90 with LRRK2 and leads to proteasomal degradation of LRRK2. Hsp90 inhibitors may therefore limit the mutant LRRK2-elicited toxicity to neurons. As a proof of principle, we show that Hsp90 inhibitors rescue the axon growth retardation caused by overexpression of the LRRK2 G2019S mutation in neurons. Therefore, inhibition of LRRK2 kinase activity can be achieved by blocking Hsp90-mediated chaperone activity and Hsp90 inhibitors may serve as potential anti-PD drugs.", citationTitle:"J Neurosci. 2008 Mar 26;28(13):3384-91. doi: 10.1523/JNEUROSCI.0185-08.2008.", annotationSubgraph:["LRRK2 subgraph", "Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18367605", citationType:"PubMed", citationRef:"18367605"}}, {start: {_id:1101}, end: {_id:1102}, properties:{evidence:"LINGO-1 antagonists (LINGO-1-Fc, dominant negative LINGO-1, and anti- LINGO-1 antibody) improved DA neuron survival in response to MPP+ in part by mechanisms that involve activation of the EGFR/Akt signaling pathway through a direct inhibition of LINGO-1's binding to EGFR.", citationTitle:"Proceedings of the National Academy of Sciences of the United States of America; Vol. 104; Iss. 36", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Parkinson Disease"], pmid:"17726113", citationType:"PubMed", citationRef:"17726113"}}, {start: {_id:1139}, end: {_id:1140}, properties:{evidence:"In conclusion, our findings demonstrate that interfering with Nogo-A signaling by antagonizing NgR1 modulates dopaminergic neuron properties during development. These observations highlight novel aspects of the role of Nogo-A in the CNS and might have an impact in the context of Parkinson's disease.", citationComment:"Antagonizing Nogo-receptor 1 promotes the number of cultured dopaminergic neurons and elongates their neurites.", citationTitle:"Neuroreport; Vol. 24; Iss. 18", annotationSubgraph:["Neurotrophic subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-18", pmid:"24201447", citationAuthorList:"Stefanie Seiler|Dario Pollini|Stefano Di Santo|Hans R Widmer", citationType:"PubMed", citationRef:"24201447"}}, {start: {_id:1424}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These data suggest that Bax is the primary substrate responsible for the antiapoptotic effects of parkin", citationTitle:"Proc Natl Acad Sci U S A. 2012 Apr 17;109(16):6283-8. doi: 10.1073/pnas.1113248109. Epub 2012 Mar 29.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["10090"], pmid:"22460798", citationType:"PubMed", citationRef:"22460798"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
