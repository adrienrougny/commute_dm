UNWIND [{start: {_id:500}, end: {_id:504}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hyperhomocysteine induces oxidative stress via NMDA receptor-mediated neuronal nitric oxide synthase activation and formation of radicals, which leads to mitochondrial dysfunction and the release of Cytochrome c and of apoptosis inducing factor (AIF), ultimately causing cell apoptosis [24].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationMeshanatomy:["Serum"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:535}, end: {_id:137}, properties:{evidence:"Current research has suggested that only protoplasmic astrocytes have an increase in the accumulation of alpha-synuclein, and these are of importance for PD development.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["embryonic stem cell"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:411}, end: {_id:564}, properties:{evidence:"Additionally, Kortekaas et al. (2005) has suggested that Parkinson patients have a reduced P-gp (glycoprotein) function in the midbrain, which is associated with a BBB disruption.", citationTitle:"Front Cell Neurosci. 2014 Aug 4;8:211. doi: 10.3389/fncel.2014.00211. eCollection 2014.", annotationMeshdisease:["Parkinson Disease"], annotationCell:["embryonic stem cell"], annotationMeshanatomy:["Mesencephalon"], pmid:"25136294", citationType:"PubMed", citationRef:"25136294"}}, {start: {_id:575}, end: {_id:576}, properties:{annotationCondition:["Normal Healthy State"], evidence:"And HRD1 levels are increased in dopaminergic neurons under conditions of neurotoxicity, suggesting a role in the response to cellular stress (Mei and Niu, 2010).", citationTitle:"Front Mol Neurosci. 2