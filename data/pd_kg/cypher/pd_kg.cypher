UNWIND [{start: {_id:947}, end: {_id:55}, properties:{evidence:"Loss of dystrophin profoundly affects muscle function and cognition. Changes in the dystrophin-glycoprotein complex (DGC) including disruption of nitric oxide synthase (NOS-1) may result from loss of dystrophin or secondarily after muscle damage.", citationTitle:"Dev Dyn. 2013 Dec;242(12):1369-81. doi: 10.1002/dvdy.24031. Epub 2013 Oct 7.", annotationSubgraph:["Notch signaling subgraph"], annotationMeshdisease:["Muscular Dystrophies"], pmid:"23940011", citationType:"PubMed", citationRef:"23940011"}}, {start: {_id:947}, end: {_id:948}, properties:{evidence:"Loss of dystrophin profoundly affects muscle function and cognition. Changes in the dystrophin-glycoprotein complex (DGC) including disruption of nitric oxide synthase (NOS-1) may result from loss of dystrophin or secondarily after muscle damage.", citationTitle:"Dev Dyn. 2013 Dec;242(12):1369-81. doi: 10.1002/dvdy.24031. Epub 2013 Oct 7.", annotationSubgraph:["Notch signaling subgraph"], annotationMeshdisease:["Muscular Dystrophies"], pmid:"23940011", citationType:"PubMed", citationRef:"23940011"}}, {start: {_id:947}, end: {_id:952}, properties:{evidence:"Previous studies demonstrate that loss of dystrophin causes dysfunctional signaling at Å’â‰¥-aminobutyric acid (GABA) synapses on Purkinje neurons, presumably by destabilization of GABAA receptors.", citationTitle:"Neurobiol Learn Mem. 2014 Jan;107:19-31. doi: 10.1016/j.nlm.2013.10.017. Epub 2013 Nov 9.", annotationSubgraph:["Notch signaling subgraph"], annotationMeshdisease:["Muscular Dystrophies"], annotationMeshanatomy:["Purkinje Cells"], pmid:"24220092", citationType:"PubMed", citationRef:"24220092"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:50}, end: {_id:51}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The LIM homeodomain transcription factor Lmx1a is a very potent inducer of stem cells towards dopaminergic neurons", citationTitle:"Eur J Neurosci. 2013 Jan;37(1):23-32. doi: 10.1111/ejn.12022. Epub 2012 Oct 29.", annotationSubgraph:["Dopaminergic subgraph"], pmid:"23106268", citationType:"PubMed", citationRef:"23106268"}}, {start: {_id:115}, end: {_id:127}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interest in how mDA neurons develop has been stimulated by the potential use of stem cells in therapy or disease modeling. However, very little is known about how specific dopaminergic subtypes are generated. Here, we show that the expression profiles of the transcription factors Sox6, Otx2, and Nolz1 define subpopulations of mDA neurons already at the neural progenitor cell stage. After cell- cycle exit, Sox6 selectively localizes to SNc neurons, while Otx2 and Nolz1 are expressed in a subset of VTA neurons. Importantly, Sox6 ablation leads to decreased expression of SNc markers and a corresponding increase in VTA markers, while Otx2 ablation has the opposite effect. Moreover, deletion of Sox6 affects striatal innervation and dopamine levels. We also find reduced Sox6 levels in Parkinson's disease patients. These findings identify Sox6 as a determinant of SNc neuron development and should facilitate the engineering of relevant mDA neurons for cell therapy and disease modeling.", citationTitle:"Cell Rep. 2014 Aug 21;8(4):1018-25. doi: 10.1016/j.celrep.2014.07.016. Epub 2014 Aug 7.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25127144", citationType:"PubMed", citationRef:"25127144"}}, {start: {_id:1246}, end: {_id:267}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"Although protective in detoxification of xenobiotics , CYP2E1 activity has been associated with increased generation of reactive oxygen species(ROS).", citationTitle:"Neurogenetics. 2012 Feb;13(1):87-91. doi: 10.1007/s10048-011-0308-3. Epub 2012 Jan 12.", annotationSubgraph:["Cholesterol metabolism subgraph", "Reactive oxygen species subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], pmid:"22238121", citationType:"PubMed", citationRef:"22238121"}}, {start: {_id:1246}, end: {_id:1247}, properties:{annotationPdstage:["Sporadic_PD"], evidence:"Enhanced CYP2E1 activity further facilitated the formation of potentially toxic metabolites, in particular isoquinolines ,which are structurally related to the selective dopaminergic neurotoxic 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine(MPTP) from Dopamine and acetaldehyde and may thus contribute to dopaminergic neurodegeneration in PD", citationTitle:"Neurogenetics. 2012 Feb;13(1):87-91. doi: 10.1007/s10048-011-0308-3. Epub 2012 Jan 12.", annotationSubgraph:["Cholesterol metabolism subgraph", "Dopaminergic subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], pmid:"22238121", citationType:"PubMed", citationRef:"22238121"}}, {start: {_id:749}, end: {_id:1746}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We believe that this effect of vitamin K2 is the result of improved mitochondrial function and not because of an important role for vitamin K2 in mitochondrial remodeling, because feeding MK-4 to drp11/2 or pink1B9;drp1/+ mutants that are defective in mitochondrial fission did not res- cue their mitochondrial morphological defects", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:436}, end: {_id:77}, properties:{evidence:"At nanomolar concentrations, a-SN protected neurons against serum deprivation, oxidative stress, and excitotoxicity through the PI3/Akt signaling pathway, and its protective effect was increased by Bcl-2 overexpression. Conversely, at both low micromolar and overexpressed levels in the cell, alpha-SN resulted in cytotoxicity. This might be related to decreased Bcl-xL expression and increased bax expression, which is subsequently followed by cytochrome c release and caspase activation and also by microglia-mediated inflammatory responses via the NFkappaB and mitogen-activated protein kinase pathways.", citationTitle:"FASEB J. 2002 Nov;16(13):1826-8. Epub 2002 Sep 5.", annotationSubgraph:["Caspase subgraph", "Bcl-2 subgraph", "Mitochondrial subgraph"], pmid:"12223445", citationType:"PubMed", citationRef:"12223445"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1747}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We tested the consequence of loss of heix on mitochonrial function (10) and found that, compared with controls, heix mutants showed a less negative Ym and lower ATP levels that could be significantly rescued by rearing heix mutants on MK-4 or by reexpression of Heix", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1768}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We report here the identification of a new mitochondrial Parkin substrate, the nucleus-encoded mitochondrial matrix 17-Î² hydroxysteroid dehydrogenase type 10 (HSD17B10), also known as endoplasmic reticulum-associated amyloid- beta-binding protein (ERAB), AÎ²-binding alcohol dehydrogen- ase (ABAD) and 3-hydroxyacyl-CoA dehydrogenase type II (HADH2).24,25 HSD17B10 is a ubiquitous NADH- dependent multifunctional enzyme essential for mitochondrial maintenance and cell viability.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
