MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:2095}, end: {_id:2097}, properties:{evidence:"Overexpression of each factors, Nurr1, Pitx3, and Lmx1a robustly promoted the dopaminergic differentiation of ESC-NP cells exposed to sonic hedgehog (SHH) and fibroblast growth factor 8 (FGF8). In addition, each of these factors directly interacts with potential binding sites within the tyrosine hydroxylase (TH) gene and activated its promoter activity. Interestingly, however, overexpression of Nurr1, but not of Pitx3 or Lmx1a, generated a significant number of nonneuronal TH-positive cells. In line with this, Pitx3 and Lmx1a, but not Nurr1, induced expression of the Ngn2 gene, which is critical for neurogenesis", citationTitle:"Stem Cells Dev. 2014 Mar 1;23(5):477-87. doi: 10.1089/scd.2013.0406. Epub 2013 Dec 4.", annotationSubgraph:["Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"24172139", citationType:"PubMed", citationRef:"24172139"}}, {start: {_id:2098}, end: {_id:2099}, properties:{evidence:"Overexpression of each factors, Nurr1, Pitx3, and Lmx1a robustly promoted the dopaminergic differentiation of ESC-NP cells exposed to sonic hedgehog (SHH) and fibroblast growth factor 8 (FGF8). In addition, each of these factors directly interacts with potential binding sites within the tyrosine hydroxylase (TH) gene and activated its promoter activity. Interestingly, however, overexpression of Nurr1, but not of Pitx3 or Lmx1a, generated a significant number of nonneuronal TH-positive cells. In line with this, Pitx3 and Lmx1a, but not Nurr1, induced expression of the Ngn2 gene, which is critical for neurogenesis", citationTitle:"Stem Cells Dev. 2014 Mar 1;23(5):477-87. doi: 10.1089/scd.2013.0406. Epub 2013 Dec 4.", annotationSubgraph:["Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"24172139", citationType:"PubMed", citationRef:"24172139"}}, {start: {_id:2100}, end: {_id:2099}, properties:{evidence:"Overexpression of each factors, Nurr1, Pitx3, and Lmx1a robustly promoted the dopaminergic differentiation of ESC-NP cells exposed to sonic hedgehog (SHH) and fibroblast growth factor 8 (FGF8). In addition, each of these factors directly interacts with potential binding sites within the tyrosine hydroxylase (TH) gene and activated its promoter activity. Interestingly, however, overexpression of Nurr1, but not of Pitx3 or Lmx1a, generated a significant number of nonneuronal TH-positive cells. In line with this, Pitx3 and Lmx1a, but not Nurr1, induced expression of the Ngn2 gene, which is critical for neurogenesis", citationTitle:"Stem Cells Dev. 2014 Mar 1;23(5):477-87. doi: 10.1089/scd.2013.0406. Epub 2013 Dec 4.", annotationSubgraph:["Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"24172139", citationType:"PubMed", citationRef:"24172139"}}] AS row
