UNWIND [{start: {_id:1710}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"reduced levels of mitochondrial proteins involved in mitochondrial oxidative phosphorylation were reported in parkin-knockout mice, which exhibited normal brain morphology, but increased striatal extracellular dopamine levels", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:7}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"reduced levels of mitochondrial proteins involved in mitochondrial oxidative phosphorylation were reported in parkin-knockout mice, which exhibited normal brain morphology, but increased striatal extracellular dopamine levels", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Synuclein subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:223}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"reduced levels of mitochondrial proteins involved in mitochondrial oxidative phosphorylation were reported in parkin-knockout mice, which exhibited normal brain morphology, but increased striatal extracellular dopamine levels", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Chaperone subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"reduced levels of mitochondrial proteins involved in mitochondrial oxidative phosphorylation were reported in parkin-knockout mice, which exhibited normal brain morphology, but increased striatal extracellular dopamine levels", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:317}, properties:{annotationCondition:["Normal Healthy State"], evidence:"When the protein is defective, ERâ€“mitochondria contact sites are reduced, Ca2+ uptake is impaired and mitochondria undergo massive fragmentation.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:24}, end: {_id:1417}, properties:{evidence:"A systemic loss of Parkin syner- gizes with mitochondrial dysfunction causing dopaminergic neuron death modeling PD pathogenic processes.", citationTitle:"Neuron. 2015 Jul 15;87(2):371-81. doi: 10.1016/j.neuron.2015.06.034.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26182419", citationType:"PubMed", citationRef:"26182419"}}] AS row
