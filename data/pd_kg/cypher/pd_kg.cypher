MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:270}, end: {_id:379}, properties:{evidence:"These results suggest that in the presence of increased oxidative stress, increased alpha-synuclein expression within dopaminergic OB neurons results in neurodegeneration in the glomerular layer (GL) and increased alpha-synuclein levels in the granular cell layer which coincide with olfactory dysfunction.", citationTitle:"Neuroscience. 2011 Jan 13;172:379-86. doi: 10.1016/j.neuroscience.2010.10.072. Epub 2010 Nov 3.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Olfactory Bulb"], annotationCell:["dopaminergic neuron"], pmid:"21055449", citationType:"PubMed", citationRef:"21055449"}}, {start: {_id:270}, end: {_id:1913}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Both mitochondrial and endoplasmic reticulum (ER) stress induce an increase in parkin-specific mRNA and protein levels.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:1913}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Both mitochondrial and endoplasmic reticulum (ER) stress induce an increase in parkin-specific mRNA and protein levels.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Endoplasmic Reticulum"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:886}, end: {_id:2263}, properties:{evidence:"In addition, CAS also increased the mRNA levels of MAOB, an enzyme for dopamine degradation, in the same brain regions.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"23208077", citationType:"PubMed", citationRef:"23208077"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:971}, end: {_id:77}, properties:{annotationBrco:["Spinal motor neuron"], annotationCondition:["Normal Healthy State"], evidence:"The glial cell line-derived neurotrophic factor (GDNF) signalling pathway has been associated with neuroprotective effects in central dopaminergic neurons and spinal motor neurons. Clinical trials have also investigated whether GDNF may ameliorate Parkinson's disease symptoms.", citationTitle:"Psychopharmacology (Berl). 2010 Jun;210(3):347-54. doi: 10.1007/s00213-010-1829-4. Epub 2010 Apr 6.", annotationSpecies:["9606"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20369355", citationType:"PubMed", citationRef:"20369355"}}, {start: {_id:1760}, end: {_id:77}, properties:{evidence:"In the present review, we emphasize the functional overlap between the PINK1â€“Parkin pathway and the endoplasmic reticulum (ER)-mitochondria interface, a subcellular compartment critically involved in neurodegeneration.", citationTitle:"Biochem Soc Trans. 2015 Apr;43(2):297-301. doi: 10.1042/BST20150008.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Neurodegenerative Diseases"], annotationMeshanatomy:["Endoplasmic Reticulum", "Mitochondria"], pmid:"25849933", citationType:"PubMed", citationRef:"25849933"}}, {start: {_id:1646}, end: {_id:267}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Reactive oxygen species (ROS) are essential components of the innate immune response against intracellular bacteria and it is thought that professional phagocytes generate ROS primarily via the phagosomal NADPH oxidase machinery. However, recent studies have suggested that mitochondrial ROS (mROS) also contribute to mouse macrophage bactericidal activity, although the mechanisms linking innate immune signalling to mitochondria for mROS generation remain unclear.", citationTitle:"Nature. 2011 Apr 28;472(7344):476-80. doi:10.1038/nature09973.", annotationSubgraph:["Reactive oxygen species subgraph", "Innate immune system subgraph"], pmid:"21525932", citationType:"PubMed", citationRef:"21525932"}}, {start: {_id:311}, end: {_id:1980}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Excessive mitochondrial fission was observed in lentivirus-transfected BV-2 cells stably expressing DsRed2-mito following LPS stimulation. Furthermore, mitochondrial localization of dynamin-related protein 1 (Drp1) (a key regulator of mitochondrial fission) was increased and accompanied by de-phosphorylation of Ser637 in Drp1.", citationTitle:"J Neurochem. 2013 Oct;127(2):221-32. doi: 10.1111/jnc.12361. Epub 2013 Jul 29.", annotationSubgraph:["Mitophagy subgraph"], pmid:"23815397", citationType:"PubMed", citationRef:"23815397"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:867}, end: {_id:868}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Using mass spectroscopy, we found that Cox7c, a nuclear-encoded subunit of the mitochondrial enzyme cytochrome oxidase, is up- regulated in the striatum of male but not female mice after receiving a single dose of caffeine. The expression of two other Cox subunits, Cox1 and Cox4, was also stimulated by caffeine in a male-specific fashion. Overall, these findings indicate that cytochrome oxidase is a metabolic target of caffeine and that stimulation of Cox activity by caffeine via blockade of A2AR signaling may be an important mechanism underlying the therapeutic benefits of caffeine in PD.", citationTitle:"Mol Pharmacol. 2008 Sep;74(3):673-84. doi: 10.1124/mol.108.046888. Epub 2008 Jun 26.", annotationMeshanatomy:["Corpus Striatum"], pmid:"18583456", citationType:"PubMed", citationRef:"18583456"}}, {start: {_id:867}, end: {_id:869}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Using mass spectroscopy, we found that Cox7c, a nuclear-encoded subunit of the mitochondrial enzyme cytochrome oxidase, is up- regulated in the striatum of male but not female mice after receiving a single dose of caffeine. The expression of two other Cox subunits, Cox1 and Cox4, was also stimulated by caffeine in a male-specific fashion. Overall, these findings indicate that cytochrome oxidase is a metabolic target of caffeine and that stimulation of Cox activity by caffeine via blockade of A2AR signaling may be an important mechanism underlying the therapeutic benefits of caffeine in PD.", citationTitle:"Mol Pharmacol. 2008 Sep;74(3):673-84. doi: 10.1124/mol.108.046888. Epub 2008 Jun 26.", annotationMeshanatomy:["Corpus Striatum"], pmid:"18583456", citationType:"PubMed", citationRef:"18583456"}}, {start: {_id:501}, end: {_id:1287}, properties:{evidence:"C677T mutation in the MTHFR enzyme was associated with elevated plasma Hcy level, and elevated plasma Hcy level has been consistently reported in PD patients.Plasma levels of Hcy were increased in PD patients", citationTitle:"Mov Disord. 2009 Jul 30;24(10):1437-44. doi: 10.1002/mds.22522.", annotationSubgraph:["Folate metabolic subgraph", "Vitamin subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"19452554", citationType:"PubMed", citationRef:"19452554"}}, {start: {_id:1934}, end: {_id:24}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Unexpectedly, we found that glutamate-induced accumulation of Parkin on mitochondria was promoted by the antioxidant N-acetyl cysteine (NAC), and that co-treatment with NAC facilitated Parkin-associated mitophagy.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1934}, end: {_id:24}, properties:{evidence:"Furthermore, the presence of NAC in glutamate- exposed neuron cultures promoted Parkin-mediated mitophagy, which we had not observed with glutamate alone.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:16}, end: {_id:114}, properties:{evidence:"Interest in how mDA neurons develop has been stimulated by the potential use of stem cells in therapy or disease modeling. However, very little is known about how specific dopaminergic subtypes are generated. Here, we show that the expression profiles of the transcription factors Sox6, Otx2, and Nolz1 define subpopulations of mDA neurons already at the neural progenitor cell stage. After cell- cycle exit, Sox6 selectively localizes to SNc neurons, while Otx2 and Nolz1 are expressed in a subset of VTA neurons. Importantly, Sox6 ablation leads to decreased expression of SNc markers and a corresponding increase in VTA markers, while Otx2 ablation has the opposite effect. Moreover, deletion of Sox6 affects striatal innervation and dopamine levels. We also find reduced Sox6 levels in Parkinson's disease patients. These findings identify Sox6 as a determinant of SNc neuron development and should facilitate the engineering of relevant mDA neurons for cell therapy and disease modeling.", citationTitle:"Cell Rep. 2014 Aug 21;8(4):1018-25. doi: 10.1016/j.celrep.2014.07.016. Epub 2014 Aug 7.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25127144", citationType:"PubMed", citationRef:"25127144"}}, {start: {_id:16}, end: {_id:508}, properties:{evidence:"Hypermethylation of MAPT gene leads to reduced expression of this gene, which might help explain why women have a lower risk of developing PD than men.", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Tau protein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:580}, end: {_id:581}, properties:{evidence:"It has been known for a long time that the activity of the mitochondrial respiratory complex I (NADH-quinone oxidoreductase) is reduced in the substantia nigra of PD patients .", citationTitle:"Exp Neurol. 2009 Aug;218(2):235-46. doi: 10.1016/j.expneurol.2009.03.006. Epub 2009 Mar 18.", annotationSubgraph:["Energy metabolic subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"19303005", citationType:"PubMed", citationRef:"19303005"}}, {start: {_id:1026}, end: {_id:1009}, properties:{evidence:"From the known regulatory mechanisms of Arc expression, HFD reduced N-methyl-D-aspartate receptor (NMDAR) activity, as seen by decreases in tyrosine phosphorylation of NMDAR2A and levels of NMDAR1. Additionally, we demonstrated that 27-hydroxycholesterol, a cholesterol metabolite that enters the brain from the blood, decreases Arc levels as well as NMDAR and Src kinase activities in rat primary hippocampal neurons. Finally, we showed that Arc levels are decreased in the cortex of AD brains. We propose that one of the mechanisms, by which hypercholesterolemia contributes to neurodegenerative diseases, could be through Arc down-regulation caused by 27-hydroxycholesterol.", citationTitle:"Brain Pathol. 2009 Jan;19(1):69-80. doi: 10.1111/j.1750-3639.2008.00174.x. Epub 2008 May 23.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationSpecies:["10116"], annotationMeshdisease:["Alzheimer Disease"], annotationMeshanatomy:["Hippocampus"], pmid:"18503570", citationType:"PubMed", citationRef:"18503570"}}, {start: {_id:1179}, end: {_id:638}, properties:{evidence:"Patients with Parkinson's disease were screened for R1441G and G2019S LRRK2 gene mutations and classified as LRRK2 mutation carriers or noncarriers. A total of 190 patients with Parkinson's disease (44 LRRK2 mutation carriers) were tested for olfactory dysfunction using the Brief Smell Identification Test. Cardiac (123) I-metaiodobenzylguanidine scintigraphy was performed on 90 patients with Parkinson's disease (27 LRRK2 mutation carriers). Thirty-six percent of patients with LRRK2 mutations have hyposmia, compared to 75% of noncarrier patients with Parkinson's disease (P < .001). Sixty- six percent of LRRK2 mutation carriers have low early metaiodobenzylguanidine uptake, compared to 86% of noncarriers (P = .048). Similarly, the heart/mediastinum ratio in delayed metaiodobenzylguanidine images appeared to differ between these groups of patients with Parkinson's disease, although these results did not reach statistical significance. The data obtained indicate that olfactory and cardiac impairment is less prevalent when Parkinson's disease is associated with mutations in LRRK2, although the underlying mechanisms for this difference remain unclear.", citationTitle:"Mov Disord. 2011 Sep;26(11):2026-31. doi: 10.1002/mds.23773. Epub 2011 May 24.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21611983", citationType:"PubMed", citationRef:"21611983"}}, {start: {_id:1179}, end: {_id:196}, properties:{evidence:"Patients with Parkinson's disease were screened for R1441G and G2019S LRRK2 gene mutations and classified as LRRK2 mutation carriers or noncarriers. A total of 190 patients with Parkinson's disease (44 LRRK2 mutation carriers) were tested for olfactory dysfunction using the Brief Smell Identification Test. Cardiac (123) I-metaiodobenzylguanidine scintigraphy was performed on 90 patients with Parkinson's disease (27 LRRK2 mutation carriers). Thirty-six percent of patients with LRRK2 mutations have hyposmia, compared to 75% of noncarrier patients with Parkinson's disease (P < .001). Sixty- six percent of LRRK2 mutation carriers have low early metaiodobenzylguanidine uptake, compared to 86% of noncarriers (P = .048). Similarly, the heart/mediastinum ratio in delayed metaiodobenzylguanidine images appeared to differ between these groups of patients with Parkinson's disease, although these results did not reach statistical significance. The data obtained indicate that olfactory and cardiac impairment is less prevalent when Parkinson's disease is associated with mutations in LRRK2, although the underlying mechanisms for this difference remain unclear.", citationTitle:"Mov Disord. 2011 Sep;26(11):2026-31. doi: 10.1002/mds.23773. Epub 2011 May 24.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21611983", citationType:"PubMed", citationRef:"21611983"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:76}, end: {_id:75}, properties:{evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central NervousSystem (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:73}, end: {_id:61}, properties:{evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central NervousSystem (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:76}, end: {_id:61}, properties:{evidence:"However, the N-terminally truncated Grb10 (BPS-SH2) shows no effect on receptor phosphorylation or glucose uptake, implying that the N-terminal domains of Grb10 is essential to its regulatory effect on IR signaling [12]. Recent studies via yeast two-hybrid screening have demonstrated that the N-terminus of Grb10 interacts with GYF proteins (GIGYF1 and GIGYF2), which are two novel and homologous proline motif binding proteins. The GIGYF1 protein can be recruited to the activated insulin and IGF1 receptors through binding to the N-terminus of Grb10. Subsequent studies using GIGYF2 null mice models showed that GIGYF2 gene disruption in mice led to inhibition of IGF1-stimulated IGF1R tyrosine phosphorylation and consequently, the manifestation of neurodegeneration [14]. Those findings suggest that Grb10 and GIGYF2 may act cooperatively to regulate IGF1R signaling. In addition, a high level of GIGYF2 expression is presented in the pancreas and testis as well as brain (including the hippocampus) of adult mouse, thus supporting a vital role of GIGYF2 in the regulation of IGF1R signaling in the central NervousSystem (CNS) [15]. Most recently, several lines of evidence have shown that GIGYF2 gene mutations are closely linked to human familial Parkinson's disease, one of the most common neurodegenerative disorders, thus further supporting the notion that GIGYF2 may play a critical role in neuronal degradation in CNS.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph", "Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:76}, end: {_id:72}, properties:{evidence:"Primary cultured embryo fibroblasts from Gigyf2 null mice exhibit decreased IGF-I-stimulated IGF-I receptor tyrosine phosphorylation and augmented ERK1/2 phosphorylation. These data provide further evidence for an important role of GIGYF2 in age-related neurodegeneration and IGF pathway signaling.", citationTitle:"Hum Mol Genet. 2009 Dec 1;18(23):4629-39. doi: 10.1093/hmg/ddp430. Epub 2009 Sep 10.", annotationSubgraph:["GRB10 subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19744960", citationType:"PubMed", citationRef:"19744960"}}, {start: {_id:117}, end: {_id:118}, properties:{evidence:"We found that the E3 ligase Trip12, a HECT domain E3 ubiquitin ligase, recognizes and polyubiquitinates Sox6. Inhibiting Trip12 or the 26S proteasome activity resulted in an increase in Sox6 protein levels in C2C12 myotubes. This control of Sox6 activity in muscle cells via Trip12 ubiquitination has significant phenotypic outcomes.", citationTitle:"Skelet Muscle. 2013 May 10;3(1):11. doi: 10.1186/2044-5040-3-11.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Muscular Atrophy"], pmid:"23663701", citationType:"PubMed", citationRef:"23663701"}}, {start: {_id:119}, end: {_id:120}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We show that Wwp2-associated Gsc is a transcriptional activator of the key cartilage regulatory protein Sox6. Wwp2 interacts with Gsc to facilitate its mono-ubiquitylation, a post-translational modification required for optimal transcriptional activation of Gsc.", citationTitle:"Nat Cell Biol. 2011 Jan;13(1):59-65. doi: 10.1038/ncb2134. Epub 2010 Dec 19.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21170031", citationType:"PubMed", citationRef:"21170031"}}, {start: {_id:130}, end: {_id:136}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Calcium channel voltage-dependent beta-2 subunit (CACNB2) (904) allows calcium influx, participating on the activation of NADPH oxidase, adhesion, degranulation and synthesis of IL-8", citationTitle:"Protein Pept Lett. 2012 Jun 1;19(6):663-72.", annotationSubgraph:["Interleukin signaling subgraph", "Calcium-dependent signal transduction"], pmid:"22519539", citationType:"PubMed", citationRef:"22519539"}}, {start: {_id:137}, end: {_id:138}, properties:{evidence:"The mDA neurons from both twins had 50% GBA enzymatic activity, ‚àº3-fold elevated Œ±-synuclein protein levels, and a reduced capacity to synthesize and release dopamine. Interestingly, the affected twin's neurons showed an even lower dopamine level, increased monoamine oxidase B (MAO-B) expression, and impaired intrinsic network activity.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1173-82. doi: 10.1016/j.celrep.2014.10.023. Epub 2014 Nov 6.", annotationSubgraph:["Synuclein subgraph", "Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456120", citationType:"PubMed", citationRef:"25456120"}}, {start: {_id:196}, end: {_id:219}, properties:{evidence:"These findings suggest that LRRK2(G2019S)-induced neurodegeneration in Parkinsonian brains may be partly mediated by increased phosphorylation of tubulin-beta and constraining of microtubule dynamics.", citationTitle:"J Neurochem. 2009 Sep;110(5):1514-22. doi: 10.1111/j.1471-4159.2009.06235.x. Epub 2009 Jun 22.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19545277", citationType:"PubMed", citationRef:"19545277"}}, {start: {_id:203}, end: {_id:137}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Aggregation of alpha-synuclein may play a primary role in the pathogenesis of sporadic PD .In this regard, Hsu and colleagues were the first to show that accumulation of alpha-synuclein could lead to mitochondrial changes that exacerbate oxidative stress and neurodegeneration: overexpression of alpha-synuclein in hypothalamic neuronal cells resulted in formation of alpha-synuclein-immunopositive inclusion-like structures and mitochondrial changes accompanied by increased levels of free radicals, all of which were ameliorated by pretreatment with antioxidants such as Vitamin E.Evidence has accumulated to suggest that LRRK2 plays a crucial role in the pathology of both familial and sporadic alpha-synuclein -synucleinopathies.Both alpha-synuclein and LRRK2 (PARK8) are involved in various pathologies such as impairment of cytoskeleton dynamics and dysregulation of the protein degradation system [19].", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["LRRK2 subgraph", "Synuclein subgraph"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:137}, end: {_id:325}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, the gracile axonal dystrophy (gad) mouse, which has a naturally deleted ubiquitin carboxy-terminal hydrolase-1 (UCH-L1), is characterized by formation of spheroid bodies in nerve terminals, which are negative for alpha-synuclein but positive for beta-synuclein or gamma-synuclein .", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Ubiquitin subgraph", "Synuclein subgraph"], annotationMeshanatomy:["Axons"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:444}, end: {_id:441}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Further characterization showed that alpha-syn-pS129 was increased upon knockdown of the PP2A catalytic subunit and when PP2A enzyme is methylated.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Synuclein subgraph", "Cell cycle subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:439}, end: {_id:459}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These findings suggest the hypothesis that PP2A, rather than PP1, is the phosphatase system regulating R1441G LRRK2 at S1292.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["LRRK2 subgraph", "Cell cycle subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:461}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["GSK3 subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:462}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Cell cycle subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:463}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Notch signaling subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:464}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Wnt signaling subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:465}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:466}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Apoptosis signaling subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}, {start: {_id:467}, end: {_id:424}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Several kinases have been reported to phosphorylate tau. These include proline directed kinases [glycogen synthase kinase 3 (GSK3), cyclin dependent kinase 5 (CDK5), and 5- adenosine monophosphate-activated protein kinase (AMPK)], non-proline directed kinases [casein kinase 1 (CK1), microtubule affinity regulating kinases (MARKs), death associated protein kinase 1 (DAPK1), cyclic AMP-dependent protein kinase A (PKA) and dual specificity tyrosine-phosphorylation regulated kinase 1A (DYRK-1A)] as well tyrosine kinases including Fyn, Abl, and Syk.", citationTitle:"Front Genet. 2014 Nov 7;5:382. doi: 10.3389/fgene.2014.00382. eCollection 2014", annotationSubgraph:["Cell cycle subgraph", "Tau protein subgraph"], pmid:"25426138", citationType:"PubMed", citationRef:"25426138"}}] AS row
