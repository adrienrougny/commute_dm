UNWIND [{start: {_id:62}, end: {_id:1423}, properties:{evidence:"The direct ubiquitination of purified Bax was also observed in vitro following incubation with recombinant parkin. We found that parkin prevented basal and apoptotic stress-induced translocation of Bax to the mitochondria.", citationTitle:"Proc Natl Acad Sci U S A. 2012 Apr 17;109(16):6283-8. doi: 10.1073/pnas.1113248109. Epub 2012 Mar 29.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"22460798", citationType:"PubMed", citationRef:"22460798"}}, {start: {_id:62}, end: {_id:1439}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Upon induction of apoptosis, Drp1 translocates from the cytosol to mitochondria, where it preferentially localizes to potential sites of organelle division.", citationTitle:"Dev Cell. 2001 Oct;1(4):515-25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"11703942", citationType:"PubMed", citationRef:"11703942"}}, {start: {_id:1930}, end: {_id:1932}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that brief, acute exposure to glutamate causes Parkin translocation to mitochon- dria in neurons, in a calcium- and N-methyl-D-aspartate (NMDA) receptor-dependent manner.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1930}, end: {_id:1932}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Glutamate excitotoxicity triggers translocation of Parkin to ER", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1930}, end: {_id:1938}, properties:{evidence:"To our knowledge, this is the first evidence of glutamate excitotoxicity triggering Parkin translocation to ER in neurons.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1930}, end: {_id:1938}, properties:{evidence:"However, to our initial surprise, we observed that glutamate- induced Parkin translocation to mitochondria was instead enhanced by the addition of NAC.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1939}, end: {_id:1932}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin translocation to mito- chondria has been observed in neurons under certain conditions of mitochondrial stress or depolarization", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1076}, end: {_id:1070}, properties:{evidence:"Our data are consistent with a model suggesting that, at a given cellular location, Mtmr2 phosphatase activity is highly regulated, being high in the Mtmr2/Sbf2 complex, moderate if Mtmr2 is not associated with Sbf2 or functionally blocked by competition through Sbf2 for membrane-binding sites.", citationComment:"Multi-level regulation of myotubularin-related protein-2 phosphatase activity by myotubularin-related protein-13/set-binding factor-2.", citationTitle:"Human molecular genetics; Vol. 15; Iss. 4", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], annotationMeshdisease:["Charcot-Marie-Tooth Disease"], citationPubDate:"2006-02-15", pmid:"16399794", citationAuthorList:"Philipp Berger|Imre Berger|Christiane Schaffitzel|Kristian Tersar|Benjamin Volkmer|Ueli Suter", citationType:"PubMed", citationRef:"16399794"}}, {start: {_id:1392}, end: {_id:1397}, properties:{evidence:"Recent evidence indicates that L-DOPA-induced dyskinesia (LID) is associated with persistent activation of the mammalian target of rapamycin complex 1 (mTORC1) in the medium spiny neurons (MSNs) of the striatum, the main component of the basal ganglia.", citationTitle:"Cell Cycle. 2010 Jul 15;9(14):2713-8. Epub 2010 Jul 27.", annotationSpecies:["9606"], annotationMeshdisease:["Dyskinesia, Drug-Induced"], annotationMeshanatomy:["Neostriatum"], annotationCell:["medium spiny neuron"], pmid:"20581466", citationType:"PubMed", citationRef:"20581466"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1249}, end: {_id:1232}, properties:{annotationPdstage:["Sporadic_PD"], annotationGender:["Female"], evidence:"When PD patients with or without L-DOPA medication were compared with respect to methylation differences at every single CpG position,male PD patients consistantly showed methylation ,while female patients displayed a decrease.", citationTitle:"Manuscript Draft: provided by Dr. Ullrich", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["blood cell"], pmid:"123", annotationTranscriptionallyActiveRegion:["intron 1"], citationType:"PubMed", citationRef:"123"}}, {start: {_id:1750}, end: {_id:1747}, properties:{annotationCondition:["Normal Healthy State"], evidence:"eeding heix mutants during development with MK-4 but not with menadione, a synthetic precursor that is prenylated to form vitamin K2, significantly improved their survival rate (Fig. 2, A and B) and other cellular defects (below), whereas ubiquinone (Q-10) feeding did not (Fig. 2A), indicating specificity (10).", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}] AS row
