UNWIND [{start: {_id:2118}, end: {_id:2126}, properties:{evidence:"Moreover, TREM2 stimulation of immature dendritic cells strongly induced expression of CCR7, a chemokine receptor binding the ligands CCL19 and CCL21.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2136}, properties:{evidence:"Stimulation of TREM2 of microglia induced phosphorylation of ERK as demonstrated by a specific antibody recognizing the phosphorylated form of ERK (XREF_FIG C).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2136}, properties:{evidence:"TREM2 stimulation induced DAP12 phosphorylation, extracellular signal regulated kinase phosphorylation, and cytoskeleton reorganization and increased phagocytosis.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2139}, properties:{evidence:"TREM2 stimulation induced DAP12 phosphorylation, extracellular signal regulated kinase phosphorylation, and cytoskeleton reorganization and increased phagocytosis.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2126}, properties:{evidence:"These results demonstrate that TREM2 stimulation does not stimulate antigen presentation but up-regulates expression of the chemokine receptor CCR7 and supports chemotaxis towards the corresponding ligands CCL19 and CCL21.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2136}, pr