UNWIND [{start: {_id:238}, end: {_id:583}, properties:{evidence:"Fibroblasts and immortalized lymphoblasts from PD patients with G309D and W437X PINK1 mutations displayed lower respiratory activity, increased glycolysis and elevated levels of lipid peroxidation.", citationTitle:"Exp Neurol. 2009 Aug;218(2):235-46. doi: 10.1016/j.expneurol.2009.03.006. Epub 2009 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19303005", citationType:"PubMed", citationRef:"19303005"}}, {start: {_id:249}, end: {_id:583}, properties:{evidence:"Fibroblasts and immortalized lymphoblasts from PD patients with G309D and W437X PINK1 mutations displayed lower respiratory activity, increased glycolysis and elevated levels of lipid peroxidation.", citationTitle:"Exp Neurol. 2009 Aug;218(2):235-46. doi: 10.1016/j.expneurol.2009.03.006. Epub 2009 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19303005", citationType:"PubMed", citationRef:"19303005"}}, {start: {_id:238}, end: {_id:584}, properties:{evidence:"Fibroblasts and immortalized lymphoblasts from PD patients with G309D and W437X PINK1 mutations displayed lower respiratory activity, increased glycolysis and elevated levels of lipid peroxidation.", citationTitle:"Exp Neurol. 2009 Aug;218(2):235-46. doi: 10.1016/j.expneurol.2009.03.006. Epub 2009 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19303005", citationType:"PubMed", citationRef:"19303005"}}, {start: {_id:249}, end: {_id:584}, properties:{evidence:"Fibroblasts and immortalized lymphoblasts from PD patients with G309D and W437X PINK1 mutations displayed lower respiratory activity, increased glycolysis and elevated levels of lipid peroxidation.", citationTitle:"Exp Neurol. 2009 Aug;218(2):235-46. doi: 10.1016/j.expneurol.2009.03.006. Epub 2009 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19303005", citationType:"PubMed", citationRef:"19303005"}}, {start: {_id:641}, end: {_id:657}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Reduction of Auxilin and its homologue GAK was shown to result in the impairment of CME and of the clathrin-dependent traffic of cargo from the Golgi to the lysosome [14].", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:659}, end: {_id:657}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Reduction of Auxilin and its homologue GAK was shown to result in the impairment of CME and of the clathrin-dependent traffic of cargo from the Golgi to the lysosome [14].", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:137}, end: {_id:657}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Alpha-synuclein (MIM 163890), which is associated with autosomal dominant PARK1, also has a role in clathrin-mediated endocytosis and is specifically involved in synaptic vesicle recycling [19].", citationTitle:"Parkinsonism & related disorders; Vol. 19; Iss. 3", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23211418", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"23211418"}}, {start: {_id:137}, end: {_id:732}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Alpha-synuclein (MIM 163890), which is associated with autosomal dominant PARK1, also has a role in clathrin-mediated endocytosis and is specifically involved in synaptic vesicle recycling [19].", citationTitle:"Parkinsonism & related disorders; Vol. 19; Iss. 3", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23211418", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"23211418"}}, {start: {_id:665}, end: {_id:270}, properties:{evidence:"The fruit fly Drosophila melanogaster, expressing human alpha- synuclein protein or its mutant, A30P, captures several hallmarks of PD and has been successfully used to model PD in numerous studies. First, we report olfactory deficits in fly expressing A30P (A30P), showing deficits in two out of three olfactory modalities, tested-- olfactory acuity and odor discrimination. The remaining third modality is odor identification/naming. Second, oxidative stress is an important environmental risk factor of PD. We show that oxidative stress exacerbated the two affected olfactory modalities in younger A30P flies. Third, different olfactory receptor neurons are activated differentially by different odors in flies.", citationTitle:"PLoS One. 2014 May 30;9(5):e97758. doi: 10.1371/journal.pone.0097758. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"24879013", citationType:"PubMed", citationRef:"24879013"}}, {start: {_id:1279}, end: {_id:62}, properties:{evidence:"Hyperacetylation of Histones Promotes Dieldrin-Induced Caspase-3 Activation and PKCâˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â¥ Proteolytic Activation in Dopaminergic Cells. Inhibition of Hyperacetylation Protects Dopaminergic Cells from Dieldrin-Induced Apoptosis and Neurotoxicity.", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:1280}, end: {_id:62}, properties:{evidence:"Hyperacetylation of Histones Promotes Dieldrin-Induced Caspase-3 Activation and PKCâˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â¥ Proteolytic Activation in Dopaminergic Cells. Inhibition of Hyperacetylation Protects Dopaminergic Cells from Dieldrin-Induced Apoptosis and Neurotoxicity.", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:603}, end: {_id:270}, properties:{evidence:"alpha-Syn overexpression and particularly its PD causing A53T mutant increases the susceptibility of cells to oxidative stress, which is a consistent abnormality in the PD brain", citationTitle:"Proc Natl Acad Sci U S A. 2009 Aug 4;106(31):13052-7. doi: 10.1073/pnas.0906277106. Epub 2009 Jul 23.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"19628698", citationType:"PubMed", citationRef:"19628698"}}, {start: {_id:634}, end: {_id:582}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pink1 deficient mice reveal impaired dopamine release (Kitada et al, 2007), deficient mitochondrial respiration and increased sensitivity to oxidative stress (Gautier et al, 2008), while overexpression and loss of function studies suggest an anti-apoptotic activity for PINK1 (Deng et al, 2005; Lin & Kang, 2008; Petit et al, 2005).", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:634}, end: {_id:1717}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Evidence that pink1 genetically interacts with the fission/fusion machinery of mitochondria has supported the hypothesis that Pink1 deficiency affects various mitochondrial functions via interference with mitochondrial dynamics", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:634}, end: {_id:323}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Evidence that pink1 genetically interacts with the fission/fusion machinery of mitochondria has supported the hypothesis that Pink1 deficiency affects various mitochondrial functions via interference with mitochondrial dynamics", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1718}, end: {_id:1744}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss of Drp1 leads to depletion of synaptic mitochondria and decreased local mitochondrial ATP production that is used by the myosin ATPase to mediate RP mobilization", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:271}, end: {_id:1779}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Genetic studies in Drosophila have shown Parkin and the mitochondrial serine/threonine kinase PINK1 to be components of a molecular pathway maintaining mitochondrial physiology", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["7227"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1781}, end: {_id:1779}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Genetic studies in Drosophila have shown Parkin and the mitochondrial serine/threonine kinase PINK1 to be components of a molecular pathway maintaining mitochondrial physiology", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["7227"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1783}, end: {_id:1779}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Genetic studies in Drosophila have shown Parkin and the mitochondrial serine/threonine kinase PINK1 to be components of a molecular pathway maintaining mitochondrial physiology", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["7227"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:271}, end: {_id:1926}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results indicate that parkin overexpression in model cells physically and func- tionally enhanced ERâ€“mitochondria coupling, favored Ca2+ transfer from the ER to the m itochondria following cells stimulation with an 1,4,5 inositol trisphosphate (InsP3) generating agonist and increased the agonist-induced ATP production.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}] AS row
