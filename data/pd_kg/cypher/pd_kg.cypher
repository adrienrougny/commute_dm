onTitle:"Mov Disord. 2009 Apr 15;24(5):662-6. doi: 10.1002/mds.22365.", annotationSubgraph:["Disaccharide metabolism subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19205068", citationType:"PubMed", citationRef:"19205068"}}, {start: {_id:756}, end: {_id:808}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Point mutations in the HtrA2 are a susceptibility factor for Parkinson's disease.", citationTitle:"Oxid Med Cell Longev. 2013;2013:601587. doi: 10.1155/2013/601587. Epub 2013 Feb 27.", annotationSubgraph:["MAPK subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23533695", citationType:"PubMed", citationRef:"23533695"}}, {start: {_id:756}, end: {_id:814}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Most pathogenic Mfn2 mutations cause loss of mitochondrial fusion activity, which could be complemented by wild-type Mfn1 but not Mfn2 (56)", citationTitle:"J Neuropathol Exp Neurol. 2009 Sep;68(9):953-63. doi: 10.1097/NEN.0b013e3181b2048c.", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondrial subgraph"], pmid:"19680148", citationType:"PubMed", citationRef:"19680148"}}, {start: {_id:756}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in the parkin, DJ-1 and PINK1 genes are associated with autosomal recessive early-onset familial forms of Parkinson's disease (PD).", citationTitle:"Hum Mol Genet. 2006 Jun 1;15(11):1816-25. Epub 2006 Apr 21.", annotationSubgraph:["Chaperone subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16632486", citationType:"PubMed", citationRef:"16632486"}}, {start: {_id:756}, end: {_id:220}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in the parkin, DJ-1 and PINK1 genes are associated with autosomal recessive early-onset familial forms of Parkinson's disease (PD).", citationTitle:"Hum Mol Genet. 2006 Jun 1;15(11):1816-25. Epub 2006 Apr 21.", annotationSubgraph:["Chaperone subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16632486", citationType:"PubMed", citationRef:"16632486"}}, {start: {_id:756}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in the parkin, DJ-1 and PINK1 genes are associated with autosomal recessive early-onset familial forms of Parkinson's disease (PD).", citationTitle:"Hum Mol Genet. 2006 Jun 1;15(11):1816-25. Epub 2006 Apr 21.", annotationSubgraph:["Chaperone subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16632486", citationType:"PubMed", citationRef:"16632486"}}, {start: {_id:756}, end: {_id:386}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in synphilin-1, Œ±-synuclein and LRRK2 are associated with familial form PD (3,37).", citationTitle:"Hum Mol Genet. 2006 Jun 1;15(11):1816-25. Epub 2006 Apr 21.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16632486", citationType:"PubMed", citationRef:"16632486"}}, {start: {_id:844}, end: {_id:220}, properties:{evidence:"The present study showed that DJ-1 was present in human CSF (Fig. 1) and that the CSF DJ-1 levels were significantly increased in PD patients compared to non-PD controls (Figs. 1 and 2).", citationTitle:"Biochem Biophys Res Commun. 2006 Jul 7;345(3):967-72. Epub 2006 May 11.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16707095", citationType:"PubMed", citationRef:"16707095"}}, {start: {_id:270}, end: {_id:1103}, properties:{evidence:"In addition, PD-related insults including, mitochondrial complex I inhibition, oxidative stress, and increased alpha-synuclein expression specifically increased endogenous FAF1 expression in vitro.", citationComment:"Fas-associated factor 1 and Parkinson's disease.", citationTitle:"Neurobiology of disease; Vol. 31; Iss. 3", annotationSubgraph:["Apoptosis signaling subgraph", "Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2008-09-01", pmid:"18573343", citationAuthorList:"Ranjita Betarbet|Leah R Anderson|Marla Gearing|Tiffany R Hodges|Jason J Fritz|James J Lah|Allan I Levey", citationType:"PubMed", citationRef:"18573343"}}, {start: {_id:1425}, end: {_id:271}, properties:{evidence:"Mitochondrial depolarization promotes Parkin- and PTEN-induced kinase 1 (PINK1)-dependent polyubiquitination of multiple proteins on mitochondrial outer membranes, resulting in the removal of defective mitochondria via mitophagy.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1538-53. doi: 10.1016/j.celrep.2014.10.046. Epub 2014 Nov 13.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456142", citationType:"PubMed", citationRef:"25456142"}}, {start: {_id:1425}, end: {_id:221}, properties:{evidence:"Mitochondrial depolarization promotes Parkin- and PTEN-induced kinase 1 (PINK1)-dependent polyubiquitination of multiple proteins on mitochondrial outer membranes, resulting in the removal of defective mitochondria via mitophagy.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1538-53. doi: 10.1016/j.celrep.2014.10.046. Epub 2014 Nov 13.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456142", citationType:"PubMed", citationRef:"25456142"}}, {start: {_id:1625}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we report that PINK1 regulates the E3 ubiquitin-protein ligase function of parkin through direct phosphorylation. We find that phosphorylation of parkin by PINK1 activates parkin E3 ligase function for catalyzing K63-linked polyubiquitination and enhances parkin- mediated ubiquitin signaling through the IkappaB kinase/nuclear factor kappaB (NF-kappaB) pathway. Furthermore, the ability of PINK1 to promote parkin phosphorylation and activate parkin-mediated ubiquitin signaling is impaired by PD-linked pathogenic PINK1 mutations. Our findings support a direct link between PINK1-mediated phosphorylation and parkin-mediated ubiquitin signaling and implicate the deregulation of the PINK1/parkin/NF-kappaB neuroprotective signaling pathway in the pathogenesis of PD.", citationTitle:"Hum Mol Genet. 2010 Jan 15;19(2):352-63. doi: 10.1093/hmg/ddp501. Epub 2009 Oct 30.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"19880420", citationType:"PubMed", citationRef:"19880420"}}, {start: {_id:1643}, end: {_id:1555}, properties:{evidence:"In human cells, posttranslational degradation of the core TIM23 subunit Tim23 contributes to caspase independent cell death following chronic stress (Goemans et al., 2008) and the expression of the mammalian TIM23 subunit Tim17A is induced by the mitochondrial Unfolded protein response subgraph (UPRmt) (Aldridge et al., 2007). Furthermore, activation of the UPRmt-associated transcription factor ATFS-1 in C. elegans requires stress-induced reduction in TIM23-dependent ATFS-1 import (Nargund et al., 2012).", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Transport related subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1643}, end: {_id:1593}, properties:{evidence:"In human cells, posttranslational degradation of the core TIM23 subunit Tim23 contributes to caspase independent cell death following chronic stress (Goemans et al., 2008) and the expression of the mammalian TIM23 subunit Tim17A is induced by the mitochondrial Unfolded protein response subgraph (UPRmt) (Aldridge et al., 2007). Furthermore, activation of the UPRmt-associated transcription factor ATFS-1 in C. elegans requires stress-induced reduction in TIM23-dependent ATFS-1 import (Nargund et al., 2012).", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Transport related subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1643}, end: {_id:1579}, properties:{evidence:"The Unfolded protein response subgraph (UPR) triggered by accumulation of misfolded proteins in the mitochondria (UPRmt) has been reported recently. So far, the UPRmt has been reported to involve the activation of CHOP and estrogen receptor alpha (ERÎ±).", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Unfolded protein response subgraph", "Apoptosis signaling subgraph"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1643}, end: {_id:1034}, properties:{evidence:"The Unfolded protein response subgraph (UPR) triggered by accumulation of misfolded proteins in the mitochondria (UPRmt) has been reported recently. So far, the UPRmt has been reported to involve the activation of CHOP and estrogen receptor alpha (ERÎ±).", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Estrogen subgraph"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:772}, end: {_id:1655}, properties:{evidence:"While this observation on its own does not prove the dual role of SirT3, it is nevertheless consistent with the possibility that in areas of the tumor experiencing local mitochondrial stress, SirT3 is upregulated.", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshdisease:["Neoplasms"], annotationMeshanatomy:["Mitochondria"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1699}, end: {_id:221}, properties:{evidence:"Regardless, our work provides additional support to the hypothesis that the dysfunction of Complex I is an important and early event in the pathogenesis of Pink1-associated PD", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1425}, end: {_id:221}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These studies showed that loss of mitochondrial membrane potential (depolarization) leads to accumulation of PINK1 on the mitochondrial outer membrane, which triggers recruitment of Parkin to the mitochondria.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1760}, end: {_id:1759}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Together, our findings indicate that the PINK1â€“Parkin pathway promotes mitochondrial autophagy in vivo and also mediates selective turnover of mitochondrial RC proteins.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1774}, end: {_id:1405}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The mitochondrion-protecting function of HSD17B10 requires mitochondrial elongation and not the enzymatic activity of the protein.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:270}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Both mitochondrial and endoplasmic reticulum (ER) stress induce an increase in parkin-specific mRNA and protein levels.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Both mitochondrial and endoplasmic reticulum (ER) stress induce an increase in parkin-specific mRNA and protein levels.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Endoplasmic Reticulum"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1915}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We also present evidence that mitochondrial damage can induce ER stress, leading to the activation of the UPR, and thereby to an upregulation of parkin expression.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin gene expression is upregulated in response to ER stress.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin mRNA levels are increased under ER stress induced by thapsigargin or tunicamycin.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"c-Jun suppresses the upregulation of parkin after ER stress.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1915}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In this study, we show that parkin is transcriptionally upregulated by mitochondrial and ER stress via the UPR to promote viability under cellular stress.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"An essential role for ATF4 in the regulation of parkin expression was substantiated by the following observations: First, a dominant- negative ATF4 mutant prevented ER stress-induced upregulation of parkin.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "Unfolded protein response subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The increased expression of parkin in response to ER stress clearly serves as a cytoprotective function.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1930}, end: {_id:271}, properties:{evidence:"Our imaging and biochemical analyses demonstrated that glutamate excitotoxicity triggered Parkin accumulation both on ER and between ER and mitochondria.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1951}, end: {_id:1952}, properties:{evidence:"Glutamate-receptor stimulation causes phosphorylation and activation of mitogen-activated protein kinases (MAPKs) in neurons in a calcium- dependent manner 26, and activation of a member of the MAPK family may mediate glutamate toxicity", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Cytoplasmic Structures"], pmid:"10196525", citationType:"PubMed", citationRef:"10196525"}}, {start: {_id:1951}, end: {_id:1039}, properties:{evidence:"Glutamate-receptor stimulation causes phosphorylation and activation of mitogen-activated protein kinases (MAPKs) in neurons in a calcium- dependent manner 26, and activation of a member of the MAPK family may mediate glutamate toxicity", citationTitle:"Nat Neurosci. 1998 Sep;1(5):366-73.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Cytopla