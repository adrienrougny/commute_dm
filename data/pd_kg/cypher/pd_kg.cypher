UNWIND [{start: {_id:33}, end: {_id:34}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The E3 ubiquitin ligase Rad18 chaperones DNA polymerase Œ∑ (PolŒ∑) to sites of UV-induced DNA damage and monoubiquitinates proliferating cell nuclear antigen (PCNA), facilitating engagement of PolŒ∑ with stalled replication forks and promoting translesion synthesis (TLS)", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph", "Cell cycle subgraph"], pmid:"22456510", citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:107}, end: {_id:103}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Examination of a panel of individual or clustered lysine mutants demonstrated that lysine 613 (K613) in the cytoplasmic tail of Dll1 is a key residue necessary for transcellular activation of Notch signaling. Multi-ubiquitination of the Dll1 mutant Dll1-K613R was altered compared to wild type Dll1, and the K613R mutation blocked the ability of Dll1 to interact with Notch1", citationTitle:"Biochim Biophys Acta. 2011 Dec;1813(12):2036-43. doi: 10.1016/j.bbamcr.2011.08.019. Epub 2011 Oct 2.", annotationSubgraph:["Notch signaling subgraph"], pmid:"21985982", citationType:"PubMed", citationRef:"21985982"}}, {start: {_id:318}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 is rapidly degraded in healthy mitochondria but accumulates in membrane potential deficient mitochondria, where it recruits Parkin to ubiquitinate the damaged mitochondria, which leads to fission and processing for degradation in the lysosome; this mechanism is referred to as mitophagy.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], annotationMeshanatomy:["Mitochondria", "Lysosomes"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:322}, end: {_id:323}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, it has been shown that LRRK2 regulates mitochondrial dynamics by increasing mitochondrial DLP1 ( dynamin-like kinase 1) through a direct interaction with DLP1.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Ubiquitin subgraph", "LRRK2 subgraph"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:557}, end: {_id:551}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK 1 kinase 1 interplays with Beclin1. A mutation in this gene provokes damaged interaction, thus resulting in ineffective or insufficient autophagic activity.", citationTitle:"Neural Regen Res. 2013 Aug 25;8(24):2275-83. doi: 10.3969/j.issn.1673-5374.2013.24.007.", annotationSubgraph:["PINK1 subgraph", "Autophagy signaling subgraph"], annotationMeshanatomy:["Neurons"], pmid:"25206537", citationType:"PubMed", citationRef:"25206537"}}, {start: {_id:654}, end: {_id:589}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three functional domains are instrumental for Auxilin's co-chaperone activity: an N-terminal PTEN-like domain (residues 40-421), which is important for recruitment of Auxilin onto CCVs, a middle domain which binds clathrin, and a carboxyl-terminal J-domain (residues 886-931) which binds Hsc70 [10], [11].", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:655}, end: {_id:589}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three functional domains are instrumental for Auxilin's co-chaperone activity: an N-terminal PTEN-like domain (residues 40-421), which is important for recruitment of Auxilin onto CCVs, a middle domain which binds clathrin, and a carboxyl-terminal J-domain (residues 886-931) which binds Hsc70 [10], [11].", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:655}, end: {_id:642}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Auxilin is the co-chaperone that recruits HSC70 to the clathrin coated vesicles (CCVs) for disassembly [11], [12], [13], [14], [15], [16] and [17].", citationTitle:"Parkinsonism & related disorders; Vol. 19; Iss. 3", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23211418", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"23211418"}}, {start: {_id:811}, end: {_id:243}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pink1 genetically interacts with mitochondrial morphogenesis machinery, such as Drp1, Opa1, mitofusin (Mfn), lending further support for a role of Pink1 in regulating mitochondrial morphogenesis.", citationTitle:"J Neuropathol Exp Neurol. 2009 Sep;68(9):953-63. doi: 10.1097/NEN.0b013e3181b2048c.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], pmid:"19680148", citationType:"PubMed", citationRef:"19680148"}}, {start: {_id:812}, end: {_id:243}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pink1 genetically interacts with mitochondrial morphogenesis machinery, such as Drp1, Opa1, mitofusin (Mfn), lending further support for a role of Pink1 in regulating mitochondrial morphogenesis.", citationTitle:"J Neuropathol Exp Neurol. 2009 Sep;68(9):953-63. doi: 10.1097/NEN.0b013e3181b2048c.", annotationSubgraph:["Mitochondria fusion subgraph", "PINK1 subgraph"], pmid:"19680148", citationType:"PubMed", citationRef:"19680148"}}, {start: {_id:813}, end: {_id:243}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Pink1 genetically interacts with mitochondrial morphogenesis machinery, such as Drp1, Opa1, mitofusin (Mfn), lending further support for a role of Pink1 in regulating mitochondrial morphogenesis.", citationTitle:"J Neuropathol Exp Neurol. 2009 Sep;68(9):953-63. doi: 10.1097/NEN.0b013e3181b2048c.", annotationSubgraph:["Mitochondria fusion subgraph", "PINK1 subgraph"], pmid:"19680148", citationType:"PubMed", citationRef:"19680148"}}, {start: {_id:33}, end: {_id:34}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The E3 ubiquitin ligase Rad18 chaperones DNA polymerase âˆšÃ©Â¬âˆ‘ (PolâˆšÃ©Â¬âˆ‘) to sites of UV-induced DNA damage and monoubiquitinates proliferating cell nuclear antigen (PCNA), facilitating engagement of PolâˆšÃ©Â¬âˆ‘ with stalled replication forks and promoting translesion synthesis (TLS)", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["DNA synthesis"], pmid:"22456510", annotationCellline:["NCI-H1299", "HCT116"], citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:1084}, end: {_id:941}, properties:{evidence:"We propose that by ubiquitinating Eps15, parkin interferes with the ability of the Eps15 UIMs to bind ubiquitinated EGFR, thereby delaying EGFR internalization and degradation, and promoting PI(3)K-Akt signalling.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:1146}, end: {_id:270}, properties:{evidence:"Elevated Hcy levels can lead to prooxidative activity, most probably through direct interaction with N-methyl-D-aspartate (NMDA) receptors and sensitization of dopaminergic neurons to age-related dysfunction and death.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:1386}, end: {_id:1387}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PDE4D binds Rheb in a noncatalytic manner that does not require its cAMP-hydrolyzing activity and thereby inhibits the ability of Rheb to activate mTORC1. However, elevated cAMP levels disrupt the interaction of PDE4D with Rheb and increase the interaction between Rheb and mTOR. This enhanced Rheb-mTOR interaction induces the activation of mTORC1 and cap-dependent translation, a cellular function of mTORC1. Taken together, our results suggest a novel regulatory mechanism for mTORC1 in which the cAMP-determined dynamic interaction between Rheb and PDE4D provides a key, unique regulatory event. We also propose a new role for PDE4 as a molecular transducer for cAMP signaling.", citationTitle:"Mol Cell Biol. 2010 Nov;30(22):5406-20. doi: 10.1128/MCB.00217-10. Epub 2010 Sep 13.", annotationSubgraph:["Cell cycle subgraph"], annotationSpecies:["9606"], pmid:"20837708", citationType:"PubMed", citationRef:"20837708"}}, {start: {_id:1385}, end: {_id:1387}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PDE4D binds Rheb in a noncatalytic manner that does not require its cAMP-hydrolyzing activity and thereby inhibits the ability of Rheb to activate mTORC1. However, elevated cAMP levels disrupt the interaction of PDE4D with Rheb and increase the interaction between Rheb and mTOR. This enhanced Rheb-mTOR interaction induces the activation of mTORC1 and cap-dependent translation, a cellular function of mTORC1. Taken together, our results suggest a novel regulatory mechanism for mTORC1 in which the cAMP-determined dynamic interaction between Rheb and PDE4D provides a key, unique regulatory event. We also propose a new role for PDE4 as a molecular transducer for cAMP signaling.", citationTitle:"Mol Cell Biol. 2010 Nov;30(22):5406-20. doi: 10.1128/MCB.00217-10. Epub 2010 Sep 13.", annotationSubgraph:["Cyclic AMP subgraph", "Cell cycle subgraph"], pmid:"20837708", citationType:"PubMed", citationRef:"20837708"}}, {start: {_id:1432}, end: {_id:1396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Bcl-2 family proteins regulate mitochondrial outer membrane permeabilization during apoptosis and can also influence macroautophagy via interactions with Beclin-1.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Bcl-2 subgraph", "Autophagy signaling subgraph"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}, {start: {_id:1702}, end: {_id:1703}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Complex I transfers electrons from NADH to ubiquinone while pumping protons across the inner mitochondrial membrane contributing to the electrochemical proton gradient used by F1F0 ATP synthase (Complex V) to produce ATP from ADP and inorganic phosphate.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1831}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Central to mitochondrial function is oxidative phosphorylation (OXPHOS), accomplished by respiratory chain complexes (RCCs) encoded by nuclear and mitochondrial genomes.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1833}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Central to mitochondrial function is oxidative phosphorylation (OXPHOS), accomplished by respiratory chain complexes (RCCs) encoded by nuclear and mitochondrial genomes.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1835}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Central to mitochondrial function is oxidative phosphorylation (OXPHOS), accomplished by respiratory chain complexes (RCCs) encoded by nuclear and mitochondrial genomes.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1836}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Central to mitochondrial function is oxidative phosphorylation (OXPHOS), accomplished by respiratory chain complexes (RCCs) encoded by nuclear and mitochondrial genomes.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1877}, end: {_id:1709}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Apoptosis-inducing factor (AIF) is a mitochondrial flavoprotein that, beyond its apoptotic function, is required for the normal expression of major respiratory chain complexes.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1890}, end: {_id:589}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Human CHCHD4 is a soluble 16-kDa protein that localizes to the mitochondrial IMS (Hofmann et al., 2005), where it participates in mitochondrial import and catalyzes oxidative protein folding in cooperation with the sulfhydryl oxidase GFER/ALR/Erv1p", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1906}, end: {_id:1882}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Irre- spective of these incognita, it appears plausible that AIF may drag the CHCHD4 N terminus into the mitochondrial IMS, thereby facilitating its import.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1996}, end: {_id:1440}, properties:{evidence:"Here we demonstrate that engagement of a subset of Toll-like receptors (TLR1, TLR2 and TLR4) results in the recruitment of mitochondria to macrophage phagosomes and augments mROS production. This response involves translocation of a TLR signalling adaptor, tumour necrosis factor receptor-associated factor 6 (TRAF6), to mitochondria, where it engages the protein ECSIT (evolutionarily conserved signalling intermediate in Toll pathways), which is implicated in mitochondrial respiratory chain assembly.", citationTitle:"Nature. 2011 Apr 28;472(7344):476-80. doi:10.1038/nature09973.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationCell:["macrophage"], pmid:"21525932", citationType:"PubMed", citationRef:"21525932"}}, {start: {_id:2061}, end: {_id:2062}, properties:{evidence:"Cell transfection requires cationic DNA complexes and heparan sulfate proteoglycans (HSPGs) at the cell surface. As efï¬�cient transfection also requires the condensed DNA particles to bear a cationic surface [4], it was inferred that anionic proteoglycans were potential receptors [2].", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", annotationMeshanatomy:["Cell Membrane"], pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2072}, end: {_id:2073}, properties:{evidence:"The primary cellular function of the syndecan family (four members) is to act as adhesion molecules; they bind extracellular matrix proteins and contribute to coordinating the cellular processes of migration, adhesion and cytoskeleton organization. They have been shown to be involved in focal adhesion and stress ï¬�ber formation together with members of the integrin family", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2072}, end: {_id:2074}, properties:{evidence:"The primary cellular function of the syndecan family (four members) is to act as adhesion molecules; they bind extracellular matrix proteins and contribute to coordinating the cellular processes of migration, adhesion and cytoskeleton organization. They have been shown to be involved in focal adhesion and stress ï¬�ber formation together with members of the integrin family", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2072}, end: {_id:2075}, properties:{evidence:"The primary cellular function of the syndecan family (four members) is to act as adhesion molecules; they bind extracellular matrix proteins and contribute to coordinating the cellular processes of migration, adhesion and cytoskeleton organization. They have been shown to be involved in focal adhesion and stress ï¬�ber formation together with members of the integrin family", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2077}, end: {_id:2078}, properties:{evidence:"The primary cellular function of the syndecan family (four members) is to act as adhesion molecules; they bind extracellular matrix proteins and contribute to coordinating the cellular processes of migration, adhesion and cytoskeleton organization. They have been shown to be involved in focal adhesion and stress ï¬�ber formation together with members of the integrin family", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2077}, end: {_id:2079}, properties:{evidence:"The primary cellular function of the syndecan family (four members) is to act as adhesion molecules; they bind extracellular matrix proteins and contribute to coordinating the cellular processes of migration, adhesion and cytoskeleton organization. They have been shown to be involved in focal adhesion and stress ï¬�ber formation together with members of the integrin family", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2077}, end: {_id:2080}, properties:{evidence:"The primary cellular function of the syndecan family (four members) is to act as adhesion molecules; they bind extracellular matrix proteins and contribute to coordinating the cellular processes of migration, adhesion and cytoskeleton organization. They have been shown to be involved in focal adhesion and stress ï¬�ber formation together with members of the integrin family", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2082}, end: {_id:2083}, properties:{evidence:"Protein kinase C is also recruited into the large multiprotein complex forming at the adhesion point where it regulates the associations. Previous studies have underlined the involvement of PKC in HSPG- dependent phagocytosis in HeLa cells", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2085}, end: {_id:2062}, properties:{evidence:"In the present study, we examined the possibility that the cellular receptors of PEI/DNA complexes might also be subjected to PKC regulation. To test if PKC might have a role in internalization of PEI/DNA complexes, we treated HeLa cells with staurosporine and tested the effects of this PKC inhibitor on transfection efï¬�ciency using a luciferase assay. As shown in Figure 1, staurosporine inhibited transfection in a concentration-dependent manner. The effects were observed at concentrations similar to those used to interfere with bacterial invasion [17] and uptake of HSPG-ligating beads [15] into HeLa cells.", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2090}, end: {_id:2062}, properties:{evidence:"Liposomes labeled with AG73 showed high efï¬�cient transfection superior molecule in the development of non-viral vector using liposomes for the gene delivery to syndecan-2 overexpressing cancer cells.", citationTitle:"Bioorg Med Chem Lett. 2010 Aug 1;20(15):4712-4", pmid:"20615691", citationType:"PubMed", citationRef:"20615691"}}, {start: {_id:2090}, end: {_id:2091}, properties:{evidence:"Liposomes labeled with AG73 showed high efï¬�cient transfection superior molecule in the development of non-viral vector using liposomes for the gene delivery to syndecan-2 overexpressing cancer cells.", citationTitle:"Bioorg Med Chem Lett. 2010 Aug 1;20(15):4712-4", pmid:"20615691", annotationCellline:["cancer cell line"], citationType:"PubMed", citationRef:"20615691"}}, {start: {_id:2106}, end: {_id:1140}, properties:{evidence:"Transduction of Nurr1 alone or in combination with other transcription factors such as Foxa2, Ngn2, Ascl1, and Pitx3, induces the generation of DA neurons, which upon transplantation have the capacity to survive and restore motor behavior in animal models of PD.", citationTitle:"Neurotox Res. 2016 Jul;30(1):14-31", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], pmid:"26678495", citationType:"PubMed", citationRef:"26678495"}}, {start: {_id:2106}, end: {_id:578}, properties:{evidence:"Transduction of Nurr1 alone or in combination with other transcription factors such as Foxa2, Ngn2, Ascl1, and Pitx3, induces the generation of DA neurons, which upon transplantation have the capacity to survive and restore motor behavior in animal models of PD.", citationTitle:"Neurotox Res. 2016 Jul;30(1):14-31", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], pmid:"26678495", citationType:"PubMed", citationRef:"26678495"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1318}, end: {_id:506}, properties:{evidence:"Overexpression of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±-syn Results in Cytoplasmic Retention of Dnmt1. We observed an inverse trend between oligomerization of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±-syn and reduction of nuclear Dnmt1, suggesting that subcellular localization of Dnmt1 might be altered by âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±-syn accumulation and/or aggregation.", citationTitle:"J Biol Chem. 2011 Mar 18;286(11):9031-7. doi: 10.1074/jbc.C110.212589. Epub 2011 Feb 4", annotationSubgraph:["Synuclein subgraph", "Transcription subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21296890", citationType:"PubMed", citationRef:"21296890"}}, {start: {_id:317}, end: {_id:634}, properties:{evidence:"Recent work has strongly drawn the attention to the mitochondrial fragmentation and other morphological abnormalities associated with PINK1 deficiency", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:311}, end: {_id:634}, properties:{evidence:"Furthermore, notwithstanding the many attempts to place Pink1 in the core machinery regulating mitochondrial fusion, a direct link between levels of Pink1 and rate of mitochondrial fusion has not been demonstrated. Since mitochondrial dysfunction, irrespective of the underlying mechanism, is accompanied by fragmentation of the organelle (Dimmer et al, 2008; Rojo et al, 2002), it is likely that the excess mitochondrial fission caused by ablation of Pink1 under certain experimental conditions is an epiphenomenon of the primary mitochondrial dysfunction sustained by reduced Complex I activity (Fig 7).", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph", "Mitochondria fission subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1924}, end: {_id:271}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our finding that the JNK pathway can negatively regulate parkin gene expression suggests a reciprocal interaction between parkin and JNK3, which might be instrumental in the dichotomy of cell survival and death.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:NEGATIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:16}, end: {_id:756}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Point mutations in the HtrA2 are a susceptibility factor for Parkinson's disease.", citationTitle:"Oxid Med Cell Longev. 2013;2013:601587. doi: 10.1155/2013/601587. Epub 2013 Feb 27.", annotationSubgraph:["MAPK subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23533695", citationType:"PubMed", citationRef:"23533695"}}, {start: {_id:831}, end: {_id:756}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in the parkin, DJ-1 and PINK1 genes are associated with autosomal recessive early-onset familial forms of Parkinson's disease (PD).", citationTitle:"Hum Mol Genet. 2006 Jun 1;15(11):1816-25. Epub 2006 Apr 21.", annotationSubgraph:["Chaperone subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16632486", citationType:"PubMed", citationRef:"16632486"}}, {start: {_id:16}, end: {_id:515}, properties:{evidence:"The pathological hallmark of PD is loss of dopaminergic neurons in the substantia nigra and the presence of eosinophilic cytoplasmic inclusions of misfolded proteins termed Lewy bodies in affected brain areas.", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:719}, end: {_id:1758}, properties:{evidence:"The accumulation of damaged mitochondria has been proposed as a key factor in aging and the pathogenesis of many common agerelated diseases, including Parkinson disease (PD).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:16}, end: {_id:515}, properties:{evidence:"Parkinson's disease (PD) is the most common neurodegenerative movement disorder. It is caused by progressive loss of the dopaminergic neurons of the substantia nigra pars compacta.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:56}, end: {_id:54}, properties:{evidence:"Several lines of evidence have demonstrated the important role of insulin-like growth factor-1 receptor (IGF1R) signaling pathway in the neuropathogenic process of cognitive impairment, while decreased Grb10-Interacting GYF Protein 2 (GIGYF2) expression can alter IGF1R trafficking and its downstream signaling pathways.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["Insulin signal transduction"], annotationMeshdisease:["Parkinson Disease"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:47}, end: {_id:55}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Growth factor receptor-bound protein 10 (Grb10), a suppressor of IGF1R pathway, has been shown to play a critical role in regulating diabetes-associated cognitive impairment.", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["GRB10 subgraph"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:96}, end: {_id:55}, properties:{evidence:"Rare copy number abnormalities of A2BP1 have been previously associated with cognitive impairment, attention deficit disorder and autism [Martin et al. (2007);", citationTitle:"Am J Med Genet A. 2012 Jul;158A(7):1654-61. doi: 10.1002/ajmg.a.35396. Epub 2012 Jun 7.", annotationSubgraph:["Post-translational events"], pmid:"22678932", citationType:"PubMed", citationRef:"22678932"}}, {start: {_id:102}, end: {_id:103}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Examination of a panel of individual or clustered lysine mutants demonstrated that lysine 613 (K613) in the cytoplasmic tail of Dll1 is a key residue necessary for transcellular activation of Notch signaling. Multi-ubiquitination of the Dll1 mutant Dll1-K613R was altered compared to wild type Dll1, and the K613R mutation blocked the ability of Dll1 to interact with Notch1", citationTitle:"Biochim Biophys Acta. 2011 Dec;1813(12):2036-43. doi: 10.1016/j.bbamcr.2011.08.019. Epub 2011 Oct 2.", annotationSubgraph:["Notch signaling subgraph"], pmid:"21985982", citationType:"PubMed", citationRef:"21985982"}}, {start: {_id:110}, end: {_id:112}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These results suggest that the interaction of DLL-1 on mouse joint macrophages with Notch-2 on mouse FLS enhances the production of IL-6 and MMP-3. Therefore, suppression of IL-6, GM-CSF, and MMP-3 production by DLL-1 blockade might be responsible for the amelioration of arthritis in a mouse model of RA.", citationTitle:"Arthritis Rheumatol. 2014 Oct;66(10):2751-61. doi: 10.1002/art.38743.", annotationSubgraph:["Interleukin signaling subgraph"], pmid:"24943093", citationType:"PubMed", citationRef:"24943093"}}, {start: {_id:111}, end: {_id:112}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These results suggest that the interaction of DLL-1 on mouse joint macrophages with Notch-2 on mouse FLS enhances the production of IL-6 and MMP-3. Therefore, suppression of IL-6, GM-CSF, and MMP-3 production by DLL-1 blockade might be responsible for the amelioration of arthritis in a mouse model of RA.", citationTitle:"Arthritis Rheumatol. 2014 Oct;66(10):2751-61. doi: 10.1002/art.38743.", annotationSubgraph:["Matrix metalloproteinase subgraph"], pmid:"24943093", citationType:"PubMed", citationRef:"24943093"}}, {start: {_id:221}, end: {_id:310}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, there is strong evidence to support an important role for PINK1 and Parkin in regulating mitochondrial homeostasis.", citationTitle:"PLoS Genet. 2010 Dec 2;6(12):e1001229. doi: 10.1371/journal.pgen.1001229. ", annotationSubgraph:["PINK1 subgraph"], pmid:"21151955", citationType:"PubMed", citationRef:"21151955"}}, {start: {_id:271}, end: {_id:310}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, there is strong evidence to support an important role for PINK1 and Parkin in regulating mitochondrial homeostasis.", citationTitle:"PLoS Genet. 2010 Dec 2;6(12):e1001229. doi: 10.1371/journal.pgen.1001229. ", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21151955", citationType:"PubMed", citationRef:"21151955"}}, {start: {_id:315}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Evolutionarily-conserved GTPases Mfn and OPA1 promote the mitochondrial fusion event while another GTPase Drp1 regulates the mitochondrial fission.", citationTitle:"PLoS Genet. 2010 Dec 2;6(12):e1001229. doi: 10.1371/journal.pgen.1001229. ", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Mitochondria fission subgraph"], pmid:"21151955", citationType:"PubMed", citationRef:"21151955"}}, {start: {_id:755}, end: {_id:756}, properties:{evidence:"Several single-nucleotide polymorphisms (SNPs) in the catechol-O- methyltransferase (COMT) gene have been associated with the risk of developing Parkinson's disease (PD).", citationTitle:"Pharmacogenet Genomics. 2014 Jul;24(7):331-9. doi: 10.1097/FPC.0000000000000056.", annotationSubgraph:["Dopaminergic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24819480", citationType:"PubMed", citationRef:"24819480"}}, {start: {_id:934}, end: {_id:939}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we investigate the role of Hepatocyte growth factor-Regulated tyrosine kinase Substrate (Hrs), a regulator of RTK trafficking, in VEGF and insulin signaling. We report that ectopic expression of Hrs increases VEGF-R2 and IR number and tyrosine phosphorylation, leading to amplification of their downstream signaling. The UIM (Ubiquitin Interacting Motif) domain of Hrs is required for Hrs-induced increases in VEGF-R2, but not in IR. Furthermore, Hrs is tyrosine-phosphorylated in response to VEGF and insulin. We show that the UIM domain is required for Hrs phosphorylation in response to VEGF, but not to insulin. Importantly, Hrs co-localizes with both VEGF-R2 and IR and co-immunoprecipitates with both in a manner independent of the Hrs-UIM domain. Finally, we demonstrate that Hrs inhibits Nedd4-mediated VEGF-R2 degradation and acts additively with Grb10. We conclude that Hrs is a positive regulator of VEGF-R2 and IR signaling and that ectopic expression of Hrs protects both VEGF-R2 and IR from degradation.", citationTitle:"Exp Cell Res. 2007 May 15;313(9):1927-42. Epub 2007 Mar 21.", annotationSubgraph:["Cytokine signaling subgraph", "Vascular endothelial growth factor subgraph"], pmid:"17445799", citationType:"PubMed", citationRef:"17445799"}}, {start: {_id:47}, end: {_id:941}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We find mouse Grb10 to be a critical component of the insulin receptor (IR) signaling complex that provides a functional link between IR and p85 phosphatidylinositol (PI) 3-kinase and regulates PI 3-kinase activity.", citationTitle:"J Biol Chem. 2003 Oct 10;278(41):39311-22. Epub 2003 Jun 3.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "GRB10 subgraph"], pmid:"12783867", citationType:"PubMed", citationRef:"12783867"}}, {start: {_id:1050}, end: {_id:1051}, properties:{evidence:"These data imply an involvement of pregnane steroids and changes in GABAergic neurotransmission in the neurodegenerative process and suggest that neurosteroids may deserve further investigation as potential therapeutic agents in PD", citationTitle:"Brain Pathol. 2010 Sep;20(5):945-51. doi: 10.1111/j.1750-3639.2010.00396.x. Epub 2010 Mar 19.", annotationSubgraph:["GABA subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"20406233", citationType:"PubMed", citationRef:"20406233"}}, {start: {_id:1055}, end: {_id:1058}, properties:{evidence:"By enhancing their GTPase activity, GAP proteins inactivate small Rho and Ras proteins, so inactivation of rhoGAP proteins might cause constitutive activation of their GTPase targets.", citationTitle:"Nature. 1998 Apr 30;392(6679):923-6.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationMeshdisease:["Mental Retardation, X-Linked"], annotationMeshanatomy:["Axons", "Dendrites"], pmid:"9582072", citationType:"PubMed", citationRef:"9582072"}}, {start: {_id:574}, end: {_id:1082}, properties:{evidence:"Furthermore, EGFR endocytosis and degradation are accelerated in parkin-deficient cells, and EGFR signalling via the phosphoinositide 3-kinase (PI(3)K)-Akt pathway is reduced in parkin knockout mouse brain.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Ubiquitin subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:1182}, end: {_id:57}, properties:{evidence:"The fragile X mental retardation protein (FMRP) is an RNA-binding protein that controls translational efficiency and regulates synaptic plasticity. Here, we report that FMRP is involved in dopamine (DA) modulation of synaptic potentiation. AMPA glutamate receptor subtype 1 (GluR1) surface expression and phosphorylation in response to D1 receptor stimulation were reduced in cultured Fmr1(-/-) prefrontal cortex (PFC) neurons. Furthermore, D1 receptor signaling was impaired, accompanied by D1 receptor hyperphosphorylation at serine sites and subcellular redistribution of G protein-coupled receptor kinase 2 (GRK2) in both PFC and striatum of Fmr1(-/-) mice. FMRP interacted with GRK2, and pharmacological inhibition of GRK2 rescued D1 receptor signaling in Fmr1(-/-) neurons. Finally, D1 receptor agonist partially rescued hyperactivity and enhanced the motor function of Fmr1(-/-) mice. Our study has identified FMRP as a key messenger for DA modulation in the forebrain and may provide insights into the cellular and molecular mechanisms underlying fragile X syndrome.", citationTitle:"Neuron. 2008 Aug 28;59(4):634-47.", annotationSubgraph:["FMR1 subgraph"], annotationMeshdisease:["Fragile X Syndrome"], pmid:"18760699", citationType:"PubMed", citationRef:"18760699"}}, {start: {_id:1182}, end: {_id:590}, properties:{evidence:"The fragile X mental retardation protein (FMRP) is an RNA-binding protein that controls translational efficiency and regulates synaptic plasticity. Here, we report that FMRP is involved in dopamine (DA) modulation of synaptic potentiation. AMPA glutamate receptor subtype 1 (GluR1) surface expression and phosphorylation in response to D1 receptor stimulation were reduced in cultured Fmr1(-/-) prefrontal cortex (PFC) neurons. Furthermore, D1 receptor signaling was impaired, accompanied by D1 receptor hyperphosphorylation at serine sites and subcellular redistribution of G protein-coupled receptor kinase 2 (GRK2) in both PFC and striatum of Fmr1(-/-) mice. FMRP interacted with GRK2, and pharmacological inhibition of GRK2 rescued D1 receptor signaling in Fmr1(-/-) neurons. Finally, D1 receptor agonist partially rescued hyperactivity and enhanced the motor function of Fmr1(-/-) mice. Our study has identified FMRP as a key messenger for DA modulation in the forebrain and may provide insights into the cellular and molecular mechanisms underlying fragile X syndrome.", citationTitle:"Neuron. 2008 Aug 28;59(4):634-47.", annotationSubgraph:["FMR1 subgraph"], annotationMeshdisease:["Fragile X Syndrome"], pmid:"18760699", citationType:"PubMed", citationRef:"18760699"}}, {start: {_id:1182}, end: {_id:1191}, properties:{evidence:"The fragile X mental retardation protein (FMRP) is an RNA-binding protein that controls translational efficiency and regulates synaptic plasticity. Here, we report that FMRP is involved in dopamine (DA) modulation of synaptic potentiation. AMPA glutamate receptor subtype 1 (GluR1) surface expression and phosphorylation in response to D1 receptor stimulation were reduced in cultured Fmr1(-/-) prefrontal cortex (PFC) neurons. Furthermore, D1 receptor signaling was impaired, accompanied by D1 receptor hyperphosphorylation at serine sites and subcellular redistribution of G protein-coupled receptor kinase 2 (GRK2) in both PFC and striatum of Fmr1(-/-) mice. FMRP interacted with GRK2, and pharmacological inhibition of GRK2 rescued D1 receptor signaling in Fmr1(-/-) neurons. Finally, D1 receptor agonist partially rescued hyperactivity and enhanced the motor function of Fmr1(-/-) mice. Our study has identified FMRP as a key messenger for DA modulation in the forebrain and may provide insights into the cellular and molecular mechanisms underlying fragile X syndrome.", citationTitle:"Neuron. 2008 Aug 28;59(4):634-47.", annotationSubgraph:["FMR1 subgraph"], annotationMeshdisease:["Fragile X Syndrome"], pmid:"18760699", citationType:"PubMed", citationRef:"18760699"}}, {start: {_id:1182}, end: {_id:590}, properties:{evidence:"Our study thus provides further insights into FMRP involvement in DA modulation and may help to reveal the molecular mechanisms underlying impaired learning and memory in fragile X syndrome.", citationTitle:"J Biol Chem. 2010 Jul 9;285(28):21888-901.", annotationSubgraph:["FMR1 subgraph"], annotationMeshdisease:["Fragile X Syndrome"], pmid:"20457613", citationType:"PubMed", citationRef:"20457613"}}, {start: {_id:221}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we identify PINK1, Parkin, ubiquitin and p62 as well as the mitochondrial substrate VDAC1 as key players in a sequential mitophagy process", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Mitophagy subgraph", "PINK1 subgraph"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:271}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we identify PINK1, Parkin, ubiquitin and p62 as well as the mitochondrial substrate VDAC1 as key players in a sequential mitophagy process", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:374}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we identify PINK1, Parkin, ubiquitin and p62 as well as the mitochondrial substrate VDAC1 as key players in a sequential mitophagy process", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:1463}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we identify PINK1, Parkin, ubiquitin and p62 as well as the mitochondrial substrate VDAC1 as key players in a sequential mitophagy process", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:221}, end: {_id:310}, properties:{evidence:"The PARKIN ubiquitin ligase (also known as PARK2) and its regulatory kinase PINK1 (also known as PARK6), often mutated in familial early- onset Parkinson's disease, have central roles in mitochondrial homeostasis and mitophagy.", citationTitle:"Nature. 2013 Apr 18;496(7445):372-6. doi: 10.1038/nature12043. Epub 2013 Mar 17.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23503661", citationType:"PubMed", citationRef:"23503661"}}, {start: {_id:271}, end: {_id:310}, properties:{evidence:"The PARKIN ubiquitin ligase (also known as PARK2) and its regulatory kinase PINK1 (also known as PARK6), often mutated in familial early- onset Parkinson's disease, have central roles in mitochondrial homeostasis and mitophagy.", citationTitle:"Nature. 2013 Apr 18;496(7445):372-6. doi: 10.1038/nature12043. Epub 2013 Mar 17.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23503661", citationType:"PubMed", citationRef:"23503661"}}, {start: {_id:271}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we describe the involvement of parkin and PINK1 in a vesicular pathway regulating mitochondrial quality control. This pathway is distinct from canonical mitophagy and is triggered by the generation of oxidative stress from within mitochondria.", citationTitle:"EMBO J. 2014 Feb 18;33(4):282-95. doi: 10.1002/embj.201385902. Epub 2014 Jan 20.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"24446486", citationType:"PubMed", citationRef:"24446486"}}, {start: {_id:221}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we describe the involvement of parkin and PINK1 in a vesicular pathway regulating mitochondrial quality control. This pathway is distinct from canonical mitophagy and is triggered by the generation of oxidative stress from within mitochondria.", citationTitle:"EMBO J. 2014 Feb 18;33(4):282-95. doi: 10.1002/embj.201385902. Epub 2014 Jan 20.", annotationSubgraph:["PINK1 subgraph"], pmid:"24446486", citationType:"PubMed", citationRef:"24446486"}}, {start: {_id:1525}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hexose kinase activity was required for parkin relocalization, suggesting the effects are shared among hexokinases including the brain-expressed hexokinase 1 (HK1). Knockdown of both HK1 and HK2 led to a stronger block in parkin relocalization than either isoform alone, and expression of HK2 in primary neurons promoted YFP-parkin recruitment to depolarized mitochondria. Mitochondrial parkin recruitment was attenuated with AKT inhibition, which is known to modulate HK2 activity and mitochondrial localization. We, therefore, propose that Akt-dependent recruitment of hexokinases is a required step in the recruitment of parkin prior to mitophagy.", citationTitle:"Hum Mol Genet. 2014 Jan 1;23(1):145-56. doi: 10.1093/hmg/ddt407. Epub 2013 Aug 19.", annotationSubgraph:["Energy metabolic subgraph"], pmid:"23962723", citationType:"PubMed", citationRef:"23962723"}}, {start: {_id:1526}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hexose kinase activity was required for parkin relocalization, suggesting the effects are shared among hexokinases including the brain-expressed hexokinase 1 (HK1). Knockdown of both HK1 and HK2 led to a stronger block in parkin relocalization than either isoform alone, and expression of HK2 in primary neurons promoted YFP-parkin recruitment to depolarized mitochondria. Mitochondrial parkin recruitment was attenuated with AKT inhibition, which is known to modulate HK2 activity and mitochondrial localization. We, therefore, propose that Akt-dependent recruitment of hexokinases is a required step in the recruitment of parkin prior to mitophagy.", citationTitle:"Hum Mol Genet. 2014 Jan 1;23(1):145-56. doi: 10.1093/hmg/ddt407. Epub 2013 Aug 19.", annotationSubgraph:["Energy metabolic subgraph"], pmid:"23962723", citationType:"PubMed", citationRef:"23962723"}}, {start: {_id:1537}, end: {_id:303}, properties:{evidence:"Re-introduction of RNAi-resistant wild-type ratUSP30cDNA,but not the inactive rat USP30(C77S)mutant,prevented the rescue of mitochondrial degradation", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph"], annotationSpecies:["10116"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1543}, end: {_id:1544}, properties:{annotationCondition:["Normal Healthy State"], evidence:"here we show that two receptors previously linked to xenophagy, NDP52 and optineurin, are the primary receptors for PINK1- and parkin- mediated mitophagy. PINK1 recruits NDP52 and optineurin, but not p62, to mitochondria to activate mitophagy directly, independently of parkin. Once recruited to mitochondria, NDP52 and optineurin recruit the autophagy factors ULK1, DFCP1 and WIPI1 to focal spots proximal to mitochondria, revealing a function for these autophagy receptors upstream of LC3. This supports a new model in which PINK1-generated phospho-ubiquitin serves as the autophagy signal on mitochondria, and parkin then acts to amplify this signal. This work also suggests direct and broader roles for ubiquitin phosphorylation in other autophagy pathways.", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Autophagy signaling subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:1545}, end: {_id:1544}, properties:{annotationCondition:["Normal Healthy State"], evidence:"here we show that two receptors previously linked to xenophagy, NDP52 and optineurin, are the primary receptors for PINK1- and parkin- mediated mitophagy. PINK1 recruits NDP52 and optineurin, but not p62, to mitochondria to activate mitophagy directly, independently of parkin. Once recruited to mitochondria, NDP52 and optineurin recruit the autophagy factors ULK1, DFCP1 and WIPI1 to focal spots proximal to mitochondria, revealing a function for these autophagy receptors upstream of LC3. This supports a new model in which PINK1-generated phospho-ubiquitin serves as the autophagy signal on mitochondria, and parkin then acts to amplify this signal. This work also suggests direct and broader roles for ubiquitin phosphorylation in other autophagy pathways.", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Apoptosis signaling subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:1543}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"here we show that two receptors previously linked to xenophagy, NDP52 and optineurin, are the primary receptors for PINK1- and parkin- mediated mitophagy. PINK1 recruits NDP52 and optineurin, but not p62, to mitochondria to activate mitophagy directly, independently of parkin. Once recruited to mitochondria, NDP52 and optineurin recruit the autophagy factors ULK1, DFCP1 and WIPI1 to focal spots proximal to mitochondria, revealing a function for these autophagy receptors upstream of LC3. This supports a new model in which PINK1-generated phospho-ubiquitin serves as the autophagy signal on mitochondria, and parkin then acts to amplify this signal. This work also suggests direct and broader roles for ubiquitin phosphorylation in other autophagy pathways.", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Autophagy signaling subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:1545}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"here we show that two receptors previously linked to xenophagy, NDP52 and optineurin, are the primary receptors for PINK1- and parkin- mediated mitophagy. PINK1 recruits NDP52 and optineurin, but not p62, to mitochondria to activate mitophagy directly, independently of parkin. Once recruited to mitochondria, NDP52 and optineurin recruit the autophagy factors ULK1, DFCP1 and WIPI1 to focal spots proximal to mitochondria, revealing a function for these autophagy receptors upstream of LC3. This supports a new model in which PINK1-generated phospho-ubiquitin serves as the autophagy signal on mitochondria, and parkin then acts to amplify this signal. This work also suggests direct and broader roles for ubiquitin phosphorylation in other autophagy pathways.", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Autophagy signaling subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:1546}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"here we show that two receptors previously linked to xenophagy, NDP52 and optineurin, are the primary receptors for PINK1- and parkin- mediated mitophagy. PINK1 recruits NDP52 and optineurin, but not p62, to mitochondria to activate mitophagy directly, independently of parkin. Once recruited to mitochondria, NDP52 and optineurin recruit the autophagy factors ULK1, DFCP1 and WIPI1 to focal spots proximal to mitochondria, revealing a function for these autophagy receptors upstream of LC3. This supports a new model in which PINK1-generated phospho-ubiquitin serves as the autophagy signal on mitochondria, and parkin then acts to amplify this signal. This work also suggests direct and broader roles for ubiquitin phosphorylation in other autophagy pathways.", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Autophagy signaling subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:1547}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"here we show that two receptors previously linked to xenophagy, NDP52 and optineurin, are the primary receptors for PINK1- and parkin- mediated mitophagy. PINK1 recruits NDP52 and optineurin, but not p62, to mitochondria to activate mitophagy directly, independently of parkin. Once recruited to mitochondria, NDP52 and optineurin recruit the autophagy factors ULK1, DFCP1 and WIPI1 to focal spots proximal to mitochondria, revealing a function for these autophagy receptors upstream of LC3. This supports a new model in which PINK1-generated phospho-ubiquitin serves as the autophagy signal on mitochondria, and parkin then acts to amplify this signal. This work also suggests direct and broader roles for ubiquitin phosphorylation in other autophagy pathways.", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Unfolded protein response subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:221}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Damaged mitochondria are removed by autophagy after activation of the kinase PINK1 and the E3 ubiquitin ligase paract(encoded by PARK2 in humans)", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:271}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Damaged mitochondria are removed by autophagy after activation of the kinase PINK1 and the E3 ubiquitin ligase paract(encoded by PARK2 in humans)", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:1550}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We propose that PINK1 generates the novel and essential signature (phospho-ubiquitin) on mitochondria to induce OPTN and NDP52 recruitment and mitophagy; parkin acts to increase this signal by generating more ubiquitin chains on mitochondria, which are subsequently phos- phorylated by PINK1. Our findings clarify the role of parkin as an amplifier ofthe PINK1-generated mitophagy signal, phospho-ubiquitin, which can engage the autophagy receptors to recruit ULK1, DFCP1, WIPI1 and LC3", citationTitle:"Nature. 2015 Aug 20;524(7565):309-14. doi: 10.1038/nature14893. Epub 2015 Aug 12.", annotationSubgraph:["Autophagy signaling subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"26266977", citationType:"PubMed", citationRef:"26266977"}}, {start: {_id:335}, end: {_id:1571}, properties:{annotationCondition:["Normal Healthy State"], evidence:"hsp-6 and hsp-60 induction was specific to perturbed mitochondrial protein handling, as neither heat-shock nor endoplasmic reticulum stress nor manipulations that impair mitochondrial steps in intermediary metabolism or ATP synthesis activated the mitochondrial chaperone genes.", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph", "Pre-translational events"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:1557}, end: {_id:1583}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondria-derived vesicles (MDVs) have been shown to transport cargo from the mitochondria to the peroxisomes. Mitochondria and peroxisomes share common functions in the oxidation of fatty acids and the reduction of damaging peroxides. Their biogenesis is also linked through both the activation of master transcription factors such as PGC-1alpha and the common use of fission machinery, including DRP1, Mff, and hFis1.", citationTitle:"Curr Biol. 2010 Jul 27;20(14):1310-5. doi: 10.1016/j.cub.2010.05.066. Epub 2010 Jul 8.", annotationSubgraph:["Energy metabolic subgraph"], pmid:"20619655", citationType:"PubMed", citationRef:"20619655"}}, {start: {_id:1601}, end: {_id:1602}, properties:{evidence:"Mitochondrial uncoupling mediated by uncoupling protein 1 (UCP1) is classically associated with non-shivering thermogenesis by brown fat. Recent evidence indicates that UCP family proteins are also present in selected neurons. Unlike UCP1, these proteins (UCP2, UCP4 and BMCP1/UCP5) are not constitutive uncouplers and are not crucial for non-shivering thermogenesis.", citationTitle:"Nat Rev Neurosci. 2005 Nov;6(11):829-40.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"16224498", citationType:"PubMed", citationRef:"16224498"}}, {start: {_id:1603}, end: {_id:245}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The mammalian brain is one of the organs with the highest energy demands, and mitochondria are key determinants of its functions. Here we show that the type-1 cannabinoid receptor (CB(1)) is present at the membranes of mouse neuronal mitochondria (mtCB(1)), where it directly controls cellular respiration and energy production. Through activation of mtCB(1) receptors, exogenous cannabinoids and in situ endocannabinoids decreased cyclic AMP concentration, protein kinase A activity, complex I enzymatic activity and respiration in neuronal mitochondria. In addition, intracellular CB(1) receptors and mitochondrial mechanisms contributed to endocannabinoid-dependent depolarization-induced suppression of inhibition in the hippocampus. Thus, mtCB(1) receptors directly modulate neuronal energy metabolism, revealing a new mechanism of action of G protein-coupled receptor signaling in the brain.", citationTitle:"Nat Neurosci. 2012 Mar 4;15(4):558-64. doi: 10.1038/nn.3053.", annotationSubgraph:["Notch signaling subgraph"], pmid:"22388959", citationType:"PubMed", citationRef:"22388959"}}, {start: {_id:1603}, end: {_id:1604}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The mammalian brain is one of the organs with the highest energy demands, and mitochondria are key determinants of its functions. Here we show that the type-1 cannabinoid receptor (CB(1)) is present at the membranes of mouse neuronal mitochondria (mtCB(1)), where it directly controls cellular respiration and energy production. Through activation of mtCB(1) receptors, exogenous cannabinoids and in situ endocannabinoids decreased cyclic AMP concentration, protein kinase A activity, complex I enzymatic activity and respiration in neuronal mitochondria. In addition, intracellular CB(1) receptors and mitochondrial mechanisms contributed to endocannabinoid-dependent depolarization-induced suppression of inhibition in the hippocampus. Thus, mtCB(1) receptors directly modulate neuronal energy metabolism, revealing a new mechanism of action of G protein-coupled receptor signaling in the brain.", citationTitle:"Nat Neurosci. 2012 Mar 4;15(4):558-64. doi: 10.1038/nn.3053.", annotationSubgraph:["Notch signaling subgraph"], pmid:"22388959", citationType:"PubMed", citationRef:"22388959"}}, {start: {_id:634}, end: {_id:1621}, properties:{evidence:"METHODS AND FINDINGS:Purified brain mitochondria of Pink1-/- mice showed impaired Ca2+ storage capacity, resulting in increased Ca2+ induced mitochondrial permeability transition (mPT) that was rescued by cyclosporine A. A subpopulation of neurons in the substantia nigra of Pink1-/- mice accumulated phospho-c-Jun, showing that Jun N-terminal kinase (JNK) activity is increased. Pink1-/- mice 6 months and older displayed reduced DA levels associated with increased DA turnover. Moreover, Pink1-/-mice had increased levels of IL-1beta, IL-12 and IL-10 in the striatum after peripheral challenge with lipopolysaccharide (LPS), and Pink1-/- embryonic fibroblasts showed decreased basal and inflammatory cytokine-induced nuclear factor kappa/beta (NF-kB) activity. Quantitative transcriptional profiling in the striatum revealed that Pink1-/- mice differentially express genes that (i) are upregulated in animals with experimentally induced dopaminergic lesions, (ii) regulate innate immune responses and/or apoptosis and (iii) promote axonal regeneration and sprouting.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:1587}, end: {_id:1643}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondrial function is evaluated by monitoring mitochondrial protein import efficiency of the transcription factor ATFS-1, which mediates the mitochondrial Unfolded protein response subgraph (UPRmt).", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Unfolded protein response subgraph"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1587}, end: {_id:1654}, properties:{evidence:"Lastly, we determined if ATFS-1 and the UPRmt interacted with established C. elegans innate immune pathways, which include a MAP kinase pathway mediated by NSY-1/SEK-1/PMK-1 (refs 6, 7, 10), the MLK-1/MEK-1/KGB-1 c-Jun kinase pathway, as well as that mediated by ZIP-2 (ref. 17).", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Innate immune system subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1587}, end: {_id:712}, properties:{evidence:"Lastly, we determined if ATFS-1 and the UPRmt interacted with established C. elegans innate immune pathways, which include a MAP kinase pathway mediated by NSY-1/SEK-1/PMK-1 (refs 6, 7, 10), the MLK-1/MEK-1/KGB-1 c-Jun kinase pathway, as well as that mediated by ZIP-2 (ref. 17).", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Innate immune system subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1655}, end: {_id:1643}, properties:{annotationCondition:["Normal Healthy State"], evidence:"SirT3 Regulates the Mitochondrial Unfolded protein response subgraph.", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:1666}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We find that DCT-1 is a key mediator of mitophagy and longevity assurance under conditions of stress in C. elegans.", citationTitle:"Nature. 2015 May 28;521(7553):525-8. doi: 10.1038/nature14300. Epub 2015 Apr 20.", annotationSubgraph:["Mitophagy subgraph"], pmid:"25896323", citationType:"PubMed", citationRef:"25896323"}}, {start: {_id:1666}, end: {_id:1667}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We find that DCT-1 is a key mediator of mitophagy and longevity assurance under conditions of stress in C. elegans.", citationTitle:"Nature. 2015 May 28;521(7553):525-8. doi: 10.1038/nature14300. Epub 2015 Apr 20.", annotationSubgraph:["Mitophagy subgraph"], pmid:"25896323", citationType:"PubMed", citationRef:"25896323"}}, {start: {_id:634}, end: {_id:1717}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It should be noted however that genetic interactions between pink1 and drp1 (dynamin related protein) or fis1 (fission 1), genes implicated in mitochondrial fission (Yoon et al, 2003), do not imply necessarily that pink1 is in the same molecular pathway as these proteins. Indeed studies performed on fibroblasts from patients carrying the homozygous W437X (Trp437 â†’ Xxx) nonsense PINK1 mutation revealed a normal mitochondrial tubular network", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph", "Mitochondria fission subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1718}, end: {_id:1717}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It should be noted however that genetic interactions between pink1 and drp1 (dynamin related protein) or fis1 (fission 1), genes implicated in mitochondrial fission (Yoon et al, 2003), do not imply necessarily that pink1 is in the same molecular pathway as these proteins. Indeed studies performed on fibroblasts from patients carrying the homozygous W437X (Trp437 â†’ Xxx) nonsense PINK1 mutation revealed a normal mitochondrial tubular network", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph", "Mitochondria fission subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1719}, end: {_id:1717}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It should be noted however that genetic interactions between pink1 and drp1 (dynamin related protein) or fis1 (fission 1), genes implicated in mitochondrial fission (Yoon et al, 2003), do not imply necessarily that pink1 is in the same molecular pathway as these proteins. Indeed studies performed on fibroblasts from patients carrying the homozygous W437X (Trp437 â†’ Xxx) nonsense PINK1 mutation revealed a normal mitochondrial tubular network", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph", "Mitochondria fission subgraph"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:221}, end: {_id:1757}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, time-dependent oxygen consumption of intact mitochondria prepared from pink1B9 mutants was increased when the flies were first placed on MK-4", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["PINK1 subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:221}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Results from PINK1 mutants were more complex, suggesting a mitophagy deficit largely masked by compensatory up-regulation of an alternative turnover pathway.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:221}, end: {_id:1842}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results reveal previously unknown functions of PINK1/Parkin in RNA metabolism and suggest new approaches to mitochondrial restoration and disease intervention", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1842}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results reveal previously unknown functions of PINK1/Parkin in RNA metabolism and suggest new approaches to mitochondrial restoration and disease intervention", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"To understand the OXPHOS defects in PINK1 mutant, we examined the expression of RCC proteins in NM tissues of control and PINK1B9 mutant flies.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:810}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, loss- or gain-of-function of genes involved in fission/fusion (Drp1, Marf) or motility (Miro) had no obvious effect on the levels of MOM-bound nRCC mRNAs, although for some unknown reason the protein levels of C-V (OSCP) and C-I 30 were reduced in Drp1-DN or Miro overexpression (OE) conditions", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondria fission subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:810}, end: {_id:313}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, loss- or gain-of-function of genes involved in fission/fusion (Drp1, Marf) or motility (Miro) had no obvious effect on the levels of MOM-bound nRCC mRNAs, although for some unknown reason the protein levels of C-V (OSCP) and C-I 30 were reduced in Drp1-DN or Miro overexpression (OE) conditions", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondria fission subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1848}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, loss- or gain-of-function of genes involved in fission/fusion (Drp1, Marf) or motility (Miro) had no obvious effect on the levels of MOM-bound nRCC mRNAs, although for some unknown reason the protein levels of C-V (OSCP) and C-I 30 were reduced in Drp1-DN or Miro overexpression (OE) conditions", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1848}, end: {_id:313}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, loss- or gain-of-function of genes involved in fission/fusion (Drp1, Marf) or motility (Miro) had no obvious effect on the levels of MOM-bound nRCC mRNAs, although for some unknown reason the protein levels of C-V (OSCP) and C-I 30 were reduced in Drp1-DN or Miro overexpression (OE) conditions", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1849}, end: {_id:1847}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, loss- or gain-of-function of genes involved in fission/fusion (Drp1, Marf) or motility (Miro) had no obvious effect on the levels of MOM-bound nRCC mRNAs, although for some unknown reason the protein levels of C-V (OSCP) and C-I 30 were reduced in Drp1-DN or Miro overexpression (OE) conditions", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recent studies have highlighted the roles of PINK1 and Parkin in mitophagy.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Mitophagy subgraph", "PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recent studies have highlighted the roles of PINK1 and Parkin in mitophagy.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1881}, end: {_id:1879}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Taken together, these findings indicate that CHCHD4 plays a central role in the biogenesis of specific respiratory chain complexes.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1589}, end: {_id:1899}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hence, by interfering with the co-translational import of CHCHD4 into mitochondria, AIF depletion also reduced the translation of GFP in this system", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1883}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Kinetic experiments led to the conclusion that the import of CHCHD4 into mitochondria was translation-dependent (because it only occurred in the absence of CHX) and that it was affected by the abundance of AIF.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1882}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In AIF-deficient cells, the biotinylation (and hence import) of CHCHD4-b by the IMS-targeted biotinylase was reduced.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1883}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"it appears plausible that AIF affects the import of CHCHD4 through a specific effect.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1883}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Moreover, a mitochondriopathy-associated point mutation occurring within the NADH-binding domain of AIF (Berger et al., 2011) reduced the interaction with CHCHD4, and the addition of NADH barely ameliorated the formation of the complex. In contrast to AIF, the binding of CHCHD4 involved a short domain.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:271}, end: {_id:1925}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In support of this notion, the antiapoptotic activity of parkin is independent of the proteasome.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:1605}, properties:{annotationCondition:["Normal Healthy State"], evidence:"To better understand how parkin could exert protective function we considered the possibility that it could modulate the ERâ€“mitochondria inter-organelles cross talk.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}, {start: {_id:1961}, end: {_id:1621}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Importantly, NLRX1 synergistically potentiated ROS production induced by tumour necrosis factor a, Shigella infection and double-stranded RNA, resulting in amplified NF-kB-dependent and JUN amino-terminal kinasesdependent signalling. Together, these results identify NLRX1 as a NLR that contributes to the link between ROS generation at the mitochondria and innate immune responses.", citationTitle:"EMBO Rep. 2008 Mar;9(3):293-300. doi: 10.1038/sj.embor.7401161. Epub 2008 Jan 25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"18219313", citationType:"PubMed", citationRef:"18219313"}}, {start: {_id:271}, end: {_id:842}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Ubiquitin-mediated targeting of intracellular bacteria to the autophagy pathway is a key innate defence mechanism against invading microbes, including the important human pathogen Mycobacterium tuberculosis. However, the ubiquitin ligases responsible for catalysing ubiquitin chains that surround intracellular bacteria are poorly understood. The parkin protein is a ubiquitin ligase with a well-established role in mitophagy, and mutations in the parkin gene (PARK2) lead to increased susceptibility to Parkinson's disease. Surprisingly, genetic polymorphisms in the PARK2 regulatory region are also associated with increased susceptibility to intracellular bacterial pathogens in humans, including Mycobacterium leprae and Salmonella enterica serovar Typhi, but the function of parkin in immunity has remained unexplored. Here we show that parkin has a role in ubiquitin-mediated autophagy of M. tuberculosis. Both parkin- deficient mice and flies are sensitive to various intracellular bacterial infections, indicating parkin has a conserved role in metazoan innate defence. Moreover, our work reveals an unexpected functional link between mitophagy and infectious disease.", citationTitle:"Nature. 2013 Sep 26;501(7468):512-6. doi:10.1038/nature12566. Epub 2013 Sep 4.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"24005326", citationType:"PubMed", citationRef:"24005326"}}, {start: {_id:271}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Indeed, several recent studies have shown PARKIN to participate in a wide array of cellular processes such as apoptosis, regulation of lipid metabolism, and cytokine production upon infection, all of which may contribute to the in vivo importance of PARKIN in immunity.", citationTitle:"Nature. 2013 Sep 26;501(7468):512-6. doi:10.1038/nature12566. Epub 2013 Sep 4.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"24005326", citationType:"PubMed", citationRef:"24005326"}}, {start: {_id:2003}, end: {_id:1621}, properties:{annotationCondition:["Normal Healthy State"], evidence:"NLRP3 is a key component of the macromolecular signaling complex called the inflammasome that promotes caspase 1-dependent production of IL-1beta. The adaptor ASC is necessary for NLRP3-dependent inflammasome function, but it is not known whether ASC is a sufficient partner and whether inflammasome formation occurs in the cytosol or in association with mitochondria is controversial. Here, we show that the mitochondria-associated adaptor molecule, MAVS, is required for optimal NLRP3 inflammasome activity. MAVS mediates recruitment of NLRP3 to mitochondria, promoting production of IL-1beta and the pathophysiologic activity of the NLRP3 inflammasome in vivo. Our data support a more complex model of NLRP3 inflammasome activation than previously appreciated, with at least two adapters required for maximal function. Because MAVS is a mitochondria-associated molecule previously considered to be uniquely involved in type 1 interferon production, these findings also reveal unexpected polygamous involvement of PYD/CARD-domain-containing adapters in innate immune signaling events.", citationTitle:"Cell. 2013 Apr 11;153(2):348-61. doi: 10.1016/j.cell.2013.02.054.", annotationSubgraph:["Caspase subgraph", "Innate immune system subgraph"], pmid:"23582325", citationType:"PubMed", citationRef:"23582325"}}, {start: {_id:2006}, end: {_id:1621}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our study indicates that astrocytic DRD2 activation normally suppresses neuroinflammation in the central nervous system through a CRYAB-dependent mechanism, and provides a new strategy for targeting the astrocyte-mediated innate immune response in the central nervous system during ageing and disease.", citationTitle:"Nature. 2013 Feb 7;494(7435):90-4. doi: 10.1038/nature11748. Epub 2012 Dec 16.", annotationSubgraph:["Chaperone subgraph", "Innate immune system subgraph"], annotationCell:["astrocyte"], pmid:"23242137", citationType:"PubMed", citationRef:"23242137"}}, {start: {_id:203}, end: {_id:328}, properties:{evidence:"Our findings provide a mechanistic link between the enhanced kinase activity of PD-linked LRRK2 and neuronal cell death.", citationTitle:"Hum Mutat. 2011 Dec;32(12):1390-7. doi: 10.1002/humu.21582. Epub 2011 Sep 12.", annotationSubgraph:["LRRK2 subgraph"], pmid:"21850687", citationType:"PubMed", citationRef:"21850687"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:196}, end: {_id:328}, properties:{evidence:"Our findings provide a mechanistic link between the enhanced kinase activity of PD-linked LRRK2 and neuronal cell death.", citationTitle:"Hum Mutat. 2011 Dec;32(12):1390-7. doi: 10.1002/humu.21582. Epub 2011 Sep 12.", annotationSubgraph:["LRRK2 subgraph"], pmid:"21850687", citationType:"PubMed", citationRef:"21850687"}}, {start: {_id:196}, end: {_id:578}, properties:{evidence:"Our results unequivocally demonstrate that LRRK2 transgenic mice develop motor impairment consisting of small anomalies in rotarod performance (presumably reflecting a deficit in motor coordination and dystonia) and a strong deficiency in the hanging-wire test (reflecting muscle weakness), rather than hypokinesia which was difficult to be demonstrated in the actimeter.", citationTitle:"Pharmacol Res. 2016 Aug;110:181-92. doi: 10.1016/j.phrs.2016.04.004. Epub 2016 Apr 6.", annotationSubgraph:["LRRK2 subgraph"], pmid:"27063942", citationType:"PubMed", citationRef:"27063942"}}, {start: {_id:203}, end: {_id:303}, properties:{evidence:"Our results provide novel insights into the multiple mechanisms that dictate the association between LRRK2 and mitophagy in sPD", citationTitle:"Mol Neurobiol. 2015 Dec;52(3):1804-20. doi: 10.1007/s12035-014-8980-6. Epub 2014 Nov 15.", annotationSubgraph:["LRRK2 subgraph", "Mitophagy subgraph"], pmid:"25394383", citationType:"PubMed", citationRef:"25394383"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
