UNWIND [{start: {_id:516}, end: {_id:16}, properties:{evidence:"Paraquat, another neurotoxin implicated in the pathogenesis of PD, also related to hyperacetylation [49] and [50].", citationTitle:"J Neurol Sci. 2015 Feb 15;349(1-2):3-9. Epub 2014 Dec 18.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25553963", citationType:"PubMed", citationRef:"25553963"}}, {start: {_id:549}, end: {_id:550}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Accumulation of aberrant proteins and inclusion bodies are hallmarks in most neurodegenerative diseases.", citationTitle:"Neural Regen Res. 2013 Aug 25;8(24):2275-83. doi: 10.3969/j.issn.1673-5374.2013.24.007.", pmid:"25206537", citationType:"PubMed", citationRef:"25206537"}}, {start: {_id:809}, end: {_id:16}, properties:{evidence:"Cell culture studies suggest that PINK1 is mitochondrially located and may exert a protective effect on the cell that is abrogated by the mutations, resulting in increased susceptibility to cellular stress. These data provide a direct molecular link between mitochondria and the pathogenesis of PD.", citationTitle:"Science. 2004 May 21;304(5674):1158-60. Epub 2004 Apr 15.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15087508", citationType:"PubMed", citationRef:"15087508"}}, {start: {_id:863}, end: {_id:16}, properties:{evidence:"noradrenaline, 5-hydroxytryptamine and acetylcholine are affected in the disease.", citationTitle:"Prog Brain Res. 2010;183:183-208. doi: 10.1016/S0079-6123(10)83010-9.", annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"20696321", citationType:"PubMed", citationRef:"20696321"}}, {start: {_id:45}, end: {_id:16}, properties:{evidence:"noradrenaline, 5-hydroxytryptamine and acetylcholine are affected in the disease.", citationTitle:"Prog Brain Res. 2010;183:183-208. doi: 10.1