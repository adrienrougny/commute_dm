 properties:{evidence:"CD28 stimulation increases IGF-IR expression on Jurkat cells, and exogenously added IGF-I can protect these cells from Fas induced apoptosis.", annotationSubgraph:["Insulin signal transduction"], pmid:"10760788", citationType:"PubMed", citationRef:"10760788"}}, {start: {_id:2216}, end: {_id:61}, properties:{evidence:"We investigated the mechanisms of NEP regulation of neuropeptide mediated cell survival in PC cells, including whether neuropeptide substrates of NEP induce phosphorylations of IGF-IR and Akt in PC cells.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"11309283", citationType:"PubMed", citationRef:"11309283"}}, {start: {_id:56}, end: {_id:2222}, properties:{evidence:"These studies indicate that IGF-IR stimulates phosphorylation of SHPS-1 which is critical for SHP-2 recruitment to the plasma membrane and for its recruitment to the IGF-IR.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"11779860", citationType:"PubMed", citationRef:"11779860"}}, {start: {_id:2201}, end: {_id:2229}, properties:{evidence:"Results generated in the in vivo studies indicate that, like insulin, AII stimulates tyrosine phosphorylation of the insulin receptor substrates IRS-1 and IRS-2.", annotationConfidence:["Very High"], pmid:"10320054", citationType:"PubMed", citationRef:"10320054"}}, {start: {_id:75}, end: {_id:2229}, properties:{evidence:"Results generated in the in vivo studies indicate that, like insulin, AII stimulates tyrosine phosphorylation of the insulin receptor substrates IRS-1 and IRS-2.", annotationConfidence:["Very High"], pmid:"10320054", citationType:"PubMed", citationRef:"10320054"}}, {start: {_id:2230}, end: {_id:2229}, properties:{evidence:"Overexpression of GLUT4 in db/+ TG6 mice markedly improved glucose stimulated insulin secretion, by 250%, and increased IRbeta, IRS-1, and p85alpha phosphorylation twofold, despite no change in concentration of these proteins.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"10331411", citationType:"PubMed", citationRef:"10331411"}}, {start: {_id:2240}, end: {_id:2241}, properties:{evidence:"The presence of tyrosine phosphorylated IRS-1 appears to increase insulin receptor tyrosine phosphorylation and potentially tyrosine kinase activity via inhibition of protein-tyrosine phosphatase (s).", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"10517679", citationType:"PubMed", citationRef:"10517679"}}, {start: {_id:2242}, end: {_id:2229}, properties:{evidence:"Recent studies demonstrated that activation of Jak-1 is necessary for the IFNÎ±-phosphorylation of IRS-1 and activation of the PI3â€_-kinase , further establishing that the IRS/PI3â€_ kinase pathway is Jak[MISSING/INVALID API KEY: limited to 200 char for", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"10517679", citationType:"PubMed", citationRef:"10517679"}}, {start: {_id:2244}, end: {_id:2226}, properties:{evidence:"Finally, IGF mediated degradation of IRS-1 was blocked by inhibition of phosphatidylinositol 3 '-kinase activity but was not affected by inhibition of ERK, suggesting that this may represent a direct negative-feedback mechanism resulting from downstream I", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"10669726", citationType:"PubMed", citationRef:"10669726"}}, {start: {_id:58}, end: {_id:2229}, properties:{evidence:"Moreover, insulin like growth factor (IGF)-I and insulin, which are well known to cause IRS-1 and IRS-2 phosphorylation, increased the stimulatory effect of IL-4 on 3beta-HSD activity.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"10674396", citationType:"PubMed", citationRef:"10674396"}}] AS row
