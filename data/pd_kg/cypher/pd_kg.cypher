UNWIND [{start: {_id:1872}, end: {_id:1873}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Given that Dcp1 and GW182 are components of the P- body (Franks and Lykke-Andersen, 2008), our results suggest that P-bodies and possibly stress granules, related cytoplasmic structures in the turnover or storage of translationally stalled mRNAs (Balagopal and Parker, 2009), may be intimately linked to PINK1/Parkin pathogenesis.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Post-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:HAS_COMPONENTS]->(end) SET r += row.properties;
UNWIND [{start: {_id:196}, end: {_id:16}, properties:{evidence:"Mutations in PARK8 (LRRK2) are associated with autosomal dominant parkinsonism and Parkinson disease (PD). The mean UPSIT score in G2019S parkinsonian carriers was lower than that in healthy controls (p < 0.001) and similar to that found in patients with PD (p > 0.999).", citationTitle:"Neurology. 2008 Sep 23;71(13):1021-6. doi: 10.1212/01.wnl.0000326575.20829.45.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18809839", citationType:"PubMed", citationRef:"18809839"}}, {start: {_id:198}, end: {_id:16}, properties:{evidence:"The clinical phenotypes and [(18)F]-dopa PET findings for subjects with R1441H or G2385R resembled those of patients with idiopathic PD. Pathogenic mutations in leucine-rich repeat kinase 2 (LRRK2) cause autosomal-dominant familial Parkinson's disease (PD).", citationTitle:"J Biomed Sci. 2008 Sep;15(5):661-7. doi: 10.1007/s11373-008-9260-0. Epub 2008 Jun 4.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18523869", citationType:"PubMed", citationRef:"18523869"}}, {start: {_id:200}, end: {_id:16}, properties:{evidence:"The clinical phenotypes and [(18)F]-dopa PET findings for subjects with R1441H or G2385R resembled those of patients with idiopathic PD. Pathogenic mutations in leucine-rich repeat kinase 2 (LRRK2) cause autosomal-dominant familial Parkinson's disease (PD).", citationTitle:"J Biomed Sci. 2008 Sep;15(5):661-7. doi: 10.1007/s11373-008-9260-0. Epub 2008 Jun 4.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18523869", citationType:"PubMed", citationRef:"18523869"}}, {start: {_id:196}, end: {_id:16}, properties:{evidence:"We conclude that in these patients carrying the LRRK2 Gly2019Ser mutation, the neurodegenerative process results in a pattern of nigrostriatal dopaminergic dysfunction similar to that observed in IPD.", citationTitle:"Mov Disord. 2006 Aug;21(8):1144-7.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16671078", citationType:"PubMed", citationRef:"16671078"}}, {start: {_id:202}, end: {_id:16}, properties:{evidence:"The PD-associated mutation, R1441C, located within the Roc domain, leads to an increase in LRRK2 kinase activity and a decrease in the rate of GTP hydrolysis, compared to the wild-type protein, in an in vitro assay. This finding suggests that the R1441C mutation may help stabilize an activated state of LRRK2. Additionally, LRRK2-mediated phosphorylation is stimulated upon binding of non-hydrolyzable GTP analogs, suggesting that LRRK2 is an MAPKKK-activated intramolecularly by its own GTPase. Since GTPases and MAPKKKs are upstream regulators of multiple signal transduction cascades, LRRK2 may play a central role in integrating pathways involved in neuronal cell signaling and the pathogenesis of PD.", citationTitle:"Exp Cell Res. 2007 Oct 1;313(16):3658-70. Epub 2007 Jul 19.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17706965", citationType:"PubMed", citationRef:"17706965"}}, {start: {_id:215}, end: {_id:16}, properties:{evidence:"In transfection studies, we demonstrated that both the wild type and Gly2385Arg variant LRRK2 protein localize to the cytoplasm and form aggregates. However, under condition of oxidative stress, the Gly2385Arg variant was more toxic and associated with a higher rate of apoptosis. Our study lends support to the contention that the Gly2385Arg is a common risk factor for PD in the Chinese population. Our bioinformatics and in-vitro studies also suggest that the Gly2385Arg variant is biologically relevant and it might act through pro-apoptotic mechanisms.", citationTitle:"Hum Genet. 2007 Feb;120(6):857-63. Epub 2006 Sep 30.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17019612", citationType:"PubMed", citationRef:"17019612"}}, {start: {_id:196}, end: {_id:16}, properties:{evidence:"The substitution of serine for glycine at position 2019 (G2019S) in the kinase domain of LRRK2 represents the most prevalent genetic mutation in both familial and apparently sporadic cases of PD. Because mutations in LRRK2 are likely associated with a toxic gain of function, destabilization of LRRK2 may be a novel way to limit its detrimental effects. Here we show that LRRK2 forms a complex with heat shock protein 90 (Hsp90) in vivo and that inhibition of Hsp90 disrupts the association of Hsp90 with LRRK2 and leads to proteasomal degradation of LRRK2. Hsp90 inhibitors may therefore limit the mutant LRRK2-elicited toxicity to neurons. As a proof of principle, we show that Hsp90 inhibitors rescue the axon growth retardation caused by overexpression of the LRRK2 G2019S mutation in neurons. Therefore, inhibition of LRRK2 kinase activity can be achieved by blocking Hsp90-mediated chaperone activity and Hsp90 inhibitors may serve as potential anti-PD drugs.", citationTitle:"J Neurosci. 2008 Mar 26;28(13):3384-91. doi: 10.1523/JNEUROSCI.0185-08.2008.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18367605", citationType:"PubMed", citationRef:"18367605"}}, {start: {_id:196}, end: {_id:16}, properties:{evidence:"Pathogenic mutations in the leucine-rich repeat kinase-2 (LRRK2) gene cause autosomal-dominant and certain cases of sporadic Parkinson's disease (PD). The G2019S substitution in LRRK2 is the most common genetic determinant of PD identified so far, and maps to a specific region of the kinase domain called the activation segment. The prominent pathogenic G2019S mutation in LRRK2 results in altered autophosphorylation, and increased autophosphorylation and substrate phosphorylation, through a process that seems to involve reorganization of the activation segment. Our results suggest a molecular mechanistic explanation for how the G2019S mutation enhances the catalytic activity of LRRK2, thereby leading to pathogenicity. These findings have important implications for therapeutic strategies in PD.", citationTitle:"Hum Mol Genet. 2007 Sep 1;16(17):2031-9. Epub 2007 Jun 20.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"17584768", citationType:"PubMed", citationRef:"17584768"}}, {start: {_id:196}, end: {_id:16}, properties:{evidence:"In this brain bank-based series, LRRK2 G2019S mutation occurred in patients with parkinsonism associated with either typical brainstem LB pathology or non-specific nigral degeneration.", citationTitle:"J Neurol Sci. 2008 Jul 15;270(1-2):94-8. doi: 10.1016/j.jns.2008.02.010. Epub 2008 Mar 19.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18353371", citationType:"PubMed", citationRef:"18353371"}}, {start: {_id:196}, end: {_id:16}, properties:{evidence:"These findings suggest that LRRK2(G2019S)-induced neurodegeneration in Parkinsonian brains may be partly mediated by increased phosphorylation of tubulin-beta and constraining of microtubule dynamics.", citationTitle:"J Neurochem. 2009 Sep;110(5):1514-22. doi: 10.1111/j.1471-4159.2009.06235.x. Epub 2009 Jun 22.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19545277", citationType:"PubMed", citationRef:"19545277"}}, {start: {_id:253}, end: {_id:16}, properties:{evidence:"Both mutations (p.A244G and p.V317I) were found to abolish the protective effect of wild-type PINK1 against staurosporine-induced apoptosis. These findings further expand the clinical spectrum of PINK1-related parkinsonism to include late onset, typical PD, and underline the existing difficulties in discriminating between mendelian parkinsonism and idiopathic PD.", citationTitle:"Mov Disord. 2008 Apr 30;23(6):881-5. doi: 10.1002/mds.21960.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18307263", citationType:"PubMed", citationRef:"18307263"}}, {start: {_id:255}, end: {_id:16}, properties:{evidence:"Both mutations (p.A244G and p.V317I) were found to abolish the protective effect of wild-type PINK1 against staurosporine-induced apoptosis. These findings further expand the clinical spectrum of PINK1-related parkinsonism to include late onset, typical PD, and underline the existing difficulties in discriminating between mendelian parkinsonism and idiopathic PD.", citationTitle:"Mov Disord. 2008 Apr 30;23(6):881-5. doi: 10.1002/mds.21960.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"18307263", citationType:"PubMed", citationRef:"18307263"}}, {start: {_id:257}, end: {_id:16}, properties:{evidence:"Mutations in the PINK1 gene represent the second most frequent cause of early-onset Parkinson's disease (EOPD). One or two mutated alleles were also reported in some sporadic or familial patients suffering from late-onset Parkinson's disease (LOPD). We aimed at assessing the frequency of mutations in this gene in our population. We performed a sequence analysis of PINK1 in 115 patients diagnosed with Parkinson's disease (PD) from southern Italy, including 93 sporadic cases with EOPD, 9 familial cases with EOPD, and 13 familial cases with LOPD. Three known homozygous mutations (Q456X, W437X, Q126P), corresponding to a 2.6% of all cases, were found. In particular, one mutation was detected among the sporadic cases (1.0%), one mutation among the familial early-onset patients (11.1%) and one mutation among the familial late-onset patients (7.7%). In addition, we found two heterozygous mutations (E476K, R207Q) among the sporadic patients. Only one mutation (R207Q) had not been previously described. Our results assess the role played by PINK1 in EOPD in southern Italy and illustrate the existence of mutations in this gene also in the late- onset form of the disease.", citationTitle:"Parkinsonism Relat Disord. 2012 Jun;18(5):651-3. doi: 10.1016/j.parkreldis.2011.08.017. Epub 2011 Sep 17.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21925922", citationType:"PubMed", citationRef:"21925922"}}, {start: {_id:249}, end: {_id:16}, properties:{evidence:"Mutations in the PINK1 gene represent the second most frequent cause of early-onset Parkinson's disease (EOPD). One or two mutated alleles were also reported in some sporadic or familial patients suffering from late-onset Parkinson's disease (LOPD). We aimed at assessing the frequency of mutations in this gene in our population. We performed a sequence analysis of PINK1 in 115 patients diagnosed with Parkinson's disease (PD) from southern Italy, including 93 sporadic cases with EOPD, 9 familial cases with EOPD, and 13 familial cases with LOPD. Three known homozygous mutations (Q456X, W437X, Q126P), corresponding to a 2.6% of all cases, were found. In particular, one mutation was detected among the sporadic cases (1.0%), one mutation among the familial early-onset patients (11.1%) and one mutation among the familial late-onset patients (7.7%). In addition, we found two heterozygous mutations (E476K, R207Q) among the sporadic patients. Only one mutation (R207Q) had not been previously described. Our results assess the role played by PINK1 in EOPD in southern Italy and illustrate the existence of mutations in this gene also in the late- onset form of the disease.", citationTitle:"Parkinsonism Relat Disord. 2012 Jun;18(5):651-3. doi: 10.1016/j.parkreldis.2011.08.017. Epub 2011 Sep 17.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21925922", citationType:"PubMed", citationRef:"21925922"}}, {start: {_id:259}, end: {_id:16}, properties:{evidence:"Mutations in the PINK1 gene represent the second most frequent cause of early-onset Parkinson's disease (EOPD). One or two mutated alleles were also reported in some sporadic or familial patients suffering from late-onset Parkinson's disease (LOPD). We aimed at assessing the frequency of mutations in this gene in our population. We performed a sequence analysis of PINK1 in 115 patients diagnosed with Parkinson's disease (PD) from southern Italy, including 93 sporadic cases with EOPD, 9 familial cases with EOPD, and 13 familial cases with LOPD. Three known homozygous mutations (Q456X, W437X, Q126P), corresponding to a 2.6% of all cases, were found. In particular, one mutation was detected among the sporadic cases (1.0%), one mutation among the familial early-onset patients (11.1%) and one mutation among the familial late-onset patients (7.7%). In addition, we found two heterozygous mutations (E476K, R207Q) among the sporadic patients. Only one mutation (R207Q) had not been previously described. Our results assess the role played by PINK1 in EOPD in southern Italy and illustrate the existence of mutations in this gene also in the late- onset form of the disease.", citationTitle:"Parkinsonism Relat Disord. 2012 Jun;18(5):651-3. doi: 10.1016/j.parkreldis.2011.08.017. Epub 2011 Sep 17.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21925922", citationType:"PubMed", citationRef:"21925922"}}, {start: {_id:261}, end: {_id:16}, properties:{evidence:"Mutations in the PINK1 gene represent the second most frequent cause of early-onset Parkinson's disease (EOPD). One or two mutated alleles were also reported in some sporadic or familial patients suffering from late-onset Parkinson's disease (LOPD). We aimed at assessing the frequency of mutations in this gene in our population. We performed a sequence analysis of PINK1 in 115 patients diagnosed with Parkinson's disease (PD) from southern Italy, including 93 sporadic cases with EOPD, 9 familial cases with EOPD, and 13 familial cases with LOPD. Three known homozygous mutations (Q456X, W437X, Q126P), corresponding to a 2.6% of all cases, were found. In particular, one mutation was detected among the sporadic cases (1.0%), one mutation among the familial early-onset patients (11.1%) and one mutation among the familial late-onset patients (7.7%). In addition, we found two heterozygous mutations (E476K, R207Q) among the sporadic patients. Only one mutation (R207Q) had not been previously described. Our results assess the role played by PINK1 in EOPD in southern Italy and illustrate the existence of mutations in this gene also in the late- onset form of the disease.", citationTitle:"Parkinsonism Relat Disord. 2012 Jun;18(5):651-3. doi: 10.1016/j.parkreldis.2011.08.017. Epub 2011 Sep 17.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21925922", citationType:"PubMed", citationRef:"21925922"}}, {start: {_id:263}, end: {_id:16}, properties:{evidence:"Mutations in the PINK1 gene represent the second most frequent cause of early-onset Parkinson's disease (EOPD). One or two mutated alleles were also reported in some sporadic or familial patients suffering from late-onset Parkinson's disease (LOPD). We aimed at assessing the frequency of mutations in this gene in our population. We performed a sequence analysis of PINK1 in 115 patients diagnosed with Parkinson's disease (PD) from southern Italy, including 93 sporadic cases with EOPD, 9 familial cases with EOPD, and 13 familial cases with LOPD. Three known homozygous mutations (Q456X, W437X, Q126P), corresponding to a 2.6% of all cases, were found. In particular, one mutation was detected among the sporadic cases (1.0%), one mutation among the familial early-onset patients (11.1%) and one mutation among the familial late-onset patients (7.7%). In addition, we found two heterozygous mutations (E476K, R207Q) among the sporadic patients. Only one mutation (R207Q) had not been previously described. Our results assess the role played by PINK1 in EOPD in southern Italy and illustrate the existence of mutations in this gene also in the late- onset form of the disease.", citationTitle:"Parkinsonism Relat Disord. 2012 Jun;18(5):651-3. doi: 10.1016/j.parkreldis.2011.08.017. Epub 2011 Sep 17.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21925922", citationType:"PubMed", citationRef:"21925922"}}, {start: {_id:238}, end: {_id:16}, properties:{evidence:"We demonstrate an enrichment of heterozygous mutations in sporadic PD patients compared with matched control subjects (1.2% in PD vs 0.4% in control subjects). Furthermore, we show that they adversely affect DeltaPsim in a similar way to the familial G309D mutation. Although it remains difficult to conclusively demonstrate the pathogenicity of heterozygous mutations, the results of this study and the previously reported subclinical nigrostriatal dysfunction in carriers of heterozygous PINK1 mutations suggest the possibility that these heterozygous mutations are a significant risk factor in the development of later onset PD.", citationTitle:"Ann Neurol. 2006 Oct;60(4):414-9.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16969854", citationType:"PubMed", citationRef:"16969854"}}, {start: {_id:298}, end: {_id:16}, properties:{evidence:"PTEN-induced kinase 1 (PINK1), which is required for mitochondrial homeostasis, is a gene product responsible for early-onset Parkinson's disease (PD).", citationTitle:"PLoS Genet. 2010 Dec 2;6(12):e1001229. doi: 10.1371/journal.pgen.1001229. ", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"21151955", citationType:"PubMed", citationRef:"21151955"}}, {start: {_id:196}, end: {_id:548}, properties:{evidence:"Numerous reports from cultured neural cell lines and primary neurons have demonstrated that expression of G2019S LRRK2 induces neuronal toxicity as assessed by measures of inclusion formation, neurite process shortening and induction of apoptosis (assessed by TUNEL labeling, propidium iodide uptake or nuclear condensation).", citationTitle:"Small GTPases. 2013 Jul-Sep;4(3):164-70. doi: 10.4161/sgtp.25130. Epub 2013 Jun 10.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Neurotoxicity Syndromes"], pmid:"24025585", citationType:"PubMed", citationRef:"24025585"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:608}, end: {_id:365}, properties:{evidence:"Loss of ATP13A2 function results in impaired lysosomal function and, consequently, accumulation of SNCA/??-synuclein and neurotoxicity(21),One patient (Patient A with c.216C>A/c.1904G>A)", citationTitle:"Acta Neurol Taiwan. 2012 Sep;21(3):99-107.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23196729", citationType:"PubMed", citationRef:"23196729"}}, {start: {_id:608}, end: {_id:609}, properties:{evidence:"Loss of ATP13A2 function results in impaired lysosomal function and, consequently, accumulation of SNCA/??-synuclein and neurotoxicity(21),One patient (Patient A with c.216C>A/c.1904G>A)", citationTitle:"Acta Neurol Taiwan. 2012 Sep;21(3):99-107.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23196729", citationType:"PubMed", citationRef:"23196729"}}, {start: {_id:611}, end: {_id:609}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three novel FBXO7 mutations, c.90711G>T and p.Thr22Met in the compound heterozygous state and p.Arg498X in homozygous state, were later identified in Dutch and Italian families exhibiting spasticity and Babinski signs, tremor, bradykinesia, and postural instability(33,34).", citationTitle:"Acta Neurol Taiwan. 2012 Sep;21(3):99-107.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23196729", citationType:"PubMed", citationRef:"23196729"}}, {start: {_id:611}, end: {_id:612}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three novel FBXO7 mutations, c.90711G>T and p.Thr22Met in the compound heterozygous state and p.Arg498X in homozygous state, were later identified in Dutch and Italian families exhibiting spasticity and Babinski signs, tremor, bradykinesia, and postural instability(33,34).", citationTitle:"Acta Neurol Taiwan. 2012 Sep;21(3):99-107.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23196729", citationType:"PubMed", citationRef:"23196729"}}, {start: {_id:614}, end: {_id:365}, properties:{evidence:"In the present study, we investigated the effects of edaravone on the neurotoxicity in PD-induced isoforms of DJ-1 containing the mutation L166P.", citationTitle:"Journal of molecular neuroscience : MN; Vol. 51; Iss. 2", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23657982", citationType:"PubMed", citationRef:"23657982"}}, {start: {_id:196}, end: {_id:16}, properties:{evidence:"However, there are marked population-specific differences [7]: the LRRK2 G2019S mutation, the most common, causes 4-5% of familial and 1-2% of sporadic PD in populations of European descent, 30-40% of both familial and sporadic PD in Arab patients from North Africa and 10-30% in Ashkenazi Jews, but is rare in Asians; two coding variants, G2385R and R1628P, increase the risk of sporadic PD only in Asians; R1441G explains a large proportion of Basque cases; the last identified LRRK2 mutation, R1437H, was found in two Norwegian families.", citationTitle:"Parkinsonism & related disorders; Vol. 18 Suppl 1; Iss.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22166458", citationType:"PubMed", citationRef:"22166458"}}, {start: {_id:636}, end: {_id:16}, properties:{evidence:"However, there are marked population-specific differences [7]: the LRRK2 G2019S mutation, the most common, causes 4-5% of familial and 1-2% of sporadic PD in populations of European descent, 30-40% of both familial and sporadic PD in Arab patients from North Africa and 10-30% in Ashkenazi Jews, but is rare in Asians; two coding variants, G2385R and R1628P, increase the risk of sporadic PD only in Asians; R1441G explains a large proportion of Basque cases; the last identified LRRK2 mutation, R1437H, was found in two Norwegian families.", citationTitle:"Parkinsonism & related disorders; Vol. 18 Suppl 1; Iss.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22166458", citationType:"PubMed", citationRef:"22166458"}}, {start: {_id:638}, end: {_id:16}, properties:{evidence:"However, there are marked population-specific differences [7]: the LRRK2 G2019S mutation, the most common, causes 4-5% of familial and 1-2% of sporadic PD in populations of European descent, 30-40% of both familial and sporadic PD in Arab patients from North Africa and 10-30% in Ashkenazi Jews, but is rare in Asians; two coding variants, G2385R and R1628P, increase the risk of sporadic PD only in Asians; R1441G explains a large proportion of Basque cases; the last identified LRRK2 mutation, R1437H, was found in two Norwegian families.", citationTitle:"Parkinsonism & related disorders; Vol. 18 Suppl 1; Iss.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22166458", citationType:"PubMed", citationRef:"22166458"}}, {start: {_id:200}, end: {_id:16}, properties:{evidence:"Beside LRRK2 mutations that cause PD themselves, two common variants in LRRK2 (G2385R and R1628P) appear to increase the risk of PD about two-fold, particularly in Asian populations.", citationTitle:"Parkinsonism & related disorders; Vol. 18 Suppl 1; Iss.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22166458", citationType:"PubMed", citationRef:"22166458"}}, {start: {_id:640}, end: {_id:16}, properties:{evidence:"Beside LRRK2 mutations that cause PD themselves, two common variants in LRRK2 (G2385R and R1628P) appear to increase the risk of PD about two-fold, particularly in Asian populations.", citationTitle:"Parkinsonism & related disorders; Vol. 18 Suppl 1; Iss.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22166458", citationType:"PubMed", citationRef:"22166458"}}, {start: {_id:644}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three variants were reported by these tools as potentially pathogenic: Arg141Cys mutation in POLR1C (rs148385032), Cys3346Arg in PKHD1 (rs149798764), and c.801 ???2 A>G mutation in DNAJC6 (at chr.1:65623981).", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Pre-translational events"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:647}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three variants were reported by these tools as potentially pathogenic: Arg141Cys mutation in POLR1C (rs148385032), Cys3346Arg in PKHD1 (rs149798764), and c.801 ???2 A>G mutation in DNAJC6 (at chr.1:65623981).", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:297}, end: {_id:16}, properties:{evidence:"The clinical phenotype of PD patients with SNCA mutations (including multiplications) has certain characteristics.", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:665}, end: {_id:16}, properties:{evidence:"The clinical phenotype of PD patients with SNCA mutations (including multiplications) has certain characteristics.", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:667}, end: {_id:16}, properties:{evidence:"The clinical phenotype of PD patients with SNCA mutations (including multiplications) has certain characteristics.", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:196}, end: {_id:16}, properties:{evidence:"In a recently published international multicenter study, only 49 of 8371 (0.58%) PD patients of European and Asian origin carried a LRRK2 G2019S mutation [44].", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:196}, end: {_id:16}, properties:{evidence:"Nevertheless, the large number of PD patients with the LRRK2 G2019S mutation allowed for a clear description of the clinical phenotype attributed to a single mutation in a PD gene, and for statistical analyses [45].", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:669}, end: {_id:16}, properties:{evidence:"In 2011, the D620N (p.Asp620Asn, c.1858G>A) mutation in vacuolar protein sorting 35 (VPS35) was discovered in a previously described Swiss parkinsonism family [53] and [54].", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Endoplasmic reticulum-Golgi protein export"], annotationMeshdisease:["Parkinson Disease"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:671}, end: {_id:365}, properties:{evidence:"Mutations in microtubule-associated protein tau (MAPT) cause frontotemporal dementia with or without parkinsonism and with tau pathology [72].", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Tau protein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:672}, end: {_id:365}, properties:{evidence:"Monogenic disorders with various manifestations that may include parkinsonism Mutations in mitochondrial DNA polymerase gamma (POLG, POLG1) have been reported from patients with parkinsonism, with loss of dopaminergic cells evidenced in DATscans and at least partial response to dopaminergic medication [85] and [86].", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:679}, end: {_id:680}, properties:{evidence:"Phospholipase A2, group VI (cytosolic, calcium-independent) (PLA2G6; PARK14) was identified in 2006 as the gene causing two types of a rare disorder called neurodegeneration with brain iron accumulation (NBIA), type 2A (also known as infantile neuroaxonal dystrophy) and type 2B [124].", citationTitle:"Parkinsonism Relat Disord. 2013 Apr;19(4):407-15. doi: 10.1016/j.parkreldis.2013.01.020. Epub 2013 Feb 23.", annotationSubgraph:["Lipid metabolism subgraph"], annotationMeshdisease:["Neuroaxonal Dystrophies", "Parkinson Disease"], annotationMeshanatomy:["Muscles"], annotationCell:["dopaminergic neuron"], pmid:"23462481", citationType:"PubMed", citationRef:"23462481"}}, {start: {_id:697}, end: {_id:16}, properties:{evidence:"On the other hand, another possible explanation is that the heterozygous PLA2G6 missense mutation already affected the biological function and increased the susceptibility to disease, just like parkin, PINK-1 but not DJ-1 heterozygous missense mutation [5].", citationTitle:"Neurosci Lett. 2012 Apr 18;514(2):156-8. doi: 10.1016/j.neulet.2012.02.078. Epub 2012 Mar 3.", annotationSubgraph:["Lipid metabolism subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22406380", citationType:"PubMed", citationRef:"22406380"}}, {start: {_id:665}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"By highlighting these points and the alpha-specific copper-binding site 50H in the 3D structure, a tight connection between these residues was exposed: 50H is surrounded by E46, A53 and T54, the mutation E46K changes the electric field of the copper-binding region, and the mutation A53T results in narrowed accessibility of this region.", citationTitle:"Biochemical and biophysical research communications; Vol. 441; Iss. 2", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24140056", citationType:"PubMed", citationRef:"24140056"}}, {start: {_id:667}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"is known that certain polymorphisms in alpha-synuclein are major risk factors for sporadic Parkinson‚Äôs disease (PD). Three well-known point mutations, A30P, E46K and A53T, result in dominant familial parkinsonism [28].", citationTitle:"Biochemical and biophysical research communications; Vol. 441; Iss. 2", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24140056", citationType:"PubMed", citationRef:"24140056"}}, {start: {_id:297}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"is known that certain polymorphisms in alpha-synuclein are major risk factors for sporadic Parkinson‚Äôs disease (PD). Three well-known point mutations, A30P, E46K and A53T, result in dominant familial parkinsonism [28].", citationTitle:"Biochemical and biophysical research communications; Vol. 441; Iss. 2", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24140056", citationType:"PubMed", citationRef:"24140056"}}, {start: {_id:716}, end: {_id:16}, properties:{evidence:"Female patient FPD-252-13, with EIF4G1 p.G686C, had PD according to UK Brain Bank criteria ( Hughes et al., 1992), onset at age 52, a Hoehn and Yahr score of 2/5, at age 67, excellent L-dopa response, peak-dose dyskinesias, but no cognitive impairment (Mini Mental State Examination score = 29/30).", citationTitle:"Neurobiology of aging; Vol. 33; Iss. 9", annotationSubgraph:["Pre-translational events"], annotationMeshdisease:["Parkinson Disease"], pmid:"22658323", citationType:"PubMed", citationRef:"22658323"}}, {start: {_id:718}, end: {_id:16}, properties:{evidence:"Linkage and candidate gene analysis identified the p.R1205H mutation in EIF4G1, encoding a component of the eIF4F translation initiation complex that regulates cell survival in response to stressors, in a large French family with AD late-onset PD and 7 smaller families of various origin, probably resulting from an ancestral founder ( Chartier-Harlin et al., 2011).", citationTitle:"Neurobiology of aging; Vol. 33; Iss. 9", annotationSubgraph:["Pre-translational events"], annotationMeshdisease:["Parkinson Disease"], pmid:"22658323", citationType:"PubMed", citationRef:"22658323"}}, {start: {_id:221}, end: {_id:719}, properties:{evidence:"In early onset of familial PD, several autosomal recessive factors, such as Parkin, Pink1, and DJ-1, are clearly involved in mitochondrial pathophysiology, and loss of function of these factors might be causative for PD.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Muscles", "Blood Platelets"], annotationCell:["fibroblast"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:220}, end: {_id:719}, properties:{evidence:"In early onset of familial PD, several autosomal recessive factors, such as Parkin, Pink1, and DJ-1, are clearly involved in mitochondrial pathophysiology, and loss of function of these factors might be causative for PD.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Muscles", "Blood Platelets"], annotationCell:["fibroblast"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:271}, end: {_id:719}, properties:{evidence:"In early onset of familial PD, several autosomal recessive factors, such as Parkin, Pink1, and DJ-1, are clearly involved in mitochondrial pathophysiology, and loss of function of these factors might be causative for PD.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Muscles", "Blood Platelets"], annotationCell:["fibroblast"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:203}, end: {_id:719}, properties:{evidence:"On the other hand, aggregation of Œ±-synuclein (Œ±S) may interfere with mitochondria in sporadic PD, and mitochondrial dysfunction might be further exacerbated by dysregulation of leucine-rich repeat kinase 2 (LRRK2).", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Muscles", "Blood Platelets"], annotationCell:["fibroblast"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:137}, end: {_id:719}, properties:{evidence:"On the other hand, aggregation of Œ±-synuclein (Œ±S) may interfere with mitochondria in sporadic PD, and mitochondrial dysfunction might be further exacerbated by dysregulation of leucine-rich repeat kinase 2 (LRRK2).", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Muscles", "Blood Platelets"], annotationCell:["fibroblast"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:725}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"By mapping the disease locus with a lod score of 5.13 to a < 3.5 Mbp region at 1p31.3 in a consanguineous family and subsequent exome sequencing analysis, we identified homozygous truncating mutation p.Q734X in DNAJC6.", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["fibroblast"], annotationMeshanatomy:["Mitochondria"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:641}, end: {_id:726}, properties:{evidence:"Also, an 80-kb deletion that included DNAJC6 sequences was identified in a boy reported as having obesity, epilepsy and mental retardation but not any signs of parkinsonism.", citationTitle:"Parkinsonism & related disorders; Vol. 19; Iss. 3", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Epilepsy"], pmid:"23211418", citationType:"PubMed", citationRef:"23211418"}}, {start: {_id:641}, end: {_id:16}, properties:{evidence:"Our findings further establish DNAJC6 as a juvenile parkinsonism gene, and expand the spectrums of the parkinsonism phenotype and DNAJC6 mutation.", citationTitle:"Parkinsonism & related disorders; Vol. 19; Iss. 3", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23211418", citationType:"PubMed", citationRef:"23211418"}}, {start: {_id:641}, end: {_id:727}, properties:{evidence:"Also, a homozygous 80-kb deletion that encompassed part of DNAJC6 and part of LEPR (leptin receptor) was identified by oligonucleotide array-CGH in a boy having obesity, epilepsy and mental retardation but not any signs of parkinsonism, and the phenotype of the DNAJC6 defect was suggested as mental retardation and/or epilepsy [9].", citationTitle:"Parkinsonism & related disorders; Vol. 19; Iss. 3", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23211418", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"23211418"}}, {start: {_id:421}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Another dominant gene that plays a role in endosomal trafficking is VPS35, responsible for late onset PD [20] and [21].", citationTitle:"Parkinsonism & related disorders; Vol. 19; Iss. 3", annotationSubgraph:["Endoplasmic reticulum-Golgi protein export"], annotationMeshdisease:["Parkinson Disease"], pmid:"23211418", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"23211418"}}, {start: {_id:841}, end: {_id:16}, properties:{evidence:"Initial movement abnormalities of the index patient carrying the E64D mutation on both DJ1 alleles started at age 34 years, when the patient developed slowing of movements and stiffness in the left leg and arm.", citationTitle:"Hum Mutat. 2004 Oct;24(4):321-9.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15365989", citationType:"PubMed", citationRef:"15365989"}}, {start: {_id:1203}, end: {_id:1172}, properties:{evidence:"We found one patient with a novel heterozygous frameshift mutation in the DYT11 gene (c.1058-1062 delCACCA/p.Gln352fsX376). Our findings provide further support to the hypothesis that adult-onset monogenic dystonia may underlie a PD look-alike clinical phenotype. I", citationTitle:"Neurology. 2014 Sep 23;83(13):1155-62.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Dystonia"], pmid:"25150291", citationType:"PubMed", citationRef:"25150291"}}, {start: {_id:1222}, end: {_id:1179}, properties:{evidence:"LRRK2(R1441G) tg mice displayed deficits in sense of smell in both the hidden treat test, and a radial arm maze test.", citationTitle:"Neurosci Lett. 2014 Nov 7;583:159-64. doi: 10.1016/j.neulet.2014.09.042. Epub 2014 Sep 26.", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], pmid:"25263790", citationType:"PubMed", citationRef:"25263790"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:665}, end: {_id:1179}, properties:{evidence:"The fruit fly Drosophila melanogaster, expressing human alpha- synuclein protein or its mutant, A30P, captures several hallmarks of PD and has been successfully used to model PD in numerous studies. First, we report olfactory deficits in fly expressing A30P (A30P), showing deficits in two out of three olfactory modalities, tested-- olfactory acuity and odor discrimination. The remaining third modality is odor identification/naming. Second, oxidative stress is an important environmental risk factor of PD. We show that oxidative stress exacerbated the two affected olfactory modalities in younger A30P flies. Third, different olfactory receptor neurons are activated differentially by different odors in flies.", citationTitle:"PLoS One. 2014 May 30;9(5):e97758. doi: 10.1371/journal.pone.0097758. eCollection 2014.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"24879013", citationType:"PubMed", citationRef:"24879013"}}, {start: {_id:196}, end: {_id:16}, properties:{annotationPdstage:["Idiopathic_PD"], evidence:"The clinical features of patients with the G2019S mutation are surprisingly uniform and resemble those of patients with other LRRK2 mutations or with idiopathic PD", citationTitle:"Physiol Rev. 2011 Oct;91(4):1161-218. doi: 10.1152/physrev.00022.2010.", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"22013209", citationType:"PubMed", citationRef:"22013209"}}, {start: {_id:196}, end: {_id:16}, properties:{annotationPdstage:["Idiopathic_PD"], evidence:"We investigated the frequency of a common heterozygous mutation, 2877510 g-->A, which produces a glycine to serine aminoacid substitution at codon 2019 (Gly2019 ser), in idiopathic Parkinson's disease. We assessed 482 patients with the disorder, of whom 263 had pathologically confirmed disease, by direct sequencing for mutations in exon 41 of LRRK2. The mutation was present in eight (1.6%) patients. We have shown that a common single Mendelian mutation is implicated in sporadic Parkinson's disease.", citationTitle:"Lancet. 2005 Jan 29-Feb 4;365(9457):415-6.", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"15680457", annotationTranscriptionallyActiveRegion:["exon 41"], citationType:"PubMed", citationRef:"15680457"}}, {start: {_id:196}, end: {_id:16}, properties:{annotationPdstage:["Familial_autosomal_dominant_PD"], evidence:"In order to assess the role of mutations in this gene in other familial cases we undertook a mutation screen of all 51 exons of LRRK2 in 117 other smaller British kindreds with familial Parkinson's disease. The commonest mutation was G2019S and we also identified two novel mutations, R1941H and T2356I, in the coding sequence. These data suggest that parkinsonism caused by mutations in LRRK2 is likely to represent the commonest locus for autosomal dominant Parkinson's disease with a phenotype, pathology and in vivo imaging similar to idiopathic, late-onset Parkinson's disease.", citationTitle:"Brain. 2005 Dec;128(Pt 12):2786-96. Epub 2005 Nov 4.", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"16272164", citationType:"PubMed", citationRef:"16272164"}}, {start: {_id:1297}, end: {_id:16}, properties:{annotationPdstage:["Familial_autosomal_dominant_PD"], evidence:"In order to assess the role of mutations in this gene in other familial cases we undertook a mutation screen of all 51 exons of LRRK2 in 117 other smaller British kindreds with familial Parkinson's disease. The commonest mutation was G2019S and we also identified two novel mutations, R1941H and T2356I, in the coding sequence. These data suggest that parkinsonism caused by mutations in LRRK2 is likely to represent the commonest locus for autosomal dominant Parkinson's disease with a phenotype, pathology and in vivo imaging similar to idiopathic, late-onset Parkinson's disease.", citationTitle:"Brain. 2005 Dec;128(Pt 12):2786-96. Epub 2005 Nov 4.", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"16272164", citationType:"PubMed", citationRef:"16272164"}}, {start: {_id:1299}, end: {_id:16}, properties:{annotationPdstage:["Familial_autosomal_dominant_PD"], evidence:"In order to assess the role of mutations in this gene in other familial cases we undertook a mutation screen of all 51 exons of LRRK2 in 117 other smaller British kindreds with familial Parkinson's disease. The commonest mutation was G2019S and we also identified two novel mutations, R1941H and T2356I, in the coding sequence. These data suggest that parkinsonism caused by mutations in LRRK2 is likely to represent the commonest locus for autosomal dominant Parkinson's disease with a phenotype, pathology and in vivo imaging similar to idiopathic, late-onset Parkinson's disease.", citationTitle:"Brain. 2005 Dec;128(Pt 12):2786-96. Epub 2005 Nov 4.", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"16272164", citationType:"PubMed", citationRef:"16272164"}}, {start: {_id:614}, end: {_id:16}, properties:{annotationPdstage:["Early_onset_PD"], evidence:"Mutations in DJ-1 (PARK7) have been reported in two consanguineous families with young-onset Parkinson's disease (YOPD). We report a low frequency of pathogenic DJ-1 mutations in our cohort of patients. One homozygous missense mutation(Leu166Pro) and one heterozygous mutation(Asp24Ala) were found in two YOPD samples.", citationTitle:"Ann Neurol. 2003 Sep;54(3):283-6.", annotationSubgraph:["Chaperone subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"12953260", citationType:"PubMed", citationRef:"12953260"}}, {start: {_id:1301}, end: {_id:16}, properties:{annotationPdstage:["Early_onset_PD"], evidence:"Mutations in DJ-1 (PARK7) have been reported in two consanguineous families with young-onset Parkinson's disease (YOPD). We report a low frequency of pathogenic DJ-1 mutations in our cohort of patients. One homozygous missense mutation(Leu166Pro) and one heterozygous mutation(Asp24Ala) were found in two YOPD samples.", citationTitle:"Ann Neurol. 2003 Sep;54(3):283-6.", annotationSubgraph:["Chaperone subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"12953260", citationType:"PubMed", citationRef:"12953260"}}, {start: {_id:1306}, end: {_id:16}, properties:{annotationPdstage:["Familial_autosomal_recessive_PD"], evidence:"The authors performed PINK1 mutation analysis of 51 families with autosomal recessive Parkinson disease (ARPD). They found two novel PINK1 mutations: one was a homozygous deletion (13516-18118del) and the other a homozygous missense mutation (C388R). Clinically, the patients with the deletion had dementia. Thus, early-onset PD with dementia may be considered PINK1-linked parkinsonism.", citationTitle:"Neurology. 2005 Jun 14;64(11):1955-7.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Dementia", "Parkinson Disease"], pmid:"15955953", citationType:"PubMed", citationRef:"15955953"}}, {start: {_id:614}, end: {_id:16}, properties:{evidence:"Our findings indicate that loss of DJ-1 function leads to neurodegeneration.we show that DJ-1 mutations are associated with PARK7, a monogenic form of human parkinsonism. We identified a homozygous point mutation (T->C transition at position 497 from the ORF start in cDNA), resulting in the substitution of a highly conserved leucine at position 166 (Leu166) of the DJ-1 protein by a proline", citationTitle:"Science. 2003 Jan 10;299(5604):256-9. Epub 2002 Nov 21.", annotationSubgraph:["Chaperone subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"12446870", citationType:"PubMed", citationRef:"12446870"}}, {start: {_id:665}, end: {_id:16}, properties:{annotationPdstage:["Familial_autosomal_dominant_PD"], evidence:"Alpha-synuclein mutations that cause familial Parkinson's disease, A30P and A53T, exhibit increased nuclear targeting in cell culture", citationTitle:"Hum Mol Genet. 2006 Oct 15;15(20):3012-23. Epub 2006 Sep 7.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16959795", citationType:"PubMed", citationRef:"16959795"}}, {start: {_id:297}, end: {_id:16}, properties:{annotationPdstage:["Familial_autosomal_dominant_PD"], evidence:"Alpha-synuclein mutations that cause familial Parkinson's disease, A30P and A53T, exhibit increased nuclear targeting in cell culture", citationTitle:"Hum Mol Genet. 2006 Oct 15;15(20):3012-23. Epub 2006 Sep 7.", annotationSubgraph:["Synuclein subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"16959795", citationType:"PubMed", citationRef:"16959795"}}, {start: {_id:137}, end: {_id:16}, properties:{evidence:"we suggest that FGF20 increases susceptibility to PD via chronically elevated levels of âˆšÃ‰â‰ˆÎ©âˆšÃ‡Â¬Â±-synuclein in human brain", citationTitle:"Am J Hum Genet. 2008 Feb;82(2):283-9. doi: 10.1016/j.ajhg.2007.09.021. Epub 2008 Jan 31.", annotationSubgraph:["Neurotrophic subgraph", "Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"18252210", annotationTranscriptionallyActiveRegion:["exon 3"], citationType:"PubMed", citationRef:"18252210"}}, {start: {_id:423}, end: {_id:16}, properties:{evidence:"abnormally phosphorylated SNCA and abnormally phosphorylated tau are found at the synaptic-enriched fractions of FC in PD", citationTitle:"Hum Mol Genet. 2011 Aug 1;20(15):3067-78. doi: 10.1093/hmg/ddr210. Epub 2011 May 10.", annotationSubgraph:["Synuclein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21558425", citationType:"PubMed", citationRef:"21558425"}}, {start: {_id:424}, end: {_id:16}, properties:{evidence:"abnormally phosphorylated SNCA and abnormally phosphorylated tau are found at the synaptic-enriched fractions of FC in PD", citationTitle:"Hum Mol Genet. 2011 Aug 1;20(15):3067-78. doi: 10.1093/hmg/ddr210. Epub 2011 May 10.", annotationSubgraph:["Tau protein subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"21558425", citationType:"PubMed", citationRef:"21558425"}}, {start: {_id:238}, end: {_id:16}, properties:{evidence:"We have identified two homozygous mutations affecting the PINK1 kinase domain in three consanguineous PARK6 families: a truncating nonsense mutation and a missense mutation at a highly conserved amino acid.The Spanish family carried a G->A transition in exon 4,resulting in amino acid substitution(G309D)at highly conserved position.Both Italian families carried the same G->A transition in exon 7 which results in W437OPA substitution.", citationTitle:"Science. 2004 May 21;304(5674):1158-60. Epub 2004 Apr 15.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"15087508", annotationTranscriptionallyActiveRegion:["exon 4"], citationType:"PubMed", citationRef:"15087508", annotationRace:["Spanish"]}}, {start: {_id:1379}, end: {_id:16}, properties:{evidence:"We have identified two homozygous mutations affecting the PINK1 kinase domain in three consanguineous PARK6 families: a truncating nonsense mutation and a missense mutation at a highly conserved amino acid.The Spanish family carried a G->A transition in exon 4,resulting in amino acid substitution(G309D)at highly conserved position.Both Italian families carried the same G->A transition in exon 7 which results in W437OPA substitution.", citationTitle:"Science. 2004 May 21;304(5674):1158-60. Epub 2004 Apr 15.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"15087508", annotationTranscriptionallyActiveRegion:["exon 7"], citationType:"PubMed", citationRef:"15087508", annotationRace:["Italian"]}}, {start: {_id:221}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Although available data on Î±-synuclein, LRRK2 and Parkin already make a strong case for a role of mitochondria in PD, the most convincing evidence for the involvement of mitochondrial dysfunction is the presence of mutations in the mitochondrial serine/threonine kinase PINK1 that cause recessive hereditary PD in several families", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:221}, end: {_id:16}, properties:{evidence:"Regardless, our work provides additional support to the hypothesis that the dysfunction of Complex I is an important and early event in the pathogenesis of Pink1-associated PD", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:271}, end: {_id:16}, properties:{evidence:"Mutations of the PARK2 and PINK1 genes, encoding the cytosolic E3 ubiquitin-protein ligase Parkin and the mitochondrial serine/ threonine kinase PINK1, respectively, cause autosomal recessive early- onset Parkinsonâ€™s disease (PD).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
