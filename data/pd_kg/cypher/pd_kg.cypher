UNWIND [{start: {_id:1000}, end: {_id:995}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three tag SNPs were selected, including the novel SNP +2852(G/A), to relate to risk of AD, Mini Mental State Examination (MMSE) scores and cerebrospinal fluid (CSF) biomarker levels of total tau (T-tau), hyperphosphorylated tau181 (P-tau(181)) and AâˆšÃ©Â¬â‰¤(1-42). The AA genotype of the newly found 3'-UTR SNP +2852(A/G), was associated with a decreased risk of AD", citationTitle:"J Neural Transm. 2012 Jul;119(7):833-42. doi: 10.1007/s00702-012-0823-x. Epub 2012 May 25.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Brain"], pmid:"22622366", citationType:"PubMed", citationRef:"22622366"}}, {start: {_id:24}, end: {_id:734}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These findings suggest that the maintenance of appropriate mitochondrial HSD17B10 levels is one of the mechanisms by which Parkin preserves mitochondrial quality.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fission subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:24}, end: {_id:719}, properties:{evidence:"If the action of parkin on damaged mitochondria is well recognized, its role in physiological condition is still obscure.", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:DECREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:271}, end: {_id:1784}, properties:{annotationCondition:["Normal Healthy State"], evidence:"There is considerable interest in the possible direct role of some of these proteins in Parkin-dependent mitochondrial degradation, particularly for Mitofusin 1/2,13,20 VDACs,9,17 hexokinases 1/216,19 and subunits of the translo- case of the OMM (TOM).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fusion subgraph", "Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:271}, end: {_id:1785}, properties:{annotationCondition:["Normal Healthy State"], evidence:"There is considerable interest in the possible direct role of some of these proteins in Parkin-dependent mitochondrial degradation, particularly for Mitofusin 1/2,13,20 VDACs,9,17 hexokinases 1/216,19 and subunits of the translo- case of the OMM (TOM).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondrial subgraph", "Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:271}, end: {_id:1786}, properties:{annotationCondition:["Normal Healthy State"], evidence:"There is considerable interest in the possible direct role of some of these proteins in Parkin-dependent mitochondrial degradation, particularly for Mitofusin 1/2,13,20 VDACs,9,17 hexokinases 1/216,19 and subunits of the translo- case of the OMM (TOM).", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"25591737", citationType:"PubMed", citationRef:"2