UNWIND [{start: {_id:961}, end: {_id:979}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The members of the GDNF family, GDNF, neurturin (NTN), persephin (PSP), and artemin (ART), have seven conserved cysteine residues with similar spacing, making them distant members of the transforming growth factor-beta (TGF-beta) superfamily. Like the members of the neurotrophin family, the GDNF-like growth factors belong structurally to the cysteine knot proteins", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:1563}, end: {_id:1564}, properties:{annotationCondition:["Normal Healthy State"], evidence:"NRF-2 belongs to the ETS family; these factors regulate a large number of mitochondrial genes encoded in the cell nucleus, including mtTFA", citationTitle:"Cell. 1999 Jul 9;98(1):115-24.", annotationSubgraph:["Transcription subgraph"], pmid:"10412986", citationType:"PubMed", citationRef:"10412986"}}, {start: {_id:2054}, end: {_id:2059}, properties:{evidence:"Cell transfection requires cationic DNA complexes and heparan sulfate proteoglycans (HSPGs) at the cell surface. As efï¬�cient transfection also requires the condensed DNA particles to bear a cationic surface [4], it was inferred that anionic proteoglycans were potential receptors [2].", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:HAS_MEMBERS]->(end) SET r += row.properties;
UNWIND [{start: {_id:366}, end: {_id:501}, properties:{evidence:"Several studies have shown that higher concentration of Hcy in PD is related to long-term administration of levodopa (L-dopa)", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationSubgraph:["G-protein-mediated signaling"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2013-12-01", annotationConfidence:["Very High"], pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:1225}, end: {_id:1167}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Estradiol increased astrocyte density and olfactory epithelium (OE) thickness regardless of the genotype. In addition estradiol treatment increased the number of mature neurons in the OE and glomerular synaptophysin in both genotypes, but the magnitude of increase was greater in the WT than in the KO mice. These data suggest that estrogen and apoE act synergistically to minimize the loss of mature sensory neurons and synapses following ovariectomy.", citationTitle:"Exp Neurol. 2012 Sep;237(1):1-7. doi: 10.1016/j.expneurol.2012.06.001. Epub 2012 Jun 9.", pmid:"22691461", citationType:"PubMed", citationRef:"22691461"}}, {start: {_id:1225}, end: {_id:1226}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Estradiol increased astrocyte density and olfactory epithelium (OE) thickness regardless of the genotype. In addition estradiol treatment increased the number of mature neurons in the OE and glomerular synaptophysin in both genotypes, but the magnitude of increase was greater in the WT than in the KO mice. These data suggest that estrogen and apoE act synergistically to minimize the loss of mature sensory neurons and synapses following ovariectomy.", citationTitle:"Exp Neurol. 2012 Sep;237(1):1-7. doi: 10.1016/j.expneurol.2012.06.001. Epub 2012 Jun 9.", pmid:"22691461", citationType:"PubMed", citationRef:"22691461"}}, {start: {_id:1227}, end: {_id:1229}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Estradiol increased astrocyte density and olfactory epithelium (OE) thickness regardless of the genotype. In addition estradiol treatment increased the number of mature neurons in the OE and glomerular synaptophysin in both genotypes, but the magnitude of increase was greater in the WT than in the KO mice. These data suggest that estrogen and apoE act synergistically to minimize the loss of mature sensory neurons and synapses following ovariectomy.", citationTitle:"Exp Neurol. 2012 Sep;237(1):1-7. doi: 10.1016/j.expneurol.2012.06.001. Epub 2012 Jun 9.", pmid:"22691461", citationType:"PubMed", citationRef:"22691461"}}, {start: {_id:1284}, end: {_id:77}, properties:{annotationCondition:["Normal Healthy State"], evidence:"the HAT( histone acetyltransferase ) inhibitor anacardic acid has a neuroprotective effect against dieldrin-induced neurotoxicity, indicating the translational potential of HAT inhibitors in the neurodegenerative process of dopaminergic neurons", citationTitle:"Mol Pharmacol. 2010 Apr;77(4):621-32. doi: 10.1124/mol.109.062174. Epub 2010 Jan 22.", annotationSpecies:["10090"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20097775", citationType:"PubMed", citationRef:"20097775"}}, {start: {_id:1249}, end: {_id:501}, properties:{evidence:"High plasma homocysteine levels have been observed in Parkinson's disease (PD) patients treated with levodopa", citationTitle:"Neuromolecular Med. 2007;9(3):249-54.", annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"17914182", citationType:"PubMed", citationRef:"17914182"}}, {start: {_id:1522}, end: {_id:267}, properties:{evidence:"antimycin A-induced ROS may cause PINK1 buildup at local or individual import channels. This interplay between local and global PINK1 accumulation may regulate the magnitudes of subsequent parkin recruitment and ubiquitin ligase activity.", citationTitle:"EMBO J. 2014 Feb 18;33(4):282-95. doi: 10.1002/embj.201385902. Epub 2014 Jan 20.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"24446486", citationType:"PubMed", citationRef:"24446486"}}, {start: {_id:1567}, end: {_id:1566}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Certain environmental states, such as cold temperatures or high- calorie diets, are known to increase the activity of the sympathetic nervous system, leading to the release of norepinephrine. This neurotransmitter triggers activation of the Î²-adrenergic receptors, resulting in the elevation of intracellular cAMP and stimulation of adaptive thermogenesis in skeletal muscle and brown fat", citationTitle:"Cell. 1999 Jul 9;98(1):115-24.", annotationSubgraph:["G-protein-mediated signaling"], pmid:"10412986", citationType:"PubMed", citationRef:"10412986"}}, {start: {_id:516}, end: {_id:267}, properties:{annotationCondition:["Normal Healthy State"], evidence:"variable addressed by our study is the role of reactive oxygen species in activating mitochondrial chaperone-encoding genes. Interactions between these two processes are revealed by the observations that both Paraquat, which leads to accumulation of massive amount of reactive oxygen species and ethidium bromide, which primarily affects the integrity of the mitochondrial genome, activate hsp-60::gfp and the oxidative stress inducible reporter sod-3::gfp", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}, {start: {_id:1750}, end: {_id:1756}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Direct application of MK-4 to mitochondria purified from pink1B9 significantly facilitated ATP production (Fig. 4G).", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1933}, end: {_id:1934}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Unexpectedly, we found that glutamate-induced accumulation of Parkin on mitochondria was promoted by the antioxidant N-acetyl cysteine (NAC), and that co-treatment with NAC facilitated Parkin-associated mitophagy.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1934}, end: {_id:267}, properties:{evidence:"Studies have shown NAC can prevent the effects of mitochondrially- produced ROS (Kulisz et al., 2002; Moreira et al., 2007; Seaton et al., 1997), and we show that NAC clearly reduced cellular ROS levels follow- ing glutamate.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1934}, end: {_id:267}, properties:{evidence:"In addition, we show here that while NAC does inhibit ROS formation, it does not prevent glutamate-induced mitochondrial depolarization.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Reactive oxygen species subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:2108}, end: {_id:44}, properties:{evidence:"Acute morphine produced a marked increase in TH activity and DA turnover in the NAc, concomitantly with increased Nurr1 and Pitx3 expression in the VTA.These effects paralleled decreases in Ago2 expression, which was accompanied by increased Nurr1 and Pitx3, TH activity and normalized TH protein levels in the VTA", citationTitle:"Br J Pharmacol. 2013 Apr;168(8):1889-901. doi: 10.1111/bph.12083.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Ventral Tegmental Area", "Nucleus Accumbens"], annotationConfidence:["High"], pmid:"23215787", citationType:"PubMed", citationRef:"23215787"}}, {start: {_id:2177}, end: {_id:2178}, properties:{evidence:"Inhibition of the cortisol oxidation by 7_-hydroxy-DHEA and 7_-hydroxy-DHEA was competitive with a Ki at 1.85 _ 0.495 and 0.255 _ 0.005 _M, respectively.", pmid:"17467270", citationType:"PubMed", citationRef:"17467270"}}, {start: {_id:2175}, end: {_id:2178}, properties:{evidence:"Inhibition of the cortisol oxidation by 7_-hydroxy-DHEA and 7_-hydroxy-DHEA was competitive with a Ki at 1.85 _ 0.495 and 0.255 _ 0.005 _M, respectively.", pmid:"17467270", citationType:"PubMed", citationRef:"17467270"}}, {start: {_id:2162}, end: {_id:2175}, properties:{evidence:"During treatment a significant rise of 7beta-hydroxy- dehydroepiandrosterone was observed, which persisted 1 week after treatment termination.", pmid:"15857167", citationType:"PubMed", citationRef:"15857167"}}, {start: {_id:2162}, end: {_id:2175}, properties:{evidence:"7beta-hydroxy-dehydroepiandrosterone remained increased for 28 days, 7alpha-hydroxy-dehydroepiandrosterone, testosterone, estradiol and sex hormone-binding globulin were decreased as late as day 63 and 91, respectively. On the other hand, epitestosterone", pmid:"15843221", citationType:"PubMed", citationRef:"15843221"}}, {start: {_id:2162}, end: {_id:2182}, properties:{evidence:"7beta-hydroxy-dehydroepiandrosterone remained increased for 28 days, 7alpha-hydroxy-dehydroepiandrosterone, testosterone, estradiol and sex hormone-binding globulin were decreased as late as day 63 and 91, respectively. On the other hand, epitestosterone", pmid:"15843221", citationType:"PubMed", citationRef:"15843221"}}, {start: {_id:2162}, end: {_id:2183}, properties:{evidence:"Levels of sex steroids, testosterone and estradiol, decreased significantly. LH levels increased significantly, but the increase of androstenedione, SHBG and FSH was not significant. Decreasing tendency close to statistical significance was observed in co", pmid:"11300231", citationType:"PubMed", citationRef:"11300231"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:2162}, end: {_id:2184}, properties:{evidence:"HDL-C and Apo A-I significantly increased at the end of the test period. The atherogenic index (AI, calculated as ratio TC/HDL-C) decreased and this change was strongly significant.", pmid:"11300231", citationType:"PubMed", citationRef:"11300231"}}] AS row
