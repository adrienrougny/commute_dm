UNWIND [{start: {_id:1391}, end: {_id:1392}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we found that mTORC1 activity was enhanced by increasing concentrations of the adenylyl cyclase activator forskolin", citationTitle:"Mol Cell Biol. 2010 Nov;30(22):5406-20. doi: 10.1128/MCB.00217-10. Epub 2010 Sep 13.", annotationSpecies:["9606"], pmid:"20837708", citationType:"PubMed", citationRef:"20837708"}}, {start: {_id:1746}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Heix mutants showed severe mitochondrial defects that were rescued by vitamin K2, and, similar to ubiquinone, vitamin K2 transferred electrons in Drosophila mitochondria, resulting in more efficient adenosine triphosphate (ATP) production.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph", "Vitamin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1746}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Thus, mitochondrial dysfunction was rescued by vitamin K2 that serves as a mitochondrial electron carrier, helping to maintain normal ATP production.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1746}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our data predict that vitamin K2 may also alleviate the defects in other conditions that impair mitochondrial function.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1746}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Heix/UBIAD1 produces vitamin K2, and in our studies vitamin K2 rescued mitochondrial defects in numerous conditions that affect mitochondrial function.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:267}, end: {_id:1982}, properties:{evidence:"Previous studies suggested that NLRP3 inflammasome activity is negatively regulated by autophagy and positively regulated by reactive oxygen species (ROS) derived from an uncharacterized organelle. Here we show that mitophagy/autophagy blockade leads to the accumulation of damaged, ROS-generating mitochondria, and this in turn activates the NLRP3 inflammasome.", citationTitle:"Nature. 2011 Jan 13;469(7329):221-5. doi:10.1038/nature09663. Epub 2010 Dec 1. Erratum in: Nature. 2011 Jul 7;475(7354):122.", annotationSubgraph:["Reactive oxygen species subgraph", "Caspase subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21124315", citationType:"PubMed", citationRef:"21124315"}}, {start: {_id:1980}, end: {_id:1948}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Excessive mitochondrial fission was observed in lentivirus-transfected BV-2 cells stably expressing DsRed2-mito following LPS stimulation. Furthermore, mitochondrial localization of dynamin-related protein 1 (Drp1) (a key regulator of mitochondrial fission) was increased and accompanied by de-phosphorylation of Ser637 in Drp1.", citationTitle:"J Neurochem. 2013 Oct;127(2):221-32. doi: 10.1111/jnc.12361. Epub 2013 Jul 29.", annotationSubgraph:["Mitophagy subgraph"], pmid:"23815397", citationType:"PubMed", citationRef:"23815397"}}, {start: {_id:1980}, end: {_id:1948}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interestingly, inhibition of LPS-induced mitochondrial fission and reactive oxygen species (ROS) generation by Mdivi-1 and Drp1 knock- down attenuated the production of pro-inflammatory mediators via reduced nuclear factor kappa-light-chain-enhancer of activated B cells (NF-kB) and mitogen-activated protein kinase (MAPK) signaling. Our results demonstrated for the first time that mitochondrial fission regulates mitochondrial ROS production in activated microglial cells and influences the expression of pro-inflammatory mediators through the activation of NF-kB and MAPK. We therefore suggest that mitochondrial dynamics may be essential for understanding pro- inflammatory mediator expression in activated microglial cells. This could represent a new therapeutic approach for preventing neurodegenerative diseases.", citationTitle:"J Neurochem. 2013 Oct;127(2):221-32. doi: 10.1111/jnc.12361. Epub 2013 Jul 29.", annotationSubgraph:["Reactive oxygen species subgraph"], pmid:"23815397", citationType:"PubMed", citationRef:"23815397"}}, {start: {_id:2005}, end: {_id:1982}, properties:{annotationCondition:["Normal Healthy State"], evidence:"NLRP3 forms an inflammasome with its adaptor ASC, and its excessive activation can cause inflammatory diseases. However, little is known about the mechanisms that control assembly of the inflammasome complex. Here we show that microtubules mediated assembly of the NLRP3 inflammasome.", citationTitle:"Nat Immunol. 2013 May;14(5):454-60. doi: 10.1038/ni.2550. Epub 2013 Mar 17.", annotationSubgraph:["Caspase subgraph", "Innate immune system subgraph"], pmid:"23502856", citationType:"PubMed", citationRef:"23502856"}}, {start: {_id:2108}, end: {_id:2097}, properties:{evidence:"Acute morphine produced a marked increase in TH activity and DA turnover in the NAc, concomitantly with increased Nurr1 and Pitx3 expression in the VTA.These effects paralleled decreases in Ago2 expression, which was accompanied by increased Nurr1 and Pitx3, TH activity and normalized TH protein levels in the VTA", citationTitle:"Br J Pharmacol. 2013 Apr;168(8):1889-901. doi: 10.1111/bph.12083.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Ventral Tegmental Area", "Nucleus Accumbens"], annotationConfidence:["High"], pmid:"23215787", citationType:"PubMed", citationRef:"23215787"}}, {start: {_id:2162}, end: {_id:2164}, properties:{evidence:"Feeding 7-oxo-DHEA decreased body weight gain of rats, increased liver mass, catalase activity (/67%), and fatty acyl CoA oxidase (/128%) (Table I) as does DHEA (4).", annotationSpecies:["10116"], annotationConfidence:["Very High"], pmid:"9143361", citationType:"PubMed", citationRef:"9143361"}}, {start: {_id:2162}, end: {_id:2168}, properties:{evidence:"7-Oxo-DHEA is more effective than DHEA as an inducer of G-3-P dehydrogenase and of malic enzyme (18) and these enzymes were measured as markers of the response to treatments", annotationSpecies:["10116"], annotationConfidence:["Very High"], pmid:"9143361", citationType:"PubMed", citationRef:"9143361"}}, {start: {_id:2162}, end: {_id:2170}, properties:{evidence:"7-Oxo-DHEA is more effective than DHEA as an inducer of G-3-P dehydrogenase and of malic enzyme (18) and these enzymes were measured as markers of the response to treatments", annotationSpecies:["10116"], annotationConfidence:["Very High"], pmid:"9143361", citationType:"PubMed", citationRef:"9143361"}}, {start: {_id:2162}, end: {_id:2191}, properties:{evidence:"When stressed mice were daily given 7-oxo-DHEA 15 mg.kg-1, lymphocyte proliferative response and the NK cell activity were significantly enhanced and the decreased levels of T3 and T4 were restored in the stressed mice.", pmid:"15040075", citationType:"PubMed", citationRef:"15040075"}}, {start: {_id:2162}, end: {_id:2193}, properties:{evidence:"When stressed mice were daily given 7-oxo-DHEA 15 mg.kg-1, lymphocyte proliferative response and the NK cell activity were significantly enhanced and the decreased levels of T3 and T4 were restored in the stressed mice.", pmid:"15040075", citationType:"PubMed", citationRef:"15040075"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
