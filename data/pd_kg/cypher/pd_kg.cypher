UNWIND [{start: {_id:634}, end: {_id:1716}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Also in fibroblasts obtained from Pink1 mouse mutants expressing mitochondrially targeted yellow fluorescent protein (YFP), no significant alterations in mitochondrial morphology were observed", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph"], annotationCell:["fibroblast"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:634}, end: {_id:369}, properties:{evidence:"Furthermore, notwithstanding the many attempts to place Pink1 in the core machinery regulating mitochondrial fusion, a direct link between levels of Pink1 and rate of mitochondrial fusion has not been demonstrated. Since mitochondrial dysfunction, irrespective of the underlying mechanism, is accompanied by fragmentation of the organelle (Dimmer et al, 2008; Rojo et al, 2002), it is likely that the excess mitochondrial fission caused by ablation of Pink1 under certain experimental conditions is an epiphenomenon of the primary mitochondrial dysfunction sustained by reduced Complex I activity (Fig 7).", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["PINK1 subgraph", "Mitochondria fission subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:1824}, end: {_id:1774}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, the Q165H and R130C variants, which had no enzymatic activity and a residual activity of 60%, respectively, were unable to promote mitochondrial elongation and to mitigate Parkin- dependent mitochondrial clearance.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:138}, end: {_id:103}, properties:{evidence:"Interestingly, siRNA mediated gene silencing of MAOB in cells reduces Abeta production, but not Notch processing.", annotationSubgraph:["Dopaminergic subgraph"], annotationConfidence:["High"], pmid:"18358303", citationType:"PubMed", citationRef:"18358303"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:CAUSES_NO_CHANGE]->(end) SET r += row.properties;
UNWIND [{start: {_id:528}, end: {_id:16}, properties:{evidence:"miR-30a may also target fibroblast growth factor (FGF20), which is targeted by miR-16-2*. In this study, both miR-30a and miR-16-2* showed the highest expression in PD subjects after levodopa treatment.", citationTitle:"J Biotechnol. 2011 Mar 20;152(3):96-101. doi: 10.1016/j.jbiotec.2011.01.023. Epub 2011 Feb 3.", annotationSubgraph:["Neurotrophic subgraph", "miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["blood cell"], pmid:"21295623", citationType:"PubMed", citationRef:"21295623"}}, {start: {_id:526}, end: {_id:16}, properties:{evidence:"miR-30a may also target fibroblast growth factor (FGF20), which is targeted by miR-16-2*. In this study, both miR-30a and miR-16-2* showed the highest expression in PD subjects after levodopa treatment.", citationTitle:"J Biotechnol. 2011 Mar 20;152(3):96-101. doi: 10.1016/j.jbiotec.2011.01.023. Epub 2011 Feb 3.", annotationSubgraph:["Neurotrophic subgraph", "miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["blood cell"], pmid:"21295623", citationType:"PubMed", citationRef:"21295623"}}, {start: {_id:1341}, end: {_id:16}, properties:{evidence:"MIR886 has recently been renamed as Vault RNA 2¬1 (vtRNA2¬1), precursor of svtRNA2¬1a, a small non-coding RNA whose upregulation induces neuronal dysfunction and was reported as an early event in PD pathology.", citationTitle:"RNA Biol. 2013 Jul;10(7):1093-106. doi: 10.4161/rna.24813. Epub 2013 May 1.", annotationSubgraph:["miRNA subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"23673382", citationType:"PubMed", citationRef:"23673382"}}, {start: {_id:1352}, end: {_id:16}, properties:{evidence:"the substantia nigra, striatum where nigral dopaminergic nerve terminals project, and olfactory bulb, which are neural systems affected in PD, have relatively higher miR-7 levels compared with the cerebral cortex and cerebellum, suggesting perhaps that dysregulation of miR-7 in these regions might relate to PD pathogenesis.", citationTitle:"Proc Natl Acad Sci U S A. 2009 Aug 4;106(31):13052-7. doi: 10.1073/pnas.0906277106. Epub 2009 Jul 23.", annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Substantia Nigra"], pmid:"19628698", annotationTranscriptionallyActiveRegion:["3'UTR"], citationType:"PubMed", citationRef:"19628698"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:POSITIVE_CORRELATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:115}, end: {_id:116}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We have previously shown that the transcription factor Sox6 plays an essential role in coordinating muscle fiber type differentiation by acting as a transcriptional suppressor of slow fiber-specific genes.", citationTitle:"Skelet Muscle. 2013 May 10;3(1):11. doi: 10.1186/2044-5040-3-11.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23663701", citationType:"PubMed", citationRef:"23663701"}}, {start: {_id:399}, end: {_id:112}, properties:{annotationCondition:["Normal Healthy State"], evidence:"However, it has been shown that microglial cells play a crucial role in neuroprotection by ROCK inhibition and that activation of microglial ROCK mediates major components of the microglial inflammatory response.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["RhoA subgraph"], annotationMeshanatomy:["Microglia"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:399}, end: {_id:112}, properties:{evidence:"This has been related to the involvement of ROCK in neuroinflammatory processes that play a major role in these diseases .", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["RhoA subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Microglia"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:399}, end: {_id:412}, properties:{evidence:"Furthermore, it has shown that, in PD models, ROCK interacts with several factors that play a major role in dopaminergic neuron degeneration/neuroprotection such as NADPH-oxidase, angiotensin, and estrogen.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["RhoA subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:709}, end: {_id:1169}, properties:{evidence:"In common with Parkinson's disease patients, SWEDDs patients had a slow gait mainly because of a small stride length, as well as a reduced arm swing. However, several abnormal features of posture and gait in Parkinson's disease were normal in SWEDDs. Thus, SWEDDs patients had normal trunk and elbow posture, normal stride length variability, and normal bilateral step-phase coordination, all of which were abnormal in Parkinson's disease patients. We also searched for signs of ataxic movements during normal and tandem walking, but found no evidence that ataxic gait was a general feature in SWEDDs. These findings could aid the clinician in identification of potential tremulous SWEDDs cases.", citationTitle:"Mov Disord. 2011 Jun;26(7):1266-73", annotationMeshdisease:["Parkinson Disease"], pmid:"21442658", citationType:"PubMed", citationRef:"21442658"}}, {start: {_id:1402}, end: {_id:1403}, properties:{evidence:"Upstream of mTOR the survival PI3K/AKT pathway modulates mTOR activity that is also altered in neurodegenerative diseases of Alzheimer and Parkinson. Nevertheless, the interplay between the PI3K/AKT/mTOR pathway and the autophagic process is complex and a more detailed examination of tissue from patients suffering neurodegenerative diseases and of animal and cellular models is needed. In the present work we review the recent findings on the role of the PI3K/AKT/mTOR pathway in the modulation of the autophagic process in neuronal protection.", citationTitle:"Cell Signal. 2014 Dec;26(12):2694-701. doi: 10.1016/j.cellsig.2014.08.019. Epub 2014 Aug 28.", annotationSubgraph:["Akt/mTOR subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"25173700", citationType:"PubMed", citationRef:"25173700"}}, {start: {_id:232}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondria participate in apoptosis through a range of mechanisms that vary between vertebrates and invertebrates. In vertebrates, they release intermembrane space proteins, such as cytochrome c, to promote caspase activation in the cytosol. This process is the result of the loss of integrity of the outer mitochondrial membrane caused by proapoptotic members of the Bcl-2 family. This event is always accompanied by a fissioning of the organelle. Fission of mitochondria has also been reported to participate in apoptosis in Drosophila and Caenorhabditis elegans.", citationTitle:"Dev Cell. 2011 Jul 19;21(1):92-101. doi: 10.1016/j.devcel.2011.06.017.", annotationSubgraph:["Caspase subgraph"], pmid:"21763611", citationType:"PubMed", citationRef:"21763611"}}, {start: {_id:1686}, end: {_id:303}, properties:{evidence:"We identify C18:0 as a regulator of mitochondrial function. Upon loss of C18:0, TFR1 de-stearoylation activates JNK, leading to HUWE1-dependent MFN2 ubiquitination, impaired MFN2 activity19, and mitochondrial fragmentation.", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:749}, end: {_id:1758}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Because mitochondria are involved in aging (21), we reared aged flies on MK-4 or overexpressed Heix but did not observe a significant rescue in mobility", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["Vitamin subgraph"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:749}, end: {_id:1598}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Central to mitochondrial function is oxidative phosphorylation (OXPHOS), accomplished by respiratory chain complexes (RCCs) encoded by nuclear and mitochondrial genomes.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:208}, end: {_id:311}, properties:{evidence:"We provide evidence that physiologically LRRK2, through its kinase activity, regulates mitochondrial fission events and facilitates autophagic degradation by modulating lysosomal cellular localization.", citationTitle:"Mol Neurobiol. 2015 Dec;52(3):1804-20. doi: 10.1007/s12035-014-8980-6. Epub 2014 Nov 15.", annotationSubgraph:["LRRK2 subgraph"], pmid:"25394383", citationType:"PubMed", citationRef:"25394383"}}, {start: {_id:208}, end: {_id:2052}, properties:{evidence:"We provide evidence that physiologically LRRK2, through its kinase activity, regulates mitochondrial fission events and facilitates autophagic degradation by modulating lysosomal cellular localization.", citationTitle:"Mol Neurobiol. 2015 Dec;52(3):1804-20. doi: 10.1007/s12035-014-8980-6. Epub 2014 Nov 15.", annotationSubgraph:["LRRK2 subgraph"], pmid:"25394383", citationType:"PubMed", citationRef:"25394383"}}, {start: {_id:208}, end: {_id:400}, properties:{evidence:"We provide evidence that physiologically LRRK2, through its kinase activity, regulates mitochondrial fission events and facilitates autophagic degradation by modulating lysosomal cellular localization.", citationTitle:"Mol Neurobiol. 2015 Dec;52(3):1804-20. doi: 10.1007/s12035-014-8980-6. Epub 2014 Nov 15.", annotationSubgraph:["LRRK2 subgraph"], pmid:"25394383", citationType:"PubMed", citationRef:"25394383"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:137}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that curcumin protected against A53T √é¬±-synuclein-induced cell death in a dose-dependent manner, suggesting that curcumin may be a candidate neuroprotective agent for A53T √Ö‚Äô√Ç¬±-synuclein-linked Parkinsonism, and possibly for other genetic or sporadic forms of PD.", citationTitle:"Pharmacol Res. 2011 May;63(5):439-44. doi: 10.1016/j.phrs.2011.01.004. Epub 2011 Jan 12.", annotationSubgraph:["Synuclein subgraph"], pmid:"21237271", citationType:"PubMed", citationRef:"21237271"}}] AS row
