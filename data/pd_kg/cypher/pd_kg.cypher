UNWIND [{start: {_id:641}, end: {_id:642}, properties:{annotationCondition:["Normal Healthy State"], evidence:"DNAJC6 encodes the HSP40 Auxilin, a protein which is selectively expressed in neurons and confers specificity to the ATPase activity of its partner Hcs70 in clathrin uncoating.", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Chaperone subgraph"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:649}, end: {_id:650}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The necessary ATPase activity is contributed by Hsc70, which like all Hsp70 homologues, interacts with J-domain containing cochaperones that specify its targets.", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Ubiquitin subgraph", "Chaperone subgraph"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:651}, end: {_id:650}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The necessary ATPase activity is contributed by Hsc70, which like all Hsp70 homologues, interacts with J-domain containing cochaperones that specify its targets.", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Ubiquitin subgraph", "Chaperone subgraph"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:641}, end: {_id:658}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Reduction of Auxilin and its homologue GAK was shown to result in the impairment of CME and of the clathrin-dependent traffic of cargo from the Golgi to the lysosome [14].", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:659}, end: {_id:658}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Reduction of Auxilin and its homologue GAK was shown to result in the impairment of CME and of the clathrin-dependent traffic of cargo from the Golgi to the lysosome [14].", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:641}, end: {_id:663}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Since dopamine receptors undergo CME [25] followed by endosomal sorting to recycling or degradation [26], it is conceivable that a homozygous deleterious mutation in the Auxilin encoding gene, DNAJC6, would give rise to abnormal dopamine receptor metabolism with the resultant parkinsonism.", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:621}, end: {_id:269}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This correlated with increased motor neuron survival, reduced oxidative stress, and attenuated gliosis in the spinal cord, as well as a dramatic decrease in total hSYN(A53T) and phosphorylated (Ser129) hSYN(A53T) in Triton-insoluble aggregates. Furthermore, Nrf2 in astrocytes delayed chaperone-mediated autophagy and macroautophagy dysfunction observed in the hSYN(A53T) mice", citationTitle:"The Journal of neuroscience : the official journal of the Society for Neuroscience; Vol. 32; Iss. 49", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Motor Neurons"], pmid:"23223297", citationType:"PubMed", citationRef:"23223297"}}, {start: {_id:621}, end: {_id:400}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our data suggest that Nrf2 in astrocytes provides neuroprotection against hSYN(A53T)-mediated toxicity by promoting the degradation of hSYN(A53T) through the autophagy-lysosome pathway in vivo.", citationTitle:"The Journal of neuroscience : the official journal of the Society for Neuroscience; Vol. 32; Iss. 49", annotationSubgraph:["Notch signaling subgraph"], annotationMeshanatomy:["Motor Neurons"], pmid:"23223297", citationType:"PubMed", citationRef:"23223297"}}, {start: {_id:137}, end: {_id:708}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Alpha-synucleins are involved in the maintenance of the synaptic vesicle pool and in the regulation of dopamine biosynthesis, homeostasis and proteasome activities.", citationTitle:"Biochemical and biophysical research communications; Vol. 441; Iss. 2", annotationSubgraph:["Synuclein subgraph", "Dopaminergic subgraph"], pmid:"24140056", citationType:"PubMed", citationRef:"24140056"}}, {start: {_id:137}, end: {_id:710}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Alpha-synucleins are involved in the maintenance of the synaptic vesicle pool and in the regulation of dopamine biosynthesis, homeostasis and proteasome activities.", citationTitle:"Biochemical and biophysical research communications; Vol. 441; Iss. 2", annotationSubgraph:["Synuclein subgraph"], pmid:"24140056", citationType:"PubMed", citationRef:"24140056"}}, {start: {_id:422}, end: {_id:269}, properties:{evidence:"Linkage and candidate gene analysis identified the p.R1205H mutation in EIF4G1, encoding a component of the eIF4F translation initiation complex that regulates cell survival in response to stressors, in a large French family with AD late-onset PD and 7 smaller families of various origin, probably resulting from an ancestral founder ( Chartier-Harlin et al., 2011).", citationTitle:"Neurobiology of aging; Vol. 33; Iss. 9", annotationSubgraph:["Pre-translational events"], annotationMeshdisease:["Parkinson Disease"], pmid:"22658323", citationType:"PubMed", citationRef:"22658323"}}, {start: {_id:203}, end: {_id:723}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Indeed, it has been shown that LRRK2 is crucial for regulation of neurite formation and length [25].", citationTitle:"Oxid Med Cell Longev. 2013;2013:817807. doi: 10.1155/2013/817807. Epub 2013 Mar 14.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["fibroblast"], annotationMeshanatomy:["Mitochondria"], pmid:"23577227", citationType:"PubMed", citationRef:"23577227"}}, {start: {_id:641}, end: {_id:730}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Defective auxilin causing parkinsonism is in line with parkinsonism often being an endosomal disorder commonly related to CCVs and synaptic vesicle recycling.", citationTitle:"Parkinsonism & related disorders; Vol. 19; Iss. 3", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23211418", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"23211418"}}, {start: {_id:761}, end: {_id:762}, properties:{evidence:"Furthermore, the homozygous missense mutations, F182L and G504R, promote the proteasomal degradation of ATP13A2 consistent with their reduced protein stability.", citationTitle:"PLoS One. 2012;7(6):e39942. doi: 10.1371/journal.pone.0039942. Epub 2012 Jun 29.", annotationSubgraph:["ATP13A2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22768177", citationType:"PubMed", citationRef:"22768177"}}, {start: {_id:764}, end: {_id:762}, properties:{evidence:"Furthermore, the homozygous missense mutations, F182L and G504R, promote the proteasomal degradation of ATP13A2 consistent with their reduced protein stability.", citationTitle:"PLoS One. 2012;7(6):e39942. doi: 10.1371/journal.pone.0039942. Epub 2012 Jun 29.", annotationSubgraph:["ATP13A2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22768177", citationType:"PubMed", citationRef:"22768177"}}, {start: {_id:297}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Overexpression of the Ala53Thr a-synuclein induced apoptosis and enhanced toxicity of the dopamine uptake-dependent neurotoxin 6-hydroxydopamine (6-OHDA); whereas WT a-synuclein was not intrinsically neurotoxic, but increased sensitivity to 6-OHDA.", citationTitle:"Pharmacol Ther. 2005 Mar;105(3):311-31. Epub 2004 Dec 8.", annotationSubgraph:["Synuclein subgraph"], pmid:"15737408", citationType:"PubMed", citationRef:"15737408"}}, {start: {_id:203}, end: {_id:358}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Another study showed that overexpression of wild-type and LRRK2 (G2019S) in C. elegans was protective against rotenone toxicity while knockdown of endogenous LRK-1 by RNAi potentiated toxicity, suggesting a role for LRRK2 in mitochondrial regulation (Wolozin et al. 2008).", citationTitle:"J Neurosci Res. 2009 May 1;87(6):1283-95. doi: 10.1002/jnr.21949.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19025767", citationType:"PubMed", citationRef:"19025767"}}, {start: {_id:221}, end: {_id:575}, properties:{evidence:"Cell culture studies suggest that PINK1 is mitochondrially located and may exert a protective effect on the cell that is abrogated by the mutations, resulting in increased susceptibility to cellular stress. These data provide a direct molecular link between mitochondria and the pathogenesis of PD.", citationTitle:"Science. 2004 May 21;304(5674):1158-60. Epub 2004 Apr 15.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15087508", citationType:"PubMed", citationRef:"15087508"}}, {start: {_id:834}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The C106S mutant of DJ-1, which is a substitution mutant of DJ-1 at amino acid 106 from cysteine to serine, possesses little or no protective activity against neuronal cell death induced by oxidative stress (4‚Äì8), and abnormally oxidized forms of DJ-1 have been observed in patients with sporadic forms of Parkinson's disease (9)", citationTitle:"Mol Cell Biol. 2013 Jan;33(2):340-59. doi: 10.1128/MCB.01350-12. Epub 2012 Nov 12.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["neuron"], pmid:"23149933", citationType:"PubMed", citationRef:"23149933"}}, {start: {_id:839}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"On the other hand, the other stressors, such as UV exposure and doxorubicin treatment, did not alter the DUSP1 gene expression level, while the expression levels of NOXA and p21 were increased at 0.5 to 6 h after UV exposure and doxorubicin treatment (Fig. 5A to ‚ÄãtoD),D), suggesting that the DUSP1 gene is a primary target of p53 against oxidative stress", citationTitle:"Mol Cell Biol. 2013 Jan;33(2):340-59. doi: 10.1128/MCB.01350-12. Epub 2012 Nov 12.", annotationSubgraph:["Apoptosis signaling subgraph", "Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23149933", citationType:"PubMed", citationRef:"23149933"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:614}, end: {_id:842}, properties:{evidence:"In contrast to the L166P mutation that is linked to ubiquitination and increased proteasomal degradation [Miller et al., 2003; Olzmann et al., 2004], we found no evidence for ubiquitination of E64D mutant DJ1(data not shown).", citationTitle:"Hum Mutat. 2004 Oct;24(4):321-9.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15365989", citationType:"PubMed", citationRef:"15365989"}}, {start: {_id:614}, end: {_id:762}, properties:{evidence:"In contrast to the L166P mutation that is linked to ubiquitination and increased proteasomal degradation [Miller et al., 2003; Olzmann et al., 2004], we found no evidence for ubiquitination of E64D mutant DJ1(data not shown).", citationTitle:"Hum Mutat. 2004 Oct;24(4):321-9.", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15365989", citationType:"PubMed", citationRef:"15365989"}}, {start: {_id:58}, end: {_id:57}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Accumulating evidence indicates that insulin-like growth factor-1 (IGF1) acts as a homeostatic modulator for normal brain functionality and synaptic plasticity, and the loss of IGF1 activity caused by diabetes may contribute to cognitive impairment [6]. Most biological functions of IGF1, including its anti-apoptotic function, are mediated by the insulin-like growth factor-1 receptor (IGF1R).", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:58}, end: {_id:55}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Accumulating evidence indicates that insulin-like growth factor-1 (IGF1) acts as a homeostatic modulator for normal brain functionality and synaptic plasticity, and the loss of IGF1 activity caused by diabetes may contribute to cognitive impairment [6]. Most biological functions of IGF1, including its anti-apoptotic function, are mediated by the insulin-like growth factor-1 receptor (IGF1R).", citationTitle:"PLoS One. 2014 Sep 30;9(9):e108559. doi: 10.1371/journal.pone.0108559. eCollection 2014.", annotationSubgraph:["Insulin signal transduction"], pmid:"25268761", citationType:"PubMed", citationRef:"25268761"}}, {start: {_id:934}, end: {_id:54}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we investigate the role of Hepatocyte growth factor-Regulated tyrosine kinase Substrate (Hrs), a regulator of RTK trafficking, in VEGF and insulin signaling. We report that ectopic expression of Hrs increases VEGF-R2 and IR number and tyrosine phosphorylation, leading to amplification of their downstream signaling. The UIM (Ubiquitin Interacting Motif) domain of Hrs is required for Hrs-induced increases in VEGF-R2, but not in IR. Furthermore, Hrs is tyrosine-phosphorylated in response to VEGF and insulin. We show that the UIM domain is required for Hrs phosphorylation in response to VEGF, but not to insulin. Importantly, Hrs co-localizes with both VEGF-R2 and IR and co-immunoprecipitates with both in a manner independent of the Hrs-UIM domain. Finally, we demonstrate that Hrs inhibits Nedd4-mediated VEGF-R2 degradation and acts additively with Grb10. We conclude that Hrs is a positive regulator of VEGF-R2 and IR signaling and that ectopic expression of Hrs protects both VEGF-R2 and IR from degradation.", citationTitle:"Exp Cell Res. 2007 May 15;313(9):1927-42. Epub 2007 Mar 21.", annotationSubgraph:["Cytokine signaling subgraph", "Vascular endothelial growth factor subgraph"], pmid:"17445799", citationType:"PubMed", citationRef:"17445799"}}, {start: {_id:940}, end: {_id:939}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we investigate the role of Hepatocyte growth factor-Regulated tyrosine kinase Substrate (Hrs), a regulator of RTK trafficking, in VEGF and insulin signaling. We report that ectopic expression of Hrs increases VEGF-R2 and IR number and tyrosine phosphorylation, leading to amplification of their downstream signaling. The UIM (Ubiquitin Interacting Motif) domain of Hrs is required for Hrs-induced increases in VEGF-R2, but not in IR. Furthermore, Hrs is tyrosine-phosphorylated in response to VEGF and insulin. We show that the UIM domain is required for Hrs phosphorylation in response to VEGF, but not to insulin. Importantly, Hrs co-localizes with both VEGF-R2 and IR and co-immunoprecipitates with both in a manner independent of the Hrs-UIM domain. Finally, we demonstrate that Hrs inhibits Nedd4-mediated VEGF-R2 degradation and acts additively with Grb10. We conclude that Hrs is a positive regulator of VEGF-R2 and IR signaling and that ectopic expression of Hrs protects both VEGF-R2 and IR from degradation.", citationTitle:"Exp Cell Res. 2007 May 15;313(9):1927-42. Epub 2007 Mar 21.", annotationSubgraph:["Vascular endothelial growth factor subgraph"], pmid:"17445799", citationType:"PubMed", citationRef:"17445799"}}, {start: {_id:955}, end: {_id:960}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We find that TREK1, typically considered to be a leak channel, contributes to the hippocampal GABA(B) response.", citationTitle:"Neuron. 2012 Jun 21;74(6):1005-14. doi: 10.1016/j.neuron.2012.04.026.", annotationSubgraph:["Transport related subgraph"], annotationMeshanatomy:["Hippocampus"], pmid:"22726831", citationType:"PubMed", citationRef:"22726831"}}, {start: {_id:961}, end: {_id:971}, properties:{annotationBrco:["Spinal motor neuron"], annotationCondition:["Normal Healthy State"], evidence:"The glial cell line-derived neurotrophic factor (GDNF) signalling pathway has been associated with neuroprotective effects in central dopaminergic neurons and spinal motor neurons. Clinical trials have also investigated whether GDNF may ameliorate Parkinson's disease symptoms.", citationTitle:"Psychopharmacology (Berl). 2010 Jun;210(3):347-54. doi: 10.1007/s00213-010-1829-4. Epub 2010 Apr 6.", annotationSpecies:["9606"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"20369355", citationType:"PubMed", citationRef:"20369355"}}, {start: {_id:994}, end: {_id:996}, properties:{evidence:"Alzheimer's disease (AD) is the most common neurodegenerative disease, and is clinically characterized by cognitive disturbances and the accumulation of the amyloid âˆšÃ©Â¬â‰¤ (AâˆšÃ©Â¬â‰¤) peptides in plaques in the brain. Recent studies have shown the links between AD and the immediate-early gene Arc (activity-regulated cytoskeleton- associated protein), involved in synaptic plasticity and memory consolidation. For example, AD mouse models show a decreased expression of Arc mRNA in the brain.", citationTitle:"J Neural Transm. 2012 Jul;119(7):833-42. doi: 10.1007/s00702-012-0823-x. Epub 2012 May 25.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Alzheimer Disease"], pmid:"22622366", citationType:"PubMed", citationRef:"22622366"}}, {start: {_id:994}, end: {_id:997}, properties:{evidence:"Alzheimer's disease (AD) is the most common neurodegenerative disease, and is clinically characterized by cognitive disturbances and the accumulation of the amyloid âˆšÃ©Â¬â‰¤ (AâˆšÃ©Â¬â‰¤) peptides in plaques in the brain. Recent studies have shown the links between AD and the immediate-early gene Arc (activity-regulated cytoskeleton- associated protein), involved in synaptic plasticity and memory consolidation. For example, AD mouse models show a decreased expression of Arc mRNA in the brain.", citationTitle:"J Neural Transm. 2012 Jul;119(7):833-42. doi: 10.1007/s00702-012-0823-x. Epub 2012 May 25.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Alzheimer Disease"], pmid:"22622366", citationType:"PubMed", citationRef:"22622366"}}, {start: {_id:1012}, end: {_id:1013}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Apolipoprotein E (APOE) seems to be the most important mediator of this recycling process, but also other lipoproteins have been implicated, e.g. apolipoproteins J and D. The thrifty nature of cholesterol homeostasis in the brain is most probably a consequence of the low rate of de novo cholesterol synthesis in the adult brain, most of which is believed to occur in glial cells. Neurons are believed to have a very low rate of cholesterol synthesis and meet their cholesterol requirements via uptake of cholesterol carried in APOE- containing lipoproteins secreted from glial cells ( Pfrieger, 2003). Accumulating epidemiological and molecular evidence indicates that there is a clear link between cholesterol turnover and neurodegenerative diseases âˆšÂ¢â€šÃ‡Â¨â€šÃ„Ãº hypercholesterolemia per-se is an important risk factor for AlzheimerâˆšÂ¢â€šÃ‡Â¨â€šÃ‘Â¢s disease (AD) and ParkinsonâˆšÂ¢â€šÃ‡Â¨â€šÃ‘Â¢s disease and the presence of an APOE âˆšÃ©Â¬Âµ4 allele is the most well described genetic risk factor for late onset AD (LOAD).", citationTitle:"Mol Aspects Med. 2009 Jun;30(3):171-9. doi: 10.1016/j.mam.2009.02.001. Epub 2009 Feb 25.", annotationSubgraph:["APOE subgraph", "Cholesterol metabolism subgraph"], annotationSpecies:["10116"], pmid:"19248803", citationType:"PubMed", citationRef:"19248803"}}, {start: {_id:1009}, end: {_id:1027}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found the down-regulation of Arc of special interest. Arc isexpressed predominantly in cortical and hippocampal glutaminer- gic neurons and it is required for the maintenance of long-term potentiation (LTP) and for memory consolidation (15, 26, 28, 45). It has been shown that Arc levels are increased during learning and memory training (48). In contrast, a decrease in Arc expression was found in AD brains (12) and in transgenic mice over-expressing human amyloid precursor protein (APP", citationTitle:"Brain Pathol. 2009 Jan;19(1):69-80. doi: 10.1111/j.1750-3639.2008.00174.x. Epub 2008 May 23.", annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], pmid:"18503570", citationType:"PubMed", citationRef:"18503570"}}, {start: {_id:1009}, end: {_id:997}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found the down-regulation of Arc of special interest. Arc isexpressed predominantly in cortical and hippocampal glutaminer- gic neurons and it is required for the maintenance of long-term potentiation (LTP) and for memory consolidation (15, 26, 28, 45). It has been shown that Arc levels are increased during learning and memory training (48). In contrast, a decrease in Arc expression was found in AD brains (12) and in transgenic mice over-expressing human amyloid precursor protein (APP", citationTitle:"Brain Pathol. 2009 Jan;19(1):69-80. doi: 10.1111/j.1750-3639.2008.00174.x. Epub 2008 May 23.", annotationSpecies:["10116"], annotationMeshanatomy:["Hippocampus"], pmid:"18503570", citationType:"PubMed", citationRef:"18503570"}}, {start: {_id:1019}, end: {_id:57}, properties:{evidence:"The progressive memory loss observed in Alzheimer's disease (AD) is accompanied by an increase in the levels of amyloid-beta peptide (Abeta) and a block of synaptic plasticity. Both synaptic plasticity and memory require changes in the expression of synaptic proteins such as the activity-regulated cytoskeleton-associated protein, Arc (also termed Arg3.1). Using a model of synaptic plasticity in which BDNF increases Arc expression in cultured cortical neurons, we have found that an oligomeric form of Abeta strongly inhibits the BDNF-induced increase of Arc expression. Given that Abeta oligomers are likely to be involved in the synaptic dysfunction and cognitive impairment observed in amyloid depositing mouse models, we hypothesize that inhibition of Arc induction by BDNF contributes to the synaptic and memory deficits at early stages of AD.", citationTitle:"Curr Alzheimer Res. 2007 Dec;4(5):518-21.", annotationMeshdisease:["Alzheimer Disease"], pmid:"18220514", citationType:"PubMed", citationRef:"18220514"}}, {start: {_id:1009}, end: {_id:57}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Brain-derived neurotrophic factor (BDNF) is well known to be capable of inducing the synthesis of activity-regulated cytoskeleton- associated protein (Arc), which plays a fundamental role in modulating synaptic plasticity.", citationTitle:"J Neurosci Res. 2009 Aug 1;87(10):2297-307. doi: 10.1002/jnr.22057.", pmid:"19301428", citationType:"PubMed", citationRef:"19301428"}}, {start: {_id:1046}, end: {_id:1048}, properties:{annotationCondition:["Normal Healthy State"], evidence:"a new member of the F-box family, Pof14, which forms a canonical, F-box dependent SCF (Skp1, Cullin, F-box protein) ubiquitin ligase complex. The Pof14 protein has intrinsic instability that is abolished by inactivation of its Skp1 interaction motif (the F-box), Skp1 or the proteasome, indicating that Pof14 stability is controlled by an autocatalytic mechanism. Pof14 interacts with the squalene synthase Erg9, a key enzyme in ergosterol metabolism, in a membrane-bound complex that does not contain the core SCF components. pof14 transcription is induced by hydrogen peroxide and requires the Pap1 transcription factor and the Sty1 MAP kinase. Pof14 binds to and decreases Erg9 activity in vitro and a pof14 deletion strain quickly loses viability in the presence of hydrogen peroxide due to its inability to repress ergosterol synthesis. A pof14 mutant lacking the F-box and an skp1-3 ts mutant behave as wild type in the presence of oxidant showing that Pof14 function is independent of SCF. This indicates that modulation of ergosterol level plays a key role in adaptation to oxidative stress.", citationTitle:"EMBO J. 2006 Oct 4;25(19):4547-56. Epub 2006 Sep 14.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"17016471", citationType:"PubMed", citationRef:"17016471"}}, {start: {_id:1064}, end: {_id:1065}, properties:{evidence:"In the Fyn knockout mice, the dopamine D1 receptor agonist failed to induce subcellular redistribution of NMDA receptors.", citationComment:"Dopamine D1-dependent trafficking of striatal N-methyl-D-aspartate glutamate receptors requires Fyn protein tyrosine kinase but not DARPP-32.", citationTitle:"Molecular pharmacology; Vol. 65; Iss. 1", annotationSubgraph:["Phosphatidylinositol 3 subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2004-01-01", pmid:"14722243", citationAuthorList:"Anthone W Dunah|Ana C Sirianni|Allen A Fienberg|Elena Bastia|Michael A Schwarzschild|David G Standaert", citationType:"PubMed", citationRef:"14722243"}}, {start: {_id:271}, end: {_id:941}, properties:{evidence:"Furthermore, EGFR endocytosis and degradation are accelerated in parkin-deficient cells, and EGFR signalling via the phosphoinositide 3-kinase (PI(3)K)-Akt pathway is reduced in parkin knockout mouse brain.", citationComment:"A regulated interaction with the UIM protein Eps15 implicates parkin in EGF receptor trafficking and PI(3)K-Akt signalling.", citationTitle:"Nature cell biology; Vol. 8; Iss. 8", annotationSubgraph:["Regulation of cytoskeleton subgraph", "Ubiquitin subgraph"], annotationSpecies:["10090"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Brain"], citationPubDate:"2006-08-01", pmid:"16862145", citationAuthorList:"Lara Fallon|Catherine M L BâˆšÂ©langer|Amadou T Corera|Maria Kontogiannea|Elsa Regan-Klapisz|France Moreau|Jarno Voortman|Michael Haber|GeneviâˆšÂ®ve Rouleau|Thorhildur Thorarinsdottir|Alexis Brice|Paul M P van Bergen En Henegouwen|Edward A Fon", citationType:"PubMed", citationRef:"16862145"}}, {start: {_id:1099}, end: {_id:269}, properties:{annotationCondition:["Normal Healthy State"], evidence:"This neuroprotection was accompanied by increased Akt phosphorylation (p-Akt).", citationTitle:"Proceedings of the National Academy of Sciences of the United States of America; Vol. 104; Iss. 36", annotationSubgraph:["G-protein-mediated signaling"], annotationConfidence:["Very High"], pmid:"17726113", citationType:"PubMed", citationRef:"17726113"}}, {start: {_id:1103}, end: {_id:270}, properties:{evidence:"Increased FAF1 levels induced cell death and significantly potentiated toxic effects of PD-related stressors including, oxidative stress, mitochondrial complex I inhibition and proteasome dysfunction.", citationComment:"Fas-associated factor 1 and Parkinson's disease.", citationTitle:"Neurobiology of disease; Vol. 31; Iss. 3", annotationSubgraph:["Apoptosis signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], citationPubDate:"2008-09-01", pmid:"18573343", citationAuthorList:"Ranjita Betarbet|Leah R Anderson|Marla Gearing|Tiffany R Hodges|Jason J Fritz|James J Lah|Allan I Levey", citationType:"PubMed", citationRef:"18573343"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1134}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Furthermore, we found that FAF1 deficiency blocked PD-linked biochemical events, including caspase activation, ROS generation, JNK activation and cell death.", citationComment:"Accumulation of the parkin substrate, FAF1, plays a key role in the dopaminergic neurodegeneration.", citationTitle:"Human molecular genetics; Vol. 22; Iss. 8", annotationSubgraph:["Apoptosis signaling subgraph"], citationPubDate:"2013-04-15", pmid:"23307929", citationAuthorList:"Jee-Won Sul|Min-Young Park|Juhee Shin|Young-Ran Kim|Sung-Eun Yoo|Young-Yun Kong|Ki-Sun Kwon|Young Ho Lee|Eunhee Kim", citationType:"PubMed", citationRef:"23307929"}}, {start: {_id:1141}, end: {_id:584}, properties:{evidence:"In the present investigation, we demonstrate that GMF-deficiency in astrocytes upregulates the antioxidant status and limit the extent of lipid peroxidation and production of reactive oxygen species (ROS) along with diminished nuclear factor-Å’âˆ«B-mediated inflammatory responses in 1-methyl-4-phenylpyridinium (MPP(+))-induced toxicity.", citationComment:"Glia maturation factor deficiency suppresses 1-methyl-4-phenylpyridinium-induced oxidative stress in astrocytes. [Copy from Id 381 at Mon Apr 20 15:44:56 CEST 2015]", citationTitle:"Journal of molecular neuroscience : MN; Vol. 53; Iss. 4", annotationSubgraph:["Lipid metabolism subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Astrocytes"], citationPubDate:"2014-08-01", pmid:"24430624", citationAuthorList:"Mohammad Moshahid Khan|Duraisamy Kempuraj|Smita Zaheer|Asgar Zaheer", citationType:"PubMed", citationRef:"24430624"}}, {start: {_id:1166}, end: {_id:535}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The over-expression of OBCAM increased the cell size of type-1 astrocytes. Moreover, intense expression of OBCAM was observed on reactive astrocytes in the injured cerebrum in vivo. These results suggest that OBCAM is responsible for controlling the cell proliferation and growth in cortical astrocytes.", citationTitle:"J Neurochem. 2010 Feb;112(3):818-28. doi: 10.1111/j.1471-4159.2009.06513.x. Epub 2009 Nov 27.; Iss. 1", annotationSubgraph:["Cell cycle subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"19943852", citationType:"PubMed", citationRef:"19943852"}}, {start: {_id:1166}, end: {_id:552}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The over-expression of OBCAM increased the cell size of type-1 astrocytes. Moreover, intense expression of OBCAM was observed on reactive astrocytes in the injured cerebrum in vivo. These results suggest that OBCAM is responsible for controlling the cell proliferation and growth in cortical astrocytes.", citationTitle:"J Neurochem. 2010 Feb;112(3):818-28. doi: 10.1111/j.1471-4159.2009.06513.x. Epub 2009 Nov 27.; Iss. 1", annotationSubgraph:["Cell cycle subgraph"], annotationMeshanatomy:["Astrocytes"], pmid:"19943852", citationType:"PubMed", citationRef:"19943852"}}, {start: {_id:1012}, end: {_id:1230}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Estradiol increased astrocyte density and olfactory epithelium (OE) thickness regardless of the genotype. In addition estradiol treatment increased the number of mature neurons in the OE and glomerular synaptophysin in both genotypes, but the magnitude of increase was greater in the WT than in the KO mice. These data suggest that estrogen and apoE act synergistically to minimize the loss of mature sensory neurons and synapses following ovariectomy.", citationTitle:"Exp Neurol. 2012 Sep;237(1):1-7. doi: 10.1016/j.expneurol.2012.06.001. Epub 2012 Jun 9.", annotationSubgraph:["APOE subgraph"], pmid:"22691461", citationType:"PubMed", citationRef:"22691461"}}, {start: {_id:1142}, end: {_id:62}, properties:{evidence:"In accordance with previous immunohistochemical analysis, the NF-Å’âˆ«B level in the nigrostriatal dopaminergic regions was significantly higher in parkinsonian patients than in the controls (P < 0.05). These data suggest that the significant increase in the levels of p53 protein, interferon-Å’â‰¥, and NF-Å’âˆ«B reflect apoptosis and the inflammatory state in the parkinsonian brain and that their elevation is involved in the degeneration of the nigrostriatal dopaminergic neurons.", citationTitle:"Neurosci Lett. 2007 Feb 27;414(1):94-7. Epub 2006 Dec 29.", annotationSubgraph:["Nuclear factor Kappa beta subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"17196747", citationType:"PubMed", citationRef:"17196747"}}, {start: {_id:1380}, end: {_id:62}, properties:{evidence:"In accordance with previous immunohistochemical analysis, the NF-Å’âˆ«B level in the nigrostriatal dopaminergic regions was significantly higher in parkinsonian patients than in the controls (P < 0.05). These data suggest that the significant increase in the levels of p53 protein, interferon-Å’â‰¥, and NF-Å’âˆ«B reflect apoptosis and the inflammatory state in the parkinsonian brain and that their elevation is involved in the degeneration of the nigrostriatal dopaminergic neurons.", citationTitle:"Neurosci Lett. 2007 Feb 27;414(1):94-7. Epub 2006 Dec 29.", annotationSubgraph:["Interferon signaling subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"17196747", citationType:"PubMed", citationRef:"17196747"}}, {start: {_id:781}, end: {_id:62}, properties:{evidence:"In accordance with previous immunohistochemical analysis, the NF-Å’âˆ«B level in the nigrostriatal dopaminergic regions was significantly higher in parkinsonian patients than in the controls (P < 0.05). These data suggest that the significant increase in the levels of p53 protein, interferon-Å’â‰¥, and NF-Å’âˆ«B reflect apoptosis and the inflammatory state in the parkinsonian brain and that their elevation is involved in the degeneration of the nigrostriatal dopaminergic neurons.", citationTitle:"Neurosci Lett. 2007 Feb 27;414(1):94-7. Epub 2006 Dec 29.", annotationSubgraph:["Cell cycle subgraph"], annotationSpecies:["9606"], annotationMeshdisease:["Parkinson Disease"], pmid:"17196747", citationType:"PubMed", citationRef:"17196747"}}, {start: {_id:1400}, end: {_id:1401}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Meteorin and its homologue meteorin-like (metrnl) are two novel proteins regulating glial cell differentiation in central nervous system. Overexpression of meteorin and metrnl further magnified the phosphorylation of Akt upon insulin stimuli in 3T3-L1 cells.", citationTitle:"Biochem Biophys Res Commun. 2013 Jul 13. pii: S0006-291X(13)01148-0. doi: 10.1016/j.bbrc.2013.07.008", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], pmid:"23860268", citationType:"PubMed", citationRef:"23860268"}}, {start: {_id:1399}, end: {_id:1401}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Meteorin and its homologue meteorin-like (metrnl) are two novel proteins regulating glial cell differentiation in central nervous system. Overexpression of meteorin and metrnl further magnified the phosphorylation of Akt upon insulin stimuli in 3T3-L1 cells.", citationTitle:"Biochem Biophys Res Commun. 2013 Jul 13. pii: S0006-291X(13)01148-0. doi: 10.1016/j.bbrc.2013.07.008", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["9606"], pmid:"23860268", citationType:"PubMed", citationRef:"23860268"}}, {start: {_id:1404}, end: {_id:269}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The neurotoxin 1-methyl-4-phenyl-1,2,3,6-tetrahydropyridine (MPTP) impairs mitochondrial respiration and damages dopaminergic neurons as seen in Parkinson's disease (PD). Here, we report that L-3-hydroxyacyl-CoA dehydrogenase type II/amyloid binding alcohol dehydrogenase (HADH II/ABAD), a mitochondrial oxidoreductase enzyme involved in neuronal survival, is downregulated in PD patients and in MPTP-intoxicated mice.", citationTitle:"Ann Neurol. 2004 Jul;56(1):51-60.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"15236401", citationType:"PubMed", citationRef:"15236401"}}, {start: {_id:1404}, end: {_id:1408}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In this paper, we describe the development of a fluorogenic substrate for 17beta-hydroxysteroid-dehydrogenase type 10 (17beta-HSD10), which is a multifunctional metabolic enzyme fulfilling several metabolic roles (beta-oxidation of fatty acids, catabolism of isoleucine, and metabolism of steroids).", citationTitle:"J Am Chem Soc. 2007 Nov 21;129(46):14518-22. Epub 2007 Oct 25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"17958419", citationType:"PubMed", citationRef:"17958419"}}, {start: {_id:1404}, end: {_id:1409}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In this paper, we describe the development of a fluorogenic substrate for 17beta-hydroxysteroid-dehydrogenase type 10 (17beta-HSD10), which is a multifunctional metabolic enzyme fulfilling several metabolic roles (beta-oxidation of fatty acids, catabolism of isoleucine, and metabolism of steroids).", citationTitle:"J Am Chem Soc. 2007 Nov 21;129(46):14518-22. Epub 2007 Oct 25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"17958419", citationType:"PubMed", citationRef:"17958419"}}, {start: {_id:1404}, end: {_id:1410}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In this paper, we describe the development of a fluorogenic substrate for 17beta-hydroxysteroid-dehydrogenase type 10 (17beta-HSD10), which is a multifunctional metabolic enzyme fulfilling several metabolic roles (beta-oxidation of fatty acids, catabolism of isoleucine, and metabolism of steroids).", citationTitle:"J Am Chem Soc. 2007 Nov 21;129(46):14518-22. Epub 2007 Oct 25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"17958419", citationType:"PubMed", citationRef:"17958419"}}, {start: {_id:1382}, end: {_id:1389}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PDE4D binds Rheb in a noncatalytic manner that does not require its cAMP-hydrolyzing activity and thereby inhibits the ability of Rheb to activate mTORC1. However, elevated cAMP levels disrupt the interaction of PDE4D with Rheb and increase the interaction between Rheb and mTOR. This enhanced Rheb-mTOR interaction induces the activation of mTORC1 and cap-dependent translation, a cellular function of mTORC1. Taken together, our results suggest a novel regulatory mechanism for mTORC1 in which the cAMP-determined dynamic interaction between Rheb and PDE4D provides a key, unique regulatory event. We also propose a new role for PDE4 as a molecular transducer for cAMP signaling.", citationTitle:"Mol Cell Biol. 2010 Nov;30(22):5406-20. doi: 10.1128/MCB.00217-10. Epub 2010 Sep 13.", annotationSubgraph:["Cyclic AMP subgraph", "Cell cycle subgraph"], pmid:"20837708", citationType:"PubMed", citationRef:"20837708"}}, {start: {_id:271}, end: {_id:1414}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Protection was abrogated by the proteasome inhibitor epoxomicin and disease-causing variants, indicating that it was mediated by the E3 ubiquitin ligase activity of Parkin.", citationTitle:"Hum Mol Genet. 2003 Mar 1;12(5):517-26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"12588799", citationType:"PubMed", citationRef:"12588799"}}, {start: {_id:271}, end: {_id:1426}, properties:{evidence:"Mitochondrial depolarization promotes Parkin- and PTEN-induced kinase 1 (PINK1)-dependent polyubiquitination of multiple proteins on mitochondrial outer membranes, resulting in the removal of defective mitochondria via mitophagy.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1538-53. doi: 10.1016/j.celrep.2014.10.046. Epub 2014 Nov 13.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456142", citationType:"PubMed", citationRef:"25456142"}}, {start: {_id:221}, end: {_id:1426}, properties:{evidence:"Mitochondrial depolarization promotes Parkin- and PTEN-induced kinase 1 (PINK1)-dependent polyubiquitination of multiple proteins on mitochondrial outer membranes, resulting in the removal of defective mitochondria via mitophagy.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1538-53. doi: 10.1016/j.celrep.2014.10.046. Epub 2014 Nov 13.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456142", citationType:"PubMed", citationRef:"25456142"}}, {start: {_id:271}, end: {_id:1427}, properties:{evidence:"These data suggest that similar to other sensors of cell stress, such as p53, Parkin has cytoprotective (mitophagy) or cytotoxic modes (apoptosis), depending on the degree of mitochondrial damage.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1538-53. doi: 10.1016/j.celrep.2014.10.046. Epub 2014 Nov 13.", annotationSubgraph:["Ubiquitin subgraph", "Apoptosis signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456142", citationType:"PubMed", citationRef:"25456142"}}, {start: {_id:271}, end: {_id:62}, properties:{evidence:"These data suggest that similar to other sensors of cell stress, such as p53, Parkin has cytoprotective (mitophagy) or cytotoxic modes (apoptosis), depending on the degree of mitochondrial damage.", citationTitle:"Cell Rep. 2014 Nov 20;9(4):1538-53. doi: 10.1016/j.celrep.2014.10.046. Epub 2014 Nov 13.", annotationSubgraph:["Ubiquitin subgraph", "Apoptosis signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25456142", citationType:"PubMed", citationRef:"25456142"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1431}, end: {_id:1433}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Bcl-2 family proteins regulate mitochondrial outer membrane permeabilization during apoptosis and can also influence macroautophagy via interactions with Beclin-1.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Bcl-2 subgraph"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}, {start: {_id:309}, end: {_id:1437}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consistent with this, Parkin translocation to mitochondria was enhanced by BH3-only proteins or a BH3-only mimetic. Taken together with their role as regulators of apoptosis-associated mitochondrial permeabilization, as well as mitochondrial fission/fusion dynamics, this suggests that Bcl-2 family proteins act as global regulators of mitochondrial homeostasis.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Ubiquitin subgraph", "Bcl-2 subgraph"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}, {start: {_id:1429}, end: {_id:1437}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Consistent with this, Parkin translocation to mitochondria was enhanced by BH3-only proteins or a BH3-only mimetic. Taken together with their role as regulators of apoptosis-associated mitochondrial permeabilization, as well as mitochondrial fission/fusion dynamics, this suggests that Bcl-2 family proteins act as global regulators of mitochondrial homeostasis.", citationTitle:"Mol Cell. 2014 Aug 7;55(3):451-66. doi: 10.1016/j.molcel.2014.06.001. Epub 2014 Jul 3.", annotationSubgraph:["Bcl-2 subgraph"], pmid:"24999239", citationType:"PubMed", citationRef:"24999239"}}, {start: {_id:810}, end: {_id:1415}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Inhibition of Drp1 by overexpression of a dominant-negative mutant counteracts the conversion to a punctiform mitochondrial phenotype, prevents the loss of the mitochondrial membrane potential and the release of cytochrome c, and reveals a reproducible swelling of the organelles. Remarkably, inhibition of Drp1 blocks cell death, implicating mitochondrial fission as an important step in apoptosis.", citationTitle:"Dev Cell. 2001 Oct;1(4):515-25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"11703942", citationType:"PubMed", citationRef:"11703942"}}, {start: {_id:810}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Inhibition of Drp1 by overexpression of a dominant-negative mutant counteracts the conversion to a punctiform mitochondrial phenotype, prevents the loss of the mitochondrial membrane potential and the release of cytochrome c, and reveals a reproducible swelling of the organelles. Remarkably, inhibition of Drp1 blocks cell death, implicating mitochondrial fission as an important step in apoptosis.", citationTitle:"Dev Cell. 2001 Oct;1(4):515-25.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"11703942", citationType:"PubMed", citationRef:"11703942"}}, {start: {_id:1445}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interactions of pink1 and parkin with genes regulating mitochondrial fusion and fission. Mitochondrial fusion requires Mfn and Opa1, and mitochondrial fission requires Drp1 and Fis1. Pink1 and Parkin promote fission and/or inhibit fusion, either directly or indirectly (dashed lines). In addition, Pink1 and Parkin are unlikely to be components of the canonical pathways regulating mitochondrial dynamics. Rather, Pink1 and Parkin may regulate other mitochondrial functions that also impact mitochondrial integrity.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1446}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Interactions of pink1 and parkin with genes regulating mitochondrial fusion and fission. Mitochondrial fusion requires Mfn and Opa1, and mitochondrial fission requires Drp1 and Fis1. Pink1 and Parkin promote fission and/or inhibit fusion, either directly or indirectly (dashed lines). In addition, Pink1 and Parkin are unlikely to be components of the canonical pathways regulating mitochondrial dynamics. Rather, Pink1 and Parkin may regulate other mitochondrial functions that also impact mitochondrial integrity.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1441}, end: {_id:1447}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of Mfn or opa1 or overexpression of drp1, rescues the phenotypes of muscle degeneration, cell death, and mitochondrial abnormalities in pink1 or parkin mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1442}, end: {_id:1447}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of Mfn or opa1 or overexpression of drp1, rescues the phenotypes of muscle degeneration, cell death, and mitochondrial abnormalities in pink1 or parkin mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1441}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of Mfn or opa1 or overexpression of drp1, rescues the phenotypes of muscle degeneration, cell death, and mitochondrial abnormalities in pink1 or parkin mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1442}, end: {_id:328}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of Mfn or opa1 or overexpression of drp1, rescues the phenotypes of muscle degeneration, cell death, and mitochondrial abnormalities in pink1 or parkin mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1441}, end: {_id:1448}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of Mfn or opa1 or overexpression of drp1, rescues the phenotypes of muscle degeneration, cell death, and mitochondrial abnormalities in pink1 or parkin mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1442}, end: {_id:1448}, properties:{annotationCondition:["Normal Healthy State"], evidence:"knockdown of Mfn or opa1 or overexpression of drp1, rescues the phenotypes of muscle degeneration, cell death, and mitochondrial abnormalities in pink1 or parkin mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1462}, end: {_id:62}, properties:{annotationCondition:["Normal Healthy State"], evidence:"As VDAC1 is a component of the mPTP (mitochondrial permeability transition pore), which is involved in apoptosis", citationTitle:"Nat Cell Biol. 2010 Feb;12(2):119-31. doi: 10.1038/ncb2012. Epub 2010 Jan 24.", annotationSubgraph:["Regulation of cytoskeleton subgraph"], pmid:"20098416", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"20098416"}}, {start: {_id:221}, end: {_id:1427}, properties:{evidence:"PINK1 on the outer mitochondrial membrane is sufficient to induce mitophagy in the presence of Parkin", citationTitle:"PLoS Biol. 2010 Jan 26;8(1):e1000298. doi: 10.1371/journal.pbio.1000298.", annotationSubgraph:["Mitophagy subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"20126261", citationType:"PubMed", citationRef:"20126261"}}, {start: {_id:271}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin, is selectively recruited to dysfunctional mitochondria", citationTitle:"PLoS Biol. 2010 Jan 26;8(1):e1000298. doi: 10.1371/journal.pbio.1000298.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"20126261", citationType:"PubMed", citationRef:"20126261"}}, {start: {_id:314}, end: {_id:313}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Opa1 degradation by Oma1 may prevent fusion of damaged mitochondria with healthy mitochondria and be coupled to Pink1-mediated recruitment of Parkin to facilitate mitophagy.", citationTitle:"J Cell Biol. 2010 Nov 29;191(5):933-42. doi: 10.1083/jcb.201008084.", annotationSubgraph:["Mitochondria fusion subgraph", "Mitochondrial subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"21115803", citationType:"PubMed", citationRef:"21115803"}}, {start: {_id:1445}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"If mitochondria re-establish membrane potential, PINK1 accumulated on the outer mitochondrial membrane is readily re-imported and degraded to deactivate Parkin, terminate mitophagy and maintain healthy organelles in the network.", citationTitle:"Dev Cell. 2012 Feb 14;22(2):320-33. doi: 10.1016/j.devcel.2011.12.014. Epub 2012 Jan 25.", annotationSpecies:["7227"], pmid:"22280891", annotationCellline:["SH-SY5Y"], citationType:"PubMed", citationRef:"22280891"}}, {start: {_id:221}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 accumulation is greatly enhanced by the knockdown of the LONP1 protease. We suggest that the accumulation of unfolded proteins in mitochondria is a physiological trigger of mitophagy.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1750-7. doi: 10.4161/auto.26122. Epub 2013 Sep 5.", annotationSubgraph:["PINK1 subgraph"], pmid:"24149988", citationType:"PubMed", citationRef:"24149988"}}, {start: {_id:1511}, end: {_id:303}, properties:{evidence:"We found that the overexpression of Î”OTC induces PINK1 accumulation, PARK2 translocation, mitophagy and the reduction of unfolded proteins.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1750-7. doi: 10.4161/auto.26122. Epub 2013 Sep 5.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24149988", citationType:"PubMed", citationRef:"24149988"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1446}, end: {_id:1512}, properties:{annotationCondition:["Normal Healthy State"], evidence:"overexpressed Parkin reduces proteotoxicity and extends life span in Drosophila", citationTitle:"Autophagy. 2013 Nov 1;9(11):1750-7. doi: 10.4161/auto.26122. Epub 2013 Sep 5.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], annotationSpecies:["7227"], pmid:"24149988", citationType:"PubMed", citationRef:"24149988"}}, {start: {_id:271}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PARK2, but not PINK1, is indispensable for the degradation of whole mitochondria", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}, {start: {_id:271}, end: {_id:762}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The investigation of the role of key elements of the autophagy machinery in our study confirmed that OMM proteolysis triggered by PINK1 and PARK2 relies on the ubiquitin-proteasome pathway; in addition, it demonstrated that PARK2 cooperates subsequently with ATG5, ATG7, and AMBRA1 in the absence of PINK1 to promote the degradation of mitochondrial remnants.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}, {start: {_id:221}, end: {_id:762}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The investigation of the role of key elements of the autophagy machinery in our study confirmed that OMM proteolysis triggered by PINK1 and PARK2 relies on the ubiquitin-proteasome pathway; in addition, it demonstrated that PARK2 cooperates subsequently with ATG5, ATG7, and AMBRA1 in the absence of PINK1 to promote the degradation of mitochondrial remnants.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}, {start: {_id:1519}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The investigation of the role of key elements of the autophagy machinery in our study confirmed that OMM proteolysis triggered by PINK1 and PARK2 relies on the ubiquitin-proteasome pathway; in addition, it demonstrated that PARK2 cooperates subsequently with ATG5, ATG7, and AMBRA1 in the absence of PINK1 to promote the degradation of mitochondrial remnants.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Mitophagy subgraph", "Autophagy signaling subgraph"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}, {start: {_id:1520}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The investigation of the role of key elements of the autophagy machinery in our study confirmed that OMM proteolysis triggered by PINK1 and PARK2 relies on the ubiquitin-proteasome pathway; in addition, it demonstrated that PARK2 cooperates subsequently with ATG5, ATG7, and AMBRA1 in the absence of PINK1 to promote the degradation of mitochondrial remnants.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Mitophagy subgraph", "Autophagy signaling subgraph"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}, {start: {_id:1521}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The investigation of the role of key elements of the autophagy machinery in our study confirmed that OMM proteolysis triggered by PINK1 and PARK2 relies on the ubiquitin-proteasome pathway; in addition, it demonstrated that PARK2 cooperates subsequently with ATG5, ATG7, and AMBRA1 in the absence of PINK1 to promote the degradation of mitochondrial remnants.", citationTitle:"Autophagy. 2013 Nov 1;9(11):1801-17. doi: 10.4161/auto.25884. Epub 2013 Sep 5.", annotationSubgraph:["Mitophagy subgraph", "Autophagy signaling subgraph"], pmid:"24149440", citationType:"PubMed", citationRef:"24149440"}}, {start: {_id:1525}, end: {_id:583}, properties:{evidence:"We note that the relative expression of HK1 compared with HK2 is higher in the brain. However, the observation that hexokinase activity itself is required for parkin recruitment suggests that HK1 or HK2 should be equally effective in this pathway. Although we show that HK2 can promote parkin recruitment in neurons, it is likely that HK1 would be more important in the brain. Our results also show that Akt- dependent recruitment of HK2 to mitochondria is important. The recruitment of hexokinase to mitochondria supports glycolysis, allowing for energy metabolism in the absence of oxygen. This has implications for both aging (31) and tolerance to oxidative stress (32), both processes implicated in Parkinson's disease. We speculate that diminishment of Akt signaling would be of interest to examine in the context of parkinsonism, and there is some evidence that Akt signaling is altered in sporadic PD", citationTitle:"Hum Mol Genet. 2014 Jan 1;23(1):145-56. doi: 10.1093/hmg/ddt407. Epub 2013 Aug 19.", annotationSubgraph:["Energy metabolic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23962723", citationType:"PubMed", citationRef:"23962723"}}, {start: {_id:1526}, end: {_id:583}, properties:{evidence:"We note that the relative expression of HK1 compared with HK2 is higher in the brain. However, the observation that hexokinase activity itself is required for parkin recruitment suggests that HK1 or HK2 should be equally effective in this pathway. Although we show that HK2 can promote parkin recruitment in neurons, it is likely that HK1 would be more important in the brain. Our results also show that Akt- dependent recruitment of HK2 to mitochondria is important. The recruitment of hexokinase to mitochondria supports glycolysis, allowing for energy metabolism in the absence of oxygen. This has implications for both aging (31) and tolerance to oxidative stress (32), both processes implicated in Parkinson's disease. We speculate that diminishment of Akt signaling would be of interest to examine in the context of parkinsonism, and there is some evidence that Akt signaling is altered in sporadic PD", citationTitle:"Hum Mol Genet. 2014 Jan 1;23(1):145-56. doi: 10.1093/hmg/ddt407. Epub 2013 Aug 19.", annotationSubgraph:["Energy metabolic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23962723", citationType:"PubMed", citationRef:"23962723"}}, {start: {_id:1525}, end: {_id:270}, properties:{evidence:"We note that the relative expression of HK1 compared with HK2 is higher in the brain. However, the observation that hexokinase activity itself is required for parkin recruitment suggests that HK1 or HK2 should be equally effective in this pathway. Although we show that HK2 can promote parkin recruitment in neurons, it is likely that HK1 would be more important in the brain. Our results also show that Akt- dependent recruitment of HK2 to mitochondria is important. The recruitment of hexokinase to mitochondria supports glycolysis, allowing for energy metabolism in the absence of oxygen. This has implications for both aging (31) and tolerance to oxidative stress (32), both processes implicated in Parkinson's disease. We speculate that diminishment of Akt signaling would be of interest to examine in the context of parkinsonism, and there is some evidence that Akt signaling is altered in sporadic PD", citationTitle:"Hum Mol Genet. 2014 Jan 1;23(1):145-56. doi: 10.1093/hmg/ddt407. Epub 2013 Aug 19.", annotationSubgraph:["Energy metabolic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23962723", citationType:"PubMed", citationRef:"23962723"}}, {start: {_id:1526}, end: {_id:270}, properties:{evidence:"We note that the relative expression of HK1 compared with HK2 is higher in the brain. However, the observation that hexokinase activity itself is required for parkin recruitment suggests that HK1 or HK2 should be equally effective in this pathway. Although we show that HK2 can promote parkin recruitment in neurons, it is likely that HK1 would be more important in the brain. Our results also show that Akt- dependent recruitment of HK2 to mitochondria is important. The recruitment of hexokinase to mitochondria supports glycolysis, allowing for energy metabolism in the absence of oxygen. This has implications for both aging (31) and tolerance to oxidative stress (32), both processes implicated in Parkinson's disease. We speculate that diminishment of Akt signaling would be of interest to examine in the context of parkinsonism, and there is some evidence that Akt signaling is altered in sporadic PD", citationTitle:"Hum Mol Genet. 2014 Jan 1;23(1):145-56. doi: 10.1093/hmg/ddt407. Epub 2013 Aug 19.", annotationSubgraph:["Energy metabolic subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23962723", citationType:"PubMed", citationRef:"23962723"}}, {start: {_id:271}, end: {_id:1427}, properties:{evidence:"we report that USP30, a deubiquitinase localized to mitochondria, antagonizes mitophagy driven by the ubiquitin ligase parkin (also known as PARK2) and protein kinase PINK1, which are encoded by two genes associated with Parkinson's disease.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:221}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"we report that USP30, a deubiquitinase localized to mitochondria, antagonizes mitophagy driven by the ubiquitin ligase parkin (also known as PARK2) and protein kinase PINK1, which are encoded by two genes associated with Parkinson's disease.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["PINK1 subgraph"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1531}, end: {_id:1532}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Knockdown of USP30 in dopaminergic neurons protects flies against paraquat toxicity in vivo, ameliorating defects in dopamine levels, motor function and organismal survival. Thus USP30 inhibition is potentially beneficial for Parkinson's disease by promoting mitochondrial clearance and quality control.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1535}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"parkin ubiquitination and degradation of USP30 might contribute to mitophagy by removing the brake on mitophagy.", citationTitle:"Nature. 2014 Jun 19;510(7505):370-5. doi: 10.1038/nature13418. Epub 2014 Jun 4.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationCell:["dopaminergic neuron"], pmid:"24896179", citationType:"PubMed", citationRef:"24896179"}}, {start: {_id:1441}, end: {_id:313}, properties:{evidence:"MUL1 is a mitochondrial protein that regulates another protein called mitofusin; the role of mitofusin is to promote the fusion of mitochondria. Conversely, removing MUL1 from PINK1 or parkin mutant worsens the symptoms because MUL1 is no longer present to compensate for the defects.", citationTitle:"Elife. 2014 Jun 4;3:e01958. doi: 10.7554/eLife.01958.", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"24898855", citationType:"PubMed", citationRef:"24898855"}}, {start: {_id:271}, end: {_id:303}, properties:{evidence:"Here we show that adult knockout of parkin in ventral midbrain leads to decreases in mitochondrial size, number, and protein markers consistent with a defect in mitochondrial biogenesis. This decrease in mitochondrial mass is prevented by short hairpin RNA knockdown of PARIS. PARIS overexpression in ventral midbrain leads to decreases in mitochondrial number and protein markers and PGC-1Î±-dependent deficits in mitochondrial respiration. Taken together, these results suggest that parkin loss impairs mitochondrial biogenesis, leading to declining function of the mitochondrial pool and cell death.", citationTitle:"Proc Natl Acad Sci U S A. 2015 Sep 15;112(37):11696-701. doi: 10.1073/pnas.1500624112. Epub 2015 Aug 31.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"26324925", citationType:"PubMed", citationRef:"26324925"}}, {start: {_id:271}, end: {_id:328}, properties:{evidence:"Here we show that adult knockout of parkin in ventral midbrain leads to decreases in mitochondrial size, number, and protein markers consistent with a defect in mitochondrial biogenesis. This decrease in mitochondrial mass is prevented by short hairpin RNA knockdown of PARIS. PARIS overexpression in ventral midbrain leads to decreases in mitochondrial number and protein markers and PGC-1Î±-dependent deficits in mitochondrial respiration. Taken together, these results suggest that parkin loss impairs mitochondrial biogenesis, leading to declining function of the mitochondrial pool and cell death.", citationTitle:"Proc Natl Acad Sci U S A. 2015 Sep 15;112(37):11696-701. doi: 10.1073/pnas.1500624112. Epub 2015 Aug 31.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"26324925", citationType:"PubMed", citationRef:"26324925"}}, {start: {_id:1561}, end: {_id:1562}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We show here that PGC-1, a cold-inducible coactivator of nuclear receptors, stimulates mitochondrial biogenesis and respiration in muscle cells through an induction of uncoupling protein 2 (UCP-2) and through regulation of the nuclear respiratory factors (NRFs). PGC-1 stimulates a powerful induction of NRF-1 and NRF-2 gene expression; in addition, PGC-1 binds to and coactivates the transcriptional function of NRF-1 on the promoter for mitochondrial transcription factor A (mtTFA), a direct regulator of mitochondrial DNA replication/transcription.", citationTitle:"Cell. 1999 Jul 9;98(1):115-24.", annotationSubgraph:["Transcription subgraph"], pmid:"10412986", citationType:"PubMed", citationRef:"10412986"}}, {start: {_id:1568}, end: {_id:1569}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Certain environmental states, such as cold temperatures or high- calorie diets, are known to increase the activity of the sympathetic nervous system, leading to the release of norepinephrine. This neurotransmitter triggers activation of the Î²-adrenergic receptors, resulting in the elevation of intracellular cAMP and stimulation of adaptive thermogenesis in skeletal muscle and brown fat", citationTitle:"Cell. 1999 Jul 9;98(1):115-24.", annotationSubgraph:["G-protein-mediated signaling"], pmid:"10412986", citationType:"PubMed", citationRef:"10412986"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1573}, end: {_id:270}, properties:{annotationCondition:["Normal Healthy State"], evidence:"variable addressed by our study is the role of reactive oxygen species in activating mitochondrial chaperone-encoding genes. Interactions between these two processes are revealed by the observations that both Paraquat, which leads to accumulation of massive amount of reactive oxygen species and ethidium bromide, which primarily affects the integrity of the mitochondrial genome, activate hsp-60::gfp and the oxidative stress inducible reporter sod-3::gfp", citationTitle:"J Cell Sci. 2004 Aug 15;117(Pt 18):4055-66. Epub 2004 Jul 27.", annotationSubgraph:["Response to oxidative stress"], pmid:"15280428", citationType:"PubMed", citationRef:"15280428"}}, {start: {_id:1584}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondria-derived vesicles (MDVs) have been shown to transport cargo from the mitochondria to the peroxisomes. Mitochondria and peroxisomes share common functions in the oxidation of fatty acids and the reduction of damaging peroxides. Their biogenesis is also linked through both the activation of master transcription factors such as PGC-1alpha and the common use of fission machinery, including DRP1, Mff, and hFis1.", citationTitle:"Curr Biol. 2010 Jul 27;20(14):1310-5. doi: 10.1016/j.cub.2010.05.066. Epub 2010 Jul 8.", annotationSubgraph:["Energy metabolic subgraph"], pmid:"20619655", citationType:"PubMed", citationRef:"20619655"}}, {start: {_id:1585}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondria-derived vesicles (MDVs) have been shown to transport cargo from the mitochondria to the peroxisomes. Mitochondria and peroxisomes share common functions in the oxidation of fatty acids and the reduction of damaging peroxides. Their biogenesis is also linked through both the activation of master transcription factors such as PGC-1alpha and the common use of fission machinery, including DRP1, Mff, and hFis1.", citationTitle:"Curr Biol. 2010 Jul 27;20(14):1310-5. doi: 10.1016/j.cub.2010.05.066. Epub 2010 Jul 8.", annotationSubgraph:["Mitochondria fission subgraph"], pmid:"20619655", citationType:"PubMed", citationRef:"20619655"}}, {start: {_id:1586}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mitochondria-derived vesicles (MDVs) have been shown to transport cargo from the mitochondria to the peroxisomes. Mitochondria and peroxisomes share common functions in the oxidation of fatty acids and the reduction of damaging peroxides. Their biogenesis is also linked through both the activation of master transcription factors such as PGC-1alpha and the common use of fission machinery, including DRP1, Mff, and hFis1.", citationTitle:"Curr Biol. 2010 Jul 27;20(14):1310-5. doi: 10.1016/j.cub.2010.05.066. Epub 2010 Jul 8.", annotationSubgraph:["Mitochondria fission subgraph"], pmid:"20619655", citationType:"PubMed", citationRef:"20619655"}}, {start: {_id:634}, end: {_id:1440}, properties:{annotationCondition:["Normal Healthy State"], evidence:"BACKGROUND:PTEN-induced kinase 1 (PINK1) is linked to recessive Parkinsonism (EOPD). Pink1 deletion results in impaired dopamine (DA) release and decreased mitochondrial respiration in the striatum of mice. To reveal additional mechanisms of Pink1-related dopaminergic dysfunction, we studied CaÃ‚Â²+ vulnerability of purified brain mitochondria, DA levels and metabolism and whether signaling pathways implicated in Parkinson's disease (PD) display altered activity in the nigrostriatal system of Pink1Ã¢ï¿½Â»/Ã¢ï¿½Â» mice.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:634}, end: {_id:1619}, properties:{evidence:"METHODS AND FINDINGS:Purified brain mitochondria of Pink1-/- mice showed impaired Ca2+ storage capacity, resulting in increased Ca2+ induced mitochondrial permeability transition (mPT) that was rescued by cyclosporine A. A subpopulation of neurons in the substantia nigra of Pink1-/- mice accumulated phospho-c-Jun, showing that Jun N-terminal kinase (JNK) activity is increased. Pink1-/- mice 6 months and older displayed reduced DA levels associated with increased DA turnover. Moreover, Pink1-/-mice had increased levels of IL-1beta, IL-12 and IL-10 in the striatum after peripheral challenge with lipopolysaccharide (LPS), and Pink1-/- embryonic fibroblasts showed decreased basal and inflammatory cytokine-induced nuclear factor kappa/beta (NF-kB) activity. Quantitative transcriptional profiling in the striatum revealed that Pink1-/- mice differentially express genes that (i) are upregulated in animals with experimentally induced dopaminergic lesions, (ii) regulate innate immune responses and/or apoptosis and (iii) promote axonal regeneration and sprouting.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:634}, end: {_id:1622}, properties:{evidence:"CONCLUSIONS:Increased mitochondrial Ca2+ sensitivity and JNK activity are early defects in Pink1-/- mice that precede reduced DA levels and abnormal DA homeostasis and may contribute to neuronal dysfunction in familial PD. Differential gene expression in the nigrostriatal system of Pink1-/- mice supports early dopaminergic dysfunction and shows that Pink1 deletion causes aberrant expression of genes that regulate innate immune responses. While some differentially expressed genes may mitigate neurodegeneration, increased LPS-induced brain cytokine expression and impaired cytokine-induced NF-kB activation may predispose neurons of Pink1-/- mice to inflammation and injury-induced cell death.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:634}, end: {_id:1619}, properties:{evidence:"CONCLUSIONS:Increased mitochondrial Ca2+ sensitivity and JNK activity are early defects in Pink1-/- mice that precede reduced DA levels and abnormal DA homeostasis and may contribute to neuronal dysfunction in familial PD. Differential gene expression in the nigrostriatal system of Pink1-/- mice supports early dopaminergic dysfunction and shows that Pink1 deletion causes aberrant expression of genes that regulate innate immune responses. While some differentially expressed genes may mitigate neurodegeneration, increased LPS-induced brain cytokine expression and impaired cytokine-induced NF-kB activation may predispose neurons of Pink1-/- mice to inflammation and injury-induced cell death.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:634}, end: {_id:881}, properties:{evidence:"CONCLUSIONS:Increased mitochondrial Ca2+ sensitivity and JNK activity are early defects in Pink1-/- mice that precede reduced DA levels and abnormal DA homeostasis and may contribute to neuronal dysfunction in familial PD. Differential gene expression in the nigrostriatal system of Pink1-/- mice supports early dopaminergic dysfunction and shows that Pink1 deletion causes aberrant expression of genes that regulate innate immune responses. While some differentially expressed genes may mitigate neurodegeneration, increased LPS-induced brain cytokine expression and impaired cytokine-induced NF-kB activation may predispose neurons of Pink1-/- mice to inflammation and injury-induced cell death.", citationTitle:"PLoS One. 2011 Jan 13;6(1):e16038. doi: 10.1371/journal.pone.0016038.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21249202", citationType:"PubMed", citationRef:"21249202"}}, {start: {_id:271}, end: {_id:1625}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutations in the parkin gene are a major cause of autosomal recessive Parkinson's disease. Here we show that the E3 ubiquitin ligase parkin activates signaling through the IkappaB kinase (IKK)/nuclear factor kappaB (NF-kappaB) pathway.Our analysis revealed that activation of this signaling cascade is causally linked to the neuroprotective potential of parkin. Inhibition of NF-kappaB activation by an IkappaB super-repressor or a kinase-inactive IKKbeta interferes with the neuroprotective activity of parkin.Furthermore, pathogenic parkin mutants with an impaired neuroprotective capacity show a reduced ability to stimulate NF-kappaB-dependent transcription. Finally, we present evidence that parkin interacts with and promotes degradation- independent ubiquitylation of IKKgamma/NEMO (NF-kappaB essential modifier) and TRAF2 [TNF (tumor necrosis factor) receptor-associated factor 2], two critical components of the NF-kappaB pathway. Thus, our results support a direct link between the neuroprotective activity of parkin and ubiquitin signaling in the IKK/NF-kappaB pathway.", citationTitle:"J Neurosci. 2007 Feb 21;27(8):1868-78.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"17314283", citationType:"PubMed", citationRef:"17314283"}}, {start: {_id:271}, end: {_id:396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss-of-function mutations of the parkin gene, which encodes a ubiquitin-protein ligase, are a common cause of autosomal recessive juvenile parkinsonism (ARJP). Previous work has led to the identification of a number of Parkin substrates that implicate specific pathways in ARJP pathogenesis, including endoplasmic reticulum (ER) stress and cell cycle activation. To test the involvement of previously implicated pathways, as well as to identify novel pathways in ARJP pathogenesis, we are using genetic and genomic approaches to study Parkin function in the fruit fly Drosophila melanogaster. In previous work, we demonstrated that Drosophila parkin null mutants exhibit mitochondrial pathology and flight muscle degeneration. To further explore the mechanisms responsible for pathology in parkin mutants, we analyzed the transcriptional alterations that occur during muscle degeneration and performed a genetic screen for parkin modifiers. Results of these studies indicate that oxidative stress response components are induced in parkin mutants and that loss-of-function mutations in oxidative stress components enhance the parkin mutant phenotypes. Genes involved in the innate immune response are also induced in parkin mutants. In contrast, our studies did not reveal evidence for cell cycle or ER stress pathway induction in parkin mutants. These results suggest that oxidative stress and/or inflammation may play a fundamental role in the etiology of ARJP.", citationTitle:"Hum Mol Genet. 2005 Mar 15;14(6):799-811. Epub 2005 Feb 2.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"15689351", citationType:"PubMed", citationRef:"15689351"}}, {start: {_id:271}, end: {_id:1638}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss-of-function mutations of the parkin gene, which encodes a ubiquitin-protein ligase, are a common cause of autosomal recessive juvenile parkinsonism (ARJP). Previous work has led to the identification of a number of Parkin substrates that implicate specific pathways in ARJP pathogenesis, including endoplasmic reticulum (ER) stress and cell cycle activation. To test the involvement of previously implicated pathways, as well as to identify novel pathways in ARJP pathogenesis, we are using genetic and genomic approaches to study Parkin function in the fruit fly Drosophila melanogaster. In previous work, we demonstrated that Drosophila parkin null mutants exhibit mitochondrial pathology and flight muscle degeneration. To further explore the mechanisms responsible for pathology in parkin mutants, we analyzed the transcriptional alterations that occur during muscle degeneration and performed a genetic screen for parkin modifiers. Results of these studies indicate that oxidative stress response components are induced in parkin mutants and that loss-of-function mutations in oxidative stress components enhance the parkin mutant phenotypes. Genes involved in the innate immune response are also induced in parkin mutants. In contrast, our studies did not reveal evidence for cell cycle or ER stress pathway induction in parkin mutants. These results suggest that oxidative stress and/or inflammation may play a fundamental role in the etiology of ARJP.", citationTitle:"Hum Mol Genet. 2005 Mar 15;14(6):799-811. Epub 2005 Feb 2.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"15689351", citationType:"PubMed", citationRef:"15689351"}}, {start: {_id:1446}, end: {_id:222}, properties:{evidence:"Loss-of-function mutations of the parkin gene, which encodes a ubiquitin-protein ligase, are a common cause of autosomal recessive juvenile parkinsonism (ARJP). Previous work has led to the identification of a number of Parkin substrates that implicate specific pathways in ARJP pathogenesis, including endoplasmic reticulum (ER) stress and cell cycle activation. To test the involvement of previously implicated pathways, as well as to identify novel pathways in ARJP pathogenesis, we are using genetic and genomic approaches to study Parkin function in the fruit fly Drosophila melanogaster. In previous work, we demonstrated that Drosophila parkin null mutants exhibit mitochondrial pathology and flight muscle degeneration. To further explore the mechanisms responsible for pathology in parkin mutants, we analyzed the transcriptional alterations that occur during muscle degeneration and performed a genetic screen for parkin modifiers. Results of these studies indicate that oxidative stress response components are induced in parkin mutants and that loss-of-function mutations in oxidative stress components enhance the parkin mutant phenotypes. Genes involved in the innate immune response are also induced in parkin mutants. In contrast, our studies did not reveal evidence for cell cycle or ER stress pathway induction in parkin mutants. These results suggest that oxidative stress and/or inflammation may play a fundamental role in the etiology of ARJP.", citationTitle:"Hum Mol Genet. 2005 Mar 15;14(6):799-811. Epub 2005 Feb 2.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"15689351", citationType:"PubMed", citationRef:"15689351"}}, {start: {_id:1641}, end: {_id:1639}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Phosphorylation of eIF2Î± induces translational attenuation of new protein synthesis and activates stress-responsive transcription factors such as activating transcription factor 4 (ATF4)", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Unfolded protein response subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1641}, end: {_id:1639}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We show that the core TIM23 subunit Tim17A is selectively decreased in response to cellular insults that induce translational attenuation through ISR-dependent eIF2Î± phosphorylation.", citationTitle:"Cell Metab. 2013 Dec 3;18(6):908-19. doi: 10.1016/j.cmet.2013.11.006.", annotationSubgraph:["Unfolded protein response subgraph", "Transport related subgraph"], pmid:"24315374", citationType:"PubMed", citationRef:"24315374"}}, {start: {_id:1587}, end: {_id:1646}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we examined the role of ATFS-1 during pathogen exposure because in addition to mitochondrial protective genes, ATFS-1 induced innate immune genes during mitochondrial stress that included a secreted lysozyme and anti-microbial peptides.", citationTitle:"Nature. 2014 Dec 18;516(7531):414-7. doi: 10.1038/nature13818. Epub 2014 Sep 28.", annotationSubgraph:["Innate immune system subgraph"], pmid:"25274306", citationType:"PubMed", citationRef:"25274306"}}, {start: {_id:271}, end: {_id:1427}, properties:{evidence:"USP15 inhibits Parkin-mediated mitophagy through its DUB activity", citationTitle:"Hum Mol Genet. 2014 Oct 1;23(19):5227-42. doi: 10.1093/hmg/ddu244. Epub 2014 May 22.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"24852371", citationType:"PubMed", citationRef:"24852371"}}, {start: {_id:271}, end: {_id:1426}, properties:{evidence:"Mutations in the Park2 gene, encoding the E3 ubiquitinâ€�ligase parkin, are responsible for a familial form of Parkinson's disease (PD). Parkinâ€�mediated ubiquitination is critical for the efficient elimination of depolarized dysfunctional mitochondria by autophagy (mitophagy).", citationTitle:"EMBO J. 2014 Nov 3;33(21):2473-91. doi: 10.15252/embj.201489729. Epub 2014 Sep 12.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"25216678", citationType:"PubMed", citationRef:"25216678"}}, {start: {_id:271}, end: {_id:1427}, properties:{evidence:"Mutations in the Park2 gene, encoding the E3 ubiquitinâ€�ligase parkin, are responsible for a familial form of Parkinson's disease (PD). Parkinâ€�mediated ubiquitination is critical for the efficient elimination of depolarized dysfunctional mitochondria by autophagy (mitophagy).", citationTitle:"EMBO J. 2014 Nov 3;33(21):2473-91. doi: 10.15252/embj.201489729. Epub 2014 Sep 12.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"25216678", citationType:"PubMed", citationRef:"25216678"}}, {start: {_id:1664}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We report here that USP8/UBPY, a deubiquitinating enzyme not previously implicated in mitochondrial quality control, is critical for parkinâ€�mediated mitophagy. USP8 preferentially removes nonâ€�canonical K6â€�linked ubiquitin chains from parkin, a process required for the efficient recruitment of parkin to depolarized mitochondria and for their subsequent elimination by mitophagy. This work uncovers a novel role for USP8â€�mediated deubiquitination of K6â€�linked ubiquitin conjugates from parkin in mitochondrial quality control. Knockdown of USP8 delays the mitochondrial recruitment of parkin and parkinâ€�mediated mitophagy.", citationTitle:"EMBO J. 2014 Nov 3;33(21):2473-91. doi: 10.15252/embj.201489729. Epub 2014 Sep 12.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25216678", citationType:"PubMed", citationRef:"25216678"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:221}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These lossâ€�ofâ€�function mutations impede the function of parkin in a variety of cellular pathways, including mitochondrial quality control, a process believed to be central to the pathogenesis of PD (Narendra et al, 2008; Geisler et al, 2010; McLelland et al, 2014). In this pathway, parkin collaborates with another PD gene, PTENâ€�Induced Kinase I (PINK1), to promote the removal of dysfunctional mitochondria by autophagy (mitophagy) (Narendra et al, 2010b).", citationTitle:"EMBO J. 2014 Nov 3;33(21):2473-91. doi: 10.15252/embj.201489729. Epub 2014 Sep 12.", annotationSubgraph:["Mitophagy subgraph", "PINK1 subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25216678", citationType:"PubMed", citationRef:"25216678"}}, {start: {_id:271}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Whereas K6â€�linked Ub conjugates on parkin appear to protect it from proteasomal degradation and to impede mitophagy, USP8â€�mediated removal of K6â€�linked Ub from parkin promotes parkin turnover and is required for mitophagy to proceed efficiently. Taken together, our work identifies USP8 and K6â€�linked Ub conjugates as key players in the regulation of parkinâ€�mediated mitophagy.", citationTitle:"EMBO J. 2014 Nov 3;33(21):2473-91. doi: 10.15252/embj.201489729. Epub 2014 Sep 12.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25216678", citationType:"PubMed", citationRef:"25216678"}}, {start: {_id:221}, end: {_id:1427}, properties:{evidence:"Silencing USP8 impairs mitophagy. Prolonged treatment with CCCP ultimately leads to the elimination of depolarized mitochondria by parkinâ€�dependent mitophagy (Narendra et al, 2008). Given that silencing USP8 delayed parkin recruitment to mitochondria, we asked whether it also affected mitophagy.", citationTitle:"EMBO J. 2014 Nov 3;33(21):2473-91. doi: 10.15252/embj.201489729. Epub 2014 Sep 12.", annotationSubgraph:["Mitophagy subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"25216678", citationType:"PubMed", citationRef:"25216678"}}, {start: {_id:1669}, end: {_id:303}, properties:{evidence:"Knockdown of lgg-1 gene, a core component of the general autophagic machinery, blocks mitophagy (Extended Data Fig. 4fâ€“h).", citationTitle:"Nature. 2015 May 28;521(7553):525-8. doi: 10.1038/nature14300. Epub 2015 Apr 20.", annotationSubgraph:["Mitophagy subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25896323", citationType:"PubMed", citationRef:"25896323"}}, {start: {_id:1666}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In all cases, induction of mitophagy is entirely dependent on DCT-1 (Fig. 1e and Extended Data Figs 4f, g and 5a).", citationTitle:"Nature. 2015 May 28;521(7553):525-8. doi: 10.1038/nature14300. Epub 2015 Apr 20.", annotationSubgraph:["Mitophagy subgraph"], pmid:"25896323", citationType:"PubMed", citationRef:"25896323"}}, {start: {_id:221}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additionally, we tested the requirement of the mitochondrial phosphatase and tensin (PTEN)-induced kinase 1 (PINK-1) and the cytosolic E3 ubiquitin ligase Parkin, two critical conserved components of mitophagy16. Consistent with their previously described role, PINK-1 and PDR-1 (the nematode Parkin homologue) deficiency blocks mitophagy under stress or low insulin/IGF-1 signalling, and destabilizes mitochondrial network in wild-type C. elegans cells (Fig. 1câ€“e and Extended Data Figs 1i, j, 4f, g and 5a).", citationTitle:"Nature. 2015 May 28;521(7553):525-8. doi: 10.1038/nature14300. Epub 2015 Apr 20.", annotationSubgraph:["Mitophagy subgraph"], pmid:"25896323", citationType:"PubMed", citationRef:"25896323"}}, {start: {_id:1670}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Additionally, we tested the requirement of the mitochondrial phosphatase and tensin (PTEN)-induced kinase 1 (PINK-1) and the cytosolic E3 ubiquitin ligase Parkin, two critical conserved components of mitophagy16. Consistent with their previously described role, PINK-1 and PDR-1 (the nematode Parkin homologue) deficiency blocks mitophagy under stress or low insulin/IGF-1 signalling, and destabilizes mitochondrial network in wild-type C. elegans cells (Fig. 1câ€“e and Extended Data Figs 1i, j, 4f, g and 5a).", citationTitle:"Nature. 2015 May 28;521(7553):525-8. doi: 10.1038/nature14300. Epub 2015 Apr 20.", annotationSubgraph:["Mitophagy subgraph"], pmid:"25896323", citationType:"PubMed", citationRef:"25896323"}}, {start: {_id:1671}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Depletion of CED-9, the nematode homologue of cell death inhibitor Bcl-2 and physical interactor of DCT-1 (refs 17, 18), causes mitochondrial mass increase without affecting DCT-1 mitochondrial localization (Extended Data Fig. 7a, b).", citationTitle:"Nature. 2015 May 28;521(7553):525-8. doi: 10.1038/nature14300. Epub 2015 Apr 20.", annotationSubgraph:["Mitophagy subgraph"], pmid:"25896323", citationType:"PubMed", citationRef:"25896323"}}, {start: {_id:1666}, end: {_id:1667}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In our recent study, we demonstrate that DCT-1, the Caenorhabditis elegans homolog of the mammalian BNIP3 and BNIP3L/NIX, is a key mediator of mitophagy, and functions in the same genetic pathway with PINK-1 and PDR-1 (the nematode homologs of PINK1 and Parkin respectively) to promote longevity and prevent cell damage under stress conditions. Interestingly, accumulation of damaged mitochondria activates SKN-1 (SKiNhead-1), the nematode homolog of NRF2, which in turn initiates a compensatory retrograde signaling response that impinges on both mitochondrial biogenesis and removal.", citationTitle:"Worm. 2015 Jul 29;4(3):e1071763. doi: 10.1080/21624054.2015.1071763.", pmid:"26430570", citationType:"PubMed", citationRef:"26430570"}}, {start: {_id:1677}, end: {_id:269}, properties:{evidence:"Here we identify a new pathway of mitochondria-mediated cell death in yeast. This pathway was named mitochondrial precursor over- accumulation stress (mPOS), and is characterized by aberrant accumulation of mitochondrial precursors in the cytosol. mPOS can be triggered by clinically relevant mitochondrial damage that is not limited to the core machineries of protein import. In response to mPOS, several ribosome-associated proteins were upregulated, including Gis2 and Nog2, which promote cap-independent translation and inhibit the nuclear export of the 60S ribosomal subunit, respectively6, 7. Gis2 and Nog2 upregulation promotes cell survival, which may be part of a feedback loop that attenuates mPOS. Our data indicate that mitochondrial dysfunction contributes directly to cytosolic proteostatic stress, and provide an explanation for the association between these two hallmarks of degenerative diseases and ageing.", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1678}, end: {_id:269}, properties:{evidence:"Here we identify a new pathway of mitochondria-mediated cell death in yeast. This pathway was named mitochondrial precursor over- accumulation stress (mPOS), and is characterized by aberrant accumulation of mitochondrial precursors in the cytosol. mPOS can be triggered by clinically relevant mitochondrial damage that is not limited to the core machineries of protein import. In response to mPOS, several ribosome-associated proteins were upregulated, including Gis2 and Nog2, which promote cap-independent translation and inhibit the nuclear export of the 60S ribosomal subunit, respectively6, 7. Gis2 and Nog2 upregulation promotes cell survival, which may be part of a feedback loop that attenuates mPOS. Our data indicate that mitochondrial dysfunction contributes directly to cytosolic proteostatic stress, and provide an explanation for the association between these two hallmarks of degenerative diseases and ageing.", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1679}, end: {_id:328}, properties:{evidence:"In yeast, similar mutations in the orthologous AAC2 (also known as PET9) gene cause protein misfolding, followed by severe mitochondrial damage and ageing-dependent degenerative cell death", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationSubgraph:["Mitochondrial subgraph"], annotationSpecies:["4932"], annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1685}, end: {_id:303}, properties:{evidence:"Only knockdown of HUWE1 rescued the mitochondrial fragmentation (Fig. 3f and Extended Data Fig. 4aâ€“c) and MFN2 hyper-ubiquitination (Fig. 3e, lane 3 versus 4) caused by C18:0 removal, as well as lethality of Elovl6 mutant flies (CG8184 in Drosophila; Extended Data Fig. 4d), identifying HUWE1 as the C18:0-responsive ubiquitin ligase. As expected19, increased MFN2 ubiquitination caused MFN2 protein destabilization (Extended Data Fig. 3h).C18:0 removal did not dramatically drop MFN2 steady-state levels, partly due to compensatory increases in MFN2 expression (Extended Data Fig. 3i), suggesting that ubiquitination additionally blocks MFN2 function in a degradation- independent manner, as for other HUWE1 targets20.", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:1688}, end: {_id:303}, properties:{evidence:"Knockdown of TFR1 completely blunted mitochondrial fragmentation upon C18:0 removal (Fig. 3h and Extended Data Fig. 7b, right, d). Thus, TFR1 is required for cells to sense the absence of C18:0.", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Wnt signaling subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:1688}, end: {_id:1687}, properties:{annotationCondition:["Normal Healthy State"], evidence:"JNK inhibition blocked the ability of gambogic acid to induce mitochondrial fragmentation (Fig. 3j and Extended Data Fig. 9e). In sum, these data suggest that TFR1 induces mitochondrial fragmentation via JNK, and that this is inhibited by TFR1 stearoylation (Fig. 3k).", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Wnt signaling subgraph"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:1688}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"JNK inhibition blocked the ability of gambogic acid to induce mitochondrial fragmentation (Fig. 3j and Extended Data Fig. 9e). In sum, these data suggest that TFR1 induces mitochondrial fragmentation via JNK, and that this is inhibited by TFR1 stearoylation (Fig. 3k).", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Wnt signaling subgraph"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:1688}, end: {_id:1687}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We identify C18:0 as a regulator of mitochondrial function. Upon loss of C18:0, TFR1 de-stearoylation activates JNK, leading to HUWE1-dependent MFN2 ubiquitination, impaired MFN2 activity19, and mitochondrial fragmentation.", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Wnt signaling subgraph"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:1685}, end: {_id:1426}, properties:{evidence:"We identify C18:0 as a regulator of mitochondrial function. Upon loss of C18:0, TFR1 de-stearoylation activates JNK, leading to HUWE1-dependent MFN2 ubiquitination, impaired MFN2 activity19, and mitochondrial fragmentation.", citationTitle:"Nature. 2015 Sep 3;525(7567):124-8. doi: 10.1038/nature14601. Epub 2015 Jul 27", annotationSubgraph:["Mitochondria fusion subgraph", "Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26214738", citationType:"PubMed", citationRef:"26214738"}}, {start: {_id:1718}, end: {_id:1717}, properties:{evidence:"Drp1 mediates mitochondrial fission and its overexpression in neurons results in excess synaptic mitochondria", citationTitle:"EMBO Mol Med. 2009 May;1(2):99-111. doi: 10.1002/emmm.200900006.", annotationSubgraph:["Mitochondria fission subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"20049710", citationType:"PubMed", citationRef:"20049710"}}, {start: {_id:221}, end: {_id:1716}, properties:{evidence:"Larval and adult pink1B9 and parkin1/D21 muscles show enlarged, clumped mitochondria, a defect that is modified by mitochondrial remodeling (15).", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:221}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Recently, in vitro studies of the PD-related proteins Parkin and PINK1 have found that these factors act in a common pathway to promote the selective autophagic degradation of damaged mitochondria (mitophagy).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1520}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that parkin null mutants showed a significant overall slowing of mitochondrial protein turnover, similar to but less severe than the slowing seen in autophagy- deficient Atg7 mutants, consistent with the model that Parkin acts upstream of Atg7 to promote mitophagy.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Autophagy signaling subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:271}, end: {_id:842}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin then ubiquitinates proteins in the outer mitochondrial membrane (13â€“17), leading to autophagic degradation of the dysfunctional mitochondrion.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondrial Membranes"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1759}, end: {_id:551}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that parkin mutant flies had a significantly decreased rate of mitochondrial protein turnover, similar to the decrease produced by general autophagy blockade, supporting the hypothesis that Parkin promotes mitochondrial turnover through autophagy.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:271}, end: {_id:551}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We found that parkin mutant flies had a significantly decreased rate of mitochondrial protein turnover, similar to the decrease produced by general autophagy blockade, supporting the hypothesis that Parkin promotes mitochondrial turnover through autophagy.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:271}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin Is Required for Mitophagy in Vivo", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1519}, end: {_id:551}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Because Atg5/Atg7-dependent autophagy acts downstream from Parkin (10, 28) and also mediates nonselective forms of mitochondrial degradation (29), we hypoth- esized that Atg7 null mutants would have a deficit in mitochondrial protein turnover similar to, but more severe than, the deficit in parkin null mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Autophagy signaling subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1520}, end: {_id:551}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Because Atg5/Atg7-dependent autophagy acts downstream from Parkin (10, 28) and also mediates nonselective forms of mitochondrial degradation (29), we hypoth- esized that Atg7 null mutants would have a deficit in mitochondrial protein turnover similar to, but more severe than, the deficit in parkin null mutants.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Autophagy signaling subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:271}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Together, these findings support the model that Parkin promotes mitophagy in vivo.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1520}, end: {_id:1762}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The turnover of most mitochondrial proteins showed greater dependence on Atg7 than Parkin, which was expected if Atg7 acts downstream from Parkin and also mediates nonselective mitochondrial turnover.", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Autophagy signaling subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:271}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Previous work has shown that PINK1 is required for Parkin-mediated mitophagy after treatment of cultured cells with mitochondrial depolarizing agents (11, 12), and genetic studies in Drosophila show that PINK1 null mutants have similar phenotypes to parkin null mutants", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph", "Mitophagy subgraph"], annotationSpecies:["7227"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1404}, end: {_id:1773}, properties:{evidence:"PD-causing PARK2 mutations impaired interaction with HSD17B10 and the HSD17B10-dependent mitochondrial translocation of Parkin.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph", "Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1404}, end: {_id:1774}, properties:{annotationCondition:["Normal Healthy State"], evidence:"HSD17B10 overproduction promoted mitochondrial elongation and mitigated CCCP-induced mitochondrial degradation independently of enzymatic activity.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:271}, end: {_id:1427}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The disruption of mitochondrial membrane (MM) potential (Î”Î¨m) by uncouplers or oxidative stress leads to PINK1 accumulation on the outer MM (OMM), the PINK1-dependent recruitment and activation of Parkin, the ubiquitylation and proteasome-dependent degradation of nearby substrates, and the initiation of mitophagy.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:271}, end: {_id:1807}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our results suggest that the maintenance of appropriate HSD17B10 levels may be a new mechanism by which Parkin preserves mitochondrial homeostasis.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph", "Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1418}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin recruitment and ubiquitylation may, in turn, facilitate HSD17B10 import", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1828}, end: {_id:1774}, properties:{annotationCondition:["Normal Healthy State"], evidence:"By contrast, the D86G variant (residual activity of 30%) behaved like the normal protein", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:1404}, end: {_id:1774}, properties:{annotationCondition:["Normal Healthy State"], evidence:"These results suggest that the mitochondrion-protecting function of HSD17B10 is directly correlated with the ability of this protein to promote mitochondrial elongation, and independent of its catalytic activity.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Mitochondrial subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:271}, end: {_id:1807}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Ubiquitin-dependent regulation of the TOM-dependent import of HSD17B10 by Parkin, possibly in cooperation with PINK1, may ensure the correct maintenance of HSD17B10 homeostasis in conditions of low mitochondrial import efficiency.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:221}, end: {_id:1830}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 and Parkin control localized translation of respiratory chain component mRNAs on mitochondria outer membrane", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:271}, end: {_id:1830}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 and Parkin control localized translation of respiratory chain component mRNAs on mitochondria outer membrane", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1837}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here we show that Parkinsonâ€™s disease (PD)-associated genes PINK1 and Parkin direct localized translation of certain nuclear-encoded RCC (nRCC) mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:271}, end: {_id:1837}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here we show that Parkinsonâ€™s disease (PD)-associated genes PINK1 and Parkin direct localized translation of certain nuclear-encoded RCC (nRCC) mRNAs.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:422}, end: {_id:1837}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Inhibiting the translation repressors rescued nRCC mRNA translation and neuromuscular-degeneration phenotypes of PINK1 mutant, whereas inhibiting eIF4G had opposite effects.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1840}, end: {_id:1837}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Inhibiting the translation repressors rescued nRCC mRNA translation and neuromuscular-degeneration phenotypes of PINK1 mutant, whereas inhibiting eIF4G had opposite effects.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1841}, end: {_id:1837}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Inhibiting the translation repressors rescued nRCC mRNA translation and neuromuscular-degeneration phenotypes of PINK1 mutant, whereas inhibiting eIF4G had opposite effects.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Pre-translational events"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:311}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 has been shown to regulate mito fission/fusion dynamics (Yang et al., 2008) and motility (Liu et al., 2012).", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph", "Mitochondria fission subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:313}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 has been shown to regulate mito fission/fusion dynamics (Yang et al., 2008) and motility (Liu et al., 2012).", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["Mitochondria fusion subgraph", "PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1847}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 has been shown to regulate mito fission/fusion dynamics (Yang et al., 2008) and motility (Liu et al., 2012).", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1440}, properties:{annotationCondition:["Normal Healthy State"], evidence:"PINK1 Promotes Translational Derepression and Activation of nRCC mRNAs on MOM", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:221}, end: {_id:1440}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Data presented earlier suggest that the MOM-localized nRCC mRNAs are translationally repressed in the cyto before reaching MOM, where they are reactivated by PINK1.", citationTitle:"Cell Metab. 2015 Jan 6;21(1):95-108. doi: 10.1016/j.cmet.2014.12.007.", annotationSubgraph:["PINK1 subgraph"], pmid:"25565208", citationType:"PubMed", citationRef:"25565208"}}, {start: {_id:1875}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hangen et al. show that the mitochondrial protein AIF regulates the biogenesis of respiratory chain complexes by interacting with, and by controlling the mitochondrial import of the mammalian homolog of yeast MIA40, CHCHD4, which is the central component of a redox- sensitive mitochondrial intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:504}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hangen et al. show that the mitochondrial protein AIF regulates the biogenesis of respiratory chain complexes by interacting with, and by controlling the mitochondrial import of the mammalian homolog of yeast MIA40, CHCHD4, which is the central component of a redox- sensitive mitochondrial intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1876}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Hangen et al. show that the mitochondrial protein AIF regulates the biogenesis of respiratory chain complexes by interacting with, and by controlling the mitochondrial import of the mammalian homolog of yeast MIA40, CHCHD4, which is the central component of a redox- sensitive mitochondrial intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1875}, end: {_id:1882}, properties:{annotationCondition:["Normal Healthy State"], evidence:"AIF interacts with CHCHD4, a regulator of the intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationSpecies:["4932"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:504}, end: {_id:1882}, properties:{annotationCondition:["Normal Healthy State"], evidence:"AIF interacts with CHCHD4, a regulator of the intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationSpecies:["4932"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1876}, end: {_id:1882}, properties:{annotationCondition:["Normal Healthy State"], evidence:"AIF interacts with CHCHD4, a regulator of the intermembrane space import machinery", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], annotationSpecies:["4932"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1882}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here we identified an AIF- interacting protein, CHCHD4, which is the central component of a redox-sensitive mitochondrial inter membrane space import machinery.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1809}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Human CHCHD4 is a soluble 16-kDa protein that localizes to the mitochondrial IMS (Hofmann et al., 2005), where it participates in mitochondrial import and catalyzes oxidative protein folding in cooperation with the sulfhydryl oxidase GFER/ALR/Erv1p", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1882}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Human CHCHD4 and its yeast ortholog MIA40 are involved in the import and assembly of mitochondrial IMS proteins", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Mitochondrial subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1881}, end: {_id:245}, properties:{annotationUserannotationcell:["AIF-Deficient Cell"], annotationCondition:["Normal Healthy State"], evidence:"Enforced Mitochondrial CHCHD4 Import Restores Respiration in AIF- Deficient Cells", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1881}, end: {_id:1901}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Mutation of all functional cysteines contained in CHCHD4 abrogated the capacity of the MC construct to restore the mitochondrial defects of AIF-deficient cells (Figure S6C), underscoring the relevance of the cysteine-dependent oxidoreductase activity of CHCHD4.", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Apoptosis signaling subgraph", "Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:1883}, end: {_id:1910}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Once the entire CHCHD4 protein has been taken up into this compartment, it may adopt its mature conformation and catalyze oxidative protein folding by virtue of its capacity to form mixed disulfides with protein substrates (Milenkovic et al., 2009; Sideris et al., 2009), thereby contributing to optimal mitochondrial biogenesis (Yang et al., 2012).", citationTitle:"Mol Cell. 2015 Jun 18;58(6):1001-14. doi: 10.1016/j.molcel.2015.04.020. Epub 2015 May 21.", annotationSubgraph:["Chaperone subgraph"], pmid:"26004228", citationType:"PubMed", citationRef:"26004228"}}, {start: {_id:271}, end: {_id:772}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Here, we show that parkin is not only a stress-protective, but also a stress-inducible protein.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:625}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Notably, the activity of parkin to protect cells from stress-induced cell death is independent of the proteasome, indicating that proteasomal degradation of parkin substrates cannot explain the cytoprotective activity of parkin.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:1605}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Our study supports the notion that parkin has a role in the interorganellar crosstalk between the ER and mitochondria to promote cell survival under stress, suggesting that both ER and mitochondrial stress can contribute to the pathogenesis of Parkinsonâ€™s disease.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:1922}, end: {_id:1923}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Parkin transcription was also repressed by JNK3, a kinase upstream of c-Jun, which has been implicated in neuronal cell death pathways in dopaminergic neurons", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationCell:["dopaminergic neuron"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:271}, end: {_id:1930}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We also observed previously-unreported non-mitochondrial accu- mulations of Parkin following excitotoxicity-induced mitochondrial de- polarization, which were not seen in our previous studies using CCCP.", citationTitle:"Neurobiol Dis. 2015 Feb;74:180-93. doi: 10.1016/j.nbd.2014.11.015. Epub 2014 Dec 3.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"25478815", citationType:"PubMed", citationRef:"25478815"}}, {start: {_id:1981}, end: {_id:112}, properties:{evidence:"An inflammatory response initiated by the NLRP3 inflammasome is triggered by a variety of situations of host 'danger', including infection and metabolic dysregulation.", citationTitle:"Nature. 2011 Jan 13;469(7329):221-5. doi:10.1038/nature09663. Epub 2010 Dec 1. Erratum in: Nature. 2011 Jul 7;475(7354):122.", annotationSubgraph:["Caspase subgraph", "Innate immune system subgraph"], annotationMeshdisease:["Infection"], pmid:"21124315", citationType:"PubMed", citationRef:"21124315"}}, {start: {_id:2006}, end: {_id:1621}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Chronic neuroinflammation is a common feature of the ageing brain and some neurodegenerative disorders. However, the molecular and cellular mechanisms underlying the regulation of innate immunity in the central nervous system remain elusive. Here we show that the astrocytic dopamine D2 receptor (DRD2) modulates innate immunity through alphaB- crystallin (CRYAB), which is known to suppress neuroinflammation.", citationTitle:"Nature. 2013 Feb 7;494(7435):90-4. doi: 10.1038/nature11748. Epub 2012 Dec 16.", annotationSubgraph:["Chaperone subgraph", "Innate immune system subgraph"], pmid:"23242137", citationType:"PubMed", citationRef:"23242137"}}, {start: {_id:1373}, end: {_id:2019}, properties:{evidence:"The nuclear receptor related 1 protein (Nurr1 or NR4A2) plays a key role in the maintenance of the dopaminergic system", citationTitle:"J Vis Exp. 2015 Aug 17;(102):e52963. doi: 10.3791/52963.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], pmid:"26325389", citationType:"PubMed", citationRef:"26325389"}}, {start: {_id:196}, end: {_id:881}, properties:{evidence:"The most prevalent LRRK2(G2019S) mutation has repeatedly been shown to enhance kinase activity and neurotoxicity", citationTitle:"J Neurochem. 2009 Sep;110(5):1514-22. doi: 10.1111/j.1471-4159.2009.06235.x. Epub 2009 Jun 22.", annotationSubgraph:["LRRK2 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"19545277", citationType:"PubMed", citationRef:"19545277"}}, {start: {_id:2035}, end: {_id:2036}, properties:{evidence:"Recently, EFhd2 was shown to promote cell motility by modulating the activity of Rac1, Cdc42, and RhoA.", citationTitle:"Front Neurosci. 2016 Mar 31;10:150. doi: 10.3389/fnins.2016.00150. eCollection 2016.", annotationSubgraph:["RhoA subgraph", "Apoptosis signaling subgraph"], pmid:"27064956", citationType:"PubMed", citationRef:"27064956"}}, {start: {_id:2054}, end: {_id:2063}, properties:{evidence:"HSPGs (presumably syndecans) represent anchors for the interaction of many pathogens with their host cell surface [8]. They have been shown to be involved in cellular binding/entry of viruses, such as HSV [9], AAV [10] and CMV [11], protozoan parasites [12] and pathogenic bacteria [13,14].", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2054}, end: {_id:2064}, properties:{evidence:"HSPGs (presumably syndecans) represent anchors for the interaction of many pathogens with their host cell surface [8]. They have been shown to be involved in cellular binding/entry of viruses, such as HSV [9], AAV [10] and CMV [11], protozoan parasites [12] and pathogenic bacteria [13,14].", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2054}, end: {_id:2065}, properties:{evidence:"HSPGs (presumably syndecans) represent anchors for the interaction of many pathogens with their host cell surface [8]. They have been shown to be involved in cellular binding/entry of viruses, such as HSV [9], AAV [10] and CMV [11], protozoan parasites [12] and pathogenic bacteria [13,14].", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2054}, end: {_id:2066}, properties:{evidence:"Following initial binding to HSPGs, most of these pathogens are internalized. The mechanism of internalization appears to depend solely, at least in some systems (e.g., epithelial cells), on clustering (ligation) of HSPGs [15,16].", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2054}, end: {_id:2067}, properties:{evidence:"Following initial binding to HSPGs, most of these pathogens are internalized. The mechanism of internalization appears to depend solely, at least in some systems (e.g., epithelial cells), on clustering (ligation) of HSPGs [15,16].", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2054}, end: {_id:2069}, properties:{evidence:"Syndecans have been shown to serve as receptors for HSPG-dependent bacterial invasion of HeLa cells", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2071}, end: {_id:2083}, properties:{evidence:"Protein kinase C is also recruited into the large multiprotein complex forming at the adhesion point where it regulates the associations. Previous studies have underlined the involvement of PKC in HSPG- dependent phagocytosis in HeLa cells", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:2081}, end: {_id:2062}, properties:{evidence:"In the present study, we examined the possibility that the cellular receptors of PEI/DNA complexes might also be subjected to PKC regulation. To test if PKC might have a role in internalization of PEI/DNA complexes, we treated HeLa cells with staurosporine and tested the effects of this PKC inhibitor on transfection efï¬�ciency using a luciferase assay. As shown in Figure 1, staurosporine inhibited transfection in a concentration-dependent manner. The effects were observed at concentrations similar to those used to interfere with bacterial invasion [17] and uptake of HSPG-ligating beads [15] into HeLa cells.", citationTitle:"J Gene Med. 2004 Jul;6(7):769-76", pmid:"15241784", annotationCellline:["HeLa cell"], citationType:"PubMed", citationRef:"15241784"}}, {start: {_id:2101}, end: {_id:1223}, properties:{evidence:"Overexpression of each factors, Nurr1, Pitx3, and Lmx1a robustly promoted the dopaminergic differentiation of ESC-NP cells exposed to sonic hedgehog (SHH) and fibroblast growth factor 8 (FGF8). In addition, each of these factors directly interacts with potential binding sites within the tyrosine hydroxylase (TH) gene and activated its promoter activity. Interestingly, however, overexpression of Nurr1, but not of Pitx3 or Lmx1a, generated a significant number of nonneuronal TH-positive cells. In line with this, Pitx3 and Lmx1a, but not Nurr1, induced expression of the Ngn2 gene, which is critical for neurogenesis", citationTitle:"Stem Cells Dev. 2014 Mar 1;23(5):477-87. doi: 10.1089/scd.2013.0406. Epub 2013 Dec 4.", annotationSubgraph:["Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"24172139", citationType:"PubMed", citationRef:"24172139"}}, {start: {_id:2010}, end: {_id:578}, properties:{evidence:"The homeobox transcription factor, Pitx3, plays a critical role in the development, function, and maintenance of midbrain DA neurons. We found that in young adult Pitx3-null mice, Pitx3(-/-), there was decreased tyrosine hydroxylase staining, indicating a loss of DA neurons particularly in the substantia nigra. In addition, fast-scan cyclic voltammetry and microdialysis assays of DA release indicated that the lack of Pitx3 caused a significant reduction of striatal DA release.Furthermore, behavioral tests revealed that Pitx3(-/-) mice displayed abnormal motor activities, including impaired motor coordination and decreased locomotion.", citationTitle:"Neurobiol Aging. 2015 Dec;36(12):3314-20. doi: 10.1016/j.neurobiolaging.2015.08.012. Epub 2015 Aug 20.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"26363812", citationType:"PubMed", citationRef:"26363812"}}, {start: {_id:2010}, end: {_id:2107}, properties:{evidence:"The homeobox transcription factor, Pitx3, plays a critical role in the development, function, and maintenance of midbrain DA neurons. We found that in young adult Pitx3-null mice, Pitx3(-/-), there was decreased tyrosine hydroxylase staining, indicating a loss of DA neurons particularly in the substantia nigra. In addition, fast-scan cyclic voltammetry and microdialysis assays of DA release indicated that the lack of Pitx3 caused a significant reduction of striatal DA release.Furthermore, behavioral tests revealed that Pitx3(-/-) mice displayed abnormal motor activities, including impaired motor coordination and decreased locomotion.", citationTitle:"Neurobiol Aging. 2015 Dec;36(12):3314-20. doi: 10.1016/j.neurobiolaging.2015.08.012. Epub 2015 Aug 20.", annotationSubgraph:["Transcription subgraph", "Dopaminergic subgraph"], annotationSpecies:["10090"], annotationMeshanatomy:["Midbrain Raphe Nuclei"], annotationConfidence:["High"], pmid:"26363812", citationType:"PubMed", citationRef:"26363812"}}, {start: {_id:2115}, end: {_id:1389}, properties:{evidence:"The protective effect of urocortin involved the activation of CRF receptor type 1, resulting in the increase of cyclic AMP (cAMP) levels. Various cAMP-enhancing reagents mimicked the effect of urocortin, while inhibitors for protein kinase A (PKA) blocked the effect of urocortin, strongly implicating the involvement of cAMP-PKA pathway in the neuroprotective effect of urocortin on MPP(+)-induced cell death. As the downstream of this signal pathway, urocortin promoted phosphorylation of both glycogen synthase kinase 3β and extracellular signal-regulated kinases, which are known to promote cell survival.", citationTitle:"Mol Cells. 2010 Nov;30(5):427-33. doi: 10.1007/s10059-010-0132-x.", annotationSubgraph:["CRH subgraph"], annotationSpecies:["9606"], pmid:"20821057", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"20821057"}}, {start: {_id:2118}, end: {_id:2128}, properties:{evidence:"TREM-2 and DAP12 promotes upregulation of CC chemokine receptor 7, partial DC maturation, and DC survival through activation of protein tyrosine kinases and extracellular signal regulated kinase.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2129}, end: {_id:2128}, properties:{evidence:"TREM-2 and DAP12 promotes upregulation of CC chemokine receptor 7, partial DC maturation, and DC survival through activation of protein tyrosine kinases and extracellular signal regulated kinase.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Dendrites"], annotationConfidence:["Very High"], pmid:"11602640", citationType:"PubMed", citationRef:"11602640"}}, {start: {_id:2118}, end: {_id:2083}, properties:{evidence:"Overexpression of TREM2 in microglia resulted in increased phagocytosis of apoptotic neurons and decreased gene transcription of TNF-alpha, IL-1beta, and NOS2.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2083}, properties:{evidence:"TREM2 stimulation induced DAP12 phosphorylation, extracellular signal regulated kinase phosphorylation, and cytoskeleton reorganization and increased phagocytosis.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2140}, properties:{evidence:"TREM2 stimulation induced DAP12 phosphorylation, extracellular signal regulated kinase phosphorylation, and cytoskeleton reorganization and increased phagocytosis.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"15728241", citationType:"PubMed", citationRef:"15728241"}}, {start: {_id:2118}, end: {_id:2141}, properties:{evidence:"Monoclonal Ab blockade of TREM2 on OCs generated from C57BL/6 BMMs results in decreased resorption of artificial calcium-phosphate substrate and dentine.", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"16418779", citationType:"PubMed", citationRef:"16418779"}}, {start: {_id:56}, end: {_id:2211}, properties:{evidence:"The ability of the IGF-IR to induce DNA repair was also demonstrated by infecting NWTb3 cells with UV irradiated adenovirus.", annotationSubgraph:["Insulin signal transduction"], annotationConfidence:["Very High"], pmid:"11278917", citationType:"PubMed", citationRef:"11278917"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:270}, end: {_id:835}, properties:{annotationCondition:["Normal Healthy State"], evidence:"When A549 cells were treated with or without 300 ŒºM H2O2 for 30 min and the localizations of proteins were analyzed by an immunofluorescence technique, DJ-1 and p53 were located in the cytoplasm and nuclei and in the nuclei, respectively, and both proteins were colocalized in the nuclei of cells before and after H2O2 treatment (Fig. 1E and ‚ÄãandF),F), indicating that oxidative stress enhances the binding activity of DJ-1 to p53 without affecting the localization of DJ-1.", citationTitle:"Mol Cell Biol. 2013 Jan;33(2):340-59. doi: 10.1128/MCB.01350-12. Epub 2012 Nov 12.", annotationSubgraph:["Chaperone subgraph", "Cell cycle subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"23149933", citationType:"PubMed", citationRef:"23149933"}}, {start: {_id:396}, end: {_id:1918}, properties:{annotationCondition:["Normal Healthy State"], evidence:"ATF4 binds to the parkin promoter and mediates parkin upregulation in response to ER and mitochondrial stress.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "Unfolded protein response subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:270}, end: {_id:1918}, properties:{annotationCondition:["Normal Healthy State"], evidence:"ATF4 binds to the parkin promoter and mediates parkin upregulation in response to ER and mitochondrial stress.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "Unfolded protein response subgraph"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}, {start: {_id:396}, end: {_id:1920}, properties:{annotationCondition:["Normal Healthy State"], evidence:"It is also conceivable that severe or prolonged ER stress leads to a preferential binding of c-Jun to the parkin promoter to suppress cytoprotective pathways and to favor the elimination of irreversibly damaged cells by proapoptotic pathways.", citationTitle:"Cell Death Differ. 2011 May;18(5):769-82. doi: 10.1038/cdd.2010.142. Epub 2010 Nov 26.", annotationSubgraph:["Ubiquitin subgraph", "MAPK subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"21113145", citationType:"PubMed", citationRef:"21113145"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:47}, end: {_id:93}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We find mouse Grb10 to be a critical component of the insulin receptor (IR) signaling complex that provides a functional link between IR and p85 phosphatidylinositol (PI) 3-kinase and regulates PI 3-kinase activity.", citationTitle:"J Biol Chem. 2003 Oct 10;278(41):39311-22. Epub 2003 Jun 3.", annotationSubgraph:["Phosphatidylinositol 3 subgraph", "GRB10 subgraph"], pmid:"12783867", citationType:"PubMed", citationRef:"12783867"}}, {start: {_id:47}, end: {_id:95}, properties:{annotationCondition:["Normal Healthy State"], evidence:"We find mouse Grb10 to be a critical component of the insulin receptor (IR) signaling complex that provides a functional link between IR and p85 phosphatidylinositol (PI) 3-kinase and regulates PI 3-kinase activity.", citationTitle:"J Biol Chem. 2003 Oct 10;278(41):39311-22. Epub 2003 Jun 3.", annotationSubgraph:["GRB10 subgraph"], pmid:"12783867", citationType:"PubMed", citationRef:"12783867"}}, {start: {_id:602}, end: {_id:604}, properties:{evidence:"Loss of ATP13A2 function results in impaired lysosomal function and, consequently, accumulation of SNCA/??-synuclein and neurotoxicity(21),One patient (Patient A with c.216C>A/c.1904G>A)", citationTitle:"Acta Neurol Taiwan. 2012 Sep;21(3):99-107.", annotationSubgraph:["Synuclein subgraph", "ATP13A2 subgraph"], pmid:"23196729", citationType:"PubMed", citationRef:"23196729"}}, {start: {_id:1177}, end: {_id:709}, properties:{evidence:"DYT-1 gene dystonic tremor presenting as a scan without evidence of dopaminergic deficit", citationTitle:"Mov Disord. 2012 Sep 15;27(11):1469. ", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Dystonic Disorders", "Parkinson Disease"], pmid:"22976004", citationType:"PubMed", citationRef:"22976004"}}, {start: {_id:1628}, end: {_id:749}, properties:{annotationCondition:["Normal Healthy State"], evidence:"By integrating stress signals with inputs from other cellular organelles, eukaryotic mitochondria are dynamic sensing systems that can confer substantial impact on innate immune signaling in both health and disease. This review highlights recently discovered elements of innate immune receptor signaling (TLR, RLR, NLR, and CLR) associated with mitochondrial function and discusses the role of mitochondria in the initiation and/or manifestation of inflammatory diseases and disorders. We also highlight the role of mitochondria as therapeutic targets for inflammatory disease.", citationTitle:"Curr Opin Microbiol. 2013 Jun;16(3):327-38. doi: 10.1016/j.mib.2013.05.005. Epub 2013 Jun 8.", annotationSubgraph:["Toll like receptor subgraph"], pmid:"23757367", citationType:"PubMed", citationRef:"23757367"}}, {start: {_id:221}, end: {_id:749}, properties:{evidence:"Human UBIAD1 localizes to mitochondria and converts vitamin K1 to vitamin K2.", citationTitle:"Science. 2012 Jun 8;336(6086):1306-10. doi: 10.1126/science.1218632. Epub 2012 May 10.", annotationSubgraph:["PINK1 subgraph"], annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"22582012", annotationDisease:["Parkinson's disease"], citationType:"PubMed", citationRef:"22582012"}}, {start: {_id:1976}, end: {_id:1982}, properties:{annotationCondition:["Normal Healthy State"], evidence:"LC3B-deficient mice produced more caspase-1-dependent cytokines in two sepsis models and were susceptible to LPS-induced mortality. Our study suggests that autophagic proteins regulate NALP3-dependent inflammation by preserving mitochondrial integrity.", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Caspase subgraph", "MAPK subgraph"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}, {start: {_id:556}, end: {_id:1982}, properties:{annotationCondition:["Normal Healthy State"], evidence:"LC3B-deficient mice produced more caspase-1-dependent cytokines in two sepsis models and were susceptible to LPS-induced mortality. Our study suggests that autophagic proteins regulate NALP3-dependent inflammation by preserving mitochondrial integrity.", citationTitle:"Nat Immunol. 2011 Mar;12(3):222-30. doi: 10.1038/ni.1980. Epub 2010 Dec 12.", annotationSubgraph:["Caspase subgraph", "Autophagy signaling subgraph"], pmid:"21151103", citationType:"PubMed", citationRef:"21151103"}}, {start: {_id:2118}, end: {_id:2145}, properties:{evidence:"However, RT-PCR demonstrated gene transcripts of the TREM2 associated signaling molecule DAP12 (XREF_FIG).", annotationSubgraph:["Inflammatory response subgraph"], annotationConfidence:["Very High"], pmid:"17425404", citationType:"PubMed", citationRef:"17425404"}}, {start: {_id:2208}, end: {_id:89}, properties:{evidence:"Thus, even if the negative effect of wild-type p53 predominates under a competitive condition, these data indicate that mutant p53 may be important for up-regulation of IGF-IR.", annotationSubgraph:["Insulin signal transduction", "Cell cycle subgraph"], annotationConfidence:["High"], pmid:"11016658", citationType:"PubMed", citationRef:"11016658"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:ASSOCIATION]->(end) SET r += row.properties;
UNWIND [{start: {_id:26}, end: {_id:24}, properties:{evidence:"RT-PCR analysis of the eight genes localizing to FRA6E indicated that 50% of the genes, including PARK2, were down-regulated in one or more of the primary ovarian tumors analyzed.", citationTitle:"Genes Chromosomes Cancer. 2003 Sep;38(1):40-52.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"12874785", citationType:"PubMed", citationRef:"12874785"}}, {start: {_id:24}, end: {_id:1768}, properties:{evidence:"Parkin overproduction in cells increased mitochondrial HSD17B10 abundance by a mechanism involving ubiquitin chain extension, whereas PARK2 downregulation or deficiency caused mitochondrial HSD17B10 depletion in cells and mice. HSD17B10 levels were also found to be low in the brains of PD patients with PARK2 mutations.", citationTitle:"Cell Death Differ. 2015 Oct;22(10):1563-76. doi: 10.1038/cdd.2014.224. Epub 2015 Jan 16.", annotationSubgraph:["Ubiquitin subgraph", "Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Mitochondria"], pmid:"25591737", citationType:"PubMed", citationRef:"25591737"}}, {start: {_id:24}, end: {_id:1304}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Increased parkin levels were associated with protection from cellular stress and cell cycle regulation [57â€“59] and overexpression of parkin in cultured cells not only rescued mitochondrial dysfunction caused by PINK1 loss of function, but exerted a cytoprotective role against different toxic stressor [19â€“23,26].", citationTitle:"Biochim Biophys Acta. 2013 Apr;1832(4):495-508. doi: 10.1016/j.bbadis.2013.01.004. Epub 2013 Jan 9.", annotationSubgraph:["Ubiquitin subgraph", "PINK1 subgraph"], pmid:"23313576", citationType:"PubMed", citationRef:"23313576"}}] AS row
