UNWIND [{start: {_id:28}, end: {_id:34}, properties:{annotationCondition:["Normal Healthy State"], evidence:"A Rad18 mutant harboring a Ser ‚Üí Ala substitution at S409 was compromised for PolŒ∑ association and did not redistribute PolŒ∑ to nuclear foci or promote PolŒ∑-PCNA interaction efficiently relative to wild-type Rad18. Rad18 S409A also failed to fully complement the UV sensitivity of Rad18-depleted cells. Taken together, these results show that Rad18 phosphorylation by JNK represents a novel mechanism for promoting TLS and DNA damage tolerance.", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"22456510", citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:80}, end: {_id:54}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In addition to inhibiting insulin receptor and IGF1R kinase activity by directly binding to the receptors, GRB10 can also negatively regulate insulin and IGF1 signaling by mediating insulin receptor and IGF1R degradation through ubiquitination.", citationTitle:"J Biol Chem. 2010 Dec 31;285(53):42130-9. doi: 10.1074/jbc.M110.143412. Epub 2010 Oct 26.", annotationSubgraph:["Insulin signal transduction"], pmid:"20980250", citationType:"PubMed", citationRef:"20980250"}}, {start: {_id:89}, end: {_id:54}, properties:{annotationCondition:["Normal Healthy State"], evidence:"In addition to inhibiting insulin receptor and IGF1R kinase activity by directly binding to the receptors, GRB10 can also negatively regulate insulin and IGF1 signaling by mediating insulin receptor and IGF1R degradation through ubiquitination.", citationTitle:"J Biol Chem. 2010 Dec 31;285(53):42130-9. doi: 10.1074/jbc.M110.143412. Epub 2010 Oct 26.", annotationSubgraph:["Insulin signal transduction"], pmid:"20980250", citationType:"PubMed", citationRef:"20980250"}}, {start: {_id:399}, end: {_id:413}, properties:{evidence:"Furthermore, it has shown that, in PD models, ROCK interacts with several factors that play a major role in dopaminergic neuron degeneration/neuroprotection such as NADPH-oxidase, angiotensin, and estrogen.", citationTitle:"Neuroscientist. 2014 Oct 16. pii: 1073858414554954. [Epub ahead of print]", annotationSubgraph:["RhoA subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Dopaminergic Neurons"], pmid:"25323761", citationType:"PubMed", citationRef:"25323761"}}, {start: {_id:652}, end: {_id:589}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Three functional domains are instrumental for Auxilin's co-chaperone activity: an N-terminal PTEN-like domain (residues 40-421), which is important for recruitment of Auxilin onto CCVs, a middle domain which binds clathrin, and a carboxyl-terminal J-domain (residues 886-931) which binds Hsc70 [10], [11].", citationTitle:"PloS one; Vol. 7; Iss. 5", annotationSubgraph:["Chaperone subgraph"], annotationMeshdisease:["Parkinson Disease"], annotationMeshanatomy:["Neurons"], pmid:"22563501", citationType:"PubMed", citationRef:"22563501"}}, {start: {_id:822}, end: {_id:303}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Importantly, we have shown that a relatively modest knockdown of MPPŒ≤, which has little overall effect on mitochondrial integrity, is sufficient to induce Parkin recruitment to mitochondria and promote mitochondrial clearance.", citationTitle:"EMBO Rep. 2012 Apr;13(4):378-85. doi: 10.1038/embor.2012.14.", annotationSubgraph:["Mitochondrial subgraph", "PINK1 subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"22354088", citationType:"PubMed", citationRef:"22354088"}}, {start: {_id:28}, end: {_id:34}, properties:{annotationCondition:["Normal Healthy State"], evidence:"A Rad18 mutant harboring a Ser âˆšÂ¢â€šÃ„â€ â€šÃ„Ã´ Ala substitution at S409 was compromised for PolâˆšÃ©Â¬âˆ‘ association and did not redistribute PolâˆšÃ©Â¬âˆ‘ to nuclear foci or promote PolâˆšÃ©Â¬âˆ‘-PCNA interaction efficiently relative to wild-type Rad18. Rad18 S409A also failed to fully complement the UV sensitivity of Rad18-depleted cells. Taken together, these results show that Rad18 phosphorylation by JNK represents a novel mechanism for promoting TLS and DNA damage tolerance.", citationTitle:"Mol Biol Cell. 2012 May;23(10):1943-54. doi: 10.1091/mbc.E11-10-0829. Epub 2012 Mar 28.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"22456510", annotationCellline:["NCI-H1299", "HCT116"], citationType:"PubMed", citationRef:"22456510"}}, {start: {_id:982}, end: {_id:971}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Like neurotrophins, GDNF family proteins are responsible for the development and maintenance of various sets of sensory and sympathetic neurons but, in addition, GDNF and NTN are also responsible for the development and survival of the enteric neurons, and NTN for parasympathetic neurons. All neurotrophins bind to the p75 low- affinity receptor, but their ligand specificity is determined by trk receptor tyrosine kinases. GDNF, NTN, PSP, and ART mediate their signals via a common receptor tyrosine kinase, Ret, but their ligand specificity is determined by a novel class of glycosylphosphatidylinositol (GPI)-anchored proteins called the GDNF family receptor alpha (GFR alpha). GDNF binds preferentially to GFR alpha1, NTN GFR alpha2, ART GRF alpha3, and PSP GFR alpha4 as a co- receptor to activate Ret.", citationTitle:"Microsc Res Tech. 1999 May 15-Jun 1;45(4-5):292-302.", annotationSubgraph:["Neurotrophic subgraph"], annotationSpecies:["10090"], pmid:"10383122", citationType:"PubMed", citationRef:"10383122"}}, {start: {_id:1395}, end: {_id:1396}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The resulting data demonstrate that inhibition of LRRK2 kinase activity stimulates macroautophagy in the absence of any alteration in the translational targets of mTORC1, suggesting that LRRK2 regulates autophagic vesicle formation independent of canonical mTORC1 signaling.", citationTitle:"Biochim Biophys Acta. 2013 Dec;1833(12):2900-10. doi: 10.1016/j.bbamcr.2013.07.020. Epub 2013 Aug 1.", annotationSubgraph:["LRRK2 subgraph"], annotationSpecies:["9606"], pmid:"23916833", citationType:"PubMed", citationRef:"23916833"}}, {start: {_id:1676}, end: {_id:328}, properties:{evidence:"We thus propose that mitochondrial damage in these strains affects protein import, leading to the over-accumulation and misfolding of mitochondrial precursors in the cytosol. The resulting stress, which we term mitochondrial precursor over-accumulation stress (mPOS), would then trigger cell death (Extended Data Fig. 1b).", citationTitle:"Nature. 2015 Aug 27;524(7566):481-4. doi: 10.1038/nature14859. Epub 2015 Jul 20.", annotationSubgraph:["Mitochondrial subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26192197", citationType:"PubMed", citationRef:"26192197"}}, {start: {_id:1457}, end: {_id:1699}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss of PINK1 and/or Parkin activity has previously been reported to cause RC deficits, particularly in complex I (34â€“36), and complex I dysfunction has repeatedly been implicated in the pathogenesis of PD (37).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["Ubiquitin subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:251}, end: {_id:1699}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Loss of PINK1 and/or Parkin activity has previously been reported to cause RC deficits, particularly in complex I (34â€“36), and complex I dysfunction has repeatedly been implicated in the pathogenesis of PD (37).", citationTitle:"Proc Natl Acad Sci U S A. 2013 Apr 16;110(16):6400-5. doi: 10.1073/pnas.1221132110. Epub 2013 Mar 18.", annotationSubgraph:["PINK1 subgraph"], pmid:"23509287", citationType:"PubMed", citationRef:"23509287"}}, {start: {_id:1982}, end: {_id:112}, properties:{annotationCondition:["Normal Healthy State"], evidence:"NLRP3 forms an inflammasome with its adaptor ASC, and its excessive activation can cause inflammatory diseases. However, little is known about the mechanisms that control assembly of the inflammasome complex. Here we show that microtubules mediated assembly of the NLRP3 inflammasome.", citationTitle:"Nat Immunol. 2013 May;14(5):454-60. doi: 10.1038/ni.2550. Epub 2013 Mar 17.", annotationSubgraph:["Caspase subgraph", "Innate immune system subgraph"], pmid:"23502856", citationType:"PubMed", citationRef:"23502856"}}, {start: {_id:2168}, end: {_id:2173}, properties:{evidence:"The increased activity of mitochondrial G-3-P DH induced by 7-oxo-DHEA (9, 18) permits an increase in the measured activity of the G-3- P shuttle (Table I) in a system reconstituted as described by others (29, 30).", annotationSpecies:["10116"], annotationConfidence:["Very High"], pmid:"9143361", citationType:"PubMed", citationRef:"9143361"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:1014}, end: {_id:1017}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Apolipoprotein E (APOE) seems to be the most important mediator of this recycling process, but also other lipoproteins have been implicated, e.g. apolipoproteins J and D. The thrifty nature of cholesterol homeostasis in the brain is most probably a consequence of the low rate of de novo cholesterol synthesis in the adult brain, most of which is believed to occur in glial cells. Neurons are believed to have a very low rate of cholesterol synthesis and meet their cholesterol requirements via uptake of cholesterol carried in APOE- containing lipoproteins secreted from glial cells ( Pfrieger, 2003). Accumulating epidemiological and molecular evidence indicates that there is a clear link between cholesterol turnover and neurodegenerative diseases âˆšÂ¢â€šÃ‡Â¨â€šÃ„Ãº hypercholesterolemia per-se is an important risk factor for AlzheimerâˆšÂ¢â€šÃ‡Â¨â€šÃ‘Â¢s disease (AD) and ParkinsonâˆšÂ¢â€šÃ‡Â¨â€šÃ‘Â¢s disease and the presence of an APOE âˆšÃ©Â¬Âµ4 allele is the most well described genetic risk factor for late onset AD (LOAD).", citationTitle:"Mol Aspects Med. 2009 Jun;30(3):171-9. doi: 10.1016/j.mam.2009.02.001. Epub 2009 Feb 25.", annotationSubgraph:["APOE subgraph", "Cholesterol metabolism subgraph"], annotationSpecies:["10116"], pmid:"19248803", citationType:"PubMed", citationRef:"19248803"}}] AS row
MATCH (start:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.start._id})
MATCH (end:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row.end._id})
CREATE (start)-[r:INCREASES]->(end) SET r += row.properties;
UNWIND [{start: {_id:781}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The p53 protein level in the caudate nucleus was significantly higher in parkinsonian patients than in controls (P < 0.05), whereas this protein in the substantia nigra, putamen, and cerebral cortex showed no significant difference between parkinsonian and control subjects.", citationTitle:"Neurosci Lett. 2007 Feb 27;414(1):94-7. Epub 2006 Dec 29.", annotationSubgraph:["Cell cycle subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Putamen", "Cerebral Cortex", "Substantia Nigra"], pmid:"17196747", citationType:"PubMed", citationRef:"17196747"}}, {start: {_id:1380}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"The interferon-Å’â‰¥ level was significantly higher in the nigrostriatal dopaminergic regions (substantia nigra, caudate nucleus, and putamen) in parkinsonian patients than in the controls (P < 0.05), but was not significantly different in the cerebellum or frontal cortex between the two groups.", citationTitle:"Neurosci Lett. 2007 Feb 27;414(1):94-7. Epub 2006 Dec 29.", annotationSubgraph:["Interferon signaling subgraph"], annotationSpecies:["9606"], annotationMeshanatomy:["Cerebellum", "Prefrontal Cortex"], pmid:"17196747", citationType:"PubMed", citationRef:"17196747"}}, {start: {_id:2265}, end: {_id:16}, properties:{evidence:"Parkinson’s disease is associated with increased serum levels of macrophage migration inhibitory factor.", annotationSubgraph:["Inflammatory response subgraph"], annotationMeshanatomy:["Blood"], annotationConfidence:["Very High"], pmid:"21550814", citationType:"PubMed", citationRef:"21550814"}}] AS row
