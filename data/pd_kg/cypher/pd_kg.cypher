UNWIND [{start: {_id:579}, end: {_id:580}, properties:{evidence:"Mitochondrial DNA haplotype analysis revealed that certain haplogroups reduced the risk for PD, suggesting that mtDNA may contribute to PD development.", citationTitle:"Exp Neurol. 2009 Aug;218(2):235-46. doi: 10.1016/j.expneurol.2009.03.006. Epub 2009 Mar 18.", annotationMeshdisease:["Parkinson Disease"], pmid:"19303005", citationType:"PubMed", citationRef:"19303005"}}, {start: {_id:267}, end: {_id:734}, properties:{annotationCondition:["Normal Healthy State"], evidence:"ATP production in neuronal cells is dependent on mitochondrial glucose oxidation, and reactive oxygen species (ROS) production associated with neuronal activation might be a major cause of mitochondrial damage in dopamine neurons.", citationTitle:"Brain and nerve = Shinkei kenky?? no shinpo; Vol. 65; Iss. 12", annotationSubgraph:["Energy metabolic subgraph"], annotationMeshanatomy:["Mitochondria"], pmid:"24323934", citationType:"PubMed", citationRef:"24323934"}}, {start: {_id:872}, end: {_id:16}, properties:{annotationCondition:["Normal Healthy State"], evidence:"diets high in animal fat or cholesterol are associated with a substantial increase in risk for Parkinson's disease", citationTitle:"2001 Sep;57(3):318-23.", annotationSubgraph:["Cholesterol metabolism subgraph"], pmid:"11516224", citationType:"PubMed", citationRef:"11516224"}}, {start: {_id:887}, end: {_id:16}, properties:{evidence:"Dietary patterns with a high intake of fruit, vegetables, legumes, whole grains, nuts, fish, and poultry and a low intake of saturated fat and a moderate intake of alcohol may protect against PD.", citationTitle:"Am J Clin Nutr. 2007 Nov;86(5):1486-94.", annotationMeshdisease:["Parkinson Disease"], pmid:"17991663", citationType:"PubMed", citationRef:"17991663"}}, {start: {_id:501}, end: {_id:377}, properties:{evidence:"In PD, increased levels of Hcy may lead to dementia, depression and progression of the disease.", citationComment:"Homocysteine Level and Mechanisms of Injury in Parkinson's Disease as Related to MTHFR, MTR, and MTHFD1 Genes Polymorphisms and L-Dopa Treatment.", citationTitle:"Current genomics; Vol. 14; Iss. 8", annotationMeshdisease:["Dementia", "Parkinson Disease"], citationPubDate:"2013-12-01", pmid:"24532985", citationAuthorList:"Agata Rozycka|Pawel P Jagodzinski|Wojciech Kozubski|Margarita Lianeri|Jolanta Dorszewska", citationType:"PubMed", citationRef:"24532985"}}, {start: {_id:1249}, end: {_id:1397}, properties:{evidence:"Recent evidence indicates that L-DOPA-induced dyskinesia (LID) is associated with persistent activation of the mammalian target of rapamycin complex 1 (mTORC1) in the medium spiny neurons (MSNs) of the striatum, the main component of the basal ganglia.", citationTitle:"Cell Cycle. 2010 Jul 15;9(14):2713-8. Epub 2010 Jul 27.", annotationSpecies:["9606"], annotationMeshdisease:["Dyskinesia, Drug-Induced"], annotationMeshanatomy:["Neostriatum"], annotationCell:["medium spiny neuron"], pmid:"20581466", citationType:"PubMed", citationRef:"20581466"}}, {start: {_id:562}, end: {_id:16}, properties:{evidence:"mitochondrial toxins such as 1-methyl 4-phenyl 1,2,3,6-tetrahydropyridine (MPTP) can selectively destroy dopaminergic neurons and cause clinical features similar to PD", citationTitle:"Proc Natl Acad Sci U S A. 2008 Sep 23;105(38):14503-8. doi: 10.1073/pnas.0803998105. Epub 2008 Sep 17", annotationSpecies:["7227"], annotationMeshdisease:["Parkinson Disease"], pmid:"18799731", citationType:"PubMed", citationRef:"18799731"}}, {start: {_id:1690}, end: {_id:1693}, properties:{annotationCondition:["Normal Healthy State"], evidence:"Statins are cholesterol-lowering drugs that inhibit the mevalonate pathway (Extended Data Fig. 8a)16. Treating C. elegans with statins also abrogates their ability to sense mitochondrial damage and activate protective programs (Extended Data Figs 7g and 8b). A common side effect of statin therapy is muscle toxicity. By inhibiting the mevalonate pathway, statins inhibit ubiquinone synthesis, a key component of the electron transport chain (Extended Data Fig. 8a).", citationTitle:"Nature. 2014 Apr 17;508(7496):406-10. doi: 10.1038/nature13204. Epub 2014 Apr 2.", annotationMeshanatomy:["Mitochondria"], pmid:"24695221", citationType:"PubMed", citationRef:"24695221"}}, {start: {_id:1911}, end: {_id:16}, properties:{evidence:"Mutations in the PARK2 and PARK6 genes, coding for the cytosolic E3 ubiquitin protein ligase Parkin and the mitochondrial serine/threonine kinase PINK1 [phosphatase and tensin homologue (PTEN)-induced putative kinase 1], lead to clinically similar early-onset Parkinsonian syndromes.", citationTitle:"Biochem Soc Trans. 2015 Apr;43(2):297-301. doi: 10.1042/BST20150008.", annotationMeshdisease:["Parkinson Disease"], pmid:"25849933", citationType:"PubMed", citationRef:"25849933"}}, {start: {_id:1911}, end: {_id:16}, properties:{evidence:"PARK2 mutations cause earlyonset forms of PD.", citationTitle:"Neuron. 2015 Jul 15;87(2):371-81. doi: 10.1016/j.neuron.2015.06.034.", annotationSubgraph:["Ubiquitin subgraph"], annotationMeshdisease:["Parkinson Disease"], pmid:"26182419", citationType:"PubMed", citationRef:"26182419"}}] AS row
